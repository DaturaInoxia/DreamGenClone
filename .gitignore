# .NET build artifacts
bin/
obj/
artifacts/
**/bin/
**/obj/
**/artifacts/tmpbuild/

# User-specific files
*.user
*.suo

# NuGet and packages
packages/

# Logs and environment
*.log
.env*
# RunPod automation local credentials (never commit)
helpers/runpod/.runpod-env.ps1

# Application data (SQLite database with encrypted API keys)
data/
# Track only the sanitized content snapshot DB (no API keys); working DBs stay ignored
!DreamGenClone.Web/data/
DreamGenClone.Web/data/*
!DreamGenClone.Web/data/dreamgenclone.snapshot.db

# IDE/editor
.vscode/
.idea/

# OS/temp
.DS_Store
Thumbs.db
*.tmp
*.swp
