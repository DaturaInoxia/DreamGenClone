@echo off
REM Template for  D:\lora-training-service\serverless-secrets.bat
REM
REM COPY IT TO THE HOST AND FILL IT IN THERE. NEVER COMMIT THE FILLED-IN COPY.
REM
REM These three values are credentials. They are deliberately kept out of start-service.bat and out of git, and
REM they are only read when a job is dispatched to RunPod Serverless (a Krea 2 job). A host that only trains kohya
REM locally does not need this file at all.
REM
REM Keep this file CRLF. An LF-only .bat is silently ignored by cmd.exe and the service starts with no credentials.
REM
REM   RUNPOD_API_KEY   RunPod -> Settings -> API Keys. This is the account API key.
REM   S3_ACCESS_KEY    RunPod -> Storage -> the network volume -> S3 API.
REM   S3_SECRET_KEY    The VOLUME'S OWN key pair, not the account API key.
REM
REM The bucket name IS the volume id, and it is NOT a secret - along with RUNPOD_VOLUME_ENDPOINT,
REM RUNPOD_VOLUME_REGION and RUNPOD_TRAIN_ENDPOINT_ID it lives in start-service.bat.

set RUNPOD_API_KEY=
set S3_ACCESS_KEY=
set S3_SECRET_KEY=
