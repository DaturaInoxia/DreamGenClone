<div>
    <label class="form-label" for="@Id">Frozen reference text</label>
    <!-- The box draws the COMMITTED text and the live value follows every keystroke, so a render cannot put an older
         value back into a box someone is typing in: see CommittedTextInput. -->
    <CommittedTextInput Multiline="true" id="@Id" class="form-control" rows="4" maxlength="@MaxCharacters"
                        Live="@Value" LiveChanged="OnInputAsync" />
    <div class="d-flex justify-content-between form-text">
        @if (IsValid)
        {
            <span>Draft</span>
        }
        else
        {
            <span class="text-danger">Required before generation or promotion.</span>
        }
        <span>@(Value?.Length ?? 0) / @MaxCharacters</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public int MaxCharacters { get; set; } = 6000;

    private bool IsValid => !string.IsNullOrWhiteSpace(Value);

    private async Task OnInputAsync(string? text)
    {
        var value = text ?? string.Empty;
        if (value.Length > MaxCharacters)
        {
            value = value[..MaxCharacters];
        }

        await ValueChanged.InvokeAsync(value);
    }
}