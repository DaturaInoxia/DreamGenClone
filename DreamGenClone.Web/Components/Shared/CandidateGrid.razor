@if (Items.Count == 0)
{
    <p class="text-muted mb-0">No candidates.</p>
}
else
{
    <div class="row g-2 mb-3">
        @foreach (var item in Items)
        {
            <div class="col-6 col-md-4 col-xl-3">
                @* The tile is a DIV wrapping a button, not one big button. The review actions are real buttons, and a
                   button inside a button is invalid markup that swallows the inner click - so the clickable area and
                   the actions are siblings. *@
                <div class="h-100 border rounded @(item.Id == SelectedId ? "border-primary border-3" : "border-secondary")">
                    <button class="btn w-100 p-0 text-start" type="button" @onclick="() => SelectedIdChanged.InvokeAsync(item.Id)">
                        <div class="ratio ratio-1x1 bg-dark">
                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                            {
                                <img src="/scene-images/@item.ImagePath" class="w-100 h-100" style="object-fit:contain;" alt="Candidate @item.Id" />
                            }
                            else
                            {
                                <span class="d-flex align-items-center justify-content-center text-light small">Pending</span>
                            }
                        </div>
                        <span class="d-flex justify-content-between gap-1 p-2 small">
                            <span class="text-truncate font-monospace">@item.Id</span>
                            <span class="badge @StatusBadge(item.Status)">@item.Status</span>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                        {
                            <span class="d-block px-2 pb-2 small text-muted text-truncate">@item.Subtitle</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Decision))
                        {
                            <span class="d-block px-2 pb-2 small">
                                <span class="badge @DecisionBadge(item.Decision)">@item.Decision</span>
                            </span>
                        }
                    </button>
                    @* The standard review actions, offered only when the host asked for them: a read-only grid passes no
                       callbacks and renders exactly as it did. The verdicts are the review deck's own set, so a decision
                       taken here and one taken in the deck are the same fact. *@
                    @if (DecisionChanged.HasDelegate || DeleteRequested.HasDelegate || EditUrlFactory is not null)
                    {
                        <div class="d-flex flex-wrap gap-1 px-2 pb-2">
                            @if (DecisionChanged.HasDelegate)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success py-0 px-1"
                                        title="Choose this as the batch's pick — this is NOT a production approval, so it will not become a usable reference until it is approved on the review page"
                                        disabled="@Busy" @onclick='() => DecideAsync(item.Id, "Accepted")'>
                                    <i class="bi bi-check2-circle"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info py-0 px-1" title="Shortlist"
                                        disabled="@Busy" @onclick='() => DecideAsync(item.Id, "Shortlisted")'>
                                    <i class="bi bi-star"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="Reject"
                                        disabled="@Busy" @onclick='() => DecideAsync(item.Id, "Rejected")'>
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            }
                            @if (DeleteRequested.HasDelegate)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 ms-auto" title="Delete"
                                        disabled="@Busy" @onclick="() => DeleteRequested.InvokeAsync(item.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            @* The edit route for THIS image, when the host can build one. It sits with the review verdicts
                               because that is where the operator is already looking and clicking, and a host that supplies
                               no factory renders exactly as before. *@
                            @if (EditUrlFactory?.Invoke(item.Id) is { Length: > 0 } editUrl)
                            {
                                <a class="btn btn-sm btn-outline-primary py-0 px-1" href="@editUrl"
                                   title="Edit this image"><i class="bi bi-magic"></i></a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CandidateGridItem> Items { get; set; } = [];
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string> SelectedIdChanged { get; set; }

    /// <summary>True while the host is working, so the actions cannot be fired twice.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>
    /// Records a review decision against one candidate. The host decides WHICH verdicts it offers; the grid offers the
    /// review deck's standard three whenever this callback is supplied, and none when it is not.
    /// </summary>
    [Parameter] public EventCallback<CandidateGridDecision> DecisionChanged { get; set; }

    /// <summary>Deletes one candidate outright. Supplied only by a host whose attempts are discardable.</summary>
    [Parameter] public EventCallback<string> DeleteRequested { get; set; }

    /// <summary>
    /// Builds the edit route for one candidate, or null when that candidate has nothing to edit. Optional: a host that
    /// supplies no factory gets no Edit action, which is why this is a factory rather than a flag - only the host knows
    /// whether a given attempt has an asset behind it, and a dead button is worse than no button.
    /// </summary>
    [Parameter] public Func<string, string?>? EditUrlFactory { get; set; }

    private async Task DecideAsync(string id, string decision)
    {
        if (!Enum.TryParse<SceneAssetCandidateDecision>(decision, out var parsed))
        {
            throw new InvalidOperationException(
                $"'{decision}' is not a review decision. Supported: {string.Join(", ", Enum.GetNames<SceneAssetCandidateDecision>())}.");
        }

        await DecisionChanged.InvokeAsync(new CandidateGridDecision(id, parsed));
    }

    private static string StatusBadge(string status) => status switch
    {
        "Accepted" or "Approved" => "text-bg-success",
        "Shortlisted" => "text-bg-info",
        "Rejected" or "Revoked" => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private static string DecisionBadge(string? decision) => decision switch
    {
        "Accepted" => "text-bg-success",
        "Shortlisted" => "text-bg-info",
        "Rejected" or "Revoked" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}