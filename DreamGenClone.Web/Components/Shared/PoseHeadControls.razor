@using DreamGenClone.Web.Application.RolePlay
@using Microsoft.Extensions.Options
@inject IPoseLibraryService LibraryService
@inject IOptions<PoseStudioOptions> StudioOptions

<div class="border rounded p-2 mt-3">
    <div class="d-flex justify-content-between align-items-start gap-2">
        <div>
            <strong class="small">Head</strong>
            <span class="d-block small text-muted">
                @if (Face is null)
                {
                    <span>
                        The head has its own pivot above the neck, so this is the same projection as the body and the arms
                        stay where they are. Turn it to a profile, or nod it from looking straight down to tipped back
                        and up.
                    </span>
                }
                else
                {
                    <span>
                        This is a face pose, so the face itself is what turns, and the close-up below is the loaded FACE
                        rather than the rig's head. Turn it to a profile, or nod it from looking straight down to tipped
                        back and up.
                    </span>
                }
            </span>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-4">
            <div class="d-flex justify-content-center align-items-center bg-black border rounded" style="height: 240px;">
                @if (_previewUrl is not null)
                {
                    <img src="@_previewUrl" alt="Head close-up preview" style="max-height: 236px; max-width: 100%;" />
                }
                else
                {
                    <span class="text-muted small">Rendering the head...</span>
                }
            </div>
            <div class="form-text">
                Head close-up · @Head.YawDegrees.ToString("0")° yaw · @Head.PitchDegrees.ToString("0")° pitch
                · @Head.RollDegrees.ToString("0")° roll
                <span class="d-block">
                    Measured from the POSE'S OWN head angle, not from straight ahead: these turn the head from wherever
                    the pose already has it, so 0° means "leave it as it is".
                </span>
                @if (Face is not null)
                {
                    <span class="d-block">Showing the loaded face, framed on its own points.</span>
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var target in HeadTargets)
                {
                    <button type="button" class="btn btn-sm @(IsCurrent(target.Head) ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetAsync(target.Head)">
                        @target.Label
                    </button>
                }
            </div>

            <div class="row g-2 align-items-center mb-1">
                <div class="col-auto"><span class="small fw-semibold">Face left / right</span></div>
                <div class="col-auto">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary" title="Turn the face left" @onclick="() => StepAsync(PoseRotationAxis.Yaw, -1)">&larr;</button>
                        <button type="button" class="btn btn-outline-secondary" title="Turn the face right" @onclick="() => StepAsync(PoseRotationAxis.Yaw, 1)">&rarr;</button>
                    </div>
                </div>
                <div class="col-auto"><span class="small text-muted">front &rarr; profile</span></div>
            </div>

            <div class="row g-2 align-items-center mb-1">
                <div class="col-auto"><span class="small fw-semibold">Look up / down</span></div>
                <div class="col-auto">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary" title="Look up" @onclick="() => StepAsync(PoseRotationAxis.Pitch, 1)">&uarr;</button>
                        <button type="button" class="btn btn-outline-secondary" title="Look down" @onclick="() => StepAsync(PoseRotationAxis.Pitch, -1)">&darr;</button>
                    </div>
                </div>
                <div class="col-auto"><span class="small text-muted">tipped back &rarr; straight down</span></div>
            </div>

            <div class="row g-2 align-items-center mb-2">
                <div class="col-auto"><span class="small fw-semibold">Tilt</span></div>
                <div class="col-auto">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary" title="Tilt counter-clockwise" @onclick="() => StepAsync(PoseRotationAxis.Roll, -1)">&#8630;</button>
                        <button type="button" class="btn btn-outline-secondary" title="Tilt clockwise" @onclick="() => StepAsync(PoseRotationAxis.Roll, 1)">&#8631;</button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetAsync(new PoseHeadRotation())">Reset head</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>The body's view, needed because the head is projected inside the body's pose.</summary>
    [Parameter] public PoseView BodyView { get; set; } = new();

    [Parameter] public PoseHeadRotation Head { get; set; } = new();

    /// <summary>
    /// The loaded FACE pose, when the pose being edited is one. Null for a rig pose, where the close-up is the rig's own
    /// head.
    ///
    /// Without this the close-up drew the RIG's head for every pose, so on a face pose the two steps showed two
    /// different heads turning: the operator's face in one, and a mannequin they had never loaded in the other.
    /// </summary>
    [Parameter] public PosePerson? Face { get; set; }

    [Parameter] public EventCallback<PoseHeadRotation> HeadChanged { get; set; }

    /// <summary>
    /// The named head views, from the one canonical list. There is no separate "lying down" preset because
    /// tipped-back-and-up at the pitch limit <em>is</em> that pose on this rig — inventing a second name for it
    /// would suggest a second mechanism.
    /// </summary>
    private static readonly (string Label, PoseHeadRotation Head)[] HeadTargets = PoseNamedViews.HeadTargets;

    private string? _previewUrl;
    private PoseView? _renderedForView;
    private PoseHeadRotation? _renderedForHead;
    private PosePerson? _renderedForFace;

    /// <summary>
    /// The ONE transform every head close-up shares, computed from the head at REST and reused across head angles.
    /// Re-fitting it per angle was the defect, and it is worth naming because all three symptoms came from it: the
    /// framing is measured on the six head points, so a YAW narrowed their box and the refit scaled it straight back
    /// up (the turn looked like a rearrange), a ROLL changed the same box the same way (turn and tilt looked identical),
    /// and a PITCH shortened the box vertically and the refit stretched it back (the face appeared squashed).
    /// </summary>
    private PoseSkeletonRenderer.Framing? _framing;

    /// <summary>The body view the framing was computed for. The head moves with the body, so a view change needs a
    /// new frame; a head angle does not.</summary>
    private PoseView? _framedForView;

    /// <summary>The face the framing was computed for. A different pose is a different head, so it needs its own frame.</summary>
    private PosePerson? _framedForFace;

    protected override async Task OnParametersSetAsync()
    {
        if (_renderedForView is not null && _renderedForHead is not null
            && Same(_renderedForView, BodyView) && Same(_renderedForHead, Head)
            && ReferenceEquals(_renderedForFace, Face))
        {
            return;
        }

        await RefreshPreviewAsync();
    }

    private static bool Same(PoseView left, PoseView right) =>
        Math.Abs(left.YawDegrees - right.YawDegrees) < 0.001
        && Math.Abs(left.PitchDegrees - right.PitchDegrees) < 0.001
        && Math.Abs(left.RollDegrees - right.RollDegrees) < 0.001;

    private static bool Same(PoseHeadRotation left, PoseHeadRotation right) =>
        Math.Abs(left.YawDegrees - right.YawDegrees) < 0.001
        && Math.Abs(left.PitchDegrees - right.PitchDegrees) < 0.001
        && Math.Abs(left.RollDegrees - right.RollDegrees) < 0.001;

    private bool IsCurrent(PoseHeadRotation head) => Same(head, Head);

    private Task SetAsync(PoseHeadRotation head) => PublishAsync(head);

    private Task StepAsync(PoseRotationAxis axis, int steps) =>
        PublishAsync(PoseHeadRotation.Step(Head, axis, steps, StudioOptions.Value));

    private async Task PublishAsync(PoseHeadRotation head)
    {
        Head = head;
        await HeadChanged.InvokeAsync(head);
        await RefreshPreviewAsync();
    }

    private Task RefreshPreviewAsync()
    {
        // The frame belongs to the POSE BEING SHOWN, not to the head angle: it is computed from the head at rest and
        // kept as the head turns. Only a different pose or a different body view needs a new one.
        if (_framing is null || _framedForView is null || !Same(_framedForView, BodyView)
            || !ReferenceEquals(_framedForFace, Face))
        {
            _framing = PoseSkeletonRenderer.ComputeFraming(
                HeadAtRest(),
                PreviewCanvas,
                // A face pose has NO body to frame on, so the frame is measured on the FACE's own points. The rig's head
                // indices would measure the handful of stray joints a face crop reports and that are not in the picture
                // — the same joints whose fit onto one of these poses is what mangled it.
                Face is null ? PoseMannequin.HeadCocoIndices : null);
            _framedForView = BodyView;
            _framedForFace = Face;
        }

        // Rendered WITHOUT re-fitting, so a head angle changes the head and never the frame around it.
        _previewUrl = "data:image/png;base64," + Convert.ToBase64String(
            PoseSkeletonRenderer.RenderPngWithoutFitting(
                PoseSkeletonRenderer.Apply(PoseAt(Head), _framing.Value),
                PreviewCanvas));

        _renderedForView = BodyView;
        _renderedForHead = Head;
        _renderedForFace = Face;
        return Task.CompletedTask;
    }

    /// <summary>
    /// The pose this step is showing, at <paramref name="head"/>: the loaded FACE turned by the head path when there is
    /// one, otherwise the rig posed for the body view. ONE place decides, so the frame and the picture can never be
    /// measured from two different poses.
    /// </summary>
    private PosePerson PoseAt(PoseHeadRotation head) => Face is null
        ? LibraryService.ProjectAuthoredPose(BodyView, head)
        : PoseFaceProxy.Project(Face, head, StudioOptions.Value);

    /// <summary>The same pose with the head at rest — what the shared frame is measured from.</summary>
    private PosePerson HeadAtRest() => PoseAt(new PoseHeadRotation());

    private const int PreviewCanvas = 320;
}
