    @* ── Group: Intimate Male ── *@
    @if (!string.Equals(Gender, "Female", StringComparison.OrdinalIgnoreCase))
    {
        <div class="pa-group-header">Intimate — Male</div>
        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label class="form-label small">Endowment Length</label>
                <select class="form-select form-select-sm"
                        value="@GetSelectValue(Attributes?.EndowmentLength, PhysicalAttributesCatalog.EndowmentLengths)"
                        @onchange="@(e => OnPresetChanged(e, PhysicalAttributesCatalog.EndowmentLengths, a => a.EndowmentLength = e.Value?.ToString(), v => _endowmentLengthCustom = v))">
                    <option value="">(none)</option>
                    @foreach (var opt in PhysicalAttributesCatalog.EndowmentLengths)
                    {
                        <option value="@opt">@opt</option>
                    }
                    <option value="__custom__">(Custom...)</option>
                </select>
                @if (IsCustom(Attributes?.EndowmentLength, PhysicalAttributesCatalog.EndowmentLengths))
                {
                    <input type="text" class="form-control form-control-sm mt-1"
                           value="@Attributes?.EndowmentLength"
                           @onchange="@(e => SetField(a => a.EndowmentLength = e.Value?.ToString()))" />
                }
            </div>
            <div class="col-md-6">
                <label class="form-label small">Endowment Girth</label>
                <select class="form-select form-select-sm"
                        value="@GetSelectValue(Attributes?.EndowmentGirth, PhysicalAttributesCatalog.EndowmentGirths)"
                        @onchange="@(e => OnPresetChanged(e, PhysicalAttributesCatalog.EndowmentGirths, a => a.EndowmentGirth = e.Value?.ToString(), v => _endowmentGirthCustom = v))">
                    <option value="">(none)</option>
                    @foreach (var opt in PhysicalAttributesCatalog.EndowmentGirths)
                    {
                        <option value="@opt">@opt</option>
                    }
                    <option value="__custom__">(Custom...)</option>
                </select>
                @if (IsCustom(Attributes?.EndowmentGirth, PhysicalAttributesCatalog.EndowmentGirths))
                {
                    <input type="text" class="form-control form-control-sm mt-1"
                           value="@Attributes?.EndowmentGirth"
                           @onchange="@(e => SetField(a => a.EndowmentGirth = e.Value?.ToString()))" />
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Attributes?.EndowmentLength) || !string.IsNullOrEmpty(Attributes?.EndowmentGirth))
        {
            <div class="pa-endowment-preview mb-2">
                <span class="text-muted small">Prompt description: </span>
                <em class="small">@BuildEndowmentDescription(Attributes?.EndowmentLength, Attributes?.EndowmentGirth)</em>
            </div>
        }
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label class="form-label small">Stamina</label>
