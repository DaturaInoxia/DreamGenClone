    @* ── Group: Body (the axes) ── *@
    @* One value per axis. These replace the old single "Body Type" list, which mixed frame, fat and muscle so two
       selections contradicted each other, and which never said WHERE mass sat — the reason bodies rendered "too
       thick". "Curvy" is deliberately absent from every list: it means normal weight with a fuller rear and a
       little belly (NOT voluptuous), and both the image model and the prefill LLM misread the bare word. *@
    <div class="pa-group-header">Body</div>
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <label class="form-label small">Build (frame)</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.BodyBuild, BuildOptions)"
                    @onchange="@(e => SelectedPreset(e, BuildOptions, a => a.BodyBuild = e.Value?.ToString()))">
                <option value="">(none)</option>
                @foreach (var opt in BuildOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Silhouette</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.Silhouette, SilhouetteOptions)"
                    @onchange="@(e => SelectedPreset(e, SilhouetteOptions, a => a.Silhouette = e.Value?.ToString()))">
                <option value="">(none)</option>
                @foreach (var opt in SilhouetteOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Adiposity (body fat)</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.Adiposity, PhysicalAttributesCatalog.AdiposityLevels)"
                    @onchange="@(e => SelectedPreset(e, PhysicalAttributesCatalog.AdiposityLevels, a => a.Adiposity = e.Value?.ToString()))">
                <option value="">(none)</option>
                @foreach (var opt in PhysicalAttributesCatalog.AdiposityLevels)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
    </div>
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <label class="form-label small">Fat Distribution (where it sits)</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.FatDistribution, FatDistributionOptions)"
                    @onchange="@(e => SelectedPreset(e, FatDistributionOptions, a => a.FatDistribution = e.Value?.ToString()))">
                <option value="">(none)</option>
                @foreach (var opt in FatDistributionOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Muscle Mass</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.MuscleMass, PhysicalAttributesCatalog.MuscleMasses)"
                    @onchange="@(e => SelectedPreset(e, PhysicalAttributesCatalog.MuscleMasses, a => a.MuscleMass = e.Value?.ToString()))">
                <option value="">(none)</option>
                @foreach (var opt in PhysicalAttributesCatalog.MuscleMasses)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Muscle Definition</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.MuscleDefinition, PhysicalAttributesCatalog.MuscleDefinitions)"
                    @onchange="@(e => SelectedPreset(e, PhysicalAttributesCatalog.MuscleDefinitions, a => a.MuscleDefinition = e.Value?.ToString()))">
                <option value="">(none)</option>
                @foreach (var opt in PhysicalAttributesCatalog.MuscleDefinitions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
    </div>

    @* ── Group: Body Measurements ── *@
    @* Shown for BOTH genders: a male body has a chest, a waist, hips and a rear too, and hiding the group for a male
       template is how "there is no male equivalent" happened. The values and the chest label follow the gender; the axes
       are the same ones. *@
    <div class="pa-group-header">Body Measurements</div>
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <label class="form-label small">@ChestLabel</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.BustSize, ChestOptions)"
                    @onchange="@(e => OnPresetChanged(e, ChestOptions, a => a.BustSize = e.Value?.ToString(), v => _bustCustom = v))">
                <option value="">(none)</option>
                @foreach (var opt in ChestOptions)
                {
                    <option value="@opt">@opt</option>
                }
                <option value="__custom__">(Custom...)</option>
            </select>
            @if (IsCustom(Attributes?.BustSize, ChestOptions))
            {
                <input type="text" class="form-control form-control-sm mt-1"
                       value="@Attributes?.BustSize"
                       @onchange="@(e => SetField(a => a.BustSize = e.Value?.ToString()))" />
            }
        </div>
        <div class="col-md-4">
            <label class="form-label small">Waist</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.WaistSize, WaistOptions)"
                    @onchange="@(e => OnPresetChanged(e, WaistOptions, a => a.WaistSize = e.Value?.ToString(), v => _waistCustom = v))">
                <option value="">(none)</option>
                @foreach (var opt in WaistOptions)
                {
                    <option value="@opt">@opt</option>
                }
                <option value="__custom__">(Custom...)</option>
            </select>
            @if (IsCustom(Attributes?.WaistSize, WaistOptions))
            {
                <input type="text" class="form-control form-control-sm mt-1"
                       value="@Attributes?.WaistSize"
                       @onchange="@(e => SetField(a => a.WaistSize = e.Value?.ToString()))" />
            }
        </div>
        <div class="col-md-4">
            <label class="form-label small">Hips</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.HipSize, HipOptions)"
                    @onchange="@(e => OnPresetChanged(e, HipOptions, a => a.HipSize = e.Value?.ToString(), v => _hipCustom = v))">
                <option value="">(none)</option>
                @foreach (var opt in HipOptions)
                {
                    <option value="@opt">@opt</option>
                }
                <option value="__custom__">(Custom...)</option>
            </select>
            @if (IsCustom(Attributes?.HipSize, HipOptions))
            {
                <input type="text" class="form-control form-control-sm mt-1"
                       value="@Attributes?.HipSize"
                       @onchange="@(e => SetField(a => a.HipSize = e.Value?.ToString()))" />
            }
        </div>
    </div>
    @* Rear (ButtSize) had a field and a figure-part mapping but no catalog and no input at all, so it could
       never be set. It is distinct from HipSize, which is skeletal hip WIDTH. *@
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <label class="form-label small">Rear</label>
            <select class="form-select form-select-sm"
                    value="@GetSelectValue(Attributes?.ButtSize, RearOptions)"
                    @onchange="@(e => SelectedPreset(e, RearOptions, a => a.ButtSize = e.Value?.ToString()))">
                <option value="">(none)</option>
                @foreach (var opt in RearOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
    </div>

    @* ── Group: Style and Misc ── *@
    <div class="pa-group-header">Style &amp; Misc</div>
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <label class="form-label small">Clothing Style</label>
            <input type="text" class="form-control form-control-sm"
                   value="@Attributes?.ClothingStyle"
                   @onchange="@(e => SetField(a => a.ClothingStyle = e.Value?.ToString()))" />
        </div>
        <div class="col-md-4">
            <label class="form-label small">Piercings</label>
            <input type="text" class="form-control form-control-sm"
                   value="@Attributes?.Piercings"
                   @onchange="@(e => SetField(a => a.Piercings = e.Value?.ToString()))" />
        </div>
        <div class="col-md-4">
            <label class="form-label small">Tattoos</label>
            <input type="text" class="form-control form-control-sm"
                   value="@Attributes?.Tattoos"
                   @onchange="@(e => SetField(a => a.Tattoos = e.Value?.ToString()))" />
        </div>
    </div>
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <label class="form-label small">Distinguishing Marks</label>
            <input type="text" class="form-control form-control-sm"
                   value="@Attributes?.DistinguishingMarks"
                   @onchange="@(e => SetField(a => a.DistinguishingMarks = e.Value?.ToString()))" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Attractiveness (1-10)</label>
            <input type="number" class="form-control form-control-sm" min="1" max="10"
                   value="@Attributes?.AttractivenessRating"
                   @onchange="@(e => SetField(a => a.AttractivenessRating = TryParseInt(e.Value?.ToString())))" />
        </div>
    </div>
    @* Body hair and pubic hair are here so the character template is the single capture surface; the studio's body
       card prefills its [DECIDE] fields from them, and blank stays "not decided" rather than reading as "none".
       Each input offers the catalog's typical values and accepts anything typed: the list is a suggestion, the
       text is the decision. *@
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <label class="form-label small">Body Hair (chest, stomach, arms, legs)</label>
            <input type="text" class="form-control form-control-sm"
                   list="pa-body-hair-options"
                   placeholder="e.g. full chest hair, or none"
                   value="@Attributes?.BodyHair"
                   @onchange="@(e => SetField(a => a.BodyHair = e.Value?.ToString()))" />
            <datalist id="pa-body-hair-options">
                @foreach (var option in PhysicalAttributesCatalog.BodyHairOptions)
                {
                    <option value="@option"></option>
                }
            </datalist>
        </div>
        <div class="col-md-6">
            <label class="form-label small">Pubic Hair</label>
            <input type="text" class="form-control form-control-sm"
                   list="pa-pubic-hair-options"
                   placeholder="e.g. neatly trimmed, or none"
                   value="@Attributes?.PubicHair"
                   @onchange="@(e => SetField(a => a.PubicHair = e.Value?.ToString()))" />
            <datalist id="pa-pubic-hair-options">
                @foreach (var option in PhysicalAttributesCatalog.PubicHairOptions)
                {
                    <option value="@option"></option>
                }
            </datalist>
        </div>
    </div>

