        var lTier = hasLength ? GetLengthTier(length!) : 4;
        var gTier = hasGirth  ? GetGirthTier(girth!)   : 4;
        var lAdj  = hasLength ? GetLengthAdj(length!)   : string.Empty;
        var gAdj  = hasGirth  ? GetGirthAdj(girth!)     : string.Empty;

