@code {
    [Parameter] public PhysicalAttributes? Attributes { get; set; }
    [Parameter] public EventCallback<PhysicalAttributes> AttributesChanged { get; set; }
    [Parameter] public string? Gender { get; set; }

    private string? _hairColourCustom;
    private string? _hairStyleCustom;
    private string? _eyeColourCustom;
    private string? _skinToneCustom;
    private string? _skinTextureCustom;
    private string? _ethnicityCustom;
    private string? _bustCustom;
    private string? _waistCustom;
    private string? _hipCustom;
    private string? _scentCustom;
    private string? _sexualConfidenceCustom;
    private string? _sexualSkillCustom;
    private string? _sexualDriveCustom;
    private string? _oralSkillCustom;
    private string? _endowmentLengthCustom;
    private string? _endowmentGirthCustom;
    private string? _staminaCustom;
    private string? _recoveryCustom;
    private string? _ejaculationCustom;
    private string? _vaginalTightnessCustom;
    private string? _sensitivityCustom;
    private string? _lubricationCustom;
    private string? _orgasmicCapacityCustom;

    private async Task SetField(Action<PhysicalAttributes> setter)
    {
        var copy = Attributes is null ? new PhysicalAttributes() : ShallowCopy(Attributes);
        setter(copy);
        await AttributesChanged.InvokeAsync(copy);
    }

    /// <summary>True when the target gender is male, which selects the male silhouette and distribution lists.</summary>
    private bool IsMaleGender => string.Equals(Gender, "Male", StringComparison.OrdinalIgnoreCase);

    /// <summary>Silhouette values for the target gender — the apparel classification, or the menswear-fit equivalent.</summary>
    private IReadOnlyList<string> SilhouetteOptions
        => IsMaleGender ? PhysicalAttributesCatalog.MaleSilhouettes : PhysicalAttributesCatalog.Silhouettes;

    /// <summary>Fat-distribution values for the target gender.</summary>
    private IReadOnlyList<string> FatDistributionOptions
        => IsMaleGender ? PhysicalAttributesCatalog.MaleFatDistributions : PhysicalAttributesCatalog.FatDistributions;

    /// <summary>
    /// The remaining axes, gender-aware on the same rule as the silhouettes: a female value on a male template is not
    /// "close enough" — "petite, fine-boned", a bust volume of "Enormous" and "Voluptuous" hips describe a female
    /// body, and a model renders what it is given. The AXIS names are unchanged, so the two templates stay comparable.
    /// </summary>
    private IReadOnlyList<string> BuildOptions
        => IsMaleGender ? PhysicalAttributesCatalog.MaleBodyBuilds : PhysicalAttributesCatalog.BodyBuilds;

    private IReadOnlyList<string> ChestOptions
        => IsMaleGender ? PhysicalAttributesCatalog.MaleChestSizes : PhysicalAttributesCatalog.BustSizes;

    private string ChestLabel => IsMaleGender ? "Chest" : "Bust";

    private IReadOnlyList<string> WaistOptions
        => IsMaleGender ? PhysicalAttributesCatalog.MaleWaistSizes : PhysicalAttributesCatalog.WaistSizes;

    private IReadOnlyList<string> HipOptions
        => IsMaleGender ? PhysicalAttributesCatalog.MaleHipSizes : PhysicalAttributesCatalog.HipSizes;

    private IReadOnlyList<string> RearOptions
        => IsMaleGender ? PhysicalAttributesCatalog.MaleButtSizes : PhysicalAttributesCatalog.ButtSizes;

    /// <summary>
    /// Preset picker for the body axes. Unlike <see cref="OnPresetChanged"/> these deliberately offer no
    /// "(Custom...)" escape hatch: the axis catalogs ARE the controlled vocabulary, and a value outside them is
    /// rejected rather than silently accepted (repo no-fallback rule).
    /// </summary>
    private async Task SelectedPreset(
        ChangeEventArgs e,
        IReadOnlyList<string> catalog,
        Action<PhysicalAttributes> setter)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        if (value.Length > 0 && !catalog.Contains(value))
        {
            throw new InvalidOperationException(
                $"'{value}' is not a value of the body-axis catalog this control is bound to.");
        }

        var copy = Attributes is null ? new PhysicalAttributes() : ShallowCopy(Attributes);
        setter(copy);
        await AttributesChanged.InvokeAsync(copy);
    }

    private async Task OnPresetChanged(
        ChangeEventArgs e,
        IReadOnlyList<string> catalog,
        Action<PhysicalAttributes> setter,
        Action<string?> storeCustom)
    {
        var val = e.Value?.ToString();
        if (val == "__custom__")
        {
            storeCustom(null);
            return;
        }
        storeCustom(null);
        var copy = Attributes is null ? new PhysicalAttributes() : ShallowCopy(Attributes);
        setter(copy);
        await AttributesChanged.InvokeAsync(copy);
    }

    private static string GetSelectValue(string? value, IReadOnlyList<string> catalog)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return catalog.Contains(value) ? value : "__custom__";
    }

    private static bool IsCustom(string? value, IReadOnlyList<string> catalog)
        => !string.IsNullOrEmpty(value) && !catalog.Contains(value);

    private static string BuildEndowmentDescription(string? length, string? girth)
