@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Web.Application.RolePlay
@using Microsoft.Extensions.Options
@using System.Numerics
@inject IPoseLibraryService LibraryService
@inject IPoseTestRenderService PoseTestRender
@inject IOptions<PoseStudioOptions> StudioOptions

<div class="card mb-3">
    <div class="card-header">
        <strong>Author a pose</strong>
        <span class="d-block small text-muted">
            Turn the rig and project it. A real rotation foreshortens the figure instead of tilting or shearing it,
            so a 3/4 and a profile here are geometry rather than an approximation. Saving adds the pose to the
            library, where the picker finds it straight away.
        </span>
    </div>
    <div class="card-body">
        @if (_loadedFrom is not null)
        {
            <div class="alert alert-info py-2 small">
                <strong>Editing the library pose '@_loadedFrom.Name'.</strong>
                @if (!string.IsNullOrWhiteSpace(_fitSummary))
                {
                    <span>@_fitSummary</span>
                }
                <div class="mt-1">
                    @if (TurningTheHead)
                    {
                        <span>
                            There is no body here to fit, so the 5&deg; arrows turn the FACE itself, in 5&deg; steps from
                            wherever it already sits, and up / down tips the head back or forward.
                        </span>
                    }
                    else
                    {
                        <span>
                            The rig was fitted onto this pose, so the 5&deg; arrows, the head tool and the drag editor
                            all work on it.
                        </span>
                    }
                    <strong>Save</strong> writes your changes over this pose. <strong>Save As</strong> stores a new pose
                    and leaves the original alone.
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" disabled="@_busy"
                        @onclick="ClearLoadedAsync">
                    Start from the rig instead
                </button>
            </div>
        }
        <ul class="nav nav-tabs small mb-3" role="tablist" aria-label="Pose authoring step">
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "body" ? "active" : "")" @onclick='() => _activeTab = "body"'>
                    <i class="bi bi-person me-1"></i>Body
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "head" ? "active" : "")" @onclick='() => _activeTab = "head"'>
                    <i class="bi bi-person-bounding-box me-1"></i>Head
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "drag" ? "active" : "")" @onclick='() => _activeTab = "drag"'>
                    <i class="bi bi-arrows-move me-1"></i>Drag
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "test" ? "active" : "")" @onclick='() => _activeTab = "test"'>
                    <i class="bi bi-eye me-1"></i>Test
                </button>
            </li>
        </ul>

        <div class="row g-3 mt-1">
            @* The stage holds the frame of the step on screen. Body and Test show the projection here; Head and Drag
               bring their own canvas, so those two take the full width and their canvas lands in this same place
               instead of beside a body preview that is no longer the thing being edited. The tab bar sits above the
               row so it does not move sideways when the step that has no stage is selected. *@
            @if (_activeTab == "body" || _activeTab == "test")
            {
                <div class="col-lg-4">
                    <div class="d-flex justify-content-center align-items-center bg-black border rounded" style="height: 300px;">
                        @if (_previewUrl is not null)
                        {
                            <img src="@_previewUrl" alt="Projected pose preview" style="max-height: 296px; max-width: 100%;" />
                        }
                        else
                        {
                            <span class="text-muted small">Rendering the rig...</span>
                        }
                    </div>
                    @if (_activeTab == "body")
                    {
                        <div class="form-text">
                            @TurnYaw.ToString("0")° yaw · @TurnPitch.ToString("0")° pitch · @TurnRoll.ToString("0")° roll
                            · one press = @StepDegrees.ToString("0")°
                            @if (TurningTheHead)
                            {
                                <span class="d-block">
                                    This is a face pose: it carries a face and no body, so these arrows turn the HEAD.
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="form-text">
                            The skeleton that will be sent — the rig's projection of the view and head above, or a
                            picked library pose's own file while it is untouched. The result says which was sent.
                        </div>
                        @if (_testImageUrl is not null)
                        {
                            <div class="d-flex justify-content-center bg-black border rounded p-2 mt-2">
                                <img src="@_testImageUrl" alt="Pose test render" style="max-height: 300px; max-width: 100%;" />
                            </div>
                        }
                    }
                </div>
            }

            <div class="@(_activeTab == "body" || _activeTab == "test" ? "col-lg-8" : "col-12")">
                @* The steps are shown and hidden with display rather than @if on purpose. @if disposes the step, and an
                   unsaved drag is the operator's own work: switching to Test to look at the pose, then back to Drag,
                   must not throw it away. *@
                <div style="display: @(_activeTab == "body" ? "block" : "none");">
                <label class="form-label small fw-semibold mb-1">Target view</label>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var target in TargetViews)
                    {
                        <button type="button" class="btn btn-sm @(IsCurrent(target.View) ? "btn-primary" : "btn-outline-secondary")"
                                disabled="@_busy" @onclick="() => SetViewAsync(target.View)">
                            @target.Label
                        </button>
                    }
                </div>

                <div class="row g-2 align-items-center mb-1">
                    <div class="col-auto"><span class="small fw-semibold">Turn left / right</span></div>
                    <div class="col-auto">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary" disabled="@_busy" title="Turn left" @onclick="() => RotateAsync(PoseRotationAxis.Yaw, -1)">&larr;</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_busy" title="Turn right" @onclick="() => RotateAsync(PoseRotationAxis.Yaw, 1)">&rarr;</button>
                        </div>
                    </div>
                    <div class="col-auto"><span class="small text-muted">facing / profile</span></div>
                </div>

                <div class="row g-2 align-items-center mb-1">
                    <div class="col-auto"><span class="small fw-semibold">Tip up / down</span></div>
                    <div class="col-auto">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary" disabled="@_busy" title="Tip up" @onclick="() => RotateAsync(PoseRotationAxis.Pitch, 1)">&uarr;</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_busy" title="Tip down" @onclick="() => RotateAsync(PoseRotationAxis.Pitch, -1)">&darr;</button>
                        </div>
                    </div>
                    <div class="col-auto"><span class="small text-muted">looking up / down</span></div>
                </div>

                <div class="row g-2 align-items-center mb-2">
                    <div class="col-auto"><span class="small fw-semibold">Tilt</span></div>
                    <div class="col-auto">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary" disabled="@_busy" title="Tilt counter-clockwise" @onclick="() => RotateAsync(PoseRotationAxis.Roll, -1)">&#8630;</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_busy" title="Tilt clockwise" @onclick="() => RotateAsync(PoseRotationAxis.Roll, 1)">&#8631;</button>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ResetAsync">Reset</button>
                    </div>
                </div>
                </div>

                <div style="display: @(_activeTab == "head" ? "block" : "none");">
                @* The FACE is handed over when there is one, so the close-up shows the pose being edited rather than the
                   rig's mannequin head — which is what the operator would otherwise see turning while the Body step
                   turned their face. *@
                <PoseHeadControls BodyView="_view" Head="_head" HeadChanged="OnHeadChangedAsync"
                                  Face="@(TurningTheHead ? _storedPose : null)" />
                </div>

                <div style="display: @(_activeTab == "drag" ? "block" : "none");">
                <PoseJointEditor Start="_editorStart" BodyView="_view" Head="_head" Canvas="@PoseCanvas"
                                 PoseChanged="OnDragChangedAsync" OnSaved="OnNestedSavedAsync" />
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Name</label>
                        <CommittedTextInput type="text" class="form-control form-control-sm" placeholder="Standing 3/4 right"
                                            Live="@_name" LiveChanged="args => _name = args" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Category</label>
                        <CommittedTextInput type="text" class="form-control form-control-sm" placeholder="standing"
                                            Live="@_category" LiveChanged="args => _category = args" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Library</label>
                        <select class="form-select form-select-sm" value="@_libraryId" @onchange="e => _libraryId = e.Value?.ToString()">
                            @foreach (var library in _libraries)
                            {
                                <option value="@library.Id">@library.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-grid gap-1">
                        <button type="button" class="btn btn-sm btn-success" disabled="@(_busy || !CanSave())" @onclick="SaveAsync">
                            <i class="bi bi-save me-1"></i>Save
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success" disabled="@(_busy || !CanSave())" @onclick="SaveAsAsync">
                            <i class="bi bi-save2 me-1"></i>Save As
                        </button>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold mb-1">Keywords (optional)</label>
                        <CommittedTextInput type="text" class="form-control form-control-sm" placeholder="three quarter, turn, profile"
                                            Live="@_keywords" LiveChanged="args => _keywords = args" />
                    </div>
                </div>

                <div class="border-top mt-3 pt-3">
                    <div class="mb-2">
                        <span class="small fw-semibold">Pose metadata</span>
                        <span class="small text-muted">
                            What this pose is, which way it faces and where the camera sits &mdash; the three facts a
                            skeleton cannot carry. They write the prompt the pose renders with and choose the face and
                            body references it needs. Every field can be set, including back to "not declared".
                        </span>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Stance</label>
                            <select class="form-select form-select-sm" value="@_metaStance"
                                    @onchange="e => SetStanceAsync(e.Value?.ToString())">
                                @foreach (var stance in MetaStances)
                                {
                                    <option value="@stance">@PoseMetadataLabels.Stance(stance)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Direction</label>
                            <select class="form-select form-select-sm" value="@_metaDirection"
                                    @onchange="e => SetDirectionAsync(e.Value?.ToString())">
                                @foreach (var direction in MetaDirections)
                                {
                                    <option value="@direction">@PoseMetadataLabels.Direction(direction)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Camera angle</label>
                            <select class="form-select form-select-sm" value="@_metaCamera"
                                    @onchange="e => SetCameraAsync(e.Value?.ToString())">
                                @foreach (var camera in MetaCameras)
                                {
                                    <option value="@camera">@PoseMetadataLabels.Camera(camera)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Content rating</label>
                            <select class="form-select form-select-sm" value="@_metaRating"
                                    @onchange="e => SetRatingAsync(e.Value?.ToString())">
                                @foreach (var rating in MetaRatings)
                                {
                                    <option value="@rating">@PoseMetadataLabels.Rating(rating)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1">Metadata prompt</label>
                            <CommittedTextInput Multiline="true" class="form-control form-control-sm" rows="3"
                                                placeholder="Set a rating and the prompt is written from the fields above."
                                                Live="@_metaPrompt" LiveChanged="OnMetadataPromptInput" />
                            <span class="form-text">
                                @if (_promptHandEdited)
                                {
                                    <span>This is your own wording. No field change will overwrite it.</span>
                                }
                                else
                                {
                                    <span>Composed from the fields above; typing here makes it yours.</span>
                                }
                                An unrated pose has no prompt at all &mdash; the subject clause would have to declare
                                whether the subject is clothed, which is the pack's call to make.
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-1" disabled="@_busy"
                                    @onclick="RecomposeAsync">
                                <i class="bi bi-arrow-repeat me-1"></i>Recompose from fields
                            </button>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger py-1 small mt-2 mb-0">@_error</div>
                }
                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <div class="alert alert-success py-1 small mt-2 mb-0">@_status</div>
                }

                <div style="display: @(_activeTab == "test" ? "block" : "none");">
                <div class="border-top mt-3 pt-3">
                    <div class="mb-1">
                        <span class="small fw-semibold">Test this pose</span>
                        <span class="small text-muted">
                            Renders one throwaway image and saves nothing — no session, no gallery entry. An untouched
                            library pose is sent as the <strong>library's own skeleton</strong>; once you change the
                            view, the head or the joints, the rig's projection of your edited pose is sent instead.
                            The result says which was sent.
                        </span>
                    </div>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Image model</label>
                            @if (_testModels.Count == 0)
                            {
                                <span class="text-muted d-block small">No image models are enabled in Model Manager.</span>
                            }
                            else
                            {
                                <select class="form-select form-select-sm" value="@_testModelId"
                                        @onchange="e => _testModelId = e.Value?.ToString()">
                                    @foreach (var model in _testModels)
                                    {
                                        <option value="@model.ModelId" disabled="@(!model.CanCarryPose)">
                                            @model.DisplayName - @model.ProviderName (@model.MechanismLabel)
                                        </option>
                                    }
                                </select>
                                <span class="form-text">@TestMechanismHint()</span>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Seed (optional)</label>
                            <CommittedTextInput type="text" class="form-control form-control-sm" placeholder="random"
                                                Live="@_testSeed" LiveChanged="args => _testSeed = args" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold mb-1">Canvas</label>
                            <CommittedTextInput type="text" class="form-control form-control-sm"
                                                Live="@_testSize" LiveChanged="args => _testSize = args" />
                        </div>
                        <div class="col-md-3 d-grid">
                            <button type="button" class="btn btn-sm btn-primary"
                                    disabled="@(_busy || _testBusy || !CanTestPose())" @onclick="RunCurrentPoseTestAsync">
                                @if (_testBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <i class="bi bi-eye me-1"></i>Test this pose
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-semibold mb-0">Prompt</label>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                        disabled="@(_busy || string.IsNullOrWhiteSpace(_metaPrompt))"
                                        @onclick="UseMetadataPromptAsync">
                                    Use the pose's metadata prompt
                                </button>
                            </div>
                            <CommittedTextInput Multiline="true" class="form-control form-control-sm" rows="3"
                                                placeholder="A full-body photograph of a fully clothed person, natural skin texture, photorealistic, plain studio background, 85mm."
                                                Live="@_testPrompt" LiveChanged="args => _testPrompt = args" />
                            <span class="form-text">
                                The same wording for every pose, so a test compares poses rather than prompts. Square
                                canvas keeps the skeleton's own aspect. Note that a skeleton carries the body's shape but
                                not which way the figure faces — add a view clause here if the render needs a specific
                                facing.
                            </span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_testError))
                    {
                        <div class="alert alert-danger py-1 small mt-2 mb-0">@_testError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_testNote))
                    {
                        <div class="alert alert-info py-1 small mt-2 mb-0">@_testNote</div>
                    }
                </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Raised after a pose is saved, so the host can refresh its grid.</summary>
    [Parameter] public EventCallback<PosePreset> OnSaved { get; set; }

    /// <summary>
    /// A library pose the rig has been fitted onto, from the host page. When it arrives the panel continues from
    /// that pose instead of the bare rig, so every tool here works on a picked library pose as well as an authored
    /// one — which is the whole point of fitting it.
    /// </summary>
    [Parameter] public PoseRigFitResult? Loaded { get; set; }

    /// <summary>The preset <see cref="Loaded"/> came from, for the notice and the suggested name and category.</summary>
    [Parameter] public PosePreset? LoadedFrom { get; set; }

    /// <summary>
    /// The named views, from the one canonical list, so this panel, the head tool and the probe export cannot
    /// disagree about what "3/4 right" means.
    /// </summary>
    private static readonly (string Label, PoseView View)[] TargetViews = PoseNamedViews.BodyTargets;

    private PoseView _view = new();
    private PoseHeadRotation _head = new();

    /// <summary>
    /// The authoring step on screen. The four steps are one pose built in stages rather than four panels: body and
    /// head set the projection, drag edits joints on top of that projection, and test renders whatever is current.
    /// </summary>
    private string _activeTab = "body";

    /// <summary>
    /// The rig pose being projected, or null to project the natural standing stance. Non-null exactly when a
    /// library pose has been fitted, and it is what makes a loaded pose turn with real geometry.
    /// </summary>
    private Quaternion[]? _rotations;

    /// <summary>The id of the preset whose fit has already been adopted, so re-rendering does not reset the view.</summary>
    private string? _adoptedPresetId;

    /// <summary>
    /// The view and head as adopted, so "has this library pose been edited here?" is a comparison against a
    /// recorded point rather than a guess. This is what decides whether a test render sends the library's OWN
    /// skeleton or the rig's projection of it.
    /// </summary>
    private PoseView? _adoptedView;
    private PoseHeadRotation? _adoptedHead;

    /// <summary>
    /// Set when the drag editor saves a pose. It stores its result as its own preset rather than mutating this
    /// panel's fit, so from here on the library skeleton is no longer what the operator is looking at.
    /// </summary>
    private bool _nestedSaveSinceAdoption;
    private PosePreset? _loadedFrom;
    private string? _fitSummary;

    /// <summary>
    /// The loaded library pose's OWN keypoints, read once when the host hands it over. Held so the rig can supply the
    /// turn while this stays the pose: the hands, the face and the proportions are here and nowhere else, because the
    /// rig is body-only.
    /// </summary>
    private PosePerson? _storedPose;

    /// <summary>
    /// The operator's drags, as the drag editor reports them, or null while nothing has been dragged. Held HERE rather
    /// than inside the editor because three consumers need it — the preview, the skeleton a test render sends, and the
    /// pose a save writes — and the editor used to keep it private, which is why a drag appeared in its own canvas and
    /// nowhere else.
    /// </summary>
    private PosePerson? _draggedPose;

    /// <summary>
    /// The one transform every picture of this pose shares, computed ONCE from the pose being edited and then reused.
    /// Recomputing it per render re-scaled the figure whenever the pose's bounding box changed, so a turn that widened
    /// the box changed the SIZE of the figure instead of turning it.
    /// </summary>
    private PoseSkeletonRenderer.Framing? _framing;

    /// <summary>
    /// The canvas the pose lives on: the configured studio canvas, because that is what the rig projects onto. The
    /// framing, the drag editor's viewBox, the preview and the skeleton a test render sends all use this one number, so
    /// no picture has to be rescaled into another coordinate space.
    /// </summary>
    private int PoseCanvas => StudioOptions.Value.RequireCanvas();

    /// <summary>The projected pose the drag editor starts from. Rebuilt whenever the view or head changes, which is
    /// what the editor treats as "a new starting pose".</summary>
    private PosePerson _editorStart = new() { Body = [] };
    private IReadOnlyList<PoseLibrary> _libraries = [];
    private string? _previewUrl;
    private string? _name;
    private string? _category = "standing";
    private string? _keywords;
    private string? _libraryId;
    private string? _error;
    private string? _status;
    private bool _busy;

    private IReadOnlyList<PoseTestModelChoice> _testModels = [];
    private string? _testModelId;
    private string? _testPrompt;
    private string? _testSize = "1024x1024";
    private string? _testSeed;
    private string? _testImageUrl;
    private string? _testNote;
    private string? _testError;
    private bool _testBusy;

    /// <summary>The metadata the editor is holding, for the pose on screen.</summary>
    private PoseStance _metaStance = PoseStance.Unknown;
    private PoseFacingDirection _metaDirection = PoseFacingDirection.Unknown;
    private PoseCameraAngle _metaCamera = PoseCameraAngle.Unknown;
    private PoseContentRating _metaRating = PoseContentRating.Unrated;
    private string? _metaPrompt;

    /// <summary>
    /// True once the operator has typed in the prompt box. It is the one thing that stops a later field change from
    /// overwriting wording they wrote themselves, and the Recompose button is the way back.
    /// </summary>
    private bool _promptHandEdited;

    /// <summary>
    /// The choices each dropdown offers, taken from the enums themselves so a new stance or camera angle appears in
    /// the editor without a second list to keep in step.
    /// </summary>
    private static readonly PoseStance[] MetaStances = Enum.GetValues<PoseStance>();
    private static readonly PoseFacingDirection[] MetaDirections = Enum.GetValues<PoseFacingDirection>();
    private static readonly PoseCameraAngle[] MetaCameras = Enum.GetValues<PoseCameraAngle>();
    private static readonly PoseContentRating[] MetaRatings = Enum.GetValues<PoseContentRating>();

    /// <summary>The configured step, so the button and the geometry use one number and it is changed in one place.</summary>
    private double StepDegrees => StudioOptions.Value.RequireRotationStepDegrees();

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        try
        {
            var authored = await LibraryService.EnsureAuthoredLibraryAsync();
            _libraryId = authored.Id;
            await LoadLibrariesAsync();
            await RefreshPreviewAsync();

            // Offered, never assumed: the operator sees this text and can change it. On a reference-conditioned
            // model these words are the only thing that fixes which way the figure faces, so a silent default here
            // would be a hidden cause of "the pose rendered backwards".
            //
            // From PoseTestPrompts: one copy of the wording that was MEASURED to work, including the clause that
            // tells the model to take the pose from the reference image. The old default said "arms at their sides",
            // which contradicts every non-standing pose in the library.
            _testPrompt ??= PoseTestPrompts.Default;

            try
            {
                _testModels = await PoseTestRender.ListModelsAsync();

                // The first model that CAN carry a pose. The service orders the reference-image route ahead of the
                // ControlNet graph, so this lands on the mechanism the pose work is built on rather than on whatever
                // sorts first alphabetically (which was an SDXL ControlNet model).
                _testModelId = _testModels.FirstOrDefault(model => model.CanCarryPose)?.ModelId;
            }
            catch (Exception ex)
            {
                _testError = $"The test render could not list image models: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            _error = $"The authoring tool could not start: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private bool CanSave() => !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_category);

    /// <summary>
    /// True only when the SELECTED model can carry a pose. Gated on the model's own resolved capability rather than
    /// on the list being non-empty, so an incapable model is not offered a button whose only outcome is a refusal.
    /// </summary>
    private bool CanTestPose() =>
        _testModels.Any(model => model.ModelId == _testModelId && model.CanCarryPose);

    /// <summary>
    /// Names the mechanism the SELECTED model will use, from the list the render itself resolved, so the words on
    /// screen and the graph that runs cannot disagree. A model that cannot carry a pose says so here, with the
    /// resolver's reason, instead of failing only after a render.
    /// </summary>
    private string TestMechanismHint()
    {
        var selected = _testModels.FirstOrDefault(model => model.ModelId == _testModelId);
        if (selected is null)
        {
            return "Pick a model to see how it carries the pose.";
        }

        return selected.CanCarryPose
            ? $"This model carries the pose through: {selected.MechanismLabel}."
            : $"This model cannot carry a pose: {selected.Reason}";
    }

    /// <summary>
    /// Adopts a fitted library pose when the host hands over a new one. Guarded by the preset id because this runs
    /// on every parameter set, and adopting unconditionally would throw away the operator's view and head changes
    /// on every re-render.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Adopted on LoadedFrom alone: Loaded is null for a HEAD pose, because there is no body to fit, and requiring it
        // here would silently ignore the very poses the head path exists for.
        if (LoadedFrom is null) return;
        if (string.Equals(_adoptedPresetId, LoadedFrom.Id, StringComparison.Ordinal)) return;

        _adoptedPresetId = LoadedFrom.Id;
        _loadedFrom = LoadedFrom;
        _rotations = Loaded?.Rotations;

        // Read here and NOT in a try/catch: a pose whose keypoints cannot be read cannot be turned, and the host page
        // parses the same JSON before handing it over, so this failing means something is genuinely wrong. Failing
        // loudly beats silently falling back to the rig's approximation of a pose nobody can read.
        _storedPose = OpenPosePoseJson.Parse(LoadedFrom.KeypointsJson, LoadedFrom.Name);

        // A new pose is a new frame and a new set of drags. The framing is recomputed from THIS pose, so every picture
        // of it shares one frame for as long as it is open.
        _draggedPose = null;
        _framing = null;
        _view = Loaded?.View ?? new PoseView();
        _head = new PoseHeadRotation();
        _adoptedView = _view;
        _adoptedHead = _head;
        _nestedSaveSinceAdoption = false;

        // The pose's OWN name, not a "(edited)" variant. Save now writes over this pose, so a renamed field would
        // silently RENAME it in the library. Save As keeps this name too and the library refuses a duplicate in the
        // same library, which is the prompt to rename rather than a silent overwrite of some other pose.
        _name = LoadedFrom.Name;
        _category = LoadedFrom.Category;
        _keywords = LoadedFrom.Keywords;

        // The stored metadata, so the editor opens on what the pose actually says instead of on blank fields — and so
        // a save that changes nothing still writes back the values that were there.
        _metaStance = LoadedFrom.Stance;
        _metaDirection = LoadedFrom.Direction;
        _metaCamera = LoadedFrom.CameraAngle;
        _metaRating = LoadedFrom.ContentRating;
        _metaPrompt = LoadedFrom.MetadataPrompt;
        _promptHandEdited = false;

        // The residual is reported, never rounded away: a fitted pose is an approximation and the operator is the
        // one who decides whether it is close enough to edit from. The ambiguity flag matters more than the number,
        // because it says the TURN was not determined by the source pose at all.
        _fitSummary = Loaded is { } fit
            ? $"Rig fit: {fit.MeanErrorPercentOfHeight:0.0}% mean joint error"
                + (fit.OrientationAmbiguous
                    ? ", and the source pose did not determine the turn — check the facing before saving."
                    : ".")
            : "Head pose: there is no body to fit, so the Head step turns the FACE itself rather than a rig.";

        await RefreshPreviewAsync();
    }

    /// <summary>Drops the loaded pose and returns to authoring from the rig.</summary>
    private async Task ClearLoadedAsync()
    {
        _rotations = null;
        _loadedFrom = null;
        _storedPose = null;
        _draggedPose = null;
        _framing = null;
        _fitSummary = null;
        _adoptedPresetId = null;
        _adoptedView = null;
        _adoptedHead = null;
        _nestedSaveSinceAdoption = false;
        _view = new PoseView();
        _head = new PoseHeadRotation();
        _name = null;
        _metaStance = PoseStance.Unknown;
        _metaDirection = PoseFacingDirection.Unknown;
        _metaCamera = PoseCameraAngle.Unknown;
        _metaRating = PoseContentRating.Unrated;
        _metaPrompt = null;
        _promptHandEdited = false;
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// True when the loaded pose is a FACE pose: a face channel with no body worth fitting. The Body step's controls
    /// then drive the HEAD, because the rig's view cannot turn a face — <see cref="PoseFaceProxy.Project"/> reads the
    /// head and takes no view at all. Leaving the arrows on the view made every control in the step that opens by
    /// default do NOTHING on exactly the poses the head path exists for.
    /// </summary>
    private bool TurningTheHead =>
        _storedPose is { } pose && PoseFaceProxy.IsHeadPose(pose);

    /// <summary>
    /// The angle the readout names, read from whichever thing the Body step is actually turning. Reported rather than
    /// assumed: printing the view on a face pose showed a permanent 0° while the head turned underneath it.
    /// </summary>
    private double TurnYaw => TurningTheHead ? _head.YawDegrees : _view.YawDegrees;

    private double TurnPitch => TurningTheHead ? _head.PitchDegrees : _view.PitchDegrees;

    private double TurnRoll => TurningTheHead ? _head.RollDegrees : _view.RollDegrees;

    /// <summary>
    /// Whether <paramref name="view"/> is the turn currently applied — the highlight on the named views. Asked of the
    /// thing that is actually turning, so on a face pose it tracks the head and the highlight cannot sit on a named
    /// view that took no part. <see cref="PoseEdited"/> reads the same answer, which is what keeps "has this been
    /// edited?" honest for both kinds of pose.
    /// </summary>
    private bool IsCurrent(PoseView view) =>
        Math.Abs(view.YawDegrees - TurnYaw) < 0.001
        && Math.Abs(view.PitchDegrees - TurnPitch) < 0.001
        && Math.Abs(view.RollDegrees - TurnRoll) < 0.001;

    private async Task SetViewAsync(PoseView view)
    {
        // A drag belongs to the pose it was made on. Changing the view re-projects that pose, so keeping the old drags
        // would apply them to a different figure — the drag editor resets for the same reason.
        DiscardDrags();

        if (TurningTheHead)
        {
            // One set of named views, two things it can mean. A face pose has no body to turn, so the SAME names land
            // on the head: Front is straight ahead and a profile is 90° off it, exactly as they mean for the body.
            _head = PoseFaceProxy.AsHeadRotation(view);
        }
        else
        {
            _view = view;
        }

        await RefreshPreviewAsync();
    }

    private async Task RotateAsync(PoseRotationAxis axis, int steps)
    {
        DiscardDrags();

        if (TurningTheHead)
        {
            // The SAME axis, the SAME configured step and the same rotation core — aimed at the head, because the head
            // is the only part of a face pose there is to turn.
            _head = PoseHeadRotation.Step(_head, axis, steps, StudioOptions.Value);
        }
        else
        {
            _view = PoseProjection.Step(_view, axis, steps, StudioOptions.Value);
        }

        await RefreshPreviewAsync();
    }

    private Task ResetAsync() => SetViewAsync(new PoseView());

    /// <summary>
    /// Drops the operator's drags. The FRAMING is deliberately kept: it belongs to the pose being edited rather than
    /// to the view, so the figure keeps its size and its place across a turn.
    /// </summary>
    private void DiscardDrags() => _draggedPose = null;

    /// <summary>
    /// The head is part of the same pose, so changing it re-renders the body preview too — the figure the operator
    /// sees must be the figure that gets saved.
    /// </summary>
    private async Task OnHeadChangedAsync(PoseHeadRotation head)
    {
        DiscardDrags();
        _head = head;
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// The pose ON SCREEN, from ONE place, because three consumers must never disagree about it: the preview, the pose
    /// the drag editor starts from, and the skeleton a test render sends. They used to be three separate calls, and the
    /// consequence was a test render that could send something the operator had not been shown.
    ///
    /// A loaded library pose goes through the rig's TURN rather than the rig's shape, so it keeps its hands, its face
    /// and its proportions while gaining the turn.
    /// </summary>
    private PosePerson CurrentPose()
    {
        PosePerson raw;

        if (_storedPose is { } headPose && PoseFaceProxy.IsHeadPose(headPose))
        {
            // A head pose has no body to fit, so the rig cannot turn it. The SAME rigid rotation is applied to the FACE
            // instead — PoseFaceProxy borrows a head shape from the rig to supply the depths a flat face lacks.
            raw = PoseFaceProxy.Project(headPose, _head, StudioOptions.Value);
        }
        else if (_storedPose is { } stored && _adoptedView is { } fittedView && _rotations is { } rotations)
        {
            raw = LibraryService.ProjectLoadedPose(stored, fittedView, _view, rotations, _head);
        }
        else
        {
            raw = LibraryService.ProjectAuthoredPose(_view, _head, _rotations);
        }

        // Framed HERE, once for the life of the pose being edited: every later version of that pose goes through the
        // same transform, so the figure keeps its size and its place and a press reads as a rotation. The first call is
        // made at the view the rig was fitted to, where a loaded pose IS the library pose, so the frame is the one that
        // pose should have.
        return PoseSkeletonRenderer.Apply(raw, _framing ??= PoseSkeletonRenderer.ComputeFraming(raw, PoseCanvas));
    }

    /// <summary>The pose the operator is actually looking at: their drags when there are any, otherwise the base.</summary>
    private PosePerson PoseOnScreen() => _draggedPose ?? _editorStart;
    private Task RefreshPreviewAsync()
    {
        _error = null;

        // Base first, then the pose on screen: the drag editor starts from the BASE, while everything drawn or sent
        // comes from the pose on screen, which is the base until the operator drags something.
        _editorStart = CurrentPose();

        // The preview is ALWAYS our own drawing of this pose, never the library's file swapped for ours on the first
        // edit. That swap was not a subtle change of appearance: the pack's skeleton is 768x1152 and ours is drawn on a
        // 1024x1024 canvas (measured 2026-09-27), so the picture changed SHAPE as well as size the moment anything was
        // edited. Drawing the pose from the start means the frame never moves, and at the fitted view the keypoints ARE
        // the library pose's own, so the operator is still looking at the pose they picked.
        _previewUrl = "data:image/png;base64," + Convert.ToBase64String(
            PoseSkeletonRenderer.RenderPngWithoutFitting(PoseOnScreen(), PoseCanvas));

        return Task.CompletedTask;
    }

    /// <summary>
    /// The drag editor's report, and the only way its edits reach the preview and the render — which is what makes a
    /// drag visible in the body skeleton AND present in what a test render sends. A null pose means the drags were
    /// undone back to the base.
    /// </summary>
    private async Task OnDragChangedAsync(PosePerson? pose)
    {
        _draggedPose = pose;
        await RefreshPreviewAsync();
    }

    /// <summary>Raised by a nested tool (the drag editor) so the host refreshes exactly as a rig save does.</summary>
    private Task OnNestedSavedAsync(PosePreset preset)
    {
        // The drag editor stores the pose it produced as its own preset instead of mutating this panel's fit, so
        // without this the test render would keep sending the ORIGINAL library skeleton while the operator expects
        // the dragged one. Recorded here so the test names what it actually sent.
        _nestedSaveSinceAdoption = true;
        return OnSaved.InvokeAsync(preset);
    }

    /// <summary>
    /// True when the pose on screen no longer IS the library pose that was adopted — a view change, a head change,
    /// or a drag-editor save. Compared against the adoption point rather than tracked by a flag on every action,
    /// so it cannot drift from what the operator actually changed.
    /// </summary>
    private bool PoseEdited()
    {
        if (_loadedFrom is null) return true;
        if (_draggedPose is not null) return true;
        if (_nestedSaveSinceAdoption) return true;
        if (_adoptedView is not null && !IsCurrent(_adoptedView)) return true;
        return _adoptedHead is not null && !_head.Equals(_adoptedHead);
    }

    private async Task LoadLibrariesAsync()
    {
        var all = await LibraryService.ListLibrariesAsync();
        // A pack is rebuilt on every import, so an authored pose cannot live there; the UI only offers libraries
        // that can actually accept one.
        _libraries = all.Where(library => !library.IsSystem).ToArray();

        if (_libraryId is null || _libraries.All(library => library.Id != _libraryId))
        {
            _libraryId = _libraries.FirstOrDefault()?.Id;
        }
    }

    /// <summary>
    /// SAVE: writes the pose and metadata on screen over the row they came from.
    ///
    /// A pose that has never been stored has no row to write over, so the first Save creates one and this panel adopts
    /// it — from then on the same button overwrites that row instead of piling up a copy per press. Save As is the
    /// button that deliberately makes another.
    /// </summary>
    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        _status = null;
        try
        {
            var overwriting = _loadedFrom is not null;
            var preset = overwriting
                ? await LibraryService.OverwritePoseAsync(_loadedFrom!.Id, BuildRequest())
                : await LibraryService.SaveAuthoredPoseAsync(BuildRequest());

            // Adopted either way, so the next Save writes over the pose just written rather than creating a second one.
            _loadedFrom = preset;
            _status = overwriting
                ? $"Overwrote '{preset.Name}' with the pose and metadata on screen."
                : $"Saved '{preset.Name}' as a new pose. Save writes over it from now on; Save As makes another.";
            await OnSaved.InvokeAsync(preset);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// SAVE AS: stores the pose on screen as a NEW pose and leaves the row it was loaded from untouched.
    ///
    /// It keeps the same name, and a library refuses two poses of the same name, so loading a library pose and pressing
    /// Save As is refused until the operator renames it. That refusal is the intended behaviour: the alternative is
    /// guessing which of two identically named poses the next render meant.
    /// </summary>
    private async Task SaveAsAsync()
    {
        _busy = true;
        _error = null;
        _status = null;
        try
        {
            var preset = await LibraryService.SaveAuthoredPoseAsync(BuildRequest());
            _loadedFrom = preset;
            _status = $"Saved '{preset.Name}' as a new pose. Save writes over it from now on; Save As makes another.";
            await OnSaved.InvokeAsync(preset);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// The save for the pose ON SCREEN, built in one place so Save and Save As cannot write different poses: the
    /// keypoints, the origin and the metadata are identical for both, and the only difference between them is which row
    /// the result lands on.
    /// </summary>
    private AuthoredPoseRequest BuildRequest() => new(
        _name ?? string.Empty,
        _category ?? string.Empty,
        _keywords,
        _view,
        _libraryId ?? string.Empty,
        _head,
        // A fitted pose is saved as the KEYPOINTS on screen, drags included. Saving it as a view would
        // re-derive the figure from the standing stance and silently discard the fit — the operator would get a
        // different pose from the one on screen, described by a recipe that says otherwise.
        //
        // The test is "is a pose loaded" rather than "does it have rig rotations": a FACE pose is loaded and has
        // NO rotations, so gating on rotations alone re-projected the rig and saved a standing MANNEQUIN with the
        // turned head on it — a full body in place of the face the operator had just turned.
        Keypoints: _storedPose is null && _draggedPose is null ? null : PoseOnScreen(),
        // Named so the keywords and the provenance say what made it. With the default, a turned face would have
        // been recorded as "dragged", which is a different act by a different tool.
        Origin: TurningTheHead ? "head-turned" : null,
        Metadata: new PoseMetadataEdit(
            _metaStance, _metaDirection, _metaCamera, _metaRating, _metaPrompt ?? string.Empty));

    /// <summary>
    /// Reads one of the panel's OWN dropdown values. Throws rather than defaulting: these options are rendered from the
    /// enum itself, so a value that will not parse means the markup and the enum disagree, and quietly landing on
    /// "not declared" would store that disagreement as the pose's metadata.
    /// </summary>
    private static T ParseMetadataChoice<T>(string? value, string field) where T : struct, Enum =>
        Enum.TryParse<T>(value, out var parsed)
            ? parsed
            : throw new InvalidOperationException(
                $"'{value}' is not a {field} this editor offers, so nothing was changed.");

    private Task SetStanceAsync(string? value)
    {
        _metaStance = ParseMetadataChoice<PoseStance>(value, "stance");
        return RecomposeUnlessHandEditedAsync();
    }

    private Task SetDirectionAsync(string? value)
    {
        _metaDirection = ParseMetadataChoice<PoseFacingDirection>(value, "direction");
        return RecomposeUnlessHandEditedAsync();
    }

    private Task SetCameraAsync(string? value)
    {
        _metaCamera = ParseMetadataChoice<PoseCameraAngle>(value, "camera angle");
        return RecomposeUnlessHandEditedAsync();
    }

    private Task SetRatingAsync(string? value)
    {
        _metaRating = ParseMetadataChoice<PoseContentRating>(value, "content rating");
        return RecomposeUnlessHandEditedAsync();
    }

    /// <summary>
    /// Records that the operator typed their own prompt. Set from the input event rather than by comparing the text
    /// against the composed one, because the two can coincide — a prompt typed to match the fields is still the
    /// operator's own wording.
    /// </summary>
    private void OnMetadataPromptInput(string? text)
    {
        _metaPrompt = text;
        _promptHandEdited = true;
    }

    /// <summary>Puts the composed prompt back, which is also what makes the box composed again.</summary>
    private Task RecomposeAsync()
    {
        _promptHandEdited = false;
        _metaPrompt = ComposeMetadataPrompt();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Rewrites the prompt from the metadata fields unless the operator has written their own wording. The four fields
    /// ARE the description, so keeping the prompt in step with them is the common case; their own text survives an
    /// unrelated field change, and Recompose is the way back.
    /// </summary>
    private Task RecomposeUnlessHandEditedAsync()
    {
        if (!_promptHandEdited) _metaPrompt = ComposeMetadataPrompt();
        return Task.CompletedTask;
    }

    /// <summary>
    /// The prompt the current fields compose, from the ONE composer the importer and the backfill also use — so a pose
    /// edited here and a pose filled from its pack are worded identically rather than by two implementations.
    /// </summary>
    private string ComposeMetadataPrompt() => PoseMetadataPrompt.Compose(new PoseMetadata(
        Stance: _metaStance,
        Direction: _metaDirection,
        Camera: _metaCamera,
        Rating: _metaRating,
        Prompt: string.Empty,
        NeedsReview: false,
        ReviewNote: string.Empty));

    /// <summary>
    /// Copies the pose's metadata prompt into the Test tab's box.
    ///
    /// A button rather than a silent substitution: the test's own wording is one fixed sentence so that a test compares
    /// POSES, and swapping it behind the operator's back would make two runs differ for a reason they did not choose.
    /// </summary>
    private Task UseMetadataPromptAsync()
    {
        _testPrompt = _metaPrompt;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Renders one throwaway image of the pose ON SCREEN. It conditions on the same bytes a real render would use —
    /// the panel's current projection, fitted to the canvas — so a pose nudged by 5° can be tested without saving it
    /// first. Nothing is persisted.
    /// </summary>
    private async Task RunCurrentPoseTestAsync()
    {
        _testBusy = true;
        _testError = null;
        _testNote = null;
        _testImageUrl = null;
        try
        {
            long? seed = null;
            if (!string.IsNullOrWhiteSpace(_testSeed))
            {
                // Refused rather than ignored: a seed that silently became "random" would make two runs differ for a
                // reason the operator cannot see.
                if (!long.TryParse(_testSeed.Trim(), out var parsed))
                {
                    throw new InvalidOperationException(
                        $"'{_testSeed}' is not a whole-number seed. Leave it blank for a random one.");
                }

                seed = parsed;
            }

            // WHAT gets tested is named explicitly, because the two objects are not the same thing. An untouched
            // library pose is tested as the LIBRARY'S OWN skeleton — the bytes the operator selected — while a pose
            // edited here is tested as the rig's projection, which is an approximation. Sending the projection for an
            // untouched library pose is what made every all-fours test come back "contorted, not following the pose
            // reference" (reported 2026-09-25): the fit of a quadruped stance onto a standing rig is exactly where
            // that approximation is worst, and the panel previewed the pack skeleton while sending something else.
            byte[] skeleton;
            string sent;
            if (_loadedFrom is not null && !string.IsNullOrWhiteSpace(_loadedFrom.SkeletonPngPath) && !PoseEdited())
            {
                skeleton = await LibraryService.ReadSkeletonAsync(_loadedFrom.Id);
                sent = $"the library skeleton for '{_loadedFrom.Name}'";
            }
            else
            {
                // RenderPngWithoutFitting: the pose on screen is ALREADY framed, and re-fitting it here would send a
                // skeleton the operator was never shown — which is how a dragged pose came to be left out of a test.
                skeleton = PoseSkeletonRenderer.RenderPngWithoutFitting(PoseOnScreen(), PoseCanvas);
                sent = _loadedFrom is null
                    ? "the rig projection of the pose on screen"
                    : $"'{_loadedFrom.Name}' with the rig's turn applied to its own keypoints, so its hands are kept";
            }

            var result = await PoseTestRender.RenderAsync(new PoseTestRenderRequest(
                skeleton,
                _loadedFrom?.Name ?? "the authored pose",
                _testModelId ?? string.Empty,
                _testPrompt ?? string.Empty,
                _testSize,
                seed));

            _testImageUrl = "data:image/png;base64," + Convert.ToBase64String(result.Image);
            _testNote = $"Sent {sent}. Carried the pose through: {result.Mechanism}. {result.Note}";
        }
        catch (Exception ex)
        {
            _testError = ex.Message;
        }
        finally
        {
            _testBusy = false;
        }
    }

    /// <summary>Preview render size. Smaller than the saved skeleton, which is rendered at the full canvas.</summary>
    /// <remarks>
    /// Retired: the preview is now rendered on <see cref="PoseCanvas"/> itself and left to the browser to scale, so
    /// what is on screen and what a render is sent are the same picture in the same coordinate space. Kept as a note
    /// so the number is not reintroduced by accident.
    /// </remarks>
}
