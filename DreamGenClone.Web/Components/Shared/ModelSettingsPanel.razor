@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Web.Domain.Models
@using DreamGenClone.Web.Application.Models

@inject IModelSettingsService ModelSettingsService
@inject IRegisteredModelRepository ModelRepository
@inject IFunctionDefaultRepository FunctionDefaultRepository

<div class="rw-settings-section">
    <div class="rw-settings-section-label">Model Settings</div>

    <div class="rw-settings-section">
        <span class="rw-settings-small-label">Model</span>
        <select id="model-@SessionId" class="rw-mode-select" @bind="SelectedModelId" @bind:event="onchange" @bind:after="OnModelChanged">
            <option value="">(Use Function Default)</option>
            @foreach (var group in _groupedModels)
            {
                <optgroup label="@group.Key">
                    @foreach (var model in group.Value)
                    {
                        <option value="@model.Id">@(model.DisplayName ?? model.ModelIdentifier)</option>
                    }
                </optgroup>
            }
        </select>
    </div>

    <div class="rw-settings-section">
        <div class="rw-settings-row">
            <span class="rw-settings-small-label">Temperature</span>
            <span class="rw-settings-small-label" style="margin-left:auto">@CurrentSettings.Temperature.ToString("F2")</span>
        </div>
        <input type="range" id="temperature-@SessionId" class="rw-settings-input" min="0" max="2" step="0.1" @bind="CurrentSettings.Temperature" @bind:event="oninput" @onchange="OnSettingsChanged" style="padding:0;" />
    </div>

    <div class="rw-settings-section">
        <div class="rw-settings-row">
            <span class="rw-settings-small-label">Top-P</span>
            <span class="rw-settings-small-label" style="margin-left:auto">@CurrentSettings.TopP.ToString("F2")</span>
        </div>
        <input type="range" id="topp-@SessionId" class="rw-settings-input" min="0" max="1" step="0.05" @bind="CurrentSettings.TopP" @bind:event="oninput" @onchange="OnSettingsChanged" style="padding:0;" />
    </div>

    <div class="rw-settings-section">
        <div class="rw-settings-row">
            <span class="rw-settings-small-label">Max Tokens</span>
            <span class="rw-settings-small-label" style="margin-left:auto">@CurrentSettings.MaxTokens</span>
        </div>
        <input type="number" id="maxtokens-@SessionId" class="rw-settings-input" min="50" max="16000" step="50" @bind="CurrentSettings.MaxTokens" @bind:event="oninput" @onchange="OnSettingsChanged" />
    </div>

    <div class="rw-settings-section">
        <div class="rw-settings-row">
            <span class="rw-settings-small-label">Context Window (turns)</span>
            <span class="rw-settings-small-label" style="margin-left:auto">@(CurrentSettings.ContextWindowSize > 0 ? CurrentSettings.ContextWindowSize : 30)</span>
        </div>
        <input type="number" id="contextwindow-@SessionId" class="rw-settings-input" min="4" max="60" step="1" @bind="CurrentSettings.ContextWindowSize" @bind:event="oninput" @onchange="OnSettingsChanged" />
        <span class="rw-settings-small-label" style="font-size:11px;">Number of recent turns sent to the model. Lower = smaller request. Default: 30.</span>
    </div>
</div>

@code {
    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnSettingsUpdated { get; set; }

    private ModelSettings CurrentSettings { get; set; } = new();
    private string SelectedModelId { get; set; } = string.Empty;
    private Dictionary<string, List<RegisteredModel>> _groupedModels = new();
    private FunctionModelDefault? _functionDefault;
    private bool _initialized;

    protected override async Task OnParametersSetAsync()
    {
        _functionDefault = await FunctionDefaultRepository.GetByFunctionAsync(AppFunction.RolePlayGeneration);

        var enabledModels = await ModelRepository.GetAllEnabledAsync();
        _groupedModels = enabledModels
            .GroupBy(m => m.ProviderName ?? "Unknown")
            .ToDictionary(g => g.Key, g => g.ToList());

        if (!string.IsNullOrEmpty(SessionId))
        {
            CurrentSettings = ModelSettingsService.GetSettings(SessionId);
            SelectedModelId = CurrentSettings.SessionModelId ?? string.Empty;

            // On first load, if no model override is set, show function default values
            if (!_initialized && !CurrentSettings.HasOverride && _functionDefault is not null)
            {
                CurrentSettings.Temperature = _functionDefault.Temperature;
                CurrentSettings.TopP = _functionDefault.TopP;
                CurrentSettings.MaxTokens = _functionDefault.MaxTokens;
                ModelSettingsService.UpdateSettings(SessionId, CurrentSettings);
            }
            _initialized = true;
        }
    }

    private async Task OnModelChanged()
    {
        CurrentSettings.SessionModelId = string.IsNullOrEmpty(SelectedModelId) ? null : SelectedModelId;

        // When model changes, reset sliders to function default values
        if (_functionDefault is not null)
        {
            CurrentSettings.Temperature = _functionDefault.Temperature;
            CurrentSettings.TopP = _functionDefault.TopP;
            CurrentSettings.MaxTokens = _functionDefault.MaxTokens;
        }

        await OnSettingsChanged();
    }

    private async Task OnSettingsChanged()
    {
        if (!string.IsNullOrEmpty(SessionId))
        {
            ModelSettingsService.UpdateSettings(SessionId, CurrentSettings);
            await OnSettingsUpdated.InvokeAsync();
        }
    }
}
