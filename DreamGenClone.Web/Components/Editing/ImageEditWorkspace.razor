            return;

        _cropDragRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("rolePlayWorkspace.initCropDrag", $"#{CropStageId}", _cropDragRef);
            _cropDragInitializedStage = CropStageId;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is going away; the listener goes with it.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Image edit workspace crop drag could not be initialised: Subject={Subject}", SubjectKey);
        }
