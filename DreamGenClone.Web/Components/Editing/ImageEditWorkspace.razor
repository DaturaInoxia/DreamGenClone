                            }
                        </div>
                    </div>
                </div>

                <div class="scene-edit-lineage">
                    @foreach (var image in _lineage)
                    {
                        <div class="scene-edit-lineage-item @(image.ImageId == _source.ImageId ? "is-current" : "")">
                            @if (image.IsComplete && !string.IsNullOrWhiteSpace(image.FileRelativePath))
                            {
                                <img src="/scene-images/@image.FileRelativePath" alt="@(image.IsEdit ? "Edited lineage image" : "Original lineage image")" class="scene-edit-lineage-thumb" />
                            }
                            else
                            {
                                <div class="scene-edit-lineage-thumb scene-edit-lineage-thumb-state">@image.StatusText</div>
                            }
                            <div class="scene-edit-lineage-meta">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge @(image.IsEdit ? "bg-info text-dark" : "bg-secondary")">@(image.IsEdit ? "Edit" : "Source")</span>
                                    <span class="text-muted small">@image.StatusText · @image.CreatedUtc.ToLocalTime().ToString("g")</span>
                                </div>
                                <span class="font-monospace small text-muted">@image.ImageId</span>
                                @if (image.IsEdit && !string.IsNullOrWhiteSpace(image.PromptSnapshot))
                                {
                                    <details class="scene-edit-lineage-prompt">
                                        <summary>Exact edit prompt</summary>
                                        <div>@image.PromptSnapshot</div>
                                    </details>
                                }
                            </div>
                            @if (EditImageUrlFactory is not null && image.IsComplete && !string.IsNullOrWhiteSpace(image.FileRelativePath))
                            {
                                <a class="btn btn-sm btn-outline-primary ms-auto" href="@EditImageUrlFactory(image.ImageId)">
                                    <i class="bi bi-pencil-square me-1"></i> Edit image
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    }
}

