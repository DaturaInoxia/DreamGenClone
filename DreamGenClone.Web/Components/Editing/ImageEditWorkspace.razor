    private async Task LoadCropDefaultsAsync()
    {
        _cropSettingsError = string.Empty;
        try
        {
            var settings = await WorkflowTemplates.ResolveSettingsAsync(null);
            _cropAspect = settings.CropTargetAspect;
            _cropHeadroomPercent = settings.CropHeadroomPercent;

            if (_cropAspect is not { } aspect || aspect <= 0)
            {
                _cropSettingsError =
                    "Missing required configuration 'CropTargetAspect': set it in the reference workflow settings before cropping.";
            }
            else if (_cropHeadroomPercent is not { } headroom || headroom is < 0 or > 100)
            {
                _cropSettingsError =
                    "Missing required configuration 'CropHeadroomPercent': set it in the reference workflow settings before cropping.";
            }
        }
        catch (Exception ex)
        {
            _cropSettingsError = $"Crop settings could not be resolved: {ex.Message}";
            Logger.LogWarning(ex, "Image edit workspace crop settings load failed: Subject={Subject}", SubjectKey);
        }

        // Head-aware placement needs a measurement; never leave a stale mode selected.
        if (EffectiveHeadMeasurement is null)
        {
            _cropMode = ImageCropMode.Framing;
        }

        RecomputeCropPreview();
    }

