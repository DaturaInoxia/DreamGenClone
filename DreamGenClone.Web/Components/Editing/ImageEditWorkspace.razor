    /// button's reason says why.
    /// </summary>
    private void RecomputeCropPreview()
    {
        // A dragged window IS the preview: recomputing it here would throw the drag away.
        if (_cropMode == ImageCropMode.Manual)
            return;

        _cropRect = null;
        if (_sourcePixelSize is not { } size
            || _cropAspect is not { } aspect
            || _cropHeadroomPercent is not { } headroom)
        {
            return;
        }

        try
        {
            var settings = new ImageCropSettings(aspect, headroom, _cropOffsetPercent);
            _cropRect = _cropMode switch
            {
                ImageCropMode.HeadAware => ImageCropCalculator.ComputeHeadAware(
                    size.Width, size.Height, settings, EffectiveHeadMeasurement),
                ImageCropMode.HeadFramed => ImageCropCalculator.ComputeHeadFramed(
                    size.Width, size.Height, settings, EffectiveHeadMeasurement),
                _ => ImageCropCalculator.Compute(size.Width, size.Height, settings)
            };
        }
        catch (InvalidOperationException)
        {
            _cropRect = null;
        }
    }

    private MediaEditCropOperation BuildCropOperation()
    {
        if (_cropAspect is not { } aspect || aspect <= 0)
            throw new InvalidOperationException("A positive crop target aspect is required.");
        if (_cropHeadroomPercent is not { } headroom)
            throw new InvalidOperationException("A crop headroom percent is required.");

        var settings = new ImageCropSettings(aspect, headroom, _cropOffsetPercent);
        if (_cropMode == ImageCropMode.Manual)
            return new MediaEditCropOperation(_cropMode, settings, null, _cropRect);

        var measurement = _cropMode is ImageCropMode.HeadAware or ImageCropMode.HeadFramed
            ? EffectiveHeadMeasurement
            : null;
        return new MediaEditCropOperation(_cropMode, settings, measurement);
    }

    /// <summary>
    /// Takes the head measurement in place, so head-aware cropping does not depend on another screen having
    /// measured the image first. A tool that finds no face is reported, never substituted with a guess.
    /// </summary>
    private async Task MeasureHeadAsync()
    {
        if (_source is null)
            return;

        await RunAsync(async () =>
        {
            var head = await HeadMeasurements.MeasureAsync(Subject);
            if (head is null)
            {
                _measuredHead = null;
                _statusMessage = "The measurement tool found no face in this image, so head-aware placement is unavailable here.";
                RecomputeCropPreview();
                return;
            }

            // A measurement with a face box can frame the head itself; one without it can only place a
            // framing-sized window by head height. Never invent the box.
            _measuredHead = new ImageCropHeadMeasurement(
                head.ForeheadTopY,
                head.ChinY,
                head.Face is { } face ? new ImageCropFaceBox(face.X, face.Y, face.Width, face.Height) : null);
            _cropMode = _measuredHead.Face is null ? ImageCropMode.HeadAware : ImageCropMode.HeadFramed;
            _statusMessage = _measuredHead.Face is null
                ? $"Head measured: {head.HeadHeightPx}px from hairline to chin (no face box, so head framing is unavailable)."
                : $"Head measured: {head.HeadHeightPx}px from hairline to chin.";
            RecomputeCropPreview();
        });
    }

