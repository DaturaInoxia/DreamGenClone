    /// <summary>
    /// The rectangle the run is confined to, or null for a whole-frame edit. The grow and feather values in force are
    /// applied HERE, from the controls, so what the run records is what the panel showed - not whatever value happened
    /// to be stored when the box was drawn.
    /// </summary>
    private MediaEditRegionOperation? BuildRegionOperation()
    {
        if (!_regionEnabled)
            return null;
        if (_region is not { } region)
        {
            throw new InvalidOperationException(
                "A region edit needs the region that was drawn; draw one, or turn the region off to edit the whole frame.");
        }

        if (_regionGrowMaskBy is not { } grow || grow is < 0 or > 64)
            throw new InvalidOperationException("A region grow value between 0 and 64 is required.");
        if (_regionFeatherPixels is not { } feather || feather < 0)
            throw new InvalidOperationException("A region feather that is not negative is required.");

        return region with { GrowMaskBy = grow, FeatherPixels = feather };
    }

    private MediaEditEnhanceOperation BuildEnhanceOperation()
    {
        if (string.IsNullOrWhiteSpace(_enhanceUpscalerModelName))
            throw new InvalidOperationException("A configured upscale model name is required.");
        if (_enhanceTargetLongEdge is not { } edge)
            throw new InvalidOperationException("A target long edge is required.");

        return new MediaEditEnhanceOperation(_enhanceUpscalerModelName, edge);
    }

