        public string ReferenceAssetId { get; set; } = string.Empty;
        public IReadOnlyList<SceneImageReferenceAsset>? Faces { get; set; }
        public bool IsBound => !string.IsNullOrWhiteSpace(CharacterId) && !string.IsNullOrWhiteSpace(ReferenceAssetId);
    }

    private void SyncIdentityTargetSelections()
    {
        var targets = _compilationResult?.Status == SceneImageEditCompilationResultStatus.Ready
            ? _compilationResult.Targets
            : [];
        var existing = _identityTargetSelections.ToDictionary(item => item.Target.Key, StringComparer.Ordinal);
        _identityTargetSelections.Clear();
        foreach (var target in targets)
        {
            if (existing.TryGetValue(target.Key, out var current))
            {
                current.Target = target;
                _identityTargetSelections.Add(current);
                continue;
            }

            _identityTargetSelections.Add(new EditIdentityTargetSelection { Target = target });
        }
    }

    private async Task SetIdentityTargetCharacterAsync(EditIdentityTargetSelection target, ChangeEventArgs args)
    {
        var characterId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(characterId))
        {
            target.CharacterId = string.Empty;
            target.CharacterName = string.Empty;
            target.ReferenceAssetId = string.Empty;
            target.Faces = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var choice = _identityCharacters.FirstOrDefault(item => string.Equals(item.CharacterId, characterId, StringComparison.Ordinal));
        target.CharacterId = choice?.CharacterId ?? characterId;
        target.CharacterName = choice?.CharacterName ?? string.Empty;
        target.Faces = choice?.Faces ?? [];
        target.ReferenceAssetId = choice is null
            ? string.Empty
            : ResolvePreferredIdentityFace(choice, target.Target.HeadView);
        _openFacePickerTargetKey = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Prefer the approved pack face whose angle matches the vision-detected head direction; fall
    /// back to the pack's configured canonical face, then the first approved face. Never invents a
    /// face: every candidate is an approved asset of the character's approved pack.
    /// </summary>
    private static string ResolvePreferredIdentityFace(ImageIdentityCharacterChoice choice, SceneImageReferenceFaceView? headView)
    {
        if (headView is { } view)
        {
            var matched = choice.Faces.FirstOrDefault(face => face.FaceView == view);
            if (matched is not null)
                return matched.Id;
        }

        var canonical = choice.Faces.FirstOrDefault(face => string.Equals(face.Id, choice.CanonicalFaceAssetId, StringComparison.Ordinal));
        return canonical?.Id ?? choice.Faces.FirstOrDefault()?.Id ?? string.Empty;
    }

    private static string IdentityFacePlaceholder(EditIdentityTargetSelection target) => target.Faces switch
    {
        null => "Select a character first…",
        { Count: 0 } => "No approved face in this pack…",
        _ => "No face selected…"
    };

    private void ToggleIdentityFacePicker(string targetKey)
        => _openFacePickerTargetKey = string.Equals(_openFacePickerTargetKey, targetKey, StringComparison.Ordinal)
            ? string.Empty
            : targetKey;

    private void CloseIdentityFacePicker() => _openFacePickerTargetKey = string.Empty;

    private async Task SelectIdentityFaceAsync(EditIdentityTargetSelection target, string assetId)
    {
        target.ReferenceAssetId = assetId;
        _openFacePickerTargetKey = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task IdentityPrepareAsync()
    {
        if (_service is null || _session is null)
            return;

        await RunAsync(async () =>
        {
            await StartNewSessionIfCompletedAsync();
            _attempt = await _service.PrepareAsync(_session.Id, IdentityAnalysisIntent, []);
            _preparedIntent = IdentityAnalysisIntent;
            _compilationResult = null;
            _identityTargetSelections.Clear();
            _activeRevision = null;
            _editablePrompt = string.Empty;
            _statusMessage = "Identity analysis queued.";
            EnsurePolling();
        });
    }

    private async Task RunIdentityEditAsync()
    {
        if (_identityService is null || _source is null)
            return;

        await RunAsync(async () =>
        {
            var selections = _identityTargetSelections
                .Where(target => target.IsBound)
                .Select(target => new ImageIdentitySelection(
                    target.Target.Key,
                    target.Target.VisibleLocator,
                    target.Target.Region,
                    target.CharacterId,
                    target.CharacterName,
                    target.ReferenceAssetId))
                .ToList();

            // The model chosen in this form, passed through unchanged — the identity run never resolves one.
            _result = await _identityService.RunIdentityEditAsync(Subject, selections, _selectedEditorModelId!);
            _statusMessage = "Identity correction queued.";
            EnsurePolling();
        });
    }

    private async Task LoadIdentityRosterAsync()
    {
        _identityCharacters = [];
        _identityRosterStatus = string.Empty;
        if (_identityService is null || _session is null)
            return;

        try
        {
            var roster = await _identityService.LoadRosterAsync(Subject);
            _identityCharacters = roster.Characters;
            _identityRosterStatus = roster.UnavailableReason ?? string.Empty;
        }
        catch (Exception ex)
        {
            _identityRosterStatus = $"Identity packs could not be loaded: {ex.Message}";
            Logger.LogWarning(ex, "Image edit workspace identity roster load failed: Subject={Subject}", SubjectKey);
        }
    }

    private static string IdentityFaceLabel(SceneImageReferenceAsset face)
        => $"{FaceViewLabel(face.FaceView)} · {face.QualityRating}";

    private static string FaceViewLabel(SceneImageReferenceFaceView? view) => view switch
    {
        SceneImageReferenceFaceView.Front => "Front",
        SceneImageReferenceFaceView.ThreeQuarterLeft => "3/4 left",
        SceneImageReferenceFaceView.ThreeQuarterRight => "3/4 right",
        SceneImageReferenceFaceView.ProfileLeft => "Profile left",
        SceneImageReferenceFaceView.ProfileRight => "Profile right",
        _ => "Front"
    };

    private static SceneImageEditCompilationResult? ParseResult(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return null;

        return JsonSerializer.Deserialize<SceneImageEditCompilationResult>(json, JsonOptions)
            ?? throw new InvalidOperationException("The stored compiler result is invalid.");
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _errorMessage = string.Empty;
        _statusMessage = string.Empty;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Logger.LogWarning(ex, "Image edit workspace action failed: Subject={Subject}", SubjectKey);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private bool HasInFlightWork()
    {
        if (_descriptionPending)
            return true;
        if (_attempt?.IsInFlight == true)
            return true;
        return _result?.IsInFlight == true;
    }

    private void EnsurePolling()
    {
        if (_polling)
            return;

        _polling = true;
        _pollingCts = new CancellationTokenSource();
        _pollingTask = Task.Run(() => PollAsync(_pollingCts.Token));
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var stillWorking = false;
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await RefreshAsync();
                    }
                    catch (Exception ex)
                    {
                        _errorMessage = $"Refresh failed: {ex.Message}";
                        Logger.LogWarning(ex, "Image edit workspace poll failed: Subject={Subject}", SubjectKey);
                    }

                    stillWorking = HasInFlightWork();
                    StateHasChanged();
                });
                if (!stillWorking)
                    break;
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            _polling = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_regionDragInitializedStage is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("rolePlayWorkspace.disposeCropDrag", $"#{_regionDragInitializedStage}");
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; there is nothing left to detach from.
            }
            catch (JSException)
            {
                // Teardown must not throw a second time over a missing element.
            }
        }

        if (_cropDragInitializedStage is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("rolePlayWorkspace.disposeCropDrag", $"#{_cropDragInitializedStage}");
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; there is nothing left to detach from.
            }
            catch (JSException)
            {
                // Teardown must not throw a second time over a missing element.
            }
        }

        _cropDragRef?.Dispose();
        _cropDragRef = null;
        _cropDragInitializedStage = null;
        _regionDragInitializedStage = null;

        var source = _pollingCts;
        _pollingCts = null;
        if (source is null)
            return;

        try
        {
            await source.CancelAsync();
        }
        catch (ObjectDisposedException) { }

        source.Dispose();
    }
}
