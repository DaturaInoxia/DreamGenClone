        }
    }

    /// <summary>
    /// Receives the region drag from the same page script the crop stage uses, with stage-normalized pointer
    /// coordinates. The script reports only the pointer and which corner was grabbed; what that means for the
    /// rectangle is decided here, by the one calculator the tests cover.
    /// </summary>
    [JSInvokable]
    public Task OnRegionDragAsync(string phase, string handle, double normalizedX, double normalizedY)
    {
        var xPercent = normalizedX * 100;
        var yPercent = normalizedY * 100;

        if (string.Equals(phase, "start", StringComparison.Ordinal))
        {
            _regionDragHandle = handle;
            _regionDragStartRegion = _region;
            _regionDragStartXPercent = xPercent;
            _regionDragStartYPercent = yPercent;

            // A press that landed on neither the window nor a corner begins a NEW box: that is how a region is drawn.
            if (string.IsNullOrEmpty(handle))
                _region = null;

            return Task.CompletedTask;
        }

        if (_regionGrowMaskBy is not { } grow || _regionFeatherPixels is not { } feather)
            return Task.CompletedTask;

        MediaEditRegionOperation? updated;
        if (string.IsNullOrEmpty(handle))
        {
            updated = RegionDragCalculator.Draw(_regionDragStartXPercent, _regionDragStartYPercent, xPercent, yPercent, grow, feather);
        }
        else if (_regionDragStartRegion is not { } start)
        {
            updated = _region;
        }
        else if (RegionDragCalculator.IsResizeHandle(handle))
        {
            updated = RegionDragCalculator.Resize(start, handle, xPercent - _regionDragStartXPercent, yPercent - _regionDragStartYPercent);
        }
        else
        {
            updated = RegionDragCalculator.Move(start, xPercent - _regionDragStartXPercent, yPercent - _regionDragStartYPercent);
        }

        // A draw that is still too small to be a selection leaves no rectangle at all: the reason below says so, which
        // is better than queueing an edit confined to a sliver the operator only brushed across.
        if (updated is not null)
            _region = updated;

        if (string.Equals(phase, "end", StringComparison.Ordinal))
            _regionDragHandle = null;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnRegionEnabledChanged(ChangeEventArgs args)
    {
        _regionEnabled = args.Value is bool enabled && enabled;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Receives the crop drag from the page script with stage-normalized pointer coordinates, so this
    /// component decides the window (and can be tested) while the script only reports the pointer.
    /// </summary>
    [JSInvokable]
    public Task OnCropDragAsync(string phase, string handle, double normalizedX, double normalizedY)
    {
        if (_sourcePixelSize is not { } size)
            return Task.CompletedTask;

        if (string.Equals(phase, "start", StringComparison.Ordinal))
        {
            _cropDragHandle = handle;
            _cropDragStartRect = _cropRect;
            _cropDragStartX = normalizedX;
            _cropDragStartY = normalizedY;
            return Task.CompletedTask;
        }

        if (_cropDragStartRect is not { } start || _cropRect is null)
            return Task.CompletedTask;

        var deltaX = (int)Math.Round((normalizedX - _cropDragStartX) * size.Width);
        var deltaY = (int)Math.Round((normalizedY - _cropDragStartY) * size.Height);

        _cropRect = string.IsNullOrEmpty(handle)
            ? ImageCropCalculator.Translate(start, deltaX, deltaY, size.Width, size.Height)
            : ImageCropCalculator.Resize(start, handle, deltaX, deltaY, size.Width, size.Height, MinCropWindowPx);
        _cropMode = ImageCropMode.Manual;

        if (string.Equals(phase, "end", StringComparison.Ordinal))
            _cropDragHandle = null;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RunCropAsync()
    {
        if (_service is null || _source is null)
            return;

        await RunAsync(async () =>
        {
            _result = await _service.RunCropAsync(Subject, BuildCropOperation());
            _statusMessage = "Crop queued.";
            EnsurePolling();
        });
    }

    private static (int Width, int Height)? ParseImageSize(string? imageSize)
    {
        if (string.IsNullOrWhiteSpace(imageSize))
            return null;

        var parts = imageSize.Split('x', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 2
            && int.TryParse(parts[0], out var width) && width > 0
            && int.TryParse(parts[1], out var height) && height > 0
                ? (width, height)
                : null;
    }

    private async Task RunEditAsync()
    {
        if (_service is null || _session is null || _attempt is null || _activeRevision is null || _source is null)
            return;

        await RunAsync(async () =>
        {
            var revision = _activeRevision;
            if (IsPromptModified)
            {
                revision = await _service.AppendRevisionAsync(_session.Id, _attempt.Id, _editablePrompt.Trim());
                _activeRevision = revision;
            }

            var region = BuildRegionOperation();
            _result = await _service.RunAsync(new ImageEditRunRequest(
                Subject,
                _session.Id,
                _attempt.Id,
                revision.Id,
                _session.SourceImageSha256,
                revision.PromptSha256,
                _selectedEditorModelId!,
                _bindings.ToList(),
                region));
            _statusMessage = region is null
                ? "Image edit queued."
                : "Region edit queued: only the box you drew is left open to change.";
            EnsurePolling();
        });
    }

    private async Task RefreshAsync()
    {
        if (_service is null || _session is null)
            return;

        _session = await _service.GetSessionAsync(_session.Id);
        if (_descriptionPending && !string.IsNullOrWhiteSpace(_session.DescriptionText))
        {
            _descriptionPending = false;
        }
        else if (_descriptionPending
            && await _service.GetDescriptionOutcomeAsync(_session.Id) is { IsTerminal: true } descriptionOutcome)
        {
            // The description cannot arrive. Stop reporting work in flight so the editor stays usable — the
            // description is context for the compiler, not a prerequisite for preparing an edit — and say why: a
            // wait that never ends, with nothing on screen, disabled every control in this panel with no message
            // (2026-09-24, debug/071: the provider echoed a different model id).
            _descriptionPending = false;
            if (!string.IsNullOrWhiteSpace(descriptionOutcome.FailureMessage))
            {
                _errorMessage = $"The source description could not be produced: {descriptionOutcome.FailureMessage}";
            }
        }

        var latestAttempt = await _service.GetLatestAttemptAsync(_session.Id);
        if (latestAttempt is not null)
        {
            var changedAttempt = !string.Equals(_attempt?.Id, latestAttempt.Id, StringComparison.Ordinal);
            _attempt = latestAttempt;
            _compilationResult = ParseResult(latestAttempt.ParsedResultJson);
            SyncIdentityTargetSelections();
            var revisions = await _service.ListRevisionsAsync(latestAttempt.Id);
            var latestRevision = revisions.OrderByDescending(revision => revision.Ordinal).FirstOrDefault();
            if (latestRevision is not null && (changedAttempt || _activeRevision is null))
            {
                _activeRevision = latestRevision;
                _editablePrompt = latestRevision.Prompt;
            }
        }

        _result = await _service.ResolveResultAsync(Subject, _session.Id, _result?.ImageId);
        _lineage = await _service.ListLineageAsync(Subject);

        if (_result is not null && _result.IsComplete
            && !string.Equals(_resultNotifiedId, _result.ImageId, StringComparison.Ordinal))
        {
            _resultNotifiedId = _result.ImageId;
            await ResultChanged.InvokeAsync(_result);
        }

        await StateChanged.InvokeAsync(Snapshot());
    }

    private ImageEditWorkspaceSnapshot Snapshot() => new(
        Subject,
        _session?.Id,
        _attempt?.Id,
        _activeRevision?.Id,
        _result?.ImageId,
        _result?.IsComplete == true,
        _source?.ImageId);

    private async Task StartNewSessionIfCompletedAsync()
    {
        if (_service is null || _session?.IsCompleted != true)
            return;

        _session = await _service.OpenSessionAsync(Subject);
        _attempt = null;
        _compilationResult = null;
        _identityTargetSelections.Clear();
        _activeRevision = null;
        _editablePrompt = string.Empty;
        _preparedIntent = string.Empty;
        _descriptionPending = false;
    }

