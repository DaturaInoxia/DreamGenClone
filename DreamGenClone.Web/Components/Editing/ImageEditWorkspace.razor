@using System.Text.Json
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.Editing
@using DreamGenClone.Web.Application.RolePlay.ImageStep
@using DreamGenClone.Web.Application.RolePlay.Models
@implements IAsyncDisposable

@inject ImageEditWorkspaceServiceResolver ServiceResolver
@inject IImageEditorModelResolver ImageEditorModelResolver
@inject DreamGenClone.Application.ModelManager.IFunctionDefaultRepository FunctionDefaults
@inject IImageWorkflowTemplateService WorkflowTemplates
@inject IImagePresetService ImagePresets
@inject IMediaEditHeadMeasurementService HeadMeasurements
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<ImageEditWorkspace> Logger

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">@_statusMessage</div>
}

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <span class="spinner-border spinner-border-sm"></span>
        <span>Loading source image...</span>
    </div>
}
else if (_source is null)
{
    <div class="alert alert-warning">The selected source image is unavailable or is not complete.</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-6">
            <section class="scene-edit-media-panel">
                <div class="scene-edit-panel-heading">
                    <div>
                        <span class="scene-edit-kicker">Source</span>
                        <strong>Original image</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_source.ImageSize))
                    {
                        <span class="badge bg-secondary">@_source.ImageSize</span>
                    }
                </div>
                <div class="scene-edit-image-stage">
                    <img src="/scene-images/@_source.FileRelativePath" alt="Source image" class="scene-edit-image" />
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="scene-edit-workbench">
                <ul class="nav nav-tabs small" role="tablist" aria-label="Image edit flow">
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link @(_activeTab == EditorTab.Edit ? "active" : "")" aria-selected="@(_activeTab == EditorTab.Edit)"
                                @onclick="() => SelectEditorTab(EditorTab.Edit)">
                            Edit
                        </button>
                    </li>
                    @if (IdentityAvailable)
                    {
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(_activeTab == EditorTab.Identity ? "active" : "")" aria-selected="@(_activeTab == EditorTab.Identity)"
                                    @onclick="() => SelectEditorTab(EditorTab.Identity)">
                                Identity @if (_identityTargetSelections.Count > 0) { <span class="badge text-bg-secondary ms-1">@_identityTargetSelections.Count</span> }
                            </button>
                        </li>
                    }
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link @(_activeTab == EditorTab.Crop ? "active" : "")" aria-selected="@(_activeTab == EditorTab.Crop)"
                                @onclick="() => SelectEditorTab(EditorTab.Crop)">
                            Crop
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link @(_activeTab == EditorTab.Enhance ? "active" : "")" aria-selected="@(_activeTab == EditorTab.Enhance)"
                                @onclick="() => SelectEditorTab(EditorTab.Enhance)">
                            Enhance
                        </button>
                    </li>
                    @if (_service?.SupportsPresetEdits == true)
                    {
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(_activeTab == EditorTab.Presets ? "active" : "") @(_presetError.Length > 0 ? "text-danger" : "")" aria-selected="@(_activeTab == EditorTab.Presets)"
                                    @onclick="() => SelectEditorTab(EditorTab.Presets)">
                                Presets
                            </button>
                        </li>
                    }
                </ul>

                @if (_activeTab == EditorTab.Edit)
                {
                    <div class="scene-edit-panel-heading">
                        <div>
                            <span class="scene-edit-kicker">Vision compiler</span>
                            <strong>Describe the change</strong>
                        </div>
                        @if (_attempt is not null)
                        {
                            <span class="badge @AttemptBadgeClass">@_attempt.StatusText</span>
                        }
                    </div>
                    <div class="mb-3">
                        @if (_editorModelChoices.Count == 0)
                        {
                            <div class="alert alert-warning py-2 mb-0">No fully configured image editor endpoints are available. Configure a Qwen editor model in Model Manager.</div>
                        }
                        else
                        {
                            @* B-130: the model and the reference slots are presented by the ONE composer. Its prompt
                               panel and submit button are OFF because this workspace's prompt comes from its own
                               workbench below (an intent is compiled into a prompt that is then run) - a second prompt
                               box would be two controls over one value. The slots that used to be three unaddressed
                               element rows are now addressed per character, because a body or wardrobe reference must
                               name whose it is. *@
                            <ImageStepComposer Blueprint="EditBlueprint"
                                               ModelChoices="_editorModelChoices"
                                               SelectedModelId="@_selectedEditorModelId"
                                               SelectedModelIdChanged="OnEditorModelChangedAsync"
                                               ModelPlaceholder="Choose an image editor model"
                                               Bindings="_bindings"
                                               BindingsChanged="OnBindingsChanged"
                                               Busy="_busy"
                                               CanSubmit="false"
                                               ShowPrompt="false" />
                        }
                    </div>
                    @* B-130: an edit is a whole-frame edit unless the operator confines it. The box is drawn on the
                       source in percent - the units the operation stores - and the two mask values open on the
                       persisted settings and can be changed for this run. *@
                    <div class="border rounded p-2 mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="@RegionToggleId"
                                   checked="@_regionEnabled" disabled="@_busy" @onchange="OnRegionEnabledChanged" />
                            <label class="form-check-label small" for="@RegionToggleId">
                                Confine this edit to a region
                            </label>
                        </div>
                        @if (_regionEnabled)
                        {
                            <div class="scene-crop-preview mt-2">
                                <div id="@RegionStageId" class="scene-crop-preview-stage">
                                    <img src="/scene-images/@_source.FileRelativePath" alt="Region selection" />
                                    @if (_region is not null && RegionWindowStyle is not null)
                                    {
                                        <div class="scene-crop-preview-window is-dimmed" data-crop-handle="move" style="@RegionWindowStyle">
                                            <span class="scene-crop-preview-corner is-tl" data-crop-handle="tl"></span>
                                            <span class="scene-crop-preview-corner is-tr" data-crop-handle="tr"></span>
                                            <span class="scene-crop-preview-corner is-bl" data-crop-handle="bl"></span>
                                            <span class="scene-crop-preview-corner is-br" data-crop-handle="br"></span>
                                        </div>
                                    }
                                </div>
                                <div class="small text-muted mt-1">Drag on the image to draw the region, drag the box to move it, or a corner to resize it.</div>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-sm-6">
                                    <label class="form-label small mb-1" for="@RegionGrowInputId">Grow mask by (px)</label>
                                    <input id="@RegionGrowInputId" type="number" step="1" min="0" max="64" class="form-control form-control-sm"
                                           @bind="RegionGrowInput" disabled="@_busy" />
                                    <div class="form-text">Overlap past the box edge, 0-64. The seed value comes from the reference workflow settings.</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small mb-1" for="@RegionFeatherInputId">Feather edge (px)</label>
                                    <input id="@RegionFeatherInputId" type="number" step="1" min="0" class="form-control form-control-sm"
                                           @bind="RegionFeatherInput" disabled="@_busy" />
                                    <div class="form-text">0 sends no feather at all.</div>
                                </div>
                            </div>
                            <div class="small text-muted mt-1">@RegionSummary</div>
                            @if (!string.IsNullOrWhiteSpace(RegionBlockReason))
                            {
                                <div class="form-text text-warning">@RegionBlockReason</div>
                            }
                        }
                    </div>
                    <EditIterateWorkbench Error="@_errorMessage"
                                           StatusMessage="@_statusMessage"
                                           Loading="false"
                                           Busy="@_busy"
                                           ReadOnly="@(_session?.IsCompleted == true)"
                                           SourceDescription="@_session?.DescriptionText"
                                           IntentInputId="@IntentInputId"
                                           @bind-Intent="_rawIntent"
                                           CompilationStale="@IsCompilationStale"
                                           HasInFlightWork="@HasInFlightWork()"
                                           Compiling="@(_attempt?.IsInFlight == true)"
                                           Rendering="@(_result?.IsInFlight == true)"
                                           Compilation="@_compilationResult"
                                           CompilationError="@CompilationError"
                                           @bind-Clarification="_clarificationAnswer"
                                           PromptReady="@(_compilationResult?.Status == SceneImageEditCompilationResultStatus.Ready && _activeRevision is not null)"
                                           PromptRevisionNumber="@((_activeRevision?.Ordinal ?? 0) + 1)"
                                           @bind-EditablePrompt="_editablePrompt"
                                           SubmittedInput="@SubmittedInput"
                                           CanRun="@(_activeRevision is not null && !string.IsNullOrWhiteSpace(_selectedEditorModelId) && CanRunRegionEdit)"
                                           ReviewDeckUrl="@ReviewDeckUrl"
                                           OnReanalyze="ReanalyzeAsync"
                                           OnPrepare="PrepareAsync"
                                           OnSubmitClarification="SubmitClarificationAsync"
                                           OnRun="RunEditAsync">
                        <ReadyContent>
                            @if (IsPromptModified)
                            {
                                <div class="form-text text-warning">Your changes will be saved as a new accepted revision before execution.</div>
                            }
                            @if (ReadyContent is not null)
                            {
                                @ReadyContent
                            }
                        </ReadyContent>
                    </EditIterateWorkbench>
                }
                else if (_activeTab == EditorTab.Crop)
                {
                    <div class="scene-edit-panel-heading">
                        <div>
                            <span class="scene-edit-kicker">Operation</span>
                            <strong>Crop the frame</strong>
                        </div>
                        @if (_cropRect is not null)
                        {
                            <span class="badge bg-secondary">@(_cropRect.Width)x@(_cropRect.Height)</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_cropSettingsError))
                    {
                        <div class="alert alert-warning py-2 small">
                            <i class="bi bi-exclamation-triangle me-1"></i>@_cropSettingsError
                        </div>
                    }

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small mb-1" for="@CropModeSelectId">Placement</label>
                            <select id="@CropModeSelectId" class="form-select form-select-sm" @bind="CropModeInput" disabled="@_busy">
                                <option value="@ImageCropMode.Framing">Framing - share of the surrounding space</option>
                                @if (EffectiveHeadMeasurement is not null)
                                {
                                    <option value="@ImageCropMode.HeadAware">Head-aware - proportion of the measured head</option>
                                }
                                @if (EffectiveHeadMeasurement?.Face is not null)
                                {
                                    <option value="@ImageCropMode.HeadFramed">Head - framed to the measured head</option>
                                }
                                @if (IsManualCrop)
                                {
                                    <option value="@ImageCropMode.Manual">Dragged window</option>
                                }
                            </select>
                            <div class="form-text">@CropModeHelp</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1" for="@CropAspectInputId">Target aspect (width / height)</label>
                            <input id="@CropAspectInputId" type="number" step="0.05" min="0.05" class="form-control form-control-sm"
                                   @bind="CropAspectInput" disabled="@_busy" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1" for="@CropHeadroomInputId">Headroom %</label>
                            <input id="@CropHeadroomInputId" type="number" step="1" min="0" max="100" class="form-control form-control-sm"
                                   @bind="CropHeadroomInput" disabled="@_busy" />
                            <div class="form-text">@CropHeadroomHelp</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1" for="@CropOffsetInputId">Horizontal offset %</label>
                            <input id="@CropOffsetInputId" type="number" step="1" min="0" max="100" class="form-control form-control-sm"
                                   @bind="CropOffsetInput" disabled="@_busy" />
                            <div class="form-text">50% centres the window.</div>
                        </div>
                    </div>

                    var head = EffectiveHeadMeasurement;
                    @if (head is null)
                    {
                        <div class="alert alert-info py-2 small mt-3">
                            <div>Head-aware placement needs a measured head. Measure this image to enable it, or keep the framing mode, which needs no measurement.</div>
                            <button type="button" class="btn btn-sm btn-outline-info mt-2" disabled="@(_busy || _source is null)" @onclick="MeasureHeadAsync">
                                <i class="bi bi-rulers me-1"></i> Measure head
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                            <span class="badge bg-success">Head measured</span>
                            <span class="small text-muted">hairline y=@head.ForeheadTopY, chin y=@head.ChinY (@head.HeadHeightPx px tall)</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="MeasureHeadAsync">
                                <i class="bi bi-arrow-repeat me-1"></i> Re-measure
                            </button>
                        </div>
                    }

                    <div class="scene-crop-presets d-flex flex-wrap align-items-center gap-1 mt-3">
                        <span class="small text-muted me-1">Aspect</span>
                        @foreach (var preset in CropAspectPresets)
                        {
                            <button type="button" class="btn btn-sm @(IsPresetSelected(preset.Value) ? "btn-primary" : "btn-outline-secondary")"
                                    disabled="@_busy" @onclick="() => ApplyCropAspect(preset.Value)">
                                @preset.Label
                            </button>
                        }
                    </div>

                    <div class="scene-crop-preview mt-3">
                        <div id="@CropStageId" class="scene-crop-preview-stage">
                            <img src="/scene-images/@_source.FileRelativePath" alt="Crop preview" />
                            @if (_cropRect is not null && CropWindowStyle is not null)
                            {
                                <div class="scene-crop-preview-window @(CropRemovesNothing ? "is-full-frame" : "is-dimmed")" style="@CropWindowStyle">
                                    <span class="scene-crop-preview-corner is-tl" data-crop-handle="tl"></span>
                                    <span class="scene-crop-preview-corner is-tr" data-crop-handle="tr"></span>
                                    <span class="scene-crop-preview-corner is-bl" data-crop-handle="bl"></span>
                                    <span class="scene-crop-preview-corner is-br" data-crop-handle="br"></span>
                                </div>
                            }
                        </div>
                        <div class="small text-muted mt-1">Drag the box to move it, or a corner to resize it. @CropPreviewSummary</div>
                    </div>

                    @if (CropRemovesNothing)
                    {
                        <div class="alert alert-warning py-2 small mt-2 mb-0">
                            This window covers the whole image, so nothing would be cropped. Choose a different
                            aspect or move the headroom to trim the frame.
                        </div>
                    }

                    <div class="d-flex align-items-center gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!CanRunCrop)" @onclick="RunCropAsync">
                            <i class="bi bi-crop me-1"></i> Crop image
                        </button>
                        <span class="small text-muted">Writes a new image; this source is untouched and no model is called.</span>
                    </div>
                    @if (!CanRunCrop && !string.IsNullOrWhiteSpace(CropBlockReason))
                    {
                        <div class="form-text text-warning">@CropBlockReason</div>
                    }
                }
                else if (_activeTab == EditorTab.Enhance)
                {
                    <div class="scene-edit-panel-heading">
                        <div>
                            <span class="scene-edit-kicker">Deterministic operation</span>
                            <strong>Enhance the frame</strong>
                        </div>
                        @if (_source is not null)
                        {
                            <span class="badge bg-secondary">@_source.ImageSize</span>
                        }
                    </div>

                    <p class="small text-muted mb-2">
                        Runs the configured upscaler over this image, then returns it to the target long edge.
                        No editor model and no prompt are involved — nothing but resolution changes.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_enhanceSettingsError))
                    {
                        <div class="alert alert-warning py-2 small">
                            <i class="bi bi-exclamation-triangle me-1"></i>@_enhanceSettingsError
                        </div>
                    }

                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label class="form-label small mb-1" for="@EnhanceUpscalerInputId">Upscaler</label>
                            <input id="@EnhanceUpscalerInputId" type="text" class="form-control form-control-sm"
                                   value="@(_enhanceUpscalerModelName ?? string.Empty)" readonly />
                            <div class="form-text">Configured upscale model installed on the ComfyUI endpoint.</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small mb-1" for="@EnhanceTargetEdgeInputId">Target long edge (px)</label>
                            <input id="@EnhanceTargetEdgeInputId" type="number" step="64" min="1" class="form-control form-control-sm"
                                   @bind="EnhanceTargetEdgeInput" disabled="@_busy" />
                            <div class="form-text">The finished image's longer side. Larger sources are scaled down to it, never up.</div>
                        </div>
                    </div>

                    <div class="alert alert-warning py-2 small mt-3 mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        <strong>Assess likeness first.</strong> Upscaling re-synthesises fine detail, so a face can
                        shift in a way that changes identity. Check the face against the approved reference before
                        promoting the result.
                    </div>

                    <div class="d-flex align-items-center gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!CanRunEnhance)" @onclick="RunEnhanceAsync">
                            <i class="bi bi-stars me-1"></i> Enhance image
                        </button>
                        <span class="small text-muted">Writes a new image; this source is untouched and no editor model is called.</span>
                    </div>
                    @if (!CanRunEnhance && !string.IsNullOrWhiteSpace(EnhanceBlockReason))
                    {
                        <div class="form-text text-warning">@EnhanceBlockReason</div>
                    }
                }
                else if (_activeTab == EditorTab.Presets && _service?.SupportsPresetEdits == true)
                {
                    <div class="scene-edit-panel-heading">
                        <div>
                            <span class="scene-edit-kicker">Preset pass</span>
                            <strong>Relight or re-express this image</strong>
                        </div>
                    </div>
                    <p class="small text-muted">
                        A preset assembles its instruction here and sends it unchanged - it never goes through the
                        vision compiler, because the detail that makes a light or an expression read is the wording
                        that was picked. The result is a NEW image derived from this one, in the same batch.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_presetError))
                    {
                        <div class="alert alert-danger py-2 small">@_presetError</div>
                    }
                    @if (_presetChoices.Count == 0)
                    {
                        <div class="alert alert-warning py-2 small mb-0">
                            No lighting or expression presets are stored. They are seeded on app start, so restart the
                            app if this build predates them.
                        </div>
                    }
                    else
                    {
                        <label class="form-label small mb-1" for="@PresetSelectId">Preset</label>
                        <select id="@PresetSelectId" class="form-select form-select-sm"
                                @bind="_selectedPresetKey" @bind:after="LoadPresetInstructionAsync"
                                disabled="@(_presetBusy || _busy || _session?.IsCompleted == true)">
                            @foreach (var group in _presetChoices.GroupBy(choice => choice.Axis))
                            {
                                <optgroup label="@(group.Key == ImagePresetAxis.Lighting ? "Lighting" : "Facial expression")">
                                    @foreach (var choice in group)
                                    {
                                        <option value="@choice.PresetKey">@choice.ShortName</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        @if (!string.IsNullOrWhiteSpace(_presetInstruction))
                        {
                            <div class="small text-muted mt-3 mb-1">The instruction this preset sends</div>
                            <pre class="border rounded bg-body-tertiary p-2 small text-wrap">@_presetInstruction</pre>
                        }
                        @if (string.IsNullOrWhiteSpace(_selectedEditorModelId))
                        {
                            <div class="form-text text-warning">Choose an image editor model on the Edit tab first.</div>
                        }
                        <div class="d-flex justify-content-end mt-2">
                            <button class="btn btn-success" type="button" @onclick="RunPresetEditAsync"
                                    disabled="@(_presetBusy || _busy || string.IsNullOrWhiteSpace(_selectedPresetKey) || string.IsNullOrWhiteSpace(_selectedEditorModelId) || _session?.IsCompleted == true)">
                                @if (_presetBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-magic me-1"></i>Run preset edit
                            </button>
                        </div>
                    }
                }
                else if (_activeTab == EditorTab.Identity && IdentityAvailable)
                {
                    <div class="scene-edit-panel-heading">
                        <div>
                            <span class="scene-edit-kicker">Character identity</span>
                            <strong>Apply identity by edit</strong>
                        </div>
                    </div>
                    <div class="mb-3">
                        <p class="small text-muted">Bind each detected person to a character's approved identity pack, then run a separate face-only identity correction. No typed prompt is required — identity compiles from the source image and runs independently of the Edit tab.</p>
                        @if (_compilationResult?.Status != SceneImageEditCompilationResultStatus.Ready)
                        {
                            <div class="alert alert-info py-2 small mb-2">Identity needs a vision analysis of this image to detect the people to correct.</div>
                            <button type="button" class="btn btn-sm btn-outline-info" disabled="@_busy" @onclick="IdentityPrepareAsync">
                                <i class="bi bi-person-badge me-1"></i> Analyze faces
                            </button>
                        }
                        else if (_identityTargetSelections.Count == 0)
                        {
                            <div class="small text-muted">No people were detected in this image, so there are no faces to bind an identity reference to.</div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(_identityRosterStatus))
                            {
                                <div class="alert alert-warning py-2 small">@_identityRosterStatus</div>
                            }
                            else if (_identityCharacters.Count == 0)
                            {
                                <div class="alert alert-warning py-2 small">No characters with an approved identity pack are available here. Create and approve identity packs in <a href="/characters/identity">Character Identity</a>.</div>
                            }
                            <section class="border rounded p-3 mt-3" aria-label="Identity-pack character targets">
                                <div class="d-flex justify-content-between align-items-baseline gap-2 mb-2">
                                    <strong>Character identity targets</strong>
                                    <span class="small text-muted">Bind a character identity pack face to each detected person.</span>
                                </div>
                                @foreach (var target in _identityTargetSelections)
                                {
                                    <div class="border rounded p-2 mb-2" @key="target.Target.Key">
                                        <div class="d-flex justify-content-between gap-2 mb-2">
                                            <strong>@target.Target.Key</strong>
                                            <span class="small text-muted">@target.Target.VisibleLocator</span>
                                        </div>
                                        @if (target.Target.Region is not null)
                                        {
                                            <div class="form-text mb-2">Region: x @target.Target.Region.X.ToString("0.###"), y @target.Target.Region.Y.ToString("0.###"), width @target.Target.Region.Width.ToString("0.###"), height @target.Target.Region.Height.ToString("0.###")</div>
                                        }
                                        @if (target.Target.HeadView is not null)
                                        {
                                            <div class="form-text mb-2">Detected pose: @FaceViewLabel(target.Target.HeadView)</div>
                                        }
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label small mb-1">Character</label>
                                                <select class="form-select form-select-sm" value="@target.CharacterId" disabled="@_busy" @onchange="args => SetIdentityTargetCharacterAsync(target, args)">
                                                    <option value="">Select character…</option>
                                                    @foreach (var choice in _identityCharacters)
                                                    {
                                                        <option value="@choice.CharacterId">@choice.CharacterName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small mb-1">Face reference (approved pack)</label>
                                                <div class="position-relative">
                                                    <button type="button"
                                                            class="scene-face-picker-toggle"
                                                            disabled="@(_busy || target.Faces is not { Count: > 0 })"
                                                            aria-haspopup="listbox"
                                                            aria-expanded="@(_openFacePickerTargetKey == target.Target.Key)"
                                                            @onclick="() => ToggleIdentityFacePicker(target.Target.Key)">
                                                        @{
