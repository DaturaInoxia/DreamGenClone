            _identityService = ServiceResolver.ResolveIdentity(Subject.Kind);
            _source = await _service.GetSourceAsync(Subject);
            if (_source is null || !_source.IsComplete)
            {
                _source = null;
                return;
            }

            _sourcePixelSize = ParseImageSize(_source.ImageSize);
            await LoadCropDefaultsAsync();
            await LoadEnhanceDefaultsAsync();
            await LoadRegionDefaultsAsync();

            _session = await _service.OpenSessionAsync(Subject);
            _editorModelChoices = await ImageEditorModelResolver.ListImageEditorModelsAsync();
            _selectedEditorModelId = await ResolveInitialEditorModelIdAsync();
            if (!string.IsNullOrWhiteSpace(SeedIntent))
            {
                _rawIntent = SeedIntent.Trim();
            }
            await LoadPresetsAsync();
            if (IdentityAvailable)
            {
                await LoadIdentityRosterAsync();
            }
            await _service.ReanalyzeAsync(_session.Id);
            _descriptionPending = true;
            await RefreshAsync();
            if (HasInFlightWork())
            {
                EnsurePolling();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to open the image editor: {ex.Message}";
            Logger.LogError(ex, "Image edit workspace load failed: Subject={Subject}", SubjectKey);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Which model the form opens on.
    ///
    /// <para>
    /// Order: the host's model when it named one that is offered, then the model configured for
    /// <c>AppFunction.RolePlaySceneImageEditor</c>, then the model the DATA flags as default, then the first offered.
    /// The function's own model is asked for FIRST because the global default flag can sit on a model that cannot
    /// edit at all - measured 2026-09-27: <c>Qwen-Image-2.1</c> carries the default flag but has no editor graph, so it
    /// is absent from this very list, and the form silently opened on an unrelated editor model. That is the reported
    /// fault: "MAKE qwen 2.1 auto selected on the Edit Asset page".
    /// </para>
    /// </summary>
    private async Task<string?> ResolveInitialEditorModelIdAsync()
    {
        if (!string.IsNullOrWhiteSpace(DefaultEditorModelId)
            && _editorModelChoices.Any(choice => string.Equals(choice.ModelId, DefaultEditorModelId, StringComparison.Ordinal)))
        {
            return DefaultEditorModelId;
        }

        var configured = await FunctionDefaults.GetByFunctionAsync(
            DreamGenClone.Domain.ModelManager.AppFunction.RolePlaySceneImageEditor);
        if (configured is not null
            && _editorModelChoices.Any(choice => string.Equals(choice.ModelId, configured.ModelId, StringComparison.Ordinal)))
        {
            return configured.ModelId;
        }

        return _editorModelChoices.FirstOrDefault(choice => choice.IsDefaultModel)?.ModelId
            ?? _editorModelChoices.FirstOrDefault()?.ModelId;
    }

