    private Task OnEditorModelChangedAsync(string? modelId)
    {
        _selectedEditorModelId = modelId;
        // The slots a step offers depend on the selected model's capability, so a model change invalidates what was
        // bound under the previous one: keeping the bindings would leave the plan describing a model no longer chosen.
        _bindings = [];
        return Task.CompletedTask;
    }

