    private async Task RunIdentityEditAsync()
    {
        if (_identityService is null || _source is null)
            return;

        await RunAsync(async () =>
        {
            var selections = _identityTargetSelections
                .Where(target => target.IsBound)
                .Select(target => new ImageIdentitySelection(
                    target.Target.Key,
                    target.Target.VisibleLocator,
