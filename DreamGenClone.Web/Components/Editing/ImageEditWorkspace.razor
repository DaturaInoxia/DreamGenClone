        {
            _cropDragHandle = handle;
            _cropDragStartRect = _cropRect;
            _cropDragStartX = normalizedX;
            _cropDragStartY = normalizedY;
            return Task.CompletedTask;
        }

        if (_cropDragStartRect is not { } start || _cropRect is null)
            return Task.CompletedTask;

        var deltaX = (int)Math.Round((normalizedX - _cropDragStartX) * size.Width);
        var deltaY = (int)Math.Round((normalizedY - _cropDragStartY) * size.Height);

        _cropRect = string.IsNullOrEmpty(handle)
            ? ImageCropCalculator.Translate(start, deltaX, deltaY, size.Width, size.Height)
            : ImageCropCalculator.Resize(start, handle, deltaX, deltaY, size.Width, size.Height, MinCropWindowPx);
        _cropMode = ImageCropMode.Manual;

        if (string.Equals(phase, "end", StringComparison.Ordinal))
            _cropDragHandle = null;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RunCropAsync()
    {
        if (_service is null || _source is null)
            return;

        await RunAsync(async () =>
        {
            _result = await _service.RunCropAsync(Subject, BuildCropOperation());
            _statusMessage = "Crop queued.";
            EnsurePolling();
        });
    }

    private static (int Width, int Height)? ParseImageSize(string? imageSize)
    {
        if (string.IsNullOrWhiteSpace(imageSize))
            return null;

        var parts = imageSize.Split('x', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 2
            && int.TryParse(parts[0], out var width) && width > 0
            && int.TryParse(parts[1], out var height) && height > 0
                ? (width, height)
                : null;
    }

    private async Task RunEditAsync()
    {
        if (_service is null || _session is null || _attempt is null || _activeRevision is null || _source is null)
            return;

        await RunAsync(async () =>
        {
            var revision = _activeRevision;
            if (IsPromptModified)
            {
                revision = await _service.AppendRevisionAsync(_session.Id, _attempt.Id, _editablePrompt.Trim());
                _activeRevision = revision;
            }

            _result = await _service.RunAsync(new ImageEditRunRequest(
                Subject,
                _session.Id,
                _attempt.Id,
                revision.Id,
                _session.SourceImageSha256,
                revision.PromptSha256,
                _selectedEditorModelId!,
                _referenceApplications.ToList()));
            _statusMessage = "Image edit queued.";
            EnsurePolling();
        });
    }

    private async Task RefreshAsync()
    {
        if (_service is null || _session is null)
            return;

        _session = await _service.GetSessionAsync(_session.Id);
        if (_descriptionPending && !string.IsNullOrWhiteSpace(_session.DescriptionText))
        {
            _descriptionPending = false;
        }

        var latestAttempt = await _service.GetLatestAttemptAsync(_session.Id);
        if (latestAttempt is not null)
        {
            var changedAttempt = !string.Equals(_attempt?.Id, latestAttempt.Id, StringComparison.Ordinal);
            _attempt = latestAttempt;
            _compilationResult = ParseResult(latestAttempt.ParsedResultJson);
            SyncIdentityTargetSelections();
            var revisions = await _service.ListRevisionsAsync(latestAttempt.Id);
            var latestRevision = revisions.OrderByDescending(revision => revision.Ordinal).FirstOrDefault();
            if (latestRevision is not null && (changedAttempt || _activeRevision is null))
            {
                _activeRevision = latestRevision;
                _editablePrompt = latestRevision.Prompt;
            }
        }

        _result = await _service.ResolveResultAsync(Subject, _session.Id, _result?.ImageId);
        _lineage = await _service.ListLineageAsync(Subject);

        if (_result is not null && _result.IsComplete
            && !string.Equals(_resultNotifiedId, _result.ImageId, StringComparison.Ordinal))
        {
            _resultNotifiedId = _result.ImageId;
            await ResultChanged.InvokeAsync(_result);
        }

        await StateChanged.InvokeAsync(Snapshot());
    }

    private ImageEditWorkspaceSnapshot Snapshot() => new(
        Subject,
        _session?.Id,
        _attempt?.Id,
        _activeRevision?.Id,
        _result?.ImageId,
        _result?.IsComplete == true,
        _source?.ImageId);

    private async Task StartNewSessionIfCompletedAsync()
    {
        if (_service is null || _session?.IsCompleted != true)
            return;

        _session = await _service.OpenSessionAsync(Subject);
        _attempt = null;
        _compilationResult = null;
        _identityTargetSelections.Clear();
        _activeRevision = null;
        _editablePrompt = string.Empty;
        _preparedIntent = string.Empty;
        _descriptionPending = false;
    }

    private Task OnReferenceApplicationsChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private sealed class EditIdentityTargetSelection
    {
        public SceneImageEditTarget Target { get; set; } = new();
        public string CharacterId { get; set; } = string.Empty;
        public string CharacterName { get; set; } = string.Empty;
        public string ReferenceAssetId { get; set; } = string.Empty;
        public IReadOnlyList<SceneImageReferenceAsset>? Faces { get; set; }
        public bool IsBound => !string.IsNullOrWhiteSpace(CharacterId) && !string.IsNullOrWhiteSpace(ReferenceAssetId);
    }

    private void SyncIdentityTargetSelections()
    {
        var targets = _compilationResult?.Status == SceneImageEditCompilationResultStatus.Ready
            ? _compilationResult.Targets
            : [];
        var existing = _identityTargetSelections.ToDictionary(item => item.Target.Key, StringComparer.Ordinal);
        _identityTargetSelections.Clear();
        foreach (var target in targets)
        {
            if (existing.TryGetValue(target.Key, out var current))
            {
                current.Target = target;
                _identityTargetSelections.Add(current);
                continue;
            }

            _identityTargetSelections.Add(new EditIdentityTargetSelection { Target = target });
        }
    }

    private async Task SetIdentityTargetCharacterAsync(EditIdentityTargetSelection target, ChangeEventArgs args)
    {
        var characterId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(characterId))
        {
            target.CharacterId = string.Empty;
            target.CharacterName = string.Empty;
            target.ReferenceAssetId = string.Empty;
            target.Faces = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var choice = _identityCharacters.FirstOrDefault(item => string.Equals(item.CharacterId, characterId, StringComparison.Ordinal));
        target.CharacterId = choice?.CharacterId ?? characterId;
        target.CharacterName = choice?.CharacterName ?? string.Empty;
        target.Faces = choice?.Faces ?? [];
        target.ReferenceAssetId = choice is null
            ? string.Empty
            : ResolvePreferredIdentityFace(choice, target.Target.HeadView);
        _openFacePickerTargetKey = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Prefer the approved pack face whose angle matches the vision-detected head direction; fall
    /// back to the pack's configured canonical face, then the first approved face. Never invents a
    /// face: every candidate is an approved asset of the character's approved pack.
    /// </summary>
    private static string ResolvePreferredIdentityFace(ImageIdentityCharacterChoice choice, SceneImageReferenceFaceView? headView)
    {
        if (headView is { } view)
        {
            var matched = choice.Faces.FirstOrDefault(face => face.FaceView == view);
            if (matched is not null)
                return matched.Id;
        }

        var canonical = choice.Faces.FirstOrDefault(face => string.Equals(face.Id, choice.CanonicalFaceAssetId, StringComparison.Ordinal));
        return canonical?.Id ?? choice.Faces.FirstOrDefault()?.Id ?? string.Empty;
    }

    private static string IdentityFacePlaceholder(EditIdentityTargetSelection target) => target.Faces switch
    {
