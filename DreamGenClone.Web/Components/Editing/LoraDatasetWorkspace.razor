@using System.Text.Json
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Components.Shared
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.Editing
@using DreamGenClone.Web.Application.RolePlay.ImageStep

@inject ICharacterLoraRepository LoraRepository
@inject ICharacterLoraCoveragePlanGenerator PlanGenerator
@inject ICharacterLoraCellService CellService
@inject ICharacterImageIdentityService IdentityService
@inject ICharacterIdentityBodyService BodyService
@inject ICharacterIdentityOwnerResolver OwnerResolver
@inject IModelResolutionService ModelResolutionService
@inject IImageWorkflowTemplateService TemplateService
@inject IImagePresetService ImagePresets
@inject ILogger<LoraDatasetWorkspace> Logger
@inject IJSRuntime JS

@* The LoRA images tab: the plan on the left, the cell being worked on the right.
   The plan is a checklist the operator works through one cell at a time. Nothing here renders: there is no
   "generate them all" action anywhere in this component, and adding one would defeat the item. *@

@if (!string.IsNullOrWhiteSpace(_ownerMessage))
{
    <div class="alert alert-danger">@_ownerMessage</div>
}
else if (_loadFailed)
{
    @* A configuration or data failure, shown instead of the tab rather than inside it: rendering the workspace
       around it would also render "no body-complete pack exists", which is not the reason. *@
    <div class="alert alert-danger">
        <strong>The LoRA dataset workspace could not open.</strong>
        <div class="mt-1">@_error</div>
    </div>
}
else if (_loading)
{
    <div class="card">
        <div class="card-body text-muted">Reading this character's datasets…</div>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert alert-info py-2">@_status</div>
    }
    @if (!string.IsNullOrWhiteSpace(_planStaleReason))
    {
        @* A plan is DATA: it was written under the rules in force the day it was generated. The framing rule changed on
           2026-09-27, and refusing to load the plans that predate it made this page unopenable for every existing
           dataset. So the plan is shown, the reason it is stale is stated, and the fix is a new dataset version - which
           is the same action that produces a corrected plan. *@
        <div class="alert alert-warning py-2" role="alert">
            <strong>This plan predates the current rules</strong> - @_planStaleReason. It can be read, but some of its
            cells ask for things their framing cannot show. Create a new dataset version to project the corrected plan
            onto the same matrix.
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_policyStaleReason))
    {
        @* The thresholds are DATA too, and the FAR rung was added after the first datasets were projected. Reading
           those snapshots strictly made the tab unopenable, so the policy is read, the missing member is named, and
           generation still refuses until an operator states the size. *@
        <div class="alert alert-warning py-2" role="alert">
            <strong>This curation policy predates the current rules</strong> - @_policyStaleReason. It can be read, but
            no plan can be generated from it until the far aspect is set.
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <label class="form-label small mb-0" for="lora-dataset">Dataset</label>
            <select id="lora-dataset" class="form-select form-select-sm" style="min-width:20rem;"
                    value="@_selectedDatasetId" @onchange="OnDatasetChangedAsync" disabled="@(_datasets.Count == 0)">
                @if (_datasets.Count == 0)
                {
                    <option value="">No dataset yet for @_characterName</option>
                }
                @foreach (var dataset in _datasets)
                {
                    <option value="@dataset.Id">v@dataset.Version · @dataset.Status · @dataset.TargetModelFamily · @dataset.TriggerToken</option>
                }
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (_plan is not null)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleGrid">
                    <i class="bi @(_gridCollapsed ? "bi-chevron-double-right" : "bi-chevron-double-left") me-1"></i>
                    @(_gridCollapsed ? "Show cells" : "Collapse cells")
                </button>
            }
            <button type="button" class="btn btn-sm btn-primary" @onclick="ToggleNewDatasetAsync">
                @(_newDatasetOpen ? "Cancel" : "New dataset")
            </button>
        </div>
    </div>

    @if (_newDatasetOpen)
    {
        <section class="card mb-3" aria-label="New LoRA dataset">
            <div class="card-header"><strong>New dataset</strong></div>
            <div class="card-body">
                @if (_approvedPacks.Count == 0)
                {
                    <div class="alert alert-warning py-2 mb-0">
                        No approved, body-complete identity pack exists for @_characterName. A LoRA dataset conditions
                        half its cells on the unclothed body reference, so the body set has to be built and promoted
                        first — open the <strong>Body</strong> tab.
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small" for="lora-pack">Approved identity pack</label>
                            <select id="lora-pack" class="form-select form-select-sm" value="@_newPackId" @onchange="OnNewPackChanged">
                                @foreach (var pack in _approvedPacks)
                                {
                                    <option value="@pack.Id">v@pack.Version · approved @pack.ApprovedUtc?.ToLocalTime().ToString("g")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small" for="lora-token">Trigger token</label>
                            <input id="lora-token" class="form-control form-control-sm" @bind="_newTriggerToken" />
                            <div class="form-text">The one word the character's identity binds to. It is the first token of every caption.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small" for="lora-family">Target model family</label>
                            <select id="lora-family" class="form-select form-select-sm" @bind="_newTargetFamily">
                                <option value="">Select a family</option>
                                @foreach (var family in CharacterLoraModelFamilies.All)
                                {
                                    <option value="@family">@family</option>
                                }
                            </select>
                            <div class="form-text">What this set is being trained for. A training profile must be qualified for the same family; a family spelled any other way matches no profile.</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary mt-3" @onclick="CreateDatasetAsync" disabled="@_busy">
                        Create dataset
                    </button>
                }
            </div>
        </section>
    }

    @if (_plan is null)
    {
        <div class="card">
            <div class="card-body text-muted">
                No coverage plan to show. Create a dataset to project @_characterName's approved pack onto the
                coverage matrix — 30 core cells and 6 variation cells, each with its own seed.
            </div>
        </div>
    }
    else
    {
        <section class="card mb-3" aria-label="Dataset readiness">
            <div class="card-body py-2">
                <div class="d-flex flex-wrap align-items-center gap-3 small">
                    <span><strong>cells accepted</strong> @AcceptedCount/@_plan.Records.Count</span>
                    @* Next cell, where the counter is: working through a 36-cell matrix meant going back to the list for
                       every cell. It walks the CURRENT filter, so "Not accepted" turns this into a to-do march. *@
                    <button type="button" class="btn btn-sm btn-outline-primary py-0" @onclick="NextCellAsync"
                            title="Move to the next cell in the list (follows the filter above)">
                        <i class="bi bi-arrow-right-circle me-1"></i>Next cell
                    </button>
                    @* The whole dataset in one deck. Reviewing a training set used to mean opening 36 cells one at a time,
                       and the deck's back button had no scope to return to. The accepted/all choice is carried in the
                       address, and `return` brings the operator back to this cell. *@
                    @if (!string.IsNullOrWhiteSpace(_selectedDatasetId))
                    {
                        <a class="btn btn-sm btn-outline-info py-0" href="@DatasetReviewDeckUrl("all")"
                           title="Review every attempt in this dataset">
                            <i class="bi bi-images me-1"></i>Review deck — all images
                        </a>
                        <a class="btn btn-sm btn-outline-info py-0" href="@DatasetReviewDeckUrl("accepted")"
                           title="Review only the attempts you accepted">
                            <i class="bi bi-check2-circle me-1"></i>Accepted only (@AcceptedCount)
                        </a>
                        @* Where the shoot ends and the training set begins. Registering the accepted images and
                           freezing the manifest happen on the dataset's own page, and nothing here linked to it, so
                           the next step after the last cell was a URL nobody could guess. *@
                        <a class="btn btn-sm btn-outline-success py-0" href="/asset-studio/lora-datasets/@_selectedDatasetId"
                           title="Register the accepted cell images as dataset members, then freeze the manifest">
                            <i class="bi bi-box-seam me-1"></i>Curate &amp; freeze dataset
                        </a>
                    }
                    <span><strong>captions</strong> @CaptionCount/@AcceptedCount</span>
                    <span><strong>clothed / nude</strong> @ClothedCount / @UnclothedCount</span>
                    <span><strong>backgrounds</strong> @BackgroundCount (min @_policy?.MinimumDistinctBackgrounds)</span>
                    <span><strong>pose classes</strong> @PoseClassCount (min @_policy?.MinimumPoseClasses)</span>
                    <span><strong>seeds</strong> @_plan.SeedRangeStart–@(_plan.SeedRangeStart + _plan.Records.Count - 1)</span>
                </div>
                @if (Gaps.Count > 0)
                {
                    <div class="mt-2 small">
                        <span class="text-warning-emphasis me-1"><i class="bi bi-exclamation-triangle me-1"></i>Gaps</span>
                        @foreach (var gap in Gaps)
                        {
                            <span class="badge text-bg-warning me-1">@gap</span>
                        }
                    </div>
                }
                else
                {
                    <div class="mt-2 small text-success-emphasis">
                        <i class="bi bi-check2-circle me-1"></i>The plan meets every configured minimum.
                    </div>
                }
            </div>
        </section>

        <div class="row g-3">
            <div class="col-12 @(_gridCollapsed ? "col-lg-auto" : "col-lg-4")">
                <section class="card" aria-label="Coverage cells">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Cells</strong>
                        @if (!_gridCollapsed)
                        {
                            <select class="form-select form-select-sm w-auto" value="@_filter" @onchange="OnFilterChanged" aria-label="Filter cells">
                                <option value="all">All @_plan.Records.Count</option>
                                <option value="planned">Planned (@PlannedCount)</option>
                                <option value="in review">In review (@InReviewCount)</option>
                                <option value="accepted">Accepted (@AcceptedCount)</option>
                                <option value="rejected">Rejected (@RejectedCount)</option>
                                <option value="remaining">Not accepted (@(_plan.Records.Count - AcceptedCount))</option>
                            </select>
                        }
                    </div>
                    @if (_gridCollapsed)
                    {
                        <div class="card-body py-2 text-muted small" style="max-width:9rem;">
                            @_plan.Records.Count cells<br />
                            @AcceptedCount accepted
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush" style="max-height:78vh;overflow-y:auto;">
                            @foreach (var row in FilteredRows)
                            {
                                <li class="list-group-item py-2 @(row.Record.Key == _selectedCellKey ? "active" : "")"
                                    style="cursor:pointer;" @onclick="() => SelectCell(row.Record.Key)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="small">
                                            <div>
                                                <span class="font-monospace">@row.Record.Key</span>
                                            </div>
                                            <div class="@(row.Record.Key == _selectedCellKey ? "" : "text-muted")">
                                                @row.Record.AngleFamily · @row.Record.Distance · @row.Record.WardrobeState · @row.Record.PoseClass
                                            </div>
                                            <div class="@(row.Record.Key == _selectedCellKey ? "" : "text-muted")">
                                                @LoraCellWorkflowKeys.ShortName(row.Record.OutfitKey) ·
                                                @LoraCellWorkflowKeys.ShortName(row.Record.BackgroundKey) ·
                                                seed @row.Record.Seed · @row.Record.Split
                                            </div>
                                        </div>
                                        <span class="badge @StatusBadge(row.Status)">@row.Status</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="col-12 @(_gridCollapsed ? "col-lg" : "col-lg-8")">
                @if (SelectedRecord is null)
                {
                    <section class="card">
                        <div class="card-body text-muted">Pick a cell on the left to work on it.</div>
                    </section>
                }
                else
                {
                    <section class="card" aria-label="Cell workspace">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>@SelectedRecord.Key</strong>
                            <span class="small text-muted">
                                @SelectedRecord.AngleFamily · @SelectedRecord.Distance · @SelectedRecord.Aspect · seed @SelectedRecord.Seed
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <dl class="row small mb-3">
                                <dt class="col-sm-3">Wardrobe</dt>
                                <dd class="col-sm-9">@SelectedRecord.WardrobeState — @SelectedWardrobePhrase</dd>
                                <dt class="col-sm-3">Pose class</dt>
                                <dd class="col-sm-9">@SelectedRecord.PoseClass — @SelectedPosePhrase</dd>
                                <dt class="col-sm-3">Expression</dt>
                                <dd class="col-sm-9">@SelectedExpressionPhrase</dd>
                                <dt class="col-sm-3">Lighting</dt>
                                <dd class="col-sm-9">@SelectedLightingPhrase</dd>
                                <dt class="col-sm-3">Background</dt>
                                <dd class="col-sm-9">@SelectedBackgroundPhrase</dd>
                                <dt class="col-sm-3">References</dt>
                                <dd class="col-sm-9">@SelectedRecord.DescribeReferenceRule()</dd>
                                <dt class="col-sm-3">Split</dt>
                                <dd class="col-sm-9">@SelectedRecord.Split</dd>
                            </dl>

                            @* There is deliberately NO render prompt here. One used to be shown, composed separately from the
                               prompt below and passing neither the face line nor the supplied elements, so it could disagree
                               with what was actually shot. The prompt that IS sent is the editable one in the step below. *@
                            <h6 class="text-uppercase text-muted small">Caption</h6>
                            <p class="small font-monospace border rounded p-2">@SelectedCaption</p>
                            <div class="form-text mb-3">
                                The trigger token comes first and the invariant features are deliberately absent — they
                                bind to the token instead of to a description the model could vary.
                            </div>

                            @* The attempts come FIRST and the shooting step below them: the operator's next action is
                               almost always to look at what came back, not to re-read the shot controls. The two blocks
                               are ordered with flex `order` rather than moved, so the markup stays in reading order. *@
                            <div class="order-1">
                            <h6 class="text-uppercase text-muted small">Shoot this cell</h6>
                            @if (!string.IsNullOrWhiteSpace(_error))
                            {
                                @* A failure in this workspace was invisible: the load guards put their reason in _error,
                                   and the step's own panel never showed it - so a cell whose model could not be read
                                   just silently lost its reference controls. Name it here, where the operator is. *@
                                <div class="alert alert-danger py-2 small" role="alert">@_error</div>
                            }
                            @* B-130: the step is presented by the ONE composer. The face and build references that the
                               render used to resolve privately now arrive as THIS step's bindings, assigned from the
                               cell's own rule - so the operator sees the two images the cell will be conditioned on,
                               and can change them, before shooting. This page deliberately batches nothing: the flag on
                               the blueprint is false and there is still no generate-them-all action here. *@
                            <ImageStepComposer Blueprint="CellBlueprint"
                                               ModelChoices="_cellModels"
                                               SelectedModelId="@_cellModelId"
                                               SelectedModelIdChanged="OnCellModelSelectedAsync"
                                               ModelPlaceholder="Select model…"
                                               Bindings="_cellBindings"
                                               BindingsChanged="OnCellBindingsChanged"
                                               Prompt="@_cellPromptDraft"
                                               PromptChanged="OnCellPromptChanged"
                                               PresetChoices="@_presetChoices"
                                               PresetKey="@_lightingPresetOverride"
                                               PresetKeyChanged="OnLightingPresetChangedAsync"
                                               PresetNote="@PresetNote"
                                               Busy="_cellBusy"
                                               CanSubmit="CanRender"
                                               SubmitLabel="Render image"
                                               SubmitBlockedReason="@RenderBlockedReason"
                                               OnGeneratePrompt="GenerateCellPromptAsync"
                                               OnSubmit="RenderCellAsync">
                                <ChildContent>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label small mb-1">Size</label>
                                            <input class="form-control form-control-sm" value="@SelectedRecord.Aspect" readonly />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small mb-1">Seed</label>
                                            <input class="form-control form-control-sm" value="@SelectedRecord.Seed" readonly />
                                        </div>
                                    </div>
                                </ChildContent>
                            </ImageStepComposer>
                            </div>

                            <div class="order-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="text-uppercase text-muted small mb-1">
                                    Attempts — this cell (@_cellAttempts.Count)
                                </h6>
                                <div class="d-flex gap-1">
                                    @if (!string.IsNullOrWhiteSpace(_cellIdentityReference))
                                    {
                                        <span class="small text-muted align-self-center me-2">
                                            <i class="bi bi-person-badge me-1"></i>@_cellIdentityReference
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_cellBodyReference))
                                    {
                                        <span class="small text-muted align-self-center me-2">
                                            <i class="bi bi-person-arms-up me-1"></i>@_cellBodyReference
                                        </span>
                                    }
                                    @if (CellReviewDeckUrl is { } reviewDeckUrl)
                                    {
                                        @* The deck the face and body workflows already link to, for THIS cell's batch: the
                                           list above is for shooting and triage, the deck for comparing a batch side by side. *@
                                        <a class="btn btn-sm btn-outline-info" href="@reviewDeckUrl"
                                           title="Review every attempt for this cell in the review deck">
                                            <i class="bi bi-images me-1"></i>Review deck
                                        </a>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshAttemptsAsync"
                                            disabled="@_cellBusy">
                                        Refresh
                                    </button>
                                </div>
                            </div>
                            @if (_cellAttempts.Count == 0)
                            {
                                <p class="small text-muted">
                                    Nothing shot for this cell yet. One render produces one image; there is no
                                    generate-them-all action here by design.
                                </p>
                            }
                            else
                            {
                                <CandidateGrid Items="AttemptItems" SelectedId="_selectedAttemptId"
                                               SelectedIdChanged="OnAttemptSelected"
                                               Busy="_cellBusy"
                                               DecisionChanged="OnAttemptDecisionAsync"
                                               DeleteRequested="OnAttemptDeleteAsync"
                                               EditUrlFactory="EditAttemptUrl" />
                                @if (_selectedAttempt is not null)
                                {
                                    <div class="border rounded p-2 mb-3">
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <span class="small text-muted font-monospace">@_selectedAttempt.Id</span>
                                            <span class="badge text-bg-secondary">@_selectedAttempt.Status</span>
                                            @if (!string.IsNullOrWhiteSpace(_selectedAttempt.FileRelativePath))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" target="_blank"
                                                   href="/scene-images/@_selectedAttempt.FileRelativePath" title="Open full size">
                                                    <i class="bi bi-arrows-fullscreen me-1"></i>Open full size
                                                </a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_selectedAttempt.AssetId))
                                            {
                                                @* B-133: an edit PASS rather than another shot. The cell's plan says which lighting
                                                   and expression it wanted, and the image that came back bright is relit here - which is
                                                   the only route that can go lower, because a text-to-image pass is conditioned on the
                                                   bright reference and an edit instruction over the finished image is not. *@
                                                <a class="btn btn-sm btn-outline-primary" href="@EditPassUrl(_selectedAttempt)"
                                                   title="Relight or re-express this attempt with a preset">
                                                    <i class="bi bi-lightbulb me-1"></i>Edit pass (@ImagePresetKeys.ShortName(EditPassPresetKey))
                                                </a>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => DiscardSelectedAttemptAsync()" disabled="@_cellBusy"
                                                    title="Discard this attempt">
                                                <i class="bi bi-trash me-1"></i>Discard
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(_selectedAttempt.ErrorMessage))
                                        {
                                            <div class="alert alert-danger py-2 small mt-2 mb-0">@_selectedAttempt.ErrorMessage</div>
                                        }
                                    </div>
                                }
                            }
                            </div>

                            <div class="alert alert-secondary py-2 small mb-0 order-3">
                                Once an attempt is good, accepting it into the dataset is the next step: the image has
                                to be approved as a Scene Asset for LoRA training before it can become a dataset member,
                                and that approval carries the consent, licence and content-policy facts that a training
                                set has to be able to prove.
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    }
}

@code {
    /// <summary>The identity-resolving route input. Resolved to the character template before any identity read.</summary>
    [Parameter] public string? CharacterId { get; set; }

    /// <summary>
    /// The cell to open on, as query/parent data. A host that sent the operator away - the review deck's back
    /// button - returns them to the cell they were working on instead of to the top of the list.
    /// </summary>
    [Parameter] public string? Cell { get; set; }

    /// <summary>Matches the options the repository writes with, so a member's coverage snapshot reads back.</summary>
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private CharacterIdentityOwner? _owner;
    private string _ownerMessage = string.Empty;
    private string _characterName = "Character";
    private string _identityKey = string.Empty;

    private readonly List<ImageWorkflowPromptTemplate> _unused = [];
    private List<CharacterImageIdentityPack> _approvedPacks = [];
    private List<CharacterLoraDataset> _datasets = [];
    private List<CharacterLoraDatasetMember> _members = [];
    private CoveragePlan? _plan;
    private CurationPolicy? _policy;
    private CharacterBodyCard? _bodyCard;

    private string _selectedDatasetId = string.Empty;
    private string _selectedCellKey = string.Empty;
    private string _filter = "all";
    private string? _renderTemplateBody;
    private string? _captionTemplateBody;
    private bool _gridCollapsed;
    private bool _newDatasetOpen;
    private bool _busy;
    private bool _loading = true;
    private bool _loadFailed;

    /// <summary>
    /// The state of every cell, keyed by cell, for the list on the left.
    ///
    /// <para>
    /// A cell's state comes from the DECISION the operator made on one of its attempts. It used to come only from a
    /// dataset-member row, and members are written by the accept-into-dataset path, which is not built (B-123 P1-05) -
    /// so accepting an image left the cell reading "planned" for ever, which is exactly what the operator reported. A
    /// member row, when one exists, is still authoritative: it is the later step.
    /// </para>
    /// </summary>
    private readonly Dictionary<string, string> _cellStatuses = new(StringComparer.Ordinal);

    /// <summary>The last cell written to browser storage, so the write happens only when the cell actually changes.</summary>
    private string? _rememberedCell;

    /// <summary>
    /// Where the selected cell is remembered. Per CHARACTER, and in the browser rather than the database: which cell the
    /// operator is working on is a place in a UI, not a fact about the dataset, and putting it in the dataset row would
    /// mean a write on every click. It is browser storage so it survives a reload, a tab switch and a return from any
    /// other page - including ones that carry no link back.
    /// </summary>
    private string CellMemoryKey => $"lora-cell:{(string.IsNullOrWhiteSpace(CharacterId) ? "none" : CharacterId)}";

    /// <summary>
    /// Why the loaded plan is not one this build would generate - null when it is current. Set from the stored plan's
    /// own schema version, so the page can say WHY it is stale instead of throwing on the first contradictory cell.
    /// </summary>
    private string? _planStaleReason;

    /// <summary>
    /// Why the loaded dataset's policy is not one this build would save - null when it is current. The FAR rung was
    /// added after the first datasets were projected, and a stored policy that predates it is read (rather than made
    /// the reason the tab will not open) with the absence named here and refused at generation.
    /// </summary>
    private string? _policyStaleReason;
    private string _error = string.Empty;
    private string _status = string.Empty;

    private string _newPackId = string.Empty;
    private string _newTriggerToken = string.Empty;
    private string _newTargetFamily = string.Empty;

    private List<SceneImageModelChoice> _cellModels = [];
    private string _cellModelId = string.Empty;
    private List<SceneAssetImage> _cellAttempts = [];
    private string? _selectedAttemptId;
    private string _cellIdentityReference = string.Empty;
    private string _cellBodyReference = string.Empty;
    private IReadOnlyList<ReferenceApplicationSelection> _cellBindings = [];
    private string _cellPromptDraft = string.Empty;

    /// <summary>
    /// The canonical body text for the selected cell's state (B-132), resolved from the body service. It replaces the
    /// card's raw line here: that line carried height and weight, and a pubic-hair detail with no state gate.
    /// </summary>
    /// <summary>
    /// The canonical face and body clauses for this cell (B-132), resolved from the body service. The two elements below
    /// show these verbatim, so what the operator reads is what the prompt carries - and neither element repeats the
    /// other's facts.
    /// </summary>
    private CharacterBodyTexts? _cellBodyTexts;

    /// <summary>
    /// The slots this cell's BOUND reference images supply (D4). Read from the same bindings the composer is given, so
    /// the text below and the prompt cannot disagree about what is supplied.
    /// </summary>
    private IReadOnlyList<ImageStepSlotKind> CellSuppliedSlots
        => CellBlueprint is null || _cellBindings.Count == 0
            ? []
            : ImageStepPromptOmission.BoundSlotsFor(CellBlueprint, _cellBindings)
                .Select(slot => slot.SlotKind)
                .ToList();
    private bool _cellBusy;

    /// <summary>The step this workspace presents, built by the one factory that owns host knowledge. A cell is shot
    /// with the character the dataset belongs to, and the blueprint declares no batch - the training set is judged frame
    /// by frame.</summary>
    private ImageStepBlueprint CellBlueprint =>
        ImageStepBlueprintFactory.ForLoraCell(
            new ImageStepActor(_identityKey, _characterName),
            CellElementText(),
            // The step declares the SAME requirement the render enforces: a cell that shows a face cannot be shot
            // without its face reference. Derived from the selected cell's own rule, so a back view is not asked for a
            // face it does not show.
            faceIsRequired: SelectedRecord?.FaceCanonicalSlot is not null);

    /// <summary>
    /// The text each element currently contributes to this cell, read from the SAME card the prompt is composed from
    /// so the text on screen and the text in the prompt cannot disagree.
    /// <para>
    /// The FACE element shows the card's face text and the BODY element shows the card's build line (B-132). They used
    /// to show the same line, because the card had no face of its own - which read as the face being "fixed" by
    /// copying the body, and made it impossible to tell which of the two a reference image had replaced.
    /// </para>
    /// </summary>
    private IReadOnlyDictionary<ImageStepSlotKind, string> CellElementText()
    {
        var text = new Dictionary<ImageStepSlotKind, string>();
        if (!string.IsNullOrWhiteSpace(_cellBodyTexts?.BodyText))
        {
            text[ImageStepSlotKind.Body] = _cellBodyTexts!.BodyText;
        }

        if (!string.IsNullOrWhiteSpace(_cellBodyTexts?.FaceText))
        {
            text[ImageStepSlotKind.Face] = _cellBodyTexts!.FaceText;
        }

        // The WARDROBE element's text is the outfit the body REFERENCE carries. The reference is state-matched, so a
        // clothed cell's reference image IS the garment — which is why the cell's Wardrobe slot declares itself supplied
        // by the Body slot and the prompt no longer describes an outfit at all. The text stays, struck through, so the
        // operator can see what that reference supplies.
        if (!string.IsNullOrWhiteSpace(_cellBodyTexts?.WardrobeText))
        {
            text[ImageStepSlotKind.Wardrobe] = _cellBodyTexts!.WardrobeText;
        }

        // The POSE element's text is this cell's own pose phrase, so the operator can see what the render asks for and
        // what a bound skeleton pins.
        if (!string.IsNullOrWhiteSpace(SelectedPosePhrase))
        {
            text[ImageStepSlotKind.Pose] = SelectedPosePhrase;
        }

        return text;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _error = string.Empty;
        _loadFailed = false;
        if (string.IsNullOrWhiteSpace(CharacterId))
        {
            _ownerMessage = "No character was given, so there is no identity to build a dataset for.";
            return;
        }

        try
        {
            // B-127: identity is keyed by the character TEMPLATE, so every read below uses the resolved key and
            // never the raw route id — the route may carry a scenario character or an asset.
            _owner = await OwnerResolver.ResolveAsync(CharacterId);
        }
        catch (Exception exception)
        {
            _ownerMessage = exception.Message;
            return;
        }

        _ownerMessage = string.Empty;
        _identityKey = _owner.TemplateId;
        _characterName = string.IsNullOrWhiteSpace(_owner.TemplateName) ? "Character" : _owner.TemplateName;

        // Everything past the owner resolve can fail on DATA rather than on a bug: a missing policy row, a stored
        // plan written by an older schema, a dataset whose policy will not parse. A component that lets one of
        // those escape takes the whole circuit down and shows the operator nothing — which is exactly what happened
        // on 2026-09-25. So the load is guarded and the failure is put on screen in the service's own words. That
        // is still failing fast: visibly, with its own reason, and never by continuing with a substitute.
        try
        {
            _policy = await LoraRepository.ResolveCurationPolicyAsync(_identityKey);
            _bodyCard = await BodyService.GetBodyCardAsync(_identityKey);
            _approvedPacks = (await IdentityService.ListPacksAsync(_identityKey))
                .Where(pack => pack.Status == CharacterImageIdentityPackStatus.Approved
                    && pack.PackScope == CharacterImageIdentityPackScope.BodyComplete)
                .OrderByDescending(pack => pack.Version)
                .ToList();
            _datasets = (await LoraRepository.ListDatasetsAsync(_identityKey))
                .OrderByDescending(dataset => dataset.Version)
                .ToList();

            if (_approvedPacks.Count > 0 && string.IsNullOrWhiteSpace(_newPackId))
            {
                _newPackId = _approvedPacks[0].Id;
            }

            if (string.IsNullOrWhiteSpace(_newTriggerToken))
            {
                // A proposal, not a hidden default: it is on screen, and the operator can overwrite it before saving.
                _newTriggerToken = $"ohwx-{Slug(_characterName)}";
            }

            _cellModels = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: false)).ToList();

            // B-133: the presets the operator may relight a cell with. They are store data like every other prompt
            // wording, so they are fetched rather than written into this page.
            _presetChoices = await ImagePresets.ListAsync(characterId: _identityKey);

            // The saved cell model is a PREFERENCE, not a prerequisite. It is read on its own so that a refusal here
            // cannot skip the INITIAL SELECTION below - which is exactly what left the model picker empty and, because
            // the composer needs a selected model to know what that model can carry, the whole reference UI unrendered
            // (reported live 2026-09-25: "the ability to add image references" was missing on this page).
            string? savedCellModel = null;
            try
            {
                savedCellModel = await CellService.ResolveCellModelAsync(_identityKey);
            }
            catch (Exception exception)
            {
                Logger.LogWarning(
                    exception,
                    "No saved LoRA cell model could be read for character {Character}; the first enabled image model is selected instead.",
                    _identityKey);
            }

            _cellModelId = !string.IsNullOrWhiteSpace(savedCellModel)
                && _cellModels.Any(model => string.Equals(model.ModelId, savedCellModel, StringComparison.Ordinal))
                    ? savedCellModel
                    : _cellModels.FirstOrDefault()?.ModelId ?? string.Empty;

            if (_datasets.Count > 0)
            {
                var target = _datasets.Any(dataset => dataset.Id == _selectedDatasetId)
                    ? _selectedDatasetId
                    : _datasets[0].Id;
                await LoadDatasetAsync(target);
            }
            else
            {
                _selectedDatasetId = string.Empty;
                _plan = null;
                _members = [];
                _selectedCellKey = string.Empty;
                // Both stale reasons describe the dataset that was loaded, so neither may outlive it: the component is
                // reused when the operator moves between characters, and an inherited banner would warn about a
                // document that is no longer on screen.
                _planStaleReason = null;
                _policyStaleReason = null;
            }

            // Arriving from somewhere that named a cell: open on it. Only honoured when the plan actually carries the
            // key, so a stale link cannot put the page into a state that no cell matches.
            if (_plan is not null
                && !string.Equals(_selectedCellKey, Cell, StringComparison.Ordinal)
                && !string.IsNullOrWhiteSpace(Cell)
                && _plan.Records.Any(record => string.Equals(record.Key, Cell, StringComparison.Ordinal)))
            {
                SelectCell(Cell);
                await RefreshAttemptsAsync();
            }
        }
        catch (Exception exception)
        {
            _plan = null;
            _members = [];
            _loadFailed = true;
            _error = exception.Message;
            Logger.LogError(exception, "The LoRA dataset workspace could not load for character {CharacterId}.", _identityKey);
        }
    }

    private async Task LoadDatasetAsync(string datasetId)
    {
        var dataset = _datasets.FirstOrDefault(candidate => candidate.Id == datasetId)
            ?? throw new InvalidOperationException($"LoRA dataset '{datasetId}' is not in this character's list.");

        _selectedDatasetId = dataset.Id;
        _plan = CoveragePlan.FromStoredJson(dataset.CoveragePlanJson, out var staleReason);
        _planStaleReason = staleReason;
        _policy = CurationPolicy.FromStoredJson(dataset.CurationPolicyJson, out var policyStaleReason);
        _policyStaleReason = policyStaleReason;
        _members = (await LoraRepository.ListDatasetMembersAsync(dataset.Id)).ToList();

        // Every cell's state is read once per dataset, so the list shows which cells are done without the operator
        // having to open each one. A decision on any of a cell's attempts is what makes it done.
        _cellStatuses.Clear();
        foreach (var record in _plan.Records)
        {
            _cellStatuses[record.Key] = await ResolveCellStatusAsync(record);
        }

        var rejected = _members.Count(member => member.CurationStatus == CharacterLoraCurationStatus.Rejected);
        if (rejected > 0)
        {
            _status = $"{rejected} cell(s) in this dataset were rejected and need re-shooting.";
        }
    }

    /// <summary>The resolved key for identity calls, exposed so a source contract can assert the route id is never used.</summary>
    private string IdentityKey => _identityKey;

    private IReadOnlyList<CellRow> FilteredRows
    {
        get
        {
            if (_plan is null)
            {
                return [];
            }

            var rows = _plan.Records
                .Select(record => new CellRow(
                    record,
                    MemberFor(record),
                    _cellStatuses.TryGetValue(record.Key, out var status) ? status : "planned"))
                .ToList();
            return _filter switch
            {
                "accepted" => rows.Where(row => row.Status == "accepted").ToList(),
                "remaining" => rows.Where(row => row.Status != "accepted").ToList(),
                // One value per state the badge can show, because the filter and the badge read the SAME field: a filter
                // that agreed with the badge only on "accepted" left the operator unable to find the cells that were
                // planned but never shot, which is the one list a coverage plan exists to produce.
                "planned" => rows.Where(row => row.Status == "planned").ToList(),
                "in review" => rows.Where(row => row.Status == "in review").ToList(),
                "rejected" => rows.Where(row => row.Status == "rejected").ToList(),
                _ => rows
            };
        }
    }

    /// <summary>
    /// Finds the member a cell already has. The join is the cell KEY recorded in the member's coverage snapshot,
    /// not its ordinal, so re-planning a dataset can never silently re-point a picture at the wrong cell.
    /// </summary>
    private CharacterLoraDatasetMember? MemberFor(CoverageRecord record)
    {
        foreach (var member in _members)
        {
            if (string.IsNullOrWhiteSpace(member.CoverageJson))
            {
                continue;
            }

            CoverageRecord? stored;
            try
            {
                stored = JsonSerializer.Deserialize<CoverageRecord>(member.CoverageJson, JsonOptions);
            }
            catch (JsonException)
            {
                // A snapshot that cannot be read is not silently matched to a cell; it simply claims none, and
                // the member still counts towards the dataset's totals.
                continue;
            }

            if (stored is not null && string.Equals(stored.Key, record.Key, StringComparison.Ordinal))
            {
                return member;
            }
        }

        return null;
    }

    private int AcceptedCount => _cellStatuses.Values.Count(status => status == "accepted");

    private int PlannedCount => _cellStatuses.Values.Count(status => status == "planned");

    private int InReviewCount => _cellStatuses.Values.Count(status => status == "in review");

    private int RejectedCount => _cellStatuses.Values.Count(status => status == "rejected");

    private int CaptionCount => _members.Count(member =>
        member.CurationStatus == CharacterLoraCurationStatus.Accepted && !string.IsNullOrWhiteSpace(member.Caption));

    private int ClothedCount => _plan?.Records.Count(record => record.WardrobeState == LoraCoverageWardrobeState.Clothed) ?? 0;

    private int UnclothedCount => _plan?.Records.Count(record => record.WardrobeState == LoraCoverageWardrobeState.Unclothed) ?? 0;

    private int BackgroundCount => _plan?.Records.Select(record => record.BackgroundKey).Distinct(StringComparer.Ordinal).Count() ?? 0;

    private int PoseClassCount => _plan?.Records.Select(record => record.PoseClass).Distinct().Count() ?? 0;

    private IReadOnlyList<string> Gaps => _plan is null || _policy is null ? [] : _plan.DescribeGaps(_policy);

    private CoverageRecord? SelectedRecord => _plan?.Records
        .FirstOrDefault(record => string.Equals(record.Key, _selectedCellKey, StringComparison.Ordinal));

    private string SelectedWardrobePhrase => Phrase(record => record.OutfitKey);

    /// <summary>
    /// The stance to show for a cell. A close-up claims no stance, because its frame cannot show one, so the page says
    /// so rather than printing an empty gap the operator has to interpret.
    /// </summary>
    private string SelectedPosePhrase => SelectedRecord is { PoseClass: null }
        ? "— (this framing shows no stance)"
        : Phrase(record => LoraCellWorkflowKeys.PoseKey(record.PoseClass!.Value));

    private string SelectedExpressionPhrase => Phrase(record => record.ExpressionKey);

    private string SelectedLightingPhrase => Phrase(record => record.LightingKey);

    private string SelectedBackgroundPhrase => Phrase(record => record.BackgroundKey);

    private string SelectedCaption => Compose(record => LoraCellPromptComposer.ComposeCaption(
        _plan!, record, _captionTemplateBody ?? string.Empty,
        // B-133: when the operator relights this cell with a picked preset, the caption tags the condition the image
        // will actually show. A caption that still named the plan's lighting would teach the trainer the wrong tag
        // over the image, which is worse than a plainer tag.
        LightingTagOverride));

    /// <summary>
    /// The text the prompt's SUBJECT slot takes (B-132). The cell templates declare one subject slot and no face
    /// element, so this is the whole-person description — WITHOUT the face clause when a bound reference image supplies
    /// the face, because a model being shown a face must not also be told in words what that face looks like.
    /// </summary>
    private string BodyCardLine
        => _cellBodyTexts is null
            ? string.Empty
            : CellSuppliedSlots.Contains(ImageStepSlotKind.Face)
                ? _cellBodyTexts.SubjectWithoutFace
                : _cellBodyTexts.SubjectWithFace;

    private string BodyCardNotice
        => _bodyCard is null
            ? "This character has no body card yet, so the render prompt cannot be composed. Fill it in on the Body tab."
            : string.IsNullOrWhiteSpace(BodyCardLine)
                ? "This character's body card has unanswered fields or no body text yet, so the render prompt cannot be "
                    + "composed. Finish it, and compose its body text, on the Body tab."
                : string.Empty;

    /// <summary>
    /// The subject noun the prompt keeps when a bound body reference supplies the build (B-132): the reference carries
    /// the build, never the fact that a person is in the frame. Read from the same body-text resolution as
    /// <see cref="BodyCardLine"/>, so the noun and the description cannot describe two different people.
    /// </summary>
    private string SubjectNoun => _cellBodyTexts?.SubjectNoun ?? string.Empty;

    private string Phrase(Func<CoverageRecord, string> select)
        => _plan is null || SelectedRecord is null ? string.Empty : _plan.PhraseFor(select(SelectedRecord));

    private string Compose(Func<CoverageRecord, string> compose)
    {
        if (_plan is null || SelectedRecord is null)
        {
            return string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(BodyCardNotice))
        {
            return BodyCardNotice;
        }

        try
        {
            return compose(SelectedRecord);
        }
        catch (Exception exception)
        {
            // The prompt is shown on screen, so a composition failure belongs on screen too. Returning a blank
            // would read as "this cell has no prompt" rather than "this template needs fixing".
            return exception.Message;
        }
    }

    private async Task SelectCellAsync(string key)
    {
        _selectedCellKey = key;
        _renderTemplateBody = null;
        _captionTemplateBody = null;
        _cellAttempts = [];

        var record = SelectedRecord;
        if (record is null)
        {
            return;
        }

        try
        {
            _renderTemplateBody = (await TemplateService.ResolveAsync(
                LoraCellPromptComposer.RenderTemplateKey(record), _identityKey)).Body;
            _captionTemplateBody = (await TemplateService.ResolveAsync(
                LoraCellWorkflowKeys.Caption, _identityKey)).Body;

            // What the render will be conditioned on, read from the pack before anything is shot, so a missing
            // reference is visible up front instead of surfacing as a failed render. Both references are read: the
            // face carries identity and the body carries the build, and a cell cannot be shot without the
            // state-matched body reference its own rule names. They are read as BINDINGS (B-130) so the step shows
            // them and the operator can change them before shooting, rather than the render resolving them privately.
            _cellIdentityReference = await CellService.DescribeIdentityReferenceAsync(_selectedDatasetId, record.Key);
            _cellBodyReference = await CellService.DescribeBodyReferenceAsync(_selectedDatasetId, record.Key);
            // The actor key is passed IN, so the binding names the SAME character the blueprint's slots address. Deriving
            // it here from the dataset would be a second answer to "whose reference is this", free to disagree with the
            // key the step was built with - which is exactly how the face and body references came to be invisible.
            _cellBindings = await CellService.ResolveCellBindingsAsync(_selectedDatasetId, record.Key, _identityKey);
            // Both canonical clauses for THIS cell's state (B-132), resolved by the service that owns them rather than
            // re-derived here from the card. One call, so the two elements and the prompt cannot describe two people.
            _cellBodyTexts = await BodyService.ResolveBodyTextsAsync(_identityKey, record.BodyState);
            // The composed prompt becomes the step's DRAFT rather than staying a read-only paragraph: the box is
            // editable, so an edit that the render ignored would be a lie about what is being shot.
            _cellPromptDraft = RenderPromptForShoot;
            await RefreshAttemptsAsync();
        }
        catch (Exception exception)
        {
            _cellIdentityReference = string.Empty;
            _cellBodyReference = string.Empty;
            _cellBindings = [];
            _cellBodyTexts = null;
            _cellPromptDraft = string.Empty;
            _error = exception.Message;
        }
    }

    /// <summary>
    /// Moves to the next cell in the list currently shown, wrapping at the end. It follows the FILTER, so selecting
    /// "Not accepted" and pressing this walks only the cells still to do.
    /// </summary>
    private async Task NextCellAsync()
    {
        var rows = FilteredRows;
        if (rows.Count == 0)
        {
            return;
        }

        var keys = rows.Select(row => row.Record.Key).ToList();
        var index = keys.FindIndex(key => string.Equals(key, _selectedCellKey, StringComparison.Ordinal));
        SelectCell(keys[(index + 1 + keys.Count) % keys.Count]);
        await RefreshAttemptsAsync();
        StateHasChanged();
    }

    /// <summary>
    /// The memory of which cell was being worked on, read and written here rather than in the load path.
    ///
    /// <para>
    /// JS interop is only legal once the component has rendered - the load runs during prerendering, where there is no
    /// browser to ask - so both halves live in this method. An explicit link (the review deck's way back) is the newest
    /// truth and is remembered first; otherwise the remembered cell is restored if the plan actually has it, so a
    /// remembered key from an old plan cannot select nothing.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrWhiteSpace(Cell))
            {
                _rememberedCell = Cell;
                await JS.InvokeVoidAsync("localStorage.setItem", CellMemoryKey, Cell);
            }
            else
            {
                var remembered = await JS.InvokeAsync<string?>("localStorage.getItem", CellMemoryKey);
                if (!string.IsNullOrWhiteSpace(remembered)
                    && _plan is not null
                    && !string.Equals(_selectedCellKey, remembered, StringComparison.Ordinal)
                    && _plan.Records.Any(record => string.Equals(record.Key, remembered, StringComparison.Ordinal)))
                {
                    SelectCell(remembered);
                    await RefreshAttemptsAsync();
                    StateHasChanged();
                }

                _rememberedCell = _selectedCellKey;
            }

            return;
        }

        if (!string.IsNullOrWhiteSpace(_selectedCellKey)
            && !string.Equals(_rememberedCell, _selectedCellKey, StringComparison.Ordinal))
        {
            _rememberedCell = _selectedCellKey;
            await JS.InvokeVoidAsync("localStorage.setItem", CellMemoryKey, _selectedCellKey);
        }
    }

    /// <summary>Re-reads this cell's attempts. Renders are queued, so a shot in flight is Pending until it lands.</summary>
    private async Task RefreshAttemptsAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedDatasetId) || string.IsNullOrWhiteSpace(_selectedCellKey))
        {
            _cellAttempts = [];
            _selectedAttemptId = null;
            return;
        }

        try
        {
            _cellAttempts = (await CellService.ListCellAttemptsAsync(_selectedDatasetId, _selectedCellKey)).ToList();
            // The cell's state follows the decision just made on it, so the list updates without a full reload.
            _cellStatuses[_selectedCellKey] = MemberStatus(SelectedMember) ?? AttemptStatus(_cellAttempts) ?? "planned";
            if (_selectedAttemptId is null || _cellAttempts.All(attempt => attempt.Id != _selectedAttemptId))
            {
                _selectedAttemptId = _cellAttempts.FirstOrDefault()?.Id;
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    /// <summary>The member a cell has, if the dataset has one: the later, authoritative record of that cell's image.</summary>
    private CharacterLoraDatasetMember? SelectedMember
        => SelectedRecord is null ? null : MemberFor(SelectedRecord);

    /// <summary>A member's own state, or null when there is no member yet.</summary>
    private static string? MemberStatus(CharacterLoraDatasetMember? member) => member?.CurationStatus switch
    {
        CharacterLoraCurationStatus.Accepted => "accepted",
        CharacterLoraCurationStatus.Rejected => "rejected",
        null => null,
        _ => "in review"
    };

    /// <summary>
    /// The state of a cell: the member's when the dataset has one, otherwise the DECISION the operator made on one of
    /// the cell's attempts, otherwise pending. The decision is what makes a cell "done" today, because accepting an
    /// image records a decision on the attempt and the accept-into-dataset path that would write a member is not built
    /// (B-123 P1-05). Reading only members made every cell say "planned" no matter how many were accepted.
    /// </summary>
    private async Task<string> ResolveCellStatusAsync(CoverageRecord record)
        => MemberStatus(MemberFor(record))
            ?? AttemptStatus(await CellService.ListCellAttemptsAsync(_selectedDatasetId, record.Key))
            ?? "planned";

    /// <summary>What a set of attempts says about the cell. A decision outranks a picture that is merely finished.</summary>
    private static string? AttemptStatus(IReadOnlyList<SceneAssetImage> attempts)
    {
        if (attempts.Any(attempt => attempt.CandidateDecision == SceneAssetCandidateDecision.Accepted))
        {
            return "accepted";
        }

        if (attempts.Any(attempt => attempt.CandidateDecision == SceneAssetCandidateDecision.Rejected))
        {
            return "rejected";
        }

        return attempts.Any(attempt => attempt.Status == SceneAssetStatus.Complete) ? "in review" : null;
    }

    /// <summary>The shared candidate grid's view of this cell's attempts.</summary>
    private IReadOnlyList<CandidateGridItem> AttemptItems => _cellAttempts
        .Select(attempt => new CandidateGridItem(
            attempt.Id,
            attempt.FileRelativePath,
            attempt.Status.ToString(),
            attempt.CreatedUtc.ToLocalTime().ToString("g"),
            attempt.CandidateDecision?.ToString()))
        .ToList();

    /// <summary>
    /// The review-deck route for THIS cell's candidate batch. The cell renders with a batch id, so its attempts are a
    /// candidate batch like any other and the standard deck can open them - the `/asset` kind, because these are
    /// scene-asset images and the bare route reads the older produced-images table.
    /// </summary>
    private string? CellReviewDeckUrl => _cellAttempts
        .Select(attempt => attempt.CandidateBatchId)
        .FirstOrDefault(batchId => !string.IsNullOrWhiteSpace(batchId)) is { } batch
            // The deck is told where to come back to: this tab, this cell. The deck's own "back" is derived from the
            // batch and can only reach the character page, which left the operator to find the tab and the cell again.
            ? $"/review-deck/asset/{batch}?return={Uri.EscapeDataString($"/characters/{CharacterId}?section=LoRA images&cell={_selectedCellKey}")}"
            : null;

    /// <summary>
    /// The review deck for the WHOLE dataset, optionally narrowed to the accepted attempts. Both the scope and the
    /// filter are in the address, and `return` carries this cell so the deck hands the operator back to where they were.
    /// </summary>
    private string DatasetReviewDeckUrl(string only)
    {
        var back = Uri.EscapeDataString($"/characters/{CharacterId}?section=LoRA images&cell={_selectedCellKey}");
        return $"/review-deck/dataset/{_selectedDatasetId}?only={only}&return={back}";
    }

    /// <summary>
    /// The edit route for one attempt, built from the CARD rather than from the selected attempt, so the operator can
    /// open the editor on any image in the cell without selecting it first. It reuses the same URL builder the detail
    /// panel's "Edit pass" button uses, so there is one edit route and not two that could drift apart. Null when the
    /// attempt has no asset behind it, so no dead button is rendered.
    /// </summary>
    private string? EditAttemptUrl(string attemptId)
        => _cellAttempts.FirstOrDefault(attempt => string.Equals(attempt.Id, attemptId, StringComparison.Ordinal)) is { } attempt
            && !string.IsNullOrWhiteSpace(attempt.AssetId)
                ? EditPassUrl(attempt)
                : null;

    private SceneAssetImage? _selectedAttempt => _selectedAttemptId is null
        ? null
        : _cellAttempts.FirstOrDefault(attempt => string.Equals(attempt.Id, _selectedAttemptId, StringComparison.Ordinal));

    // ---- B-133 preset override for this cell -------------------------------------------------------------------
    //
    // Null means "the condition the HOST already carries" - the cell's own planned lighting, which is what the plan
    // exists to state. Picking a preset replaces it for this shot, and the pick is what reaches the prompt and the
    // caption tag. The presets themselves come from the store, so the operator's wording stays their data.
    private IReadOnlyList<ImagePresetChoice> _presetChoices = [];
    private string? _lightingPresetOverride;

    /// <summary>The picked preset's own words, or null when the cell's plan supplies the condition.</summary>
    private string? LightingPhraseOverride => _lightingPresetOverride is null
        ? null
        : _presetChoices.FirstOrDefault(choice => string.Equals(choice.PresetKey, _lightingPresetOverride, StringComparison.Ordinal))?.Detail;

    /// <summary>The caption tag for an overridden condition: the preset's own short name, never the plan's wording.</summary>
    private string? LightingTagOverride => _lightingPresetOverride is null
        ? null
        : ImagePresetKeys.ShortName(_lightingPresetOverride);

    private string PresetNote => _lightingPresetOverride is null
        ? "This cell's plan supplies the lighting; pick a preset to relight this shot."
        : "Overriding this cell's planned lighting for this shot.";

    private Task OnLightingPresetChangedAsync(string? presetKey)
    {
        _lightingPresetOverride = string.IsNullOrWhiteSpace(presetKey) ? null : presetKey;
        // The draft is what is shot, so it is recomposed from the same source the caption is - never patched in place.
        _cellPromptDraft = RenderPromptForShoot;
        return Task.CompletedTask;
    }

    private void OnAttemptSelected(string id) => _selectedAttemptId = id;

    /// <summary>
    /// The preset this cell's edit pass opens on (B-133): the SAME lighting its plan asked it to be shot in, mapped
    /// by key suffix. It is a default, not a decision - the editor lists every preset and the operator can pick
    /// another, including an expression pass on the same image.
    /// </summary>
    private string EditPassPresetKey => SelectedRecord is null
        ? ImagePresetKeys.LightingIndoorBright
        : ImagePresetKeys.PresetKeyFor(SelectedRecord.LightingKey);

    /// <summary>The edit-pass route for an attempt: the shared editor, opened on the Presets tab with the cell's preset.</summary>
    private string EditPassUrl(SceneAssetImage attempt)
        => $"/assets/{attempt.AssetId}/images/{attempt.Id}/edit?preset={Uri.EscapeDataString(EditPassPresetKey)}";

    /// <summary>
    /// True when this cell can be shot at all: it needs a renderable body card, a resolved render template and a
    /// chosen model. The workspace says which of those is missing rather than leaving a dead button.
    /// </summary>
    private bool CanRender => _plan is not null
        && SelectedRecord is not null
        && string.IsNullOrWhiteSpace(BodyCardNotice)
        && !string.IsNullOrWhiteSpace(_renderTemplateBody)
        && !string.IsNullOrWhiteSpace(_cellModelId);

    private string RenderBlockedReason => !string.IsNullOrWhiteSpace(BodyCardNotice)
        ? BodyCardNotice
        : string.IsNullOrWhiteSpace(_cellModelId)
            ? "Choose the image model this cell is shot with."
            : string.Empty;

    /// <summary>
    /// The exact text this cell is rendered from - the same composition shown above, never a second one. The
    /// elements the bound reference images supply are LEFT OUT (D4) through the same omission set the composer
    /// reports to the operator, so the prompt and the "left out of the prompt" list cannot disagree. The subject is
    /// the ONE element a body reference does not supply, so the composer keeps its noun.
    /// </summary>
    private string RenderPromptForShoot => Compose(record => LoraCellPromptComposer.ComposeRenderPrompt(
        _plan!, record, BodyCardLine, _renderTemplateBody ?? string.Empty,
        _cellBodyTexts?.FaceText,
        ImageStepPromptOmission.BoundSlotsFor(CellBlueprint, _cellBindings).Select(slot => slot.SlotKind).ToList(),
        SubjectNoun,
        // B-133: the cell's plan supplies the condition; a picked preset replaces it, because relighting a shot is a
        // deliberate operator decision and the prompt is where it has to land.
        LightingPhraseOverride));

    private void SelectCell(string key) => _ = SelectCellAsync(key);

    private async Task OnCellModelSelectedAsync(string? modelId)
    {
        _cellModelId = modelId ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_cellModelId) || string.IsNullOrWhiteSpace(_identityKey))
        {
            return;
        }

        try
        {
            await CellService.SaveCellModelAsync(_identityKey, _cellModelId);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private Task OnCellBindingsChanged(IReadOnlyList<ReferenceApplicationSelection> bindings)
    {
        _cellBindings = bindings;
        return Task.CompletedTask;
    }

    private Task OnCellPromptChanged(string? prompt)
    {
        _cellPromptDraft = prompt ?? string.Empty;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Re-derives this cell's prompt from its axes AND the references as they now stand. Deliberately NOT
    /// <c>SelectCellAsync</c>: that re-resolves the bindings from the pack and would throw away a reference the
    /// operator had just changed, which is the opposite of what regenerating a prompt is for.
    /// </summary>
    private Task GenerateCellPromptAsync()
    {
        _cellPromptDraft = RenderPromptForShoot;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Shoots ONE image for the selected cell. There is no batch here and there must never be one: the training set
    /// is judged frame by frame, and a sweep is how a set of near-duplicates gets made.
    /// </summary>
    private async Task RenderCellAsync()
    {
        var record = SelectedRecord;
        if (record is null || string.IsNullOrWhiteSpace(_selectedDatasetId))
        {
            return;
        }

        _cellBusy = true;
        _error = string.Empty;
        _status = string.Empty;
        try
        {
            var image = await CellService.RenderCellAsync(
                _selectedDatasetId, record.Key, _cellPromptDraft.Trim(), _cellModelId, record.Aspect, _cellBindings);
            var reference = string.IsNullOrWhiteSpace(_cellIdentityReference)
                ? "no face reference — this view shows none"
                : _cellIdentityReference;
            var bodyReference = string.IsNullOrWhiteSpace(_cellBodyReference)
                ? "no body reference — this cell cannot be rendered on the character's build"
                : _cellBodyReference;
            _status = $"Queued one render for {record.Key} with {_cellModelId}, conditioned on {reference} "
                + $"and {bodyReference}. It appears here as Pending until the worker finishes it.";
            Logger.LogInformation(
                "Queued one LoRA coverage cell render: DatasetId={DatasetId}, Cell={Cell}, ImageId={ImageId}, Model={Model}.",
                _selectedDatasetId, record.Key, image.Id, _cellModelId);
            await RefreshAttemptsAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            Logger.LogWarning(exception, "Rendering LoRA coverage cell {Cell} failed.", record.Key);
        }
        finally
        {
            _cellBusy = false;
        }
    }

    private async Task DiscardSelectedAttemptAsync()
    {
        var attempt = _selectedAttempt;
        if (attempt is null)
        {
            return;
        }

        _cellBusy = true;
        _error = string.Empty;
        try
        {
            await CellService.DiscardAttemptAsync(attempt.Id);
            _selectedAttemptId = null;
            await RefreshAttemptsAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _cellBusy = false;
        }
    }

    /// <summary>
    /// Records a review decision on one attempt straight from the list, so the cell behaves like the face and body
    /// workflows rather than making the operator open the deck to say "this one is good".
    /// </summary>
    private async Task OnAttemptDecisionAsync(CandidateGridDecision decision)
    {
        _cellBusy = true;
        _error = string.Empty;
        try
        {
            await CellService.SetAttemptDecisionAsync(decision.CandidateId, decision.Decision);
            await RefreshAttemptsAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _cellBusy = false;
        }
    }

    /// <summary>Deletes one attempt straight from the list — the standard grid action, not only the selected one.</summary>
    private async Task OnAttemptDeleteAsync(string candidateId)
    {
        _cellBusy = true;
        _error = string.Empty;
        try
        {
            await CellService.DiscardAttemptAsync(candidateId);
            if (string.Equals(_selectedAttemptId, candidateId, StringComparison.Ordinal))
            {
                _selectedAttemptId = null;
            }

            await RefreshAttemptsAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _cellBusy = false;
        }
    }

    private void ToggleGrid() => _gridCollapsed = !_gridCollapsed;

    private void OnFilterChanged(ChangeEventArgs args) => _filter = args.Value?.ToString() ?? "all";

    private void OnNewPackChanged(ChangeEventArgs args) => _newPackId = args.Value?.ToString() ?? string.Empty;

    private async Task OnDatasetChangedAsync(ChangeEventArgs args)
    {
        var datasetId = args.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(datasetId))
        {
            return;
        }

        _error = string.Empty;
        _selectedCellKey = string.Empty;
        _renderTemplateBody = null;
        _captionTemplateBody = null;

        try
        {
            await LoadDatasetAsync(datasetId);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private async Task ToggleNewDatasetAsync()
    {
        _newDatasetOpen = !_newDatasetOpen;
        _error = string.Empty;
        _status = string.Empty;

        if (!_newDatasetOpen || _approvedPacks.Count == 0 || !string.IsNullOrWhiteSpace(_newTargetFamily))
        {
            return;
        }

        // The family is proposed from a training profile that actually exists and is qualified, so the operator
        // picks between real options instead of inventing a name no profile will ever match.
        var qualified = (await LoraRepository.ListTrainingProfilesAsync())
            .Where(profile => profile.Status == CharacterLoraTrainingProfileStatus.Qualified && profile.Enabled)
            .Select(profile => profile.TargetModelFamily)
            .Where(family => !string.IsNullOrWhiteSpace(family))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        if (qualified.Count > 0)
        {
            _newTargetFamily = qualified[0];
        }
    }

    private async Task CreateDatasetAsync()
    {
        _busy = true;
        _error = string.Empty;
        _status = string.Empty;
        try
        {
            var pack = _approvedPacks.FirstOrDefault(candidate => candidate.Id == _newPackId)
                ?? throw new InvalidOperationException("Select an approved, body-complete identity pack first.");

            var plan = await PlanGenerator.GenerateAsync(new CoveragePlanRequest(
                _identityKey,
                pack.Id,
                pack.Version,
                pack.PackScope,
                _newTriggerToken,
                _newTargetFamily));
            var policy = await LoraRepository.ResolveCurationPolicyAsync(_identityKey);

            var nextVersion = _datasets.Count == 0 ? 1 : _datasets.Max(dataset => dataset.Version) + 1;
            var dataset = new CharacterLoraDataset
            {
                CharacterTemplateId = _identityKey,
                IdentityPackId = pack.Id,
                Version = nextVersion,
                Status = CharacterLoraDatasetStatus.Draft,
                TriggerToken = _newTriggerToken.Trim(),
                TargetModelFamily = _newTargetFamily.Trim(),
                CoveragePlanJson = plan.ToJson(),
                CurationPolicyJson = policy.ToJson(),
                CreatedUtc = DateTime.UtcNow
            };
            await LoraRepository.CreateDatasetAsync(dataset);

            _selectedCellKey = string.Empty;
            _renderTemplateBody = null;
            _captionTemplateBody = null;
            _newDatasetOpen = false;
            await LoadAsync();
            _status = $"Created dataset v{dataset.Version} with {plan.Records.Count} cells from pack v{pack.Version}.";
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            Logger.LogWarning(exception, "Creating a LoRA dataset for character {CharacterId} failed.", _identityKey);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusBadge(string status) => status switch
    {
        "accepted" => "text-bg-success",
        "rejected" => "text-bg-danger",
        "in review" => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private static string Slug(string value)
    {
        var characters = value.Where(char.IsLetterOrDigit).ToArray();
        return characters.Length == 0 ? "character" : new string(characters).ToLowerInvariant();
    }

    private sealed record CellRow(CoverageRecord Record, CharacterLoraDatasetMember? Member, string Status);
}
