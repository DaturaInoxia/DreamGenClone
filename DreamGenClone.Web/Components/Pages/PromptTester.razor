@page "/prompt-tester"
@rendermode InteractiveServer
@using DreamGenClone.Application.Abstractions
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Application.PromptTester
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.PromptTester
@using DreamGenClone.Web.Application.ModelManager

@inject ModelManagerFacade Facade
@inject ICompletionClient CompletionClient
@inject IApiKeyEncryptionService EncryptionService
@inject IPromptTestRunRepository PromptTestRunRepo

<PageTitle>Prompt Tester - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <h1 class="mb-4"><i class="bi bi-terminal"></i> Prompt Tester</h1>
    <p class="text-muted mb-4">Send a raw prompt to any registered model and inspect the response. Useful for testing prompt phrasing, injection wording, and model behaviour in isolation.</p>

    @if (!string.IsNullOrEmpty(_globalError))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @_globalError
            <button type="button" class="btn-close" @onclick="() => _globalError = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(_activeTab == "previous" ? "active" : "")" @onclick='() => _activeTab = "previous"'>
                <i class="bi bi-clock-history me-1"></i> Previous Runs
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_activeTab == "tester" ? "active" : "")" @onclick='() => _activeTab = "tester"'>
                <i class="bi bi-terminal me-1"></i> Prompt Tester
            </button>
        </li>
    </ul>

    @if (_activeTab == "previous")
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Previous Runs</h5>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadPreviousRuns" disabled="@_isLoadingRuns">
                    @if (_isLoadingRuns) { <span class="spinner-border spinner-border-sm"></span> }
                    else { <i class="bi bi-arrow-clockwise"></i> }
                </button>
            </div>
            <div class="card-body">
                @if (_previousRuns.Count == 0)
                {
                    <div class="text-muted">No saved runs yet. Execute a prompt and save it to see it here.</div>
                }
                @foreach (var run in _previousRuns)
                {
                    var isActive = _loadedRunId == run.Id;
                    <div class="card mb-2 @(isActive ? "border-primary" : "")">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1 me-2">
                                    <small class="text-muted">@FormatTimestamp(run.CreatedUtc)</small>
                                    <div class="fw-semibold small">@run.ModelDisplayName</div>
                                    @if (!string.IsNullOrWhiteSpace(run.Comment))
                                    {
                                        <div class="small text-truncate" style="max-width: 500px;" title="@run.Comment">
                                            <i class="bi bi-chat-left-text me-1"></i>@run.Comment
                                        </div>
                                    }
                                    <div class="small text-muted">
                                        @run.PromptCharCount chars &middot; @run.ResultWordCount words &middot; @run.ElapsedSeconds.ToString("F1")s
                                    </div>
                                </div>
                                <div class="d-flex gap-1 flex-shrink-0">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => LoadRun(run)" title="Load this run">
                                        <i class="bi bi-arrow-down-circle me-1"></i> Load
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteRun(run)" title="Delete this run">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-cpu"></i> Model</h5>
        </div>
        <div class="card-body">
            @if (_modelsDropdown.Count == 0)
            {
                <div class="alert alert-info mb-0">No enabled models found. Register and enable a model in <a href="model-manager">Model Manager</a>.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Model</label>
                        <select class="form-select" @bind="SelectedModelKey">
                            <option value="">-- Select a model --</option>
                            @foreach (var entry in _modelsDropdown)
                            {
                                <option value="@entry.Key">@(entry.Label)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Temperature</label>
                        <input type="number" class="form-control" @bind="_temperature" min="0" max="2" step="0.05" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">TopP</label>
                        <input type="number" class="form-control" @bind="_topP" min="0" max="1" step="0.05" />
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-2">
                        <label class="form-label">MaxTokens</label>
                        <input type="number" class="form-control" @bind="_maxTokens" min="1" max="8192" step="50" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Presence Penalty</label>
                        <input type="number" class="form-control" @bind="_presencePenalty" min="-2" max="2" step="0.1" placeholder="omit" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Seed</label>
                        <input type="number" class="form-control" @bind="_seed" placeholder="random" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Thinking</label>
                        <select class="form-select" @bind="_thinkingMode" disabled="@(!SelectedModelControlsThinking)">
                            <option value="@ThinkingMode.Default">Model default</option>
                            <option value="@ThinkingMode.Enabled">On (chat_template_kwargs.thinking=true)</option>
                            <option value="@ThinkingMode.Disabled">Off (chat_template_kwargs.thinking=false)</option>
                        </select>
                        @if (!string.IsNullOrEmpty(_selectedModelKey) && !SelectedModelControlsThinking)
                        {
                            <small class="text-muted">This model does not declare thinking support, so the flag would be ignored.</small>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-chat-left-text"></i> Prompt</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">System Message <small class="text-muted">(optional)</small></label>
                <textarea class="form-control" rows="4" @bind="_systemMessage"
                          placeholder="Optional system instructions for the model..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">User Prompt <small class="text-muted">(required)</small></label>
                <textarea class="form-control" rows="12" style="font-family: 'Cascadia Code', 'Fira Code', monospace; font-size: 0.9em;"
                          @bind="_userPrompt" placeholder="Enter your prompt here..."></textarea>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-primary" @onclick="ExecutePrompt" disabled="@(!CanExecute || _isExecuting)">
                    @if (_isExecuting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-play-fill me-1"></i>
                    }
                    Execute
                </button>
                @if (!CanExecute && !_isExecuting)
                {
                    <small class="text-muted">@(string.IsNullOrEmpty(_selectedModelKey) ? "Select a model to enable execution." : "Enter a prompt to enable execution.")</small>
                }
                @if (_elapsedMs.HasValue)
                {
                    <small class="text-muted"><i class="bi bi-stopwatch me-1"></i>@(_elapsedMs.Value.ToString("F2"))s</small>
                }
            </div>
        </div>
    </div>

    @if (_resultText is not null || _resultReasoning is not null || _resultError is not null)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-eye"></i> Result</h5>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-secondary">Prompt: @_promptCharCount chars</span>
                    <span class="badge bg-secondary">Output: @_resultWordCount words &middot; @_resultParagraphCount ¶</span>
                    @if (_resultReasoningCharCount > 0)
                    {
                        <span class="badge bg-dark">Reasoning: @_resultReasoningCharCount chars</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_resultText))
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CopyResult">
                            <i class="bi bi-clipboard me-1"></i> Copy
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (_resultError is not null)
                {
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i> @_resultError
                    </div>
                }

                @if (string.IsNullOrWhiteSpace(_resultText) && string.IsNullOrWhiteSpace(_resultReasoning))
                {
                    @if (_resultError is null)
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            The model returned no text at all — not even reasoning. Raise MaxTokens or try another model.
                        </div>
                    }
                }
                else
                {
                    @if (string.IsNullOrWhiteSpace(_resultText))
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-1"></i>
                            No prose returned: the model spent its whole budget on reasoning. Its reasoning is shown below —
                            raise MaxTokens to get an actual answer.
                        </div>
                        <pre class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; max-height: 600px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 0.375rem; font-size: 0.9em;">@_resultReasoning</pre>
                    }
                    else
                    {
                        <pre class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; max-height: 600px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 0.375rem; font-size: 0.9em;">@_resultText</pre>
                    }

                    @if (!string.IsNullOrWhiteSpace(_resultReasoning))
                    {
                        <details class="mt-3">
                            <summary class="text-muted small">Reasoning trace (@_resultReasoningCharCount chars)</summary>
                            <pre class="mt-2 mb-0" style="white-space: pre-wrap; word-wrap: break-word; max-height: 400px; overflow-y: auto; background: #f4f4f4; color: #333; padding: 1rem; border-radius: 0.375rem; font-size: 0.85em;">@_resultReasoning</pre>
                        </details>
                    }
                }
            </div>
        </div>

        @* ═══════════════ SAVE RUN ═══════════════ *@
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-bookmark"></i> Save Run</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_saveError))
                {
                    <div class="alert alert-danger mb-3">@_saveError</div>
                }
                @if (_saveSuccess)
                {
                    <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-1"></i> Run saved successfully.</div>
                }
                <div class="row g-3 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label">Comment <small class="text-muted">(optional — e.g. "added pacing directive")</small></label>
                        <input type="text" class="form-control" @bind="_comment" maxlength="500"
                               placeholder="What changed? Why did you run this test?" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-success w-100" @onclick="SaveRun" disabled="@(_isSaving || (string.IsNullOrWhiteSpace(_resultText) && _resultError is null))">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-bookmark-fill me-1"></i>
                            }
                            Save Run
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    }
</div>

@code {
    private readonly Dictionary<string, (string ProviderName, Provider Provider, RegisteredModel Model)> _resolvedModels = [];
    private List<(string Key, string Label)> _modelsDropdown = [];

    // Tabs
    private string _activeTab = "previous";

    private string _selectedModelKey = string.Empty;

    /// <summary>
    /// Bound to the model dropdown. Changing the model resets every input to that model's defaults: leaving
    /// the previous model's sampling — and above all its thinking mode — in place silently sent the same
    /// settings to a different model, so the choice of model stopped being the only variable.
    /// </summary>
    private string SelectedModelKey
    {
        get => _selectedModelKey;
        set
        {
            if (string.Equals(_selectedModelKey, value, StringComparison.Ordinal))
            {
                return;
            }

            _selectedModelKey = value;
            ApplyModelDefaults();
        }
    }
    private double _temperature = 0.7;
    private double _topP = 0.9;
    private int _maxTokens = 500;

    /// <summary>Sent as presence_penalty when set; null omits the field entirely (the client only sends it when declared).</summary>
    private double? _presencePenalty;

    /// <summary>Sent as seed when set, so two runs of the same wording are reproducible.</summary>
    private long? _seed;

    private ThinkingMode _thinkingMode = ThinkingMode.Default;

    private string _systemMessage = string.Empty;
    private string _userPrompt = string.Empty;

    private bool _isExecuting;
    private string? _resultText;
    private string? _resultReasoning;
    private string? _resultError;
    private double? _elapsedMs;
    private string? _globalError;

    // Metrics
    private int _promptCharCount;
    private int _resultWordCount;
    private int _resultCharCount;
    private int _resultParagraphCount;
    private int _resultReasoningCharCount;

    // Save
    private string _comment = string.Empty;
    private bool _isSaving;
    private bool _saveSuccess;
    private string? _saveError;

    // Previous runs
    private List<PromptTestRun> _previousRuns = [];
    private string? _loadedRunId;
    private bool _isLoadingRuns;

    private bool CanExecute => !string.IsNullOrEmpty(_selectedModelKey) && !string.IsNullOrWhiteSpace(_userPrompt) && !_isExecuting;

    /// <summary>
    /// True only when the selected model declares chat_template_kwargs support; sending a thinking flag to a
    /// model that ignores it would make the toggle look like it did something.
    /// </summary>
    private bool SelectedModelControlsThinking
        => !string.IsNullOrEmpty(_selectedModelKey)
           && _resolvedModels.TryGetValue(_selectedModelKey, out var entry)
           && entry.Model.SupportsThinkingControl;

    /// <summary>
    /// Puts the tester back to neutral settings for the newly selected model and clears any result that
    /// belonged to the previous one. Called from <see cref="SelectedModelKey"/> only, so loading a saved run
    /// (which assigns the model first and its values afterwards) still restores exactly what was saved.
    /// </summary>
    private void ApplyModelDefaults()
    {
        _temperature = 0.7;
        _topP = 0.9;
        _presencePenalty = null;
        _seed = null;
        _thinkingMode = ThinkingMode.Default;

        // Never ask for more output than the model declares it can produce, or the first request 400s.
        _maxTokens = 500;
        if (_resolvedModels.TryGetValue(_selectedModelKey, out var entry)
            && entry.Model.MaximumOutputTokens is { } limit
            && limit > 0
            && limit < _maxTokens)
        {
            _maxTokens = limit;
        }

        // A result belongs to the model that produced it; showing it under a new model reads as that model's.
        _resultText = null;
        _resultReasoning = null;
        _resultError = null;
        _resultWordCount = 0;
        _resultCharCount = 0;
        _resultParagraphCount = 0;
        _resultReasoningCharCount = 0;
        _elapsedMs = null;
        _loadedRunId = null;
        _saveSuccess = false;
        _saveError = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var grouped = await Facade.GetAllModelsGroupedByProviderAsync();

            foreach (var (provider, models) in grouped)
            {
                if (!provider.IsEnabled) continue;

                foreach (var model in models.Where(m => m.IsEnabled && m.ModelKind == ModelKind.Text))
                {
                    var key = model.Id;
                    var label = $"{provider.Name} / {model.DisplayName}";
                    _modelsDropdown.Add((key, label));
                    _resolvedModels[key] = (provider.Name, provider, model);
                }
            }

            await LoadPreviousRuns();
        }
        catch (Exception ex)
        {
            _globalError = $"Failed to load models: {ex.Message}";
        }
    }

    private async Task ExecutePrompt()
    {
        if (!CanExecute) return;

        _resultText = null;
        _resultReasoning = null;
        _resultError = null;
        _isExecuting = true;
        _elapsedMs = null;
        _saveSuccess = false;
        _saveError = null;
        _loadedRunId = null;
        _activeTab = "tester";
        StateHasChanged();

        try
        {
            var (_, provider, model) = _resolvedModels[_selectedModelKey];

            var resolved = new ResolvedModel(
                ProviderBaseUrl: provider.BaseUrl,
                ChatCompletionsPath: provider.ChatCompletionsPath,
                ProviderTimeoutSeconds: provider.TimeoutSeconds,
                ApiKeyEncrypted: provider.ApiKeyEncrypted,
                ModelIdentifier: model.ModelIdentifier,
                Temperature: _temperature,
                TopP: _topP,
                MaxTokens: _maxTokens,
                ProviderName: provider.Name,
                IsSessionOverride: false)
            {
                PresencePenalty = _presencePenalty,
                Seed = _seed,
                SupportsThinkingControl = model.SupportsThinkingControl,
                ThinkingMode = _thinkingMode
            };

            _promptCharCount = string.IsNullOrWhiteSpace(_systemMessage)
                ? _userPrompt.Length
                : _systemMessage.Length + _userPrompt.Length;

            var sw = System.Diagnostics.Stopwatch.StartNew();

            // Reasoning-aware call: this is the only path that returns reasoning_content separately, so the
            // tester can show a refusal/prose below and the model's thinking above instead of losing it.
            var (content, reasoning) = string.IsNullOrWhiteSpace(_systemMessage)
                ? await CompletionClient.GenerateWithReasoningAsync(_userPrompt, resolved)
                : await CompletionClient.GenerateWithReasoningAsync(_systemMessage, _userPrompt, resolved);

            sw.Stop();
            _elapsedMs = sw.Elapsed.TotalSeconds;
            _resultText = content;
            _resultReasoning = string.IsNullOrWhiteSpace(reasoning) ? null : reasoning;
            _resultCharCount = content.Length;
            _resultWordCount = CountWords(content);
            _resultParagraphCount = CountParagraphs(content);
            _resultReasoningCharCount = _resultReasoning?.Length ?? 0;
        }
        catch (IncompleteCompletionException ex)
        {
            // The provider cut the stream mid-generation. Keep the partial prose on screen and say why it
            // stops, otherwise a truncated scene reads as the model's whole answer (or as a refusal).
            _resultText = ex.PartialContent;
            _resultReasoning = string.IsNullOrWhiteSpace(ex.PartialReasoning) ? null : ex.PartialReasoning;
            _resultCharCount = ex.PartialContent.Length;
            _resultWordCount = CountWords(ex.PartialContent);
            _resultParagraphCount = CountParagraphs(ex.PartialContent);
            _resultReasoningCharCount = _resultReasoning?.Length ?? 0;
            _resultError =
                $"Provider aborted the stream after {ex.PartialContent.Length} characters: \"{ex.Message}\". "
                + "The text below is incomplete — raising MaxTokens will not help. Together's managed chat layer returns "
                + "this when it cuts a generation, usually output moderation on explicit content or an upstream failure.";
        }
        catch (Exception ex)
        {
            _resultError = $"Execution failed: {ex.Message}";
            _resultCharCount = 0;
            _resultWordCount = 0;
            _resultParagraphCount = 0;
            _resultReasoningCharCount = 0;
        }
        finally
        {
            _isExecuting = false;
            StateHasChanged();
        }
    }

    private async Task SaveRun()
    {
        if (string.IsNullOrWhiteSpace(_resultText) && _resultError is null) return;

        _isSaving = true;
        _saveSuccess = false;
        _saveError = null;
        StateHasChanged();

        try
        {
            var (_, provider, model) = _resolvedModels[_selectedModelKey];

            var run = new PromptTestRun
            {
                Comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim(),
                ModelIdentifier = model.ModelIdentifier,
                ModelDisplayName = model.DisplayName,
                ProviderName = provider.Name,
                SystemMessage = string.IsNullOrWhiteSpace(_systemMessage) ? null : _systemMessage,
                UserPrompt = _userPrompt,
                Temperature = _temperature,
                TopP = _topP,
                MaxTokens = _maxTokens,
                ResultText = _resultText,
                ResultError = _resultError,
                PromptCharCount = _promptCharCount,
                ResultWordCount = _resultWordCount,
                ResultCharCount = _resultCharCount,
                ElapsedSeconds = _elapsedMs ?? 0,
                CreatedUtc = DateTime.UtcNow.ToString("o")
            };

            await PromptTestRunRepo.SaveAsync(run);
            _saveSuccess = true;
            _loadedRunId = run.Id;

            await LoadPreviousRuns();
        }
        catch (Exception ex)
        {
            _saveError = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task LoadPreviousRuns()
    {
        _isLoadingRuns = true;
        StateHasChanged();

        try
        {
            _previousRuns = await PromptTestRunRepo.GetAllAsync(50);
        }
        catch (Exception)
        {
            // Silent fail for previous runs list
        }
        finally
        {
            _isLoadingRuns = false;
            StateHasChanged();
        }
    }

    private void LoadRun(PromptTestRun run)
    {
        var matchingKey = _modelsDropdown
            .FirstOrDefault(e => _resolvedModels.ContainsKey(e.Key) &&
                                 (_resolvedModels[e.Key].Model.Id == run.ModelIdentifier ||
                                  _resolvedModels[e.Key].Model.ModelIdentifier == run.ModelIdentifier)).Key;

        if (!string.IsNullOrEmpty(matchingKey))
        {
            // Uses the bound property on purpose: its defaults are applied first, then the saved values below
            // overwrite them, so a loaded run still restores exactly what was saved for that model.
            SelectedModelKey = matchingKey;
        }

        _systemMessage = run.SystemMessage ?? string.Empty;
        _userPrompt = run.UserPrompt;
        _temperature = run.Temperature;
        _topP = run.TopP;
        _maxTokens = run.MaxTokens;
        _resultText = run.ResultText;
        _resultError = run.ResultError;
        _resultReasoning = null;
        _resultReasoningCharCount = 0;
        _resultParagraphCount = CountParagraphs(run.ResultText ?? string.Empty);
        _elapsedMs = run.ElapsedSeconds;
        _promptCharCount = run.PromptCharCount;
        _resultWordCount = run.ResultWordCount;
        _resultCharCount = run.ResultCharCount;
        _loadedRunId = run.Id;
        _comment = string.Empty;
        _saveSuccess = false;
        _saveError = null;
        _activeTab = "tester";

        StateHasChanged();
    }

    private async Task DeleteRun(PromptTestRun run)
    {
        try
        {
            await PromptTestRunRepo.DeleteAsync(run.Id);
            _previousRuns.RemoveAll(r => r.Id == run.Id);

            if (_loadedRunId == run.Id)
            {
                _loadedRunId = null;
            }

            StateHasChanged();
        }
        catch (Exception)
        {
            // Silent fail for delete
        }
    }

    private async Task CopyResult()
    {
        if (_resultText is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _resultText);
        }
    }

    private static int CountWords(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    /// <summary>Paragraph count for prose comparison: blocks separated by a blank line.</summary>
    private static int CountParagraphs(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries)
            .Count(block => !string.IsNullOrWhiteSpace(block));
    }

    private static string FormatTimestamp(string utc)
    {
        if (DateTime.TryParse(utc, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var dt))
        {
            return dt.ToLocalTime().ToString("g");
        }
        return utc;
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;
}
