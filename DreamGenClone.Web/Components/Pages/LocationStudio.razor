@page "/locations/{LocationId}"
@rendermode InteractiveServer

<PageTitle>Location Studio - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="card border-info mb-3">
        <div class="card-body">
            <h5 class="card-title mb-1">Views are just named images</h5>
            <p class="text-muted mb-0">
                This location is a container: every image generated, uploaded or edited here belongs to it. There is no
                fixed set of views to fill in — name each accepted image in its own card below (Front, Left side,
                Interior, or anything else the place needs), and that name is what the Location reference picker shows.
                An image must be named before it can be approved for production, because an unnamed one cannot be told
                apart from its siblings when you bind it.
            </p>
        </div>
    </div>

    <AssetStudioView AssetId="@LocationId" />
</div>

@code {
    [Parameter] public string? LocationId { get; set; }
}
