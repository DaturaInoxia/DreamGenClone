    private int GetWillingnessToCheat()
        => ComputeWillingnessDetail().Score;

    private (int Score, int Desire, int Loyalty, int SedRecept, int BoundFirm, int Att, int Intim) ComputeWillingnessDetail()
    {
        if (_v2State?.CharacterSnapshots is null)
            return (50, 50, 50, 50, 50, 50, 50);

        var wifeStats = _v2State.CharacterSnapshots.FirstOrDefault(s =>
            string.Equals(s.CharacterRole, "Wife", StringComparison.OrdinalIgnoreCase));
        var husbandStats = _v2State.CharacterSnapshots.FirstOrDefault(s =>
            string.Equals(s.CharacterRole, "Husband", StringComparison.OrdinalIgnoreCase));

        var desire = wifeStats is not null ? GetCharacterStatValue(wifeStats, "Desire") : 50;
        var loyalty = wifeStats is not null ? GetCharacterStatValue(wifeStats, "Loyalty") : 50;
        var sedRecept = wifeStats?.RuntimeEncounterStats?.TryGetValue("SeductionReceptivity", out var sr) == true ? sr : 50;
        var boundFirm = wifeStats?.RuntimeEncounterStats?.TryGetValue("BoundaryFirmness", out var bf) == true ? bf : 50;
        var att = husbandStats?.RuntimeEncounterStats?.TryGetValue("Attentiveness", out var a) == true ? a : 50;
        var intim = husbandStats?.RuntimeEncounterStats?.TryGetValue("IntimacyAvailability", out var i) == true ? i : 50;

        var score = DreamGenClone.Application.RolePlay.WifeWillingnessCalculator.ComputeWillingnessToCheat(
            desire, loyalty, sedRecept, boundFirm, att, intim,
            _scenarioEngineSettings.WillingnessDesireLoyaltyWeight,
            _scenarioEngineSettings.WillingnessBehaviorWeight,
            _scenarioEngineSettings.WillingnessMaritalDeficitWeight);

        return (score, desire, loyalty, sedRecept, boundFirm, att, intim);
    }

