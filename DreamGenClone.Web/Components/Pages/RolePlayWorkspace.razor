    private async Task RefreshActiveProfileThemesAsync()
    {
        if (_session is null)
        {
            _activeProfileThemes = [];
            _rankingProfiles = [];
            _rpThemeProfiles = [];
            _intensityProfiles = [];
            _steeringProfiles = [];
            _baseStatProfiles = [];
            _willingnessProfiles = [];
            _resistanceProfiles = [];
            _characterProfiles = [];
            _intensityProfilesById = new(StringComparer.OrdinalIgnoreCase);
            return;
        }

        _rankingProfiles = (await StoryAnalysisFacade.ListProfilesAsync())
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _rpThemeProfiles = (await RPThemeService.ListProfilesAsync())
            .Where(x => !string.Equals(x.Id, IRPThemeService.GlobalThemeLibraryProfileId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _steeringProfiles = (await StoryAnalysisFacade.ListSteeringProfilesAsync())
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _baseStatProfiles = (await StoryAnalysisFacade.ListBaseStatProfilesAsync())
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _willingnessProfiles = (await StoryAnalysisFacade.ListStatWillingnessProfilesAsync())
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _resistanceProfiles = (await StoryAnalysisFacade.ListStatResistanceProfilesAsync())
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _characterProfiles = (await StoryAnalysisFacade.GetAllCharacterProfilesAsync())
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var intensityProfiles = await StoryAnalysisFacade.ListIntensityProfilesAsync();
        var characterIntensityProfiles = intensityProfiles
            .Where(x => x.Intensity != IntensityLevel.Intro)
            .ToList();

        _intensityProfiles = characterIntensityProfiles
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _intensityProfilesById = characterIntensityProfiles.ToDictionary(x => x.Id, StringComparer.OrdinalIgnoreCase);

        if (string.IsNullOrWhiteSpace(_session.SelectedThemeProfileId))
        {
            _activeProfileThemes = [];
            return;
        }

        _activeProfileThemes = await StoryAnalysisFacade.ListThemesByProfileAsync(_session.SelectedThemeProfileId);
    }

