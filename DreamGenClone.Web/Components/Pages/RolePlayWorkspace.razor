        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to write finish debug event: SessionId={SessionId} EventKind={EventKind}", _session.Id, eventKind);
        }
    }

    private IReadOnlyList<string> BuildFallbackFinishOptions()
    {
        if (_finishUseGuidedFlow)
        {
            return
            [
                "Lock in eye contact and control the pace with one decisive, grounded finishing beat.",
                "Shift posture to close distance deliberately, then deliver a concise ending line that seals intent.",
                "Hold position, lower the tempo, and end on a clear, dominant choice that resolves the climax."
            ];
        }

        return
        [
            "Close the moment with a direct line that resolves the immediate tension and lands the scene.",
            "Take one clear final action that confirms the emotional outcome and ends the beat cleanly.",
            "Pause, acknowledge the shift between characters, and finish with a concise closing move."
