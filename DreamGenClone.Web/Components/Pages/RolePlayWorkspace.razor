    private string SessionThemeSummary
    {
        get
        {
            if (_session is null || _session.SessionThemeSelections.Count == 0) return string.Empty;
            const int maxLabels = 3;
            var labels = _session.SessionThemeSelections
                .Select(s => _sessionThemeLabels.GetValueOrDefault(s.ThemeId, string.Empty))
                .Where(l => !string.IsNullOrEmpty(l))
                .ToList();
            if (labels.Count == 0) return $"{_session.SessionThemeSelections.Count} themes";
            var shown = labels.Take(maxLabels).ToList();
            var extra = labels.Count - shown.Count;
            var summary = string.Join(", ", shown);
            return extra > 0 ? $"Themes: {summary} (+{extra} more)" : $"Themes: {summary}";
        }
    }

    // Reloads the session from the DB, applies a mutation, persists it, and refreshes _session.
    //
    // The workspace's in-memory _session can go stale relative to the DB: the engine graduates a
    // one-shot staged direction (IsStagedDirection=false) on its own session instance, and the
    // debounced graduation save may not have landed before the component reloaded after the turn.
    // Saving that stale _session blob re-persists stale per-interaction flags, which RE-ACTIVATES a
    // consumed one-shot staged direction and drags the narrative back to an already-passed beat
    // (e.g. back into the shower after it had moved on). Always persist against a fresh DB load.
    private async Task ReloadAndSaveSessionAsync(Action<RolePlaySession> mutate)
    {
        if (_session is null) return;
        var fresh = await RolePlayEngine.GetSessionAsync(_session.Id);
        if (fresh is null) return;
        mutate(fresh);
        await RolePlayEngine.SaveSessionAsync(fresh);
        _session = fresh;
    }

    private void StartTitleEdit()
    {
        if (_session is null) return;
        _editingTitleText = _session.Title;
        _editingTitle = true;
    }

    private async Task CommitTitleEditAsync()
    {
        if (!_editingTitle) return;
        _editingTitle = false;
        if (_session is null || string.IsNullOrWhiteSpace(_editingTitleText)) return;
        if (string.Equals(_editingTitleText, _session.Title, StringComparison.Ordinal)) return;
        await ReloadAndSaveSessionAsync(s => s.Title = _editingTitleText);
    }

    private async Task OnTitleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitTitleEditAsync();
        else if (e.Key == "Escape") _editingTitle = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadSessionAsync();
        await QueryTrackerOnMountAsync();

        // Handle auto-complete query parameter from create wizard
        if (autocomplete.HasValue && autocomplete.Value > 0)
        {
            var maxTurns = autocomplete.Value;
            autocomplete = null;
            _autoCompletePendingStart = true;
            _autoCompletePendingMaxTurns = maxTurns;
        }
    }

    // T018: Reconnect to any in-flight or failed background submission when the component mounts
    // or when the session parameter changes (navigation return).
    private async Task QueryTrackerOnMountAsync()
    {
        if (string.IsNullOrEmpty(sessionId)) return;

        var entry = _tracker.GetEntry(sessionId);
        if (entry is null) return;

        if (entry.Status == RolePlaySubmissionStatus.Running)
        {
            _backgroundSubmissionRunning = true;
            // Attach chunk callback so any future streaming chunks reach this component instance.
            _tracker.AttachChunkCallback(sessionId, OnRolePlayResponseChunkAsync);
            // B-087: re-attach per-interaction completion so subsequent actors' committed
            // interactions stream into the re-mounted component. Already-completed actors
            // (flushed to DB) are visible via LoadSessionAsync below.
            _tracker.AttachInteractionCompletedCallback(sessionId, OnRolePlayInteractionCompletedAsync);
            _tracker.OnJobStatusChanged += OnTrackerStatusChanged;
            _ = StartSubmissionPollingAsync();
            // Refresh the session so any per-actor-flushed interactions (committed while
            // navigated away) appear immediately on return.
            await LoadSessionAsync();
            Logger.LogInformation(
                "Reconnected to in-flight background submission on mount: session={SessionId}",
                sessionId);
        }
        else if (entry.Status == RolePlaySubmissionStatus.Failed)
        {
            _statusMessage = entry.FailureMessage ?? "Previous action failed.";
            _tracker.AcknowledgeFailure(sessionId);
        }

        await Task.CompletedTask;
    }

    // T020: PeriodicTimer fallback — handles the case where OnJobStatusChanged fired before
    // this component instance was mounted (e.g. completed while navigated away).
    private async Task StartSubmissionPollingAsync()
    {
        _submissionPollTimer?.Dispose();
        _submissionPollTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await _submissionPollTimer.WaitForNextTickAsync())
            {
                if (_tracker.GetEntry(sessionId)?.Status != RolePlaySubmissionStatus.Running)
                {
                    OnTrackerStatusChanged(sessionId);
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_resizeInitialized)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "rolePlayWorkspace.initPanelResize",
                ".rw-shell",
                ".rw-panel-resize-handle",
                _workspaceSettings.SettingsPanelWidth,
                WorkspaceSettingsState.MinPanelWidth,
                WorkspaceSettingsState.MaxPanelWidth,
                _dotNetRef);

            _resizeInitialized = true;
        }

        var interactionCount = _session?.Interactions.Count ?? 0;
        if (interactionCount != _lastRenderedInteractionCount)
        {
            // Only scroll to bottom on the very first render after session load.
            if (_lastRenderedInteractionCount == -1)
            {
                await JS.InvokeVoidAsync("rolePlayWorkspace.scrollStoryToBottom");
            }

            _lastRenderedInteractionCount = interactionCount;

            if (_dotNetRef is not null && _session is not null)
            {
                var displayCount = GetDisplayInteractions().Count;
                try
                {
                    await JS.InvokeVoidAsync("rolePlayWorkspace.initReadCursorObserver", _dotNetRef, displayCount, _readCursorInteractionIndex);
                }
                catch (JSException ex)
                {
                    Logger.LogWarning(ex, "initReadCursorObserver JS call failed → browser may have stale JS cache. Hard-refresh the page to resolve.");
                }
            }
        }
    }

    private async Task LoadSessionAsync()
    {
        if (_roleDefinitions.Count == 0)
        {
            _roleDefinitions = await StoryAnalysisFacade.ListRoleDefinitionsAsync();
        }

        if (_characterLikeTemplates.Count == 0)
        {
            _characterLikeTemplates = (await TemplateService.GetAllAsync())
                .Where(x => x.TemplateType == TemplateType.Character)
                .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        _session = await RolePlayEngine.GetSessionAsync(sessionId);
        if (_session is null)
        {
            _statusMessage = "Session not found.";
            Navigation.NavigateTo(RolePlayRoutes.Sessions);
            return;
        }

        await HydrateV2AdaptiveStateAsync();

        if (_climaxBeatsByCode.Count == 0)
        {
            var allBeats = await ClimaxBeatRepository.GetAllAsync();
            _climaxBeatsByCode = allBeats.ToDictionary(x => x.BeatCode, StringComparer.OrdinalIgnoreCase);
        }

        await LoadSemanticInteractionAnalysisStateAsync(_session.Id);
        await LoadImageCountsAsync();

        // Note: do NOT reset _readCursorInteractionIndex / _lastRenderedInteractionCount here.
        // LoadSessionAsync is invoked after Send/Continue and many other in-session actions to
        // refresh data. Resetting those sentinels would re-trigger the "first render after load"
        // scroll-to-bottom on every action, defeating B-010 (Read Position Indicator). The field
        // initializers (-1) already give the correct behavior on the genuine initial load.

        _defaultNarrativeGateProfile = await StoryAnalysisFacade.GetDefaultNarrativeGateProfileAsync();
        _selectedNarrativeGateProfile = string.IsNullOrWhiteSpace(_v2State?.SelectedNarrativeGateProfileId)
            ? null
            : await StoryAnalysisFacade.GetNarrativeGateProfileAsync(_v2State!.SelectedNarrativeGateProfileId!);
        _scenarioEngineSettings = await StoryAnalysisFacade.LoadScenarioEngineSettingsAsync();

        var sessionUpdated = false;

        if (_session.AssistantMaxTokens < 2000)
        {
            _session.AssistantMaxTokens = 2000;
            sessionUpdated = true;
        }

        EnsureAssistantChatsInitialized(_session);
        _assistantChats = _session.AssistantChats
            .OrderByDescending(c => c.ModifiedAt)
            .ToList();
        _activeAssistantChatId = _session.ActiveAssistantChatId;

        if (sessionUpdated)
        {
            await RolePlayEngine.SaveSessionAsync(_session);
        }

        _selectedBehaviorMode = _session.BehaviorMode;

        // Sync persisted model settings into the in-memory service
        var persistedSettings = new ModelSettings
        {
            SessionModelId = _session.SessionModelId,
            Temperature = _session.SessionTemperature,
            TopP = _session.SessionTopP,
            MaxTokens = _session.SessionMaxTokens,
            ContextWindowSize = _session.ContextWindowSize
        };
        ModelSettingsService.UpdateSettings(_session.Id, persistedSettings);

        _identityOptions = (await IdentityOptionsService.GetIdentityOptionsAsync(_session)).ToList();

        // Load scenario for assistant context
        if (!string.IsNullOrWhiteSpace(_session.ScenarioId) && _loadedScenario?.Id != _session.ScenarioId)
        {
            _loadedScenario = await ScenarioService.GetScenarioAsync(_session.ScenarioId);
        }

        // Build theme label map for header display
        if (_session.SessionThemeSelections.Count > 0 && _sessionThemeLabels.Count == 0)
        {
            var allThemes = await RPThemeService.ListThemesAsync();
            var sessionThemeIds = _session.SessionThemeSelections.Select(s => s.ThemeId).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _sessionThemeLabels = allThemes
                .Where(t => sessionThemeIds.Contains(t.Id))
                .ToDictionary(t => t.Id, t => t.Label, StringComparer.OrdinalIgnoreCase);
        }

        // Backfill adaptive profile/style fields for sessions that were created before defaults were copied.
        if (_loadedScenario is not null)
        {
            var originalPersonaRelationTargetId = CharacterRelationCatalog.NormalizeTargetId(_session.PersonaRelationTargetId);
            SyncPersonaRelationFromScenarioCharacters();
            if (!string.Equals(originalPersonaRelationTargetId, CharacterRelationCatalog.NormalizeTargetId(_session.PersonaRelationTargetId), StringComparison.OrdinalIgnoreCase))
            {
                sessionUpdated = true;
            }

            // Only back-fill SelectedRPThemeProfileId from the scenario when the session has no
            // per-session theme selections. When SessionThemeSelections is non-empty, null is the
            // correct value → back-filling would cause BuildScenarioCandidatesAsync to pull from the
            // profile and let themes outside the selection become active.
            if (_session.SessionThemeSelections.Count == 0 && string.IsNullOrWhiteSpace(_session.SelectedRPThemeProfileId))
            {
                if (!string.IsNullOrWhiteSpace(_loadedScenario.DefaultRPThemeProfileId))
                {
                    _session.SelectedRPThemeProfileId = _loadedScenario.DefaultRPThemeProfileId;
                    sessionUpdated = true;
                }
                else if (!string.IsNullOrWhiteSpace(_loadedScenario.DefaultThemeProfileId))
                {
                    // Legacy migration fallback for scenarios not yet updated.
                    _session.SelectedRPThemeProfileId = _loadedScenario.DefaultThemeProfileId;
                    sessionUpdated = true;
                }
            }

            if (string.IsNullOrWhiteSpace(_session.SelectedThemeProfileId) && !string.IsNullOrWhiteSpace(_loadedScenario.DefaultThemeProfileId))
            {
                _session.SelectedThemeProfileId = _loadedScenario.DefaultThemeProfileId;
                sessionUpdated = true;
            }

            if (string.IsNullOrWhiteSpace(_session.SelectedIntensityProfileId) && !string.IsNullOrWhiteSpace(_loadedScenario.DefaultIntensityProfileId))
            {
                _session.SelectedIntensityProfileId = _loadedScenario.DefaultIntensityProfileId;
                sessionUpdated = true;
            }

            // Clear a stale SelectedIntensityProfileId that points to a non-selectable profile
            // (e.g. Atmospheric/Intro, which is excluded from the dropdown). This can happen when
            // old code wrote the resolved intensity — which could be Intro — back into the field.
            if (!string.IsNullOrWhiteSpace(_session.SelectedIntensityProfileId)
                && _intensityProfilesById.Count > 0
                && !_intensityProfilesById.ContainsKey(_session.SelectedIntensityProfileId))
            {
                _session.SelectedIntensityProfileId = null;
                sessionUpdated = true;
            }

            if (string.IsNullOrWhiteSpace(_session.SelectedSteeringProfileId) && !string.IsNullOrWhiteSpace(_loadedScenario.DefaultSteeringProfileId))
            {
                _session.SelectedSteeringProfileId = _loadedScenario.DefaultSteeringProfileId;
                sessionUpdated = true;
            }

            if (string.IsNullOrWhiteSpace(_session.IntensityFloorOverride) && !string.IsNullOrWhiteSpace(_loadedScenario.DefaultIntensityFloor))
            {
                _session.IntensityFloorOverride = _loadedScenario.DefaultIntensityFloor;
                sessionUpdated = true;
            }

            if (string.IsNullOrWhiteSpace(_session.IntensityCeilingOverride) && !string.IsNullOrWhiteSpace(_loadedScenario.DefaultIntensityCeiling))
            {
                _session.IntensityCeilingOverride = _loadedScenario.DefaultIntensityCeiling;
                sessionUpdated = true;
            }

            if (!Enum.IsDefined(_session.PersonaPerspectiveMode))
            {
                _session.PersonaPerspectiveMode = Enum.IsDefined(_loadedScenario.DefaultPersonaPerspectiveMode)
                    ? _loadedScenario.DefaultPersonaPerspectiveMode
                    : CharacterPerspectiveMode.FirstPersonInternalMonologue;
                sessionUpdated = true;
            }

            if (EnsureCharacterPerspectiveEntries(_session, _loadedScenario))
            {
                sessionUpdated = true;
            }
        }
        else if (!Enum.IsDefined(_session.PersonaPerspectiveMode))
        {
            _session.PersonaPerspectiveMode = CharacterPerspectiveMode.FirstPersonInternalMonologue;
            sessionUpdated = true;
        }

        // Theme primary/secondary selection is owned by RolePlayAdaptiveStateService.RecalculateSelectedThemes.
        // The page must not seed PrimaryThemeId/SecondaryThemeId on load → doing so bypasses the
        // SelectionMinimumTurns/Observing gate and creates a duplicate decision path.

        var originalFloor = _session.IntensityFloorOverride;
        var originalCeiling = _session.IntensityCeilingOverride;
        NormalizeStyleBounds(_session, preferFloor: true);
        if (!string.Equals(originalFloor, _session.IntensityFloorOverride, StringComparison.Ordinal)
            || !string.Equals(originalCeiling, _session.IntensityCeilingOverride, StringComparison.Ordinal))
        {
            sessionUpdated = true;
        }

        // Load assistant model selection
        _assistantSelectedModelId = _session.AssistantModelId ?? string.Empty;
        var enabledModels = await RegisteredModelRepository.GetAllEnabledAsync();
        _assistantGroupedModels = enabledModels
            .GroupBy(m => m.ProviderName ?? "Unknown")
            .ToDictionary(g => g.Key, g => g.ToList());

        var selectedIdentityId = _selectedIdentity?.Id;
        if (!string.IsNullOrWhiteSpace(selectedIdentityId))
        {
            _selectedIdentity = _identityOptions.FirstOrDefault(x =>
                string.Equals(x.Id, selectedIdentityId, StringComparison.OrdinalIgnoreCase));
        }

        var continueIds = _identityOptions
            .Where(x => x.IsAvailable)
            .Select(x => x.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _continueSelectedIdentityIds.RemoveWhere(id => !continueIds.Contains(id));

        if (_selectedIdentity is null)
        {
            _selectedIdentity = _identityOptions.FirstOrDefault(x => x.IsAvailable)
                ?? _identityOptions.FirstOrDefault();
        }

        _showCustomInput = _selectedIdentity?.SourceType == IdentityOptionSource.CustomCharacter;

        await RefreshActiveProfileThemesAsync();
        _adaptiveThemeOverrideSelection = _v2State?.ActiveScenarioId
            ?? _v2State?.PrimaryThemeId;
        _adaptiveThemeOverrideStatus = string.Empty;

        if (sessionUpdated)
        {
            await RolePlayEngine.SaveSessionAsync(_session);
        }

        _v2Diagnostics = await RolePlayDiagnostics.GetSnapshotAsync(_session.Id);
        _activeRpTheme = await LoadActiveRpThemeAsync();
        await ResolveBuildUpGateRuleCacheAsync();
        _pendingDecisionPrompt = DecisionOptions.Value.EnableDecisionPrompts
            ? await RolePlayEngine.GetPendingDecisionPromptAsync(_session.Id)
            : null;
        _deferredDecisionPrompts = DecisionOptions.Value.EnableDecisionPrompts
            ? (await RolePlayEngine.GetDeferredDecisionPromptsAsync(_session.Id)).ToList()
            : [];
        if (_pendingDecisionPrompt is null)
        {
            _dismissedDecisionPointId = null;
        }
        else if (!string.Equals(_dismissedDecisionPointId, _pendingDecisionPrompt.DecisionPoint.DecisionPointId, StringComparison.OrdinalIgnoreCase))
        {
            _dismissedDecisionPointId = null;
        }

        _decisionPromptError = string.Empty;
