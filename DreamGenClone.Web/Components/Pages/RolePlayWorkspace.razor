    private string GetEffectiveStyleReasonEnglishDetails()
    {
        if (_session is null)
        {
            return "(session unavailable)";
        }

        var (_, reason) = ResolveEffectiveStyle(_session);
        if (string.IsNullOrWhiteSpace(reason))
        {
            return "The system had no additional resolution inputs, so it kept the current intensity configuration.";
        }

        var parts = reason
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

        string? selectedRaw = null;
        string? adaptiveRaw = null;
        string? progressionRaw = null;

        foreach (var part in parts)
        {
            if (part.StartsWith("selected=", StringComparison.OrdinalIgnoreCase))
            {
                selectedRaw = part["selected=".Length..];
                continue;
            }

            if (part.StartsWith("adaptive=", StringComparison.OrdinalIgnoreCase))
            {
                adaptiveRaw = part["adaptive=".Length..];
                continue;
            }

            if (part.StartsWith("progression=", StringComparison.OrdinalIgnoreCase))
            {
                progressionRaw = part["progression=".Length..];
            }
        }

        var selectedProfileName = GetSelectedIntensityProfileName();
        var adaptiveProfileName = GetAdaptiveIntensityProfileName();
        var selectedText = selectedProfileName == "(none)"
            ? (string.IsNullOrWhiteSpace(selectedRaw) ? "the selected baseline" : selectedRaw)
            : selectedProfileName;
        var adaptiveText = adaptiveProfileName == "(none)"
            ? (string.IsNullOrWhiteSpace(adaptiveRaw) ? "the adaptive recommendation" : adaptiveRaw)
            : adaptiveProfileName;

        var progressionText = progressionRaw switch
        {
            "early(-1)" => "an early-scene pacing adjustment that de-escalates intensity by one step",
            "late(+1)" => "a late-scene pacing adjustment that escalates intensity by one step",
            null or "" => "no explicit progression adjustment",
            _ => $"a progression adjustment ({progressionRaw})"
        };

        return $"The system is balancing your chosen profile, adaptive scene state, and pacing safety. It started from {selectedText}, compared that with adaptive guidance of {adaptiveText}, then applied {progressionText}. This helps prevent scenes from escalating too quickly when the session is still early.";
    }

