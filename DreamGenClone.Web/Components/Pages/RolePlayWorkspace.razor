    private async Task GenerateNextPhaseOptionsAsync()
    {
        if (_session is null || !IsNextPhaseEligible)
        {
            Logger.LogInformation(
                "Next Phase option generation skipped. SessionMissing={SessionMissing} Eligible={Eligible}",
                _session is null,
                IsNextPhaseEligible);
            return;
        }

        _nextPhaseOptionsLoading = true;
        _nextPhaseOptionError = string.Empty;
        try
        {
            var context = BuildAssistantContext();
            var currentPhase = _v2State?.CurrentPhase ?? DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp;
            var targetLabel = (_v2State?.CurrentPhase) switch
            {
                DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp => "Committed",
                DreamGenClone.Domain.RolePlay.NarrativePhase.Committed => "Approaching",
                DreamGenClone.Domain.RolePlay.NarrativePhase.Approaching => "Climax",
                DreamGenClone.Domain.RolePlay.NarrativePhase.Climax => "Reset",
                _ => "Next"
            };

            Logger.LogInformation(
                "Generating Next Phase options: SessionId={SessionId} CurrentPhase={CurrentPhase} TargetLabel={TargetLabel}",
                _session.Id,
                currentPhase,
                targetLabel);

            var prompt = await BuildNextPhaseOptionsPromptAsync(targetLabel);

            var response = await RolePlayAssistant.GenerateSuggestionAsync(
                context,
                prompt,
                assistantModelId: string.IsNullOrWhiteSpace(_session.SessionModelId) ? null : _session.SessionModelId,
                assistantTemperature: _session.SessionTemperature,
                assistantTopP: _session.SessionTopP,
                assistantMaxTokens: _session.SessionMaxTokens,
                appFunction: AppFunction.RolePlaySteering);

            _nextPhaseOptions = ParseFinishOptions(response).ToList();
            if (_nextPhaseOptions.Count == 0)
            {
                Logger.LogWarning(
                    "Next Phase option generation returned no options: SessionId={SessionId} CurrentPhase={CurrentPhase} TargetLabel={TargetLabel}",
                    _session.Id,
                    currentPhase,
                    targetLabel);
                _nextPhaseOptionError = "Could not generate phase options. Try again.";
                return;
            }

            Logger.LogInformation(
                "Generated Next Phase options: SessionId={SessionId} CurrentPhase={CurrentPhase} OptionCount={OptionCount}",
                _session.Id,
                currentPhase,
                _nextPhaseOptions.Count);

            _selectedNextPhaseOption = _nextPhaseOptions[0];
        }
        catch (Exception ex)
        {
            _nextPhaseOptionError = ex.Message;
            Logger.LogError(ex, "Failed generating next-phase options for session {SessionId}", _session.Id);
        }
        finally
        {
            _nextPhaseOptionsLoading = false;
        }
    }

    private async Task ApplyNextPhaseOptionAsync()
    {
        if (_session is null)
        {
            Logger.LogWarning("Apply Next Phase ignored because session is null.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedNextPhaseOption))
        {
            Logger.LogWarning("Apply Next Phase ignored due empty selected option: SessionId={SessionId}", _session.Id);
            return;
        }

        if (!IsNextPhaseEligible)
        {
            Logger.LogWarning(
                "Apply Next Phase ignored: ineligible phase. SessionId={SessionId} CurrentPhase={CurrentPhase}",
                _session.Id,
                _v2State?.CurrentPhase);
            return;
        }

        if (IsNextPhaseUiLocked)
        {
            Logger.LogInformation(
                "Apply Next Phase ignored: UI locked. SessionId={SessionId} IsSubmitting={IsSubmitting} OptionsLoading={OptionsLoading} OptionSubmitting={OptionSubmitting}",
                _session.Id,
                _isSubmitting,
                _nextPhaseOptionsLoading,
                _nextPhaseOptionSubmitting);
            return;
        }

        var currentPhase = _v2State?.CurrentPhase ?? DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp;
        var selectedDirective = _selectedNextPhaseOption.Trim();
        var commandPrefix = currentPhase == DreamGenClone.Domain.RolePlay.NarrativePhase.Climax
            ? "/endclimax"
            : "/nextphase";
        var commandText = string.IsNullOrWhiteSpace(selectedDirective)
            ? commandPrefix
            : $"{commandPrefix} {selectedDirective}";

        Logger.LogInformation(
            "Applying Next Phase option: SessionId={SessionId} CurrentPhase={CurrentPhase} Command={Command}",
            _session.Id,
            currentPhase,
            commandText);

        // Load the command text into the prompt input so the user can review, edit,
        // and submit it manually with Continue rather than executing immediately.
        _nextPhasePopupOpen = false;
        _nextPhaseOptionError = string.Empty;
        _selectedIntent = PromptIntent.Instruction;
        _promptText = commandText;
        _nextPhaseOptions.Clear();
        _selectedNextPhaseOption = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenSteerPopupAsync()
    {
        if (_session is null || !IsSteerEligible || IsSteerUiLocked)
        {
            return;
        }

        _steerPopupOpen = true;
        _continueCustomPopupOpen = false;
        _continuationSettingsPopupOpen = false;
        _intentPopupOpen = false;
        _identityPopupOpen = false;
        _finishPopupOpen = false;
        _nextPhasePopupOpen = false;
        _steerOptionError = string.Empty;
        _steerPageIndex = _steerOptionPages.Count > 0 ? _steerOptionPages.Count - 1 : 0;
        _steerGenerationIndex = _steerOptionPages.Count;

        // B-075: Initialize target character to first available if not set.
        if (string.IsNullOrWhiteSpace(_steerTargetCharacterId) && SteerableTargets.Count > 0)
        {
            _steerTargetCharacterId = SteerableTargets[0].CharacterId;
            _steerTargetCharacterLabel = SteerableTargets[0].CharacterName;
        }

        // Auto-steer: always check for fresh pre-generated options on open.
        // During active turn generation, clear everything — no stale choices allowed.
        if (_isAwaitingModelResponse || _isSubmitting)
        {
            _steerOptionPages.Clear();
            _selectedSteerOption = string.Empty;
            _steerPageIndex = 0;
            _cachedSteerResponse = null;
            _cachedSteerGenerationId = null;
        }
        else if (!_steerUseGuidedFlow)
        {
            try
            {
                var cached = await Persistence.GetLatestSteeringGenerationRecordAsync(_session.Id);
                var latestInteraction = _session.Interactions.LastOrDefault();
                var isStale = latestInteraction is not null && cached is not null
                    && cached.CreatedUtc.ToUniversalTime() < latestInteraction.CreatedAt.ToUniversalTime();

                // If no fresh cache, clear any stale pages so user can't select old options.
                if (cached is null || isStale || string.IsNullOrWhiteSpace(cached.ParsedOptionsJson))
                {
                    if (_steerOptionPages.Count > 0)
                    {
                        _steerOptionPages.Clear();
                        _selectedSteerOption = string.Empty;
                        _steerPageIndex = 0;
                        _cachedSteerResponse = null;
                        _cachedSteerGenerationId = null;
                    }
                }
                else
                {
                    var parsed = SteerGenerationParser.TryParse(cached.GenerationResponse);
                    if (parsed is not null && parsed.Characters.Count > 0)
                    {
                        _cachedSteerResponse = parsed;
                        _cachedSteerGenerationId = cached.Id;
                        RefreshLocalSteerPages();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load cached steer options for session {SessionId}", _session.Id);
            }
        }
    }

