            && (string.Equals(profile.CharacterRole, "Wife", StringComparison.OrdinalIgnoreCase)
                || string.Equals(profile.CharacterRole, "Husband", StringComparison.OrdinalIgnoreCase)))
        {
            var dimensions = BehavioralDimensionCatalog.GetDimensions(profile.CharacterRole);
