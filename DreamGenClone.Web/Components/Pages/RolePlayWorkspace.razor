    private void ApplyScenarioCharacterProfile(Character character)
    {
        var selectedProfileId = GetScenarioCharacterProfileSelection(character);
        if (string.IsNullOrWhiteSpace(selectedProfileId))
        {
            return;
        }

        var profile = _baseStatProfiles.FirstOrDefault(x =>
            string.Equals(x.Id, selectedProfileId, StringComparison.OrdinalIgnoreCase)
            && CharacterGenderCatalog.IsProfileApplicableToCharacter(x.TargetGender, character.Gender)
            && CharacterRoleCatalog.IsProfileApplicableToCharacter(x.TargetRole, character.Role));
        if (profile is null)
        {
            return;
        }

        character.BaseStats = AdaptiveStatCatalog.NormalizeComplete(profile.DefaultStats);
        character.Gender = CharacterGenderCatalog.NormalizeForCharacter(profile.TargetGender);
        character.Role = CharacterRoleCatalog.Normalize(profile.TargetRole);

        // Also apply to live session stats so changes show immediately
        if (!string.IsNullOrWhiteSpace(character.Name) && _session is not null)
        {
            var actorKey = character.Name.Trim();
            if (!_session.AdaptiveState.CharacterStats.TryGetValue(actorKey, out var liveBlock))
            {
                liveBlock = CharacterStatProfileV2Accessor.CreateDefault(actorKey);
                _session.AdaptiveState.CharacterStats[actorKey] = liveBlock;
            }
            foreach (var (statName, value) in character.BaseStats)
                CharacterStatProfileV2Accessor.SetStat(liveBlock, statName, value);
            // Per user requirement: Apply resets the baseline too — the new profile becomes
            // the reference point for Base column display and Reset-phase decay target.
            liveBlock.BaselineStats = new Dictionary<string, int>(character.BaseStats, StringComparer.OrdinalIgnoreCase);

            // Re-seed RuntimeEncounterStats from the encounter profile that was seeded at session creation.
            if (_session.AdaptiveState.CharacterEncounterProfileIds.TryGetValue(character.Id, out var applyEncProfileId)
                && !string.IsNullOrWhiteSpace(applyEncProfileId))
            {
                var encProfile = _characterProfiles.FirstOrDefault(p =>
                    string.Equals(p.Id, applyEncProfileId, StringComparison.OrdinalIgnoreCase));
                if (encProfile?.EncounterStats is { Count: > 0 })
                {
                    var applyRole = CharacterRoleCatalog.Normalize(character.Role);
                    var dims = BehavioralDimensionCatalog.GetDimensions(applyRole);
                    if (dims.Count > 0)
                    {
                        liveBlock.RuntimeEncounterStats = dims.ToDictionary(
                            d => d.Name,
                            d => encProfile.EncounterStats.TryGetValue(d.Name, out var v) ? v : 50,
                            StringComparer.OrdinalIgnoreCase);
                    }
                }
            }

            liveBlock.UpdatedUtc = DateTime.UtcNow;
        }

        MarkSessionStatsDirty();
    }

