        return _session.AdaptiveIntensityTransitions
            .OrderByDescending(x => x.OccurredUtc)
            .Take(5)
            .Select(x => $"{FormatProfileIdWithName(x.FromProfileId)} -> {FormatProfileIdWithName(x.ToProfileId)} ({FormatAdaptiveTransitionReason(x.ReasonCode)})")
            .ToList();
    }

    private string FormatProfileIdWithName(string? profileId)
    {
        if (string.IsNullOrWhiteSpace(profileId))
        {
            return "(none)";
        }

        if (_intensityProfilesById.TryGetValue(profileId, out var profile)
            && !string.IsNullOrWhiteSpace(profile.Name))
        {
            return $"{profile.Name} ({profileId})";
        }

        return profileId;
    }

    private string FormatStyleResolutionReason(string? reason)
    {
        if (string.IsNullOrWhiteSpace(reason))
        {
            return "(none)";
        }

        var translated = reason
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Select(TranslateStyleResolutionPart)
            .ToList();

        if (translated.Count == 0)
        {
            return reason;
        }

        return string.Join(" | ", translated);
    }

    private string TranslateStyleResolutionPart(string part)
    {
        if (part.StartsWith("selected=", StringComparison.OrdinalIgnoreCase))
        {
            var selectedProfileName = GetSelectedIntensityProfileName();
            var legacyValue = part["selected=".Length..];
            return selectedProfileName == "(none)"
                ? $"Selected baseline profile: {legacyValue}"
                : $"Selected baseline profile: {selectedProfileName}";
        }

        if (part.StartsWith("adaptive=", StringComparison.OrdinalIgnoreCase))
        {
            var adaptiveProfileName = GetAdaptiveIntensityProfileName();
            var legacyValue = part["adaptive=".Length..];
            return adaptiveProfileName == "(none)"
                ? $"Adaptive baseline profile: {legacyValue}"
                : $"Adaptive baseline profile: {adaptiveProfileName}";
        }

        if (part.StartsWith("progression=", StringComparison.OrdinalIgnoreCase))
        {
            return $"Progression adjustment: {part["progression=".Length..]}";
        }

        if (part.StartsWith("desire=", StringComparison.OrdinalIgnoreCase))
        {
            return $"Desire signal: {part["desire=".Length..]}";
        }

        if (part.StartsWith("theme=", StringComparison.OrdinalIgnoreCase))
        {
            return $"Theme influence: {part["theme=".Length..]}";
        }

        if (part.Equals("dealbreaker-suppressed", StringComparison.OrdinalIgnoreCase))
        {
            return "Escalation suppressed by deal breaker";
        }

        if (part.StartsWith("musthave-push", StringComparison.OrdinalIgnoreCase))
        {
            return "Must-have preference increased intensity";
        }

        if (part.StartsWith("manual-pin=", StringComparison.OrdinalIgnoreCase))
        {
            return "Manual pin override applied";
        }

        if (part.StartsWith("floor=", StringComparison.OrdinalIgnoreCase))
        {
            return $"Applied floor bound: {part["floor=".Length..]}";
        }

        if (part.StartsWith("ceiling=", StringComparison.OrdinalIgnoreCase))
        {
            return $"Applied ceiling bound: {part["ceiling=".Length..]}";
        }

        if (part.StartsWith("bounds=", StringComparison.OrdinalIgnoreCase))
        {
            return "Normalized invalid floor/ceiling bounds";
        }

        return part;
    }

    private static string FormatAdaptiveTransitionReason(string? reason)
    {
        if (string.IsNullOrWhiteSpace(reason))
        {
            return "(none)";
        }

        var parts = reason.Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return reason;
        }

        var summary = parts[0] switch
        {
            "desire-high-restraint-low-escalate" => "Escalated because desire is high and restraint is low",
            "desire-low-or-restraint-high-deescalate" => "De-escalated because desire is low or restraint is high",
            "tension-and-restraint-high-deescalate" => "De-escalated because tension and restraint are both high",
            "early-phase-no-escalation" => "Escalation prevented in early phase",
            "late-phase-gentle-escalation" => "Late-phase gentle escalation applied",
            "manual-pin-suppressed" => "Adaptive transition suppressed due to manual pin",
            "no-intensity-profiles" => "No intensity profiles available",
            "adaptive-profile-not-found" => "Current adaptive profile not found",
            "stable" => "No transition needed; profile remains stable",
            _ => parts[0]
        };

        var detailParts = parts.Skip(1)
            .Select(part => part switch
            {
                var p when p.StartsWith("phase=", StringComparison.OrdinalIgnoreCase) => $"Phase: {p["phase=".Length..]}",
                var p when p.StartsWith("phase-delta=", StringComparison.OrdinalIgnoreCase) => $"Phase adjustment: {p["phase-delta=".Length..]}",
                var p when p.StartsWith("stat-delta=", StringComparison.OrdinalIgnoreCase) => $"Stat adjustment: {p["stat-delta=".Length..]}",
                var p when p.EndsWith("-blocked-by-floor", StringComparison.OrdinalIgnoreCase) => "Floor bound blocked de-escalation",
                var p when p.EndsWith("-blocked-by-ceiling", StringComparison.OrdinalIgnoreCase) => "Ceiling bound blocked escalation",
                var p when p.EndsWith("-target-profile-missing", StringComparison.OrdinalIgnoreCase) => "Target profile for transition was missing",
                _ => part
            })
            .ToList();

        if (detailParts.Count == 0)
        {
            return summary;
        }

        return $"{summary} | {string.Join("; ", detailParts)}";
    }

    private IReadOnlyList<PhaseGateRow> GetPhaseGateRows()
    {
        if (_session is null)
        {
            return [];
        }

        var state = _session.AdaptiveState;
        var desire = GetAverageAdaptiveStat(state, "Desire");
        var restraint = GetAverageAdaptiveStat(state, "Restraint");
        var dominance = GetAverageAdaptiveStat(state, "Dominance");
        var loyalty = GetAverageAdaptiveStat(state, "Loyalty");
        var selfRespect = GetAverageAdaptiveStat(state, "SelfRespect");
        var activeScenarioScore = GetLifecycleActiveScenarioScore(state, out var activeScenarioScoreSource);
        var willingnessTier = ResolveWillingnessTier(desire, _scenarioEngineSettings);
        var stageALowDesireMin = _scenarioEngineSettings.StageALowDesireMin;
        var stageAOpen = !string.Equals(willingnessTier, "Blocked", StringComparison.OrdinalIgnoreCase);
        var stageEligible = stageAOpen;

        var rows = new List<PhaseGateRow>();
        rows.Add(new PhaseGateRow(
            "Session Stats Snapshot",
            "Live",
            $"Desire={desire:0.0}, Restraint={restraint:0.0}, Dominance={dominance:0.0}, Loyalty={loyalty:0.0}, SelfRespect={selfRespect:0.0}, ActiveScenarioScore={activeScenarioScore:0.0} ({activeScenarioScoreSource}), CompletedScenarios={state.CompletedScenarios}."));

        var desireGapToStageA = Math.Max(0, stageALowDesireMin - desire);
        rows.Add(new PhaseGateRow(
            "Selection Gate A: Willingness Tier",
            stageAOpen ? "Open" : "Closed",
            $"{(stageAOpen ? "✓" : "✗")} Desire = {desire:0.0} (requires = {stageALowDesireMin:0.##}){(!stageAOpen ? $" → need +{desireGapToStageA:0.0} to pass" : " → pass")}.\n{(stageAOpen ? "✓" : "✗")} Willingness tier = {willingnessTier}{(!stageAOpen ? " → must not be Blocked" : " → pass (not Blocked)")}."  ));

        if (state.CurrentPhase == NarrativePhase.BuildUp)
        {
            var topEligibleCandidate = _v2Diagnostics?.CandidateEvaluations
                .Where(x => x.StageBEligible)
                .OrderByDescending(x => x.FitScore)
                .ThenByDescending(x => x.Confidence)
                .FirstOrDefault();
            var topCandidate = topEligibleCandidate
                ?? _v2Diagnostics?.CandidateEvaluations
                    .OrderByDescending(x => x.FitScore)
                    .ThenByDescending(x => x.Confidence)
                    .FirstOrDefault();
            var fitScore = topEligibleCandidate?.FitScore ?? topCandidate?.FitScore;
            var interactionCount = _v2State?.TurnCountInPhase ?? state.TurnCountInPhase;
            var averageDesire = GetAverageAdaptiveStat(state, "Desire");
            var averageRestraint = GetAverageAdaptiveStat(state, "Restraint");
            var averageDominance = GetAverageAdaptiveStat(state, "Dominance");
            var averageLoyalty = GetAverageAdaptiveStat(state, "Loyalty");
            var averageSelfRespect = GetAverageAdaptiveStat(state, "SelfRespect");
            var metricValues = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase)
            {
                [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore] = fitScore ?? 0m,
                [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment] = interactionCount,
                [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDesire] = (decimal)averageDesire,
                [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageRestraint] = (decimal)averageRestraint,
                [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDominance] = (decimal)averageDominance,
                [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageLoyalty] = (decimal)averageLoyalty,
                [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageSelfRespect] = (decimal)averageSelfRespect
            };

            // Read thresholds from the resolved configured source (selected profile or theme-local rules).
            var buildUpRules = _resolvedBuildUpCommittedRules.ToList();

            if (buildUpRules.Count == 0)
            {
                rows.Add(new PhaseGateRow(
                    "BuildUp Commit Gate",
                    "Error",
                    _resolvedBuildUpCommittedRuleError
                        ?? "No BuildUp -> Committed rules configured from selected profile or theme-local configuration."));
            }
            else
            {
                if (topEligibleCandidate is null)
                {
                    // Gate A may be open in live stats while stale diagnostics show no eligible candidate.
                    var eligibilityHeader = stageEligible
                        ? $"● No eligible candidate in last engine run (diagnostics stale → re-evaluates next cycle). Top candidate: {topCandidate?.ScenarioId ?? "(none)"} fit={fitScore?.ToString("0.00") ?? "n/a"}."
                        : topCandidate is null
                            ? "No candidate evaluations yet. Engine has not run or no scenarios match the active theme."
                            : $"✗ Top candidate '{topCandidate.ScenarioId}' did not pass the fit gate (fit={fitScore?.ToString("0.00") ?? "n/a"}). Gate A must be open first.";

                    var ruleLines = new List<string> { eligibilityHeader, $"Commit rules ({_resolvedBuildUpCommittedRuleSource}):" };
                    foreach (var rule in buildUpRules)
                    {
                        if (!metricValues.TryGetValue(rule.MetricKey, out var val))
                        {
                            ruleLines.Add($"⚠ {rule.MetricKey}: value unavailable");
                            continue;
                        }
                        if (!TryCompareRuleMetric(val, rule.Comparator, rule.Threshold, out var rulePass))
                        {
                            ruleLines.Add($"⚠ {rule.MetricKey}: invalid comparator '{rule.Comparator}'");
                            continue;
                        }
                        ruleLines.Add(rulePass
                            ? $"✓ {rule.MetricKey} = {val:0.##} (requires {rule.Comparator} {rule.Threshold:0.##}) → pass"
                            : $"✗ {rule.MetricKey} = {val:0.##} (requires {rule.Comparator} {rule.Threshold:0.##}) → {ComputeRuleGapDescription(val, rule.Comparator, rule.Threshold)}");
                    }
                    rows.Add(new PhaseGateRow(
                        "BuildUp Commit Gate",
                        "Closed",
                        string.Join("\n", ruleLines)));
                }
                else
                {
                    var fitDisplay = fitScore?.ToString("0.00") ?? "n/a";
                    var ruleLines = new List<string> { $"✓ Fit-gate eligible: {topEligibleCandidate.ScenarioId} (fit={fitDisplay})", $"Commit rules ({_resolvedBuildUpCommittedRuleSource}):" };
                    var allRulesPassed = true;
                    foreach (var rule in buildUpRules)
                    {
                        if (!metricValues.TryGetValue(rule.MetricKey, out var actualValue))
                        {
                            ruleLines.Add($"⚠ {rule.MetricKey}: value unavailable");
                            allRulesPassed = false;
                            continue;
                        }
                        if (!TryCompareRuleMetric(actualValue, rule.Comparator, rule.Threshold, out var passed))
                        {
                            ruleLines.Add($"⚠ {rule.MetricKey}: invalid comparator '{rule.Comparator}'");
                            allRulesPassed = false;
                            continue;
                        }
                        if (!passed) allRulesPassed = false;
                        ruleLines.Add(passed
                            ? $"✓ {rule.MetricKey} = {actualValue:0.##} (requires {rule.Comparator} {rule.Threshold:0.##}) → pass"
                            : $"✗ {rule.MetricKey} = {actualValue:0.##} (requires {rule.Comparator} {rule.Threshold:0.##}) → {ComputeRuleGapDescription(actualValue, rule.Comparator, rule.Threshold)}");
                    }
                    rows.Add(new PhaseGateRow(
                        "BuildUp Commit Gate",
                        allRulesPassed ? "Open" : "Closed",
                        string.Join("\n", ruleLines)));
                }
            }
        }

        switch (state.CurrentPhase)
        {
            case NarrativePhase.Committed:
            {
                var thresholds = ResolveCommittedGateThresholds(state);
                var committedTurns = _v2State?.TurnCountInPhase ?? state.TurnsSinceCommitment;
                var scoreMet = activeScenarioScore >= thresholds.ScoreMin;
                var desireMet = desire >= thresholds.DesireMin;
                var restraintMet = restraint <= thresholds.RestraintMax;
                var turnsMet = committedTurns >= thresholds.InteractionsMin;
                var isMet = scoreMet && desireMet && restraintMet && turnsMet;
                var scoreGap = Math.Max(0, thresholds.ScoreMin - activeScenarioScore);
                var desireGap = Math.Max(0, thresholds.DesireMin - desire);
                var restraintGap = Math.Max(0, restraint - thresholds.RestraintMax);
                var turnGap = Math.Max(0, thresholds.InteractionsMin - committedTurns);
                rows.Add(new PhaseGateRow(
                    "Gate: Committed -> Approaching",
                    isMet ? "Open" : "Closed",
                    $"{thresholds.Source}: Score {activeScenarioScore:0.0}/{thresholds.ScoreMin:0} ({(scoreMet ? "OK" : $"Need +{scoreGap:0.0}")}), Desire {desire:0.0}/{thresholds.DesireMin:0} ({(desireMet ? "OK" : $"Need +{desireGap:0.0}")}), Restraint {restraint:0.0}/<={thresholds.RestraintMax:0} ({(restraintMet ? "OK" : $"Need -{restraintGap:0.0}")}), Interactions {committedTurns}/{thresholds.InteractionsMin} ({(turnsMet ? "OK" : $"Need +{turnGap}")})"));
                break;
            }
            case NarrativePhase.Approaching:
            {
                var thresholds = ResolveApproachingGateThresholds(state);
                var scoreMet = activeScenarioScore >= thresholds.ScoreMin;
                var desireMet = desire >= thresholds.DesireMin;
                var restraintMet = restraint <= thresholds.RestraintMax;
                var turnsMet = state.TurnsInApproaching >= thresholds.InteractionsMin;
                var thresholdMet = scoreMet && desireMet && restraintMet && turnsMet;
                var scoreGap = Math.Max(0, thresholds.ScoreMin - activeScenarioScore);
                var desireGap = Math.Max(0, thresholds.DesireMin - desire);
                var restraintGap = Math.Max(0, restraint - thresholds.RestraintMax);
                var turnGap = Math.Max(0, thresholds.InteractionsMin - state.TurnsInApproaching);
                rows.Add(new PhaseGateRow(
                    "Gate: Approaching -> Climax",
                    thresholdMet ? "Open" : "Closed",
                    $"{thresholds.Source}: Score {activeScenarioScore:0.0}/{thresholds.ScoreMin:0} ({(scoreMet ? "OK" : $"Need +{scoreGap:0.0}")}), Desire {desire:0.0}/{thresholds.DesireMin:0} ({(desireMet ? "OK" : $"Need +{desireGap:0.0}")}), Restraint {restraint:0.0}/<={thresholds.RestraintMax:0} ({(restraintMet ? "OK" : $"Need -{restraintGap:0.0}")}), Interactions {state.TurnsInApproaching}/{thresholds.InteractionsMin} ({(turnsMet ? "OK" : $"Need +{turnGap}")}). '/climax' can force transition."));
                break;
            }
            case NarrativePhase.Climax:
                rows.Add(new PhaseGateRow(
                    "Gate: Climax -> Reset",
                    "Command-driven",
                    "Transition opens when climax completion is signaled (for example '/completeclimax')."));
                break;
            case NarrativePhase.Reset:
            {
                var resetInteractionRule = _defaultNarrativeGateProfile?.Rules
                    .FirstOrDefault(r =>
                        string.Equals(r.FromPhase, "Reset", StringComparison.OrdinalIgnoreCase)
                        && string.Equals(r.ToPhase, "BuildUp", StringComparison.OrdinalIgnoreCase)
                        && string.Equals(r.MetricKey, DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment, StringComparison.OrdinalIgnoreCase));
                var resetThreshold = resetInteractionRule is not null ? (int)Math.Round(resetInteractionRule.Threshold, MidpointRounding.AwayFromZero) : 3;
                var resetInteractions = state.TurnsSinceCommitment;
                var resetGateOpen = resetInteractions >= resetThreshold;
                rows.Add(new PhaseGateRow(
                    "Gate: Reset -> BuildUp",
                    resetGateOpen ? "Open" : "Waiting",
                    $"Minimum {resetThreshold} interactions in Reset phase before returning to BuildUp (current: {resetInteractions}/{resetThreshold}). Commit is paused during Reset."));
                break;
            }
            case NarrativePhase.BuildUp:
                rows.Add(new PhaseGateRow(
                    "Gate: BuildUp -> Committed",
                    string.IsNullOrWhiteSpace(state.ActiveScenarioId) ? "Waiting" : "Committed scenario active",
                    string.IsNullOrWhiteSpace(state.ActiveScenarioId)
                        ? "No active scenario is committed yet. Scenario selection/commitment must happen first."
                        : "A scenario is already committed, so phase is expected to move through Committed flow gates."));
                break;
        }

        rows.Add(new PhaseGateRow(
            "Manual Override Gate",
            "Command-driven",
            "A manual scenario override request immediately forces a reset before switching scenario."));

        return rows;
    }

    private static string ResolveWillingnessTier(
        double desire,
        DreamGenClone.Domain.RolePlay.ScenarioEngineSettings? settings = null)
    {
        var highMin = settings?.StageAHighDesireMin ?? 75;
        var mediumMin = settings?.StageAMediumDesireMin ?? 55;
        var lowMin = settings?.StageALowDesireMin ?? 35;

        if (desire >= highMin)
        {
            return "High";
        }

        if (desire >= mediumMin)
        {
            return "Medium";
        }

        if (desire >= lowMin)
        {
            return "Low";
        }

        return "Blocked";
    }

    private IReadOnlyList<PhaseLadderItem> GetPhaseLadderItems()
    {
        if (_session is null)
        {
            return [new PhaseLadderItem("(session unavailable)", "badge text-bg-secondary")];
        }

        var current = _v2State?.CurrentPhase ?? DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp;
        var phases = new[]
        {
            DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Committed,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Approaching,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Climax,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Reset
        };

        var currentOrder = GetPhaseOrder(current);
        return phases
            .Select(phase =>
            {
                var order = GetPhaseOrder(phase);
                var badgeClass = phase == current
                    ? "badge text-bg-warning"
                    : order < currentOrder
                        ? "badge text-bg-success"
                        : "badge text-bg-secondary";
                return new PhaseLadderItem(phase.ToString(), badgeClass);
            })
            .ToList();
    }

    private string GetPhaseProgressBarClass()
    {
        if (_session is null)
        {
            return "bg-secondary";
        }

        return _v2State?.CurrentPhase switch
        {
            DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp => "bg-info",
            DreamGenClone.Domain.RolePlay.NarrativePhase.Committed => "bg-primary",
            DreamGenClone.Domain.RolePlay.NarrativePhase.Approaching => "bg-warning",
            DreamGenClone.Domain.RolePlay.NarrativePhase.Climax => "bg-danger",
            DreamGenClone.Domain.RolePlay.NarrativePhase.Reset => "bg-success",
            _ => "bg-secondary"
        };
    }

    private static int GetPhaseOrder(DreamGenClone.Domain.RolePlay.NarrativePhase phase)
    {
        return phase switch
        {
            DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp => 0,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Committed => 1,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Approaching => 2,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Climax => 3,
            DreamGenClone.Domain.RolePlay.NarrativePhase.Reset => 4,
            _ => 99
        };
    }

    private PhaseProgressInfo GetCurrentPhaseProgress()
    {
        if (_session is null)
        {
            return new PhaseProgressInfo("(unknown)", 0, "Session unavailable.");
        }

        var state = _session.AdaptiveState;
        var desire = GetAverageAdaptiveStat(state, "Desire");
        var restraint = GetAverageAdaptiveStat(state, "Restraint");
        var activeScenarioScore = GetLifecycleActiveScenarioScore(state, out _);
        var effectiveTurnsSinceCommitment = GetEffectiveTurnsSinceCommitment(state);
        var effectiveTurnsInApproaching = GetEffectiveTurnsInApproaching(state, effectiveTurnsSinceCommitment);

        return state.CurrentPhase switch
        {
            NarrativePhase.BuildUp => BuildBuildUpProgress(state, desire, restraint),
            NarrativePhase.Committed => BuildCommittedProgress(state, activeScenarioScore, desire, restraint, effectiveTurnsSinceCommitment),
            NarrativePhase.Approaching => BuildApproachingProgress(state, activeScenarioScore, desire, restraint, effectiveTurnsInApproaching),
            NarrativePhase.Climax => new PhaseProgressInfo(
                "Reset",
                0,
                "Completion is command-driven in current flow. Use '/completeclimax' when the climax has resolved."),
            NarrativePhase.Reset => BuildResetProgress(state),
            _ => new PhaseProgressInfo("(unknown)", 0, "No phase metric available.")
        };
    }

    private PhaseProgressInfo BuildBuildUpProgress(AdaptiveScenarioState state, double desire, double restraint)
    {
        var nextPhase = "Committed";

        // In observer mode the engine is still accumulating turn signals before committing a theme.
        if (string.Equals(state.ThemeSelectionRule, "Observing", StringComparison.OrdinalIgnoreCase))
        {
            var remaining = Math.Max(0, state.SelectionMinimumTurns - state.ObservedTurnCount);
            if (remaining == 0)
            {
                return new PhaseProgressInfo(
                    "Selection",
                    100,
                    "Observer window complete. Theme will be committed on the next selection cycle.");
            }

            var done = state.SelectionMinimumTurns > 0
                ? (int)Math.Round((double)state.ObservedTurnCount / state.SelectionMinimumTurns * 100)
                : 0;
            return new PhaseProgressInfo(
                "Selection",
                done,
                $"Observer mode: {remaining} turn{(remaining == 1 ? "" : "s")} remaining until theme selection closes.");
        }

        var buildUpRules = _resolvedBuildUpCommittedRules.ToList();

        if (buildUpRules.Count == 0)
        {
            return new PhaseProgressInfo(
                nextPhase,
                0,
                $"ERROR: {_resolvedBuildUpCommittedRuleError ?? "No BuildUp -> Committed rules configured from selected profile or theme-local configuration."}");
        }

        var topEligibleCandidate = _v2Diagnostics?.CandidateEvaluations
            .Where(x => x.StageBEligible)
            .OrderByDescending(x => x.Confidence)
            .ThenByDescending(x => x.FitScore)
            .FirstOrDefault();
        var topCandidate = topEligibleCandidate
            ?? _v2Diagnostics?.CandidateEvaluations
                .OrderByDescending(x => x.Confidence)
                .ThenByDescending(x => x.FitScore)
                .FirstOrDefault();

        var interactionCount = _v2State?.TurnCountInPhase ?? _session?.AdaptiveState.TurnCountInPhase ?? 0;
        var fitScore = topEligibleCandidate?.FitScore ?? 0m;
        var metricValues = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase)
        {
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore] = fitScore,
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment] = interactionCount,
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDesire] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Desire"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageRestraint] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Restraint"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDominance] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Dominance"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageLoyalty] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Loyalty"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageSelfRespect] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "SelfRespect")
        };

        var ruleCount = 0;
        var progressSum = 0.0;
        foreach (var rule in buildUpRules)
        {
            if (!metricValues.TryGetValue(rule.MetricKey, out var actualValue))
            {
                continue;
            }

            ruleCount++;
            if (!TryCompareRuleMetric(actualValue, rule.Comparator, rule.Threshold, out var passed))
            {
                continue;
            }

            if (passed)
            {
                progressSum += 1.0;
                continue;
            }

            var partial = rule.Comparator switch
            {
                DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThanOrEqual or DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThan
                    => rule.Threshold == 0 ? 1.0 : Math.Clamp((double)(actualValue / rule.Threshold), 0, 1),
                DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThanOrEqual or DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThan
                    => actualValue <= 0 ? 1.0 : Math.Clamp((double)(rule.Threshold / actualValue), 0, 1),
                DreamGenClone.Domain.RolePlay.NarrativeGateComparators.Equal
                    => Math.Clamp(1.0 - Math.Abs((double)(actualValue - rule.Threshold)) / 100.0, 0, 1),
                _ => 0.0
            };
            progressSum += partial;
        }

        var confidenceProgress = ruleCount > 0 ? (int)Math.Round(progressSum / ruleCount * 100.0) : 0;

        var ruleParts = new List<string>();
        foreach (var r in buildUpRules)
            ruleParts.Add($"{r.MetricKey}{r.Comparator}{r.Threshold:0.##}");
        var rulesText = string.Join(", ", ruleParts);

        var candidateInfo = topCandidate is null
            ? "No candidate evaluations available yet."
            : $"Top candidate '{topCandidate.ScenarioId}' fit={topCandidate.FitScore:0.0}, confidence={topCandidate.Confidence:F2}.";

        return new PhaseProgressInfo(
            nextPhase,
            confidenceProgress,
            $"{_resolvedBuildUpCommittedRuleSource} rules: {rulesText}. Runtime interactionMetric={interactionCount}. {candidateInfo}"
        );
    }

    private async Task ResolveBuildUpGateRuleCacheAsync()
    {
        _resolvedBuildUpCommittedRules = [];
        _resolvedBuildUpCommittedRuleSource = "(unresolved)";
        _resolvedBuildUpCommittedRuleError = null;
        _resolvedEffectiveNarrativeGateProfile = null;

        if (_session is null)
        {
            _resolvedBuildUpCommittedRuleError = "Session unavailable while resolving BuildUp gate rules.";
            return;
        }

        // In observer mode no theme has been committed yet; gate rules are not applicable.
        if (string.Equals(_v2State?.ThemeSelectionRule, "Observing", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_v2State?.SelectedNarrativeGateProfileId))
        {
            if (_selectedNarrativeGateProfile is null)
            {
                _resolvedBuildUpCommittedRuleError = $"Selected narrative gate profile '{_v2State?.SelectedNarrativeGateProfileId}' not found.";
                return;
            }

            _resolvedBuildUpCommittedRuleSource = $"Profile '{_selectedNarrativeGateProfile.Name}'";
            _resolvedEffectiveNarrativeGateProfile = _selectedNarrativeGateProfile;
            _resolvedBuildUpCommittedRules = _selectedNarrativeGateProfile.Rules
                .Where(r => string.Equals(r.FromPhase, "BuildUp", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(r.ToPhase, "Committed", StringComparison.OrdinalIgnoreCase))
                .OrderBy(r => r.SortOrder)
                .ToList();

            if (_resolvedBuildUpCommittedRules.Count == 0)
            {
                _resolvedBuildUpCommittedRuleError = $"Selected profile '{_selectedNarrativeGateProfile.Name}' has no BuildUp -> Committed rules.";
            }

            return;
        }

        var topEligibleCandidateScenarioId = _v2Diagnostics?.CandidateEvaluations
            .Where(x => x.StageBEligible)
            .OrderByDescending(x => x.FitScore)
            .ThenByDescending(x => x.Confidence)
            .FirstOrDefault()?.ScenarioId;
        var topCandidateScenarioId = _v2Diagnostics?.CandidateEvaluations
            .OrderByDescending(x => x.FitScore)
            .ThenByDescending(x => x.Confidence)
            .FirstOrDefault()?.ScenarioId;
        var themeId = !string.IsNullOrWhiteSpace(_v2State?.ActiveScenarioId)
            ? _v2State?.ActiveScenarioId
            : !string.IsNullOrWhiteSpace(topEligibleCandidateScenarioId)
                ? topEligibleCandidateScenarioId
                : topCandidateScenarioId;

        if (string.IsNullOrWhiteSpace(themeId))
        {
            _resolvedBuildUpCommittedRuleError = "No scenario/theme id available to resolve BuildUp gate rules.";
            return;
        }

        var theme = await RPThemeService.GetThemeAsync(themeId);
        if (theme is null)
        {
            _resolvedBuildUpCommittedRuleError = $"Theme '{themeId}' not found while resolving BuildUp gate rules.";
            return;
        }

        _resolvedBuildUpCommittedRuleSource = $"Theme '{theme.Id}' local rules";
        _resolvedEffectiveNarrativeGateProfile = new DreamGenClone.Domain.RolePlay.NarrativeGateProfile
        {
            Id = theme.Id,
            Name = $"Theme '{theme.Id}' local rules",
            Rules = theme.NarrativeGateRules.ToList()
        };
        _resolvedBuildUpCommittedRules = theme.NarrativeGateRules
            .Where(r => string.Equals(r.FromPhase, "BuildUp", StringComparison.OrdinalIgnoreCase)
                && string.Equals(r.ToPhase, "Committed", StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => r.SortOrder)
            .ToList();

        if (_resolvedBuildUpCommittedRules.Count == 0)
        {
            _resolvedBuildUpCommittedRuleError = $"Theme '{theme.Id}' has no BuildUp -> Committed rules.";
        }
    }

    private PhaseProgressInfo BuildCommittedProgress(AdaptiveScenarioState state, double activeScenarioScore, double desire, double restraint, int TurnsSinceCommitment)
    {
        var thresholds = ResolveCommittedGateThresholds(state);
        var scoreProgress = Math.Clamp(activeScenarioScore / thresholds.ScoreMin, 0, 1);
        var desireProgress = Math.Clamp(desire / thresholds.DesireMin, 0, 1);
        var restraintProgress = Math.Clamp((100.0 - restraint) / (100.0 - thresholds.RestraintMax), 0, 1);
        var interactionProgress = Math.Clamp((double)TurnsSinceCommitment / thresholds.InteractionsMin, 0, 1);

        var progressPercent = (int)Math.Round((scoreProgress + desireProgress + restraintProgress + interactionProgress) / 4.0 * 100.0);
        return new PhaseProgressInfo(
            "Approaching",
            progressPercent,
            $"{thresholds.Source}: score>={thresholds.ScoreMin:0} ({activeScenarioScore:0.0}), desire>={thresholds.DesireMin:0} ({desire:0.0}), restraint<={thresholds.RestraintMax:0} ({restraint:0.0}), interactions>={thresholds.InteractionsMin} ({TurnsSinceCommitment})."
        );
    }

    private PhaseProgressInfo BuildApproachingProgress(AdaptiveScenarioState state, double activeScenarioScore, double desire, double restraint, int TurnsInApproaching)
    {
        var thresholds = ResolveApproachingGateThresholds(state);
        var scoreProgress = Math.Clamp(activeScenarioScore / thresholds.ScoreMin, 0, 1);
        var desireProgress = Math.Clamp(desire / thresholds.DesireMin, 0, 1);
        var restraintProgress = Math.Clamp((100.0 - restraint) / (100.0 - thresholds.RestraintMax), 0, 1);
        var interactionProgress = Math.Clamp((double)TurnsInApproaching / thresholds.InteractionsMin, 0, 1);

        var progressPercent = (int)Math.Round((scoreProgress + desireProgress + restraintProgress + interactionProgress) / 4.0 * 100.0);
        return new PhaseProgressInfo(
            "Climax",
            progressPercent,
            $"{thresholds.Source}: score>={thresholds.ScoreMin:0} ({activeScenarioScore:0.0}), desire>={thresholds.DesireMin:0} ({desire:0.0}), restraint<={thresholds.RestraintMax:0} ({restraint:0.0}), approaching interactions>={thresholds.InteractionsMin} ({TurnsInApproaching}). '/climax' can force transition."
        );
    }

    private PhaseProgressInfo BuildResetProgress(AdaptiveScenarioState state)
    {
        var interactionRule = _defaultNarrativeGateProfile?.Rules
            .FirstOrDefault(r =>
                string.Equals(r.FromPhase, "Reset", StringComparison.OrdinalIgnoreCase)
                && string.Equals(r.ToPhase, "BuildUp", StringComparison.OrdinalIgnoreCase)
                && string.Equals(r.MetricKey, DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment, StringComparison.OrdinalIgnoreCase));
        var threshold = interactionRule is not null ? (int)Math.Round(interactionRule.Threshold, MidpointRounding.AwayFromZero) : 3;
        var current = state.TurnsSinceCommitment;
        var progress = threshold <= 0 ? 100 : (int)Math.Round(Math.Clamp((double)current / threshold, 0.0, 1.0) * 100.0);
        var source = _defaultNarrativeGateProfile is not null ? $"Profile '{_defaultNarrativeGateProfile.Name}'" : "default";
        return new PhaseProgressInfo(
            "BuildUp",
            progress,
            $"{source}: minimum {threshold} Reset-phase interactions required before returning to BuildUp (current: {current}). Commit is paused during Reset.");
    }

    private PhaseGateThresholds ResolveCommittedGateThresholds(AdaptiveScenarioState state)
    {
        return ResolveGateThresholdsFromProfile("Committed", "Approaching");
    }

    private PhaseGateThresholds ResolveApproachingGateThresholds(AdaptiveScenarioState state)
    {
        return ResolveGateThresholdsFromProfile("Approaching", "Climax");
    }

    private PhaseGateThresholds ResolveGateThresholdsFromProfile(
        string fromPhase,
        string toPhase)
    {
        // Use the effective profile (selected or theme-local) to match what the engine actually evaluates.
        // Fall back to the default profile only when no effective profile has been resolved.
        var profile = _resolvedEffectiveNarrativeGateProfile ?? _defaultNarrativeGateProfile;
        var notConfigured = new PhaseGateThresholds(
            ScoreMin: 0,
            DesireMin: 0,
            RestraintMax: 100,
            InteractionsMin: 0,
            Source: $"ERROR: No {fromPhase} ? {toPhase} rules configured in Narrative Gate Profile");

        if (profile?.Rules is null || profile.Rules.Count == 0)
        {
            return notConfigured;
        }

        var rules = profile.Rules
            .Where(rule => string.Equals(rule.FromPhase, fromPhase, StringComparison.OrdinalIgnoreCase)
                && string.Equals(rule.ToPhase, toPhase, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (rules.Count == 0)
        {
            return notConfigured;
        }

        var hasScore = TryGetThreshold(
            rules,
            DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore,
            [DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThanOrEqual, DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThan],
            out var scoreMin);
        var hasDesire = TryGetThreshold(
            rules,
            DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDesire,
            [DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThanOrEqual, DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThan],
            out var desireMin);
        var hasRestraint = TryGetThreshold(
            rules,
            DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageRestraint,
            [DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThanOrEqual, DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThan],
            out var restraintMax);
        var hasInteractions = TryGetThreshold(
            rules,
            DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment,
            [DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThanOrEqual, DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThan],
            out var interactionsMin);

        if (!hasScore && !hasDesire && !hasRestraint && !hasInteractions)
        {
            return notConfigured;
        }

        return new PhaseGateThresholds(
            ScoreMin: hasScore ? scoreMin : 0,
            DesireMin: hasDesire ? desireMin : 0,
            RestraintMax: hasRestraint ? restraintMax : 100,
            InteractionsMin: hasInteractions
                ? Math.Max(0, (int)Math.Round(interactionsMin, MidpointRounding.AwayFromZero))
                : 0,
            Source: $"Profile '{profile.Name}'");
    }

    private static bool TryGetThreshold(
        IReadOnlyList<DreamGenClone.Domain.RolePlay.NarrativeGateRule> rules,
        string metricKey,
        IReadOnlyList<string> comparators,
        out double threshold)
    {
        var match = rules.FirstOrDefault(rule => string.Equals(rule.MetricKey, metricKey, StringComparison.OrdinalIgnoreCase)
            && comparators.Any(comparator => string.Equals(rule.Comparator, comparator, StringComparison.OrdinalIgnoreCase)));
        if (match is null)
        {
            threshold = 0;
            return false;
        }

        threshold = (double)match.Threshold;
        return true;
    }

    private static string ComputeRuleGapDescription(decimal actual, string comparator, decimal threshold)
        => (comparator ?? string.Empty).Trim() switch
        {
            DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThanOrEqual or
            DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThan
                => $"need +{threshold - actual:0.##} more (to reach {threshold:0.##})",
            DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThanOrEqual or
            DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThan
                => $"need -{actual - threshold:0.##} less (to reach {threshold:0.##})",
            _ => $"value {actual:0.##} does not meet threshold {threshold:0.##}"
        };

    private static bool TryCompareRuleMetric(decimal actual, string comparator, decimal threshold, out bool passed)
    {
        switch ((comparator ?? string.Empty).Trim())
        {
            case DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThanOrEqual:
                passed = actual >= threshold;
                return true;
            case DreamGenClone.Domain.RolePlay.NarrativeGateComparators.GreaterThan:
                passed = actual > threshold;
                return true;
            case DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThanOrEqual:
                passed = actual <= threshold;
                return true;
            case DreamGenClone.Domain.RolePlay.NarrativeGateComparators.LessThan:
                passed = actual < threshold;
                return true;
            case DreamGenClone.Domain.RolePlay.NarrativeGateComparators.Equal:
                passed = actual == threshold;
                return true;
            default:
                passed = false;
                return false;
        }
    }

    private (string Status, string NextStep) GetSimpleRuntimeSummary()
    {
        if (_session is null)
        {
            return ("Session not loaded.", "Wait for session load.");
        }

        var state = _session.AdaptiveState;
        var phase = state.CurrentPhase;
        var phaseProgress = GetCurrentPhaseProgress();
        if (phase == NarrativePhase.Committed)
        {
            var thresholds = ResolveCommittedGateThresholds(state);
            if (thresholds.Source.StartsWith("ERROR", StringComparison.OrdinalIgnoreCase))
            {
                return (
                    "Next phase Approaching is blocked.",
                    thresholds.Source);
            }

            var activeScenarioScore = GetLifecycleActiveScenarioScore(state, out _);
            var desire = GetAverageAdaptiveStat(state, "Desire");
            var restraint = GetAverageAdaptiveStat(state, "Restraint");
            var TurnsSinceCommitment = GetEffectiveTurnsSinceCommitment(state);

            if (activeScenarioScore < thresholds.ScoreMin)
            {
                return (
                    "Next phase Approaching is blocked.",
                    $"Raise score to {thresholds.ScoreMin:0} (current {activeScenarioScore:0.0}).");
            }

            if (desire < thresholds.DesireMin)
            {
                return (
                    "Next phase Approaching is blocked.",
                    $"Raise desire to {thresholds.DesireMin:0} (current {desire:0.0}).");
            }

            if (restraint > thresholds.RestraintMax)
            {
                return (
                    "Next phase Approaching is blocked.",
                    $"Lower restraint to {thresholds.RestraintMax:0} (current {restraint:0.0}).");
            }

            if (TurnsSinceCommitment < thresholds.InteractionsMin)
            {
                return (
                    "Next phase Approaching is blocked.",
                    $"Add interactions to {thresholds.InteractionsMin} (current {TurnsSinceCommitment}).");
            }

            return (
                "Next phase Approaching is ready.",
                "All Committed gate rules are passing.");
        }

        if (phase == NarrativePhase.Approaching)
        {
            var thresholds = ResolveApproachingGateThresholds(state);
            if (thresholds.Source.StartsWith("ERROR", StringComparison.OrdinalIgnoreCase))
            {
                return (
                    "Next phase Climax is blocked.",
                    thresholds.Source);
            }

            var activeScenarioScore = GetLifecycleActiveScenarioScore(state, out _);
            var desire = GetAverageAdaptiveStat(state, "Desire");
            var restraint = GetAverageAdaptiveStat(state, "Restraint");
            var TurnsSinceCommitment = GetEffectiveTurnsSinceCommitment(state);
            var TurnsInApproaching = GetEffectiveTurnsInApproaching(state, TurnsSinceCommitment);

            if (activeScenarioScore < thresholds.ScoreMin)
            {
                return (
                    "Next phase Climax is blocked.",
                    $"Raise score to {thresholds.ScoreMin:0} (current {activeScenarioScore:0.0}).");
            }

            if (desire < thresholds.DesireMin)
            {
                return (
                    "Next phase Climax is blocked.",
                    $"Raise desire to {thresholds.DesireMin:0} (current {desire:0.0}).");
            }

            if (restraint > thresholds.RestraintMax)
            {
                return (
                    "Next phase Climax is blocked.",
                    $"Lower restraint to {thresholds.RestraintMax:0} (current {restraint:0.0}).");
            }

            if (TurnsInApproaching < thresholds.InteractionsMin)
            {
                return (
                    "Next phase Climax is blocked.",
                    $"Add approaching interactions to {thresholds.InteractionsMin} (current {TurnsInApproaching}).");
            }

            return (
                "Next phase Climax is ready.",
                "All Approaching gate rules are passing.");
        }

        if (phase == NarrativePhase.Reset)
        {
            var interactionRule = _defaultNarrativeGateProfile?.Rules
                .FirstOrDefault(r =>
                    string.Equals(r.FromPhase, "Reset", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(r.ToPhase, "BuildUp", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(r.MetricKey, DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment, StringComparison.OrdinalIgnoreCase));
            var threshold = interactionRule is not null ? (int)Math.Round(interactionRule.Threshold, MidpointRounding.AwayFromZero) : 3;
            var current = state.TurnsSinceCommitment;
            if (current < threshold)
            {
                return (
                    "Next phase BuildUp is blocked.",
                    $"Add Reset interactions to {threshold} (current {current}).");
            }

            return (
                "Next phase BuildUp is ready.",
                "Reset interaction rule is passing.");
        }

        if (phase == NarrativePhase.Climax)
        {
            return (
                "Next phase Reset is ready.",
                "Proceed to transition out of Climax.");
        }

        if (phase != NarrativePhase.BuildUp)
        {
            return ($"Next phase {phaseProgress.NextPhase} pending.", phaseProgress.Details);
        }

        // In observer mode the engine is still accumulating signals before committing a theme.
        if (string.Equals(state.ThemeSelectionRule, "Observing", StringComparison.OrdinalIgnoreCase))
        {
            var remaining = Math.Max(0, state.SelectionMinimumTurns - state.ObservedTurnCount);
            if (remaining == 0)
            {
                return (
                    "Observer mode: selection window complete.",
                    "Theme will be committed on the next selection cycle.");
            }

            return (
                "Observer mode: gathering signals.",
                $"{remaining} turn{(remaining == 1 ? "" : "s")} remaining before theme selection closes.");
        }

        var topEligibleCandidate = _v2Diagnostics?.CandidateEvaluations
            .Where(x => x.StageBEligible)
            .OrderByDescending(x => x.FitScore)
            .ThenByDescending(x => x.Confidence)
            .FirstOrDefault();
        if (topEligibleCandidate is null)
        {
            // Check whether live Gate A is open (may differ from stale diagnostics).
            var liveDesire = GetAverageAdaptiveStat(state, "Desire");
            var liveWillingnessTier = ResolveWillingnessTier(liveDesire, _scenarioEngineSettings);
            var liveStageAOpen = !string.Equals(liveWillingnessTier, "Blocked", StringComparison.OrdinalIgnoreCase);
            if (liveStageAOpen)
            {
                return (
                    "BuildUp commit pending re-evaluation.",
                    "Gate A is open. Candidates will be re-evaluated for fit on the next engine cycle.");
            }
            return (
                "BuildUp commit is blocked: Gate A closed.",
                $"Desire = {liveDesire:0.0} (needs = {_scenarioEngineSettings.StageALowDesireMin:0.##}). Raise desire to open Gate A.");
        }

        var buildUpRules = _resolvedBuildUpCommittedRules;
        if (buildUpRules.Count == 0)
        {
            return (
                "BuildUp commit rules are missing.",
                _resolvedBuildUpCommittedRuleError ?? "Configure BuildUp -> Committed rules for selected profile/theme.");
        }

        var fitScore = topEligibleCandidate.FitScore;
        var interactionCount = _v2State?.TurnCountInPhase ?? _session?.AdaptiveState.TurnCountInPhase ?? 0;
        var metricValues = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase)
        {
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore] = fitScore,
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment] = interactionCount,
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDesire] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Desire"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageRestraint] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Restraint"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageTension] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Tension"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageConnection] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Connection"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDominance] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Dominance"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageLoyalty] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "Loyalty"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageSelfRespect] = (decimal)GetAverageAdaptiveStat(_session.AdaptiveState, "SelfRespect")
        };

        foreach (var rule in buildUpRules)
        {
            if (!metricValues.TryGetValue(rule.MetricKey, out var actualValue))
            {
                return (
                    $"BuildUp commit is blocked: {rule.MetricKey} value is unavailable.",
                    $"Populate {rule.MetricKey} metric and retry.");
            }

            if (!TryCompareRuleMetric(actualValue, rule.Comparator, rule.Threshold, out var passed))
            {
                return (
                    $"BuildUp commit is blocked: invalid comparator '{rule.Comparator}'.",
                    $"Fix comparator for {rule.MetricKey} in gate rules.");
            }

            if (!passed)
            {
                return (
                    $"BuildUp commit is blocked: {rule.MetricKey} is {actualValue:0.##}, needs {rule.Comparator}{rule.Threshold:0.##}.",
                    $"Raise/lower {rule.MetricKey} until this rule passes.");
            }
        }

        return (
            "All BuildUp commit rules are open.",
            "Commit should happen on this/next evaluation cycle unless a higher-level lock is active.");
    }

    private int GetEffectiveTurnsSinceCommitment(AdaptiveScenarioState state)
    {
        var raw = state.TurnsSinceCommitment;
        if (raw > 0)
        {
            return raw;
        }

        if (_session is null
            || string.IsNullOrWhiteSpace(state.ActiveScenarioId)
            || state.CurrentPhase is NarrativePhase.BuildUp or NarrativePhase.Reset)
        {
            return raw;
        }

        if (!state.ScenarioCommitmentTimeUtc.HasValue)
        {
            return raw;
        }

        var commitmentUtc = state.ScenarioCommitmentTimeUtc.Value;
        var interactionsSinceCommitTimestamp = _session.Interactions.Count(x => x.CreatedAt >= commitmentUtc);
        var estimated = Math.Max(0, interactionsSinceCommitTimestamp - 1);
        return Math.Max(raw, estimated);
    }

    private static int GetEffectiveTurnsInApproaching(AdaptiveScenarioState state, int effectiveTurnsSinceCommitment)
    {
        if (state.TurnsInApproaching > 0)
        {
            return state.TurnsInApproaching;
        }

        if (state.CurrentPhase != NarrativePhase.Approaching)
        {
            return state.TurnsInApproaching;
        }

        return Math.Max(0, Math.Min(effectiveTurnsSinceCommitment, 2));
    }

    private sealed record PhaseGateRuleRow(
        string MetricLabel,
        string CurrentDisplay,
        string Requirement,
        bool Passed,
        string GapDescription);

    private IReadOnlyList<PhaseGateRuleRow> GetPhaseGateDisplayRows()
    {
        if (_session is null || _resolvedEffectiveNarrativeGateProfile is null)
            return [];

        var state = _session.AdaptiveState;
        var phase = state.CurrentPhase;

        var (fromPhase, toPhase) = phase switch
        {
            NarrativePhase.BuildUp    => ("BuildUp",    "Committed"),
            NarrativePhase.Committed  => ("Committed",  "Approaching"),
            NarrativePhase.Approaching => ("Approaching", "Climax"),
            NarrativePhase.Climax     => ("Climax",     "Reset"),
            NarrativePhase.Reset      => ("Reset",      "BuildUp"),
            _                         => (string.Empty, string.Empty)
        };

        if (string.IsNullOrEmpty(fromPhase))
            return [];

        var rules = _resolvedEffectiveNarrativeGateProfile.Rules
            .Where(r => string.Equals(r.FromPhase, fromPhase, StringComparison.OrdinalIgnoreCase)
                     && string.Equals(r.ToPhase, toPhase, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => r.SortOrder)
            .ToList();

        if (rules.Count == 0)
            return [];

        var activeScenarioId = _v2State?.ActiveScenarioId ?? state.ActiveScenarioId;
        var activeEval = string.IsNullOrWhiteSpace(activeScenarioId)
            ? null
            : _v2Diagnostics?.CandidateEvaluations
                .LastOrDefault(x => string.Equals(x.ScenarioId, activeScenarioId, StringComparison.OrdinalIgnoreCase));
        var topEval = activeEval
            ?? _v2Diagnostics?.CandidateEvaluations
                .Where(x => x.StageBEligible)
                .OrderByDescending(x => x.FitScore)
                .ThenByDescending(x => x.Confidence)
                .FirstOrDefault()
            ?? _v2Diagnostics?.CandidateEvaluations
                .OrderByDescending(x => x.FitScore)
                .ThenByDescending(x => x.Confidence)
                .FirstOrDefault();

        var fitScore = topEval is not null
            ? topEval.FitScore
            : 0m;

        var interactionCount = (decimal)(_v2State?.TurnCountInPhase ?? state.TurnCountInPhase);

        var metricValues = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase)
        {
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore]          = fitScore,
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment]  = interactionCount,
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDesire]                = (decimal)GetAverageAdaptiveStat(state, "Desire"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageRestraint]             = (decimal)GetAverageAdaptiveStat(state, "Restraint"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageTension]               = (decimal)GetAverageAdaptiveStat(state, "Tension"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageConnection]            = (decimal)GetAverageAdaptiveStat(state, "Connection"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDominance]             = (decimal)GetAverageAdaptiveStat(state, "Dominance"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageLoyalty]               = (decimal)GetAverageAdaptiveStat(state, "Loyalty"),
            [DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageSelfRespect]           = (decimal)GetAverageAdaptiveStat(state, "SelfRespect")
        };

        var rows = new List<PhaseGateRuleRow>();
        foreach (var rule in rules)
        {
            if (!metricValues.TryGetValue(rule.MetricKey, out var actual))
                continue;
            TryCompareRuleMetric(actual, rule.Comparator, rule.Threshold, out var passed);
            var gapDesc = passed ? string.Empty : ComputeRuleGapDescription(actual, rule.Comparator, rule.Threshold);
            var isCount = string.Equals(rule.MetricKey,
                DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment,
                StringComparison.OrdinalIgnoreCase);
            rows.Add(new PhaseGateRuleRow(
                MetricLabel: FormatGateMetricLabel(rule.MetricKey),
                CurrentDisplay: isCount ? $"{(int)actual}" : $"{actual:0.#}",
                Requirement: $"{rule.Comparator} {rule.Threshold:0.##}",
                Passed: passed,
                GapDescription: gapDesc));
        }
        return rows;
    }

    private static string FormatGateMetricLabel(string metricKey) => metricKey switch
    {
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore          => "Fit Score",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.TurnsSinceCommitment  => "Interactions",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDesire                => "Avg Desire",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageRestraint             => "Avg Restraint",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageTension               => "Avg Tension",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageConnection            => "Avg Connection",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDominance             => "Avg Dominance",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageLoyalty               => "Avg Loyalty",
        DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageSelfRespect           => "Avg Self-Respect",
        _ => metricKey
    };

    private static double GetAverageAdaptiveStat(AdaptiveScenarioState state, string statName)
    {
        // Only scenario-bound characters (those with a CharacterRole) contribute to averages.
        // Incidental characters mentioned in narrative have no role and must not affect gating.
        var tracked = state.CharacterStats.Values
            .Where(x => !string.IsNullOrEmpty(x.CharacterRole))
            .ToList();
        if (tracked.Count == 0)
        {
            return AdaptiveStatCatalog.DefaultValue;
        }

        return tracked
            .Select(x => CharacterStatProfileV2Accessor.GetStatOrDefault(x, statName, AdaptiveStatCatalog.DefaultValue))
            .Average();
    }

    private double GetLifecycleActiveScenarioScore(AdaptiveScenarioState state, out string source)
    {
        var activeScenarioId = _v2State?.ActiveScenarioId ?? state.ActiveScenarioId;
        if (string.IsNullOrWhiteSpace(activeScenarioId))
        {
            source = "none";
            return 0;
        }

        var activeEval = _v2Diagnostics?.CandidateEvaluations
            .LastOrDefault(x => string.Equals(x.ScenarioId, activeScenarioId, StringComparison.OrdinalIgnoreCase));

        if (activeEval is not null)
        {
            source = "runtime fit";
            return (double)activeEval.FitScore;
        }

        source = "none";
        return 0;
    }

