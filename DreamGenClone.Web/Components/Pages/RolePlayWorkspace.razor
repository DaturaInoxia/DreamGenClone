                        }
                    </div>

                    <div class="rw-collapsible-section">
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("character-stats")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("character-stats") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">Character Stats (@(_v2State?.CharacterSnapshots?.Count ?? 0))</span>
                        </button>
                        @if (IsAdaptiveSectionExpanded("character-stats"))
                        {
                            <div class="rw-collapsible-body">
                                @if ((_v2State?.CharacterSnapshots?.Count ?? 0) == 0)
                                {
                                    <p class="rw-scenario-empty">No adaptive stats yet. Generate interactions to populate.</p>
                                }
                                else
                                {
                                    var fitClauseGaps = GetCharacterFitClauseGaps();
                                    var topEligible = _v2Diagnostics?.CandidateEvaluations
                                        .Where(x => x.StageBEligible)
                                        .OrderByDescending(x => x.FitScore)
                                        .ThenByDescending(x => x.Confidence)
                                        .FirstOrDefault();
                                    var topCandidateEval = topEligible
                                        ?? _v2Diagnostics?.CandidateEvaluations
                                            .OrderByDescending(x => x.FitScore)
                                            .ThenByDescending(x => x.Confidence)
                                            .FirstOrDefault();
                                    var activeFitScore = topCandidateEval is not null
                                        ? topCandidateEval.FitScore
                                        : (decimal?)null;
                                    var buildUpScoreRule = _resolvedBuildUpCommittedRules
                                        .FirstOrDefault(r => string.Equals(r.MetricKey,
                                            DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore,
                                            StringComparison.OrdinalIgnoreCase));
                                    // Fit Rules And Clauses (character alignment, dominant-role, clause evaluations)
                                    // are only relevant during the observation/selection window — before a theme
                                    // is committed. Once ActiveScenarioId is set, only the Narrative Gate Values
                                    // gate phase transitions; the fit clause block is no longer shown.
                                    var showFitBlock = fitClauseGaps is not null
                                        && _v2State?.CurrentPhase == DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp
                                        && string.IsNullOrWhiteSpace(_v2State?.ActiveScenarioId);
                                    var scoreLabel = activeFitScore.HasValue ? $"{activeFitScore:0.0}" : "n/a";
                                    var scoreRequired = buildUpScoreRule is not null ? $"{buildUpScoreRule.Threshold:0}" : "—";
                                    var scorePass = buildUpScoreRule is not null && activeFitScore.HasValue
                                        && activeFitScore.Value >= buildUpScoreRule.Threshold;

                                    if (showFitBlock && fitClauseGaps is not null)
                                    {
                                        <div class="rw-fit-score-block">
                                            <div class="rw-fit-score-header">
                                                <span>Scenario Fit Score</span>
                                                <span class="@(scorePass ? "rw-fit-score-pass" : "rw-fit-score-fail")">
                                                    @scoreLabel / @scoreRequired required (BuildUp gate)
                                                    @if (!scorePass && activeFitScore.HasValue && buildUpScoreRule is not null)
                                                    {
                                                        var scoreGap = buildUpScoreRule.Threshold - activeFitScore.Value;
                                                        <span> → need +@scoreGap.ToString("0.0")</span>
                                                    }
                                                </span>
                                            </div>
                                            @if (topCandidateEval?.Rationale is { Length: > 0 } rationale)
                                            {
                                                <div class="rw-fit-score-rationale">@rationale</div>
                                            }
                                            @foreach (var (actorKey, displayName, failingClauses) in fitClauseGaps)
                                            {
                                                @if (failingClauses.Count > 0)
                                                {
                                                    <div class="rw-fit-char-row">
                                                        <span class="rw-fit-char-name">@displayName → failing clauses:</span>
                                                        <span class="rw-fit-char-clauses">
                                                            @foreach (var fc in failingClauses)
                                                            {
                                                                var gapStr = fc.Gap > 0 ? $"+{fc.Gap}" : fc.Gap.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                                                <span class="rw-fit-clause-gap" title="@fc.StatName @fc.Comparator @fc.Threshold (current @fc.CurrentValue)">
                                                                    @fc.StatName @gapStr
                                                                </span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                    @foreach (var actorStats in (_v2State?.CharacterSnapshots ?? []).OrderBy(c => c.CharacterId))
                                    {
                                        var baselineProfile = GetBaselineCharacterProfile(actorStats.CharacterId);
                                        var characterExpanded = _expandedAdaptiveCharacterStats.Contains(actorStats.CharacterId);
                                        <div class="rw-collapsible-section" style="margin-bottom:10px;">
                                            <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveCharacterStatsCharacter(actorStats.CharacterId)'>
                                                <span class="rw-collapsible-chevron @(characterExpanded ? "is-open" : "")">›</span>
                                                <span class="rw-collapsible-title">@actorStats.CharacterId</span>
                                            </button>
                                            @if (characterExpanded)
                                            {
                                                <div class="rw-collapsible-body">
                                                    <div class="rw-settings-info-row"><span>Baseline Character Stat Profile</span><span>@baselineProfile</span></div>
                                                    <div class="rw-stat-grid" role="table" aria-label="Baseline and current character stats">
                                                        <div class="rw-stat-grid-header" role="row">
                                                            <span class="rw-stat-cell rw-stat-col-name" role="columnheader">Stat</span>
                                                            <span class="rw-stat-cell rw-stat-col-baseline" role="columnheader">Base</span>
                                                            <span class="rw-stat-cell rw-stat-col-current" role="columnheader">Curr</span>
                                                            <span class="rw-stat-cell rw-stat-col-fit" role="columnheader">Fit</span>
                                                            <span class="rw-stat-cell rw-stat-col-gate" role="columnheader">Gate</span>
                                                        </div>
                                                        @foreach (var statName in AdaptiveStatCatalog.CanonicalStatNames)
                                                        {
                                                            var baselineValue = GetCharacterBaselineStatValue(actorStats.CharacterId, statName);
                                                            var currentValue = GetCharacterStatValue(actorStats, statName);
                                                            var fitIndicator = GetFitRuleIndicator(actorStats.CharacterId, statName, currentValue);
                                                            var gateIndicator = GetGateBlockIndicator(actorStats.CharacterId, statName, currentValue);
                                                            <div class="rw-stat-grid-row" role="row">
                                                                <span class="rw-stat-cell rw-stat-col-name" role="cell">@statName</span>
                                                                <span class="rw-stat-cell rw-stat-col-baseline" role="cell">@baselineValue</span>
                                                                <span class="@GetCharacterStatDeltaClass(currentValue, baselineValue) rw-stat-col-current" role="cell">@currentValue</span>
                                                                <span class="@fitIndicator.CssClass rw-stat-col-fit" title="@fitIndicator.Tooltip" role="cell">@fitIndicator.Label</span>
                                                                <span class="@gateIndicator.CssClass rw-stat-col-gate" title="@gateIndicator.Tooltip" role="cell">@gateIndicator.Label</span>
                                                            </div>
                                                        }
                                                    </div>
                                                    @{
                                                        var charRole = ResolveCharacterRole(actorStats.CharacterId);
                                                    }
                                                    @if (string.Equals(charRole, "Wife", StringComparison.OrdinalIgnoreCase))
                                                    {
                            var willDetail = ComputeWillingnessDetail();
                            var rawDesire = GetCharacterStatValue(actorStats, "Desire");
                            var willingness = willDetail.Score;
                            var verdict = ResolveWillingnessVerdict(willingness);
                            var ceiling = GetWillingnessCeiling(actorStats);
                                                        <div class="rw-stat-prompt-section">
                                                            <div class="rw-stat-prompt-heading">Wife Willingness to Cheat</div>
                                                            <div class="rw-stat-prompt-row">
                                                                <span class="rw-stat-prompt-name">Willingness Score</span>
                                                                <span class="rw-stat-prompt-text">@willingness / 100</span>
                                                            </div>
                                                            <div class="rw-stat-prompt-row">
                                                                <span class="rw-stat-prompt-name">Verdict</span>
                                                                <span class="rw-stat-prompt-text">@verdict — @GetBandText(actorStats)</span>
                                                            </div>
                                                            <div class="rw-stat-prompt-row">
                                                                <span class="rw-stat-prompt-name">Ceiling (what she'll do)</span>
                                                                <span class="rw-stat-prompt-text">@GetCeilingBand(actorStats) — @GetCeilingBandText(actorStats)</span>
                                                            </div>
                                                            <div class="rw-stat-prompt-row">
                                                                <span class="rw-stat-prompt-name">Desire</span>
                                                                <span class="rw-stat-prompt-text">@rawDesire (Ceiling = min(Desire, willingness) = @ceiling)</span>
                                                            </div>
                                                            <div class="rw-stat-prompt-heading" @onclick='() => ToggleAdaptiveSection("mot-"+actorStats.CharacterId)' style="cursor:pointer;display:flex;align-items:center;gap:6px;margin-top:8px;"><span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("mot-"+actorStats.CharacterId)?"is-open":"")">&#8250;</span> Formula Details</div>
                                                            @if (IsAdaptiveSectionExpanded("mot-"+actorStats.CharacterId))
                                                            {
                                                                <div class="rw-stat-prompt-section" style="padding-left:10px;border-left:2px solid #444;margin-top:4px;">
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">Desire</span>
                                                                        <span class="rw-stat-prompt-text">@willDetail.Desire</span>
                                                                    </div>
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">Loyalty</span>
                                                                        <span class="rw-stat-prompt-text">@willDetail.Loyalty</span>
                                                                    </div>
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">SeductionReceptivity</span>
                                                                        <span class="rw-stat-prompt-text">@willDetail.SedRecept</span>
                                                                    </div>
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">BoundaryFirmness</span>
                                                                        <span class="rw-stat-prompt-text">@willDetail.BoundFirm</span>
                                                                    </div>
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">Husband Attentiveness</span>
                                                                        <span class="rw-stat-prompt-text">@willDetail.Att</span>
                                                                    </div>
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">Husband IntimacyAvailability</span>
                                                                        <span class="rw-stat-prompt-text">@willDetail.Intim</span>
                                                                    </div>
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">Formula</span>
                                                                        <span class="rw-stat-prompt-text">50 + (Desire−Loyalty)×@(_scenarioEngineSettings.WillingnessDesireLoyaltyWeight) + (SedRecept−BoundFirm)×@(_scenarioEngineSettings.WillingnessBehaviorWeight) + ((100−Att)+(100−Intim))×@(_scenarioEngineSettings.WillingnessMaritalDeficitWeight) = @willingness</span>
                                                                    </div>
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">Verdict bands</span>
                                                                        <span class="rw-stat-prompt-text">0-@(_scenarioEngineSettings.WillingnessVerdictNoMax) NO, @(_scenarioEngineSettings.WillingnessVerdictNoMax+1)-@(_scenarioEngineSettings.WillingnessVerdictMaybeMax) MAYBE, @(_scenarioEngineSettings.WillingnessVerdictMaybeMax+1)-100 YES</span>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    <div class="rw-stat-prompt-section">
                                                        <div class="rw-stat-prompt-heading" @onclick='() => ToggleAdaptiveSection("sp-"+actorStats.CharacterId)' style="cursor:pointer;display:flex;align-items:center;gap:6px;"><span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("sp-"+actorStats.CharacterId)?"is-open":"")">&#8250;</span> Stat Prompt Texts</div>
                                                        @if (IsAdaptiveSectionExpanded("sp-"+actorStats.CharacterId))
                                                        {
                                                        @foreach (var pStatName in AdaptiveStatCatalog.CanonicalStatNames)
                                                        {
                                                            var pValue = GetCharacterStatValue(actorStats, pStatName);
                                                            var pText = CharacterStatTextCatalog.ResolveText(pStatName, charRole, pValue);
                                                            <div class="rw-stat-prompt-row">
                                                                <span class="rw-stat-prompt-name">@pStatName (@pValue)</span>
                                                                @if (pText is null)
                                                                {
                                                                    <span class="rw-stat-prompt-neutral">no catalog entry for @pStatName/@charRole</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="rw-stat-prompt-text">@pText</span>
                                                                }
                                                            </div>
                                                        }
                                                        }
                                                    </div>
                                                    @{
                                                        var bDims = !string.IsNullOrWhiteSpace(actorStats.CharacterRole)
                                                            ? BehavioralDimensionCatalog.GetDimensions(actorStats.CharacterRole)
                                                            : null;
                                                    }
                                                    @if (bDims is { Count: > 0 })
                                                    {
                                                        <div class="rw-stat-prompt-section">
                                                            <div class="rw-stat-prompt-heading">Behavioral Dimensions (@actorStats.CharacterRole)</div>
                                                            @if (actorStats.RuntimeEncounterStats is not { Count: > 0 })
                                                            {
                                                                <div class="rw-stat-prompt-row rw-stat-prompt-row-neutral">
                                                                    <span class="rw-stat-prompt-neutral">not yet initialized — will seed on first stat mutation</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="rw-stat-grid" role="table" aria-label="Behavioral dimension drift">
                                                                    <div class="rw-stat-grid-header" role="row">
                                                                        <span class="rw-stat-cell rw-stat-col-name" role="columnheader">Dimension</span>
                                                                        <span class="rw-stat-cell rw-stat-col-baseline" role="columnheader">Base</span>
                                                                        <span class="rw-stat-cell rw-stat-col-current" role="columnheader">Curr</span>
                                                                        <span class="rw-stat-cell rw-stat-col-fit" role="columnheader">Δ</span>
                                                                        <span class="rw-stat-cell rw-stat-col-gate" role="columnheader">Tier</span>
                                                                    </div>
                                                                    @foreach (var bDim in bDims)
                                                                    {
                                                                        var bVal = actorStats.RuntimeEncounterStats.TryGetValue(bDim.Name, out var bv) ? bv : 50;
                                                                        var bTier = BehavioralDimensionCatalog.ResolveTierText(actorStats.CharacterRole!, bDim.Name, bVal);
                                                                        var bBase = GetBaselineEncounterDimensionValue(actorStats.CharacterId, bDim.Name);
                                                                        var displayBaseline = bBase ?? 50;
                                                                        <div class="rw-stat-grid-row" role="row">
                                                                            <span class="rw-stat-cell rw-stat-col-name" role="cell">@bDim.Name</span>
                                                                            <span class="rw-stat-cell rw-stat-col-baseline" role="cell">@displayBaseline</span>
                                                                            <span class="@GetCharacterStatDeltaClass(bVal, displayBaseline) rw-stat-col-current" role="cell">@bVal</span>
                                                                            <span class="rw-stat-cell rw-stat-col-fit" role="cell">@FormatCharacterStatDelta(bVal, displayBaseline)</span>
                                                                            <span class="rw-stat-cell rw-stat-col-gate" role="cell" title="@bTier">@(bVal <= 20 ? "B1" : bVal <= 50 ? "B2" : bVal <= 75 ? "B3" : "B4")</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="rw-stat-prompt-section">
                                                            <div class="rw-stat-prompt-heading" @onclick='() => ToggleAdaptiveSection("bd-"+actorStats.CharacterId)' style="cursor:pointer;display:flex;align-items:center;gap:6px;"><span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("bd-"+actorStats.CharacterId)?"is-open":"")">&#8250;</span> Behavioral Prompt Texts</div>
                                                            @if (IsAdaptiveSectionExpanded("bd-"+actorStats.CharacterId))
                                                            {
                                                                @foreach (var bdProm in bDims)
                                                                {
                                                                    var bdVal = actorStats.RuntimeEncounterStats?.TryGetValue(bdProm.Name, out var bdv) == true ? bdv : 50;
                                                                    var bdTier = BehavioralDimensionCatalog.ResolveTierText(actorStats.CharacterRole!, bdProm.Name, bdVal);
                                                                    <div class="rw-stat-prompt-row">
                                                                        <span class="rw-stat-prompt-name">@bdProm.Name (@bdVal)</span>
                                                                        <span class="rw-stat-prompt-text">@bdTier</span>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                    @{
                                                        var charMemory = (_v2State?.EncounterSummaries ?? [])
                                                            .Where(s => string.Equals(s.CharacterId, actorStats.CharacterId, StringComparison.OrdinalIgnoreCase))
                                                            .OrderBy(s => s.OccurredUtc)
                                                            .ToList();
                                                    }
                                                    @if (charMemory.Count > 0)
                                                    {
                                                        <div class="rw-char-memory-section">
                                                            <div class="rw-char-memory-heading" @onclick='() => ToggleAdaptiveSection("cm-"+actorStats.CharacterId)' style="cursor:pointer;display:flex;align-items:center;gap:6px;"><span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("cm-"+actorStats.CharacterId)?"is-open":""))">&#8250;</span> Memory (@charMemory.Count)</div>
                                                            @if (IsAdaptiveSectionExpanded("cm-"+actorStats.CharacterId))
                                                            {
                                                            @foreach (var mem in charMemory)
                                                            {
                                                                <div class="rw-char-memory-entry @(mem.SummaryType == DreamGenClone.Domain.RolePlay.EncounterSummaryType.ArcCompletion ? "rw-char-memory-arc" : (mem.SummaryType == DreamGenClone.Domain.RolePlay.EncounterSummaryType.EncounterCompletion ? "rw-char-memory-encounter" : "rw-char-memory-milestone"))">
                                                                    <div class="rw-char-memory-meta">
                                                                        <span class="rw-char-memory-type">@(mem.SummaryType == DreamGenClone.Domain.RolePlay.EncounterSummaryType.ArcCompletion ? "Arc" : (mem.SummaryType == DreamGenClone.Domain.RolePlay.EncounterSummaryType.EncounterCompletion ? "Encounter" : "Milestone"))</span>
                                                                        <span class="rw-char-memory-arc-label">Arc @(mem.CycleIndex + 1)</span>
                                                                        <span class="rw-char-memory-phases">@mem.FromPhase → @mem.ToPhase</span>
                                                                        @if (mem.IsEnhanced)
                                                                        {
                                                                            <span class="rw-char-memory-enhanced" title="LLM-enhanced prose">✦</span>
                                                                        }
                                                                        <button class="rw-toolbar-btn" title="Memory info" @onclick='() => { _memoryInfoPopupId = mem.Id; _memoryInfoPopupTab = "summary"; }' @onclick:stopPropagation>
                                                                            <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                                                        </button>
                                                                    </div>
                                                                    <div class="rw-char-memory-text">@mem.ActiveSummary</div>
                                                                </div>
                                                            }
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="rw-collapsible-section">
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("advanced")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("advanced") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">Advanced Diagnostics</span>
                        </button>
                        @if (IsAdaptiveSectionExpanded("advanced"))
                        {
                            <div class="rw-collapsible-body">
                                <div class="rw-collapsible-section">
                                    <button type="button" class="rw-collapsible-header" @onclick="ToggleAdaptiveDiagnosticsSection">
                                        <span class="rw-collapsible-chevron @(_adaptiveDiagnosticsExpanded ? "is-open" : "")">›</span>
                                        <span class="rw-collapsible-title">Adaptive Resolution Details</span>
                                    </button>
                                    @if (_adaptiveDiagnosticsExpanded)
                                    {
                                        <div class="rw-collapsible-body">
                                            <div class="rw-settings-info-row"><span>Resolution Reason</span><span>@GetEffectiveStyleReason()</span></div>
                                            <div class="rw-settings-info-row rw-settings-info-row-block"><span>Resolution Explanation</span><span>@GetEffectiveStyleReasonEnglishDetails()</span></div>
                                            <div class="rw-settings-info-row rw-settings-info-row-block"><span>Adaptive Transition Reason</span><span>@GetAdaptiveTransitionReason()</span></div>
                                            <div class="rw-settings-info-row"><span>Adaptive Transition Time</span><span>@GetAdaptiveTransitionTime()</span></div>
                                            <div class="rw-settings-info-row rw-settings-info-row-block"><span>Adaptive Transition Path</span><span>@GetAdaptiveTransitionPath()</span></div>
                                        </div>
                                    }
                                </div>

                                @if (_v2Diagnostics is null)
                                {
                                    <p class="rw-scenario-empty">Diagnostics are not available yet.</p>
                                }
                                else
                                {
                                    <div class="rw-settings-info-row"><span>Correlation</span><span>@_v2Diagnostics.CorrelationId</span></div>
                                    <div class="rw-settings-info-row"><span>Turns</span><span>@_v2Diagnostics.Turns.Count</span></div>
                                    <div class="rw-settings-info-row"><span>Latest Turn</span><span>@LatestTurnSummary</span></div>
                                    <div class="rw-settings-info-row"><span>Candidate Evaluations</span><span>@_v2Diagnostics.CandidateEvaluations.Count</span></div>
                                    <div class="rw-settings-info-row"><span>Transitions</span><span>@_v2Diagnostics.TransitionEvents.Count</span></div>
                                    <div class="rw-settings-info-row"><span>Theme Machine Events</span><span>@_v2Diagnostics.ThemeMachineEvents.Count</span></div>
                                    <div class="rw-settings-info-row"><span>Theme Machine State</span><span>@(_v2Diagnostics.AdaptiveState?.ThemeMachineSnapshot?.CurrentStateCode ?? "(none)")</span></div>
                                    <div class="rw-settings-info-row"><span>Decision Points</span><span>@_v2Diagnostics.DecisionPoints.Count</span></div>
                                    <div class="rw-settings-info-row"><span>Compatibility Errors</span><span>@_v2Diagnostics.CompatibilityErrors.Count</span></div>
                                    <div class="rw-settings-info-row"><span>Semantic Step Succeeded</span><span>@((_v2State?.SemanticStepSucceeded ?? true) ? "Yes" : "No")</span></div>
                                    <div class="rw-settings-info-row"><span>Semantic Event Trace</span><span>@((_v2State?.SemanticEvents.Count ?? 0))</span></div>
                                    @if (_v2State?.SemanticEvents.Count > 0)
                                    {
                                        <div class="rw-settings-info-row rw-settings-info-row-block">
                                            <span>Semantic Events</span>
                                            <span>
                                                @foreach (var semanticEvent in _v2State!.SemanticEvents.TakeLast(5))
                                                {
                                                    <div>@($"{semanticEvent.EventId} conf={semanticEvent.Confidence:0.###} target={string.Join(",", semanticEvent.ThemeTargets)}")</div>
                                                }
                                            </span>
                                        </div>
                                    }
                                    @if (_v2State?.SemanticDeltaBreakdowns.Count > 0)
                                    {
                                        <div class="rw-settings-info-row rw-settings-info-row-block">
                                            <span>Semantic Delta Breakdown (Applied/Capped/Suppressed)</span>
                                            <span>
                                                @foreach (var delta in _v2State!.SemanticDeltaBreakdowns.TakeLast(5))
                                                {
                                                    <div>@($"{delta.ThemeId}: {delta.AppliedDelta:0.###}/{delta.CappedDelta:0.###}/{delta.SuppressedDelta:0.###} reason={delta.SuppressionReasonCode ?? "-"}")</div>
                                                }
                                            </span>
                                        </div>
                                    }
                                    @if ((_v2State?.SemanticEvents.Count ?? 0) == 0)
                                    {
                                        <div class="rw-settings-info-row"><span>Semantic Confidence</span><span>No semantic contribution detected for latest interaction.</span></div>
                                    }

                                    @if (_v2Diagnostics.ThemeMachineEvents.Count > 0)
                                    {
                                        <div class="rw-settings-info-row rw-settings-info-row-block">
                                            <span>Latest Theme Machine Events</span>
                                            <span>
                                                @foreach (var machineEvent in _v2Diagnostics.ThemeMachineEvents.Take(3))
                                                {
                                                    <div>@($"{machineEvent.EventType}: {machineEvent.ReasonCode} ({machineEvent.FromStateCode ?? "-"} -> {machineEvent.ToStateCode ?? "-"})")</div>
                                                }
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="rw-collapsible-section">
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("encounter")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("encounter") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">Encounter Detection</span>
                            @if (_v2State?.IsEncounterActive == true)
                            {
                                <span class="badge text-bg-warning" style="margin-left:auto;">Active</span>
                            }
                        </button>
                        @if (IsAdaptiveSectionExpanded("encounter"))
                        {
                            <div class="rw-collapsible-body">
                                <div class="rw-settings-info-row"><span>Encounter #</span><span>@(_v2State?.CurrentEncounterNumber ?? 0)</span></div>
                                <div class="rw-settings-info-row"><span>Completed</span><span>@(_v2State?.GlobalEncounterCount ?? 0)</span></div>
                                <div class="rw-settings-info-row"><span>Interactions this encounter</span><span>@(_v2State?.TurnsInCurrentEncounter ?? 0)</span></div>
                                <div class="rw-settings-info-row"><span>Active</span><span>@(_v2State?.IsEncounterActive == true ? "Yes" : "No")</span></div>

                                @{
                                    var encStart = _v2State?.LastEncounterStartDetection;
                                    var encBoundary = _v2State?.LastEncounterBoundaryDetection;
                                }
                                @if (encStart is not null)
                                {
                                    <div class="rw-settings-info-row rw-settings-info-row-block">
                                        <span>Last Start Detection</span>
                                        <span>
                                            <div class="rw-enc-det-status @(encStart.Detected ? "is-detected" : encStart.Succeeded ? "" : "is-error")">
                                                @(encStart.Detected ? $"detected, conf {encStart.Confidence:0.##}" : encStart.Succeeded ? "not detected" : "failed")
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(encStart.ErrorMessage))
                                            {
                                                <div class="rw-enc-det-error">@encStart.ErrorMessage</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(encStart.PromptSystem))
                                            {
                                                <button type="button" class="rw-enc-det-link" @onclick='() => { _viewEncDetPrompt = encStart.PromptSystem + "\n\n--- USER ---\n" + encStart.PromptUser; _viewEncDetResponse = encStart.RawResponse; _viewEncDetOpen = true; }' @onclick:stopPropagation>View Prompt / Response</button>
                                            }
                                            <div class="rw-enc-det-time">@encStart.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</div>
                                        </span>
                                    </div>
                                }
                                @if (encBoundary is not null)
                                {
                                    <div class="rw-settings-info-row rw-settings-info-row-block">
                                        <span>Last Boundary Detection</span>
                                        <span>
                                            <div class="rw-enc-det-status @(encBoundary.Detected ? "is-detected" : encBoundary.Succeeded ? "" : "is-error")">
                                                @(encBoundary.Detected ? $"detected, conf {encBoundary.Confidence:0.##}" : encBoundary.Succeeded ? "not detected" : "failed")
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(encBoundary.ErrorMessage))
                                            {
                                                <div class="rw-enc-det-error">@encBoundary.ErrorMessage</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(encBoundary.PromptSystem))
                                            {
                                                <button type="button" class="rw-enc-det-link" @onclick='() => { _viewEncDetPrompt = encBoundary.PromptSystem + "\n\n--- USER ---\n" + encBoundary.PromptUser; _viewEncDetResponse = encBoundary.RawResponse; _viewEncDetOpen = true; }' @onclick:stopPropagation>View Prompt / Response</button>
                                            }
                                            <div class="rw-enc-det-time">@encBoundary.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</div>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (_viewEncDetOpen)
                    {
                        <div class="rw-modal-overlay" @onclick='@(() => _viewEncDetOpen = false)'>
                            <div class="rw-modal rw-steer-prompt-modal" @onclick:stopPropagation>
                                <div class="rw-modal-header">
                                    <span>Encounter Detection Prompt &amp; Response</span>
                                    <button class="rw-modal-close-btn" @onclick='@(() => _viewEncDetOpen = false)'>&times;</button>
                                </div>
                                <div class="rw-modal-body rw-steer-prompt-body">
                                    <div class="rw-steer-prompt-section">
                                        <div class="rw-steer-prompt-section-header">Prompt</div>
                                        <pre class="rw-steer-prompt-text">@_viewEncDetPrompt</pre>
                                    </div>
                                    <div class="rw-steer-prompt-section">
                                        <div class="rw-steer-prompt-section-header">Raw Response</div>
                                        <pre class="rw-steer-prompt-text">@_viewEncDetResponse</pre>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="rw-collapsible-section">
                        @{
                            var qEntry = _tracker.GetEntry(sessionId);
                            var qPromptRunning = qEntry?.Status == RolePlaySubmissionStatus.Running
                                                 || _isAwaitingModelResponse || _isSubmitting;
                            var qSemAnalyzing = _semanticAnalysisByInteractionId.Values.Count(s => s.Status == SemanticAnalysisStatus.Analyzing);
                            var qSemErrors = _semanticAnalysisByInteractionId.Values.Count(s => s.Status == SemanticAnalysisStatus.Error);
                            var qAnyActive = qPromptRunning || qSemAnalyzing > 0;
                        }
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("queues")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("queues") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">Queues</span>
                            @if (qAnyActive)
                            {
                                <span class="badge text-bg-primary" style="margin-left:auto;">Active</span>
                            }
                            @if (qSemErrors > 0)
                            {
                                <span class="badge text-bg-danger" style="@(qAnyActive ? "" : "margin-left:auto;")">@qSemErrors err</span>
                            }
                        </button>
                        @if (IsAdaptiveSectionExpanded("queues"))
                        {
                            <div class="rw-collapsible-body">
                                <div class="rw-settings-info-row"><span><strong>Prompt Submission</strong></span><span></span></div>
                                @if (qEntry is not null)
                                {
                                    <div class="rw-settings-info-row"><span>Status</span><span class="@GetQueueEntryStatusBadgeClass(qEntry.Status)">@qEntry.Status</span></div>
                                    <div class="rw-settings-info-row"><span>Intent</span><span>@qEntry.Payload.Intent</span></div>
                                    <div class="rw-settings-info-row"><span>Started</span><span>@qEntry.StartedUtc.ToString("HH:mm:ss") UTC</span></div>
                                    @if (qEntry.Status == RolePlaySubmissionStatus.Failed && qEntry.FailureMessage is not null)
                                    {
                                        <div class="rw-settings-info-row"><span>Failure</span><span class="rw-fit-score-fail">@qEntry.FailureMessage</span></div>
                                    }
                                }
                                else if (_isAwaitingModelResponse || _isSubmitting)
                                {
                                    <div class="rw-settings-info-row"><span>Status</span><span class="badge text-bg-primary">Running</span></div>
                                    @if (!string.IsNullOrEmpty(_pendingResponseLabel))
                                    {
                                        <div class="rw-settings-info-row"><span>Label</span><span>@_pendingResponseLabel</span></div>
                                    }
                                }
                                else
                                {
                                    <div class="rw-settings-info-row"><span>Status</span><span>Idle</span></div>
                                }

                                <div class="rw-settings-info-row" style="margin-top:8px;"><span><strong>Semantic Analysis</strong></span><span></span></div>
                                @{
                                    var qSemStates = _semanticAnalysisByInteractionId.Values
                                        .OrderBy(s => s.Status == SemanticAnalysisStatus.Analyzing ? 0 :
                                                      s.Status == SemanticAnalysisStatus.Error ? 1 :
                                                      s.Status == SemanticAnalysisStatus.Idle ? 2 : 3)
                                        .ThenByDescending(s => s.UpdatedUtc)
                                        .ToList();
                                }
                                @if (qSemStates.Count == 0)
                                {
                                    <div class="rw-settings-info-row"><span>States</span><span>None loaded</span></div>
                                }
                                else
                                {
                                    <div class="rw-settings-info-row"><span>Summary</span><span>@qSemAnalyzing analyzing · @qSemErrors errors · @qSemStates.Count(s => s.Status == SemanticAnalysisStatus.Complete) complete</span></div>
                                    @foreach (var qState in qSemStates.Take(10))
                                    {
                                        var qRowClickable = qState.Status != SemanticAnalysisStatus.Idle;
                                        <div class="rw-settings-info-row @(qRowClickable ? "rw-queue-sem-row-clickable" : "")"
                                             style="@(qRowClickable ? "cursor:pointer;" : "")"
                                             @onclick="@(() => { if (qState.Status != SemanticAnalysisStatus.Idle) ShowSemanticDetail(qState.InteractionId); })">
                                            <span style="font-size:0.78em;word-break:break-all;">@(qState.InteractionId.Length > 8 ? qState.InteractionId[..8] + "…" : qState.InteractionId)&nbsp;<span style="opacity:0.55;">@(string.IsNullOrEmpty(qState.CharacterId) ? "—" : (qState.CharacterId.Length > 8 ? qState.CharacterId[..8] : qState.CharacterId))</span></span>
                                            <span class="@GetSemanticStatusBadgeClass(qState.Status)">@qState.Status</span>
                                        </div>
                                    }
                                    @if (qSemStates.Count > 10)
                                    {
                                        <div class="rw-adaptive-note">+@(qSemStates.Count - 10) more (showing 10)</div>
                                    }
                                }
                            </div>
                        }
                    </div>

                </div>
            }

            @if (_activeSettingsTab == "autocomplete")
            {
                <div class="rw-settings-content">
                    <div class="rw-settings-section">
                        <div class="rw-settings-section-label">Auto-Complete</div>
                        <p class="text-muted small mb-2">Runs default continuations in a loop until max turns or all themes complete.</p>

                        @if (_autoCompleteState?.Status == AutoCompleteStatus.Running)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small">Turn @_autoCompleteState.CurrentTurn / @_autoCompleteState.MaxTurns</span>
                                    <span class="small">@_autoCompleteState.CurrentActivity</span>
                                </div>
                                <div class="progress" style="height:6px">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width:@((int)((double)_autoCompleteState.CurrentTurn / _autoCompleteState.MaxTurns * 100))%"></div>
                                </div>
                                <div class="small text-muted mt-1">Themes: @_autoCompleteState.ThemesCompleted / @_autoCompleteState.TotalThemes</div>
                            </div>
                            <button class="btn btn-sm btn-outline-danger" @onclick="CancelAutoComplete">Cancel</button>
                        }
                        else if (_autoCompleteState?.Status == AutoCompleteStatus.Completed)
                        {
                            <div class="alert alert-success small mb-2">
                                <strong>Done</strong>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _autoCompleteState = null)">Clear</button>
                        }
                        else if (_autoCompleteState?.Status == AutoCompleteStatus.Cancelled)
                        {
                            <div class="alert alert-warning small mb-2">
                                <strong>Cancelled</strong> after @_autoCompleteState.CurrentTurn turns.
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _autoCompleteState = null)">Clear</button>
                        }
                        else
                        {
                            <div class="row g-2 align-items-end">
                                <div class="col-auto">
                                    <label class="form-label small">Max Turns</label>
                                    <input type="number" class="form-control form-control-sm" style="width:100px" min="1" step="1" @bind="_autoCompleteMaxTurns" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-sm btn-primary" @onclick="@(() => StartAutoCompleteAsync(_autoCompleteMaxTurns))" disabled="@(_autoCompleteRunning)">
                                        Start Auto-Complete
                                    </button>
                                </div>
                            </div>
                        }

                        @if (_autoCompleteState?.RecentLog.Count > 0)
                        {
                            <div class="mt-3">
                                <div class="rw-settings-section-label">Log</div>
                                <pre class="small text-muted mb-0" style="max-height:200px;overflow-y:auto;white-space:pre-wrap;font-size:11px">@string.Join("\n", _autoCompleteState.RecentLog)</pre>
                            </div>
                        }
                    </div>
                </div>
            }
        }

    </div>

</div>

@code {
    private sealed record MenuRect(double Top, double Left, double Bottom, double Right, double Width, double Height);
    private sealed record PhaseGateRow(string Label, string Status, string Details);
    private sealed record AdaptiveSelectionGateSnapshot(bool StageAOpen, double Desire, string GapSummary);
    private sealed record AdaptiveThemeStatusRow(
        string ThemeId,
        string ThemeName,
        double Score,
        string Intensity,
        bool IsActive,
        bool IsBlocked,
        string Status,
        string NextStep,
        double ChoiceSignal,
        double CharacterStateSignal,
        double InteractionEvidenceSignal,
        double ScenarioPhaseSignal,
        decimal? FitScore,
        decimal? UnpenalizedFitScore,
        decimal FitScorePenalty,
        decimal? CharAlignScore,
        decimal? NarrEvidScore,
        decimal? PrefPriorityScore,
        bool? StageBEligible,
        decimal? SuccessorCausalityBoost,
        string? GateDetailsJson);
    private sealed record PhaseProgressInfo(string NextPhase, int ProgressPercent, string Details);
    private sealed record PhaseLadderItem(string Label, string BadgeClass);
    private sealed record PhaseGateThresholds(double ScoreMin, double DesireMin, double RestraintMax, int InteractionsMin, string Source);

    // Semantic detail modal deserialization
    private sealed class SemanticDetailView
    {
        public string ActorName { get; set; } = string.Empty;
        public DateTime CompletedUtc { get; set; }
        public int InferredEventCount { get; set; }
        public int ContextTurnsCount { get; set; }
        public string? PromptSystem { get; set; }
        public string? PromptUser { get; set; }
        public string? InferenceRawOutput { get; set; }
        public List<SemanticDetailEvent> InferredEvents { get; set; } = [];
    }

    private sealed class SemanticDetailEvent
    {
        public string EventId { get; set; } = string.Empty;
        public decimal Confidence { get; set; }
        public string? ActorName { get; set; }
        public string? TargetCharacterName { get; set; }
        public string? EvidenceSpan { get; set; }
    }

    private sealed class SemanticEventStatRow
    {
        public string EventId { get; set; } = string.Empty;
        public decimal Confidence { get; set; }
        public string? ActorName { get; set; }
        public string? TargetCharacterName { get; set; }
        public string? EvidenceSpan { get; set; }
        public string TargetStat { get; set; } = string.Empty;
        public decimal Delta { get; set; }
        public bool IsFirstOfEvent { get; set; }
    }

    private static readonly System.Text.Json.JsonSerializerOptions _semanticDetailJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private SemanticDetailView? TryParseSemanticDetail(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<SemanticDetailView>(json, _semanticDetailJsonOptions);
        }
        catch
        {
            return null;
        }
    }

    private static CandidateGateDetails? ParseCandidateGateDetails(ScenarioCandidateEvaluation candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate.DetailsJson))
        {
            return null;
        }

        try
        {
            var details = JsonSerializer.Deserialize<CandidateDetailsEnvelope>(candidate.DetailsJson, CandidateDetailsJsonOptions);
            return details?.Gate;
        }
        catch
        {
            return null;
        }
    }

    private static CandidateDetailsEnvelope? ParseFullCandidateDetails(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            return JsonSerializer.Deserialize<CandidateDetailsEnvelope>(json, CandidateDetailsJsonOptions);
        }
        catch
        {
            return null;
        }
    }

    private static string FormatCandidateRoleScores(ScenarioCandidateEvaluation candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate.DetailsJson))
        {
            return string.Empty;
        }

        try
        {
            var details = JsonSerializer.Deserialize<CandidateDetailsEnvelope>(candidate.DetailsJson, CandidateDetailsJsonOptions);
            var scores = details?.FitResult?.RoleScores;
            if (scores is null || scores.Count == 0)
            {
                return string.Empty;
            }

            return string.Join(", ", scores
                .OrderByDescending(x => x.Value)
                .ThenBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
                .Select(x => $"{x.Key}={x.Value:0.###}"));
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string FormatTopCandidateClauseSummary(ScenarioCandidateEvaluation candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate.DetailsJson))
        {
            return string.Empty;
        }

        try
        {
            var details = JsonSerializer.Deserialize<CandidateDetailsEnvelope>(candidate.DetailsJson, CandidateDetailsJsonOptions);
            var scores = details?.FitResult?.RoleScores;
            var clauses = details?.FitResult?.ClauseEvaluations;
            if (scores is null || scores.Count == 0 || clauses is null || clauses.Count == 0)
            {
                return string.Empty;
            }

            var topRole = scores
                .OrderByDescending(x => x.Value)
                .ThenBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
                .FirstOrDefault().Key;
            if (string.IsNullOrWhiteSpace(topRole) || !clauses.TryGetValue(topRole, out var roleClauses) || roleClauses.Count == 0)
            {
                return string.Empty;
            }

            return $"{topRole}: {string.Join(" | ", roleClauses.Take(4))}";
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string FormatCandidateTieSetSummary(IReadOnlyList<ScenarioCandidateEvaluation> evaluations)
    {
        if (evaluations.Count < 2)
        {
            return string.Empty;
        }

        var ordered = evaluations
            .OrderByDescending(x => x.FitScore)
            .ThenByDescending(x => x.Confidence)
            .ThenBy(x => x.TieBreakKey, StringComparer.Ordinal)
            .ToList();

        var leader = ordered[0];
        var tieSet = ordered
            .Where(x => leader.FitScore - x.FitScore <= CandidateTieDeltaThreshold)
            .ToList();

        if (tieSet.Count <= 1)
        {
            return string.Empty;
        }

        var leadDelta = leader.FitScore - tieSet[1].FitScore;
        var members = string.Join(", ", tieSet.Select(x => $"{x.ScenarioId}:{x.FitScore:0.###}"));
        return $"delta={leadDelta:0.###}, threshold={CandidateTieDeltaThreshold:0.###}, members=[{members}]";
    }

    private static readonly JsonSerializerOptions CandidateDetailsJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private const decimal CandidateTieDeltaThreshold = 0.8m;

    private sealed class CandidateDetailsEnvelope
    {
        public CandidateGateDetails? Gate { get; set; }

        public CandidateFitResultDetails? FitResult { get; set; }
    }

    private sealed class CandidateGateDetails
    {
        public bool Passed { get; set; }

        public string Strategy { get; set; } = string.Empty;

        public string Reason { get; set; } = string.Empty;
    }

    private sealed class CandidateFitResultDetails
    {
        public Dictionary<string, double> RoleScores { get; set; } = new(StringComparer.OrdinalIgnoreCase);

        public Dictionary<string, List<string>> ClauseEvaluations { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }
}
