    private async Task AppendThemeReferenceContextAsync(StringBuilder sb, string phase)
    {
        if (_session is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_v2State?.CurrentSceneLocation))
        {
            sb.AppendLine($"Current scene location: {_v2State!.CurrentSceneLocation}.");
            sb.AppendLine("Keep surroundings and movement plausible for this location. Do not teleport characters or jump locations without transition beats.");
        }

        var recentNarrativeInteractions = _session.Interactions
            .Where(x => !string.Equals(x.ActorName, "Instruction", StringComparison.OrdinalIgnoreCase))
            .TakeLast(2)
            .ToList();
        if (recentNarrativeInteractions.Count > 0)
        {
            sb.AppendLine("Recent scene context (ground all options strictly in this continuity → do not introduce places, objects, or characters not already present here):");
            foreach (var recentInteraction in recentNarrativeInteractions)
            {
                var snippet = string.IsNullOrWhiteSpace(recentInteraction.Content)
                    ? string.Empty
                    : recentInteraction.Content.Length > 300
                        ? recentInteraction.Content[..300].TrimEnd() + "\u2026"
                        : recentInteraction.Content.TrimEnd();
                if (!string.IsNullOrWhiteSpace(snippet))
                {
                    sb.AppendLine($"- [{recentInteraction.ActorName}]: {snippet}");
                }
            }
        }

        var activeScenarioId = _v2State?.ActiveScenarioId;
        RPTheme? activeTheme = null;
        if (!string.IsNullOrWhiteSpace(activeScenarioId))
        {
            try
            {
                activeTheme = await RPThemeService.GetThemeAsync(activeScenarioId);
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Unable to load active RP theme for steer options in session {SessionId}.", _session.Id);
            }
        }

        if (activeTheme is not null)
        {
            var themeLabel = string.IsNullOrWhiteSpace(activeTheme.Label) ? activeTheme.Id : activeTheme.Label;
            sb.AppendLine($"Active theme: {themeLabel} ({activeTheme.Id}).");
            if (!string.IsNullOrWhiteSpace(activeTheme.Description))
            {
                sb.AppendLine($"Theme description: {activeTheme.Description.Trim()}");
            }

            var phaseGuidance = DreamGenClone.Web.Application.RolePlay.RolePlayAssistantPrompts.GetThemePhaseGuidanceLines(activeTheme, phase);
            if (phaseGuidance.Count > 0)
            {
                sb.AppendLine($"Theme phase guidance for {phase}:");
                foreach (var line in phaseGuidance)
                {
                    sb.AppendLine($"- {line}");
                }
            }

            var guidanceNotes = DreamGenClone.Web.Application.RolePlay.RolePlayAssistantPrompts.GetPhaseRelevantThemeAIGuidanceNotes(
                activeTheme,
                phase,
                maxNotes: Math.Clamp(_session.MaxThemeAIGuidanceNotes, 1, 30),
                includeFormulaNotes: false);
            if (guidanceNotes.Count > 0)
            {
                sb.AppendLine("Relevant theme AI guidance notes for this phase:");
                foreach (var note in guidanceNotes)
                {
                    sb.AppendLine($"- [{note.Section}] {note.Text.Trim()}");
                }
            }

            sb.AppendLine("Every option must clearly align with the active theme and this phase guidance.");
        }
        else
        {
            var availableThemes = (_v2State?.ThemeScores.Values ?? (IEnumerable<V2RolePlay.ThemeScoreState>)[])
                .Where(x => !x.Blocked)
                .OrderByDescending(x => x.Score)
                .Take(4)
                .ToList();

            if (availableThemes.Count > 0)
            {
                sb.AppendLine("No active theme is locked. Guide options toward one of these available high-fit themes:");
                foreach (var theme in availableThemes)
                {
                    var name = string.IsNullOrWhiteSpace(theme.ThemeName) ? theme.ThemeId : theme.ThemeName;
                    sb.AppendLine($"- {name} ({theme.ThemeId}), score={theme.Score:F1}, intensity={theme.Intensity}");
                }
                sb.AppendLine("Each option should naturally increase coherence with one listed theme without abrupt or implausible pivots.");
            }
            else
            {
                sb.AppendLine("No strong theme signals are available. Keep options phase-appropriate and grounded in current context.");
            }
        }
    }

    private async Task ApplySteerOptionAsync()
    {
        if (_session is null
            || string.IsNullOrWhiteSpace(_selectedSteerOption)
            || !IsSteerEligible
            || IsSteerUiLocked)
        {
            return;
        }

        var selectedOption = _selectedSteerOption.Trim();

        if (_steerUseGuidedFlow)
        {
            // Position flow: keep existing behaviour — load into prompt box.
            var positionInstruction = BuildSteerPositionInstructionSnippet();
            if (string.IsNullOrWhiteSpace(positionInstruction))
            {
                positionInstruction = "State an explicit physical position and orientation in the steer instruction.";
            }
            selectedOption = $"{selectedOption} [Position instruction: {positionInstruction}]";
            _steerPopupOpen = false;
            _steerOptionError = string.Empty;
            _selectedIntent = PromptIntent.Instruction;
            _promptText = selectedOption;
            _steerOptionPages.Clear();
            _steerPageIndex = 0;
            _selectedSteerOption = string.Empty;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // ── B-075: Direction flow — stage as per-character steering directive ──
        var cardIndex = CurrentSteerPage.IndexOf(_selectedSteerOption);
        var direction = cardIndex switch
        {
            0 => V2RolePlay.SteerDirection.Away,
            1 => V2RolePlay.SteerDirection.Neutral,
            2 => V2RolePlay.SteerDirection.Towards,
            3 => V2RolePlay.SteerDirection.Hard,
            _ => V2RolePlay.SteerDirection.Neutral
        };

        // Resolve target character.
        var targetLabel = _steerTargetCharacterLabel;
        var targetId = _steerTargetCharacterId;
        if (string.IsNullOrWhiteSpace(targetLabel) && SteerableTargets.Count > 0)
        {
            targetId = SteerableTargets[0].CharacterId;
            targetLabel = SteerableTargets[0].CharacterName;
        }

        var targetRole = ResolveTargetRole(targetLabel);

        // Validate target character exists in session stats.
        if (string.IsNullOrWhiteSpace(targetId)
            || !_session.AdaptiveState.CharacterStats.Any(kvp =>
                string.Equals(kvp.Key, targetLabel, StringComparison.OrdinalIgnoreCase)
                || string.Equals(kvp.Value.CharacterId, targetId, StringComparison.OrdinalIgnoreCase)))
        {
            _steerOptionError = $"Target character '{targetLabel ?? targetId}' is not in the session's character stats.";
            return;
        }

        var directive = new RolePlaySteeringDirective
        {
            TargetCharacterId = targetId,
            TargetCharacterLabel = targetLabel,
            TargetCharacterRole = targetRole,
            Direction = direction,
            FreeTextDirective = selectedOption
        };

        var metadataJson = JsonSerializer.Serialize(directive);

        // Submit as a staged instruction via the + path.
        _isSubmitting = true;
        try
        {
            var submission = new UnifiedPromptSubmission
            {
                SessionId = _session.Id,
                PromptText = selectedOption,
                Intent = PromptIntent.Instruction,
                SelectedIdentityId = string.Empty,
                SelectedIdentityType = IdentityOptionSource.Persona,
                BehaviorModeAtSubmit = _selectedBehaviorMode,
                SubmittedVia = SubmissionSource.PlusButton
            };

            await RolePlayEngine.SubmitPromptAsync(submission);

            // Set steering metadata on the newly created interaction.
            // The interaction was added at the end of session.Interactions.
            var stagedInteraction = _session.Interactions.LastOrDefault();
            if (stagedInteraction is not null)
            {
                stagedInteraction.SteeringMetadataJson = metadataJson;
                stagedInteraction.SteeringGenerationId = _cachedSteerGenerationId;
            }

            // Update the generation record with the selected directive summary.
            if (!string.IsNullOrWhiteSpace(_cachedSteerGenerationId))
            {
                try
                {
                    var genRecord = await Persistence.LoadSteeringGenerationRecordAsync(_cachedSteerGenerationId);
                    if (genRecord is not null)
                    {
                        genRecord.SelectedDirectiveSummary = $"{targetLabel} | {direction} | {selectedOption}";
                        genRecord.StagedInteractionId = stagedInteraction?.Id;
                        genRecord.UpdatedUtc = DateTime.UtcNow;
                        await Persistence.SaveSteeringGenerationRecordAsync(genRecord);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to update steering generation record {Id}", _cachedSteerGenerationId);
                }
            }

            await LoadSessionAsync();
        }
        catch (Exception ex)
        {
            _steerOptionError = ex.Message;
            Logger.LogError(ex, "Failed submitting steer directive for session {SessionId}", _session.Id);
        }
        finally
        {
            _isSubmitting = false;
        }

        _steerPopupOpen = false;
        _steerOptionError = string.Empty;
        _steerOptionPages.Clear();
        _steerPageIndex = 0;
        _selectedSteerOption = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

