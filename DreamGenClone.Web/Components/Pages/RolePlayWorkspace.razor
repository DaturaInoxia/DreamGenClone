    private string GetBandText(CharacterStatProfileV2 profile)
    {
        // B-034: verdict band text from WillingnessVerdictBands (NO/MAYBE/YES).
        var verdict = GetResBand(profile);
        return verdict switch
        {
            "YES" => "Yes — willing to cross. Desire caps how far (see Ceiling).",
            "MAYBE" => "Maybe — tempted but unresolved; leans on the ceiling for how far.",
            _ => "No — holds the line; not willing to cheat under current state."
        };
    }

    private (WillingnessThreshold? Threshold, string Level) ResolveCeilingThreshold(CharacterStatProfileV2 profile)
    {
        var selectedId = _session?.AdaptiveState?.SelectedWillingnessProfileId;
        StatWillingnessProfile? willingnessProfile;
        if (string.IsNullOrWhiteSpace(selectedId))
        {
            willingnessProfile = _willingnessProfiles.FirstOrDefault(p => p.IsDefault);
        }
        else
        {
            willingnessProfile = _willingnessProfiles.FirstOrDefault(x => string.Equals(x.Id, selectedId, StringComparison.OrdinalIgnoreCase));
        }
        if (willingnessProfile is null) return (null, "-");

        var ceiling = GetWillingnessCeiling(profile);
        var threshold = willingnessProfile.Thresholds
            .Where(t => ceiling >= t.MinValue && ceiling <= t.MaxValue)
            .OrderBy(t => t.SortOrder)
            .FirstOrDefault();
        return (threshold, threshold?.ExplicitnessLevel ?? "-");
    }

    private string GetCeilingBand(CharacterStatProfileV2 profile)
    {
        var (_, level) = ResolveCeilingThreshold(profile);
        return level;
    }

    private string GetCeilingBandText(CharacterStatProfileV2 profile)
    {
        var (threshold, _) = ResolveCeilingThreshold(profile);
        return threshold?.PromptGuideline ?? "-";
    }

