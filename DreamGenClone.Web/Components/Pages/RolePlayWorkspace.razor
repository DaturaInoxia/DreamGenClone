    private Task OnRolePlayResponseChunkAsync(string chunk)
    {
        if (string.IsNullOrEmpty(chunk) || _isDisposed)
        {
            return Task.CompletedTask;
        }

        _pendingResponseBuilder.Append(chunk);

        var now = DateTime.UtcNow;
        if (now - _lastPendingResponseRenderAt < PendingResponseRenderInterval)
        {
            return Task.CompletedTask;
        }

        _lastPendingResponseRenderAt = now;
        _pendingResponseText = _pendingResponseBuilder.ToString();

        // Route the streaming text update to the isolated child component. The child schedules
        // its own render via fire-and-forget InvokeAsync(StateHasChanged), so the workspace
        // component (and the adaptive panel inside it) is NOT re-rendered per chunk. This keeps
        // the Blazor circuit dispatcher free to process other UI events (panel navigation,
        // scrolling, button clicks) while the continuation is generating.
        _pendingResponseComponent?.SetText(_pendingResponseText);
        return Task.CompletedTask;
    }

    // B-087: Called by the engine on a thread-pool thread BEFORE each actor's generation begins.
    // Resets the streaming buffer + pending bubble for the next actor and updates the progress
    // label. Marshals to the Blazor sync context so SetText/SetActorName run on the circuit.
    private Task OnRolePlayActorStart(int positionInTurn, string actorName, int turnActorCount)
    {
        if (_isDisposed)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            // Reset the streaming buffer so the next actor's chunks do not concatenate with
            // the previous actor's text.
            _pendingResponseBuilder.Clear();
            _pendingResponseText = string.Empty;
            _lastPendingResponseRenderAt = DateTime.MinValue;

            var isNarrative = string.Equals(actorName, "Narrative", StringComparison.OrdinalIgnoreCase);
            _pendingResponseLabel = isNarrative
                ? "Waiting for narrative continuation..."
                : $"Generating {actorName} ({positionInTurn} of {turnActorCount})...";

            _pendingResponseComponent?.Clear();
            _pendingResponseComponent?.SetActorName(isNarrative ? "Narrative" : actorName);
            _pendingResponseComponent?.SetLabel(_pendingResponseLabel);
        });
    }

    // B-087: Called by the engine on a thread-pool thread AFTER each interaction is finalized
    // and appended to session.Interactions in-memory. Appends it to the displayed session and
    // re-renders the parent so the committed row appears immediately. On the first new
    // interaction of the turn, applies the B-010 read-cursor pin (scroll-to-cursor when the
    // user was NOT at the bottom; follow-to-bottom when at the bottom).
    private async Task OnRolePlayInteractionCompletedAsync(
        RolePlayInteraction interaction,
        int positionInTurn,
        int turnActorCount,
        bool isNarrative)
    {
        if (_isDisposed || _session is null || interaction is null)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            // Avoid double-appending if the interaction is already present (e.g. a re-entrant
            // callback after a LoadSessionAsync reload already picked it up from the DB).
            if (!_session.Interactions.Any(i => string.Equals(i.Id, interaction.Id, StringComparison.OrdinalIgnoreCase)))
            {
                _session.Interactions.Add(interaction);
            }

            // B-010 read-cursor pin on the first new interaction of the turn.
            if (_newInteractionCountThisTurn == 0)
            {
                _newInteractionCountThisTurn++;
                var displayIndex = GetDisplayInteractions().Count - 1;
                if (displayIndex >= 0)
                {
                    var wasAtBottom = await JS.InvokeAsync<bool>("rolePlayWorkspace.isStoryNearBottom", 80);
                    if (wasAtBottom)
                    {
                        await JS.InvokeVoidAsync("rolePlayWorkspace.scrollStoryToBottom");
                    }
                    else
                    {
                        _readCursorInteractionIndex = displayIndex;
                        await JS.InvokeVoidAsync("rolePlayWorkspace.scrollToCursor");
                    }
                }
            }
            else
            {
                _newInteractionCountThisTurn++;
            }

            // Clear the pending bubble text for this actor (the committed row now shows the
            // content). The next onActorStart will reset the label/actor name.
            _pendingResponseBuilder.Clear();
            _pendingResponseText = string.Empty;
            _pendingResponseComponent?.Clear();

            StateHasChanged();
        });
    }

