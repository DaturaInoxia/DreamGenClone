    private async Task RefreshEffectiveContinuationSettingsAsync()
    {
        if (_session is null)
        {
            return;
        }

        var phase = (_v2State?.CurrentPhase ?? _session.AdaptiveState.CurrentPhase).ToString();
        var themeId = !string.IsNullOrWhiteSpace(_v2State?.ActiveScenarioId)
            ? _v2State!.ActiveScenarioId
            : _v2State?.PrimaryThemeId;

        DreamGenClone.Domain.RolePlay.RPTheme? theme = null;
        if (!string.IsNullOrWhiteSpace(themeId))
        {
            try { theme = await RPThemeService.GetThemeAsync(themeId); }
            catch (Exception ex) { Logger.LogDebug(ex, "RefreshEffectiveContinuationSettings: could not load theme {ThemeId}", themeId); }
        }

        _effectiveSceneDirection = SceneDirectionResolver.Resolve(phase, theme, DreamGenClone.Domain.RolePlay.ClimaxSubPhase.None, PromptIntent.Message);
        _effectiveMultiEncounter = theme is not null && DreamGenClone.Web.Application.RolePlay.RolePlayAssistantPrompts.IsMultiEncounterClimax(theme, "Climax");
        _effectiveAftermath = theme is not null && DreamGenClone.Web.Application.RolePlay.RolePlayAssistantPrompts.IsAftermathHusbandContrast(theme, phase);

        var marker = DreamGenClone.Web.Application.RolePlay.RolePlayAssistantPrompts.GetWordTargetMarker(theme, phase) ?? "small";
        var preset = ContinuationMarkerCatalog.WordCountPresets
            .FirstOrDefault(p => string.Equals(p.Key, marker, StringComparison.OrdinalIgnoreCase));
        if (preset == default)
        {
            preset = ContinuationMarkerCatalog.WordCountPresets[0];
        }
        _effectiveWordMin = preset.Min;
        _effectiveWordMax = preset.Max;
    }

