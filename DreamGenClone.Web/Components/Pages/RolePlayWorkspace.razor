    private AdaptiveSelectionGateSnapshot BuildAdaptiveSelectionGateSnapshot(AdaptiveScenarioState state)
    {
        var desire = GetAverageAdaptiveStat(state, "Desire");
        var stageALowDesireMin = _scenarioEngineSettings.StageALowDesireMin;
        var stageAOpen = desire >= stageALowDesireMin;

        var gapParts = new List<string>();
        if (!stageAOpen)
        {
            gapParts.Add($"Need +{Math.Max(0, stageALowDesireMin - desire):0.0} Desire (target {stageALowDesireMin:0.##})");
        }

        return new AdaptiveSelectionGateSnapshot(
            StageAOpen: stageAOpen,
            Desire: desire,
            GapSummary: gapParts.Count == 0 ? "No gate gaps. Selection gate is open." : string.Join("; ", gapParts));
    }

    private IReadOnlyList<AdaptiveThemeStatusRow> GetAdaptiveThemeStatusRows()
    {
        if (_session is null)
        {
            return [];
        }

        // Prefer _v2State (loaded directly from RolePlayV2ThemeScores) because it carries
        // accumulated InteractionEvidenceSignal from async background semantic jobs.
        // _session.AdaptiveState comes from PayloadJson which only reflects the last
        // foreground-pipeline save and has IES=0 until the next foreground turn propagates
        // the V2 values back via HydrateV2State → SyncSessionAdaptiveStateFromV2.
        var state = (_v2State is not null && _v2State.ThemeScores.Count > 0)
            ? _v2State
            : _session.AdaptiveState;
        var gateSnapshot = BuildAdaptiveSelectionGateSnapshot(state);
        var activeThemeId = string.IsNullOrWhiteSpace(state.ActiveScenarioId)
            ? state.PrimaryThemeId
            : state.ActiveScenarioId;

var evalsByTheme = _v2Diagnostics?.CandidateEvaluations
        .GroupBy(x => x.ScenarioId, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(
            g => g.Key,
            g => g.OrderByDescending(x => x.EvaluatedUtc).First(),
            StringComparer.OrdinalIgnoreCase)
        ?? new Dictionary<string, DreamGenClone.Domain.RolePlay.ScenarioCandidateEvaluation>(StringComparer.OrdinalIgnoreCase);

    var highestFitScore = evalsByTheme.Count > 0
        ? evalsByTheme.Values.Select(e => e.FitScore).Max()
        : 0m;

    return state.ThemeScores.Values
        .OrderByDescending(x => x.Score)
        .ThenBy(x => x.ThemeName, StringComparer.OrdinalIgnoreCase)
        .Select(theme =>
        {
            evalsByTheme.TryGetValue(theme.ThemeId, out var eval);
            var isActive = !string.IsNullOrWhiteSpace(activeThemeId)
                && string.Equals(theme.ThemeId, activeThemeId, StringComparison.OrdinalIgnoreCase);
            var fitScoreGap = Math.Max(0m, highestFitScore - (eval?.FitScore ?? 0m));
            var status = theme.Blocked
                ? "Blocked"
                : isActive
                    ? "Active"
                    : fitScoreGap <= 0.05m
                        ? "Ready"
                        : "Candidate";

            var nextStep = theme.Blocked
                ? "Theme is blocked by profile/dealbreaker rules and cannot become active until unblocked."
                : !gateSnapshot.StageAOpen
                    ? gateSnapshot.GapSummary
                    : isActive
                        ? "Currently active. Keep gate values healthy to retain momentum."
                        : eval?.StageBEligible == false
                            ? "Fit gate not met — satisfy fit rules (character/narrative fit clauses) to become eligible for selection."
                            : fitScoreGap <= 0.05m
                                ? "Eligible now. This theme can become active on the next selection cycle."
                                : $"Need +{fitScoreGap:0.0} FitScore to overtake the current top candidate.";

            return new AdaptiveThemeStatusRow(
                ThemeId: theme.ThemeId,
                ThemeName: string.IsNullOrWhiteSpace(theme.ThemeName) ? theme.ThemeId : theme.ThemeName,
                Score: theme.Score,
                Intensity: string.IsNullOrWhiteSpace(theme.Intensity) ? "(none)" : theme.Intensity,
                IsActive: isActive,
                IsBlocked: theme.Blocked,
                Status: status,
                NextStep: nextStep,
                ChoiceSignal: theme.Breakdown.ChoiceSignal,
                CharacterStateSignal: theme.Breakdown.CharacterStateSignal,
                InteractionEvidenceSignal: theme.Breakdown.InteractionEvidenceSignal,
                ScenarioPhaseSignal: theme.Breakdown.ScenarioPhaseSignal,
                FitScore: eval is not null ? eval.FitScore : (decimal?)null,
                UnpenalizedFitScore: eval is not null ? eval.UnpenalizedFitScore : (decimal?)null,
                FitScorePenalty: eval is not null ? Math.Max(0m, eval.UnpenalizedFitScore - eval.FitScore) : 0m,
                CharAlignScore: eval?.CharacterAlignmentScore,
                NarrEvidScore: eval?.NarrativeEvidenceScore,
                PrefPriorityScore: eval?.PreferencePriorityScore,
                StageBEligible: eval?.StageBEligible,
                SuccessorCausalityBoost: eval is not null && eval.SuccessorCausalityBoost > 0m ? eval.SuccessorCausalityBoost : (decimal?)null,
                GateDetailsJson: eval?.DetailsJson);
            })
            .ToList();
    }

