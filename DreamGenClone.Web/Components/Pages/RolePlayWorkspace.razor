    private async Task ApplyFinishOptionAsync()
    {
        if (_session is null || string.IsNullOrWhiteSpace(_selectedFinishOption) || IsFinishUiLocked)
        {
            return;
        }

        // Load the command text into the prompt input so the user can review, edit,
        // and submit it manually with Continue rather than executing immediately.
        var directive = _selectedFinishOption.Trim();
        var promptText = _finishEndClimax
            ? $"/completeclimax {directive}"
            : (_finishUseGuidedFlow ? directive : BuildThirdPersonWriteInstruction(directive));

        _finishPopupOpen = false;
        _finishOptionError = string.Empty;
        _selectedIntent = PromptIntent.Instruction;
        _promptText = promptText;
        _finishOptionPages.Clear();
        _finishPageIndex = 0;
        _finishGenerationIndex = 0;
        _selectedFinishOption = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private string BuildThirdPersonWriteInstruction(string directive)
    {
        var names = new List<string>();
        if (_session is not null)
        {
            if (!string.IsNullOrWhiteSpace(_session.PersonaName)
                && !string.Equals(_session.PersonaName, "You", StringComparison.OrdinalIgnoreCase))
            {
                names.Add(_session.PersonaName);
            }
            names.AddRange(
                _session.CharacterPerspectives
                    .Where(x => !string.IsNullOrWhiteSpace(x.CharacterName))
                    .Select(x => x.CharacterName));
        }
        var nameHint = names.Count > 0 ? $" ({string.Join(", ", names)})" : string.Empty;
        return $"[Write as third-person narrative{nameHint}] {directive}";
    }

    private static IReadOnlyList<string> ParseFinishOptions(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return [];
        }

        static List<string> NormalizeOptions(IEnumerable<string> options)
            => options
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x.Trim('"'))
                .Select(x => x.Trim())
                .Where(IsLikelyGeneratedOptionLine)
                .Where(x => x.Length > 4)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(5)
                .ToList();

        try
        {
            var direct = JsonSerializer.Deserialize<List<string>>(raw);
            if (direct is { Count: > 0 })
            {
                return NormalizeOptions(direct);
            }
        }
        catch
        {
            // Fall through to best-effort parsing.
        }

        var start = raw.IndexOf('[');
        var end = raw.LastIndexOf(']');
        if (start >= 0 && end > start)
        {
            var slice = raw[start..(end + 1)];
            try
            {
                var extracted = JsonSerializer.Deserialize<List<string>>(slice);
                if (extracted is { Count: > 0 })
                {
                    return NormalizeOptions(extracted);
                }
            }
            catch
            {
                // Fall through to line parsing.
            }
        }

        var lines = raw.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line => line.TrimStart('-', '*', ' ', '\t'))
            .Select(line => Regex.Replace(line, "^\\d+[\\.)]\\s*", string.Empty))
            .ToList();
        return NormalizeOptions(lines);

        static bool IsLikelyGeneratedOptionLine(string text)
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return false;
            }

            var value = text.Trim();
            var lower = value.ToLowerInvariant();
            var wordCount = Regex.Matches(value, "[A-Za-z0-9']+").Count;
            if (value.StartsWith("[", StringComparison.Ordinal)
                || value.StartsWith("{", StringComparison.Ordinal)
                || value.StartsWith("```", StringComparison.Ordinal)
                || value.StartsWith("**", StringComparison.Ordinal)
                || value.EndsWith(":", StringComparison.Ordinal)
                || value.Length > 260
                || wordCount < 4
                || wordCount > 48
                || value.Contains("Return ONLY a JSON array", StringComparison.OrdinalIgnoreCase)
                || value.Contains("Generate exactly", StringComparison.OrdinalIgnoreCase)
                || value.Contains("Use standard", StringComparison.OrdinalIgnoreCase)
                || value.Contains("Current stats for band match", StringComparison.OrdinalIgnoreCase)
                || value.Contains("Finishing move matrix rows", StringComparison.OrdinalIgnoreCase)
                || value.Contains("Theme description:", StringComparison.OrdinalIgnoreCase)
                || value.Contains("Relevant theme AI guidance notes", StringComparison.OrdinalIgnoreCase)
                || value.Contains("SessionId=", StringComparison.OrdinalIgnoreCase)
                || lower.Contains("recent interactions")
                || lower.Contains("scenario summary")
                || lower.Contains("output format")
                || lower.Contains("json array")
                || lower.Contains("assistant prompt")
                || lower.Contains("system prompt")
                || lower.Contains("you are")
                || lower.Contains("actions to take")
                || lower.Contains("prompt area")
                || lower.Contains("instruction intent")
                || lower.Contains("paste the following")
                || lower.Contains("system-level directive")
                || lower.Contains("override standard narrative generation")
                || lower.Contains("task:")
                || lower.Contains("constraints:")
                || lower.Contains("instruction:")
                || lower.Contains("example output")
                || lower.Contains("option 1")
                || lower.Contains("option 2")
                || lower.Contains("option 3")
                || lower.Contains("option 4")
                || lower.Contains("option 5")
                || lower.StartsWith("avoidance:")
                || lower.Contains("phase guidance")
                || lower.Contains("theme guidance"))
            {
                return false;
            }

            return !Regex.IsMatch(value,
                "^(Generate|Return|Use|Keep|Each|Every|Active|Relevant|No active|No strong|Theme phase guidance|Position mode requirement|Ending moves should|Actions to take|Prompt area|Instruction intent|Paste)\\b",
                RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
        }
    }

    private static string BuildLogPreview(string value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var singleLine = value
            .Replace("\r", " ", StringComparison.Ordinal)
            .Replace("\n", " ", StringComparison.Ordinal)
            .Trim();

        if (singleLine.Length <= maxLength)
        {
            return singleLine;
        }

        return singleLine[..maxLength] + "...";
    }

