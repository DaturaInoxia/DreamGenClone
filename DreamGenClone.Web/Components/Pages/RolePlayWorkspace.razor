    private async Task GenerateFinishOptionsAsync()
    {
        if (_session is null || _finishOptionsLoading)
        {
            Logger.LogInformation(
                "Finish option generation skipped. SessionMissing={SessionMissing} AlreadyLoading={AlreadyLoading}",
                _session is null,
                _finishOptionsLoading);
            return;
        }

        _finishOptionsGenerationCts?.Cancel();
        _finishOptionsGenerationCts?.Dispose();
        _finishOptionsGenerationCts = new CancellationTokenSource();
        var configuredTimeoutSeconds = Math.Clamp(LmStudioConfiguration.Value.TimeoutSeconds, 10, 600);
        var cancellationToken = _finishOptionsGenerationCts.Token;
        var finishGenerationCorrelationId = Guid.NewGuid().ToString("N")[..12];
        var totalStopwatch = Stopwatch.StartNew();
        var usedFallback = false;
        var outcome = "Success";

        _finishOptionsLoading = true;
        _finishOptionError = string.Empty;
        _finishGenerationIndex++;
        try
        {
            var contextBuildStopwatch = Stopwatch.StartNew();
            var context = BuildAssistantContext(finishGenerationCorrelationId);
            contextBuildStopwatch.Stop();

            var promptBuildStopwatch = Stopwatch.StartNew();
            var prompt = await BuildFinishOptionsPromptAsync();
            promptBuildStopwatch.Stop();

            await WriteFinishDebugEventAsync(
                finishGenerationCorrelationId,
                eventKind: "FinishPromptRequested",
                severity: "Info",
                summary: $"Finish prompt requested ({(_finishUseGuidedFlow ? "FinishingMove" : "Finish")}).",
                durationMs: null,
                metadata: new
                {
                    flowMode = _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                    timeoutSeconds = configuredTimeoutSeconds,
                    contextBuildMs = contextBuildStopwatch.ElapsedMilliseconds,
                    promptBuildMs = promptBuildStopwatch.ElapsedMilliseconds,
                    promptLength = prompt.Length,
                    recentInteractions = context.RecentInteractions.Count,
                    prompt
                });

            Logger.LogInformation(
                "Generating finish options: SessionId={SessionId} CorrelationId={CorrelationId} FlowMode={FlowMode} TimeoutSeconds={TimeoutSeconds} ContextBuildMs={ContextBuildMs} PromptBuildMs={PromptBuildMs} PromptLength={PromptLength} RecentInteractions={RecentInteractions}",
                _session.Id,
                finishGenerationCorrelationId,
                _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                configuredTimeoutSeconds,
                contextBuildStopwatch.ElapsedMilliseconds,
                promptBuildStopwatch.ElapsedMilliseconds,
                prompt.Length,
                context.RecentInteractions.Count);

            var assistantCallStopwatch = Stopwatch.StartNew();

            var response = await RolePlayAssistant.GenerateSuggestionAsync(
                context,
                prompt,
                assistantModelId: string.IsNullOrWhiteSpace(_session.SessionModelId) ? null : _session.SessionModelId,
                assistantTemperature: _session.SessionTemperature,
                assistantTopP: _session.SessionTopP,
                assistantMaxTokens: _session.SessionMaxTokens,
                appFunction: AppFunction.RolePlaySteering,
                cancellationToken: cancellationToken);
            assistantCallStopwatch.Stop();

            Logger.LogInformation(
                "Finish assistant response preview: SessionId={SessionId} CorrelationId={CorrelationId} ResponseLength={ResponseLength} Preview={ResponsePreview}",
                _session.Id,
                finishGenerationCorrelationId,
                response.Length,
                BuildLogPreview(response, 320));

            var parseStopwatch = Stopwatch.StartNew();

            var newPage = ParseFinishOptions(response).ToList();
            parseStopwatch.Stop();

            await WriteFinishDebugEventAsync(
                finishGenerationCorrelationId,
                eventKind: "FinishPromptResponseReceived",
                severity: "Info",
                summary: "Finish prompt response received.",
                durationMs: (int)assistantCallStopwatch.ElapsedMilliseconds,
                metadata: new
                {
                    flowMode = _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                    responseLength = response.Length,
                    responsePreview = BuildLogPreview(response, 500),
                    parsedOptionCount = newPage.Count,
                    options = newPage
                });

            if (newPage.Count == 0)
            {
                Logger.LogWarning(
                    "Finish option generation returned no options: SessionId={SessionId} CorrelationId={CorrelationId} FlowMode={FlowMode} AssistantCallMs={AssistantCallMs} ParseMs={ParseMs} ResponseLength={ResponseLength}",
                    _session.Id,
                    finishGenerationCorrelationId,
                    _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                    assistantCallStopwatch.ElapsedMilliseconds,
                    parseStopwatch.ElapsedMilliseconds,
                    response.Length);
                newPage = BuildFallbackFinishOptions().ToList();
                _finishOptionPages.Add(newPage);
                _finishPageIndex = _finishOptionPages.Count - 1;
                _selectedFinishOption = newPage[0];
                _finishOptionError = "Model returned no options. Using local fallback options.";
                usedFallback = true;
                outcome = "EmptyModelOutputFallback";

                await WriteFinishDebugEventAsync(
                    finishGenerationCorrelationId,
                    eventKind: "FinishPromptEmptyOutputFallback",
                    severity: "Warning",
                    summary: "Finish prompt returned no valid options; using fallback.",
                    durationMs: (int)totalStopwatch.ElapsedMilliseconds,
                    metadata: new
                    {
                        flowMode = _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                        fallbackOptions = newPage
                    });
                return;
            }

            Logger.LogInformation(
                "Generated finish options: SessionId={SessionId} CorrelationId={CorrelationId} FlowMode={FlowMode} OptionCount={OptionCount} AssistantCallMs={AssistantCallMs} ParseMs={ParseMs} FirstOption={FirstOption}",
                _session.Id,
                finishGenerationCorrelationId,
                _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                newPage.Count,
                assistantCallStopwatch.ElapsedMilliseconds,
                parseStopwatch.ElapsedMilliseconds,
                BuildLogPreview(newPage[0], 180));

            _finishOptionPages.Add(newPage);
            _finishPageIndex = _finishOptionPages.Count - 1;
            _selectedFinishOption = newPage[0];
        }
        catch (OperationCanceledException ex)
        {
            var canceledByUser = cancellationToken.IsCancellationRequested;
            outcome = canceledByUser ? "CanceledByUser" : "ProviderCanceledOrTimedOut";
            _finishOptionError = canceledByUser
                ? "Finish generation canceled."
                : "Finish generation was canceled by the provider or timed out. Try Regenerate.";

            Logger.LogWarning(
                ex,
                "Finish option generation canceled: SessionId={SessionId} CorrelationId={CorrelationId} FlowMode={FlowMode} CanceledByUser={CanceledByUser} TimeoutSeconds={TimeoutSeconds} ElapsedMs={ElapsedMs}",
                _session?.Id,
                finishGenerationCorrelationId,
                _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                canceledByUser,
                configuredTimeoutSeconds,
                totalStopwatch.ElapsedMilliseconds);

            await WriteFinishDebugEventAsync(
                finishGenerationCorrelationId,
                eventKind: canceledByUser ? "FinishPromptCanceledByUser" : "FinishPromptProviderTimeoutOrCancel",
                severity: "Warning",
                summary: canceledByUser
                    ? "Finish prompt generation canceled by user action."
                    : "Finish prompt generation canceled by provider or timeout.",
                durationMs: (int)totalStopwatch.ElapsedMilliseconds,
                metadata: new
                {
                    flowMode = _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                    timeoutSeconds = configuredTimeoutSeconds,
                    canceledByUser
                });
        }
        catch (Exception ex)
        {
            var fallbackPage = BuildFallbackFinishOptions().ToList();
            _finishOptionPages.Add(fallbackPage);
            _finishPageIndex = _finishOptionPages.Count - 1;
            _selectedFinishOption = fallbackPage[0];
            _finishOptionError = "Finish option generation failed. Using local fallback options.";
            usedFallback = true;
            outcome = "ExceptionFallback";
            Logger.LogError(
                ex,
                "Failed generating finish options for session {SessionId}: CorrelationId={CorrelationId}, FlowMode={FlowMode}, TimeoutSeconds={TimeoutSeconds}, ElapsedMs={ElapsedMs}",
                _session.Id,
                finishGenerationCorrelationId,
                _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                configuredTimeoutSeconds,
                totalStopwatch.ElapsedMilliseconds);

            await WriteFinishDebugEventAsync(
                finishGenerationCorrelationId,
                eventKind: "FinishPromptFailed",
                severity: "Error",
                summary: "Finish prompt generation failed; fallback options used.",
                durationMs: (int)totalStopwatch.ElapsedMilliseconds,
                metadata: new
                {
                    flowMode = _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                    timeoutSeconds = configuredTimeoutSeconds,
                    exceptionType = ex.GetType().Name,
                    exceptionMessage = ex.Message,
                    fallbackOptions = fallbackPage
                });
        }
        finally
        {
            totalStopwatch.Stop();

            await WriteFinishDebugEventAsync(
                finishGenerationCorrelationId,
                eventKind: "FinishPromptCompleted",
                severity: usedFallback ? "Warning" : "Info",
                summary: $"Finish prompt completed with outcome {outcome}.",
                durationMs: (int)totalStopwatch.ElapsedMilliseconds,
                metadata: new
                {
                    flowMode = _finishUseGuidedFlow ? "FinishingMove" : "Finish",
                    outcome,
                    usedFallback,
                    optionCount = CurrentFinishPage.Count,
                    selectedOption = _selectedFinishOption
                });

            Logger.LogInformation(
                "Finish option generation completed: SessionId={SessionId} CorrelationId={CorrelationId} Outcome={Outcome} UsedFallback={UsedFallback} ElapsedMs={ElapsedMs} OptionCount={OptionCount}",
                _session?.Id,
                finishGenerationCorrelationId,
                outcome,
                usedFallback,
                totalStopwatch.ElapsedMilliseconds,
                CurrentFinishPage.Count);

            _finishOptionsLoading = false;
            _finishOptionsGenerationCts?.Dispose();
            _finishOptionsGenerationCts = null;
        }
    }

    private async Task CancelFinishGenerationAsync(string reason)
    {
        if (_finishOptionsGenerationCts is null && !_finishOptionsLoading)
        {
            return;
        }

        Logger.LogInformation(
            "Canceling finish option generation: SessionId={SessionId} Reason={Reason} PopupOpen={PopupOpen}",
            _session?.Id,
            reason,
            _finishPopupOpen);

        _finishOptionsGenerationCts?.Cancel();
        _finishOptionsLoading = false;

        if (_session is not null)
        {
            await WriteFinishDebugEventAsync(
                correlationId: null,
                eventKind: "FinishPromptCancelRequested",
                severity: "Info",
                summary: $"Finish prompt cancellation requested ({reason}).",
                durationMs: null,
                metadata: new
                {
                    reason,
                    popupOpen = _finishPopupOpen,
                    hasOptions = _finishOptionPages.Count > 0
                });
        }
    }

    private async Task WriteFinishDebugEventAsync(
        string? correlationId,
        string eventKind,
        string severity,
        string summary,
        int? durationMs,
        object metadata)
    {
        if (_session is null)
        {
            return;
