    private List<RolePlayInteraction> GetDisplayInteractions()
    {
        if (_session is null) return [];
        // Show originals (no parent) and resolve active alternative; hide hidden interactions
        var originals = _session.Interactions.Where(i => i.ParentInteractionId is null).ToList();
        var result = new List<RolePlayInteraction>(originals.Count);
        foreach (var original in originals)
        {
            var active = _session.ResolveActiveAlternative(original);
            result.Add(active);
        }
        return result;
    }

    private bool IsFirstInteractionForPhaseInCycle(RolePlayInteraction interaction, int? cycleIndex = null)
    {
        if (_session is null || interaction.NarrativePhaseAtCreation is null)
            return false;

        var targetPhase = interaction.NarrativePhaseAtCreation.Value;

        // Track phases seen so far in the session
        var phasesSeen = new HashSet<NarrativePhase>();

        foreach (var existingInteraction in _session.Interactions)
        {
            if (existingInteraction.NarrativePhaseAtCreation is null)
                continue;

            var existingPhase = existingInteraction.NarrativePhaseAtCreation.Value;

            // If we've reached the target interaction, check if its phase was already seen
            if (string.Equals(existingInteraction.Id, interaction.Id, StringComparison.OrdinalIgnoreCase))
            {
                return !phasesSeen.Contains(targetPhase);
            }

            phasesSeen.Add(existingPhase);
        }

        return false;
    }

