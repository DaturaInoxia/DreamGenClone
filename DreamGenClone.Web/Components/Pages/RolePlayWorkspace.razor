        }

        if (!sexualContext)
        {
            sb.AppendLine("No explicit sexual cue detected. Focus on body positioning, gaze control, spacing, and movement continuity rather than explicit acts.");
        }

        try
        {
            var enabledRows = (await RPThemeService.ListSteerPositionMatrixRowsAsync())
                .Where(x => x.IsEnabled)
                .OrderBy(x => x.SortOrder)
                .ToList();

            if (enabledRows.Count == 0)
            {
                sb.AppendLine("No enabled steer position matrix rows found in the global base table; use interaction-derived position context only.");
                return;
            }

            var state = _session.AdaptiveState;
            var desire = GetAverageAdaptiveStat(state, "Desire");
            var selfRespect = GetAverageAdaptiveStat(state, "SelfRespect");
            var dominance = GetAverageAdaptiveStat(state, "Dominance");
            var wifeDominance = GetAverageAdaptiveStatOrFallback(
                state,
                dominance,
                "WifeDominance",
                "WifeDom",
                "PartnerDominance",
                "FemaleDominance");
            var otherManDominance = GetAverageAdaptiveStatOrFallback(
                state,
                dominance,
                "OtherManDominance",
                "OtherManDom",
                "RivalDominance",
                "BullDominance");

            sb.AppendLine("Steer position matrix rows (global base table):");
            sb.AppendLine($"Current stats for band match: desire={desire:0.0}, selfRespect={selfRespect:0.0}, wifeDominance={wifeDominance:0.0}, otherManDominance={otherManDominance:0.0}.");

            var matchedRows = enabledRows
                .Where(x => MatchesSteerPositionBands(x, desire, selfRespect, wifeDominance, otherManDominance))
                .Select(x => new
                {
                    Row = x,
                    PositionScore = ScoreSteerPositionMatch(x, detectedPosition)
                })
                .Where(x => x.PositionScore >= 0)
                .OrderByDescending(x => x.PositionScore)
                .ThenBy(x => x.Row.SortOrder)
                .Take(6)
                .Select(x => x.Row)
                .ToList();

            var selectedRows = matchedRows.Count > 0
                ? matchedRows
                : enabledRows.Take(6).ToList();

            var detectedPositionLabel = string.IsNullOrWhiteSpace(detectedPosition) ? "none" : detectedPosition;
            var selectionReason = matchedRows.Count > 0
                ? $"Matched {matchedRows.Count} row(s) using bands and detected position '{detectedPositionLabel}'"
                : "No exact steer matrix match; using top rows by sort order";

            sb.AppendLine(selectionReason + ".");

            foreach (var row in selectedRows)
            {
                var primary = row.PrimaryPositions.Count > 0 ? string.Join(", ", row.PrimaryPositions) : "none";
                var secondary = row.SecondaryPositions.Count > 0 ? string.Join(", ", row.SecondaryPositions) : "none";
                var excluded = row.ExcludedPositions.Count > 0 ? string.Join(", ", row.ExcludedPositions) : "none";

                sb.AppendLine($"- desire={row.DesireBand}; selfRespect={row.SelfRespectBand}; wifeDominance={row.WifeDominanceBand}; otherManDominance={row.OtherManDominanceBand}; primary={primary}; secondary={secondary}; excluded={excluded}; wifeBehavior={row.WifeBehaviorModifier}; otherManBehavior={row.OtherManBehaviorModifier}; transition={row.TransitionInstruction}");
            }

            sb.AppendLine("Prefer steer options that align to one selected row and avoid excluded positions.");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to load steer position matrix rows for session {SessionId}.", _session.Id);
        }
    }

    private static bool MatchesSteerPositionBands(
        RPSteerPositionMatrixRow row,
        double desire,
        double selfRespect,
        double wifeDominance,
        double otherManDominance)
        => MatchesNumericBand(row.DesireBand, desire)
           && MatchesNumericBand(row.SelfRespectBand, selfRespect)
           && MatchesNumericBand(row.WifeDominanceBand, wifeDominance)
           && MatchesNumericBand(row.OtherManDominanceBand, otherManDominance);

    private static int ScoreSteerPositionMatch(RPSteerPositionMatrixRow row, string? detectedPosition)
    {
        if (string.IsNullOrWhiteSpace(detectedPosition))
        {
            return 0;
        }

        if (ContainsPositionToken(row.ExcludedPositions, detectedPosition))
        {
            return -1;
        }

        if (ContainsPositionToken(row.PrimaryPositions, detectedPosition))
        {
            return 2;
        }

        if (ContainsPositionToken(row.SecondaryPositions, detectedPosition))
        {
            return 1;
        }

        if (row.PrimaryPositions.Count > 0 || row.SecondaryPositions.Count > 0)
        {
            return 0;
        }

        return 0;
    }

