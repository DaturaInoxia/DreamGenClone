    // â”€â”€ Auto-Complete â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private async Task StartAutoCompleteAsync(int maxTurns)
    {
        if (_autoCompleteRunning || _session is null) return;

        _autoCompleteRunning = true;
        _autoCompleteMaxTurns = maxTurns;
        _autoCompleteState = null;
        _autoCompleteCts = new CancellationTokenSource();
        _activeSettingsTab = "autocomplete";

        var options = new AutoCompleteOptions { MaxTurns = maxTurns };
        var task = AutoCompleteService.RunAsync(sessionId, options, _autoCompleteCts.Token);

        _ = StartAutoCompletePollingAsync(task);
    }

    private async Task StartAutoCompletePollingAsync(Task<AutoCompleteState> runTask)
    {
        _autoCompletePollTimer?.Dispose();
        _autoCompletePollTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _autoCompletePollTimer.WaitForNextTickAsync())
            {
                _autoCompleteState = AutoCompleteService.GetState(sessionId);
                await InvokeAsync(StateHasChanged);

                if (_autoCompleteState?.Status != AutoCompleteStatus.Running)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }

        _autoCompleteState = AutoCompleteService.GetState(sessionId);
        _autoCompleteRunning = false;
        _autoCompleteCts?.Dispose();
        _autoCompleteCts = null;
        _autoCompletePollTimer?.Dispose();
        _autoCompletePollTimer = null;

        try { await InvokeAsync(StateHasChanged); } catch { }
    }

    private void CancelAutoComplete()
    {
        _autoCompleteCts?.Cancel();
    }
}

<PageTitle>Role-Play Workspace</PageTitle>

<div class="rw-shell" @onclick="CloseAllPopups" style="@ShellStyle">

    
    <div class="rw-main">

        <div class="rw-header">
            <div class="rw-header-left">
                <button class="rw-back-btn" @onclick="GoToSavedSessions" @onclick:stopPropagation>‹</button>
                @if (_session is not null)
                {
                    @if (_editingTitle)
                    {
                        <input class="rw-session-title-input"
                               value="@_editingTitleText"
                               @oninput="e => _editingTitleText = e.Value?.ToString() ?? string.Empty"
                               @onblur="CommitTitleEditAsync"
                               @onkeydown="OnTitleKeyDownAsync"
                               @onclick:stopPropagation />
                    }
                    else
                    {
                        <span class="rw-session-title rw-session-title-editable" @onclick="StartTitleEdit" @onclick:stopPropagation title="Click to edit title">@_session.Title</span>
                    }
                    <span class="rw-session-meta">@_session.Interactions.Count interactions → @TotalTurns turns → @_session.BehaviorMode</span>
                }
            </div>
            <div class="rw-header-right">
                <a class="rw-gallery-link" href="/roleplay/gallery/@sessionId" title="View all session images">Gallery</a>
                @if (_session is not null && _session.Interactions.Count > 0)
                {
                    <a class="rw-gallery-link" href="@($"/roleplay/studio/{_session.Id}/{_session.Interactions.Last().Id}")" title="Open the Scene Image Studio for this session">Studio</a>
                }
                <button class="rw-debug-btn" @onclick="OpenDebugWindowAsync" @onclick:stopPropagation>Debug View</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="rw-status-bar">@_statusMessage</div>
        }

        @if (_session is null)
        {
            <div class="rw-loading">Loading session...</div>
        }
        else
        {
            <div class="rw-story">
                @if (_session.Interactions.Count == 0)
                {
                    <p class="rw-empty-hint">No interactions yet. Type below and press Send to begin.</p>
                }
                else
                {
                    var _displayInteractions = GetDisplayInteractions();
                    @for (int _i = 0; _i < _displayInteractions.Count; _i++)
                    {
                        var interaction = _displayInteractions[_i];
                        var _cursorIdx = _i;
                        var interactionId = interaction.Id;
                        <div class="rw-interaction rw-type-@interaction.InteractionType.ToString().ToLower()" data-interaction-index="@_cursorIdx" @key="interactionId" @onclick="@(() => SetReadCursor(_cursorIdx))">
                            <div class="rw-actor-badge">@GetInitial(interaction.ActorName)</div>
                            <div class="rw-interaction-body">
                                <div class="rw-interaction-header">
                                    <div class="rw-actor-name">
                                        @interaction.ActorName
                                        @if (interaction.IsExcluded)
                                        {
                                            <span class="rw-flag-icon rw-flag-excluded" title="This interaction is hidden from the AI">&#x1F6AB;</span>
                                        }
                                        @if (interaction.IsHidden)
                                        {
                                            <span class="rw-flag-icon rw-flag-hidden" title="This interaction is hidden from the user interface">&#x1F441;</span>
                                        }
                                        @if (interaction.IsPinned)
                                        {
                                            <span class="rw-flag-icon rw-flag-pinned" title="This interaction is pinned for AI context retention">&#x1F4CC;</span>
                                        }
                                        @if (interaction.WasEncounterStart == true)
                                        {
                                            <span class="rw-flag-icon rw-flag-encounter-start" title="Encounter started (semantic)">&#x1F525;</span>
                                        }
                                        @if (interaction.WasEncounterBoundaryDetected == true)
                                        {
                                            <span class="rw-flag-icon rw-flag-encounter-end" title="Encounter ended (semantic)">&#x1F4A6;</span>
                                        }
                                        @if (interaction.EncounterNumberAtCreation.HasValue)
                                        {
                                            <span class="rw-flag-icon rw-flag-in-sex-scene" title="In sex scene (Interaction #@interaction.InteractionIndexInEncounter in encounter #@interaction.EncounterNumberAtCreation)">&#x1F346;</span>
                                        }
                                    </div>
                                    <div class="rw-interaction-header-right">
                                        <div class="rw-interaction-toolbar">
                                            @{
                                                var semanticStatus = GetSemanticInteractionAnalysisState(interactionId);
                                            }
                                            @if (semanticStatus is not null && semanticStatus.Status != SemanticAnalysisStatus.Idle)
                                            {
                                                var semanticLabel = GetSemanticStatusLabel(semanticStatus.Status);
                                                var semanticTitle = semanticStatus.Status == SemanticAnalysisStatus.Error
                                                    ? $"Semantic analysis failed: {semanticStatus.ErrorMessage ?? "Unknown error"}"
                                                    : $"Semantic analysis status: {semanticLabel}";
                                                var semanticBtnClass = GetSemanticToolbarBtnClass(semanticStatus.Status);
                                                <button class="rw-toolbar-btn @semanticBtnClass" title="@semanticTitle" @onclick="@(() => ShowSemanticDetail(interactionId))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                                </button>
                                            }
                                            @if (_editContent.ContainsKey(interactionId))
                                            {
                                                @* Edit-mode toolbar: Delete | ? Kebab | Undo | Save | Cancel *@
                                                <button class="rw-toolbar-btn rw-toolbar-btn-danger" title="Delete interaction"
                                                        @onclick="@(() => ShowDeleteConfirmation(interactionId))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                </button>
                                                <button class="rw-toolbar-btn" data-kebab-btn="@interactionId" title="More options" @onclick="@(() => ToggleKebabMenu(interactionId))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                                                </button>
                                                <button class="rw-toolbar-btn" title="Undo changes" @onclick="@(() => UndoEdit(interactionId))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                                                </button>
                                                <button class="rw-toolbar-btn" title="Save edit" @onclick="@(() => SaveEditAsync(interactionId))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                                </button>
                                                <button class="rw-toolbar-btn" title="Cancel edit" @onclick="@(() => CancelEdit(interactionId))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                                </button>
                                            }
                                            else
                                            {
                                                var imgCount = GetImageCountForInteraction(interactionId);
                                                @if (imgCount > 0)
                                                {
                                                    <button class="rw-toolbar-btn rw-toolbar-btn-image" title="@($"{imgCount} image(s) generated — click to open in studio")" @onclick="@(() => OpenImageStudioAsync(interactionId))" @onclick:stopPropagation>
                                                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                                        <span class="rw-image-badge">@imgCount</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="rw-toolbar-btn" title="Generate image for this interaction" @onclick="@(() => OpenImageStudioAsync(interactionId))" @onclick:stopPropagation>
                                                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                                    </button>
                                                }
                                                @* Default toolbar: Retry | Edit | Info *@
                                                <button class="rw-toolbar-btn" data-retry-btn="@interactionId" title="Retry / Regenerate" @onclick="@(() => ToggleRetryMenu(interactionId))" @onclick:stopPropagation>
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/><path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/></svg>
                                                </button>
                                                <button class="rw-toolbar-btn" title="Edit interaction" @onclick="@(() => StartEdit(interactionId, interaction.Content))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                </button>
                                                <button class="rw-toolbar-btn" title="Generation info" @onclick="@(() => ShowInteractionInfo(interactionId))">
                                                    <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                                </button>
                                            }
                                        </div>
                                        @if (IsFirstInteractionForPhaseInCycle(interaction))
                                        {
                                            var phaseClass = interaction.NarrativePhaseAtCreation?.ToString().ToLower() switch
                                            {
                                                "buildup" => "rw-phase-badge-buildup",
                                                "committed" => "rw-phase-badge-committed",
                                                "approaching" => "rw-phase-badge-approaching",
                                                "climax" => "rw-phase-badge-climax",
                                                "reset" => "rw-phase-badge-reset",
                                                _ => "rw-phase-badge-reset"
                                            };
                                            <span class="rw-phase-badge @phaseClass" title="Phase: @interaction.NarrativePhaseAtCreation">@interaction.NarrativePhaseAtCreation</span>
                                        }
                                    </div>
                                </div>
                                <div class="rw-interaction-text">
                                    @if (_generatingIds.Contains(interactionId))
                                    {
                                        <div class="rw-generating-indicator">Generating...</div>
                                    }
                                    @if (_editContent.ContainsKey(interactionId))
                                    {
                                        <textarea class="rw-edit-textarea" @bind="_editContent[interactionId]" @bind:event="oninput"></textarea>
                                    }
                                    else
                                    {
                                        @interaction.Content
                                    }
                                    @if (_retryErrors.TryGetValue(interactionId, out var errorMsg))
                                    {
                                        <div class="rw-error-inline">@errorMsg</div>
                                    }
                                </div>
                                @{
                                    var originalId = interaction.ParentInteractionId ?? interaction.Id;
                                    var altCount = GetAlternativeCount(originalId);
                                    var activeIdx = GetActiveAlternativeIndex(originalId);
                                }
                                @if (altCount > 0)
                                {
                                    <div class="rw-alt-navigation">
                                        <button class="rw-alt-nav-btn" disabled="@(activeIdx <= 0)" @onclick="@(() => NavigateAlternativeAsync(originalId, -1))">&#x25C0;</button>
                                        <span class="rw-alt-counter">@(activeIdx + 1) of @(altCount + 1)</span>
                                        <button class="rw-alt-nav-btn" disabled="@(activeIdx >= altCount)" @onclick="@(() => NavigateAlternativeAsync(originalId, 1))">&#x25B6;</button>
                                        @if (activeIdx > 0)
                                        {
                                            <button class="rw-alt-delete-btn" title="Delete this alternative" @onclick="@(() => ShowDeleteAlternativeConfirmation(interactionId))">
                                                <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        }
                                        else if (activeIdx == 0 && altCount > 0)
                                        {
                                            <button class="rw-alt-delete-btn" title="Delete this version (first rewrite becomes the new version)" @onclick="@(() => ShowDeleteOriginalConfirmation(interactionId))">
                                                <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        @if (_cursorIdx == _readCursorInteractionIndex)
                        {
                            <div class="rw-read-cursor" id="rw-read-cursor"><span class="rw-read-cursor-label">→ new →</span></div>
                        }
                    }

                    @if (_deleteConfirmInteractionId is not null)
                    {
                        <div class="rw-modal-overlay" @onclick="CancelDelete">
                            <div class="rw-modal" @onclick:stopPropagation>
                                <div class="rw-modal-header">Delete Interaction</div>
                                <div class="rw-modal-body">
                                    <p>This can't be undone.</p>
                                </div>
                                <div class="rw-modal-actions">
                                    <button class="rw-btn rw-btn-secondary" @onclick="CancelDelete">Cancel</button>
                                    <button class="rw-btn rw-btn-danger" @onclick="@(() => ConfirmDeleteAsync(true))">Delete + below</button>
                                    <button class="rw-btn rw-btn-danger" @onclick="@(() => ConfirmDeleteAsync(false))">Delete</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_deleteAlternativeConfirmId is not null)
                    {
                        <div class="rw-modal-overlay" @onclick="CancelDeleteAlternative">
                            <div class="rw-modal" @onclick:stopPropagation>
                                <div class="rw-modal-header">Delete Alternative</div>
                                <div class="rw-modal-body">
                                    <p>Delete this rewrite alternative? Remaining alternatives will be renumbered. This can't be undone.</p>
                                </div>
                                <div class="rw-modal-actions">
                                    <button class="rw-btn rw-btn-secondary" @onclick="CancelDeleteAlternative">Cancel</button>
                                    <button class="rw-btn rw-btn-danger" @onclick="ConfirmDeleteAlternativeAsync">Delete</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_deleteOriginalConfirmId is not null)
                    {
                        <div class="rw-modal-overlay" @onclick="CancelDeleteOriginal">
                            <div class="rw-modal" @onclick:stopPropagation>
                                <div class="rw-modal-header">Delete This Version</div>
                                <div class="rw-modal-body">
                                    <p>Delete the first version? The next rewrite becomes the new version (2 of 2 becomes 1 of 1). This can't be undone.</p>
                                </div>
                                <div class="rw-modal-actions">
                                    <button class="rw-btn rw-btn-secondary" @onclick="CancelDeleteOriginal">Cancel</button>
                                    <button class="rw-btn rw-btn-danger" @onclick="ConfirmDeleteOriginalAsync">Delete</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_rewriteDialogInteractionId is not null)
                    {
                        <div class="rw-modal-overlay" @onclick="CancelRewriteDialog">
                            <div class="rw-modal" @onclick:stopPropagation>
                                <div class="rw-modal-header">Custom Rewrite Instruction</div>
                                <div class="rw-modal-body">
                                    <textarea class="rw-rewrite-textarea" @bind="_rewriteInstruction" @bind:event="oninput" placeholder="Describe how to rewrite this interaction..."></textarea>
                                </div>
                                <div class="rw-modal-actions">
                                    <button class="rw-btn rw-btn-secondary" @onclick="CancelRewriteDialog">Cancel</button>
                                    <button class="rw-btn rw-btn-primary" disabled="@string.IsNullOrWhiteSpace(_rewriteInstruction)" @onclick="ConfirmRewriteAsync">Rewrite</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_pendingDecisionPrompt is not null && !ShouldShowDecisionPrompt)
                    {
                        <div class="rw-settings-info-row" style="margin-top:12px;">
                            <span>@($"Decision pending ({PendingDecisionCount} queued)")</span>
                            <div style="display:flex; gap:8px;">
                                <button class="rw-btn rw-btn-secondary" @onclick="ReopenDecisionPrompt">Review Decision</button>
                                <button class="rw-btn rw-btn-secondary"
                                        disabled="@_decisionPromptSubmitting"
                                        @onclick="SkipCurrentDecisionPromptAsync">
                                    Skip Current
                                </button>
                            </div>
                        </div>
                    }

                    @if (_deferredDecisionPrompts.Count > 0)
                    {
                        <div class="rw-scenario-field" style="margin-top:12px;">
                            <label class="rw-scenario-field-label">Deferred Decisions (@_deferredDecisionPrompts.Count)</label>
                            @foreach (var deferred in _deferredDecisionPrompts.Take(4))
                            {
                                <div class="rw-settings-info-row">
                                    <span>@($"{deferred.DecisionPoint.TriggerSource} -> {ResolveDecisionActorLabel(deferred.DecisionPoint.TargetActorId)}")</span>
                                    <div style="display:flex; gap:8px;">
                                        <button class="rw-btn rw-btn-secondary"
                                                disabled="@_decisionPromptSubmitting"
                                                @onclick="@(() => RestoreDeferredDecisionAsync(deferred.DecisionPoint.DecisionPointId))">
                                            Restore
                                        </button>
                                        <button class="rw-btn rw-btn-secondary"
                                                disabled="@_decisionPromptSubmitting"
                                                @onclick="@(() => SkipDeferredDecisionAsync(deferred.DecisionPoint.DecisionPointId))">
                                            Skip
                                        </button>
                                    </div>
                                </div>
                            }
                            @if (_deferredDecisionPrompts.Count > 4)
                            {
                                <div class="small" style="margin-top:6px; color:#9f9f9f;">Showing 4 of @_deferredDecisionPrompts.Count deferred decisions.</div>
                            }
                        </div>
                    }

                    @if (_pendingDecisionPrompt is not null && _session is not null && ShouldShowDecisionPrompt)
                    {
                        <div class="rw-modal-overlay" @onclick:stopPropagation>
                            <div class="rw-modal rw-modal-decision" @onclick:stopPropagation>
                                <div class="rw-modal-header">Decision Prompt</div>
                                <div class="rw-modal-body rw-modal-body-scroll">
                                    <div class="rw-info-grid">
                                        <div class="rw-info-row"><span class="rw-info-label">Decision Actor</span><span class="rw-info-value">@ResolveDecisionActorLabel(_pendingDecisionPrompt.DecisionPoint.TargetActorId)</span></div>
                                        <div class="rw-info-row"><span class="rw-info-label">Asking Actor</span><span class="rw-info-value">@ResolveDecisionActorLabel(_pendingDecisionPrompt.DecisionPoint.AskingActorName)</span></div>
                                        @if (!string.IsNullOrWhiteSpace(_pendingDecisionPrompt.DecisionPoint.TargetActorId))
                                        {
                                            <div class="rw-info-row"><span class="rw-info-label">Target Actor</span><span class="rw-info-value">@ResolveDecisionActorLabel(_pendingDecisionPrompt.DecisionPoint.TargetActorId)</span></div>
                                        }
                                        <div class="rw-info-row"><span class="rw-info-label">Theme</span><span class="rw-info-value">@ResolveDecisionThemeLabel(_pendingDecisionPrompt.DecisionPoint.ScenarioId)</span></div>
                                        <div class="rw-info-row"><span class="rw-info-label">Phase</span><span class="rw-info-value">@_pendingDecisionPrompt.DecisionPoint.Phase</span></div>
                                        <div class="rw-info-row"><span class="rw-info-label">Trigger</span><span class="rw-info-value">@_pendingDecisionPrompt.DecisionPoint.TriggerSource</span></div>
                                    </div>

                                    @if (PendingDecisionCount > 1)
                                    {
                                        <div class="rw-scenario-field" style="margin-top:10px;">
                                            <label class="rw-scenario-field-label">Decision Queue</label>
                                            <div class="rw-settings-info-row"><span>Pending Total</span><span>@PendingDecisionCount</span></div>
                                            <div class="rw-settings-info-row"><span>Additional After This</span><span>@(PendingDecisionCount - 1)</span></div>
                                            @foreach (var bucket in GetPendingDecisionQueueBuckets().Take(6))
                                            {
                                                <div class="rw-settings-info-row">
                                                    <span>@bucket.TriggerSource</span>
                                                    <span>@($"{bucket.Count} x {bucket.TargetActorLabel}")</span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(_decisionPromptError))
                                    {
                                        <div class="rw-error-inline" style="margin-top:10px;">@_decisionPromptError</div>
                                    }

                                    <div class="rw-modal-actions" style="justify-content:flex-end; padding:8px 0 0 0;">
                                        <button class="rw-btn rw-btn-secondary"
                                                disabled="@_decisionPromptSubmitting"
                                                @onclick="SkipCurrentDecisionPromptAsync">
                                            Skip Current
                                        </button>
                                        <button class="rw-btn rw-btn-secondary"
                                                disabled="@_decisionPromptSubmitting"
                                                @onclick="DeferDecisionPromptAsync">
                                            Ask Me Later
                                        </button>
                                    </div>

                                    @foreach (var option in _pendingDecisionPrompt.Options)
                                    {
                                        <div class="rw-scenario-field" style="margin-top:10px;">
                                            <label class="rw-scenario-field-label">@option.DisplayText</label>
                                            @if (!string.IsNullOrWhiteSpace(option.ResponsePreview))
                                            {
                                                <div class="small" style="color:#a8a8a8; margin-bottom:2px;">Suggested answer:</div>
                                                <div class="small" style="white-space:pre-wrap; color:#c9c9c9; margin-bottom:4px;">@option.ResponsePreview</div>
                                            }
                                            <div class="rw-settings-info-row"><span>Choice Id</span><span>@option.OptionId</span></div>
                                            <div class="rw-settings-info-row"><span>Result</span><span>@FormatDecisionDeltas(option.StatDeltaMap)</span></div>

                                            @if (option.IsCustomResponseFallback)
                                            {
                                                <textarea class="rw-rewrite-textarea"
                                                          placeholder="Describe your custom choice..."
                                                          @bind="_decisionCustomResponse"
                                                          @bind:event="oninput"></textarea>
                                            }

                                            <div class="rw-modal-actions" style="justify-content:flex-end; padding:8px 0 0 0;">
                                                <button class="rw-btn rw-btn-primary"
                                                        disabled="@(_decisionPromptSubmitting || (option.IsCustomResponseFallback && string.IsNullOrWhiteSpace(_decisionCustomResponse)))"
                                                        @onclick="@(() => ApplyDecisionOptionAsync(option))">
                                                    Apply Choice
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (_infoPopupInteractionId is not null && _session is not null)
                    {
                        var infoInteraction = _session.Interactions.FirstOrDefault(i => i.Id == _infoPopupInteractionId);
                        if (infoInteraction is not null)
                        {
                            <div class="rw-modal-overlay" @onclick="CloseInteractionInfo">
                                <div class="rw-modal rw-modal-info" @onclick:stopPropagation>
                                    <div class="rw-modal-header">
                                        <span class="rw-modal-title">Interaction Info</span>
                                        <div class="rw-modal-tabs">
                                            <button class="rw-tab @(_infoPopupTab == "info" ? "rw-tab-active" : "")" @onclick="SetInfoTab">Info</button>
                                            @if (!string.IsNullOrWhiteSpace(infoInteraction.ReasoningContent))
                                            {
                                                <button class="rw-tab @(_infoPopupTab == "reasoning" ? "rw-tab-active" : "")" @onclick="SetReasoningTab">Reasoning</button>
                                            }
                                            <button class="rw-tab @(_infoPopupTab == "prompt" ? "rw-tab-active" : "")" @onclick="SetPromptTab">LLM Prompt</button>
                                        </div>
                                    </div>
                                    <div class="rw-modal-body">
                                        @if (_infoPopupTab == "info")
                                        {
                                        <div class="rw-info-grid">
                                            <div class="rw-info-row"><span class="rw-info-label">ID</span><span class="rw-info-value rw-info-value-mono">@infoInteraction.Id</span></div>
                                            @{
                                                var infoPhaseAtCreation = infoInteraction.NarrativePhaseAtCreation?.ToString() ?? "—";
                                                var infoInteractionNumber = _session!.Interactions.IndexOf(infoInteraction) + 1;
                                            }
                                            <div class="rw-info-row"><span class="rw-info-label">Phase at Creation</span><span class="rw-info-value">@infoPhaseAtCreation</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Interaction #</span><span class="rw-info-value">@infoInteractionNumber</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Actor</span><span class="rw-info-value">@infoInteraction.ActorName</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Type</span><span class="rw-info-value">@infoInteraction.InteractionType</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Created</span><span class="rw-info-value">@infoInteraction.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                                            @{
                                                var infoSemanticState = GetSemanticInteractionAnalysisState(infoInteraction.Id);
                                            }
                                            <div class="rw-info-row"><span class="rw-info-label">Semantic Analysis</span><span class="rw-info-value">@(infoSemanticState is null ? "Idle" : GetSemanticStatusLabel(infoSemanticState.Status))</span></div>
                                            @if (infoSemanticState?.AnalyzedUtc is not null)
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Analyzed</span><span class="rw-info-value">@infoSemanticState.AnalyzedUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(infoSemanticState?.ErrorMessage))
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Semantic Error</span><span class="rw-info-value">@infoSemanticState.ErrorMessage</span></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(infoSemanticState?.ResultJson))
                                            {
                                                @try
                                                {
                                                    var parsedResult = JsonSerializer.Deserialize<JsonElement>(infoSemanticState.ResultJson);
                                                    <div class="rw-info-row"><span class="rw-info-label">Events Inferred</span><span class="rw-info-value">@(parsedResult.TryGetProperty("inferredEventCount", out var ec) ? ec.GetInt32() : 0)</span></div>
                                                    <div class="rw-info-row"><span class="rw-info-label">Context Turns</span><span class="rw-info-value">@(parsedResult.TryGetProperty("contextTurnsCount", out var ct) ? ct.GetInt32() : 0)</span></div>
                                                    @if (parsedResult.TryGetProperty("inferredEvents", out var eventsEl) && eventsEl.GetArrayLength() > 0)
                                                    {
                                                        <div class="rw-info-row rw-settings-info-row-block">
                                                            <span class="rw-info-label">Inferred Events</span>
                                                            <span class="rw-info-value">
                                                                @foreach (var ev in eventsEl.EnumerateArray())
                                                                {
                                                                    var evId = ev.TryGetProperty("eventId", out var eid) ? eid.GetString() : "?";
                                                                    var evConf = ev.TryGetProperty("confidence", out var ec2) ? ec2.GetDecimal().ToString("F2") : "?";
                                                                    var evActor = ev.TryGetProperty("actorName", out var ea) && ea.ValueKind != JsonValueKind.Null ? ea.GetString() : null;
                                                                    var evSpan = ev.TryGetProperty("evidenceSpan", out var es) && es.ValueKind != JsonValueKind.Null ? es.GetString() : null;
                                                                    <div class="rw-info-value-mono" style="margin-bottom:2px">
                                                                        @evId — conf: @evConf@(evActor is not null ? $" | actor: {evActor}" : "")@(evSpan is not null ? $" | \"{evSpan}\"" : "")
                                                                    </div>
                                                                }
                                                            </span>
                                                        </div>
                                                    }
                                                    @if (parsedResult.TryGetProperty("inferenceRawOutput", out var raw) && !string.IsNullOrWhiteSpace(raw.GetString()))
                                                    {
                                                        <div class="rw-info-row rw-settings-info-row-block"><span class="rw-info-label">Raw Output</span><span class="rw-info-value rw-info-value-mono">@raw.GetString()</span></div>
                                                    }
                                                }
                                                catch
                                                {
                                                    <div class="rw-info-row rw-settings-info-row-block"><span class="rw-info-label">Semantic Details</span><span class="rw-info-value rw-info-value-mono">@infoSemanticState.ResultJson</span></div>
                                                }
                                            }
                                            <div class="rw-info-row"><span class="rw-info-label">Word Count</span><span class="rw-info-value">@(string.IsNullOrWhiteSpace(infoInteraction.Content) ? 0 : infoInteraction.Content.Trim().Split((char[])null!, StringSplitOptions.RemoveEmptyEntries).Length)</span></div>
                                            @if (infoInteraction.ParentInteractionId is not null)
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Alternative #</span><span class="rw-info-value">@infoInteraction.AlternativeIndex</span></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(infoInteraction.GeneratedByCommand))
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Command</span><span class="rw-info-value">@infoInteraction.GeneratedByCommand</span></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(infoInteraction.GeneratedByModelName))
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Model</span><span class="rw-info-value">@infoInteraction.GeneratedByModelName</span></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(infoInteraction.GeneratedByProvider))
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Provider</span><span class="rw-info-value">@infoInteraction.GeneratedByProvider</span></div>
                                            }
                                            @if (infoInteraction.GeneratedTemperature.HasValue)
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Temperature</span><span class="rw-info-value">@infoInteraction.GeneratedTemperature.Value.ToString("F2")</span></div>
                                            }
                                            @if (infoInteraction.GeneratedTopP.HasValue)
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Top-P</span><span class="rw-info-value">@infoInteraction.GeneratedTopP.Value.ToString("F2")</span></div>
                                            }
                                            @if (infoInteraction.GeneratedMaxTokens.HasValue)
                                            {
                                                <div class="rw-info-row"><span class="rw-info-label">Max Tokens</span><span class="rw-info-value">@infoInteraction.GeneratedMaxTokens.Value</span></div>
                                            }
                                            <div class="rw-info-row"><span class="rw-info-label">Excluded</span><span class="rw-info-value">@(infoInteraction.IsExcluded ? "Yes" : "No")</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Pinned</span><span class="rw-info-value">@(infoInteraction.IsPinned ? "Yes" : "No")</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Hidden</span><span class="rw-info-value">@(infoInteraction.IsHidden ? "Yes" : "No")</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Encounter Start</span><span class="rw-info-value">@(infoInteraction.WasEncounterStart.HasValue ? (infoInteraction.WasEncounterStart.Value ? "Yes" : "No") : "—")</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Encounter End</span><span class="rw-info-value">@(infoInteraction.WasEncounterBoundaryDetected.HasValue ? (infoInteraction.WasEncounterBoundaryDetected.Value ? "Yes" : "No") : "—")</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Encounter #</span><span class="rw-info-value">@(infoInteraction.EncounterNumberAtCreation.HasValue ? infoInteraction.EncounterNumberAtCreation.Value.ToString() : "—")</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">Interaction in Encounter</span><span class="rw-info-value">@(infoInteraction.InteractionIndexInEncounter.HasValue ? infoInteraction.InteractionIndexInEncounter.Value.ToString() : "—")</span></div>
                                            <div class="rw-info-row"><span class="rw-info-label">In Sex Scene</span><span class="rw-info-value">@(infoInteraction.EncounterNumberAtCreation.HasValue ? "Yes" : "—")</span></div>
                                        </div>
                                        }
                                        @if (_infoPopupTab == "reasoning" && !string.IsNullOrWhiteSpace(infoInteraction.ReasoningContent))
                                        {
                                            <div class="rw-info-value-mono" style="white-space: pre-wrap; max-height: 60vh; overflow-y: auto; font-size: 0.85em; color: #b0b0b0;">@infoInteraction.ReasoningContent</div>
                                        }
                                        @if (_infoPopupTab == "prompt")
                                        {
                                            @if (!string.IsNullOrWhiteSpace(infoInteraction.PromptText))
                                            {
                                                <div style="margin-bottom: 0.5rem;">
                                                    <button class="rw-btn rw-btn-secondary" @onclick="() => CopyPromptToClipboard(infoInteraction.PromptText)">
                                                        <i class="fas fa-copy"></i> Copy to Clipboard
                                                    </button>
                                                </div>
                                                <div class="rw-info-value-mono rw-prompt-viewer">@infoInteraction.PromptText</div>
                                            }
                                            else
                                            {
                                                <div class="rw-info-value" style="font-style: italic; color: #888;">
                                                    No prompt data available for this interaction.
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="rw-modal-actions">
                                        <button class="rw-btn rw-btn-secondary" @onclick="CloseInteractionInfo">Close</button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @* ─── Semantic Detail Modal ─── *@
                    @if (_semanticDetailInteractionId is not null && _session is not null)
                    {
                        var sdState = GetSemanticInteractionAnalysisState(_semanticDetailInteractionId);
                        if (sdState is not null)
                        {
                            var sdLabel = GetSemanticStatusLabel(sdState.Status);
                            var sdBadgeClass = GetSemanticStatusBadgeClass(sdState.Status);
                            var sdDetail = TryParseSemanticDetail(sdState.ResultJson);
                            var sdEventStatRows = new List<SemanticEventStatRow>();
                            if (sdDetail is not null)
                            {
                                var statMappings = _activeRpTheme?.SemanticStatMappings ?? [];
                                foreach (var ev in sdDetail.InferredEvents)
                                {
                                    var matched = statMappings
                                        .Where(m => string.Equals(m.EventId, ev.EventId, StringComparison.OrdinalIgnoreCase))
                                        .GroupBy(m => m.TargetStat, StringComparer.OrdinalIgnoreCase)
                                        .Select(g =>
                                        {
                                            var net = g.Sum(m =>
                                                string.Equals(m.Direction, "decrease", StringComparison.OrdinalIgnoreCase)
                                                    ? -Math.Abs(m.Delta)
                                                    : m.Delta);
                                            return (TargetStat: g.Key, NetDelta: net);
                                        })
                                        .Where(x => x.NetDelta != 0)
                                        .ToList();

                                    if (matched.Count == 0)
                                    {
                                        matched.Add(("—", 0m));
                                    }

                                    for (int i = 0; i < matched.Count; i++)
                                    {
                                        sdEventStatRows.Add(new SemanticEventStatRow
                                        {
                                            EventId = ev.EventId,
                                            Confidence = ev.Confidence,
                                            ActorName = ev.ActorName,
                                            TargetCharacterName = ev.TargetCharacterName,
                                            EvidenceSpan = ev.EvidenceSpan,
                                            TargetStat = matched[i].TargetStat,
                                            Delta = matched[i].NetDelta,
                                            IsFirstOfEvent = i == 0
                                        });
                                    }
                                }
                            }
                            <div class="rw-modal-overlay" @onclick="CloseSemanticDetail">
                                <div class="rw-modal rw-modal-semantic" @onclick:stopPropagation>
                                    <div class="rw-modal-header">
                                        Semantic Analysis
                                        <span class="@sdBadgeClass" style="float:right;margin-top:-2px;">@sdLabel</span>
                                    </div>
                                    @*└─ Tab bar ──*@
                                    <div class="rw-semantic-tabs">
                                        <button class="rw-semantic-tab @(_semanticDetailTab == "interaction" ? "rw-semantic-tab-active" : "")"
                                            @onclick='() => _semanticDetailTab = "interaction"'>Interaction</button>
                                        <button class="rw-semantic-tab @(_semanticDetailTab == "prompt" ? "rw-semantic-tab-active" : "")"
                                            @onclick='() => _semanticDetailTab = "prompt"'>Prompt</button>
                                        <button class="rw-semantic-tab @(_semanticDetailTab == "response" ? "rw-semantic-tab-active" : "")"
                                            @onclick='() => _semanticDetailTab = "response"'>Response</button>
                                    </div>
                                    <div class="rw-modal-body rw-modal-body-scroll">
                                        @if (sdState.Status == SemanticAnalysisStatus.Error)
                                        {
                                            <div class="rw-semantic-detail-error">
                                                <strong>Error:</strong> @(sdState.ErrorMessage ?? "Unknown error")
                                            </div>
                                        }
                                        @if (_semanticDetailTab == "prompt")
                                        {
                                            @if (sdDetail is not null && (!string.IsNullOrWhiteSpace(sdDetail.PromptSystem) || !string.IsNullOrWhiteSpace(sdDetail.PromptUser)))
                                            {
                                                @if (!string.IsNullOrWhiteSpace(sdDetail.PromptSystem))
                                                {
                                                    <div class="rw-scenario-field">
                                                        <label class="rw-scenario-field-label">System Prompt</label>
                                                        <div class="rw-info-value-mono rw-prompt-viewer">@sdDetail.PromptSystem</div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(sdDetail.PromptUser))
                                                {
                                                    <div class="rw-scenario-field" style="margin-top:12px;">
                                                        <label class="rw-scenario-field-label">User Prompt</label>
                                                        <div class="rw-info-value-mono rw-prompt-viewer">@sdDetail.PromptUser</div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="rw-semantic-detail-empty">Prompt data is not available for this record.</div>
                                            }
                                        }
                                        else if (_semanticDetailTab == "response")
                                        {
                                            @if (sdDetail is not null && !string.IsNullOrWhiteSpace(sdDetail.InferenceRawOutput))
                                            {
                                                <div class="rw-info-value-mono rw-prompt-viewer">@sdDetail.InferenceRawOutput</div>
                                            }
                                            else
                                            {
                                                <div class="rw-semantic-detail-empty">Raw response data is not available for this record.</div>
                                            }
                                        }
                                        else if (sdDetail is not null)
                                        {
                                            <div class="rw-info-grid" style="margin-bottom:12px;">
                                                <div class="rw-info-row"><span class="rw-info-label">Actor</span><span class="rw-info-value">@sdDetail.ActorName</span></div>
                                                <div class="rw-info-row"><span class="rw-info-label">Analyzed</span><span class="rw-info-value">@sdDetail.CompletedUtc.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                                                <div class="rw-info-row"><span class="rw-info-label">Events matched</span><span class="rw-info-value">@sdDetail.InferredEventCount</span></div>
                                                <div class="rw-info-row"><span class="rw-info-label">Context turns</span><span class="rw-info-value">@sdDetail.ContextTurnsCount</span></div>
                                            </div>
                                            @if (sdDetail.InferredEvents.Count > 0)
                                            {
                                                <table class="rw-semantic-event-table">
                                                    <thead>
                                                        <tr class="rw-semantic-event-header">
                                                            <th>Event</th>
                                                            <th>Conf.</th>
                                                            <th>Actors</th>
                                                            <th>Stat</th>
                                                            <th>Δ</th>
                                                            <th>Evidence</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var row in sdEventStatRows)
                                                        {
                                                            var deltaClass = row.Delta > 0 ? "rw-semantic-event-delta-pos"
                                                                : row.Delta < 0 ? "rw-semantic-event-delta-neg"
                                                                : "rw-semantic-event-delta-zero";
                                                            var deltaFmt = row.TargetStat == "—" ? "—"
                                                                : row.Delta.ToString("+0.#;-0.#;0", CultureInfo.InvariantCulture);
                                                            <tr class="rw-semantic-event-row">
                                                                <td class="rw-semantic-event-id">
                                                                    @if (row.IsFirstOfEvent)
                                                                    {
                                                                        @row.EventId
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="rw-semantic-event-id-repeat">↳</span>
                                                                    }
                                                                </td>
                                                                <td class="rw-semantic-event-conf">
                                                                    @if (row.IsFirstOfEvent)
                                                                    {
                                                                        @row.Confidence.ToString("P0")
                                                                    }
                                                                </td>
                                                                <td class="rw-semantic-event-actors">
                                                                    @if (row.IsFirstOfEvent)
                                                                    {
                                                                        if (!string.IsNullOrWhiteSpace(row.ActorName))
                                                                        {
                                                                            <span>@row.ActorName</span>
                                                                        }
                                                                        if (!string.IsNullOrWhiteSpace(row.TargetCharacterName))
                                                                        {
                                                                            <span class="rw-semantic-event-target">→ @row.TargetCharacterName</span>
                                                                        }
                                                                    }
                                                                </td>
                                                                <td class="rw-semantic-event-stat">@row.TargetStat</td>
                                                                <td class="rw-semantic-event-delta @deltaClass">@deltaFmt</td>
                                                                <td class="rw-semantic-event-evidence">
                                                                    @if (row.IsFirstOfEvent)
                                                                    {
                                                                        @(row.EvidenceSpan ?? "—")
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <div class="rw-semantic-detail-empty">No semantic events matched for this interaction.</div>
                                            }
                                        }
                                        else if (sdState.Status == SemanticAnalysisStatus.Complete)
                                        {
                                            <div class="rw-semantic-detail-empty">Event details are not available for this record.</div>
                                        }
                                        else if (sdState.Status == SemanticAnalysisStatus.Analyzing)
                                        {
                                            <div class="rw-semantic-detail-empty">Analysis is still in progress…</div>
                                        }
                                    </div>
                                    <div class="rw-modal-actions">
                                        <button class="rw-btn rw-btn-secondary" @onclick="CloseSemanticDetail">Close</button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @* ─── Memory Info Modal ─── *@
                    @if (_memoryInfoPopupId is not null && _v2State is not null)
                    {
                        var memRecord = _v2State.EncounterSummaries.FirstOrDefault(e => e.Id == _memoryInfoPopupId);
                        if (memRecord is not null)
                        {
                            <div class="rw-modal-overlay" @onclick='() => _memoryInfoPopupId = null'>
                                <div class="rw-modal rw-modal-info" @onclick:stopPropagation>
                                    <div class="rw-modal-header">
                                        <span class="rw-modal-title">Memory Info</span>
                                        <div class="rw-modal-tabs">
                                            <button class="rw-tab @(_memoryInfoPopupTab == "summary" ? "rw-tab-active" : "")" @onclick='() => _memoryInfoPopupTab = "summary"'>Summary</button>
                                            <button class="rw-tab @(_memoryInfoPopupTab == "prompt" ? "rw-tab-active" : "")" @onclick='() => _memoryInfoPopupTab = "prompt"'>LLM Prompt</button>
                                            <button class="rw-tab @(_memoryInfoPopupTab == "info" ? "rw-tab-active" : "")" @onclick='() => _memoryInfoPopupTab = "info"'>Info</button>
                                        </div>
                                    </div>
                                    <div class="rw-modal-body">
                                        @if (_memoryInfoPopupTab == "summary")
                                        {
                                            <div class="rw-info-value" style="white-space: pre-wrap;">@memRecord.ActiveSummary</div>
                                        }
                                        @if (_memoryInfoPopupTab == "prompt")
                                        {
                                            @if (!string.IsNullOrWhiteSpace(memRecord.EnrichmentPrompt))
                                            {
                                                <div style="margin-bottom: 0.5rem;">
                                                    <button class="rw-btn rw-btn-secondary" @onclick='() => CopyPromptToClipboard(memRecord.EnrichmentPrompt!)'>
                                                        <i class="fas fa-copy"></i> Copy to Clipboard
                                                    </button>
                                                </div>
                                                <div class="rw-info-value-mono rw-prompt-viewer">@memRecord.EnrichmentPrompt</div>
                                            }
                                            else
                                            {
                                                <div class="rw-info-value" style="font-style: italic; color: #888;">
                                                    No prompt data — enrichment has not run yet.
                                                </div>
                                            }
                                        }
                                        @if (_memoryInfoPopupTab == "info")
                                        {
                                            <div class="rw-info-grid">
                                                <div class="rw-info-row"><span class="rw-info-label">Type</span><span class="rw-info-value">@memRecord.SummaryType</span></div>
                                                <div class="rw-info-row"><span class="rw-info-label">Character</span><span class="rw-info-value">@memRecord.CharacterId</span></div>
                                                <div class="rw-info-row"><span class="rw-info-label">Phases</span><span class="rw-info-value">@memRecord.FromPhase → @memRecord.ToPhase</span></div>
                                                <div class="rw-info-row"><span class="rw-info-label">Arc</span><span class="rw-info-value">@(memRecord.CycleIndex + 1)</span></div>
                                                @if (memRecord.EncounterNumber > 0)
                                                {
                                                    <div class="rw-info-row"><span class="rw-info-label">Encounter</span><span class="rw-info-value">#@memRecord.EncounterNumber</span></div>
                                                }
                                                <div class="rw-info-row"><span class="rw-info-label">Occurred</span><span class="rw-info-value">@memRecord.OccurredUtc.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                                                <div class="rw-info-row"><span class="rw-info-label">Enhanced</span><span class="rw-info-value">@(memRecord.IsEnhanced ? "Yes" : "No")</span></div>
                                                @if (memRecord.LlmEnhancedUtc is not null)
                                                {
                                                    <div class="rw-info-row"><span class="rw-info-label">Enhanced At</span><span class="rw-info-value">@memRecord.LlmEnhancedUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                                                }
                                                <div class="rw-info-row"><span class="rw-info-label">Turns in Phase</span><span class="rw-info-value">@memRecord.TurnCountInPhase</span></div>
                                                @if (!string.IsNullOrWhiteSpace(memRecord.SceneLocation))
                                                {
                                                    <div class="rw-info-row"><span class="rw-info-label">Scene</span><span class="rw-info-value">@memRecord.SceneLocation</span></div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="rw-modal-actions">
                                        <button class="rw-btn rw-btn-secondary" @onclick='() => _memoryInfoPopupId = null'>Close</button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (ShowPendingResponseIndicator)
                    {
                        <RolePlayPendingResponse @ref="_pendingResponseComponent" Label="@_pendingResponseLabel" />
                    }
                }
            </div>

            @* --- Portal: Retry dropdown menu (fixed position, escapes scroll container) --- *@
            @if (_retryMenuInteractionId is not null)
            {
                var retryId = _retryMenuInteractionId;
                <div class="rw-menu-backdrop" @onclick="@(() => { _retryMenuInteractionId = null; })"></div>
                <div class="rw-dropdown-menu rw-dropdown-fixed" style="top: @(_menuPosition.Top)px; left: @(_menuPosition.Left)px;">
                    <button class="rw-dropdown-item" @onclick="@(() => RetryAsync(retryId))">
                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/><path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/></svg>
                        Retry
                    </button>
                    <div class="rw-dropdown-submenu">
                        <button class="rw-dropdown-item rw-has-submenu">
                            <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/><path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/></svg>
                            Retry with model
                            <span class="rw-submenu-arrow">&#x25B6;</span>
                        </button>
                        <div class="rw-dropdown-submenu-content">
                            @if (_availableModels is not null)
                            {
                                @foreach (var model in _availableModels)
                                {
                                    <button class="rw-dropdown-item" @onclick="@(() => RetryWithModelAsync(retryId, model.Id))">@model.DisplayName</button>
                                }
                            }
                        </div>
                    </div>
                    <div class="rw-dropdown-submenu">
                        <button class="rw-dropdown-item rw-has-submenu">
                            <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/><path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/></svg>
                            Retry as...
                            <span class="rw-submenu-arrow">&#x25B6;</span>
                        </button>
                        <div class="rw-dropdown-submenu-content">
                            <button class="rw-dropdown-item" @onclick="@(() => RetryAsAsync(retryId, ContinueAsActor.Npc, "Narrative"))">
                                <span class="rw-identity-initial">&#x1F4D6;</span> Narrative
                            </button>
                            @if (_identityOptions is not null)
                            {
                                @foreach (var identity in _identityOptions)
                                {
                                    <button class="rw-dropdown-item" @onclick="@(() => RetryAsAsync(retryId, identity.Actor, identity.DisplayName))">
                                        <span class="rw-identity-initial">@GetInitial(identity.DisplayName)</span> @identity.DisplayName
                                    </button>
                                }
                            }
                        </div>
                    </div>
                    <button class="rw-dropdown-item" @onclick="@(() => MakeLongerAsync(retryId))">
                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="12" x2="18" y2="12"/><line x1="3" y1="16" x2="15" y2="16"/></svg>
                        Make longer
                    </button>
                    <button class="rw-dropdown-item" @onclick="@(() => MakeShorterAsync(retryId))">
                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="8" x2="18" y2="8"/><line x1="3" y1="12" x2="13" y2="12"/><line x1="3" y1="16" x2="8" y2="16"/></svg>
                        Make shorter
                    </button>
                    <button class="rw-dropdown-item" @onclick="@(() => ShowRewriteDialog(retryId))">
                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        Ask to rewrite
                    </button>
                </div>
            }

            @* --- Portal: Kebab dropdown menu (fixed position, escapes scroll container) --- *@
            @if (_kebabMenuInteractionId is not null && _session is not null)
            {
                var kebabId = _kebabMenuInteractionId;
                var kebabInteraction = _session.Interactions.FirstOrDefault(i => i.Id == kebabId);
                var kebabOriginalId = kebabInteraction?.ParentInteractionId ?? kebabId;
                <div class="rw-menu-backdrop" @onclick="@(() => { _kebabMenuInteractionId = null; })"></div>
                <div class="rw-dropdown-menu rw-dropdown-fixed" style="top: @(_menuPosition.Top)px; left: @(_menuPosition.Left)px;">
                    @if (kebabInteraction is not null)
                    {
                        <button class="rw-dropdown-item rw-flag-toggle" @onclick="@(() => ToggleFlagAsync(kebabId, InteractionFlag.Excluded))"
                                title="Excluded interactions are not sent to the AI, but are still visible in the user interface.">
                            <span class="rw-flag-check">@(kebabInteraction.IsExcluded ? "✓" : string.Empty)</span>
                            <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                            Excluded
                        </button>
                        <button class="rw-dropdown-item rw-flag-toggle" @onclick="@(() => ToggleFlagAsync(kebabId, InteractionFlag.Pinned))"
                                title="Pinned interactions are always included in AI context.">
                            <span class="rw-flag-check">@(kebabInteraction.IsPinned ? "✓" : string.Empty)</span>
                            <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v8l4 4v2H8v-2l4-4V2z"/><line x1="8" y1="22" x2="16" y2="22"/></svg>
                            Pinned
                        </button>
                        <button class="rw-dropdown-item rw-flag-toggle" @onclick="@(() => ToggleFlagAsync(kebabId, InteractionFlag.Hidden))"
                                title="Hiding will hide the interactions from the user interface, but will still be sent to the AI.">
                            <span class="rw-flag-check">@(kebabInteraction.IsHidden ? "✓" : string.Empty)</span>
                            <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            Hidden
                        </button>
                    }
                    <div class="rw-dropdown-separator"></div>
                    <button class="rw-dropdown-item" @onclick="@(() => ForkAboveAsync(kebabOriginalId))">
                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17l5-5 5 5"/><path d="M7 7h10"/></svg>
                        Fork Here &amp; Above
                    </button>
                    <button class="rw-dropdown-item" @onclick="@(() => ForkBelowAsync(kebabOriginalId))">
                        <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7l5 5 5-5"/><path d="M7 17h10"/></svg>
                        Fork Here &amp; Below
                    </button>
                </div>
            }

            
            <div class="rw-prompt-area" @onclick:stopPropagation>

                @* T024: Background-processing indicator (B-027) *@
                @if (_backgroundSubmissionRunning)
                {
                    <div class="rw-bg-processing-bar">
                        <span class="rw-spinner rw-spinner--sm"></span>
                        <span>Response processing in background…</span>
                    </div>
                }


                @if (_intentPopupOpen)
                {
                    <div class="rw-popup rw-intent-popup">
                        <button class="rw-popup-item @(_selectedIntent == PromptIntent.Message ? "is-selected" : "")"
                                @onclick="@(() => SelectIntent(PromptIntent.Message))">
                            <div class="rw-popup-item-content">
                                <span class="rw-popup-item-title">Message</span>
                                <span class="rw-popup-item-desc">Act as one of the characters</span>
                            </div>
                            @if (_selectedIntent == PromptIntent.Message)
                            {
                                <span class="rw-popup-check">?</span>
                            }
                        </button>
                        <button class="rw-popup-item @(_selectedIntent == PromptIntent.Narrative ? "is-selected" : "")"
                                @onclick="@(() => SelectIntent(PromptIntent.Narrative))">
                            <div class="rw-popup-item-content">
                                <span class="rw-popup-item-title">Narrative by Character</span>
                                <span class="rw-popup-item-desc">Expand tone or phrase from selected character POV</span>
                            </div>
                            @if (_selectedIntent == PromptIntent.Narrative)
                            {
                                <span class="rw-popup-check">?</span>
                            }
                        </button>
                        <button class="rw-popup-item @(_selectedIntent == PromptIntent.Instruction ? "is-selected" : "")"
                                @onclick="@(() => SelectIntent(PromptIntent.Instruction))">
                            <div class="rw-popup-item-content">
                                <span class="rw-popup-item-title">Instruction</span>
                                <span class="rw-popup-item-desc">Tell the AI what to do</span>
                            </div>
                            @if (_selectedIntent == PromptIntent.Instruction)
                            {
                                <span class="rw-popup-check">?</span>
                            }
                        </button>
                    </div>
                }

                
                @if (_identityPopupOpen)
                {
                    <div class="rw-popup rw-identity-popup">
                        <div class="rw-popup-header">
                            <span class="rw-popup-intent-label">@IntentLabel</span>
                        </div>
                        <div class="rw-identity-list">
                            @foreach (var option in _identityOptions)
                            {
                                <button class="rw-identity-item @(option.Id == _selectedIdentity?.Id ? "is-selected" : "") @(IsIdentityOptionDisabled(option) ? "is-disabled" : "")"
                                        @onclick="@(() => SelectIdentity(option))"
                                        disabled="@(IsIdentityOptionDisabled(option))"
                                        title="@GetIdentityOptionTitle(option)">
                                    <span class="rw-identity-badge">@GetInitial(option.DisplayName)</span>
                                    <span class="rw-identity-name">@option.DisplayName</span>
                                    @if (option.Id == _selectedIdentity?.Id)
                                    {
                                        <span class="rw-popup-check">?</span>
                                    }
                                </button>
                            }
                        </div>
                        @if (_showCustomInput)
                        {
                            <div class="rw-custom-name-row">
                                <input class="rw-custom-name-input" placeholder="Character name..."
                                       @bind="_customIdentityName" @bind:event="oninput" />
                            </div>
                        }
                    </div>
                }

                <div class="rw-continue-row">
                    <span class="rw-continue-label">Continue As</span>
                    <button class="rw-continue-chip @(HasPersonaContinueSelection && !_continueIncludeNarrative ? "is-active" : string.Empty)"
                            @onclick="ContinueAsYouQuickAsync"
                            disabled="@IsSelectionUiLocked"
                            @onclick:stopPropagation>
                        You
                    </button>
                    <button class="rw-continue-chip @(HasNpcContinueSelection && _continueIncludeNarrative ? "is-active" : string.Empty)"
                            @onclick="ContinueAsNpcQuickAsync"
                            disabled="@IsSelectionUiLocked"
                            @onclick:stopPropagation>
                        NPC
                    </button>
                    <button class="rw-continue-chip rw-continue-chip-custom @((HasCustomContinueSelection || ContinueSelectionCount > 0 || _continueIncludeNarrative || _continueCustomPopupOpen) ? "is-active" : string.Empty)"
                            @onclick="ToggleContinueCustomPopup"
                            disabled="@IsSelectionUiLocked"
                            @onclick:stopPropagation>
                        Custom
                    </button>
                    <button class="rw-continue-chip @(_continuationSettingsPopupOpen ? "is-active" : string.Empty)"
                            @onclick="OpenContinuationSettingsPopupAsync"
                            disabled="@IsSelectionUiLocked"
                            @onclick:stopPropagation>
                        Settings
                    </button>
                        <button type="button"
                            class="rw-continue-chip"
                            @onclick="OpenNextPhasePopupAsync"
                            disabled="@(!IsNextPhaseEligible || IsNextPhaseUiLocked)"
                            @onclick:preventDefault
                            @onclick:stopPropagation>
                        Next Phase
                    </button>
                        <button type="button"
                            class="rw-continue-chip"
                            @onclick="OpenSteerPopupAsync"
                            disabled="@(!IsSteerEligible || IsSteerUiLocked)"
                            @onclick:preventDefault
                            @onclick:stopPropagation>
                        Steer
                    </button>
                        <button type="button"
                            class="rw-continue-chip rw-finish-chip @(_finishPopupOpen ? "is-active" : string.Empty)"
                            @onclick="OpenFinishPopupAsync"
                            disabled="@(!IsClimaxPhase || IsFinishUiLocked)"
                            @onclick:preventDefault
                            @onclick:stopPropagation>
                        Finish
                    </button>
                </div>

                @if (_continueCustomPopupOpen)
                {
                    <div class="rw-popup rw-continue-custom-popup">
                        <div class="rw-popup-header">
                            <span class="rw-popup-intent-label">continue as custom</span>
                        </div>
                        <div class="rw-continue-options-row">
                            <button class="rw-popup-action-btn @(_continueIncludeNarrative ? "is-primary" : string.Empty)"
                                    disabled="@IsSelectionUiLocked"
                                    @onclick="ToggleContinueNarrative">
                                Narrative @(_continueIncludeNarrative ? "✓" : string.Empty)
                            </button>
                            @if (ContinueCustomIdentityOption is not null)
                            {
                                <button class="rw-popup-action-btn @(HasCustomContinueSelection ? "is-primary" : string.Empty)"
                                        disabled="@IsSelectionUiLocked"
                                        @onclick="SelectContinueCustomIdentityShortcut">
                                    Custom @((HasCustomContinueSelection) ? "✓" : string.Empty)
                                </button>
                            }
                        </div>
                        <div class="rw-identity-list rw-continue-identity-list">
                            @foreach (var option in _identityOptions)
                            {
                                <button class="rw-identity-item @(IsContinueIdentitySelected(option) ? "is-selected" : string.Empty) @(IsSelectionUiLocked ? "is-disabled" : "")"
                                        disabled="@IsSelectionUiLocked"
                                        @onclick="@(() => ToggleContinueIdentitySelection(option.Id))">
                                    <span class="rw-identity-badge">@GetInitial(option.DisplayName)</span>
                                    <span class="rw-identity-name">@option.DisplayName</span>
                                    @if (IsContinueIdentitySelected(option))
                                    {
                                        <span class="rw-popup-check">?</span>
                                    }
                                </button>
                            }
                        </div>
                        @if (HasCustomContinueSelection || _continueSelectedIdentityIds.Any(id => 
                            _identityOptions.FirstOrDefault(o => o.Id == id)?.SourceType == IdentityOptionSource.CustomCharacter))
                        {
                            <div class="rw-custom-name-row">
                                <input class="rw-custom-name-input" placeholder="Character name..."
                                       @bind="_customIdentityName" @bind:event="oninput" disabled="@IsSelectionUiLocked" />
                            </div>
                        }
                        <div class="rw-popup-actions rw-continue-popup-actions">
                            <button class="rw-popup-action-btn"
                                    disabled="@_isSubmitting"
                                    @onclick="ClearContinueAsAsync">Clear</button>
                            <button class="rw-popup-action-btn is-primary"
                                    disabled="@_isSubmitting"
                                    @onclick="ContinueFromIdentityPopupAsync">Continue</button>
                        </div>
                    </div>
                }

                @if (_continuationSettingsPopupOpen)
                {
                    <div class="rw-modal-overlay" @onclick="CancelContinuationSettingsPopup">
                        <ContinuationSettingsPopup CurrentPhase="@CurrentNarrativePhase"
                                                  EffectiveDirection="@_effectiveSceneDirection"
                                                  EffectiveMultiEncounter="@_effectiveMultiEncounter"
                                                  EffectiveAftermath="@_effectiveAftermath"
                                                  EffectiveWordMin="@_effectiveWordMin"
                                                  EffectiveWordMax="@_effectiveWordMax"
                                                  CurrentOverride="@(_session?.ContinuationOverride)"
                                                  OnSave="SaveContinuationOverrideAsync"
                                                  OnClear="ClearContinuationOverrideAsync"
                                                  OnCancel="CancelContinuationSettingsPopup" />
                    </div>
                }

                @if (_finishPopupOpen)
                {
                    <div class="rw-popup rw-finish-popup">
                        <div class="rw-popup-header">
                            <span class="rw-popup-intent-label">finish (@(_finishUseGuidedFlow ? "finishing move" : "finish"))</span>
                        </div>
                        <div class="rw-popup-actions rw-finish-popup-actions">
                                <button type="button"
                                    class="rw-popup-action-btn @(!_finishUseGuidedFlow ? "is-primary" : string.Empty)"
                                    disabled="@_finishOptionSubmitting"
                                    @onclick="@(() => SetFinishFlowAsync(false))">Finish</button>
                                <button type="button"
                                    class="rw-popup-action-btn @(_finishUseGuidedFlow ? "is-primary" : string.Empty)"
                                    disabled="@_finishOptionSubmitting"
                                    @onclick="@(() => SetFinishFlowAsync(true))">Finishing Move</button>
                        </div>
                        <div class="rw-finish-popup-body">
                            @if (_finishOptionsLoading)
                            {
                                <div class="rw-finish-loading">Generating ending options...</div>
                            }
                            else if (_finishOptionPages.Count == 0)
                            {
                                <div class="rw-finish-loading">No options yet.</div>
                            }
                            else
                            {
                                @if (_finishOptionPages.Count > 1)
                                {
                                    <div class="rw-steer-pager">
                                        <button class="rw-steer-pager-btn" disabled="@(_finishPageIndex == 0 || _finishOptionSubmitting || _finishOptionsLoading)" @onclick="@(() => { _finishPageIndex--; _selectedFinishOption = CurrentFinishPage[0]; })">&#x2039;</button>
                                        <span class="rw-steer-pager-label">Set @(_finishPageIndex + 1) / @_finishOptionPages.Count</span>
                                        <button class="rw-steer-pager-btn" disabled="@(_finishPageIndex == _finishOptionPages.Count - 1 || _finishOptionSubmitting || _finishOptionsLoading)" @onclick="@(() => { _finishPageIndex++; _selectedFinishOption = CurrentFinishPage[0]; })">&#x203a;</button>
                                    </div>
                                }
                                @foreach (var option in CurrentFinishPage)
                                {
                                        <button type="button"
                                            class="rw-popup-item @(string.Equals(_selectedFinishOption, option, StringComparison.Ordinal) ? "is-selected" : string.Empty)"
                                            disabled="@_finishOptionSubmitting"
                                            @onclick="@(() => _selectedFinishOption = option)">
                                        <div class="rw-popup-item-content">
                                            <span class="rw-popup-item-title">@option</span>
                                        </div>
                                        @if (string.Equals(_selectedFinishOption, option, StringComparison.Ordinal))
                                        {
                                            <span class="rw-popup-check">?</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_finishOptionError))
                        {
                            <div class="rw-finish-error">@_finishOptionError</div>
                        }
                        <div class="rw-popup-toggle-row">
                            <label class="rw-popup-toggle-label">
                                <input type="checkbox" @bind="_finishEndClimax" disabled="@_finishOptionSubmitting" />
                                End Climax (transition to Reset)
                            </label>
                        </div>
                        <div class="rw-popup-actions rw-finish-popup-actions">
                                <button type="button"
                                    class="rw-popup-action-btn"
                                    disabled="@_finishOptionSubmitting"
                                    @onclick="CloseFinishPopup">Cancel</button>
                                <button type="button"
                                    class="rw-popup-action-btn"
                                    disabled="@(_finishOptionSubmitting || _finishOptionsLoading)"
                                    @onclick="GenerateFinishOptionsAsync">@(_finishOptionPages.Count == 0 ? "Generate" : "Regenerate")</button>
                                <button type="button"
                                    class="rw-popup-action-btn is-primary"
                                    disabled="@(_finishOptionSubmitting || _finishOptionsLoading || string.IsNullOrWhiteSpace(_selectedFinishOption))"
                                    @onclick="ApplyFinishOptionAsync">@(_finishEndClimax ? "Finish Scene" : "Write Move")</button>
                        </div>
                    </div>
                }

                @if (_nextPhasePopupOpen)
                {
                    <div class="rw-popup rw-finish-popup">
                        <div class="rw-popup-header">
                            <span class="rw-popup-intent-label">next phase</span>
                        </div>
                        <div class="rw-finish-popup-body">
                            @if (_nextPhaseOptionsLoading)
                            {
                                <div class="rw-finish-loading">Generating transition options...</div>
                            }
                            else if (_nextPhaseOptions.Count == 0)
                            {
                                <div class="rw-finish-loading">No options yet.</div>
                            }
                            else
                            {
                                @foreach (var option in _nextPhaseOptions)
                                {
                                    <button class="rw-popup-item @(string.Equals(_selectedNextPhaseOption, option, StringComparison.Ordinal) ? "is-selected" : string.Empty)"
                                            disabled="@_nextPhaseOptionSubmitting"
                                            @onclick="@(() => _selectedNextPhaseOption = option)">
                                        <div class="rw-popup-item-content">
                                            <span class="rw-popup-item-title">@option</span>
                                        </div>
                                        @if (string.Equals(_selectedNextPhaseOption, option, StringComparison.Ordinal))
                                        {
                                            <span class="rw-popup-check">?</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_nextPhaseOptionError))
                        {
                            <div class="rw-finish-error">@_nextPhaseOptionError</div>
                        }
                        <div class="rw-popup-actions rw-finish-popup-actions">
                            <button class="rw-popup-action-btn"
                                    disabled="@_nextPhaseOptionSubmitting"
                                    @onclick="CloseNextPhasePopup">Cancel</button>
                            <button class="rw-popup-action-btn"
                                    disabled="@(_nextPhaseOptionSubmitting || _nextPhaseOptionsLoading)"
                                    @onclick="GenerateNextPhaseOptionsAsync">Regenerate</button>
                            <button class="rw-popup-action-btn is-primary"
                                    disabled="@(_nextPhaseOptionSubmitting || _nextPhaseOptionsLoading || string.IsNullOrWhiteSpace(_selectedNextPhaseOption))"
                                    @onclick="ApplyNextPhaseOptionAsync">Advance</button>
                        </div>
                    </div>
                }

                @if (_steerPopupOpen)
                {
                    <div class="rw-modal-overlay rw-steer-overlay" @onclick="CloseSteerPopup">
                        <div class="rw-popup rw-finish-popup rw-steer-popup rw-steer-overlay-popup" @onclick:stopPropagation>
                        <div class="rw-popup-header">
                            <span class="rw-popup-intent-label">steer (@(_steerUseGuidedFlow ? "position" : "direction"))</span>
                            @if (!string.IsNullOrWhiteSpace(_cachedSteerGenerationId))
                            {
                                <button class="rw-steer-view-prompt-btn" @onclick="ViewSteerPromptAsync" @onclick:stopPropagation title="View generation prompt and response">View Prompt</button>
                            }
                        </div>
                        @if (!_steerUseGuidedFlow)
                        {
                            <div class="rw-popup-actions rw-finish-popup-actions" style="padding: 0 12px 6px;">
                                <select class="form-select" style="width:100%"
                                        value="@_steerTargetCharacterId"
                                        disabled="@(_steerOptionSubmitting || _steerOptionsLoading)"
                                        @onchange="@(args => {
                                            _steerTargetCharacterId = args.Value?.ToString() ?? string.Empty;
                                            var match = SteerableTargets.FirstOrDefault(t => t.CharacterId == _steerTargetCharacterId);
                                            _steerTargetCharacterLabel = match.CharacterName;
                                            RefreshLocalSteerPages();
                                        })">
                                    @if (SteerableTargets.Count == 0)
                                    {
                                        <option value="">No characters available</option>
                                    }
                                    else
                                    {
                                        @foreach (var target in SteerableTargets)
                                        {
                                            <option value="@target.CharacterId" selected="@(target.CharacterId == _steerTargetCharacterId)">
                                                @target.CharacterName @(target.Role is not null ? $"({target.Role})" : "")
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        <div class="rw-finish-popup-body">
                            @if (_steerOptionsLoading)
                            {
                                <div class="rw-finish-loading">Generating steering options...</div>
                            }
                            else if (_steerOptionPages.Count == 0)
                            {
                                <div class="rw-finish-loading">Generating steering options in background...</div>
                            }
                            else
                            {
                                @if (_steerOptionPages.Count > 1)
                                {
                                    <div class="rw-steer-pager">
                                        <button class="rw-steer-pager-btn" disabled="@(_steerPageIndex == 0 || _steerOptionSubmitting || _steerOptionsLoading)" @onclick="@(() => { _steerPageIndex--; _selectedSteerOption = CurrentSteerPage[0]; })">←</button>
                                        <span class="rw-steer-pager-label">Set @(_steerPageIndex + 1) / @_steerOptionPages.Count</span>
                                        <button class="rw-steer-pager-btn" disabled="@(_steerPageIndex == _steerOptionPages.Count - 1 || _steerOptionSubmitting || _steerOptionsLoading)" @onclick="@(() => { _steerPageIndex++; _selectedSteerOption = CurrentSteerPage[0]; })">→</button>
                                    </div>
                                }
                                @if (!_steerUseGuidedFlow && CurrentSteerPage.Count == 4)
                                {
                                    var dirLabels = new[] { "Away", "Neutral", "Towards", "Hard" };
                                    for (int i = 0; i < 4; i++)
                                    {
                                        var option = CurrentSteerPage[i];
                                        var dirLabel = dirLabels[i];
                                        <button class="rw-popup-item rw-steer-dir-item @(string.Equals(_selectedSteerOption, option, StringComparison.Ordinal) ? "is-selected" : string.Empty)"
                                                disabled="@_steerOptionSubmitting"
                                                @onclick="@(() => _selectedSteerOption = option)">
                                            <span class="rw-steer-dir-badge">@dirLabel</span>
                                            <div class="rw-popup-item-content">
                                                <span class="rw-popup-item-title">@option</span>
                                            </div>
                                            @if (string.Equals(_selectedSteerOption, option, StringComparison.Ordinal))
                                            {
                                                <span class="rw-popup-check">✓</span>
                                            }
                                        </button>
                                    }
                                }
                                else
                                {
                                    @foreach (var option in CurrentSteerPage)
                                    {
                                        <button class="rw-popup-item @(string.Equals(_selectedSteerOption, option, StringComparison.Ordinal) ? "is-selected" : string.Empty)"
                                                disabled="@_steerOptionSubmitting"
                                                @onclick="@(() => _selectedSteerOption = option)">
                                            <div class="rw-popup-item-content">
                                                <span class="rw-popup-item-title">@option</span>
                                            </div>
                                            @if (string.Equals(_selectedSteerOption, option, StringComparison.Ordinal))
                                            {
                                                <span class="rw-popup-check">✓</span>
                                            }
                                        </button>
                                    }
                                }
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_steerOptionError))
                        {
                            <div class="rw-finish-error">@_steerOptionError</div>
                        }
                        @if (!_steerUseGuidedFlow && !string.IsNullOrWhiteSpace(_selectedSteerOption))
                        {
                            <div class="rw-steer-preview" style="padding: 8px 12px; font-size: 0.85rem; color: var(--bs-secondary-color); border-top: 1px solid var(--bs-border-color);">
                                <strong>Preview:</strong> Target: @_steerTargetCharacterLabel · Direction: @(CurrentSteerPage.IndexOf(_selectedSteerOption) switch { 0 => "Away", 1 => "Neutral", 2 => "Towards", 3 => "Hard", _ => "?" })<br/>
                                Directive: "@_selectedSteerOption"
                            </div>
                        }
                        <div class="rw-popup-actions rw-finish-popup-actions">
                            <button class="rw-popup-action-btn @(!_steerUseGuidedFlow ? "is-primary" : string.Empty)"
                                disabled="@(_steerOptionSubmitting || _steerOptionsLoading)"
                                @onclick="@(() => SetSteerFlowAsync(false))">Direction</button>
                            <button class="rw-popup-action-btn @(_steerUseGuidedFlow ? "is-primary" : string.Empty)"
                                disabled="@(_steerOptionSubmitting || _steerOptionsLoading)"
                                @onclick="@(() => SetSteerFlowAsync(true))">Position</button>
                            <button class="rw-popup-action-btn"
                                    disabled="@_steerOptionSubmitting"
                                    @onclick="CloseSteerPopup">Cancel</button>
                            <button class="rw-popup-action-btn"
                                    disabled="@(_steerOptionSubmitting || _steerOptionsLoading || _isAwaitingModelResponse || _isSubmitting)"
                                    @onclick="GenerateSteerOptionsAsync">@(_steerOptionPages.Count == 0 ? "Generate" : "Regenerate")</button>
                            <button class="rw-popup-action-btn is-primary"
                                    disabled="@(_steerOptionSubmitting || _steerOptionsLoading || string.IsNullOrWhiteSpace(_selectedSteerOption))"
                                    @onclick="ApplySteerOptionAsync">Apply Steer</button>
                        </div>
                        </div>
                    </div>
                }

                @if (_viewSteerPromptOpen)
                {
                    <div class="rw-modal-overlay" @onclick="@(() => _viewSteerPromptOpen = false)">
                        <div class="rw-modal rw-steer-prompt-modal" @onclick:stopPropagation>
                            <div class="rw-modal-header">
                                <span>Steering Generation Prompt & Response</span>
                                <button class="rw-modal-close-btn" @onclick="@(() => _viewSteerPromptOpen = false)">×</button>
                            </div>
                            <div class="rw-modal-body rw-steer-prompt-body">
                                <div class="rw-steer-prompt-section">
                                    <div class="rw-steer-prompt-section-header">Generation Prompt</div>
                                    <pre class="rw-steer-prompt-text">@_viewSteerPromptText</pre>
                                </div>
                                <div class="rw-steer-prompt-section">
                                    <div class="rw-steer-prompt-section-header">Raw Response</div>
                                    <pre class="rw-steer-prompt-text">@_viewSteerResponseText</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                
                <div class="rw-input-row">
                    @if (_selectedIntent == PromptIntent.Message)
                    {
                        <button class="rw-identity-btn rw-identity-btn-outside @(_selectedIdentity is not null ? "has-selection" : string.Empty)"
                                @onclick="ToggleIdentityPopup"
                                @onclick:stopPropagation
                                title="Select character: @CurrentIdentityLabel">
                            <span class="rw-identity-btn-initial">@CurrentIdentityInitial</span>
                        </button>
                    }

                    <div class="rw-prompt-box">
                        <textarea class="rw-prompt-textarea"
                                  placeholder="Write something..."
                                  rows="2"
                                  @bind="_promptText"
                                  @bind:event="oninput"
                                  disabled="@IsSelectionUiLocked"></textarea>
                        <div class="rw-prompt-toolbar">
                            <div class="rw-toolbar-left">
                                <button class="rw-intent-btn" @onclick="ToggleIntentPopup" @onclick:stopPropagation disabled="@IsSelectionUiLocked" title="Change message type">
                                    @IntentLabel <span class="rw-chevron">^</span>
                                </button>
                            </div>
                            <div class="rw-toolbar-right">
                                <button class="rw-add-btn"
                                        @onclick="AddPromptEntryAsync"
                                        disabled="@(!CanAddPromptEntry)"
                                        title="Stage message for later continuation">+</button>
                                <button class="rw-continue-btn"
                                        @onclick="ContinuePromptAsync"
                                        disabled="@(!CanContinue)"
                                        title="Continue with or without text">
                                    @if (_isSubmitting)
                                    {
                                        <span class="rw-spinner"></span>
                                    }
                                    else
                                    {
                                        <span class="rw-continue-ellipsis">…</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

    </div>

    
    <div class="rw-panel-resize-handle" @onclick:stopPropagation title="Resize settings panel"></div>
    <button class="rw-panel-toggle-btn" onclick="rolePlayWorkspace.toggleSettingsPanel(event)" title="Toggle settings panel"></button>
    <div class="rw-settings-panel" @onclick:stopPropagation>

        <div class="rw-settings-tabs">
            <button class="rw-settings-tab @(_activeSettingsTab == "scenario" ? "is-active" : "")"
                    @onclick="@(() => _activeSettingsTab = "scenario")">Scenario</button>
            <button class="rw-settings-tab @(_activeSettingsTab == "settings" ? "is-active" : "")"
                    @onclick="@(() => _activeSettingsTab = "settings")">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" style="margin-right:4px;vertical-align:-1px">
                    <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/>
                    <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.47l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"/>
                </svg>Settings
            </button>
            <button class="rw-settings-tab @(_activeSettingsTab == "assistant" ? "is-active" : "")"
                    @onclick="@(() => _activeSettingsTab = "assistant")">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" style="margin-right:4px;vertical-align:-1px">
                    <path d="M2.678 11.894a1 1 0 0 1 .287.801 10.97 10.97 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8.06 8.06 0 0 0 8 14c3.996 0 7-2.807 7-6 0-3.192-3.004-6-7-6S1 4.808 1 8c0 1.468.617 2.83 1.678 3.894z"/>
                </svg>Assistant
            </button>
            <button class="rw-settings-tab @(_activeSettingsTab == "adaptive" ? "is-active" : "")"
                    @onclick="OnAdaptiveTabClickAsync">
                Adaptive
            </button>
            <button class="rw-settings-tab @(_activeSettingsTab == "autocomplete" ? "is-active" : "")"
                    @onclick="@(() => _activeSettingsTab = "autocomplete")">
                Auto-Complete
            </button>
        </div>

        @if (_session is not null)
        {
            @if (_activeSettingsTab == "settings")
            {
                <div class="rw-settings-content">

                    <div class="rw-settings-section">
                        <div class="rw-settings-section-label">Behaviour</div>
                        <select class="rw-mode-select" @bind="_selectedBehaviorMode" @bind:after="ApplyBehaviorModeAsync">
                            <option value="@BehaviorMode.TakeTurns">⇄  Take Turns</option>
                            <option value="@BehaviorMode.Spectate">◎  Spectate</option>
                            <option value="@BehaviorMode.NpcOnly">▸  NPC Only</option>
                        </select>
                    </div>

                    <div class="rw-settings-section">
                        <div class="rw-settings-section-label">Model Override</div>
                        <ModelSettingsPanel SessionId="@_session.Id" OnSettingsUpdated="OnModelSettingsUpdated" />
                    </div>

                    <div class="rw-settings-section">
                        <div class="rw-settings-section-label">Theme AI Guidance Notes</div>
                        <div class="rw-scenario-field">
                            <label class="rw-scenario-field-label">Enabled</label>
                            <input type="checkbox" checked="@_session.UseThemeAIGuidanceNotesInPrompt" @onchange="OnThemeAIGuidanceEnabledChanged" />
                        </div>
                        @if (_session.UseThemeAIGuidanceNotesInPrompt)
                        {
                            <div class="rw-scenario-field">
                                <label class="rw-scenario-field-label">Max Notes</label>
                                <input type="number" class="rw-settings-input" style="width:70px;"
                                       min="1" max="30"
                                       value="@_session.MaxThemeAIGuidanceNotes"
                                       @onchange="OnThemeAIGuidanceMaxNotesChanged" />
                            </div>
                            <div class="rw-scenario-field">
                                <label class="rw-scenario-field-label">Influence %</label>
                                <input type="number" class="rw-settings-input" style="width:70px;"
                                       min="0" max="100"
                                       value="@_session.ThemeAIGuidanceInfluencePercent"
                                       @onchange="OnThemeAIGuidanceInfluenceChanged" />
                            </div>
                            <div class="text-muted small">&ge;80% = authoritative directives &middot; &ge;50% = strong guidance &middot; &lt;50% = soft hints</div>
                        }
                    </div>

                </div>
            }

            @if (_activeSettingsTab == "scenario")
            {
                <div class="rw-settings-content">
                    <div class="rw-settings-section">
                        <div class="rw-settings-section-label">Session Info</div>
                        <div class="rw-settings-info-row"><span>Status</span><span>@_session.Status</span></div>
                        <div class="rw-settings-info-row"><span>Mode</span><span>@_session.BehaviorMode</span></div>
                        <div class="rw-settings-info-row"><span>Created</span><span>@_session.CreatedAt.ToString("MMM d")</span></div>
                    </div>

                    @if (_loadedScenario is not null)
                    {
                        @* -- Style -- *@
                        <div class="rw-collapsible-section">
                            <button class="rw-collapsible-header" @onclick="@(() => ToggleScenarioSection("style"))">
                                <span class="rw-collapsible-chevron @(_expandedScenarioSections.Contains("style") ? "is-open" : "")">›</span>
                                <span class="rw-collapsible-title">Writing Voice</span>
                            </button>
                            @if (_expandedScenarioSections.Contains("style"))
                            {
                                <div class="rw-collapsible-body">
                                    <div class="text-muted small mb-3">RP Theme Profile controls adaptive theme direction. Writing Style Profile controls prose voice and texture.</div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Writing Style Profile</label>
                                        <select class="rw-mode-select"
                                                value="@_loadedScenario.DefaultSteeringProfileId"
                                                @onchange="@(e => { _loadedScenario.DefaultSteeringProfileId = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString(); MarkScenarioDirty(); })">
                                            <option value="">(None)</option>
                                            @foreach (var style in _steeringProfiles)
                                            {
                                                <option value="@style.Id">@style.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Narrative Tone (legacy)</label>
                                        <input class="rw-settings-input" placeholder="Deprecated — use Tone/Register/Focus below"
                                               value="@_loadedScenario.Narrative.NarrativeTone"
                                               disabled />
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Tone</label>
                                        <input class="rw-settings-input" placeholder="e.g. erotic, conversational, playful"
                                               value="@_loadedScenario.Narrative.Tone"
                                               @onchange="@(e => { _loadedScenario.Narrative.Tone = e.Value?.ToString(); MarkScenarioDirty(); })" />
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Register</label>
                                        <input class="rw-settings-input" placeholder="e.g. low to moderate language complexity"
                                               value="@_loadedScenario.Narrative.Register"
                                               @onchange="@(e => { _loadedScenario.Narrative.Register = e.Value?.ToString(); MarkScenarioDirty(); })" />
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Focus</label>
                                        <input class="rw-settings-input" placeholder="e.g. physical pleasure"
                                               value="@_loadedScenario.Narrative.Focus"
                                               @onchange="@(e => { _loadedScenario.Narrative.Focus = e.Value?.ToString(); MarkScenarioDirty(); })" />
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Prose Style</label>
                                        <input class="rw-settings-input" placeholder="e.g. literary, dialog-driven"
                                               value="@_loadedScenario.Narrative.ProseStyle"
                                               @onchange="@(e => { _loadedScenario.Narrative.ProseStyle = e.Value?.ToString(); MarkScenarioDirty(); })" />
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Point of View</label>
                                        <input class="rw-settings-input" placeholder="e.g. third-person limited"
                                               value="@_loadedScenario.Narrative.PointOfView"
                                               @onchange="@(e => { _loadedScenario.Narrative.PointOfView = e.Value?.ToString(); MarkScenarioDirty(); })" />
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Narrative Guidelines</label>
                                        @for (var i = 0; i < _loadedScenario.Narrative.NarrativeGuidelines.Count; i++)
                                        {
                                            var idx = i;
                                            <div class="rw-list-item-row">
                                                <input class="rw-settings-input" value="@_loadedScenario.Narrative.NarrativeGuidelines[idx]"
                                                       @onchange="@(e => { _loadedScenario.Narrative.NarrativeGuidelines[idx] = e.Value?.ToString() ?? ""; MarkScenarioDirty(); })" />
                                                <button class="rw-list-remove-btn" @onclick="@(() => { _loadedScenario.Narrative.NarrativeGuidelines.RemoveAt(idx); MarkScenarioDirty(); })">×</button>
                                            </div>
                                        }
                                        <button class="rw-list-add-btn" @onclick="@(() => _loadedScenario.Narrative.NarrativeGuidelines.Add(""))">+ Add Guideline</button>
                                    </div>
                                </div>
                            }
                        </div>

                        @* -- Plot -- *@
                        <div class="rw-collapsible-section">
                            <button class="rw-collapsible-header" @onclick="@(() => ToggleScenarioSection("plot"))">
                                <span class="rw-collapsible-chevron @(_expandedScenarioSections.Contains("plot") ? "is-open" : "")">›</span>
                                <span class="rw-collapsible-title">Plot</span>
                            </button>
                            @if (_expandedScenarioSections.Contains("plot"))
                            {
                                <div class="rw-collapsible-body">
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Description</label>
                                        <textarea class="rw-settings-textarea" rows="3"
                                                  placeholder="The overarching story"
                                                  value="@_loadedScenario.Plot.Description"
                                                  @onchange="@(e => { _loadedScenario.Plot.Description = e.Value?.ToString(); MarkScenarioDirty(); })"></textarea>
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Conflicts</label>
                                        @for (var i = 0; i < _loadedScenario.Plot.Conflicts.Count; i++)
                                        {
                                            var idx = i;
                                            <div class="rw-list-item-row">
                                                <input class="rw-settings-input" value="@_loadedScenario.Plot.Conflicts[idx]"
                                                       @onchange="@(e => { _loadedScenario.Plot.Conflicts[idx] = e.Value?.ToString() ?? ""; MarkScenarioDirty(); })" />
                                                <button class="rw-list-remove-btn" @onclick="@(() => { _loadedScenario.Plot.Conflicts.RemoveAt(idx); MarkScenarioDirty(); })">×</button>
                                            </div>
                                        }
                                        <button class="rw-list-add-btn" @onclick="@(() => _loadedScenario.Plot.Conflicts.Add(""))">+ Add Conflict</button>
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">Goals</label>
                                        @for (var i = 0; i < _loadedScenario.Plot.Goals.Count; i++)
                                        {
                                            var idx = i;
                                            <div class="rw-list-item-row">
                                                <input class="rw-settings-input" value="@_loadedScenario.Plot.Goals[idx]"
                                                       @onchange="@(e => { _loadedScenario.Plot.Goals[idx] = e.Value?.ToString() ?? ""; MarkScenarioDirty(); })" />
                                                <button class="rw-list-remove-btn" @onclick="@(() => { _loadedScenario.Plot.Goals.RemoveAt(idx); MarkScenarioDirty(); })">×</button>
                                            </div>
                                        }
                                        <button class="rw-list-add-btn" @onclick="@(() => _loadedScenario.Plot.Goals.Add(""))">+ Add Goal</button>
                                    </div>
                                </div>
                            }
                        </div>

                        @* -- Setting -- *@
                        <div class="rw-collapsible-section">
                            <button class="rw-collapsible-header" @onclick="@(() => ToggleScenarioSection("setting"))">
                                <span class="rw-collapsible-chevron @(_expandedScenarioSections.Contains("setting") ? "is-open" : "")">›</span>
                                <span class="rw-collapsible-title">Setting</span>
                            </button>
                            @if (_expandedScenarioSections.Contains("setting"))
                            {
                                <div class="rw-collapsible-body">
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">World Description</label>
                                        <textarea class="rw-settings-textarea" rows="2"
                                                  placeholder="The world/environment"
                                                  value="@_loadedScenario.Setting.WorldDescription"
                                                  @onchange="@(e => { _loadedScenario.Setting.WorldDescription = e.Value?.ToString(); MarkScenarioDirty(); })"></textarea>
                                    </div>
                                    <div class="rw-scenario-field">
                                        <label class="rw-scenario-field-label">World Rules</label>
                                        @for (var i = 0; i < _loadedScenario.Setting.WorldRules.Count; i++)
                                        {
                                            var idx = i;
                                            <div class="rw-list-item-row">
                                                <input class="rw-settings-input" value="@_loadedScenario.Setting.WorldRules[idx]"
                                                       @onchange="@(e => { _loadedScenario.Setting.WorldRules[idx] = e.Value?.ToString() ?? ""; MarkScenarioDirty(); })" />
                                                <button class="rw-list-remove-btn" @onclick="@(() => { _loadedScenario.Setting.WorldRules.RemoveAt(idx); MarkScenarioDirty(); })">×</button>
                                            </div>
                                        }
                                        <button class="rw-list-add-btn" @onclick="@(() => _loadedScenario.Setting.WorldRules.Add(""))">+ Add Rule</button>
                                    </div>
                                </div>
                            }
                        </div>

                        @* -- Characters -- *@
                        <div class="rw-collapsible-section">
                            <button class="rw-collapsible-header" @onclick="@(() => ToggleScenarioSection("characters"))">
                                <span class="rw-collapsible-chevron @(_expandedScenarioSections.Contains("characters") ? "is-open" : "")">›</span>
                                <span class="rw-collapsible-title">Characters (@_loadedScenario.Characters.Count)</span>
                            </button>
                            @if (_expandedScenarioSections.Contains("characters"))
                            {
                                <div class="rw-collapsible-body">
                                    @foreach (var character in _loadedScenario.Characters)
                                    {
                                        <div class="rw-scenario-character">
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">@(character.Name ?? "Unnamed") @(!string.IsNullOrWhiteSpace(character.Role) ? $"({character.Role})" : "")</label>
                                                <textarea class="rw-settings-textarea" rows="3"
                                                          placeholder="Character description, personality, motivations..."
                                                          value="@character.Description"
                                                          @onchange="@(e => { character.Description = e.Value?.ToString(); MarkScenarioDirty(); })"></textarea>
                                            </div>
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">Role</label>
                                                <select class="rw-mode-select"
                                                        value="@CharacterRoleCatalog.Normalize(character.Role)"
                                                        @onchange="@(e => { character.Role = CharacterRoleCatalog.Normalize(e.Value?.ToString()); MarkScenarioDirty(); })">
                                                    @foreach (var option in GetCharacterRoleOptions(character.Role))
                                                    {
                                                        <option value="@option">@option</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">Gender</label>
                                                <select class="rw-mode-select"
                                                        value="@GetCharacterGenderValue(character)"
                                                        @onchange="@(e => OnCharacterGenderChanged(character, e.Value?.ToString()))">
                                                    @foreach (var option in CharacterGenderCatalog.CharacterGenders)
                                                    {
                                                        <option value="@option">@option</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">Relation</label>
                                                <select class="rw-mode-select"
                                                        value="@(CharacterRelationCatalog.NormalizeTargetId(character.RelationTargetId) ?? string.Empty)"
                                                        @onchange="@(e => SetScenarioCharacterRelationTarget(character, e.Value?.ToString()))">
                                                    <option value="">(None)</option>
                                                    @foreach (var option in GetCharacterRelationTargetOptions(character))
                                                    {
                                                        <option value="@option.Value">@option.Label</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">Session Perspective</label>
                                                <select class="rw-mode-select"
                                                        value="@GetCharacterPerspectiveModeValue(character)"
                                                        @onchange="@(e => OnCharacterPerspectiveChanged(character, e))">
                                                    @foreach (var mode in CharacterPerspectiveModes.All)
                                                    {
                                                        <option value="@mode.Mode">@mode.DisplayName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">Character Stat Profile</label>
                                                <div class="input-group input-group-sm">
                                                    <select class="form-select"
                                                            value="@GetScenarioCharacterProfileSelection(character)"
                                                            @onchange="@(e => SetScenarioCharacterProfileSelection(character, e.Value?.ToString()))">
                                                        <option value="">(Select Profile)</option>
                                                        @foreach (var profile in GetApplicableBaseStatProfiles(character))
                                                        {
                                                            <option value="@profile.Id">@profile.Name (@CharacterGenderCatalog.NormalizeForProfile(profile.TargetGender) / @CharacterRoleCatalog.Normalize(profile.TargetRole))</option>
                                                        }
                                                    </select>
                                                    <button class="btn btn-outline-primary" type="button" @onclick="@(() => ApplyScenarioCharacterProfile(character))">Apply</button>
                                                </div>
                                            </div>
                                            @{
                                                var charEncProfileId = _session?.AdaptiveState?.CharacterEncounterProfileIds.GetValueOrDefault(character.Id) ?? string.Empty;
                                                var charEncProfileName = string.IsNullOrWhiteSpace(charEncProfileId)
                                                    ? "(none)"
                                                    : _characterProfiles.FirstOrDefault(p => string.Equals(p.Id, charEncProfileId, StringComparison.OrdinalIgnoreCase))?.Name ?? "(none)";
                                            }
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">Encounter Profile (seeded)</label>
                                                <span class="rw-adaptive-note">@charEncProfileName</span>
                                            </div>
                                            @{
                                                var charActorKey = character.Name?.Trim() ?? string.Empty;
                                                var charHasLiveStats = !string.IsNullOrWhiteSpace(charActorKey)
                                                    && _v2State?.CharacterSnapshots?.Any(c => string.Equals(c.CharacterId, charActorKey, StringComparison.OrdinalIgnoreCase)) == true;
                                            }
                                            <div class="rw-scenario-field">
                                                <label class="rw-scenario-field-label">Current Session Stats (@(string.IsNullOrWhiteSpace(charActorKey) ? "(no name)" : charActorKey))@(charHasLiveStats ? "" : " → not in session yet")</label>
                                                <div class="rw-adaptive-note mb-1">Live adaptive stat values for this character. Changes take effect immediately and persist to the session.</div>
                                                @if (!string.IsNullOrWhiteSpace(charActorKey))
                                                {
                                                    @foreach (var statName in AdaptiveStatCatalog.CanonicalStatNames)
                                                    {
                                                        <div class="input-group input-group-sm mb-1" style="max-width: 360px;">
                                                            <span class="input-group-text" style="min-width: 140px;">@statName</span>
                                                            <input type="number"
                                                                   class="form-control"
                                                                   min="0"
                                                                   max="100"
                                                                   value="@GetCharacterLiveSessionStat(charActorKey, statName)"
                                                                   @onchange="@(e => SetCharacterLiveSessionStat(charActorKey, statName, e.Value?.ToString()))" />
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="text-muted small">Set a character name to enable live stat editing.</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @* -- T057: Time of Day display + manual override -- *@
                        <div class="rw-settings-section mt-3">
                            <div class="rw-settings-section-label">Time of Day</div>
                            <div class="rw-scenario-field">
                                <span class="rw-adaptive-note">
                                    Current: @(_session.AdaptiveState.CurrentTimeOfDay?.ToString() ?? "(unknown)")
                                    @if (_session.AdaptiveState.TimeOfDayManuallySet)
                                    {
                                        <span class="badge bg-warning ms-2">Manual</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-2">Auto</span>
                                    }
                                </span>
                            </div>
                            <div class="rw-scenario-field">
                                <label class="rw-scenario-field-label">Override</label>
                                <select class="rw-settings-input" @onchange="@OnTimeOfDayOverrideChanged">
                                    <option value="" selected="@(!_session.AdaptiveState.TimeOfDayManuallySet)">Auto</option>
                                    @foreach (var tod in Enum.GetValues<TimeOfDay>())
                                    {
                                        <option value="@tod" selected="@(_session.AdaptiveState.TimeOfDayManuallySet && _session.AdaptiveState.CurrentTimeOfDay == tod)">@tod</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @* -- T059: Scene Continue Batch Size -- *@
                        <div class="rw-settings-section mt-3">
                            <div class="rw-settings-section-label">Overflow Continue Batch Size</div>
                            <div class="rw-scenario-field">
                                <input type="range" min="1" max="6" step="1"
                                       value="@_session.SceneContinueBatchSize"
                                       @onchange="@OnSceneContinueBatchSizeChanged"
                                       class="rw-settings-slider" style="width:120px;" />
                                <span class="small text-muted ms-2">@_session.SceneContinueBatchSize</span>
                            </div>
                        </div>

                        @* -- PreferredPosition Override Chance -- *@
                        <div class="rw-settings-section mt-3">
                            <div class="rw-settings-section-label">Position Override Chance</div>
                            <div class="small text-muted mb-1">Probability the highest-scoring character leads the turn regardless of PreferredPosition groups. 0 = always honor First/Last positions, 1 = always let highest score lead.</div>
                            <div class="rw-scenario-field">
                                <input type="range" min="0" max="1" step="0.05"
                                       value="@_session.PreferredPositionOverrideChance.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       @onchange="@OnPreferredPositionOverrideChanceChanged"
                                       class="rw-settings-slider" style="width:120px;" />
                                <span class="small text-muted ms-2">@(_session.PreferredPositionOverrideChance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))</span>
                            </div>
                        </div>

                        @* -- T058: Per-character Turn Overrides -- *@
                        <div class="rw-settings-section mt-3">
                            <div class="rw-settings-section-label">Per-Character Turn Overrides</div>
                            @{ var personaChar = _loadedScenario?.GetPersonaCharacter(); }
                            @{ var personaNameForFallback = _session.PersonaName; }
                            @{ var hasNpcNamedLikePersona = personaChar is null
                                && _loadedScenario?.Characters.Any(c => !c.IsPersona
                                    && !string.IsNullOrWhiteSpace(c.Name)
                                    && string.Equals(c.Name.Trim(), personaNameForFallback, StringComparison.OrdinalIgnoreCase)) == true; }
                            @{ var overrideEntries = _session.CharacterPerspectives
                                .Where(c => !string.IsNullOrWhiteSpace(c.CharacterName)
                                    && !IsPersonaPerspectiveEntry(c, personaChar, personaNameForFallback, hasNpcNamedLikePersona))
                                .ToList(); }
                            @if (overrideEntries.Count == 0 && _loadedScenario?.Characters.Any(c => !c.IsPersona && !string.IsNullOrWhiteSpace(c.Name)) == true)
                            {
                                <div class="rw-adaptive-note">No character perspectives loaded yet. Interact with the session to populate the character list.</div>
                            }
                            @foreach (var cp in overrideEntries)
                            {
                                var charName = cp.CharacterName!;
                                var hasOverride = _session.CharacterTurnOverrides.TryGetValue(charName, out var turnOverride);
                                var participate = hasOverride ? turnOverride!.ParticipateInAutoContinue : true;
                                var priority = hasOverride ? turnOverride!.ResponsePriority ?? 0 : 0;
                                var preferred = hasOverride ? turnOverride!.PreferredPosition : PreferredTurnPosition.Auto;
                                <div class="rw-scenario-field">
                                    <label class="rw-scenario-field-label">@charName</label>
                                    <div class="d-flex gap-3 align-items-center">
                                        <label class="form-check form-check-sm">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@participate"
                                                   @onchange="@(e => OnParticipateInAutoContinueChanged(charName, e))" /> Auto-participate
                                        </label>
                                        <label class="small">Priority:
                                            <input type="range" min="0" max="100" step="1"
                                                   value="@priority"
                                                   @onchange="@(e => OnResponsePriorityChanged(charName, e))"
                                                   class="rw-settings-slider" style="width:100px;" />
                                            <span class="small text-muted ms-1">@priority</span>
                                        </label>
                                        <label class="small">Position:
                                            <select class="form-select form-select-sm" style="width:90px;"
                                                    value="@preferred"
                                                    @onchange="@(e => OnPreferredPositionChanged(charName, e.Value?.ToString()))">
                                                <option value="Auto" selected="@(preferred == PreferredTurnPosition.Auto)">Auto</option>
                                                <option value="First" selected="@(preferred == PreferredTurnPosition.First)">First</option>
                                                <option value="Last" selected="@(preferred == PreferredTurnPosition.Last)">Last</option>
                                            </select>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                        @* -- Save Button -- *@
                        <button class="rw-scenario-save-btn @(_scenarioDirty || _sessionStatsDirty ? "" : "is-disabled")"
                                disabled="@(!(_scenarioDirty || _sessionStatsDirty))"
                                @onclick="OnSaveScenarioClicked">
                            @(_scenarioDirty || _sessionStatsDirty ? "Save Changes" : "No Changes")
                        </button>
                    }
                    else
                    {
                        <div class="rw-settings-section">
                            <p class="rw-scenario-empty">No scenario linked to this session.</p>
                        </div>
                    }
                </div>
            }

            @if (_activeSettingsTab == "assistant")
            {
                <div class="rw-settings-content">
                    <div class="rw-settings-section">
                        <div class="rw-settings-section-label">Assistant Model</div>
                        <select class="rw-mode-select" @bind="_assistantSelectedModelId" @bind:after="OnAssistantModelChanged">
                            <option value="">(Use Function Default)</option>
                            @foreach (var group in _assistantGroupedModels)
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var model in group.Value)
                                    {
                                        <option value="@model.Id">@(model.DisplayName ?? model.ModelIdentifier)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="text-muted small mb-2">
                        Ask detailed engine questions like: "Why did next phase not advance?", "Why was this theme selected?", or "Show evidence from logs/debug events for this session".
                    </div>
                    <AssistantPanel Title="Role-Play Assistant"
                                    SessionId="@_session.Id"
                                    Messages="@GetActiveAssistantMessages()"
                                    Chats="@GetAssistantChatSummaries()"
                                    ActiveChatId="@_activeAssistantChatId"
                                    OnSelectChatRequest="OnAssistantSelectChat"
                                    OnCreateChatRequest="OnAssistantCreateChat"
                                    OnDeleteChatRequest="OnAssistantDeleteChat"
                                    OnGenerateRequest="OnAssistantGenerateRequest"
                                    OnClearChatRequest="OnAssistantClearChat" />
                </div>
            }

            @if (_activeSettingsTab == "adaptive")
            {
                <div class="rw-settings-content rw-adaptive-panel">
                    <div class="rw-collapsible-section">
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("profiles")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("profiles") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">Active Profiles And Controls</span>
                        </button>
                        @if (IsAdaptiveSectionExpanded("profiles"))
                        {
                            <div class="rw-collapsible-body">
                                <div class="text-muted small mb-2">RP Theme Profile steers adaptive theme direction. Writing Style Profile steers wording, texture, and voice.</div>
                                <div class="rw-scenario-field">
                                    <label class="rw-scenario-field-label">RP Theme Profile</label>
                                    <select class="rw-mode-select" value="@_session.SelectedRPThemeProfileId" @onchange="OnRpThemeProfileChanged">
                                        <option value="">(None)</option>
                                        @foreach (var profile in _rpThemeProfiles)
                                        {
                                            <option value="@profile.Id">@profile.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="rw-scenario-field">
                                    <label class="rw-scenario-field-label">Manual Theme Override</label>
                                    <select class="rw-mode-select" value="@_adaptiveThemeOverrideSelection" @onchange="OnAdaptiveThemeOverrideChanged">
                                        <option value="">(Select Theme)</option>
                                        @foreach (var theme in GetAdaptiveOverrideThemes())
                                        {
                                            <option value="@theme.ThemeId">@BuildAdaptiveOverrideThemeLabel(theme)</option>
                                        }
                                    </select>
                                    <div class="text-muted small mb-2">Forces the active adaptive theme immediately.</div>
                                    <button class="rw-btn rw-btn-secondary" disabled="@string.IsNullOrWhiteSpace(_adaptiveThemeOverrideSelection)" @onclick="ApplyAdaptiveThemeOverrideAsync">Apply Theme Override</button>
                                    @if (!string.IsNullOrWhiteSpace(_adaptiveThemeOverrideStatus))
                                    {
                                        <div class="small" style="margin-top:6px; color:#c8d6c8;">@_adaptiveThemeOverrideStatus</div>
                                    }
                                </div>
                                <div class="rw-scenario-field">
                                    <label class="rw-scenario-field-label">Selected Intensity Profile</label>
                                    <select class="rw-mode-select" value="@GetIntensityDropdownValue()" @onchange="OnIntensityProfileChanged">
                                        <option value="">(None)</option>
                                        @foreach (var profile in _intensityProfiles)
                                        {
                                            <option value="@profile.Id">@profile.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="rw-scenario-field">
                                    <label class="rw-scenario-field-label">Writing Style Profile</label>
                                    <select class="rw-mode-select" value="@_session.SelectedSteeringProfileId" @onchange="OnSteeringProfileChanged">
                                        <option value="">(None)</option>
                                        @foreach (var profile in _steeringProfiles)
                                        {
                                            <option value="@profile.Id">@profile.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="rw-scenario-field">
                                    <label class="rw-scenario-field-label">Willingness Profile</label>
                                    <select class="rw-mode-select" value="@(_v2State?.SelectedWillingnessProfileId)" @onchange="OnWillingnessProfileChanged">
                                        <option value="">(None)</option>
                                        @foreach (var profile in _willingnessProfiles)
                                        {
                                            <option value="@profile.Id">@profile.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="rw-settings-info-row"><span>Selected Intensity Profile</span><span>@GetSelectedIntensityProfileName()</span></div>
                                <div class="rw-settings-info-row"><span>Adaptive Intensity Profile</span><span>@GetAdaptiveIntensityProfileName()</span></div>
                                <div class="rw-settings-info-row"><span>Resolved Intensity</span><span>@GetEffectiveStyleLabel()</span></div>
                            </div>
                        }
                    </div>

                    <div class="rw-collapsible-section">
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("runtime")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("runtime") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">RolePlay v2 Runtime Status</span>
                            @if (_latestSemanticInteractionAnalysis is not null && _latestSemanticInteractionAnalysis.Status != SemanticAnalysisStatus.Idle)
                            {
                                <span class="@GetSemanticStatusBadgeClass(_latestSemanticInteractionAnalysis.Status)">@GetSemanticStatusLabel(_latestSemanticInteractionAnalysis.Status)</span>
                            }
                        </button>
                        @if (IsAdaptiveSectionExpanded("runtime"))
                        {
                            var phaseProgress = GetCurrentPhaseProgress();
                            var simpleSummary = GetSimpleRuntimeSummary();
                            var activeGateRows = GetPhaseGateRows().Where(x => IsPrimaryUserGate(x.Label)).ToList();
                            <div class="rw-collapsible-body">
                                <div class="rw-settings-info-row"><span>Current Phase</span><span>@(
                                    _v2State?.CurrentPhase == DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp && string.IsNullOrWhiteSpace(_v2State?.ActiveScenarioId)
                                        ? "Observer (no active theme)"
                                        : (_v2State?.CurrentPhase.ToString() ?? "")
                                )</span></div>
                                <div class="rw-settings-info-row"><span>Phase Progress</span><span>@($"{phaseProgress.ProgressPercent}% to {phaseProgress.NextPhase}")</span></div>
                                @{
                                    var runtimePhase = _v2State?.CurrentPhase ?? DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp;
                                    var runtimeNextPhase = runtimePhase switch
                                    {
                                        NarrativePhase.BuildUp     => "Committed",
                                        NarrativePhase.Committed   => "Approaching",
                                        NarrativePhase.Approaching => "Climax",
                                        NarrativePhase.Climax      => "Reset",
                                        NarrativePhase.Reset       => "BuildUp",
                                        _                          => "—"
                                    };
                                    var runtimeGateRows = GetPhaseGateDisplayRows();
                                }
                                @if (runtimeGateRows.Count > 0)
                                {
                                    <div class="rw-fit-score-block" style="margin:6px 0 8px 0;">
                                        <div class="rw-fit-score-header">
                                            <span>Narrative Gate — @runtimePhase → @runtimeNextPhase</span>
                                        </div>
                                        @foreach (var gateRow in runtimeGateRows)
                                        {
                                            <div class="rw-settings-info-row">
                                                <span class="@(gateRow.Passed ? "rw-fit-score-pass" : "rw-fit-score-fail")">@gateRow.MetricLabel</span>
                                                <span>
                                                    @gateRow.CurrentDisplay @gateRow.Requirement
                                                    @if (!gateRow.Passed)
                                                    {
                                                        <span> — @gateRow.GapDescription</span>
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="rw-settings-info-row rw-settings-info-row-block"><span>Simple Status</span><span>@simpleSummary.Status</span></div>
                                <div class="rw-settings-info-row rw-settings-info-row-block"><span>Simple Next Step</span><span>@simpleSummary.NextStep</span></div>
                                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@phaseProgress.ProgressPercent" style="height:8px; margin:4px 0 8px 0;">
                                    <div class="progress-bar @GetPhaseProgressBarClass()" style="width:@($"{phaseProgress.ProgressPercent}%")"></div>
                                </div>
                                <div class="rw-settings-info-row rw-settings-info-row-block"><span>What This Means</span><span>@phaseProgress.Details</span></div>
                                <div class="rw-settings-info-row"><span>Theme Selection Rule</span><span>@(_v2State?.ThemeSelectionRule ?? "")</span></div>
                                <div class="rw-settings-info-row"><span>Primary Selection</span><span>@(string.IsNullOrWhiteSpace(_v2State?.PrimaryThemeId) ? "(none)" : ResolveDecisionThemeLabel(_v2State!.PrimaryThemeId!))</span></div>
                                <div class="rw-settings-info-row"><span>Secondary Selection</span><span>@(string.IsNullOrWhiteSpace(_v2State?.SecondaryThemeId) ? "(none)" : ResolveDecisionThemeLabel(_v2State!.SecondaryThemeId!))</span></div>
                                <div class="rw-settings-info-row"><span>Active Theme</span><span>@(string.IsNullOrWhiteSpace(_v2State?.ActiveScenarioId) ? "(none)" : _v2State!.ActiveScenarioId)</span></div>

                                @if (_v2State?.CurrentPhase == DreamGenClone.Domain.RolePlay.NarrativePhase.Climax)
                                {
                                    var beatCode = _v2State?.CurrentBeatCode;
                                    var turnsInBeat = _v2Diagnostics?.AdaptiveState?.TurnsInCurrentBeat ?? 0;
                                    DreamGenClone.Domain.RolePlay.ClimaxBeatEntry? beatEntry = null;
                                    DreamGenClone.Domain.RolePlay.ClimaxBeatEntry? nextBeatEntry = null;
                                    if (!string.IsNullOrWhiteSpace(beatCode))
                                    {
                                        _climaxBeatsByCode.TryGetValue(beatCode, out beatEntry);
                                        if (beatEntry?.NextBeatCode is not null)
                                        {
                                            _climaxBeatsByCode.TryGetValue(beatEntry.NextBeatCode, out nextBeatEntry);
                                        }
                                    }
                                    <div class="rw-settings-info-row rw-settings-info-row-heading mt-1"><span>Climax Beat Cursor</span></div>
                                    <div class="rw-settings-info-row"><span>Beat Code</span><span>@(beatCode ?? "(none)")</span></div>
                                    @if (beatEntry is not null)
                                    {
                                        <div class="rw-settings-info-row"><span>Stage</span><span>@beatEntry.StageNumber → @beatEntry.StageName</span></div>
                                        <div class="rw-settings-info-row"><span>Sub-Beat</span><span>@beatEntry.SubBeatName</span></div>
                                        <div class="rw-settings-info-row">
                                            <span>Turns In Beat</span>
                                            <span>@turnsInBeat / @beatEntry.MinTurnsBeforeAdvance @(turnsInBeat >= beatEntry.MinTurnsBeforeAdvance && beatEntry.NextBeatCode is not null ? "(ready to advance)" : "")</span>
                                        </div>
                                        @if (beatEntry.NextBeatCode is not null)
                                        {
                                            <div class="rw-settings-info-row"><span>Next Beat</span><span>@beatEntry.NextBeatCode@(nextBeatEntry is not null ? $" → Stage {nextBeatEntry.StageNumber} → {nextBeatEntry.SubBeatName}" : "")</span></div>
                                        }
                                        else
                                        {
                                            <div class="rw-settings-info-row"><span>Next Beat</span><span>(terminal beat)</span></div>
                                        }
                                        @if (beatEntry.Hints.Count > 0)
                                        {
                                            <div class="rw-settings-info-row rw-settings-info-row-block rw-settings-info-row-heading"><span>Hints</span></div>
                                            @foreach (var hint in beatEntry.Hints)
                                            {
                                                <div class="rw-settings-info-row rw-settings-info-row-block rw-settings-info-row-guidance"><span>→ @hint</span></div>
                                            }
                                        }
                                    }
                                    else if (!string.IsNullOrWhiteSpace(beatCode))
                                    {
                                        <div class="rw-settings-info-row rw-settings-info-row-block"><span>Status</span><span>BeatCode '@beatCode' not found in catalog.</span></div>
                                    }
                                }

                                @{
                                    var currentPhaseEnum = _v2State?.CurrentPhase ?? DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp;
                                    var hasActiveScenario = !string.IsNullOrWhiteSpace(_v2State?.ActiveScenarioId);
                                    var phaseGuidanceLines = hasActiveScenario
                                        ? DreamGenClone.Web.Application.RolePlay.RolePlayAssistantPrompts.GetThemePhaseGuidanceLines(_activeRpTheme, currentPhaseEnum.ToString())
                                        : (IReadOnlyList<string>)Array.Empty<string>();
                                }
                                @if (hasActiveScenario && phaseGuidanceLines.Count > 0)
                                {
                                    <div class="rw-settings-info-row rw-settings-info-row-block rw-settings-info-row-heading mt-1"><span>Phase Guidance (@currentPhaseEnum)</span></div>
                                    <div class="rw-phase-guidance-scroll">
                                    @foreach (var guidanceLine in phaseGuidanceLines)
                                    {
                                        <div class="rw-settings-info-row rw-settings-info-row-block rw-settings-info-row-guidance"><span>@guidanceLine</span></div>
                                    }
                                    </div>
                                }

                                <div class="rw-collapsible-section" style="margin-top:10px;">
                                    <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("active-theme-gates")'>
                                        <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("active-theme-gates") ? "is-open" : "")">›</span>
                                        <span class="rw-collapsible-title">Active Theme Gates</span>
                                    </button>
                                    @if (IsAdaptiveSectionExpanded("active-theme-gates"))
                                    {
                                        <div class="rw-collapsible-body">
                                            @foreach (var gate in activeGateRows)
                                            {
                                                <div class="rw-settings-info-row"><span>@gate.Label</span><span class="@GetGateStatusBadgeClass(gate.Status)">@gate.Status</span></div>
                                                var gateDetailLines = gate.Details.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                                                if (gateDetailLines.Length <= 1)
                                                {
                                                    <div class="rw-settings-info-row rw-settings-info-row-block"><span>Status</span><span>@gate.Details</span></div>
                                                }
                                                else
                                                {
                                                    <div class="rw-settings-info-row rw-settings-info-row-block rw-settings-info-row-heading"><span>Status</span></div>
                                                    @foreach (var detailLine in gateDetailLines)
                                                    {
                                                        <div class="rw-settings-info-row rw-settings-info-row-block rw-settings-info-row-guidance"><span>@detailLine</span></div>
                                                    }
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="rw-collapsible-section">
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("themes")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("themes") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">Theme Profile Stats</span>
                        </button>
                        @if (IsAdaptiveSectionExpanded("themes"))
                        {
                            var themeRows = GetAdaptiveThemeStatusRows();
                            var themeGateRows = GetPhaseGateDisplayRows();
                            var themePhase = _session?.AdaptiveState.CurrentPhase;
                            var themeNextPhase = themePhase switch
                            {
                                NarrativePhase.BuildUp     => "Committed",
                                NarrativePhase.Committed   => "Approaching",
                                NarrativePhase.Approaching => "Climax",
                                NarrativePhase.Climax      => "Reset",
                                NarrativePhase.Reset       => "BuildUp",
                                _                          => "—"
                            };
                            <div class="rw-collapsible-body">
                                <div class="rw-adaptive-note">Each theme shows score, readiness status, and what is missing for activation.</div>
                                @if (_resolvedBuildUpCommittedRuleError is not null && themeGateRows.Count == 0)
                                {
                                    <div class="rw-fit-score-block">
                                        <div class="rw-fit-score-header"><span>@themePhase → @themeNextPhase Gate</span></div>
                                        <div class="rw-fit-score-rationale">@_resolvedBuildUpCommittedRuleError</div>
                                    </div>
                                }
                                else if (themeGateRows.Count > 0)
                                {
                                    <div class="rw-fit-score-block">
                                        <div class="rw-fit-score-header">
                                            <span>@themePhase → @themeNextPhase Gate</span>
                                            <span class="rw-settings-info-value-muted">@_resolvedBuildUpCommittedRuleSource</span>
                                        </div>
                                        @foreach (var gateRow in themeGateRows)
                                        {
                                            <div class="rw-settings-info-row">
                                                <span class="@(gateRow.Passed ? "rw-fit-score-pass" : "rw-fit-score-fail")">@gateRow.MetricLabel</span>
                                                <span>
                                                    @gateRow.CurrentDisplay @gateRow.Requirement
                                                    @if (!gateRow.Passed)
                                                    {
                                                        <span> — @gateRow.GapDescription</span>
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (themeRows.Count == 0)
                                {
                                    <p class="rw-scenario-empty">No theme tracker data yet. Generate interactions to populate scores.</p>
                                }
                                else
                                {
                                    @foreach (var row in themeRows)
                                    {
                                        var rowExpanded = IsAdaptiveThemeRowExpanded(row.ThemeId);
                                        <div class="rw-collapsible-section" style="margin-bottom:8px;">
                                            <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveThemeRow(row.ThemeId)'>
                                                <span class="rw-collapsible-chevron @(rowExpanded ? "is-open" : "")">›</span>
                                                <span class="rw-collapsible-title">@row.ThemeName</span>
                                                <span class="ms-auto d-inline-flex gap-2 align-items-center">
                                                    <span class="badge text-bg-dark">Score @((row.FitScore ?? (decimal)row.Score).ToString("F1"))</span>
                                                    <span class="@GetAdaptiveStatusBadgeClass(row.Status)">@row.Status</span>
                                                </span>
                                            </button>
                                            @if (rowExpanded)
                                            {
                                                <div class="rw-collapsible-body">
                                                    <div class="rw-settings-info-row"><span title="Stable identifier of this theme in the catalog. Used by mappings, profile tiers, and scenario links.">Theme Id</span><span>@row.ThemeId</span></div>
                                                    <div class="rw-settings-info-row"><span title="Current narrative intensity tier derived from Score (None < 25, Minor 25-49, Moderate 50-74, Major 75-89, Peak >= 90). Drives prompt emphasis and gate eligibility.">Intensity</span><span>@row.Intensity</span></div>
                                                    <div class="rw-settings-info-row rw-settings-info-row-block"><span title="Human guidance for the next move: what's needed for this theme to activate or how to keep it healthy if it's already active.">Next Step</span><span>@row.NextStep</span></div>
                                                    <div class="rw-settings-info-row"><span title="Contribution from the user's ThemeProfile tier preference at seed time. MustHave +15, StronglyPrefer +8, NiceToHave +3, Discouraged -5, HardDealBreaker blocks the theme (Score locked at 0). Set once at session start and does not change during play.">Choice Signal</span><span>@row.ChoiceSignal.ToString("F2")</span></div>
                                                    <div class="rw-settings-info-row"><span title="Cumulative contribution from in-play evidence. Includes keyword hits in AI output AND semantic-event-mapping deltas (the inferred-semantic pipeline writes its applied deltas into this bucket). Grows as the story produces theme-relevant beats. Also receives a one-time boost when a predecessor theme completes and this theme is listed as a successor.">Interaction Evidence Signal</span><span>@row.InteractionEvidenceSignal.ToString("F2")</span></div>
                                                    <div class="rw-settings-info-row"><span title="Contribution from keyword matches scored against the initial scenario text at session start. Set once during seeding and does not change during play.">Scenario Phase Signal</span><span>@row.ScenarioPhaseSignal.ToString("F2")</span></div>
                                                    @if (row.FitScore.HasValue)
                                                    {
                                                        <div class="rw-settings-info-row" style="margin-top:4px;"><span title="Actual penalized selection score for this theme. Gate failures apply a multiplier (e.g. ×0.7) to the weighted composite. This is the score used for scenario selection ordering.">Eval Fit Score</span><span>@row.FitScore.Value.ToString("F1") @(row.StageBEligible == true ? "✓ eligible" : "⚠ gate failed")</span></div>
                                                        <div class="rw-settings-info-row" style="@(row.FitScorePenalty > 0m ? "color:var(--bs-danger);" : string.Empty)"><span title="Total FitScore deduction applied to this theme. UnpenalizedFitScore − FitScore. Source: flat completion penalty applied after theme reset. 0 means no active penalty.">Penalty</span><span>−@row.FitScorePenalty.ToString("F1")</span></div>
                                                        @if (row.SuccessorCausalityBoost.HasValue)
                                                        {
                                                            <div class="rw-settings-info-row" style="color:var(--bs-success);"><span title="Additive FitScore bonus from a Successor Causality Link. Applied directly to this theme's gate-adjusted FitScore (0-100 scale) because a predecessor scenario completed. Cleared at the next arc reset.">Successor Boost</span><span>+@row.SuccessorCausalityBoost.Value.ToString("F1")</span></div>
                                                        }
                                                        <div class="rw-settings-info-row"><span title="How well the current character stats match this scenario's requirements. Weight 50% of FitScore.">Char Alignment</span><span>@((row.CharAlignScore * 100m ?? 0m).ToString("F1"))</span></div>
                                                        <div class="rw-settings-info-row"><span title="Narrative evidence contribution from theme score and in-play evidence. Weight 30% of FitScore.">Narrative Evidence</span><span>@((row.NarrEvidScore * 100m ?? 0m).ToString("F1"))</span></div>
                                                        <div class="rw-settings-info-row"><span title="Preference priority contribution from profile tier assignment. Weight 20% of FitScore.">Pref Priority</span><span>@((row.PrefPriorityScore * 100m ?? 0m).ToString("F1"))</span></div>
                                                        @if (row.StageBEligible == false && row.GateDetailsJson is not null)
                                                        {
                                                            var gateEnv = ParseFullCandidateDetails(row.GateDetailsJson);
                                                            if (gateEnv is not null)
                                                            {
                                                                <div class="rw-fit-score-block" style="margin-top:6px;">
                                                                    <div class="rw-fit-score-header">
                                                                        <span>Fit Gate Failure</span>
                                                                        @if (gateEnv.Gate?.Strategy is { Length: > 0 } gateStrategy)
                                                                        {
                                                                            <span class="rw-settings-info-value-muted">@gateStrategy</span>
                                                                        }
                                                                    </div>
                                                                    @if (gateEnv.Gate?.Reason is { Length: > 0 } gateReason)
                                                                    {
                                                                        <div class="rw-fit-score-rationale">@gateReason</div>
                                                                    }
                                                                    @if (gateEnv.FitResult?.ClauseEvaluations is { Count: > 0 } clausesByRole)
                                                                    {
                                                                        @foreach (var clauseRoleKv in clausesByRole.OrderBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase))
                                                                        {
                                                                            var roleScore = gateEnv.FitResult.RoleScores?.TryGetValue(clauseRoleKv.Key, out var rs) == true ? rs : (double?)null;
                                                                            <div class="rw-fit-char-row">
                                                                                <span class="rw-fit-char-name">@clauseRoleKv.Key @(roleScore.HasValue ? $"({roleScore.Value:F3})" : string.Empty)</span>
                                                                                <span class="rw-fit-char-clauses">
                                                                                    @foreach (var clause in clauseRoleKv.Value)
                                                                                    {
                                                                                        var clauseIsPass = clause.StartsWith("PASS", StringComparison.OrdinalIgnoreCase);
                                                                                        var clauseClass = clauseIsPass ? "rw-fit-score-pass" : "rw-fit-clause-gap";
                                                                                        <span class="@clauseClass">@clause</span>
                                                                                    }
                                                                                </span>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    @* TODO-004: Location section in Adaptive tab *@
                    <div class="rw-collapsible-section">
                        <button type="button" class="rw-collapsible-header" @onclick='() => ToggleAdaptiveSection("location")'>
                            <span class="rw-collapsible-chevron @(IsAdaptiveSectionExpanded("location") ? "is-open" : "")">›</span>
                            <span class="rw-collapsible-title">Location</span>
                        </button>
                        @if (IsAdaptiveSectionExpanded("location"))
                        {
                            <div class="rw-collapsible-body">
                                <div class="rw-settings-info-row">
                                    <span>Current Scene Location</span>
                                    <span>@(_v2State?.CurrentSceneLocation ?? "(none)")</span>
                                </div>
                                <div class="rw-settings-info-row">
                                    <span>Time of Day</span>
                                    <span>
                                        @(_v2State?.CurrentTimeOfDay?.ToString() ?? "(unknown)")
                                        @if (_v2State?.TimeOfDayManuallySet == true)
                                        {
                                            <span class="badge bg-warning ms-1" style="font-size:10px;">Manual</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size:10px;">Auto</span>
                                        }
                                    </span>
                                </div>
                                @if ((_v2State?.CharacterLocations?.Count ?? 0) > 0)
                                {
                                    <div class="rw-settings-info-row" style="margin-top:6px;">
                                        <span class="fw-semibold">Character Locations</span>
                                        <span></span>
                                    </div>
                                    @foreach (var loc in _v2State!.CharacterLocations)
                                    {
                                        <div class="rw-settings-info-row" style="padding-left:12px;">
                                            <span>@loc.CharacterId</span>
                                            <span>@(loc.TrueLocation ?? "(unknown)")
                                                @if (loc.IsHidden)
                                                {
                                                    <span class="badge bg-secondary ms-1" style="font-size:10px;">Hidden</span>
