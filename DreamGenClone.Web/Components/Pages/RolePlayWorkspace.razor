    private ContinueAsRequest BuildContinueRequest(SubmissionSource source, bool useCustomSelections = true)
    {
        var selectedOptions = useCustomSelections
            ? ContinueIdentityOptions.Where(x => _continueSelectedIdentityIds.Contains(x.Id)).ToList()
            : [];

        return new ContinueAsRequest
        {
            SessionId = _session!.Id,
            SelectedIdentityIds = selectedOptions.Select(x => x.Id).ToList(),
            SelectedParticipants = selectedOptions.Select(x => x.Actor).ToList(),
            IncludeNarrative = useCustomSelections && _continueIncludeNarrative,
            CustomIdentityName = useCustomSelections && !string.IsNullOrWhiteSpace(_customIdentityName)
                ? _customIdentityName.Trim()
                : null,
            TriggeredBy = source
        };
    }

    private async Task<bool> ExecuteContinueAsync(ContinueAsRequest request, string defaultErrorMessage)
    {
        _isSubmitting = true;
        _statusMessage = string.Empty;
        CloseAllPopups();
        _isAwaitingModelResponse = true;
        _pendingResponseLabel = BuildContinuePendingResponseLabel(request);
        _pendingResponseText = string.Empty;
        _pendingResponseBuilder.Clear();
        _lastPendingResponseRenderAt = DateTime.MinValue;
        _newInteractionCountThisTurn = 0;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        // Block if a tracker entry already exists (e.g. previous background submission still running).
        if (_tracker.GetEntry(sessionId) is not null)
        {
            _statusMessage = "A response is already in progress.";
            _isSubmitting = false;
            _isAwaitingModelResponse = false;
            await InvokeAsync(StateHasChanged);
            return false;
        }

        // Synthetic payload for the Queues card display — Continue has no user prompt text.
        var payload = new UnifiedPromptSubmission
        {
            SessionId = sessionId,
            PromptText = string.Empty,
            Intent = PromptIntent.Message,
            SelectedIdentityId = string.Empty,
            BehaviorModeAtSubmit = _selectedBehaviorMode,
            SubmittedVia = request.TriggeredBy
        };

        // Fire without awaiting — task survives component dispose (same pattern as Send button / B-027).
        // isResubmittable: false — Continue failures show inline; no re-submit prompt is offered.
        var engineTask = RolePlayEngine.ContinueAsAsync(
            request,
            OnRolePlayResponseChunkAsync,
            OnRolePlayInteractionCompletedAsync,
            OnRolePlayActorStart);
        _tracker.TryBeginSubmission(sessionId, payload, engineTask, isResubmittable: false);
        _tracker.OnJobStatusChanged += OnTrackerStatusChanged;

        Logger.LogInformation(
            "Continue action handed to tracker: session={SessionId}, source={TriggeredBy}",
            sessionId, request.TriggeredBy);

        _isSubmitting = false;
        _backgroundSubmissionRunning = true;
        // _isAwaitingModelResponse remains true — OnTrackerStatusChanged resets it on completion.
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private static string FormatDecisionDeltas(string statDeltaJson)
    {
        if (string.IsNullOrWhiteSpace(statDeltaJson) || statDeltaJson == "{}")
        {
            return "Narrative impact without explicit stat deltas.";
        }

        try
        {
            var deltas = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(statDeltaJson);
            if (deltas is null || deltas.Count == 0)
            {
                return "Narrative impact without explicit stat deltas.";
            }

            return string.Join(", ", deltas.Select(x => $"{x.Key} {(x.Value >= 0 ? "+" : string.Empty)}{x.Value}"));
        }
        catch
        {
            return "Unable to parse stat impact.";
        }
    }

    private string ResolveDecisionThemeLabel(string scenarioId)
    {
        if (_v2State?.ThemeScores is null
            || string.IsNullOrWhiteSpace(scenarioId))
        {
            return scenarioId;
        }

        if (_v2State.ThemeScores.TryGetValue(scenarioId, out var theme)
            && !string.IsNullOrWhiteSpace(theme.ThemeName))
        {
            return $"{theme.ThemeName} ({scenarioId})";
        }

        return scenarioId;
    }

    private string BuildDecisionQuestionText(DreamGenClone.Domain.RolePlay.DecisionPoint point)
    {
        if (!string.IsNullOrWhiteSpace(point.ContextSummary)
            && LooksLikeQuestionPrompt(point.ContextSummary))
        {
            return point.ContextSummary.Trim();
        }

        var decisionActor = ResolveDecisionActorShortLabel(point.TargetActorId);
        var askingActor = ResolveDecisionActorShortLabel(point.AskingActorName);
        var currentLocation = _v2State?.CurrentSceneLocation;
        var isLatePhase = point.Phase is DreamGenClone.Domain.RolePlay.NarrativePhase.Approaching
            or DreamGenClone.Domain.RolePlay.NarrativePhase.Climax;

        if (string.Equals(point.TriggerSource, "CharacterDirectQuestion", StringComparison.OrdinalIgnoreCase))
        {
            return isLatePhase
                ? $"{askingActor} put the question directly to {decisionActor}. How does {decisionActor} answer?"
                : $"{askingActor} asked {decisionActor} a direct question. How does {decisionActor} respond right now?";
        }

        if (string.Equals(point.TriggerSource, "SceneLocationChanged", StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrWhiteSpace(currentLocation))
            {
                return isLatePhase
                    ? $"The scene has moved to {currentLocation}. What does {decisionActor} do now?"
                    : $"The scene has shifted to {currentLocation}. What does {decisionActor} say or do next?";
            }

            return isLatePhase
                ? $"The setting has changed. How does {decisionActor} react?"
                : $"The scene context has shifted. What does {decisionActor} say or do next?";
        }

        if (string.Equals(point.TriggerSource, "PhaseChanged", StringComparison.OrdinalIgnoreCase))
        {
            return isLatePhase
                ? $"The moment is building. What does {decisionActor} do next?"
                : $"The dynamic between the characters is shifting. What does {decisionActor} choose?";
        }

        return point.Phase switch
        {
            DreamGenClone.Domain.RolePlay.NarrativePhase.Climax => $"Right now, what does {decisionActor} say or do?",
            DreamGenClone.Domain.RolePlay.NarrativePhase.Approaching => $"How does {decisionActor} respond to this moment?",
            _ => $"Given this moment, what does {decisionActor} choose to say or do next?"
        };
    }

    private static bool LooksLikeQuestionPrompt(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return false;
        }

        var normalized = text.Trim();
        return normalized.Contains('?', StringComparison.Ordinal)
            || normalized.Contains("what", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("how", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("which", StringComparison.OrdinalIgnoreCase);
    }

    private string ResolveDecisionActorShortLabel(string? actorIdOrName)
    {
        var label = ResolveDecisionActorLabel(actorIdOrName);
        if (string.IsNullOrWhiteSpace(label))
        {
            return label;
        }

        var marker = " (";
        var markerIndex = label.IndexOf(marker, StringComparison.Ordinal);
        if (markerIndex > 0 && label.EndsWith(')'))
        {
            var inner = label.Substring(markerIndex + marker.Length, label.Length - markerIndex - marker.Length - 1);
            if (Guid.TryParse(inner, out _))
            {
                return label[..markerIndex];
            }
        }

        return label;
    }

    private string ResolveDecisionActorLabel(string? actorIdOrName)
    {
        if (string.IsNullOrWhiteSpace(actorIdOrName))
        {
            return "Unknown";
        }

        var token = actorIdOrName.Trim();
        if (_session is null)
        {
            return token;
        }

        if (string.Equals(token, _session.PersonaName, StringComparison.OrdinalIgnoreCase))
        {
            return $"{_session.PersonaName} (Persona)";
        }

        var perspectiveMatch = _session.CharacterPerspectives.FirstOrDefault(x =>
            string.Equals(x.CharacterId, token, StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.CharacterName, token, StringComparison.OrdinalIgnoreCase));

        if (perspectiveMatch is not null)
        {
            if (string.Equals(perspectiveMatch.CharacterId, token, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(perspectiveMatch.CharacterName))
            {
                return $"{perspectiveMatch.CharacterName} ({perspectiveMatch.CharacterId})";
            }

            return !string.IsNullOrWhiteSpace(perspectiveMatch.CharacterName)
                ? perspectiveMatch.CharacterName
                : token;
        }

        var optionMatch = _identityOptions.FirstOrDefault(x => string.Equals(x.Id, token, StringComparison.OrdinalIgnoreCase));
        if (optionMatch is not null && !string.IsNullOrWhiteSpace(optionMatch.DisplayName))
        {
            return $"{optionMatch.DisplayName} ({token})";
        }

        return token;
    }

    private string ResolveDecisionActorType(string? actorIdOrName)
    {
        if (string.IsNullOrWhiteSpace(actorIdOrName) || _session is null)
        {
            return "unknown";
        }

        var token = actorIdOrName.Trim();
        if (string.Equals(token, _session.PersonaName, StringComparison.OrdinalIgnoreCase))
        {
            return "persona";
        }

        return _session.CharacterPerspectives.Any(x =>
            string.Equals(x.CharacterId, token, StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.CharacterName, token, StringComparison.OrdinalIgnoreCase))
            ? "character"
            : "unknown";
    }

    private int PendingDecisionCount => GetPendingDecisionPoints().Count;

    private IReadOnlyList<DecisionQueueBucket> GetPendingDecisionQueueBuckets()
    {
        var pending = GetPendingDecisionPoints();
        if (pending.Count == 0)
        {
            return [];
        }

        return pending
            .GroupBy(point => new
            {
                Trigger = string.IsNullOrWhiteSpace(point.TriggerSource) ? "Unknown" : point.TriggerSource,
                Target = ResolveDecisionActorLabel(point.TargetActorId)
            })
            .Select(group => new DecisionQueueBucket(
                group.Key.Trigger,
                group.Key.Target,
                group.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.TriggerSource, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.TargetActorLabel, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private List<DreamGenClone.Domain.RolePlay.DecisionPoint> GetPendingDecisionPoints()
    {
        if (_session is null || _v2Diagnostics is null || _v2Diagnostics.DecisionPoints.Count == 0)
        {
            return [];
        }

        var appliedIds = (_session.AppliedDecisionPointIds ?? [])
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return _v2Diagnostics.DecisionPoints
            .Where(point => !appliedIds.Contains(point.DecisionPointId))
            .OrderBy(point => point.CreatedUtc)
            .ToList();
    }

    private sealed record DecisionQueueBucket(string TriggerSource, string TargetActorLabel, int Count);

    private async Task ApplyDecisionOptionAsync(DreamGenClone.Domain.RolePlay.DecisionOption option)
    {
        if (_session is null || _pendingDecisionPrompt is null)
        {
            return;
        }

        _decisionPromptSubmitting = true;
        _decisionPromptError = string.Empty;
        try
        {
            var customResponse = option.IsCustomResponseFallback
                ? (string.IsNullOrWhiteSpace(_decisionCustomResponse) ? null : _decisionCustomResponse.Trim())
                : null;

            var outcome = await RolePlayEngine.ApplyDecisionAsync(
                _session.Id,
                _pendingDecisionPrompt.DecisionPoint.DecisionPointId,
                option.OptionId,
                customResponse);

            if (outcome is null || !outcome.Applied)
            {
                _decisionPromptError = "Could not apply the selected decision.";
                return;
            }

            _decisionCustomResponse = string.Empty;
            _dismissedDecisionPointId = null;
            await LoadSessionAsync();
        }
        catch (Exception ex)
        {
            _decisionPromptError = ex.Message;
        }
        finally
        {
            _decisionPromptSubmitting = false;
        }
    }

