            || string.Equals(status, "Live", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Automatic", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Committed scenario active", StringComparison.OrdinalIgnoreCase))
