    private void SetCharacterLiveSessionStat(string actorKey, string statName, string? rawValue)
    {
        if (_session is null) return;
        if (!int.TryParse(rawValue, out var parsed))
            parsed = AdaptiveStatCatalog.DefaultValue;
        parsed = Math.Clamp(parsed, AdaptiveStatCatalog.MinValue, AdaptiveStatCatalog.MaxValue);

        if (!_session.AdaptiveState.CharacterStats.TryGetValue(actorKey, out var block))
        {
            block = CharacterStatProfileV2Accessor.CreateDefault(actorKey);
            _session.AdaptiveState.CharacterStats[actorKey] = block;
        }
        var oldValue = CharacterStatProfileV2Accessor.GetStatOrDefault(block, statName, AdaptiveStatCatalog.DefaultValue);
        CharacterStatProfileV2Accessor.SetStat(block, statName, parsed);
        var delta = parsed - oldValue;
        if (delta != 0 && _session.AdaptiveState.CharacterRoles.TryGetValue(actorKey, out var role))
        {
            block.RuntimeEncounterStats ??= new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            StatToDimensionMappings.ApplyDelta(block.RuntimeEncounterStats, role, statName, delta);
        }
        block.UpdatedUtc = DateTime.UtcNow;
        MarkSessionStatsDirty();
    }

