    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _finishOptionsGenerationCts?.Cancel();
        _finishOptionsGenerationCts?.Dispose();
        _finishOptionsGenerationCts = null;

        // B-027: detach chunk callback and unsubscribe tracker event so a disposed
        // component never receives streaming invocations or status change notifications.
        _tracker.DetachChunkCallback(sessionId);
        _tracker.DetachInteractionCompletedCallback(sessionId);
        _tracker.OnJobStatusChanged -= OnTrackerStatusChanged;
        _submissionPollTimer?.Dispose();
        _submissionPollTimer = null;

        if (_resizeInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("rolePlayWorkspace.disposePanelResize", ".rw-panel-resize-handle");
            }
            catch (Exception)
            {
            }
        }

        try
        {
            await JS.InvokeVoidAsync("rolePlayWorkspace.disposeReadCursorObserver");
        }
        catch (Exception)
        {
        }

        _dotNetRef?.Dispose();
    }

