    }

    private sealed record StatIndicator(string Label, string CssClass, string Tooltip);

    private StatIndicator GetFitRuleIndicator(string actorName, string statName, int currentValue)
    {
        var empty = new StatIndicator(string.Empty, "rw-stat-cell", string.Empty);

        if (_activeRpTheme?.FitRules is not { Count: > 0 })
        {
            return empty;
        }

        var characterRole = ResolveCharacterRole(actorName);
        if (string.IsNullOrWhiteSpace(characterRole))
        {
            return empty;
        }

        // Collect all clauses for this stat across rules whose RoleName matches the character's role exactly.
        // No "Any" fallback → show nothing if the role doesn't match.
        var matchingClauses = _activeRpTheme.FitRules
            .Where(r => string.Equals(r.RoleName, characterRole, StringComparison.OrdinalIgnoreCase))
            .SelectMany(r => r.Clauses)
            .Where(c => string.Equals(c.StatName, statName, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (matchingClauses.Count == 0)
        {
            return empty;
        }

        var failingClause = matchingClauses
            .FirstOrDefault(c => !EvaluateComparator(currentValue, c.Comparator, (int)Math.Round(c.Threshold)));

        if (failingClause is null)
        {
            var tooltip = string.Join(", ", matchingClauses.Select(c =>
                $"{statName} {c.Comparator} {c.Threshold:0}"));
            return new StatIndicator("✓", "rw-stat-cell rw-stat-fit-ok", $"Fit: {tooltip}");
        }
        else
        {
            var threshold = (int)Math.Round(failingClause.Threshold);
            var gap = ComputeGap(currentValue, failingClause.Comparator, threshold);
            var gapStr = FormatSignedDelta(gap);
            return new StatIndicator(
                gapStr,
                "rw-stat-cell rw-stat-fit-fail",
                $"Fit: need {statName} {failingClause.Comparator} {threshold} (gap {gapStr})");
        }
    }

    private StatIndicator GetGateBlockIndicator(string actorName, string statName, int currentValue)
    {
        var empty = new StatIndicator(string.Empty, "rw-stat-cell", string.Empty);

        if (_session is null)
            return empty;

        // Map canonical stat name to its NarrativeGateMetricKey equivalent.
        var metricKey = statName switch
        {
            "Desire" => DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDesire,
            "Restraint" => DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageRestraint,
            "Tension" => DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageTension,
            "Connection" => DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageConnection,
            "Dominance" => DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageDominance,
            "Loyalty" => DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageLoyalty,
            "SelfRespect" => DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.AverageSelfRespect,
            _ => null
        };

        var currentPhase = _v2State?.CurrentPhase.ToString() ?? string.Empty;
        var profile = _resolvedEffectiveNarrativeGateProfile;

        // Primary: per-stat average NarrativeGateProfile rule.
        if (metricKey is not null && profile?.Rules is { Count: > 0 })
        {
            var rule = profile.Rules.FirstOrDefault(r =>
                string.Equals(r.FromPhase, currentPhase, StringComparison.OrdinalIgnoreCase)
                && string.Equals(r.MetricKey, metricKey, StringComparison.OrdinalIgnoreCase));

            if (rule is not null)
            {
                var threshold = (int)Math.Round((double)rule.Threshold);
                if (!EvaluateComparator(currentValue, rule.Comparator, threshold))
                {
                    var gap = ComputeGap(currentValue, rule.Comparator, threshold);
                    var gapStr = FormatSignedDelta(gap);
                    return new StatIndicator(
                        gapStr,
                        "rw-stat-cell rw-stat-gate-fail",
                        $"Gate ({rule.FromPhase}?{rule.ToPhase}): need {statName} {rule.Comparator} {threshold} ({gapStr})");
                }
                // Rule exists and is passing → show nothing.
                return empty;
            }
        }

        // Fallback: when the gate is ActiveScenarioScore-based, the fit clauses drive that score.
        // Show the failing fit clause gap for this stat so the Gate column is populated.
        var scoreGateRule = _resolvedBuildUpCommittedRules
            .FirstOrDefault(r =>
                string.Equals(r.MetricKey,
                    DreamGenClone.Domain.RolePlay.NarrativeGateMetricKeys.ActiveScenarioScore,
                    StringComparison.OrdinalIgnoreCase)
                && string.Equals(r.FromPhase, currentPhase, StringComparison.OrdinalIgnoreCase));

        if (scoreGateRule is null || _activeRpTheme?.FitRules is not { Count: > 0 })
            return empty;

        var characterRole = ResolveCharacterRole(actorName);
        var exactFitRules = _activeRpTheme.FitRules
            .Where(r => string.Equals(r.RoleName, characterRole, StringComparison.OrdinalIgnoreCase))
            .ToList();
        List<RPThemeFitRuleClause> fitClauses;
        if (exactFitRules.Count > 0)
        {
            fitClauses = exactFitRules.SelectMany(r => r.Clauses).ToList();
        }
        else
        {
            var v2ActorSnap = _v2State?.CharacterSnapshots.FirstOrDefault(ch => string.Equals(ch.CharacterId, actorName, StringComparison.OrdinalIgnoreCase));
            var bestRule = _activeRpTheme.FitRules
                .OrderByDescending(r =>
                    r.Clauses.Count(c =>
                        v2ActorSnap is not null
                        && CharacterStatProfileV2Accessor.TryGetStat(v2ActorSnap, c.StatName, out var sv)
                        && EvaluateComparator(sv, c.Comparator, (int)Math.Round(c.Threshold))))
                .FirstOrDefault();
            fitClauses = bestRule?.Clauses.ToList() ?? [];
        }

        var failingFitClause = fitClauses
            .Where(c => string.Equals(c.StatName, statName, StringComparison.OrdinalIgnoreCase))
            .FirstOrDefault(c => !EvaluateComparator(currentValue, c.Comparator, (int)Math.Round(c.Threshold)));

        if (failingFitClause is null)
            return empty;

        var fitThreshold = (int)Math.Round(failingFitClause.Threshold);
        var fitGap = ComputeGap(currentValue, failingFitClause.Comparator, fitThreshold);
        var fitGapStr = FormatSignedDelta(fitGap);
        return new StatIndicator(
            fitGapStr,
            "rw-stat-cell rw-stat-gate-fail",
            $"Gate (score): {statName} {failingFitClause.Comparator} {fitThreshold} needed for fit score ({fitGapStr})");
    }

    private static bool EvaluateComparator(int value, string comparator, int threshold)
        => comparator switch
        {
            ">=" => value >= threshold,
            ">" => value > threshold,
            "<=" => value <= threshold,
            "<" => value < threshold,
            "==" => value == threshold,
            _ => false
        };

    private static int ComputeGap(int value, string comparator, int threshold)
        // Positive means "need to increase", negative means "need to decrease".
        // threshold - value gives the signed direction in all cases.
        => threshold - value;

    // Returns the display name for a CharacterStats key (which may be a UUID or a plain name).
    private string ResolveCharacterDisplayName(string actorKey)
    {
        if (_session is not null
            && !string.IsNullOrWhiteSpace(_session.PersonaName)
            && string.Equals(_session.PersonaName.Trim(), actorKey, StringComparison.OrdinalIgnoreCase))
        {
            return _session.PersonaName.Trim();
        }

        if (_loadedScenario is not null)
        {
            var match = _loadedScenario.Characters.FirstOrDefault(x =>
                (!string.IsNullOrWhiteSpace(x.Id) && string.Equals(x.Id.Trim(), actorKey, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(x.Name) && string.Equals(x.Name.Trim(), actorKey, StringComparison.OrdinalIgnoreCase)));
            if (match is not null && !string.IsNullOrWhiteSpace(match.Name))
                return match.Name.Trim();
        }

        return actorKey;
    }

    private sealed record FitClauseGap(string StatName, string Comparator, int Threshold, int CurrentValue, int Gap);

    // Returns per-character failing fit clause gaps for the active theme.
    // Returns null when no theme/fit rules are configured.
    private IReadOnlyList<(string ActorKey, string DisplayName, IReadOnlyList<FitClauseGap> FailingClauses)>?
        GetCharacterFitClauseGaps()
    {
        if (_activeRpTheme?.FitRules is not { Count: > 0 } || _session is null)
            return null;

        var results = new List<(string, string, IReadOnlyList<FitClauseGap>)>();

        foreach (var snap in (_v2State?.CharacterSnapshots ?? []))
        {
            var actorKey = snap.CharacterId;
            // Determine which fit rule to use for this character (same logic as GetFitRuleIndicator).
            var characterRole = ResolveCharacterRole(actorKey);
            var exactRules = _activeRpTheme.FitRules
                .Where(r => string.Equals(r.RoleName, characterRole, StringComparison.OrdinalIgnoreCase))
                .ToList();

            List<RPThemeFitRuleClause> ruleClauses;
            if (exactRules.Count > 0)
            {
                ruleClauses = exactRules.SelectMany(r => r.Clauses).ToList();
            }
            else
            {
                // Pick best-matching rule when RoleName is not a canonical role.
                var bestRule = _activeRpTheme.FitRules
                    .OrderByDescending(r =>
                        r.Clauses.Count(c =>
                            CharacterStatProfileV2Accessor.TryGetStat(snap, c.StatName, out var sv)
                            && EvaluateComparator(sv, c.Comparator, (int)Math.Round(c.Threshold))))
                    .FirstOrDefault();
                ruleClauses = bestRule?.Clauses.ToList() ?? [];
            }

            var failing = new List<FitClauseGap>();
            foreach (var clause in ruleClauses)
            {
                var val = CharacterStatProfileV2Accessor.GetStatOrDefault(snap, clause.StatName);
                var threshold = (int)Math.Round(clause.Threshold);
                if (!EvaluateComparator(val, clause.Comparator, threshold))
                    failing.Add(new FitClauseGap(clause.StatName, clause.Comparator, threshold, val, ComputeGap(val, clause.Comparator, threshold)));
            }

            results.Add((actorKey, ResolveCharacterDisplayName(actorKey), failing));
        }

        return results;
    }

    private string ResolveCharacterGender(string actorName)
    {
        if (_session is not null
            && !string.IsNullOrWhiteSpace(_session.PersonaName)
            && string.Equals(_session.PersonaName.Trim(), actorName, StringComparison.OrdinalIgnoreCase))
        {
            return CharacterGenderCatalog.NormalizeForCharacter(_session.PersonaGender);
        }

        if (_loadedScenario is null)
        {
            return CharacterGenderCatalog.Unknown;
        }

        var scenarioCharacter = _loadedScenario.Characters.FirstOrDefault(x =>
            !string.IsNullOrWhiteSpace(x.Name)
            && string.Equals(x.Name.Trim(), actorName, StringComparison.OrdinalIgnoreCase));

        if (scenarioCharacter is null)
        {
            return CharacterGenderCatalog.Unknown;
        }

        var explicitGender = CharacterGenderCatalog.NormalizeForCharacter(scenarioCharacter.Gender);
        return explicitGender;
    }

    private string ResolveCharacterRole(string actorName)
    {
        if (_session is not null
            && !string.IsNullOrWhiteSpace(_session.PersonaName)
            && string.Equals(_session.PersonaName.Trim(), actorName, StringComparison.OrdinalIgnoreCase))
        {
            return CharacterRoleCatalog.Normalize(_session.PersonaRole);
        }

        if (_loadedScenario is null)
        {
            return CharacterRoleCatalog.Unknown;
        }

        var scenarioCharacter = _loadedScenario.Characters.FirstOrDefault(x =>
            !string.IsNullOrWhiteSpace(x.Name)
            && string.Equals(x.Name.Trim(), actorName, StringComparison.OrdinalIgnoreCase));

        return scenarioCharacter is null
            ? CharacterRoleCatalog.Unknown
            : CharacterRoleCatalog.Normalize(scenarioCharacter.Role);
    }

    private IEnumerable<BaseStatProfile> GetApplicableBaseStatProfiles(Character character)
    {
        return _baseStatProfiles.Where(profile =>
            CharacterGenderCatalog.IsProfileApplicableToCharacter(profile.TargetGender, character.Gender)
            && CharacterRoleCatalog.IsProfileApplicableToCharacter(profile.TargetRole, character.Role));
    }

    private IReadOnlyList<string> GetCharacterRoleOptions(string? selectedRole = null)
    {
        var options = _roleDefinitions.Count > 0
            ? _roleDefinitions.Select(x => x.Name).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList()
            : CharacterRoleCatalog.CharacterRoleOptions.ToList();

        var normalizedSelectedRole = CharacterRoleCatalog.Normalize(selectedRole);
        if (!string.IsNullOrWhiteSpace(normalizedSelectedRole)
            && !string.Equals(normalizedSelectedRole, CharacterRoleCatalog.Unknown, StringComparison.OrdinalIgnoreCase)
            && !options.Contains(normalizedSelectedRole, StringComparer.OrdinalIgnoreCase))
        {
            options.Add(normalizedSelectedRole);
        }

        return options;
    }

    private IReadOnlyList<(string Value, string Label)> GetCharacterRelationTargetOptions(Character character)
    {
        var options = new List<(string Value, string Label)>();

        if (_loadedScenario is not null)
        {
            options.AddRange(_loadedScenario.Characters
                .Where(x => !string.Equals(x.Id, character.Id, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(x.Name))
                .Select(x => (x.Id, x.Name!.Trim())));
        }

        options.AddRange(_characterLikeTemplates
            .Where(x => x.TemplateType == TemplateType.Persona && !string.IsNullOrWhiteSpace(x.Name))
            .Select(x => (CharacterRelationCatalog.CreatePersonaTemplateTargetId(x.Id.ToString()), x.Name.Trim())));

        var selectedTargetId = CharacterRelationCatalog.NormalizeTargetId(character.RelationTargetId);
        if (!string.IsNullOrWhiteSpace(selectedTargetId)
            && !options.Any(x => string.Equals(x.Value, selectedTargetId, StringComparison.OrdinalIgnoreCase)))
        {
            options.Add((selectedTargetId, GetRelationOptionFallbackLabel(selectedTargetId)));
        }

        return options;
    }

    private IReadOnlyList<(string Value, string Label)> GetPersonaRelationTargetOptions()
    {
        var options = (_loadedScenario?.Characters ?? [])
            .Where(x => !string.IsNullOrWhiteSpace(x.Name))
            .Select(x => (Value: x.Id, Label: x.Name!.Trim()))
            .ToList();

        var selectedTargetId = CharacterRelationCatalog.NormalizeTargetId(_session?.PersonaRelationTargetId);
        if (!string.IsNullOrWhiteSpace(selectedTargetId)
            && !options.Any(x => string.Equals(x.Value, selectedTargetId, StringComparison.OrdinalIgnoreCase)))
        {
            options.Add((Value: selectedTargetId, Label: $"Unknown target ({selectedTargetId})"));
        }

        return options;
    }

    private string GetPersonaRelationOptionLabel()
    {
        var personaName = _session is null || string.IsNullOrWhiteSpace(_session.PersonaName)
            ? CharacterRelationCatalog.PersonaDisplayLabel
            : _session.PersonaName.Trim();
        return personaName;
    }

    private void SetScenarioCharacterRelationTarget(Character character, string? targetId)
    {
        if (_loadedScenario is null)
        {
            return;
        }

        UpdateScenarioCharacterRelation(_loadedScenario.Characters, character, targetId);
        SyncPersonaRelationFromScenarioCharacters();
        MarkScenarioDirty();
        _ = SaveSessionSettingsAsync();
    }

    private void SetPersonaRelationTarget(string? targetId)
    {
        if (_session is null)
        {
            return;
        }

        var normalizedTargetId = CharacterRelationCatalog.NormalizeTargetId(targetId);
        _session.PersonaRelationTargetId = normalizedTargetId;

        if (_loadedScenario is not null && !string.IsNullOrWhiteSpace(_session.PersonaTemplateId))
        {
            var personaTemplateTargetId = CharacterRelationCatalog.CreatePersonaTemplateTargetId(_session.PersonaTemplateId);
            if (string.IsNullOrWhiteSpace(normalizedTargetId))
            {
                foreach (var character in _loadedScenario.Characters.Where(x => string.Equals(CharacterRelationCatalog.NormalizeTargetId(x.RelationTargetId), personaTemplateTargetId, StringComparison.OrdinalIgnoreCase)))
                {
                    character.RelationTargetId = null;
                }
            }
            else
            {
                var selectedCharacter = _loadedScenario.Characters.FirstOrDefault(x => string.Equals(x.Id, normalizedTargetId, StringComparison.OrdinalIgnoreCase));
                if (selectedCharacter is not null)
                {
                    UpdateScenarioCharacterRelation(_loadedScenario.Characters, selectedCharacter, personaTemplateTargetId);
                }
            }

            MarkScenarioDirty();
        }

        _ = SaveSessionSettingsAsync();
    }

    private void UpdateScenarioCharacterRelation(List<Character> characters, Character sourceCharacter, string? targetId)
    {
        var normalizedTargetId = CharacterRelationCatalog.NormalizeTargetId(targetId);
        if (string.Equals(normalizedTargetId, sourceCharacter.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var previousTargetId = CharacterRelationCatalog.NormalizeTargetId(sourceCharacter.RelationTargetId);
        if (!string.Equals(previousTargetId, normalizedTargetId, StringComparison.OrdinalIgnoreCase))
        {
            ClearScenarioReciprocalRelation(characters, previousTargetId, sourceCharacter.Id);
        }

        if (CharacterRelationCatalog.IsPersonaTemplateTarget(normalizedTargetId))
        {
            foreach (var character in characters.Where(x => !string.Equals(x.Id, sourceCharacter.Id, StringComparison.OrdinalIgnoreCase)
                && string.Equals(CharacterRelationCatalog.NormalizeTargetId(x.RelationTargetId), normalizedTargetId, StringComparison.OrdinalIgnoreCase)))
            {
                character.RelationTargetId = null;
            }
        }

        sourceCharacter.RelationTargetId = normalizedTargetId;

        var targetCharacter = FindScenarioCharacterByTargetId(characters, normalizedTargetId);
        if (targetCharacter is null)
        {
            return;
        }

        var targetPreviousTargetId = CharacterRelationCatalog.NormalizeTargetId(targetCharacter.RelationTargetId);
        if (!string.Equals(targetPreviousTargetId, sourceCharacter.Id, StringComparison.OrdinalIgnoreCase))
        {
            ClearScenarioReciprocalRelation(characters, targetPreviousTargetId, targetCharacter.Id);
        }

        targetCharacter.RelationTargetId = sourceCharacter.Id;
    }

    private void ClearScenarioReciprocalRelation(List<Character> characters, string? targetId, string sourceCharacterId)
    {
        var reciprocalCharacter = FindScenarioCharacterByTargetId(characters, targetId);
        if (reciprocalCharacter is null)
        {
            return;
        }

        if (string.Equals(CharacterRelationCatalog.NormalizeTargetId(reciprocalCharacter.RelationTargetId), sourceCharacterId, StringComparison.OrdinalIgnoreCase))
        {
            reciprocalCharacter.RelationTargetId = null;
        }
    }

    private static Character? FindScenarioCharacterByTargetId(IEnumerable<Character> characters, string? targetId)
    {
        var normalizedTargetId = CharacterRelationCatalog.NormalizeTargetId(targetId);
        if (string.IsNullOrWhiteSpace(normalizedTargetId)
            || CharacterRelationCatalog.IsPersonaTarget(normalizedTargetId)
            || CharacterRelationCatalog.IsPersonaTemplateTarget(normalizedTargetId))
        {
            return null;
        }

        return characters.FirstOrDefault(x => string.Equals(x.Id, normalizedTargetId, StringComparison.OrdinalIgnoreCase));
    }

    private string GetRelationOptionFallbackLabel(string targetId)
    {
        if (CharacterRelationCatalog.IsPersonaTarget(targetId))
        {
            return GetPersonaRelationOptionLabel();
        }

        var personaTemplateId = CharacterRelationCatalog.TryGetPersonaTemplateId(targetId);
        if (!string.IsNullOrWhiteSpace(personaTemplateId))
        {
            var personaTemplate = _characterLikeTemplates.FirstOrDefault(x => string.Equals(x.Id.ToString(), personaTemplateId, StringComparison.OrdinalIgnoreCase));
            return personaTemplate?.Name?.Trim() ?? $"Unknown persona ({personaTemplateId})";
        }

        return $"Unknown target ({targetId})";
    }

    private void SyncPersonaRelationFromScenarioCharacters()
    {
        if (_session is null || _loadedScenario is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_session.PersonaTemplateId))
        {
            var personaTemplateTargetId = CharacterRelationCatalog.CreatePersonaTemplateTargetId(_session.PersonaTemplateId);
            var linkedCharacter = _loadedScenario.Characters.FirstOrDefault(x =>
                string.Equals(CharacterRelationCatalog.NormalizeTargetId(x.RelationTargetId), personaTemplateTargetId, StringComparison.OrdinalIgnoreCase));
            _session.PersonaRelationTargetId = linkedCharacter?.Id;
            return;
        }

        var legacyLinkedCharacter = _loadedScenario.Characters.FirstOrDefault(x => CharacterRelationCatalog.IsPersonaTarget(x.RelationTargetId));
        _session.PersonaRelationTargetId = legacyLinkedCharacter?.Id;
    }

    private IReadOnlyDictionary<string, int> ResolveCharacterReferenceStats(string actorName)
    {
        // Prefer the session-persisted baseline (set at session-start or when the user clicks Apply).
        // This is the accurate "where stats began" value, which may differ from the scenario's
        // current BaseStats after the user has applied a different profile mid-session.
        if (_session is not null && _v2State is not null)
        {
            var v2Snap = _v2State.CharacterSnapshots.FirstOrDefault(c => string.Equals(c.CharacterId, actorName, StringComparison.OrdinalIgnoreCase));
            if (v2Snap?.BaselineStats is { Count: > 0 })
                return v2Snap.BaselineStats;
        }

        // Backward compat: old sessions without BaselineStats fall back to scenario BaseStats.
        if (_loadedScenario is not null)
        {
            var scenarioCharacter = _loadedScenario.Characters.FirstOrDefault(x =>
                !string.IsNullOrWhiteSpace(x.Name)
                && string.Equals(x.Name.Trim(), actorName, StringComparison.OrdinalIgnoreCase));
            if (scenarioCharacter is not null)
            {
                return AdaptiveStatCatalog.NormalizeComplete(scenarioCharacter.BaseStats);
            }
        }

        return AdaptiveStatCatalog.CreateDefaultStatMap();
    }

    private (string Label, string Reason) ResolveEffectiveStyle(RolePlaySession session)
    {
        IntensityLevel? selectedIntensityLevel = IntensityLevel.Emotional;
        IntensityLevel? adaptiveIntensityLevel = null;

        if (!string.IsNullOrWhiteSpace(session.SelectedIntensityProfileId)
            && _intensityProfilesById.TryGetValue(session.SelectedIntensityProfileId, out var intensityProfile))
        {
            selectedIntensityLevel = intensityProfile.Intensity;
        }

        if (!string.IsNullOrWhiteSpace(session.AdaptiveIntensityProfileId)
            && _intensityProfilesById.TryGetValue(session.AdaptiveIntensityProfileId, out var adaptiveProfile))
        {
            adaptiveIntensityLevel = adaptiveProfile.Intensity;
        }

        return RolePlayStyleResolver.ResolveEffectiveStyle(session, selectedIntensityLevel, adaptiveIntensityLevel);
    }

    private string? GetIntensityDropdownValue()
    {
        if (_session is null)
        {
            return null;
        }

        // Only return the ID if it is actually present in the selectable set (Intro/Atmospheric
        // is excluded from the dropdown). A stale non-selectable ID shows as blank; treat as null.
        var id = _session.SelectedIntensityProfileId;
        if (!string.IsNullOrWhiteSpace(id) && _intensityProfilesById.ContainsKey(id))
        {
            return id;
        }

        return null;
    }

    private string? GetResolvedIntensityProfileId(RolePlaySession session)
    {
        var (label, _) = ResolveEffectiveStyle(session);
        var resolvedScale = RolePlayStyleResolver.ParseBoundScale(label);
        if (!resolvedScale.HasValue)
        {
            return null;
        }

        var matches = _intensityProfiles.Where(profile => (int)profile.Intensity == resolvedScale.Value).Take(2).ToList();
        if (matches.Count != 1)
        {
            return null;
        }

        return matches[0].Id;
    }

    private void CaptureResolvedIntensitySnapshot(RolePlaySession session)
    {
        var (label, reason) = ResolveEffectiveStyle(session);
        session.LastResolvedIntensityLabel = label;
        session.LastResolvedIntensityReason = reason;
        session.LastResolvedIntensityUtc = DateTime.UtcNow;

        // Do NOT overwrite SelectedIntensityProfileId here. It is the user's explicitly chosen
        // base profile and must only change via OnIntensityProfileChanged. Overwriting it with
        // the resolved/adaptive value would corrupt the escalation baseline on every save.
    }

    private static int GetTierPriority(ThemeTier tier)
    {
        return tier switch
        {
            ThemeTier.MustHave => 0,
            ThemeTier.StronglyPrefer => 1,
            ThemeTier.NiceToHave => 2,
            ThemeTier.Neutral => 3,
            ThemeTier.Dislike => 4,
            ThemeTier.HardDealBreaker => 5,
            _ => 99
        };
    }

    private static string FormatTier(ThemeTier tier)
    {
        return tier switch
        {
            ThemeTier.MustHave => "Must Have",
            ThemeTier.StronglyPrefer => "Strongly Prefer",
            ThemeTier.NiceToHave => "Nice To Have",
            ThemeTier.Neutral => "Neutral",
            ThemeTier.Dislike => "Dislike",
            ThemeTier.HardDealBreaker => "Hard Dealbreaker",
            _ => tier.ToString()
        };
    }

    private bool CanAddPromptEntry =>
        _session is not null &&
        HasPromptText &&
        IsAddIntent &&
        !_isSubmitting &&
        !_backgroundSubmissionRunning;

    private bool CanContinue =>
        _session is not null &&
        !_isSubmitting &&
        !_backgroundSubmissionRunning;

    private bool HasPromptText => !string.IsNullOrWhiteSpace(_promptText);

    private bool IsSelectionUiLocked => _isSubmitting && !_isAwaitingModelResponse;

    private bool IsClimaxPhase => _v2State?.CurrentPhase == DreamGenClone.Domain.RolePlay.NarrativePhase.Climax;

    private bool IsNextPhaseEligible => _v2State?.CurrentPhase is
        DreamGenClone.Domain.RolePlay.NarrativePhase.BuildUp or
        DreamGenClone.Domain.RolePlay.NarrativePhase.Committed or
        DreamGenClone.Domain.RolePlay.NarrativePhase.Approaching or
        DreamGenClone.Domain.RolePlay.NarrativePhase.Climax;

    private bool IsSteerEligible => _session is not null
        && _v2State?.CurrentPhase != DreamGenClone.Domain.RolePlay.NarrativePhase.Reset;

    private List<(string CharacterId, string CharacterName, string? Role)> SteerableTargets
    {
        get
        {
            var results = new List<(string, string, string?)>();
            if (_session is null) return results;

            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var kvp in _session.AdaptiveState.CharacterStats)
            {
                if (seen.Contains(kvp.Key)) continue;
                seen.Add(kvp.Key);
                results.Add((kvp.Key, kvp.Key, kvp.Value.CharacterRole));
            }
            foreach (var cp in _session.CharacterPerspectives)
            {
                if (seen.Contains(cp.CharacterId)) continue;
                seen.Add(cp.CharacterId);
                results.Add((cp.CharacterId, cp.CharacterName ?? cp.CharacterId, null));
            }
            return results;
        }
    }

    private bool IsTimeSkipEligible => _session is not null
        && _v2State?.CurrentPhase != DreamGenClone.Domain.RolePlay.NarrativePhase.Reset;

    private bool IsFinishUiLocked => _isSubmitting || _finishOptionSubmitting;
    private List<string> CurrentFinishPage => _finishOptionPages.Count > 0 ? _finishOptionPages[_finishPageIndex] : [];

    private bool IsNextPhaseUiLocked => _isSubmitting || _nextPhaseOptionsLoading || _nextPhaseOptionSubmitting;

    private bool IsSteerUiLocked => _isSubmitting || _steerOptionsLoading || _steerOptionSubmitting;
    private List<string> CurrentSteerPage => _steerOptionPages.Count > 0 ? _steerOptionPages[_steerPageIndex] : [];

    private bool IsTimeSkipUiLocked => _isSubmitting || _timeSkipSubmitting;

    private bool ShowPendingResponseIndicator =>
        _isAwaitingModelResponse && !string.IsNullOrWhiteSpace(_pendingResponseLabel);

    private bool IsAddIntent =>
        _selectedIntent == PromptIntent.Instruction ||
        _selectedIntent == PromptIntent.Narrative ||
        _selectedIntent == PromptIntent.Message;

    private bool IsIdentitySelectionValidForIntent
    {
        get
        {
            if (_selectedIntent == PromptIntent.Instruction)
            {
                return true;
            }

            if (_selectedIdentity is null || !_selectedIdentity.IsAvailable)
            {
                return false;
            }

            if (_selectedIdentity.SourceType == IdentityOptionSource.CustomCharacter)
            {
                return !string.IsNullOrWhiteSpace(_customIdentityName);
            }

            return true;
        }
    }

    private bool IsIdentityOptionDisabled(IdentityOption option) => IsSelectionUiLocked;

    private string? GetIdentityOptionTitle(IdentityOption option)
    {
        if (IsSelectionUiLocked)
        {
            return "Please wait for the current action to finish.";
        }

        return option.IsAvailable ? null : option.AvailabilityReason;
    }

    private async Task AddPromptEntryAsync()
    {
        if (!CanAddPromptEntry) return;

        _isSubmitting = true;
        _statusMessage = string.Empty;
        CloseAllPopups();

        try
        {
            var selectedIdentity = _selectedIntent == PromptIntent.Instruction ? null : _selectedIdentity;
            if (_selectedIntent != PromptIntent.Instruction && selectedIdentity is null)
            {
                _statusMessage = "Select a character before adding the interaction.";
                return;
            }

            var submission = new UnifiedPromptSubmission
            {
                SessionId = _session!.Id,
                PromptText = _promptText.Trim(),
                Intent = _selectedIntent,
                SelectedIdentityId = selectedIdentity?.Id ?? string.Empty,
                SelectedIdentityType = selectedIdentity?.SourceType ?? IdentityOptionSource.Persona,
                CustomIdentityName = string.IsNullOrWhiteSpace(_customIdentityName) ? null : _customIdentityName.Trim(),
                BehaviorModeAtSubmit = _selectedBehaviorMode,
                SubmittedVia = SubmissionSource.PlusButton
            };

            Logger.LogInformation(
                "Role-play entry added from + button without continuation: session={SessionId}, intent={Intent}, identity={IdentityId}",
                _session.Id,
                _selectedIntent,
                submission.SelectedIdentityId);

            await RolePlayEngine.SubmitPromptAsync(submission);

            _promptText = string.Empty;
            await LoadSessionAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            Logger.LogError(ex, "Prompt entry via + failed for session {SessionId}", sessionId);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ContinuePromptAsync()
    {
        if (!CanContinue)
        {
            return;
        }

        if (_session is null)
        {
            return;
        }

        if (!HasPromptText)
        {
            // No text: pure continue.
            var request = BuildContinueRequest(SubmissionSource.MainOverflowContinue, useCustomSelections: false);
            await ExecuteContinueAsync(request, "Continue failed.");
            return;
        }

        // Has text: stage + continue in one engine call.
        // Block duplicate submissions while a background task is active.
        if (_tracker.GetEntry(sessionId) is not null)
        {
            _statusMessage = "A response is already in progress.";
            return;
        }

        _isSubmitting = true;
        _statusMessage = string.Empty;
        CloseAllPopups();

        var awaitsModelResponse = _selectedIntent != PromptIntent.Instruction;
        if (awaitsModelResponse)
        {
            _isAwaitingModelResponse = true;
            _pendingResponseLabel = BuildPromptPendingResponseLabel();
            _pendingResponseText = string.Empty;
            _pendingResponseBuilder.Clear();
            _lastPendingResponseRenderAt = DateTime.MinValue;
            _newInteractionCountThisTurn = 0;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
        }

        var submission = new UnifiedPromptSubmission
        {
            SessionId = _session!.Id,
            PromptText = _promptText.Trim(),
            Intent = _selectedIntent,
            SelectedIdentityId = _selectedIntent == PromptIntent.Instruction ? string.Empty : (_selectedIdentity?.Id ?? string.Empty),
            SelectedIdentityType = _selectedIntent == PromptIntent.Instruction ? IdentityOptionSource.Persona : (_selectedIdentity?.SourceType ?? IdentityOptionSource.Persona),
            CustomIdentityName = string.IsNullOrWhiteSpace(_customIdentityName) ? null : _customIdentityName.Trim(),
            BehaviorModeAtSubmit = _selectedBehaviorMode,
            SubmittedVia = SubmissionSource.MainOverflowContinue
        };

        Logger.LogInformation(
            "Role-play continue with text: session={SessionId}, intent={Intent}, mode={Mode}",
            _session.Id,
            _selectedIntent,
            _selectedBehaviorMode);

        var engineTask = RolePlayEngine.SubmitPromptAsync(
            submission,
            awaitsModelResponse ? OnRolePlayResponseChunkAsync : null,
            awaitsModelResponse ? OnRolePlayInteractionCompletedAsync : null,
            awaitsModelResponse ? OnRolePlayActorStart : null);

        _tracker.TryBeginSubmission(sessionId, submission, engineTask);
        _tracker.OnJobStatusChanged += OnTrackerStatusChanged;

        _promptText = string.Empty;
        _backgroundSubmissionRunning = true;
        _isSubmitting = false;
        await InvokeAsync(StateHasChanged);
    }

    // Called by the tracker (on a thread-pool thread) when the engine task completes or fails.
    private async void OnTrackerStatusChanged(string changedSessionId)
    {
        if (changedSessionId != sessionId) return;

        _tracker.OnJobStatusChanged -= OnTrackerStatusChanged;
        _submissionPollTimer?.Dispose();
        _submissionPollTimer = null;

        try
        {
            await InvokeAsync(async () =>
            {
                _backgroundSubmissionRunning = false;
                _isAwaitingModelResponse = false;
                _pendingResponseLabel = string.Empty;
                _pendingResponseText = string.Empty;
                _pendingResponseBuilder.Clear();
                _lastPendingResponseRenderAt = DateTime.MinValue;

                var entry = _tracker.GetEntry(sessionId);
                if (entry?.Status == RolePlaySubmissionStatus.Failed)
                {
                    // Non-resubmittable failure: show error inline and auto-acknowledge.
                    _statusMessage = entry.FailureMessage ?? "Action failed.";
                    _tracker.AcknowledgeFailure(sessionId);
                    Logger.LogWarning(
                        "Continue action failed for session {SessionId}: {FailureMessage}",
                        sessionId, entry.FailureMessage);
                }
                else
                {
                    await LoadSessionAsync();
                }

                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnTrackerStatusChanged handler threw for session {SessionId}", sessionId);
        }
    }

