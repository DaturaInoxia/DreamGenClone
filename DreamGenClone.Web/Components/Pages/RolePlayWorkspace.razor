    private async Task GenerateSteerOptionsAsync()
    {
        if (_session is null || !IsSteerEligible)
        {
            return;
        }

        _steerOptionsLoading = true;
        _steerOptionError = string.Empty;
        _steerGenerationIndex++;
        try
        {
            if (_steerUseGuidedFlow)
            {
                // Position flow: existing behaviour unchanged.
                var context = BuildAssistantContext();
                var prompt = await BuildPositionSteerOptionsPromptAsync();
                var response = await RolePlayAssistant.GenerateSuggestionAsync(
                    context, prompt,
                    assistantModelId: string.IsNullOrWhiteSpace(_session.SessionModelId) ? null : _session.SessionModelId,
                    assistantTemperature: _session.SessionTemperature,
                    assistantTopP: _session.SessionTopP,
                    assistantMaxTokens: _session.SessionMaxTokens,
                    appFunction: AppFunction.RolePlaySteering);
                var newPage = ParseFinishOptions(response).ToList();
                if (newPage.Count == 0)
                {
                    _steerOptionError = "Could not generate steering options. Try again.";
                    return;
                }
                _steerOptionPages.Add(newPage);
                _steerPageIndex = _steerOptionPages.Count - 1;
                _selectedSteerOption = newPage[0];
                return;
            }

            // ── B-075: All-character structured generation ──
            var genPrompt = await BuildAllCharacterSteerPromptAsync();
            var genResponse = await RolePlayAssistant.GenerateSuggestionAsync(
                BuildAssistantContext(), genPrompt,
                assistantModelId: string.IsNullOrWhiteSpace(_session.SessionModelId) ? null : _session.SessionModelId,
                assistantTemperature: _session.SessionTemperature,
                assistantTopP: _session.SessionTopP,
                assistantMaxTokens: _session.SessionMaxTokens,
                appFunction: AppFunction.RolePlaySteering);

            var parsed = SteerGenerationParser.TryParse(genResponse);
            if (parsed is null || parsed.Characters.Count == 0)
            {
                // Fallback: try to use raw response as flat options.
                var fallback = ParseFinishOptions(genResponse).ToList();
                if (fallback.Count > 0)
                {
                    _steerOptionPages.Add(fallback);
                    _steerPageIndex = _steerOptionPages.Count - 1;
                    _selectedSteerOption = fallback[0];
                }
                else
                {
                    _steerOptionError = "Could not parse steering options. Try again.";
                }
                _cachedSteerResponse = null;
                _cachedSteerGenerationId = null;
                return;
            }

            _cachedSteerResponse = parsed;
            _cachedSteerGenerationId = null; // generated on Apply

            // Build snapshot and persist generation record.
            var snapshot = BuildCharacterSnapshotJson();
            var record = new SteeringGenerationRecord
            {
                SessionId = _session.Id,
                GenerationPrompt = genPrompt,
                GenerationResponse = genResponse,
                ParsedOptionsJson = JsonSerializer.Serialize(parsed),
                CharacterSnapshotJson = snapshot,
                ActiveThemeId = _v2State?.PrimaryThemeId,
                ActiveThemeLabel = (await GetActiveThemeLabelAsync()) ?? _v2State?.PrimaryThemeId,
                Phase = _v2State?.CurrentPhase.ToString(),
                ModelIdentifier = _session.SessionModelId,
                Succeeded = true,
                CreatedUtc = DateTime.UtcNow,
                UpdatedUtc = DateTime.UtcNow
            };

            await Persistence.SaveSteeringGenerationRecordAsync(record);
            _cachedSteerGenerationId = record.Id;

            // Populate flat pages for the existing popup renderer.
            RefreshLocalSteerPages();
        }
        catch (Exception ex)
        {
            _steerOptionError = ex.Message;
            Logger.LogError(ex, "Failed generating steer options for session {SessionId}", _session.Id);
        }
        finally
        {
            _steerOptionsLoading = false;
        }
    }

    private async Task<string?> GetActiveThemeLabelAsync()
    {
        if (_session is null || string.IsNullOrWhiteSpace(_v2State?.PrimaryThemeId)) return null;
        try
        {
            var theme = await RPThemeService.GetThemeAsync(_v2State.PrimaryThemeId);
            return theme?.Label ?? theme?.Id;
        }
        catch { return null; }
    }

    private string? BuildCharacterSnapshotJson()
    {
        if (_session is null) return null;
        var snapshots = new List<object>();
        foreach (var kvp in _session.AdaptiveState.CharacterStats)
        {
            var p = kvp.Value;
            snapshots.Add(new
            {
                characterId = p.CharacterId,
                characterName = kvp.Key,
                role = p.CharacterRole,
                stats = new { p.Desire, p.Restraint, p.Dominance, p.Loyalty, p.SelfRespect },
                encounterDimensions = p.RuntimeEncounterStats
            });
        }
        return snapshots.Count > 0 ? JsonSerializer.Serialize(new { characters = snapshots }) : null;
    }

    private void RefreshLocalSteerPages()
    {
        _steerOptionPages.Clear();
        _steerPageIndex = 0;
        _selectedSteerOption = string.Empty;

        if (_cachedSteerResponse is null) return;

        // Select the currently chosen character; default to first.
        var targetId = _steerTargetCharacterId;
        var match = _cachedSteerResponse.Characters.FirstOrDefault(c =>
            string.Equals(c.CharacterId, targetId, StringComparison.OrdinalIgnoreCase));
        if (match is null && _cachedSteerResponse.Characters.Count > 0)
        {
            match = _cachedSteerResponse.Characters[0];
            _steerTargetCharacterId = match.CharacterId;
            _steerTargetCharacterLabel = match.CharacterName;
        }
        if (match is null) return;

        var page = new List<string>
        {
            match.Options.Away,
            match.Options.Neutral,
            match.Options.Towards,
            match.Options.Hard
        };

        _steerOptionPages.Add(page);
        _selectedSteerOption = page[0];
    }

    private async Task<string> BuildAllCharacterSteerPromptAsync()
    {
        if (_session is null) return "Generate 4 steering choices per character. Return ONLY structured JSON.";

        var phase = (_v2State?.CurrentPhase.ToString()) ?? string.Empty;
        var sb = new StringBuilder();

        sb.AppendLine("You are generating steering options for EVERY active steerable character in the current scene.");
        sb.AppendLine();

        var targets = SteerableTargets;
        if (targets.Count == 0)
        {
            sb.AppendLine("No characters available.");
            return sb.ToString();
        }

        sb.AppendLine($"Current phase: {phase}");
        var activeTheme = _v2State?.PrimaryThemeId;
        if (!string.IsNullOrWhiteSpace(activeTheme))
        {
            sb.AppendLine($"Active theme ID: {activeTheme}");
        }
        sb.AppendLine();

        // ── B-077: Gap-aware steering block — placed BEFORE characters so every character's TOWARDS/HARD is gap-informed ──
        await AppendWillingnessGapBlockAsync(sb);

        // Per-character sections.
        foreach (var (charId, charName, charRole) in targets)
        {
            sb.AppendLine($"--- Character: {charName} ---");
            sb.AppendLine($"  ID: {charId}");
            sb.AppendLine($"  Role: {charRole ?? "unassigned"}");
            if (!string.IsNullOrWhiteSpace(charRole))
            {
                sb.AppendLine($"  Role context: {SteerRoleIntentCatalog.GetRoleContext(charRole)}");
            }

            AppendTargetCharacterStatsContext(sb, charName, charRole);

            if (!string.IsNullOrWhiteSpace(charRole))
            {
                var awayIntent = SteerRoleIntentCatalog.GetIntent(charRole, V2RolePlay.SteerDirection.Away);
                var neutralIntent = SteerRoleIntentCatalog.GetIntent(charRole, V2RolePlay.SteerDirection.Neutral);
                var towardsIntent = SteerRoleIntentCatalog.GetIntent(charRole, V2RolePlay.SteerDirection.Towards);
                var hardIntent = SteerRoleIntentCatalog.GetIntent(charRole, V2RolePlay.SteerDirection.Hard);
                sb.AppendLine($"  Direction intents:");
                sb.AppendLine($"    AWAY   — {awayIntent}");
                sb.AppendLine($"    NEUTRAL — {neutralIntent}");
                sb.AppendLine($"    TOWARDS — {towardsIntent}");
                sb.AppendLine($"    HARD   — {hardIntent}");
            }
            sb.AppendLine();
        }

        await AppendThemeReferenceContextAsync(sb, phase);

        var recentContext = BuildRecentSteerContextText();
        if (!string.IsNullOrWhiteSpace(recentContext))
        {
            sb.AppendLine($"Recent scene context (abbreviated):");
            sb.AppendLine(recentContext);
            sb.AppendLine();
        }

        sb.AppendLine("Generate exactly 4 steering directives for EACH character above, in this fixed order:");
        sb.AppendLine("  1. AWAY");
        sb.AppendLine("  2. NEUTRAL");
        sb.AppendLine("  3. TOWARDS");
        sb.AppendLine("  4. HARD");
        sb.AppendLine();
        sb.AppendLine("Constraints:");
