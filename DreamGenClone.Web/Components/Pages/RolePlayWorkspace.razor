    /// <summary>
    /// Returns true when the given perspective entry is the persona (should be excluded
    /// from the Turn Overrides panel). Matches by the persona character's scenario ID when
    /// available, and only falls back to name-matching when no NPC shares that name.
    /// </summary>
    private static bool IsPersonaPerspectiveEntry(
        RolePlayCharacterPerspective entry,
        Character? personaChar,
        string personaNameFallback,
        bool hasNpcNamedLikePersona)
    {
        if (personaChar is not null)
        {
            // Match by the persona's scenario character ID (most precise, works for new sessions
            // where the persona has a GUID Id in CharacterPerspectives).
            if (string.Equals(entry.CharacterId, personaChar.Id, StringComparison.OrdinalIgnoreCase))
                return true;
            // Also match by persona name as a secondary check in case the perspective entry
            // was seeded by name rather than ID (legacy CreateSessionAsync path).
            if (!string.IsNullOrWhiteSpace(personaChar.Name)
                && string.Equals(entry.CharacterName, personaChar.Name.Trim(), StringComparison.OrdinalIgnoreCase))
                return true;
            return false;
        }

        // No persona character defined — fall back to name match, but ONLY when it's safe:
        // if an NPC shares the persona name, we can't distinguish and must NOT filter
        // (avoids false positives, e.g. persona "Ken" accidentally excluding NPC "Ken").
        if (!hasNpcNamedLikePersona
            && string.Equals(entry.CharacterName, personaNameFallback, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }

    private async Task OnSaveScenarioClicked()
    {
        // Snapshot manual stat overrides before any potential scenario rebuild
        Dictionary<string, Dictionary<string, int>>? statSnapshot = null;
        if (_sessionStatsDirty && _session is not null)
        {
            statSnapshot = _session.AdaptiveState.CharacterStats
                .ToDictionary(
                    kvp => kvp.Key,
                    kvp => CharacterStatProfileV2Accessor.GetAllStats(kvp.Value),
                    StringComparer.OrdinalIgnoreCase);
        }

        if (_scenarioDirty)
        {
            await SaveScenarioAsync(); // may rebuild adaptive state from scenario
        }

        if (_sessionStatsDirty && _session is not null)
        {
            // Re-apply user stat overrides on top of any rebuild result
            if (statSnapshot is not null)
            {
                foreach (var (actorKey, stats) in statSnapshot)
                {
                    if (!_session.AdaptiveState.CharacterStats.TryGetValue(actorKey, out var block))
                    {
                        block = CharacterStatProfileV2Accessor.CreateDefault(actorKey);
                        _session.AdaptiveState.CharacterStats[actorKey] = block;
                    }
                    foreach (var (statName, value) in stats)
                        CharacterStatProfileV2Accessor.SetStat(block, statName, value);
                }
            }
            await SaveSessionSettingsAsync();
        }

        _scenarioDirty = false;
        _sessionStatsDirty = false;
        StateHasChanged();
    }

    private async Task SaveScenarioAsync()
    {
        if (_loadedScenario is null) return;
        try
        {
            await ScenarioService.SaveScenarioAsync(_loadedScenario);
            if (_session is not null)
            {
                _session = await RolePlayEngine.RebuildAdaptiveStateAsync(_session.Id);
                await HydrateV2AdaptiveStateAsync();
                await RefreshActiveProfileThemesAsync();
            }
            Logger.LogInformation("Scenario saved from workspace: {ScenarioId}", _loadedScenario.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save scenario {ScenarioId}", _loadedScenario.Id);
        }
    }

    private async Task SaveSessionSettingsAsync()
    {
        if (_session is null) return;
        try
        {
            await ReloadAndSaveSessionAsync(CaptureResolvedIntensitySnapshot);
            await HydrateV2AdaptiveStateAsync();
            await RefreshActiveProfileThemesAsync();
            Logger.LogInformation("Session settings saved: {SessionId}", _session.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save session settings {SessionId}", _session.Id);
        }
    }

