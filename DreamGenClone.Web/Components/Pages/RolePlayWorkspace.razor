    private async Task OnTimeOfDayOverrideChanged(ChangeEventArgs e)
    {
        if (_session is null) return;
        var value = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            _session.AdaptiveState.TimeOfDayManuallySet = false;
        }
        else if (Enum.TryParse<TimeOfDay>(value, out var parsed))
        {
            _session.AdaptiveState.TimeOfDayManuallySet = true;
            _session.AdaptiveState.CurrentTimeOfDay = parsed;
        }
        MarkScenarioDirty();
        await SaveSessionSettingsAsync();
    }

    private async Task OnSceneContinueBatchSizeChanged(ChangeEventArgs e)
    {
        if (_session is null) return;
        if (int.TryParse(e.Value?.ToString(), out var parsed) && parsed >= 1 && parsed <= 6)
        {
            _session.SceneContinueBatchSize = parsed;
            MarkScenarioDirty();
            await SaveSessionSettingsAsync();
        }
    }

    private async Task OnPreferredPositionOverrideChanceChanged(ChangeEventArgs e)
    {
        if (_session is null) return;
        if (double.TryParse(e.Value?.ToString(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
