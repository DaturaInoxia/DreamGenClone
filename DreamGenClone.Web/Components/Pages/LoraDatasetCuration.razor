@page "/asset-studio/lora-datasets/{DatasetId}"
@rendermode InteractiveServer

@using System.Text.Json
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay

@inject ICharacterLoraRepository LoraRepository
@inject ICharacterLoraDatasetRegistrationService RegistrationService
@inject ISceneAssetRepository AssetRepository
@inject NavigationManager Navigation
@inject ILogger<LoraDatasetCuration> Logger

<PageTitle>Curate LoRA Dataset - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h4 class="mb-1">Curate LoRA Dataset</h4>
            <div class="font-monospace small text-muted text-break">@DatasetId</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @* This page is where the shoot ENDS and nothing here led back to the cells that feed it, so landing on it
               made the workspace reachable only by typing its URL. The section name is the tab CharacterStudio
               already shows ("LoRA images"), and the section query is what opens it. *@
            @if (_dataset is not null)
            {
                <a class="btn btn-outline-primary btn-sm"
                   href="/characters/@Uri.EscapeDataString(_dataset.CharacterTemplateId)?section=LoRA%20images">
                    <i class="bi bi-images me-1"></i>Shoot / approve cells
                </a>
            }
            <a href="/asset-studio" class="btn btn-outline-secondary btn-sm">Back to Asset Manager</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert alert-info">@_status</div>
    }
    @if (_dataset is null)
    {
        <div class="text-muted">Loading dataset...</div>
    }
    else
    {
        <section class="card mb-3" aria-label="Dataset manifest">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <strong>Dataset v@_dataset.Version</strong>
                <span class="badge @(_dataset.Status == CharacterLoraDatasetStatus.Frozen ? "text-bg-success" : "text-bg-secondary")">@_dataset.Status</span>
            </div>
            <div class="card-body small">
                <div class="row g-2">
                    <div class="col-md-3"><strong>Character</strong><div class="font-monospace text-break">@_dataset.CharacterTemplateId</div></div>
                    <div class="col-md-3">
                        <strong>Identity pack</strong>
                        <div class="font-monospace text-break">@_dataset.IdentityPackId</div>
                        <a href="/characters/identity?characterId=@Uri.EscapeDataString(_dataset.CharacterTemplateId)&amp;packId=@Uri.EscapeDataString(_dataset.IdentityPackId)">View source pack</a>
                    </div>
                    <div class="col-md-3"><strong>Trigger token</strong><div class="font-monospace text-break">@_dataset.TriggerToken</div></div>
                    <div class="col-md-3">
                        <strong>Target family</strong>
                        @if (IsFrozen)
                        {
                            <div class="font-monospace text-break">@_dataset.TargetModelFamily</div>
                        }
                        else
                        {
                            <div class="d-flex gap-1">
                                <select class="form-select form-select-sm" aria-label="Target model family" disabled="@_busy" @bind="_familyDraft">
                                    @foreach (var family in CharacterLoraModelFamilies.All)
                                    {
                                        <option value="@family">@family</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_busy || string.Equals(_familyDraft, _dataset.TargetModelFamily, StringComparison.Ordinal))" @onclick="SaveFamilyAsync">Save</button>
                            </div>
                        }
                        <div class="form-text">What this set is trained for. Changing it re-points which qualified profiles may train this dataset; it changes no image.</div>
                    </div>
                </div>
                @if (!CharacterLoraModelFamilies.IsKnown(_dataset.TargetModelFamily))
                {
                    <div class="alert alert-warning small mt-3 mb-0">
                        This dataset declares family '<strong>@_dataset.TargetModelFamily</strong>', which is not a
                        trainable family, so no qualified training profile can ever match it. Pick one of
                        @string.Join(", ", CharacterLoraModelFamilies.All) above and save.
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_dataset.ManifestSha256))
                {
                    <div class="mt-2"><strong>Manifest SHA-256</strong><div class="font-monospace text-break">@_dataset.ManifestSha256</div></div>
                    <a class="btn btn-primary btn-sm mt-3" href="/asset-studio/lora-datasets/@DatasetId/training">Open Training Workflow</a>
                }
            </div>
        </section>

        @* Where the operator is, and what the next action is. Every control on this page is dead until the cells have
           accepted images, and the page never said so: it showed four disabled controls and a badge whose meaning
           ("pending" = no attempt of this cell has been accepted yet) lives only in the registration service. *@
        @if (IsFrozen)
        {
            <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><strong>Frozen.</strong> The manifest is recorded, so this dataset is ready to train.</span>
                <a class="btn btn-primary btn-sm" href="/asset-studio/lora-datasets/@DatasetId/training">Open Training Workflow</a>
            </div>
        }
        else if (_preview is null)
        {
            <div class="alert alert-secondary">Reading this dataset's cells...</div>
        }
        else if (_preview.Refused.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>@_preview.Refused.Count cell(s) block registration.</strong> A cell contributes exactly one
                training image, so revoke every accepted attempt but the one you want for each of those cells, then
                come back. Registration cannot proceed while any cell has more than one.
            </div>
        }
        else if (_preview.Ready.Count > 0)
        {
            <div class="alert alert-primary">
                <strong>@_preview.Ready.Count cell(s) are ready.</strong> Record the approval facts below, press
                <strong>Register</strong>, accept the members that appear, then freeze the manifest.
            </div>
        }
        else if (_members.Count > 0)
        {
            <div class="alert alert-primary">
                Every cell that has an accepted image is registered. Accept the members below, then press
                <strong>Freeze Exact Manifest</strong>.
            </div>
        }
        else
        {
            <div class="alert alert-secondary">
                <strong>Nothing to register yet.</strong> None of the @_preview.Pending.Count cell(s) has an accepted
                image, so no control on this page can do anything until some do.
                <a class="alert-link"
                   href="/characters/@Uri.EscapeDataString(_dataset.CharacterTemplateId)?section=LoRA%20images">Shoot the cells</a>
                on the character's LoRA images tab and accept one attempt per cell there, then come back.
            </div>
        }

        @if (!IsFrozen)
        {
            <section class="card mb-4" aria-label="Register accepted cell images">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong>Register accepted cell images</strong>
                    @if (_preview is not null)
                    {
                        <span class="badge text-bg-secondary">@_preview.Ready.Count ready · @_preview.Registered.Count registered · @_preview.Pending.Count pending · @_preview.Refused.Count blocked</span>
                    }
                </div>
                <div class="card-body small">
                    <p class="text-muted">
                        An accepted cell image is not in the dataset until it is registered. Registering promotes each
                        accepted image into its own Scene Asset that shares its bytes, approves that asset for
                        <strong>CharacterLoraTraining</strong>, and adds it as a dataset member. Freezing then verifies
                        every one of those facts.
                    </p>

                    @if (_preview is null)
                    {
                        <div class="text-muted">Reading the dataset's cells...</div>
                    }
                    else
                    {
                        @if (_preview.Ready.Count > 0)
                        {
                            <details class="mb-2">
                                <summary>@_preview.Ready.Count cell(s) ready to register</summary>
                                <ul class="mb-0">
                                    @foreach (var item in _preview.Ready)
                                    {
                                        <li>
                                            <span class="font-monospace">@item.CellKey</span>
                                            · @item.MemberRole · @item.Split · attempt <span class="font-monospace">@item.Image.Id</span>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }

                        @if (_preview.Refused.Count > 0)
                        {
                            <div class="alert alert-danger py-2">
                                <strong>@_preview.Refused.Count cell(s) are ambiguous and block registration:</strong>
                                <ul class="mb-0">
                                    @foreach (var item in _preview.Refused)
                                    {
                                        <li><span class="font-monospace">@item.CellKey</span> — @item.Reason</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (_preview.Pending.Count > 0)
                        {
                            <details class="mb-2">
                                <summary>@_preview.Pending.Count cell(s) have no accepted image yet (they are skipped)</summary>
                                <ul class="mb-0">
                                    @foreach (var item in _preview.Pending)
                                    {
                                        <li><span class="font-monospace">@item.CellKey</span></li>
                                    }
                                </ul>
                            </details>
                        }

                        @if (_preview.Registered.Count > 0)
                        {
                            <details class="mb-2">
                                <summary>@_preview.Registered.Count cell(s) are already members of this dataset</summary>
                                <ul class="mb-0">
                                    @foreach (var item in _preview.Registered)
                                    {
                                        <li><span class="font-monospace">@item.CellKey</span></li>
                                    }
                                </ul>
                            </details>
                        }

                        <h6 class="mt-3">Approval facts recorded on every promoted asset</h6>
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label small" for="reg-provenance">Source provenance JSON</label>
                                <textarea id="reg-provenance" class="form-control form-control-sm font-monospace" rows="2" @bind="_registrationProvenance"></textarea>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small" for="reg-consent">Consent</label>
                                <select id="reg-consent" class="form-select form-select-sm" @bind="_registrationConsent">
                                    <option value="">Select consent</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="NotApplicable">Not applicable</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small" for="reg-license">License</label>
                                <select id="reg-license" class="form-select form-select-sm" @bind="_registrationLicense">
                                    <option value="">Select license</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="NotApplicable">Not applicable</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small" for="reg-license-label">License label</label>
                                <input id="reg-license-label" class="form-control form-control-sm" @bind="_registrationLicenseLabel" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small" for="reg-policy">Content policy key</label>
                                <input id="reg-policy" class="form-control form-control-sm" @bind="_registrationPolicy" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small" for="reg-compatibility">Compatibility metadata JSON</label>
                                <textarea id="reg-compatibility" class="form-control form-control-sm font-monospace" rows="2" @bind="_registrationCompatibility"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Approved use scope</label>
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var scope in Enum.GetValues<SceneAssetApprovedUseScope>())
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="reg-scope-@scope"
                                                   checked="@_registrationScopes.Contains(scope)"
                                                   @onchange="args => ToggleScope(scope, args)" />
                                            <label class="form-check-label" for="reg-scope-@scope">@scope</label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small" for="reg-reviewer">Reviewer id</label>
                                <input id="reg-reviewer" class="form-control form-control-sm" @bind="_reviewedBy" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm mt-3" disabled="@(_busy || !CanRegister)" @onclick="RegisterAsync">
                            Register @_preview.Ready.Count member(s)
                        </button>
                        @if (!RegistrationUseScopeHasLoraTraining)
                        {
                            <div class="form-text text-danger">CharacterLoraTraining must be granted: a member is a training image.</div>
                        }
                    }
                </div>
            </section>
        }

        @* The "nothing has been registered yet" alert that stood here said what the state banner above now says,
           with the reason and the next action. Two messages for one fact is how a page reads as noise. *@
        @foreach (var editor in _members)
        {
            <section class="card mb-3" aria-label="Dataset member @editor.Member.Ordinal">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong>Candidate @(editor.Member.Ordinal + 1)</strong>
                    <span class="badge @(editor.Member.CurationStatus == CharacterLoraCurationStatus.Accepted ? "text-bg-success" : editor.Member.CurationStatus == CharacterLoraCurationStatus.Rejected ? "text-bg-danger" : "text-bg-secondary")">@editor.Member.CurationStatus</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-lg-4">
                            @if (editor.Asset is not null && !string.IsNullOrWhiteSpace(editor.Asset.FileRelativePath))
                            {
                                <img src="/scene-images/@editor.Asset.FileRelativePath" class="img-fluid w-100 mb-2" style="max-height:360px;object-fit:contain;background:#101010;" alt="Candidate @(editor.Member.Ordinal + 1)" />
                            }
                            <dl class="row small mb-0">
                                <dt class="col-4">Asset</dt><dd class="col-8 font-monospace text-break">@editor.Member.SceneAssetId</dd>
                                <dt class="col-4">Version</dt><dd class="col-8">@editor.Member.SceneAssetVersion</dd>
                                <dt class="col-4">Attempt</dt><dd class="col-8 font-monospace text-break">@editor.Member.GenerationAttemptId</dd>
                                <dt class="col-4">SHA-256</dt><dd class="col-8 font-monospace text-break">@editor.Member.AssetSha256</dd>
                            </dl>
                        </div>
                        <div class="col-lg-8">
                            <label class="form-label small" for="caption-@editor.Member.Id">Caption</label>
                            <textarea id="caption-@editor.Member.Id" class="form-control form-control-sm" rows="3" disabled="@IsFrozen" @bind="editor.Member.Caption"></textarea>
                            <div class="row g-2 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label small" for="role-@editor.Member.Id">Role</label>
                                    <select id="role-@editor.Member.Id" class="form-select form-select-sm" disabled="@IsFrozen" @bind="editor.Member.Role">
                                        @foreach (var role in Enum.GetValues<CharacterLoraDatasetMemberRole>())
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small" for="split-@editor.Member.Id">Split</label>
                                    <select id="split-@editor.Member.Id" class="form-select form-select-sm" disabled="@IsFrozen" @bind="editor.Member.Split">
                                        @foreach (var split in Enum.GetValues<CharacterLoraDatasetSplit>())
                                        {
                                            <option value="@split">@split</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <fieldset class="mt-3" disabled="@IsFrozen">
                                <legend class="fs-6">Curation findings</legend>
                                <div class="row g-2 small">
                                    <div class="col-sm-6"><div class="form-check"><input id="drift-@editor.Member.Id" class="form-check-input" type="checkbox" @bind="editor.IdentityDrift" /><label class="form-check-label" for="drift-@editor.Member.Id">Identity drift</label></div></div>
                                    <div class="col-sm-6"><div class="form-check"><input id="duplicate-@editor.Member.Id" class="form-check-input" type="checkbox" @bind="editor.NearDuplicate" /><label class="form-check-label" for="duplicate-@editor.Member.Id">Near duplicate</label></div></div>
                                    <div class="col-sm-6"><div class="form-check"><input id="anatomy-@editor.Member.Id" class="form-check-input" type="checkbox" @bind="editor.AnatomyIssue" /><label class="form-check-label" for="anatomy-@editor.Member.Id">Anatomy issue</label></div></div>
                                    <div class="col-sm-6"><div class="form-check"><input id="leakage-@editor.Member.Id" class="form-check-input" type="checkbox" @bind="editor.Leakage" /><label class="form-check-label" for="leakage-@editor.Member.Id">Identity or wardrobe leakage</label></div></div>
                                    <div class="col-sm-6"><div class="form-check"><input id="traits-@editor.Member.Id" class="form-check-input" type="checkbox" @bind="editor.PermanentTraitsVerified" /><label class="form-check-label" for="traits-@editor.Member.Id">Permanent traits verified</label></div></div>
                                </div>
                            </fieldset>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button type="button" class="btn btn-success btn-sm" disabled="@(_busy || IsFrozen)" @onclick="() => CurateAsync(editor, CharacterLoraCurationStatus.Accepted)">Accept</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(_busy || IsFrozen)" @onclick="() => CurateAsync(editor, CharacterLoraCurationStatus.Rejected)">Reject</button>
                                <a class="btn btn-outline-secondary btn-sm" href="/asset-studio/@editor.Member.SceneAssetId">Inspect asset</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }

        <section class="card mb-4" aria-label="Freeze dataset">
            <div class="card-header"><strong>Freeze Dataset</strong></div>
            <div class="card-body">
                <label class="form-label small" for="curator-id">Curator ID</label>
                <input id="curator-id" class="form-control form-control-sm" disabled="@IsFrozen" @bind="_reviewedBy" />
                <button type="button" class="btn btn-primary btn-sm mt-3" disabled="@(_busy || IsFrozen || _members.Count == 0)" @onclick="FreezeAsync">Freeze Exact Manifest</button>
            </div>
        </section>

        @* The images ARE the character; the family is only what they are trained for. Shooting 36 cells again to
           train the same character against a second checkpoint buys nothing, and that is what this is for. *@
        <section class="card mb-4" aria-label="Derive a version for another family">
            <div class="card-header"><strong>Derive a version for another family</strong></div>
            <div class="card-body small">
                <p class="text-muted">
                    Copies this set's plan, trigger token and every member — including the curation already recorded —
                    into a new DRAFT aimed at the family you pick. No image is re-rendered and no asset is duplicated:
                    the new version references the SAME promoted assets, and this dataset is left untouched. Pick the
                    family it already is to take an updated set forward instead.
                </p>
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small" for="derive-family">Family to train for</label>
                        <select id="derive-family" class="form-select form-select-sm" disabled="@_busy" @bind="_deriveFamily">
                            @foreach (var family in CharacterLoraModelFamilies.All)
                            {
                                <option value="@family">@family</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                disabled="@(_busy || _members.Count == 0)"
                                @onclick="DeriveAsync">
                            Derive @_members.Count member(s) for @_deriveFamily
                        </button>
                    </div>
                </div>
                <div class="form-text">
                    @(_members.Count == 0
                        ? "This dataset has no members to carry across yet."
                        : "The new version opens as a Draft, ready to freeze, or to add images to first.")
                </div>
            </div>
        </section>

        <section class="card mb-4" aria-label="Remove dataset">
            <div class="card-header"><strong>Remove this dataset</strong></div>
            <div class="card-body small">
                <p class="text-muted mb-2">
                    Removes this dataset and its member list. It does <strong>not</strong> delete any image: a promoted
                    asset is its own record and may be shared with other datasets. Refused if this dataset has training
                    jobs, or if another dataset was derived from it.
                </p>
                @if (!_confirmRemove)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy"
                            @onclick="() => _confirmRemove = true">
                        Remove dataset v@_dataset.Version
                    </button>
                }
                else
                {
                    <div class="alert alert-danger py-2 d-flex flex-wrap align-items-center gap-2 mb-0">
                        <span>Remove <strong>v@_dataset.Version</strong> (@_dataset.TargetModelFamily) permanently?</span>
                        <button type="button" class="btn btn-danger btn-sm" disabled="@_busy" @onclick="RemoveAsync">Yes, remove it</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy"
                                @onclick="() => _confirmRemove = false">
                            Cancel
                        </button>
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public string DatasetId { get; set; } = string.Empty;

    private sealed class MemberEditor
    {
        public required CharacterLoraDatasetMember Member { get; init; }
        public SceneAsset? Asset { get; init; }
        public bool IdentityDrift { get; set; }
        public bool NearDuplicate { get; set; }
        public bool AnatomyIssue { get; set; }
        public bool Leakage { get; set; }
        public bool PermanentTraitsVerified { get; set; }
    }

    private CharacterLoraDataset? _dataset;
    private readonly List<MemberEditor> _members = [];
    private LoraCellRegistrationPreview? _preview;
    private string _familyDraft = string.Empty;
    private string _registrationSeedKey = string.Empty;
    private string _registrationProvenance = string.Empty;
    private string _registrationConsent = string.Empty;
    private string _registrationLicense = string.Empty;
    private string _registrationLicenseLabel = string.Empty;
    private string _registrationPolicy = string.Empty;
    private string _registrationCompatibility = string.Empty;
    private readonly HashSet<SceneAssetApprovedUseScope> _registrationScopes = [];
    private string _reviewedBy = string.Empty;
    private string _deriveFamily = string.Empty;
    private bool _confirmRemove;
    private bool _busy;
    private string? _error;
    private string? _status;
    private bool IsFrozen => _dataset?.Status != CharacterLoraDatasetStatus.Draft;

    /// <summary>The flags the operator has ticked, as one bitmask. Empty means nothing has been granted yet.</summary>
    private SceneAssetApprovedUseScope RegistrationUseScope =>
        _registrationScopes.Aggregate(
            (SceneAssetApprovedUseScope)0, (accumulated, scope) => accumulated | scope);

    private bool RegistrationUseScopeHasLoraTraining =>
        RegistrationUseScope.HasFlag(SceneAssetApprovedUseScope.CharacterLoraTraining);

    /// <summary>
    /// Registration is offered only when the set is unambiguous and every fact a production approval requires has
    /// been supplied. Nothing here is defaulted: an invented consent or licence value would be a false record on
    /// every member, and freezing reads those records.
    /// </summary>
    private bool CanRegister =>
        _preview is { Refused.Count: 0 }
        && _preview.Ready.Count > 0
        && !string.IsNullOrWhiteSpace(_registrationProvenance)
        && !string.IsNullOrWhiteSpace(_registrationConsent)
        && !string.IsNullOrWhiteSpace(_registrationLicense)
        && !string.IsNullOrWhiteSpace(_registrationLicenseLabel)
        && !string.IsNullOrWhiteSpace(_registrationPolicy)
        && !string.IsNullOrWhiteSpace(_registrationCompatibility)
        && !string.IsNullOrWhiteSpace(_reviewedBy)
        && RegistrationUseScopeHasLoraTraining;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _dataset = await LoraRepository.GetDatasetAsync(DatasetId);
        if (_dataset is null)
        {
            _error = $"LoRA dataset '{DatasetId}' was not found.";
            return;
        }
        _members.Clear();
        foreach (var member in await LoraRepository.ListDatasetMembersAsync(DatasetId))
        {
            _members.Add(new MemberEditor
            {
                Member = member,
                Asset = await AssetRepository.GetAsync(member.SceneAssetId)
            });
        }

        // A stored family that is not trainable cannot be shown in the list, so the picker starts on a real family
        // and the page says why. Leaving it blank would let "save" quietly write back the unusable value.
        _familyDraft = CharacterLoraModelFamilies.IsKnown(_dataset.TargetModelFamily)
            ? _dataset.TargetModelFamily
            : CharacterLoraModelFamilies.All[0];

        // Defaults to a family this dataset is NOT: deriving into the family it already is would produce a second
        // identical version, which is legal (that is how an updated set is taken forward) but a surprising default.
        _deriveFamily = CharacterLoraModelFamilies.All
            .First(family => !string.Equals(family, _dataset.TargetModelFamily, StringComparison.Ordinal));

        if (_dataset.Status == CharacterLoraDatasetStatus.Draft)
        {
            _preview = await RegistrationService.PreviewAsync(DatasetId);
            var seedKey = $"{_dataset.Id}|{_dataset.Version}|{_dataset.TargetModelFamily}";
            if (!string.Equals(_registrationSeedKey, seedKey, StringComparison.Ordinal))
            {
                PrepareRegistration();
            }
        }
        else
        {
            _preview = null;
        }
    }

    /// <summary>
    /// Seeds the provenance and compatibility JSON from the dataset's OWN record.
    ///
    /// <para>
    /// Both are derived facts, not operator input: the compatibility block names the family the member images are
    /// being trained FOR, which is the dataset's declared family. It is therefore re-derived whenever that family
    /// (or the dataset version) changes - otherwise retargeting the set from one family to another would leave every
    /// newly promoted asset carrying a compatibility record for the family it is no longer being trained for.
    /// Consent, licence and the policy key are never seeded: they are the operator's to state.
    /// </para>
    /// </summary>
    private void PrepareRegistration()
    {
        _registrationProvenance = JsonSerializer.Serialize(new
        {
            source = "lora-cell-acceptance",
            datasetId = DatasetId,
            characterId = _dataset?.CharacterTemplateId,
            identityPackId = _dataset?.IdentityPackId,
            targetModelFamily = _dataset?.TargetModelFamily
        });
        _registrationCompatibility = JsonSerializer.Serialize(new
        {
            modelFamilies = new[] { _dataset?.TargetModelFamily },
            loraDatasetId = DatasetId,
            loraDatasetVersion = _dataset?.Version
        });
        _registrationScopes.Add(SceneAssetApprovedUseScope.CharacterLoraTraining);
        _registrationSeedKey = $"{_dataset?.Id}|{_dataset?.Version}|{_dataset?.TargetModelFamily}";
    }

    private void ToggleScope(SceneAssetApprovedUseScope scope, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            _registrationScopes.Add(scope);
        }
        else
        {
            _registrationScopes.Remove(scope);
        }
    }

    private async Task RegisterAsync()
    {
        await RunAsync(async () =>
        {
            if (!CanRegister) throw new InvalidOperationException("Every approval fact is required before registering.");
            var outcome = await RegistrationService.RegisterAsync(DatasetId, new LoraDatasetApprovalFacts(
                _registrationProvenance,
                Enum.Parse<SceneAssetConsentState>(_registrationConsent, false),
                Enum.Parse<SceneAssetLicenseState>(_registrationLicense, false),
                _registrationLicenseLabel,
                RegistrationUseScope,
                _registrationPolicy,
                _registrationCompatibility,
                _reviewedBy));
            _status = $"Registered {outcome.RegisteredCount} member(s). "
                + (outcome.Pending.Count > 0
                    ? $"{outcome.Pending.Count} cell(s) still have no accepted image."
                    : string.Empty);
        });
        await ReloadWhenItWorkedAsync();
    }

    private async Task SaveFamilyAsync()
    {
        await RunAsync(async () =>
        {
            _dataset = await LoraRepository.SetDatasetTargetFamilyAsync(DatasetId, _familyDraft);
            _status = $"Dataset target family is now {_dataset.TargetModelFamily}.";
        });
        await ReloadWhenItWorkedAsync();
    }

    /// <summary>
    /// Reload only after a SUCCESSFUL write. <see cref="LoadAsync"/> clears the error field, so reloading after a
    /// refusal would erase the very message that tells the operator why nothing happened.
    /// </summary>
    private async Task ReloadWhenItWorkedAsync()
    {
        if (string.IsNullOrWhiteSpace(_error))
        {
            await LoadAsync();
        }
    }

    private async Task CurateAsync(MemberEditor editor, CharacterLoraCurationStatus status)
    {
        await RunAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(_reviewedBy)) throw new InvalidOperationException("Curator ID is required.");
            var expectedRevision = editor.Member.CaptionRevision;
            editor.Member.CaptionRevision++;
            editor.Member.CurationStatus = status;
            editor.Member.CurationFindingsJson = JsonSerializer.Serialize(new
            {
                identityDrift = editor.IdentityDrift,
                nearDuplicate = editor.NearDuplicate,
                anatomyIssue = editor.AnatomyIssue,
                leakage = editor.Leakage,
                permanentTraitsVerified = editor.PermanentTraitsVerified
            });
            editor.Member.ReviewedBy = _reviewedBy.Trim();
            editor.Member.ReviewedUtc = DateTime.UtcNow;
            await LoraRepository.CurateDatasetMemberAsync(editor.Member, expectedRevision);
            _status = $"Candidate {editor.Member.Ordinal + 1} saved as {status}.";
        });
    }

    /// <summary>
    /// Carries this dataset's members into a new Draft aimed at another family, then opens it.
    ///
    /// <para>
    /// Nothing is re-rendered and no asset is duplicated: the derived set references the SAME promoted Scene
    /// Assets, because their approval (consent, licence, scope, version, checksum) is what freezing verifies and
    /// none of it is family-specific.
    /// </para>
    /// </summary>
    private async Task DeriveAsync()
    {
        await RunAsync(async () =>
        {
            var derived = await LoraRepository.DeriveDatasetAsync(DatasetId, _deriveFamily);
            Navigation.NavigateTo($"/asset-studio/lora-datasets/{derived.Id}");
        });
    }

    /// <summary>
    /// Removes this dataset. The character is captured FIRST: once the row is gone a reload cannot read it, and the
    /// operator would be left on a page whose subject no longer exists.
    /// </summary>
    private async Task RemoveAsync()
    {
        var characterId = _dataset?.CharacterTemplateId ?? string.Empty;
        await RunAsync(async () =>
        {
            await LoraRepository.DeleteDatasetAsync(DatasetId);
            _confirmRemove = false;
            Navigation.NavigateTo($"/characters/{Uri.EscapeDataString(characterId)}?section=LoRA%20images");
        });
    }

    private async Task FreezeAsync()
    {
        await RunAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(_reviewedBy)) throw new InvalidOperationException("Curator ID is required.");
            _dataset = await LoraRepository.FreezeDatasetAsync(DatasetId, _reviewedBy, DateTime.UtcNow);
            _status = $"Dataset frozen with manifest {_dataset.ManifestSha256}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _status = null;
        try { await action(); }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "LoRA dataset curation operation failed.");

            // Reload FIRST: LoadAsync clears the error, so setting it before the reload is how a refusal used to
            // disappear without ever reaching the operator.
            await LoadAsync();
            _error = exception.Message;
        }
        finally { _busy = false; }
    }
}