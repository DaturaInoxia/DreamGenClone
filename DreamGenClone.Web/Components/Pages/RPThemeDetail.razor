@page "/rp-themes/{ThemeId}"
@rendermode InteractiveServer

@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Application.StoryAnalysis
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.StoryAnalysis
@using System.Text.Json
@using System.Text.Json.Nodes

@inject IRPThemeService RPThemeService
@inject StoryAnalysisFacade StoryAnalysisFacade
@inject NavigationManager Navigation

<PageTitle>RP Theme Detail</PageTitle>

<div class="container-fluid mt-3 rp-theme-detail-page">
    <div class="sticky-theme-actions border rounded p-2 bg-body mb-3">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@_isBusy">Save Theme</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="OpenCloneDialog" disabled="@(_isBusy || _isNew)">Clone Theme</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteAsync" disabled="@(_isBusy || _isNew)">Delete Theme</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToList">Back To List</button>
            </div>
            <div class="small">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <span class="text-danger">@_error</span>
                }
                else if (!string.IsNullOrWhiteSpace(_status))
                {
                    <span class="text-success">@_status</span>
                }
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="alert alert-info">Loading theme...</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <h3 class="mb-1">Theme Details</h3>
                <p class="text-muted mb-0">Full CRUD editor for all RP theme structures.</p>
            </div>
            <span class="badge bg-secondary-subtle text-secondary-emphasis border">@(_isNew ? "New Theme" : _theme.Id)</span>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Theme Metadata</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Theme Metadata"))">What is this?</button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-lg-4">
                        <label class="form-label">Id</label>
                        <input class="form-control" @bind="_theme.Id" disabled="@(!_isNew)" />
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label">Label</label>
                        <input class="form-control" @bind="_theme.Label" />
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label">Category</label>
                        <input class="form-control" @bind="_theme.Category" />
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label">Weight</label>
                        <input class="form-control" type="number" min="1" max="10" @bind="_theme.Weight" />
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">Parent Theme Id</label>
                        <input class="form-control" @bind="_theme.ParentThemeId" placeholder="Optional" />
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">Narrative Gate Template Profile</label>
                        <select class="form-select" @bind="_theme.NarrativeGateProfileId">
                            <option value="">(Optional template profile)</option>
                            @foreach (var profile in _narrativeGateProfiles)
                            {
                                <option value="@profile.Id">@profile.Name</option>
                            }
                        </select>
                        <div class="form-text">Optional: select a profile to clone gate rows into this theme. Theme gate values are detached after cloning.</div>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">Enabled</label>
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" @bind="_theme.IsEnabled" />
                            <label class="form-check-label">Theme is enabled</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="3" @bind="_theme.Description"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>Narrative Gate Values</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Narrative Gate Values"))">What is this?</button>
            </summary>
            <div class="card-body">
                <details class="border rounded p-2 mb-3">
                    <summary><strong>Theme-local gate values</strong></summary>
                    <div class="text-muted small mt-2">Detached from profiles after cloning. Required transitions: BuildUp -> Committed, Committed -> Approaching, Approaching -> Climax, Climax -> Reset, Reset -> BuildUp.</div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadNarrativeGateTemplateAsync" disabled="@(_isBusy || string.IsNullOrWhiteSpace(_theme.NarrativeGateProfileId))">Load From Selected Profile</button>
                    </div>
                </details>

                @if (!string.IsNullOrWhiteSpace(_narrativeGateError))
                {
                    <div class="alert alert-danger py-2">@_narrativeGateError</div>
                }
                else if (!string.IsNullOrWhiteSpace(_narrativeGateStatus))
                {
                    <div class="alert alert-success py-2">@_narrativeGateStatus</div>
                }

                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddNarrativeGateRule">Add Rule</button>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 150px;">From Phase</th>
                                <th style="width: 150px;">To Phase</th>
                                <th style="width: 240px;">Metric</th>
                                <th style="width: 120px;">Comparator</th>
                                <th style="width: 140px;">Threshold</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_theme.NarrativeGateRules.Count == 0)
                            {
                                <tr><td colspan="6" class="text-muted">No gate rules configured for this theme yet.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _theme.NarrativeGateRules.Count; i++)
                                {
                                    var rowIndex = i;
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.NarrativeGateRules[rowIndex].FromPhase">
                                                @foreach (var phaseName in _narrativePhaseNames)
                                                {
                                                    <option value="@phaseName">@phaseName</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.NarrativeGateRules[rowIndex].ToPhase">
                                                @foreach (var phaseName in _narrativePhaseNames)
                                                {
                                                    <option value="@phaseName">@phaseName</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.NarrativeGateRules[rowIndex].MetricKey">
                                                @foreach (var metricKey in _narrativeMetricKeys)
                                                {
                                                    <option value="@metricKey">@metricKey</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.NarrativeGateRules[rowIndex].Comparator">
                                                @foreach (var comparator in _narrativeComparators)
                                                {
                                                    <option value="@comparator">@comparator</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control form-control-sm" type="number" step="0.01" @bind="_theme.NarrativeGateRules[rowIndex].Threshold" /></td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveNarrativeGateRule(rowIndex)">Remove</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>Theme Machines</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Theme Machines"))">What is this?</button>
            </summary>
            <div class="card-body">
                @if (_isNew)
                {
                    <div class="alert alert-warning mb-0">Save this theme first before configuring machine definitions.</div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_machineError))
                    {
                        <div class="alert alert-danger py-2">@_machineError</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_machineStatus))
                    {
                        <div class="alert alert-success py-2">@_machineStatus</div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Definitions</h6>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadMachineDefinitionsAsync" disabled="@(_isBusy || _isMachineBusy)">Refresh</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartNewMachineDefinition" disabled="@(_isBusy || _isMachineBusy)">New Definition</button>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Machine</th>
                                            <th>Version</th>
                                            <th>Active</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_machineDefinitions.Count == 0)
                                        {
                                            <tr><td colspan="4" class="text-muted">No machine definitions configured for this theme.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var definition in _machineDefinitions)
                                            {
                                                var isSelected = string.Equals(_machineEditor.DefinitionId, definition.DefinitionId, StringComparison.OrdinalIgnoreCase);
                                                <tr class="@(isSelected ? "table-primary" : string.Empty)" style="cursor: pointer;" @onclick="() => SelectMachineDefinition(definition.DefinitionId)">
                                                    <td>@definition.Name</td>
                                                    <td>@definition.MachineKey</td>
                                                    <td>@definition.Version</td>
                                                    <td>
                                                        @if (definition.IsActive)
                                                        {
                                                            <span class="badge bg-success">Yes</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">No</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-12 border-top pt-3">
                            <h6 class="mb-2">Machine Editor</h6>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Name</label>
                                    <input class="form-control form-control-sm" @bind="_machineEditor.Name" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Machine Key</label>
                                    <input class="form-control form-control-sm" @bind="_machineEditor.MachineKey" placeholder="infidelity-brief-disappearance" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Version</label>
                                    <input class="form-control form-control-sm" type="number" min="1" @bind="_machineEditor.Version" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Definition Id</label>
                                    <input class="form-control form-control-sm" @bind="_machineEditor.DefinitionId" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Seeded</label>
                                    <div class="form-check form-switch mt-1">
                                        <input class="form-check-input" type="checkbox" @bind="_machineEditor.IsSeeded" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Active</label>
                                    <div class="form-check form-switch mt-1">
                                        <input class="form-check-input" type="checkbox" @bind="_machineEditor.IsActive" disabled />
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">States (@_machineEditor.States.Count)</h6>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddMachineState" disabled="@(_isBusy || _isMachineBusy)">Add State</button>
                            </div>
                            <div class="table-responsive mb-3">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Label</th>
                                            <th>Initial</th>
                                            <th>Terminal</th>
                                            <th>Sort</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_machineEditor.States.Count == 0)
                                        {
                                            <tr><td colspan="6" class="text-muted">No states defined yet.</td></tr>
                                        }
                                        else
                                        {
                                            @for (var i = 0; i < _machineEditor.States.Count; i++)
                                            {
                                                var stateIndex = i;
                                                <tr>
                                                    <td><input class="form-control form-control-sm" @bind="_machineEditor.States[stateIndex].StateCode" /></td>
                                                    <td><input class="form-control form-control-sm" @bind="_machineEditor.States[stateIndex].Label" /></td>
                                                    <td><input class="form-check-input" type="checkbox" @bind="_machineEditor.States[stateIndex].IsInitial" /></td>
                                                    <td><input class="form-check-input" type="checkbox" @bind="_machineEditor.States[stateIndex].IsTerminal" /></td>
                                                    <td><input class="form-control form-control-sm" type="number" @bind="_machineEditor.States[stateIndex].SortOrder" /></td>
                                                    <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMachineState(stateIndex)">Remove</button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Transitions (@_machineEditor.Transitions.Count)</h6>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddMachineTransition" disabled="@(_isBusy || _isMachineBusy)">Add Transition</button>
                            </div>
                            <div class="table-responsive mb-3">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Priority</th>
                                            <th>Trigger</th>
                                            <th>Block Reason</th>
                                            <th>Enabled</th>
                                            <th>Gate JSON</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_machineEditor.Transitions.Count == 0)
                                        {
                                            <tr><td colspan="8" class="text-muted">No transitions defined yet.</td></tr>
                                        }
                                        else
                                        {
                                            @for (var i = 0; i < _machineEditor.Transitions.Count; i++)
                                            {
                                                var transitionIndex = i;
                                                <tr>
                                                    <td><input class="form-control form-control-sm" @bind="_machineEditor.Transitions[transitionIndex].FromStateCode" /></td>
                                                    <td><input class="form-control form-control-sm" @bind="_machineEditor.Transitions[transitionIndex].ToStateCode" /></td>
                                                    <td><input class="form-control form-control-sm" type="number" @bind="_machineEditor.Transitions[transitionIndex].Priority" /></td>
                                                    <td><input class="form-control form-control-sm" @bind="_machineEditor.Transitions[transitionIndex].TriggerType" /></td>
                                                    <td><input class="form-control form-control-sm" @bind="_machineEditor.Transitions[transitionIndex].BlockReasonCode" /></td>
                                                    <td><input class="form-check-input" type="checkbox" @bind="_machineEditor.Transitions[transitionIndex].IsEnabled" /></td>
                                                    <td>
                                                        <textarea class="form-control form-control-sm" rows="3" @bind="_machineEditor.Transitions[transitionIndex].GateConfigJson"></textarea>
                                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ApplyCooldownTemplateToTransition(transitionIndex)" disabled="@(_isBusy || _isMachineBusy)">Apply Cooldown Template</button>
                                                            @foreach (var signal in _returnBeatSignalSuggestions)
                                                            {
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AddReturnBeatSignalToTransition(transitionIndex, signal)" disabled="@(_isBusy || _isMachineBusy)">+ @signal</button>
                                                            }
                                                        </div>
                                                        <div class="form-text">Helpers add/maintain minimumInteractions, requireReturnBeatCompleted, returnBeatCompletionSignals, returnBeatTransgressorRole, and returnBeatPartnerRole for cooldown gates.</div>
                                                    </td>
                                                    <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMachineTransition(transitionIndex)">Remove</button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <button type="button" class="btn btn-sm btn-primary" @onclick="SaveMachineDefinitionAsync" disabled="@(_isBusy || _isMachineBusy)">Save Machine Definition</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ValidateMachineDefinitionAsync" disabled="@(_isBusy || _isMachineBusy || string.IsNullOrWhiteSpace(_machineEditor.DefinitionId))">Validate Definition</button>
                                <button type="button" class="btn btn-sm btn-outline-success" @onclick="ActivateMachineDefinitionAsync" disabled="@(_isBusy || _isMachineBusy || string.IsNullOrWhiteSpace(_machineEditor.MachineKey) || _machineEditor.Version <= 0)">Activate Version</button>
                            </div>

                            @if (_machineValidationResult is not null)
                            {
                                <div class="border rounded p-2 mb-3">
                                    <div><strong>Validation:</strong> @(_machineValidationResult.IsValid ? "Valid" : "Invalid")</div>
                                    @if (_machineValidationResult.Errors.Count > 0)
                                    {
                                        <div class="text-danger small mt-1">@string.Join(" | ", _machineValidationResult.Errors)</div>
                                    }
                                    @if (_machineValidationResult.Warnings.Count > 0)
                                    {
                                        <div class="text-warning small mt-1">@string.Join(" | ", _machineValidationResult.Warnings)</div>
                                    }
                                </div>
                            }

                            <h6 class="mb-2">Session Migration</h6>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label">Session Id</label>
                                    <input class="form-control form-control-sm" @bind="_machineMigrationSessionId" placeholder="Session Id" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Target Version</label>
                                    <input class="form-control form-control-sm" type="number" min="1" @bind="_machineMigrationTargetVersion" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Actor Id</label>
                                    <input class="form-control form-control-sm" @bind="_machineActorId" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-sm btn-outline-warning w-100" @onclick="MigrateMachineVersionAsync" disabled="@(_isBusy || _isMachineBusy)">Migrate</button>
                                </div>
                            </div>
                            <div class="form-text">Migration is explicit and admin-only. The session snapshot is updated to the selected machine version.</div>
                        </div>
                    </div>
                }
            </div>
        </details>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>Keywords (@_theme.Keywords.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Keywords"))">What is this?</button>
            </summary>
            <div class="card-body">
                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddKeyword">Add Keyword</button>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 180px;">Group</th>
                                <th>Keyword</th>
                                <th style="width: 120px;">Sort</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_theme.Keywords.Count == 0)
                            {
                                <tr><td colspan="4" class="text-muted">No keywords yet.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _theme.Keywords.Count; i++)
                                {
                                    var rowIndex = i;
                                    <tr>
                                        <td><input class="form-control form-control-sm" @bind="_theme.Keywords[rowIndex].GroupName" /></td>
                                        <td><input class="form-control form-control-sm" @bind="_theme.Keywords[rowIndex].Keyword" /></td>
                                        <td><input class="form-control form-control-sm" type="number" @bind="_theme.Keywords[rowIndex].SortOrder" /></td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveKeyword(rowIndex)">Remove</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>Stat Affinities (@_theme.StatAffinities.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Stat Affinities"))">What is this?</button>
            </summary>
            <div class="card-body">
                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddAffinity">Add Affinity</button>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 200px;">Stat</th>
                                <th style="width: 120px;">Value</th>
                                <th>Rationale</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_theme.StatAffinities.Count == 0)
                            {
                                <tr><td colspan="4" class="text-muted">No stat affinities yet.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _theme.StatAffinities.Count; i++)
                                {
                                    var rowIndex = i;
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.StatAffinities[rowIndex].StatName">
                                                <option value="">Select stat...</option>
                                                @foreach (var statName in AdaptiveStatCatalog.CanonicalStatNames)
                                                {
                                                    <option value="@statName">@statName</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control form-control-sm" type="number" min="-10" max="10" @bind="_theme.StatAffinities[rowIndex].Value" /></td>
                                        <td><input class="form-control form-control-sm" @bind="_theme.StatAffinities[rowIndex].Rationale" /></td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAffinity(rowIndex)">Remove</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>Phase Guidance (@_theme.PhaseGuidance.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Phase Guidance"))">What is this?</button>
            </summary>
            <div class="card-body">
                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddPhaseGuidance">Add Guidance</button>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 180px;">Phase</th>
                                <th>Guidance Text</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_theme.PhaseGuidance.Count == 0)
                            {
                                <tr><td colspan="3" class="text-muted">No phase guidance yet.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _theme.PhaseGuidance.Count; i++)
                                {
                                    var rowIndex = i;
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.PhaseGuidance[rowIndex].Phase">
                                                @foreach (var phase in Enum.GetValues<NarrativePhase>())
                                                {
                                                    <option value="@phase">@phase</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <textarea class="form-control form-control-sm rp-phase-guidance-editor" rows="4" @bind="_theme.PhaseGuidance[rowIndex].GuidanceText"></textarea>
                                        </td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemovePhaseGuidance(rowIndex)">Remove</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>Guidance Points (@_theme.GuidancePoints.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Guidance Points"))">What is this?</button>
            </summary>
            <div class="card-body">
                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddGuidancePoint">Add Point</button>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 150px;">Phase</th>
                                <th style="width: 150px;">Type</th>
                                <th>Text</th>
                                <th style="width: 120px;">Sort</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_theme.GuidancePoints.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted">No guidance points yet.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _theme.GuidancePoints.Count; i++)
                                {
                                    var rowIndex = i;
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.GuidancePoints[rowIndex].Phase">
                                                @foreach (var phase in Enum.GetValues<NarrativePhase>())
                                                {
                                                    <option value="@phase">@phase</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.GuidancePoints[rowIndex].PointType">
                                                @foreach (var pointType in Enum.GetValues<RPThemeGuidancePointType>())
                                                {
                                                    <option value="@pointType">@pointType</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control form-control-sm" @bind="_theme.GuidancePoints[rowIndex].Text" /></td>
                                        <td><input class="form-control form-control-sm" type="number" @bind="_theme.GuidancePoints[rowIndex].SortOrder" /></td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveGuidancePoint(rowIndex)">Remove</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>Fit Rules And Clauses (Character Roles) (@_theme.FitRules.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("Fit Rules"))">What is this?</button>
            </summary>
            <div class="card-body">
                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddFitRule">Add Fit Rule</button>

                @if (_theme.FitRules.Count == 0)
                {
                    <div class="text-muted">No fit rules yet.</div>
                }
                else
                {
                    @for (var i = 0; i < _theme.FitRules.Count; i++)
                    {
                        var ruleIndex = i;
                        <div class="border rounded p-2 mb-2">
                            <div class="row g-2 align-items-end mb-2">
                                <div class="col-lg-5">
                                    <label class="form-label small">Character Role</label>
                                    <select class="form-select form-select-sm" @bind="_theme.FitRules[ruleIndex].RoleName">
                                        <option value="">Select character role...</option>
                                        @foreach (var roleName in GetCharacterRoleOptions(_theme.FitRules[ruleIndex].RoleName))
                                        {
                                            <option value="@roleName">@roleName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-3">
                                    <label class="form-label small">Role Weight</label>
                                    <input class="form-control form-control-sm" type="number" min="0.1" max="10" step="0.1" @bind="_theme.FitRules[ruleIndex].RoleWeight" />
                                </div>
                                <div class="col-lg-4 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="() => AddFitRuleClause(ruleIndex)">Add Clause</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFitRule(ruleIndex)">Remove Rule</button>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 160px;">Stat</th>
                                            <th style="width: 120px;">Comparator</th>
                                            <th style="width: 120px;">Threshold</th>
                                            <th style="width: 140px;">Penalty</th>
                                            <th>Description</th>
                                            <th style="width: 120px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_theme.FitRules[ruleIndex].Clauses.Count == 0)
                                        {
                                            <tr><td colspan="6" class="text-muted">No clauses yet.</td></tr>
                                        }
                                        else
                                        {
                                            @for (var j = 0; j < _theme.FitRules[ruleIndex].Clauses.Count; j++)
                                            {
                                                var clauseIndex = j;
                                                <tr>
                                                    <td><input class="form-control form-control-sm" @bind="_theme.FitRules[ruleIndex].Clauses[clauseIndex].StatName" /></td>
                                                    <td><input class="form-control form-control-sm" @bind="_theme.FitRules[ruleIndex].Clauses[clauseIndex].Comparator" /></td>
                                                    <td><input class="form-control form-control-sm" type="number" step="0.1" @bind="_theme.FitRules[ruleIndex].Clauses[clauseIndex].Threshold" /></td>
                                                    <td><input class="form-control form-control-sm" type="number" step="0.1" min="0" max="10" @bind="_theme.FitRules[ruleIndex].Clauses[clauseIndex].PenaltyWeight" /></td>
                                                    <td><input class="form-control form-control-sm" @bind="_theme.FitRules[ruleIndex].Clauses[clauseIndex].Description" /></td>
                                                    <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFitRuleClause(ruleIndex, clauseIndex)">Remove</button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </details>

        <details class="card mb-3">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span>AI Guidance Notes (@_theme.AIGenerationNotes.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => ShowInfoForSection("AI Guidance Notes"))">What is this?</button>
            </summary>
            <div class="card-body">
                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddAIGuidanceNote">Add AI Guidance Note</button>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 220px;">Section</th>
                                <th>Text</th>
                                <th style="width: 120px;">Sort</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_theme.AIGenerationNotes.Count == 0)
                            {
                                <tr><td colspan="4" class="text-muted">No AI guidance notes yet.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _theme.AIGenerationNotes.Count; i++)
                                {
                                    var rowIndex = i;
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="_theme.AIGenerationNotes[rowIndex].Section">
                                                @foreach (var noteSection in Enum.GetValues<RPThemeAIGuidanceSection>())
                                                {
                                                    <option value="@noteSection">@noteSection</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control form-control-sm" @bind="_theme.AIGenerationNotes[rowIndex].Text" /></td>
                                        <td><input class="form-control form-control-sm" type="number" @bind="_theme.AIGenerationNotes[rowIndex].SortOrder" /></td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAIGuidanceNote(rowIndex)">Remove</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>
    }
</div>

@if (_showInfoModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.35);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_infoTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseInfo"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@_infoBody</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseInfo">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showCloneModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.35);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Clone Theme</h5>
                    <button type="button" class="btn-close" @onclick="CloseCloneDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="small text-muted mb-3">
                        Creates a full clone of this theme, including metadata, keywords, stat affinities, phase guidance, guidance points, fit rules and clauses, AI guidance notes, and narrative gate values.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Source Theme</label>
                        <input class="form-control" value="@_theme.Id" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Theme Id</label>
                        <input class="form-control" @bind="_cloneThemeId" />
                        <div class="form-text">Default increments version suffix (for example: theme -> theme-v2, theme-v2 -> theme-v3). You can change it before cloning.</div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label">New Theme Label</label>
                        <input class="form-control" @bind="_cloneThemeLabel" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_cloneError))
                    {
                        <div class="text-danger small mt-2">@_cloneError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCloneDialog" disabled="@_isBusy">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="CloneThemeAsync" disabled="@_isBusy">Create Clone</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .rp-theme-detail-page .sticky-theme-actions {
        position: sticky;
        top: 0.5rem;
        z-index: 1020;
    }

    .rp-theme-detail-page details > summary {
        list-style: none;
        cursor: pointer;
    }

    .rp-theme-detail-page details > summary::-webkit-details-marker {
        display: none;
    }

    .rp-theme-detail-page .rp-phase-guidance-editor {
        min-height: 7rem;
        resize: vertical;
    }
</style>

@code {
    [Parameter] public string ThemeId { get; set; } = string.Empty;

    private RPTheme _theme = CreateEmptyTheme();
    private bool _isLoading;
    private bool _isBusy;
    private bool _isNew;
    private string _status = string.Empty;
    private string _error = string.Empty;
    private List<string> _availableRoleNames = [];
    private List<NarrativeGateProfile> _narrativeGateProfiles = [];
    private string _narrativeGateStatus = string.Empty;
    private string _narrativeGateError = string.Empty;
    private static readonly IReadOnlyList<string> _narrativePhaseNames = Enum.GetNames<NarrativePhase>();
    private static readonly IReadOnlyList<string> _narrativeMetricKeys =
    [
        NarrativeGateMetricKeys.ActiveScenarioScore,
        NarrativeGateMetricKeys.AverageDesire,
        NarrativeGateMetricKeys.AverageRestraint,
        NarrativeGateMetricKeys.InteractionsSinceCommitment
    ];
    private static readonly IReadOnlyList<string> _narrativeComparators =
    [
        NarrativeGateComparators.GreaterThanOrEqual,
        NarrativeGateComparators.GreaterThan,
        NarrativeGateComparators.LessThanOrEqual,
        NarrativeGateComparators.LessThan,
        NarrativeGateComparators.Equal
    ];

    private List<RPThemeMachineDefinition> _machineDefinitions = [];
    private RPThemeMachineDefinition _machineEditor = CreateEmptyMachineDefinition();
    private bool _isMachineBusy;
    private string _machineStatus = string.Empty;
    private string _machineError = string.Empty;
    private MachineDefinitionValidationResult? _machineValidationResult;
    private string _machineMigrationSessionId = string.Empty;
    private int _machineMigrationTargetVersion = 1;
    private string _machineActorId = "Admin:RPThemeDetail";
    private static readonly IReadOnlyList<string> _returnBeatSignalSuggestions =
    [
        "returned safely",
        "back at home",
        "rejoined the group",
        "walked back in",
        "returned to the room",
        "came back"
    ];
    private static readonly JsonSerializerOptions _machineGateJsonEditorOptions = new()
    {
        WriteIndented = true
    };

    private bool _showInfoModal;
    private string _infoTitle = string.Empty;
    private string _infoBody = string.Empty;
    private bool _showCloneModal;
    private string _cloneThemeId = string.Empty;
    private string _cloneThemeLabel = string.Empty;
    private string _cloneError = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await LoadThemeAsync();
    }

    private async Task LoadThemeAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _error = string.Empty;
        _status = string.Empty;
        _narrativeGateStatus = string.Empty;
        _narrativeGateError = string.Empty;

        try
        {
            await LoadAvailableRoleNamesAsync();
            await LoadNarrativeGateProfilesAsync();

            _isNew = string.Equals(ThemeId, "new", StringComparison.OrdinalIgnoreCase);
            if (_isNew)
            {
                _theme = CreateEmptyTheme();
                _machineDefinitions = [];
                _machineEditor = CreateEmptyMachineDefinition();
                return;
            }

            var loaded = await RPThemeService.GetThemeAsync(ThemeId);
            if (loaded is null)
            {
                _error = $"Theme '{ThemeId}' was not found.";
                _theme = CreateEmptyTheme();
                _isNew = true;
                _machineDefinitions = [];
                _machineEditor = CreateEmptyMachineDefinition();
                return;
            }

            _theme = loaded;
            await LoadMachineDefinitionsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _error = string.Empty;
        _status = string.Empty;

        try
        {
            NormalizeTheme();

            var saved = await RPThemeService.SaveThemeAsync(_theme);
            _theme = saved;
            _status = "Theme saved.";

            if (_isNew)
            {
                _isNew = false;
                await LoadMachineDefinitionsAsync();
                Navigation.NavigateTo($"/rp-themes/{Uri.EscapeDataString(_theme.Id)}", forceLoad: false);
                return;
            }

            await LoadMachineDefinitionsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_isBusy || _isNew)
        {
            return;
        }

        _isBusy = true;
        _error = string.Empty;
        _status = string.Empty;

        try
        {
            var deleted = await RPThemeService.DeleteThemeAsync(_theme.Id);
            if (!deleted)
            {
                _error = "Theme cannot be deleted because it is referenced by one or more profiles.";
                return;
            }

            Navigation.NavigateTo("/rp-themes");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/rp-themes");
    }

    private void OpenCloneDialog()
    {
        if (_isBusy || _isNew)
        {
            return;
        }

        _cloneError = string.Empty;
        _cloneThemeId = BuildDefaultCloneThemeId(_theme.Id, _theme.Label);
        _cloneThemeLabel = BuildDefaultCloneThemeLabel(_theme.Label);
        _showCloneModal = true;
    }

    private void CloseCloneDialog()
    {
        if (_isBusy)
        {
            return;
        }

        _showCloneModal = false;
        _cloneError = string.Empty;
    }

    private async Task CloneThemeAsync()
    {
        if (_isBusy)
        {
            return;
        }

        _cloneThemeId = (_cloneThemeId ?? string.Empty).Trim();
        _cloneThemeLabel = (_cloneThemeLabel ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(_cloneThemeId))
        {
            _cloneError = "New theme Id is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_cloneThemeLabel))
        {
            _cloneError = "New theme label is required.";
            return;
        }

        if (string.Equals(_cloneThemeId, _theme.Id, StringComparison.OrdinalIgnoreCase))
        {
            _cloneError = "Clone Id must be different from source theme Id.";
            return;
        }

        _isBusy = true;
        _cloneError = string.Empty;
        _error = string.Empty;
        _status = string.Empty;

        try
        {
            var cloned = await RPThemeService.CloneThemeAsync(_theme.Id, _cloneThemeId, _cloneThemeLabel);
            _showCloneModal = false;
            _status = $"Theme cloned to '{cloned.Id}'.";
            Navigation.NavigateTo($"/rp-themes/{Uri.EscapeDataString(cloned.Id)}", forceLoad: false);
        }
        catch (Exception ex)
        {
            _cloneError = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowInfo(string title, string body)
    {
        _infoTitle = title;
        _infoBody = body;
        _showInfoModal = true;
    }

    private void ShowInfoForSection(string sectionName)
    {
        ShowInfo(sectionName, GetUsageText(sectionName));
    }
    private void CloseInfo()
    {
        _showInfoModal = false;
    }

    private string GetUsageText(string sectionName)
    {
        return sectionName switch
        {
            "Theme Metadata" => "Used by RP Engine. Category and Weight influence how strongly this theme contributes to selection/scoring. Label/Description also feed model-facing context.",
            "Keywords" => "Currently not used by active RP Engine scoring gates. Maintained as model/context metadata and for future retrieval/filtering workflows.",
            "Stat Affinities" => "Used by RP Engine candidate fit scoring and adaptive nudges. Affinity values align theme pressure against stat movements.",
            "Phase Guidance" => "Used by RP Engine prompt construction by narrative phase. These entries shape phase-specific writing direction.",
            "Guidance Points" => "Used by model prompt assembly. Emphasis/Avoidance points become concise instruction bullets per phase.",
            "Fit Rules" => "Used by RP Engine candidate gating/scoring. Character Role and RoleWeight scope weighting to specific participants; clauses enforce stat-level constraints.",
            "Narrative Gate Values" => "Used by RP lifecycle transitions for RP Theme subsystem sessions. Values are stored on this theme as a detached copy and control phase transitions such as BuildUp->Committed, Committed->Approaching, Approaching->Climax, Climax->Reset, and Reset->BuildUp.",
            "Theme Machines" => "Defines deterministic state-machine continuity for this theme. Admin users can edit states/transitions, validate versions, activate one version, and migrate in-progress sessions explicitly.",
            "AI Guidance Notes" => "Used by model prompt assembly. Notes are grouped into semantic sections to keep generation aligned with theme intent.",
            _ => "Information is available, but this section is currently not used by the RP Engine or model prompt path."
        };
    }

    private async Task LoadNarrativeGateTemplateAsync()
    {
        _theme.NarrativeGateProfileId = string.IsNullOrWhiteSpace(_theme.NarrativeGateProfileId)
            ? null
            : _theme.NarrativeGateProfileId.Trim();

        _narrativeGateError = string.Empty;
        _narrativeGateStatus = string.Empty;

        if (string.IsNullOrWhiteSpace(_theme.NarrativeGateProfileId))
        {
            return;
        }

        var profile = await StoryAnalysisFacade.GetNarrativeGateProfileAsync(_theme.NarrativeGateProfileId);
        if (profile is null)
        {
            _narrativeGateError = $"Narrative gate profile '{_theme.NarrativeGateProfileId}' was not found.";
            return;
        }

        _theme.NarrativeGateRules = profile.Rules
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.FromPhase, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.ToPhase, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.MetricKey, StringComparer.OrdinalIgnoreCase)
            .Select(CloneNarrativeGateRule)
            .ToList();
        _narrativeGateStatus = $"Cloned narrative gate values from template profile '{profile.Name}'.";
    }

    private void AddNarrativeGateRule()
    {
        _theme.NarrativeGateRules.Add(new NarrativeGateRule
        {
            SortOrder = _theme.NarrativeGateRules.Count + 1,
            FromPhase = NarrativePhase.BuildUp.ToString(),
            ToPhase = NarrativePhase.Committed.ToString(),
            MetricKey = NarrativeGateMetricKeys.ActiveScenarioScore,
            Comparator = NarrativeGateComparators.GreaterThanOrEqual,
            Threshold = 60m
        });
    }

    private void RemoveNarrativeGateRule(int index)
    {
        if (index < 0 || index >= _theme.NarrativeGateRules.Count)
        {
            return;
        }

        _theme.NarrativeGateRules.RemoveAt(index);
    }

    private static NarrativeGateRule CloneNarrativeGateRule(NarrativeGateRule source)
    {
        return new NarrativeGateRule
        {
            SortOrder = source.SortOrder,
            FromPhase = source.FromPhase,
            ToPhase = source.ToPhase,
            MetricKey = source.MetricKey,
            Comparator = source.Comparator,
            Threshold = source.Threshold
        };
    }

    private async Task LoadMachineDefinitionsAsync()
    {
        _machineError = string.Empty;
        _machineStatus = string.Empty;
        _machineValidationResult = null;

        if (_isNew || string.IsNullOrWhiteSpace(_theme.Id))
        {
            _machineDefinitions = [];
            _machineEditor = CreateEmptyMachineDefinition();
            return;
        }

        var definitions = await RPThemeService.ListMachineDefinitionsAsync(_theme.Id);
        _machineDefinitions = definitions
            .OrderBy(x => x.MachineKey, StringComparer.OrdinalIgnoreCase)
            .ThenByDescending(x => x.Version)
            .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .Select(CloneMachineDefinition)
            .ToList();

        if (!string.IsNullOrWhiteSpace(_machineEditor.DefinitionId))
        {
            var selected = _machineDefinitions.FirstOrDefault(x =>
                string.Equals(x.DefinitionId, _machineEditor.DefinitionId, StringComparison.OrdinalIgnoreCase));
            if (selected is not null)
            {
                _machineEditor = CloneMachineDefinition(selected);
                _machineMigrationTargetVersion = Math.Max(1, selected.Version);
                return;
            }
        }

        if (_machineDefinitions.Count > 0)
        {
            _machineEditor = CloneMachineDefinition(_machineDefinitions[0]);
            _machineMigrationTargetVersion = Math.Max(1, _machineEditor.Version);
            return;
        }

        StartNewMachineDefinition();
    }

    private void StartNewMachineDefinition()
    {
        _machineValidationResult = null;
        _machineEditor = CreateEmptyMachineDefinition();
        _machineEditor.ThemeId = _theme.Id;
        _machineMigrationTargetVersion = 1;
    }

    private void SelectMachineDefinition(string definitionId)
    {
        var selected = _machineDefinitions.FirstOrDefault(x =>
            string.Equals(x.DefinitionId, definitionId, StringComparison.OrdinalIgnoreCase));
        if (selected is null)
        {
            return;
        }

        _machineValidationResult = null;
        _machineEditor = CloneMachineDefinition(selected);
        _machineMigrationTargetVersion = Math.Max(1, _machineEditor.Version);
    }

    private void AddMachineState()
    {
        _machineEditor.States.Add(new RPThemeMachineState
        {
            DefinitionId = _machineEditor.DefinitionId,
            StateCode = string.Empty,
            Label = string.Empty,
            SortOrder = _machineEditor.States.Count
        });
    }

    private void RemoveMachineState(int index)
    {
        if (index < 0 || index >= _machineEditor.States.Count)
        {
            return;
        }

        _machineEditor.States.RemoveAt(index);
    }

    private void AddMachineTransition()
    {
