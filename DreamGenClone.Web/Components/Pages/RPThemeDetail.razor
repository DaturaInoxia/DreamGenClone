    private void ApplyCooldownTemplateToTransition(int index)
    {
        if (!TryGetMachineTransition(index, out var transition))
        {
            return;
        }

        if (!TryParseGateConfigObject(transition.GateConfigJson, out var gateConfig))
        {
            return;
        }

        transition.TriggerType = "cooldown-eligibility";
        if (string.IsNullOrWhiteSpace(transition.BlockReasonCode))
        {
            transition.BlockReasonCode = "ReintegrationCooldownGateBlocked";
        }

        if (!gateConfig.ContainsKey("minimumInteractions"))
        {
            gateConfig["minimumInteractions"] = 4;
        }

        gateConfig["requireReturnBeatCompleted"] = true;
        EnsureReturnBeatRoleFields(gateConfig);

        if (!TryGetOrCreateReturnBeatSignalArray(gateConfig, out var signalArray))
        {
            return;
        }

        if (signalArray.Count == 0)
        {
            foreach (var signal in _returnBeatSignalSuggestions.Take(3))
            {
                signalArray.Add(signal);
            }
        }

        transition.GateConfigJson = gateConfig.ToJsonString(_machineGateJsonEditorOptions);
        _machineError = string.Empty;
        _machineStatus = "Cooldown gate template applied to transition.";
    }

    private void AddReturnBeatSignalToTransition(int index, string signal)
    {
        signal = (signal ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(signal))
        {
            return;
        }

        if (!TryGetMachineTransition(index, out var transition))
        {
            return;
        }

        if (!TryParseGateConfigObject(transition.GateConfigJson, out var gateConfig))
        {
            return;
        }

        transition.TriggerType = "cooldown-eligibility";
        if (string.IsNullOrWhiteSpace(transition.BlockReasonCode))
        {
            transition.BlockReasonCode = "ReintegrationCooldownGateBlocked";
        }

        if (!gateConfig.ContainsKey("minimumInteractions"))
        {
            gateConfig["minimumInteractions"] = 4;
        }

        gateConfig["requireReturnBeatCompleted"] = true;
        EnsureReturnBeatRoleFields(gateConfig);

        if (!TryGetOrCreateReturnBeatSignalArray(gateConfig, out var signalArray))
        {
            return;
        }

        if (ContainsReturnBeatSignal(signalArray, signal))
        {
            _machineError = string.Empty;
            _machineStatus = $"Signal '{signal}' is already present.";
            return;
        }

        signalArray.Add(signal);
        transition.GateConfigJson = gateConfig.ToJsonString(_machineGateJsonEditorOptions);

        _machineError = string.Empty;
        _machineStatus = $"Added return-beat signal '{signal}'.";
    }

    private bool TryGetMachineTransition(int index, out RPThemeMachineTransition transition)
    {
        transition = null!;
        if (index < 0 || index >= _machineEditor.Transitions.Count)
        {
            return false;
        }

        transition = _machineEditor.Transitions[index];
        return true;
    }

    private bool TryParseGateConfigObject(string? gateConfigJson, out JsonObject gateConfig)
    {
        gateConfig = new JsonObject();
        if (string.IsNullOrWhiteSpace(gateConfigJson))
        {
            return true;
        }

        try
        {
            var node = JsonNode.Parse(gateConfigJson);
            if (node is null)
            {
                return true;
            }

            if (node is not JsonObject gateConfigObject)
            {
                _machineStatus = string.Empty;
                _machineError = "Gate JSON must be a JSON object before using helpers.";
                return false;
            }

            gateConfig = gateConfigObject;
            return true;
        }
        catch (JsonException ex)
        {
            _machineStatus = string.Empty;
            _machineError = $"Gate JSON must be valid JSON before using helpers. {ex.Message}";
            return false;
        }
    }

    private bool TryGetOrCreateReturnBeatSignalArray(JsonObject gateConfig, out JsonArray signalArray)
    {
        signalArray = new JsonArray();
        if (gateConfig.TryGetPropertyValue("returnBeatCompletionSignals", out var existingSignals)
            && existingSignals is not null)
        {
            if (existingSignals is JsonArray existingSignalArray)
            {
                signalArray = existingSignalArray;
                return true;
            }

            _machineStatus = string.Empty;
            _machineError = "Gate JSON property returnBeatCompletionSignals must be an array before using helpers.";
            return false;
        }

        gateConfig["returnBeatCompletionSignals"] = signalArray;
        return true;
    }

    private static void EnsureReturnBeatRoleFields(JsonObject gateConfig)
    {
        if (!TryGetNonEmptyString(gateConfig, "returnBeatTransgressorRole", out _))
        {
            gateConfig["returnBeatTransgressorRole"] = CharacterRoleCatalog.Wife;
        }

        if (!TryGetNonEmptyString(gateConfig, "returnBeatPartnerRole", out _))
        {
            gateConfig["returnBeatPartnerRole"] = CharacterRoleCatalog.Husband;
        }
    }

    private static bool TryGetNonEmptyString(JsonObject gateConfig, string propertyName, out string value)
    {
        value = string.Empty;
        if (!gateConfig.TryGetPropertyValue(propertyName, out var node)
            || node is not JsonValue jsonValue
            || !jsonValue.TryGetValue<string>(out var raw)
            || string.IsNullOrWhiteSpace(raw))
        {
            return false;
        }

        value = raw.Trim();
        return true;
    }

    private static bool ContainsReturnBeatSignal(JsonArray signalArray, string signal)
    {
        foreach (var signalNode in signalArray)
        {
            if (signalNode is not JsonValue signalValue)
            {
                continue;
            }

            if (!signalValue.TryGetValue<string>(out var existingSignal)
                || string.IsNullOrWhiteSpace(existingSignal))
            {
                continue;
            }

            if (string.Equals(existingSignal.Trim(), signal, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private async Task SaveMachineDefinitionAsync()
    {
        if (_isBusy || _isMachineBusy || _isNew)
        {
            return;
        }

        _isMachineBusy = true;
        _machineError = string.Empty;
        _machineStatus = string.Empty;
        _machineValidationResult = null;

        try
        {
            var payload = NormalizeMachineDefinitionForSave(_machineEditor);
            var saved = await RPThemeService.SaveMachineDefinitionAsync(payload);
            _machineEditor = CloneMachineDefinition(saved);
            _machineMigrationTargetVersion = Math.Max(1, _machineEditor.Version);
            _machineStatus = $"Machine definition '{saved.Name}' v{saved.Version} saved.";
            await LoadMachineDefinitionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _machineError = $"Authorization denied: {ex.Message}";
        }
        catch (Exception ex)
        {
            _machineError = ex.Message;
        }
        finally
        {
            _isMachineBusy = false;
        }
    }

    private async Task ValidateMachineDefinitionAsync()
    {
        if (_isBusy || _isMachineBusy || string.IsNullOrWhiteSpace(_machineEditor.DefinitionId))
        {
            return;
        }

        _isMachineBusy = true;
        _machineError = string.Empty;
        _machineStatus = string.Empty;

        try
        {
            _machineValidationResult = await RPThemeService.ValidateMachineDefinitionAsync(_machineEditor.DefinitionId);
            _machineStatus = _machineValidationResult.IsValid
                ? "Machine definition validation passed."
                : "Machine definition validation failed.";
        }
        catch (Exception ex)
        {
            _machineError = ex.Message;
        }
        finally
        {
            _isMachineBusy = false;
        }
    }

    private async Task ActivateMachineDefinitionAsync()
    {
        if (_isBusy || _isMachineBusy || _isNew)
        {
            return;
        }

        _isMachineBusy = true;
        _machineError = string.Empty;
        _machineStatus = string.Empty;

        try
        {
            await RPThemeService.ActivateMachineDefinitionAsync(
                _theme.Id,
                _machineEditor.MachineKey,
                _machineEditor.Version,
                _machineActorId);
            _machineStatus = $"Activated machine '{_machineEditor.MachineKey}' version {_machineEditor.Version}.";
            await LoadMachineDefinitionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _machineError = $"Authorization denied: {ex.Message}";
        }
        catch (Exception ex)
        {
            _machineError = ex.Message;
        }
        finally
        {
            _isMachineBusy = false;
        }
    }

    private async Task MigrateMachineVersionAsync()
    {
        if (_isBusy || _isMachineBusy || _isNew)
        {
            return;
        }

        var sessionId = (_machineMigrationSessionId ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(sessionId))
        {
            _machineError = "Session Id is required for machine migration.";
            return;
        }

        _isMachineBusy = true;
        _machineError = string.Empty;
        _machineStatus = string.Empty;

        try
        {
            await RPThemeService.MigrateSessionMachineVersionAsync(
                sessionId,
                _theme.Id,
                _machineEditor.MachineKey,
                _machineMigrationTargetVersion,
                _machineActorId);
            _machineStatus = $"Session '{sessionId}' migrated to machine '{_machineEditor.MachineKey}' version {_machineMigrationTargetVersion}.";
        }
        catch (UnauthorizedAccessException ex)
        {
            _machineError = $"Authorization denied: {ex.Message}";
        }
        catch (Exception ex)
        {
            _machineError = ex.Message;
        }
        finally
        {
            _isMachineBusy = false;
        }
    }

    private RPThemeMachineDefinition NormalizeMachineDefinitionForSave(RPThemeMachineDefinition source)
    {
        var definition = CloneMachineDefinition(source);

        definition.DefinitionId = (definition.DefinitionId ?? string.Empty).Trim();
        definition.ThemeId = _theme.Id;
        definition.MachineKey = (definition.MachineKey ?? string.Empty).Trim();
        definition.Name = (definition.Name ?? string.Empty).Trim();
        definition.Version = Math.Max(1, definition.Version);

        definition.States = definition.States
            .Where(x => !string.IsNullOrWhiteSpace(x.StateCode)
                || !string.IsNullOrWhiteSpace(x.Label)
                || x.IsInitial
                || x.IsTerminal)
            .Select((x, index) => new RPThemeMachineState
            {
                StateId = (x.StateId ?? string.Empty).Trim(),
                DefinitionId = definition.DefinitionId,
                StateCode = (x.StateCode ?? string.Empty).Trim(),
                Label = (x.Label ?? string.Empty).Trim(),
                IsInitial = x.IsInitial,
                IsTerminal = x.IsTerminal,
                SortOrder = x.SortOrder == 0 ? index : x.SortOrder
            })
            .ToList();

        definition.Transitions = definition.Transitions
            .Where(x => !string.IsNullOrWhiteSpace(x.FromStateCode)
                || !string.IsNullOrWhiteSpace(x.ToStateCode)
                || !string.IsNullOrWhiteSpace(x.TriggerType)
                || !string.IsNullOrWhiteSpace(x.BlockReasonCode))
            .Select((x, index) => new RPThemeMachineTransition
            {
                TransitionId = (x.TransitionId ?? string.Empty).Trim(),
                DefinitionId = definition.DefinitionId,
                FromStateCode = (x.FromStateCode ?? string.Empty).Trim(),
                ToStateCode = (x.ToStateCode ?? string.Empty).Trim(),
                Priority = x.Priority == 0 ? index : x.Priority,
                TriggerType = (x.TriggerType ?? string.Empty).Trim(),
                GateConfigJson = string.IsNullOrWhiteSpace(x.GateConfigJson) ? "{}" : x.GateConfigJson.Trim(),
                BlockReasonCode = (x.BlockReasonCode ?? string.Empty).Trim(),
                IsEnabled = x.IsEnabled,
                CreatedUtc = x.CreatedUtc,
                UpdatedUtc = x.UpdatedUtc
            })
            .ToList();

        return definition;
    }

    private static RPThemeMachineDefinition CreateEmptyMachineDefinition()
        => new()
        {
            DefinitionId = string.Empty,
            ThemeId = string.Empty,
            MachineKey = string.Empty,
            Version = 1,
            Name = string.Empty,
            IsActive = false,
            IsSeeded = false,
            States = [],
            Transitions = []
        };

    private static RPThemeMachineDefinition CloneMachineDefinition(RPThemeMachineDefinition source)
        => new()
        {
            DefinitionId = source.DefinitionId,
            ThemeId = source.ThemeId,
            MachineKey = source.MachineKey,
            Version = source.Version,
            Name = source.Name,
            IsActive = source.IsActive,
            IsSeeded = source.IsSeeded,
            CreatedUtc = source.CreatedUtc,
            UpdatedUtc = source.UpdatedUtc,
            States = source.States
                .OrderBy(x => x.SortOrder)
                .ThenBy(x => x.StateCode, StringComparer.OrdinalIgnoreCase)
                .Select(x => new RPThemeMachineState
                {
                    StateId = x.StateId,
                    DefinitionId = x.DefinitionId,
                    StateCode = x.StateCode,
                    Label = x.Label,
                    IsInitial = x.IsInitial,
                    IsTerminal = x.IsTerminal,
                    SortOrder = x.SortOrder
                })
                .ToList(),
            Transitions = source.Transitions
                .OrderBy(x => x.Priority)
                .ThenBy(x => x.FromStateCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(x => x.TransitionId, StringComparer.OrdinalIgnoreCase)
                .Select(x => new RPThemeMachineTransition
                {
                    TransitionId = x.TransitionId,
                    DefinitionId = x.DefinitionId,
                    FromStateCode = x.FromStateCode,
                    ToStateCode = x.ToStateCode,
                    Priority = x.Priority,
                    TriggerType = x.TriggerType,
                    GateConfigJson = x.GateConfigJson,
                    BlockReasonCode = x.BlockReasonCode,
                    IsEnabled = x.IsEnabled,
                    CreatedUtc = x.CreatedUtc,
                    UpdatedUtc = x.UpdatedUtc
                })
                .ToList()
        };

