@page "/asset-studio/{assetId}"
@rendermode InteractiveServer

@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.Evaluation
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Components.Assets
@implements IAsyncDisposable

@inject ISceneAssetService AssetService
@inject ILocationImageAnalysisQueue AnalysisQueue
@inject NavigationManager Navigation
@inject ILogger<AssetStudioView> Logger

<PageTitle>Asset - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">@(_asset?.Name ?? "Asset")</h4>
            @if (_asset is not null)
            {
                <span class="small text-muted">@_asset.Type · @_images.Count image@(_images.Count == 1 ? string.Empty : "s")</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a href="/asset-studio" class="btn btn-outline-secondary btn-sm">Back to Asset Manager</a>
        </div>
    </div>

    @if (_asset is null)
    {
        <div class="alert alert-warning">Asset not found.</div>
    }
    else
    {
        @* The container's own name, and its own end-of-life. Both live here rather than in the images list because
           they are facts about the container, not about any one image in it: a run container is named by whoever
           starts the run and is deleted as a whole. *@
        <div class="card mb-3">
            <div class="card-header py-2"><span class="small fw-semibold">This container</span></div>
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-sm-6 col-lg-4">
                        <label class="form-label small mb-1" for="container-name">Name</label>
                        <input id="container-name" class="form-control form-control-sm" value="@_nameDraft"
                               disabled="@_busy" @onchange="e => _nameDraft = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary" type="button" disabled="@(_busy || !CanRename)"
                                @onclick="RenameAsync">
                            Save name
                        </button>
                    </div>
                    <div class="col-auto ms-auto">
                        @if (!_deleteArmed)
                        {
                            <button class="btn btn-sm btn-outline-danger" type="button" disabled="@_busy"
                                    @onclick="() => _deleteArmed = true">
                                <i class="bi bi-trash me-1"></i>Delete container
                            </button>
                        }
                        else
                        {
                            <span class="small text-danger me-1">Delete this container and its images permanently?</span>
                            <button class="btn btn-sm btn-danger" type="button" disabled="@_busy"
                                    @onclick="DeleteContainerAsync">
                                Yes, delete
                            </button>
                            <button class="btn btn-sm btn-outline-secondary ms-1" type="button" disabled="@_busy"
                                    @onclick="() => _deleteArmed = false">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
                <div class="form-text">
                    The name is the container's label in the Asset Manager and in every run report. Deleting removes the
                    container and every image in it; a container that is in use (a LoRA dataset member, an approved
                    production asset, an identity pack) is refused by name instead.
                </div>
                @if (!string.IsNullOrWhiteSpace(_containerMessage))
                {
                    <div class="alert alert-secondary py-1 small mb-0 mt-2">@_containerMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_containerError))
                {
                    <div class="alert alert-warning py-1 small mb-0 mt-2">@_containerError</div>
                }
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-7">
                <PromptAssetCreator AssetId="@_asset.Id" SubjectActor="SubjectActor()" ImagesChanged="LoadAsync" Draft="_draft"
                                    RequestedLocationReference="_requestedLocationReference"
                                    SeedUserInput="@(_asset.Type == SceneAssetType.Location ? _asset.Prompt : null)" />
            </div>
            <div class="col-xl-5">
                <AssetUploadCreator AssetId="@_asset.Id" ImagesChanged="LoadAsync" />
            </div>
        </div>

        <div class="mb-4">
            <AssetRunTray AssetId="@_asset.Id" />
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Images</h5>
            <div class="d-flex align-items-center gap-2">
                @if (_images.Any(image => image.Status == SceneAssetStatus.Pending))
                {
                    <span class="small text-muted">Processing...</span>
                }
                @* Filtering narrows what is SHOWN; every card below is still the same card, and the counts come from the
                   list itself so an empty view is never offered. *@
                <ImageCardStatusFilter Options="FilterOptions"
                                       Selected="_decisionFilter"
                                       SelectedChanged="OnDecisionFilterChanged"
                                       Total="_images.Count" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-secondary py-1 small mb-2">@_message</div>
        }
        @if (_images.Count == 0)
        {
            <div class="border rounded p-4 text-center text-muted">No images yet. Generate or upload the first one above.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var image in VisibleImages)
                {
                    <div class="col-sm-6 col-xl-4 col-xxl-3">
                        <ImageCard Model="CardModel(image)"
                                   Busy="_busy"
                                   ShowName="true"
                                   NameChanged="name => RenameImageAsync(image, name)"
                                   AcceptRequested="() => DecideImageAsync(image, SceneAssetCandidateDecision.Accepted)"
                                   ShortlistRequested="() => DecideImageAsync(image, SceneAssetCandidateDecision.Shortlisted)"
                                   RejectRequested="() => DecideImageAsync(image, SceneAssetCandidateDecision.Rejected)"
                                   EditRequested="() => OpenEdit(image)"
                                   ReviewRequested="() => OpenReview(image)"
                                   DownloadRequested="() => OpenDownload(image)"
                                   VideoRequested="() => OpenVideo(image)"
                                   LoadIntoGeneratorRequested="() => LoadIntoGenerator(image)"
                                   UseAsReferenceRequested="@(CanUseAsReference(image)
                                       ? EventCallback.Factory.Create(this, () => UseAsReference(image))
                                       : default(EventCallback))"
                                   RevokeRequested="() => RevokeApprovalAsync(image)"
                                   DeleteRequested="() => DeleteImageAsync(image)">
                            <BodyContent>
                                @if (image.Status == SceneAssetStatus.Complete)
                                {
                                    <div class="mt-2">
                                        <ImageTags ImageId="image.Id" Target="ImageTagTarget.AssetLibrary"
                                                   TagsJson="image.TagsJson" Editable="true" TagsChanged="LoadAsync" />
                                    </div>
                                }
                                @if (IsLocationAsset)
                                {
                                    @* B-160: what a vision model found in this location image, and the action that
                                       asks it to look. Shown for LOCATION containers only, because a location image is
                                       the one whose contents the prompt has to place people against — a face or a
                                       wardrobe reference is not a place. *@
                                    <div class="mt-2 border rounded p-2">
                                        <div class="d-flex justify-content-between align-items-center gap-2">
                                            <strong class="small">Location contents</strong>
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    disabled="@_busy" @onclick="() => ReadLocationAsync(image)">
                                                <i class="bi bi-eye me-1"></i>@(AnalysisFor(image) is null ? "Read this location" : "Read again")
                                            </button>
                                        </div>
                                        @if (AnalysisFor(image) is { } analysis)
                                        {
                                            <div class="small mt-1">@analysis.Description</div>
                                            @if (analysis.Anchors.Count > 0)
                                            {
                                                <ul class="small mb-0 ps-3 mt-1">
                                                    @foreach (var anchor in analysis.Anchors)
                                                    {
                                                        <li>
                                                            <span class="fw-semibold">@anchor.Role</span>: @anchor.Name
                                                            @if (anchor.Horizontal is not null || anchor.Depth is not null)
                                                            {
                                                                <span class="text-muted">
                                                                    (@string.Join(", ", new[] { anchor.Horizontal?.ToString(), anchor.Depth?.ToString() }.Where(part => part is not null)))
                                                                </span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            @if (!analysis.IsAbout(image.Sha256))
                                            {
                                                @* Staleness is stated, not hidden: the reading is about a picture
                                                   this one has replaced, so nothing downstream may use it. *@
                                                <div class="alert alert-warning py-1 small mt-2 mb-0">
                                                    This reading is of an earlier version of this image. Read it again.
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="form-text mt-1">
                                                Read this image to learn what is in it — then the prompt can place people
                                                on the right structure (a deck, a doorway, the line).
                                            </div>
                                        }
                                    </div>
                                }
                            </BodyContent>
                        </ImageCard>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string? AssetId { get; set; }

    /// <summary>
    /// An image whose recorded settings this page should load into the generator as soon as it is open (B-140 FR-12).
    ///
    /// <para>
    /// Carried as a query parameter so the REVIEW page — where an operator decides an image is worth reproducing — can
    /// hand the round-trip over in one click, instead of making them go back to the asset, find the same thumbnail and
    /// press the same button. The load itself is the page's existing one, so there is a single implementation of
    /// "restore what made this image".
    /// </para>
    /// </summary>
    [SupplyParameterFromQuery(Name = "loadImageId")] public string? LoadImageId { get; set; }

    private SceneAsset? _asset;
    private List<SceneAssetImage> _images = [];
    private bool _busy;
    private string? _message;
    private string? _decisionFilter;

    /// <summary>
    /// The cards the filter offers, and the images the filter leaves visible. Both are derived from <see cref="_images"/>
    /// through the ONE card model, so what the operator filters on is exactly what the card shows.
    /// </summary>
    private IReadOnlyList<SceneImageCardModel> CardModels => _images.Select(CardModel).ToList();

    private IReadOnlyList<ImageCardFilterOption> FilterOptions => ImageCardStatus.Build(CardModels);

    private IEnumerable<SceneAssetImage> VisibleImages =>
        _images.Where(image => ImageCardStatus.Matches(CardModel(image), _decisionFilter));

    private void OnDecisionFilterChanged(string? key) => _decisionFilter = key;

    /// <summary>The name being typed. A DRAFT, not the stored name: nothing is written until Save, so a half-typed name
    /// never reaches the row that a run report or a container link is already showing.</summary>
    private string _nameDraft = string.Empty;

    /// <summary>
    /// Whether the delete button has been pressed once. Two steps rather than one: a container and every image in it go
    /// together, so the confirmation is an act of its own rather than a click that can be made by accident.
    /// </summary>
    private bool _deleteArmed;

    private string? _containerMessage;
    private string? _containerError;

    /// <summary>Which asset the name box was seeded from, so a reload of the SAME asset leaves it alone.</summary>
    private string? _nameDraftAssetId;

    /// <summary>Save is offered only for a name that differs from the stored one, so a no-op write cannot be queued.</summary>
    private bool CanRename => _asset is not null
        && !string.IsNullOrWhiteSpace(_nameDraft)
        && !string.Equals(_nameDraft.Trim(), _asset.Name, StringComparison.Ordinal);

    private async Task RenameAsync()
    {
        if (_asset is null)
        {
            return;
        }

        _busy = true;
        _containerError = null;
        _containerMessage = null;
        try
        {
            var renamed = await AssetService.RenameAssetAsync(_asset.Id, _nameDraft);
            _containerMessage = $"Renamed to '{renamed.Name}'.";
            _nameDraft = renamed.Name;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _containerError = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Deletes this container and everything in it, then returns to the Asset Manager. The refusal cases - an approved
    /// production asset, a LoRA dataset member, an identity pack - come back in the service's own words and are shown
    /// where the button was, because a delete that silently did nothing would read as a delete that worked.
    /// </summary>
    private async Task DeleteContainerAsync()
    {
        if (_asset is null)
        {
            return;
        }

        _busy = true;
        _containerError = null;
        _containerMessage = null;
        try
        {
            await AssetService.DeleteAssetAsync(_asset.Id);
            Navigation.NavigateTo("/asset-studio");
        }
        catch (Exception exception)
        {
            _containerError = exception.Message;
            _deleteArmed = false;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// The image whose own recorded settings have been loaded into the generate panel above, or null until one is.
    /// Held on the page rather than in the panel so the panel stays a plain surface that a parent can seed.
    /// </summary>
    private DreamGenClone.Web.Application.RolePlay.ImageStep.ImageGenerationDraft? _draft;

    /// <summary>
    /// Loads one image's own settings back into the generator: the prompt it rendered, the model, the size, the seed
    /// and the references it carried.
    ///
    /// <para>
    /// Read from the image ROW, not from its queue payload: a completed job's payload is gone, and for an image that
    /// succeeded the row is the authoritative record of how it was made. Nothing is invented for a field the row never
    /// recorded - the panel names what it could not restore instead.
    /// </para>
    /// </summary>
    private void LoadIntoGenerator(SceneAssetImage image)
    {
        _draft = DreamGenClone.Web.Application.RolePlay.ImageStep.ImageGenerationDraft.FromImage(image);
        _autoLoadedImageId = image.Id;
        _message = _draft.HasAnythingToLoad
            ? $"Loaded image {image.Id[..Math.Min(8, image.Id.Length)]}… into the generator."
            : $"Image {image.Id[..Math.Min(8, image.Id.Length)]}… recorded nothing that can be loaded.";
    }

    /// <summary>
    /// Whether this image could stand as the generator's Location reference. It is the approved-image channel's own
    /// contract — approved, with the version and checksum the binding has to record — so the command is offered exactly
    /// where the render would accept it.
    /// </summary>
    private static bool CanUseAsReference(SceneAssetImage image)
        => image.Status == SceneAssetStatus.Complete
            && image.ProductionApprovalStatus == SceneAssetProductionApprovalStatus.Approved
            && image.ProductionVersion is not null
            && !string.IsNullOrWhiteSpace(image.Sha256);

    /// <summary>
    /// The card's "use as reference": load everything that made this image into the generator AND bind the image itself
    /// as the step's Location reference, so the next render is anchored to it.
    ///
    /// <para>
    /// Both halves go through the page's existing load and the composer's own plan — the draft is the SAME load the
    /// "load the prompt and model" command performs, and the reference is a request the step applies, not a binding this
    /// page authors.
    /// </para>
    /// </summary>
    private void UseAsReference(SceneAssetImage image)
    {
        LoadIntoGenerator(image);
        _requestedLocationReference = DreamGenClone.Web.Application.RolePlay.ImageStep.SceneImageLocationReferenceRequest
            .ForApprovedAssetImage(
                image.AssetId,
                image.Id,
                image.ProductionVersion!.Value,
                image.Sha256!,
                image.DisplayName);
        _message = $"Loaded image {image.Id[..Math.Min(8, image.Id.Length)]}… and added it as the Location reference.";
    }

    /// <summary>
    /// The image a card asked to bind as the generator's Location reference. Held as a REQUEST rather than a binding:
    /// the composer owns the step's plan, so the page states the image and the step decides where it goes.
    /// </summary>
    private DreamGenClone.Web.Application.RolePlay.ImageStep.SceneImageLocationReferenceRequest? _requestedLocationReference;

    /// <summary>
    /// The image a query-parameter load already applied, so the page's polling reload does not re-apply it and stomp on
    /// edits the operator has since made in the generator.
    /// </summary>
    private string? _autoLoadedImageId;

    /// <summary>
    /// Applies the <c>loadImageId</c> request once, when the named image is actually among this asset's images. An id
    /// that is not (a stale link, an image deleted since) loads nothing and is not silently reported as loaded.
    /// </summary>
    private void ApplyRequestedDraftLoad()
    {
        if (string.IsNullOrWhiteSpace(LoadImageId)
            || string.Equals(_autoLoadedImageId, LoadImageId, StringComparison.Ordinal))
        {
            return;
        }

        if (_images.FirstOrDefault(image => string.Equals(image.Id, LoadImageId, StringComparison.Ordinal)) is { } image)
        {
            LoadIntoGenerator(image);
        }
    }

    /// <summary>
    /// Deletes one image. The service refuses an image that is IN USE as a reference image, and its message is shown
    /// verbatim: "stop using it first" is an instruction the operator can act on, and inventing a nicer sentence here
    /// would be a second, drifting copy of the rule.
    /// </summary>
    /// <summary>
    /// Names one image, or renames it. The name is the operator's label for THIS picture and what a reference picker
    /// shows, so it is written through its own writer rather than through any image save.
    ///
    /// <para>
    /// A blank name is refused by the service and its own words are shown: clearing the box is an instruction the
    /// operator can act on ("a name is required"), and inventing a nicer sentence here would be a second, drifting
    /// copy of the rule. The reload then puts the stored value back in the box, so the card always shows what is
    /// actually recorded.
    /// </para>
    /// </summary>
    private async Task RenameImageAsync(SceneAssetImage image, string? name)
    {
        _busy = true;
        _message = null;
        try
        {
            var named = await AssetService.SetImageDisplayNameAsync(image.Id, name ?? string.Empty);
            _message = $"This image is named '{named.DisplayName}'.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteImageAsync(SceneAssetImage image)
    {
        _busy = true;
        _message = null;
        try
        {
            await AssetService.DeleteImageAsync(image.Id);
            _message = $"Deleted image {image.Id[..Math.Min(8, image.Id.Length)]}…";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Records the review deck's decision (accept / shortlist / reject) against this image.</summary>
    private async Task DecideImageAsync(SceneAssetImage image, SceneAssetCandidateDecision decision)
    {
        _busy = true;
        _message = null;
        try
        {
            await AssetService.SetImageCandidateDecisionAsync(image.Id, decision, null);
            _message = $"Set {image.Id[..Math.Min(8, image.Id.Length)]}… to {decision}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string? EditImageUrl(SceneAssetImage image)
        => $"/assets/{_asset!.Id}/images/{image.Id}/edit?return=/asset-studio/{_asset.Id}";

    private string? ReviewImageUrl(SceneAssetImage image)
        => $"/assets/{_asset!.Id}/images/{image.Id}/review";

    private string? DownloadImageUrl(SceneAssetImage image)
        => $"/asset-studio/images/{image.Id}/download";

    private string? VideoImageUrl(SceneAssetImage image)
        => $"/roleplay/video-studio/asset/{image.Id}";

    private SceneImageCardModel CardModel(SceneAssetImage image) => new()
    {
        Id = image.Id,
        FileRelativePath = image.FileRelativePath,
        StatusText = image.Status.ToString(),
        StatusBadgeClass = image.Status switch
        {
            SceneAssetStatus.Complete => "text-bg-success",
            SceneAssetStatus.Failed => "text-bg-danger",
            _ => "text-bg-secondary"
        },
        IsComplete = image.Status == SceneAssetStatus.Complete,
        ErrorMessage = image.ErrorMessage,
        Subtitle = $"{image.Kind} · {image.CreatedUtc.ToLocalTime():g}",
        DecisionBadgeText = image.CandidateDecision is null ? null : $"picked: {image.CandidateDecision}",
        DecisionBadgeTitle = "This attempt was the batch's pick. It is NOT approved for production, so it cannot be used as a reference until it is approved on the review page.",
        ApprovalBadgeText = image.ProductionApprovalStatus?.ToString(),
        GateResults = ImageGateResults.Read(image.GateResultsJson),
        CandidateBatchId = image.CandidateBatchId,
        DisplayName = image.DisplayName,
        IsProductionApproved = image.ProductionApprovalStatus == SceneAssetProductionApprovalStatus.Approved,
        DecisionKey = DecideKey(image),
        DecisionLabel = DecideLabel(image)
    };

    /// <summary>
    /// The one decision this image is filed under, in the filter's shared vocabulary. Production approval wins over the
    /// candidate verdict: an image approved for production is "Approved" whatever the batch picked, because that is the
    /// state an operator is looking for when they filter.
    /// </summary>
    private static string? DecideKey(SceneAssetImage image) => image.Status switch
    {
        SceneAssetStatus.Pending => ImageCardStatus.Pending,
        SceneAssetStatus.Failed => ImageCardStatus.Failed,
        _ when image.ProductionApprovalStatus == SceneAssetProductionApprovalStatus.Approved => ImageCardStatus.Approved,
        _ => image.CandidateDecision switch
        {
            SceneAssetCandidateDecision.Accepted => ImageCardStatus.Accepted,
            SceneAssetCandidateDecision.Shortlisted => ImageCardStatus.Shortlisted,
            SceneAssetCandidateDecision.Rejected => ImageCardStatus.Rejected,
            SceneAssetCandidateDecision.Revoked => ImageCardStatus.Revoked,
            _ => ImageCardStatus.Undecided
        }
    };

    private static string? DecideLabel(SceneAssetImage image)
        => DecideKey(image) == ImageCardStatus.Approved ? "Approved" : null;

    private void OpenEdit(SceneAssetImage image) => NavigateTo(EditImageUrl(image));

    private void OpenReview(SceneAssetImage image) => NavigateTo(ReviewImageUrl(image));

    private void OpenDownload(SceneAssetImage image) => NavigateTo(DownloadImageUrl(image));

    private void OpenVideo(SceneAssetImage image) => NavigateTo(VideoImageUrl(image));

    private void NavigateTo(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
            Navigation.NavigateTo(url);
    }

    /// <summary>
    /// Takes an approved image back out of production.
    ///
    /// <para>
    /// This is the step the delete's refusal tells the operator to take, so it has to exist somewhere they can reach:
    /// while the image is approved the pickers offer it as a reference and <c>DeleteImageAsync</c> refuses. Nothing is
    /// destroyed here — the approval is what is withdrawn, and it can be given again from the review page.
    /// </para>
    /// </summary>
    private async Task RevokeApprovalAsync(SceneAssetImage image)
    {
        _busy = true;
        _message = null;
        try
        {
            var revoked = await AssetService.RevokeImageApprovalAsync(image.Id);
            var label = revoked.DisplayName is { Length: > 0 } name
                ? name
                : revoked.Id[..Math.Min(8, revoked.Id.Length)];
            _message = $"Took '{label}' out of production. It is no longer offered as a reference, so it can be deleted now.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private System.Threading.Timer? _timer;
    private readonly object _timerLock = new();

    protected override async Task OnParametersSetAsync()
    {
        // The poll is started by the load itself, so every path that loads the list - opening the page, generating,
        // renaming, deleting - reconciles it. See LoadAsync.
        await LoadAsync();
    }

    /// <summary>
    /// True for a location container whose images are places rather than people or garments — the surface where a
    /// reading of what the image contains is meaningful (B-160).
    /// </summary>
    private bool IsLocationAsset => _asset?.Type == SceneAssetType.Location;

    /// <summary>
    /// The reading stored on an image, or null when it has none or the stored JSON is unreadable.
    /// </summary>
    /// <remarks>
    /// An unreadable analysis is treated as absent rather than as a reason to fail the page: the card's job is to show
    /// whether a reading exists, and "Read again" is the remedy either way.
    /// </remarks>
    private static LocationImageAnalysis? AnalysisFor(SceneAssetImage image)
    {
        try
        {
            return LocationImageAnalysisJson.TryRead(image.LocationAnalysisJson);
        }
        catch (InvalidOperationException)
        {
            return null;
        }
    }

    /// <summary>
    /// Asks for this location image to be read (B-160), or read AGAIN when it already has a reading.
    /// </summary>
    /// <remarks>
    /// The second press is a genuine re-read: the first reading is kept until the new one succeeds, so a failed attempt
    /// costs nothing, and the handler's "already read this checksum" rule is bypassed because the operator asked.
    /// </remarks>
    private async Task ReadLocationAsync(SceneAssetImage image)
    {
        try
        {
            _busy = true;
            _message = null;
            var again = AnalysisFor(image) is not null;
            await AnalysisQueue.RequestAsync(image.Id, force: again);
            _message = again
                ? "Reading this location again. The current reading stays until the new one arrives."
                : "Reading this location. The result appears here when it is done.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Requesting a location analysis failed for image {ImageId}.", image.Id);
            _message = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        _asset = string.IsNullOrWhiteSpace(AssetId)
            ? null
            : await AssetService.GetAssetAsync(AssetId!);
        _images = _asset is null
            ? []
            : (await AssetService.ListImagesAsync(_asset.Id)).ToList();

        // After the image list is loaded, so a request to load one image's settings can be honoured for THIS asset.
        ApplyRequestedDraftLoad();

        // Seeded ONCE per asset, not on every load. This page polls while an image is pending, and a poll that
        // re-seeded the box would delete a name the operator was halfway through typing.
        if (!string.Equals(_nameDraftAssetId, AssetId, StringComparison.Ordinal))
        {
            _nameDraftAssetId = AssetId;
            _nameDraft = _asset?.Name ?? string.Empty;
        }

        StateHasChanged();

        // THIS is what makes the Images list update on its own. Blazor re-renders a poll-driven load only because the
        // load renders; and the poll has to be reconciled HERE, on the load path, because the image that is pending is
        // usually asked for from this very page (it arrives through ImagesChanged, after the page opened). Starting it
        // only when the page was first shown left a finished render — and the "Processing..." badge — stuck until the
        // operator reloaded the screen by hand. Same rule as CharacterWardrobePanel.
        EnsurePolling();
    }

    /// <summary>
    /// The character this asset belongs to, when it belongs to one. The asset creator declares its per-character
    /// element slots from this, because a character slot must name its character; an asset with no character simply
    /// has no such slots rather than rendering one that addresses nobody.
    /// </summary>
    private ImageStepActor? SubjectActor() => string.IsNullOrWhiteSpace(_asset?.CharacterProfileId)
        ? null
        : new ImageStepActor(_asset.CharacterProfileId, _asset.Name);

    private void EnsurePolling()
    {
        lock (_timerLock)
        {
            if (_timer is not null) return;
            if (_asset is null || !_images.Any(image => image.Status == SceneAssetStatus.Pending))
            {
                return;
            }

            _timer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    // Marshalled onto the dispatcher because a System.Threading.Timer callback runs on a threadpool
                    // thread, and GUARDED because this lambda is async void: an exception escaping one of those is
                    // unhandled and can take the process down. Same guard as the Asset Manager's own poll.
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        if (_asset is null || !_images.Any(image => image.Status == SceneAssetStatus.Pending))
                        {
                            StopPolling();
                        }
                    });
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Asset image list polling reload failed.");
                }
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        }
    }

    private static string StatusBadge(SceneAssetStatus status) => status switch
    {
        SceneAssetStatus.Complete => "text-bg-success",
        SceneAssetStatus.Failed => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    /// <summary>The native gates measured on this image (B-135 P3), or empty when none ran.</summary>
    private static IReadOnlyList<ImageGateResult> GateResults(SceneAssetImage image) =>
        ImageGateResults.Read(image.GateResultsJson);

    private void StopPolling()
    {
        lock (_timerLock)
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}
