@page "/asset-studio/{assetId}"
@rendermode InteractiveServer

@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.Evaluation
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Components.Assets
@implements IAsyncDisposable

@inject ISceneAssetService AssetService
@inject NavigationManager Navigation
@inject ILogger<AssetStudioView> Logger

<PageTitle>Asset - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">@(_asset?.Name ?? "Asset")</h4>
            @if (_asset is not null)
            {
                <span class="small text-muted">@_asset.Type · @_images.Count image@(_images.Count == 1 ? string.Empty : "s")</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a href="/asset-studio" class="btn btn-outline-secondary btn-sm">Back to Asset Manager</a>
        </div>
    </div>

    @if (_asset is null)
    {
        <div class="alert alert-warning">Asset not found.</div>
    }
    else
    {
        @* The container's own name, and its own end-of-life. Both live here rather than in the images list because
           they are facts about the container, not about any one image in it: a run container is named by whoever
           starts the run and is deleted as a whole. *@
        <div class="card mb-3">
            <div class="card-header py-2"><span class="small fw-semibold">This container</span></div>
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-sm-6 col-lg-4">
                        <label class="form-label small mb-1" for="container-name">Name</label>
                        <input id="container-name" class="form-control form-control-sm" value="@_nameDraft"
                               disabled="@_busy" @onchange="e => _nameDraft = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary" type="button" disabled="@(_busy || !CanRename)"
                                @onclick="RenameAsync">
                            Save name
                        </button>
                    </div>
                    <div class="col-auto ms-auto">
                        @if (!_deleteArmed)
                        {
                            <button class="btn btn-sm btn-outline-danger" type="button" disabled="@_busy"
                                    @onclick="() => _deleteArmed = true">
                                <i class="bi bi-trash me-1"></i>Delete container
                            </button>
                        }
                        else
                        {
                            <span class="small text-danger me-1">Delete this container and its images permanently?</span>
                            <button class="btn btn-sm btn-danger" type="button" disabled="@_busy"
                                    @onclick="DeleteContainerAsync">
                                Yes, delete
                            </button>
                            <button class="btn btn-sm btn-outline-secondary ms-1" type="button" disabled="@_busy"
                                    @onclick="() => _deleteArmed = false">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
                <div class="form-text">
                    The name is the container's label in the Asset Manager and in every run report. Deleting removes the
                    container and every image in it; a container that is in use (a LoRA dataset member, an approved
                    production asset, an identity pack) is refused by name instead.
                </div>
                @if (!string.IsNullOrWhiteSpace(_containerMessage))
                {
                    <div class="alert alert-secondary py-1 small mb-0 mt-2">@_containerMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_containerError))
                {
                    <div class="alert alert-warning py-1 small mb-0 mt-2">@_containerError</div>
                }
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-7">
                <PromptAssetCreator AssetId="@_asset.Id" SubjectActor="SubjectActor()" ImagesChanged="LoadAsync" Draft="_draft"
                                    SeedUserInput="@(_asset.Type == SceneAssetType.Location ? _asset.Prompt : null)" />
            </div>
            <div class="col-xl-5">
                <AssetUploadCreator AssetId="@_asset.Id" ImagesChanged="LoadAsync" />
            </div>
        </div>

        <div class="mb-4">
            <AssetRunTray AssetId="@_asset.Id" />
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Images</h5>
            @if (_images.Any(image => image.Status == SceneAssetStatus.Pending))
            {
                <span class="small text-muted">Processing...</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-secondary py-1 small mb-2">@_message</div>
        }
        @if (_images.Count == 0)
        {
            <div class="border rounded p-4 text-center text-muted">No images yet. Generate or upload the first one above.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var image in _images)
                {
                    <div class="col-sm-6 col-xl-4 col-xxl-3">
                        <article class="card h-100">
                            <div class="ratio ratio-1x1 bg-dark">
                                @if (image.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(image.FileRelativePath))
                                {
                                    <img src="/scene-images/@image.FileRelativePath" class="w-100 h-100" style="object-fit:contain;" alt="@_asset.Name image" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center text-light small">@image.Status</div>
                                }
                            </div>
                            <div class="card-body py-2 small">
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge @StatusBadge(image.Status)">@image.Status</span>
                                    @if (image.ProductionApprovalStatus is not null)
                                    {
                                        <span class="badge text-bg-info">@image.ProductionApprovalStatus</span>
                                    }
                                    @if (image.CandidateDecision is not null)
                                    {
                                        @* Deliberately NOT green and deliberately not just the verdict. A green "Accepted"
                                           reads as approved-for-use, which it is not: it only says this attempt was the
                                           batch's pick. The confusion cost an operator a working session (2026-10-02),
                                           so the badge names the gate it is and the title says which gate it is not. *@
                                        <span class="badge text-bg-secondary"
                                              title="This attempt was the batch's pick. It is NOT approved for production, so it cannot be used as a reference until it is approved on the review page.">
                                            picked: @image.CandidateDecision
                                        </span>
                                    }
                                    @* The native gates measured on this image (B-135 P3). A fail carries the measured
                                       number in its tooltip; a gate only records, it never blocks the render. *@
                                    @foreach (var gate in GateResults(image))
                                    {
                                        <span class="badge @(gate.Pass ? "text-bg-success" : "text-bg-danger")"
                                              title="@gate.Detail">
                                            @gate.Name @(gate.Pass ? "✓" : "✗")
                                        </span>
                                    }
                                </div>
                                <div class="font-monospace text-truncate mt-2" title="@image.Id">@image.Id</div>
                                <div class="text-muted">@image.Kind · @image.CreatedUtc.ToLocalTime().ToString("g")</div>
                                @* The name is what a reference picker shows, so it is edited HERE, on the picture it
                                   belongs to. Saved on change (blur or Enter) rather than by a button: there is one
                                   field, and a Save button under every thumbnail would be a row of buttons for a
                                   one-word label. A blank name is refused by the service, whose words are shown above
                                   rather than swallowed, and the card then shows the stored value again. *@
                                <div class="mt-2">
                                    <input class="form-control form-control-sm" value="@image.DisplayName"
                                           placeholder="Name this image (Front, Left side…)"
                                           aria-label="Image name"
                                           disabled="@_busy"
                                           @onchange="args => RenameImageAsync(image, args.Value?.ToString())" />
                                </div>
                                @if (image.Status == SceneAssetStatus.Complete)
                                {
                                    @* Tags are edited only on a finished image: a tag is a claim about a picture, and
                                       a pending or failed row has no picture to make a claim about. *@
                                    <div class="mt-2">
                                        <ImageTags Image="image" Editable="true" TagsChanged="LoadAsync" />
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(image.ErrorMessage))
                                {
                                    <div class="text-danger mt-1">@image.ErrorMessage</div>
                                }
                            </div>
                            @if (image.Status == SceneAssetStatus.Complete)
                            {
                                <div class="card-footer d-flex gap-1 justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary" href="/assets/@_asset.Id/images/@image.Id/edit?return=/asset-studio/@_asset.Id" title="Edit image"><i class="bi bi-magic"></i></a>
                                    <a class="btn btn-sm btn-outline-success" href="/assets/@_asset.Id/images/@image.Id/review" title="Review image"><i class="bi bi-check2-circle"></i></a>
                                    @if (!string.IsNullOrWhiteSpace(image.CandidateBatchId))
                                    {
                                        <a class="btn btn-sm btn-outline-info" href="/review-deck/asset/@image.CandidateBatchId" title="Review candidate batch"><i class="bi bi-collection-play"></i></a>
                                    }
                                    <a class="btn btn-sm btn-outline-secondary" href="/asset-studio/images/@image.Id/download" title="Download image"><i class="bi bi-download"></i></a>
                                    <button type="button" class="btn btn-sm btn-outline-warning" disabled="@_busy"
                                            title="Load the prompt, model, size, seed and references that made this image into the generator above"
                                            @onclick="() => LoadIntoGenerator(image)">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                    @* Deliberately NOT next to the delete button's meaning: this one is reversible and
                                       is the step that makes the delete legal, so it says what it does rather than
                                       borrowing the trash icon. *@
                                    @if (image.ProductionApprovalStatus == SceneAssetProductionApprovalStatus.Approved)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-dark" disabled="@_busy"
                                                title="Take this image out of production: it stops being offered as a reference, and deleting it then works"
                                                @onclick="() => RevokeApprovalAsync(image)">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                            title="Delete this image" @onclick="() => DeleteImageAsync(image)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                @* A failed or still-running attempt is deletable too: the operator's way of cleaning up a
                                   bad generation must not depend on it having succeeded. *@
                                <div class="card-footer d-flex gap-1 justify-content-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                            title="Delete this image" @onclick="() => DeleteImageAsync(image)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </article>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string? AssetId { get; set; }

    /// <summary>
    /// An image whose recorded settings this page should load into the generator as soon as it is open (B-140 FR-12).
    ///
    /// <para>
    /// Carried as a query parameter so the REVIEW page — where an operator decides an image is worth reproducing — can
    /// hand the round-trip over in one click, instead of making them go back to the asset, find the same thumbnail and
    /// press the same button. The load itself is the page's existing one, so there is a single implementation of
    /// "restore what made this image".
    /// </para>
    /// </summary>
    [SupplyParameterFromQuery(Name = "loadImageId")] public string? LoadImageId { get; set; }

    private SceneAsset? _asset;
    private List<SceneAssetImage> _images = [];
    private bool _busy;
    private string? _message;

    /// <summary>The name being typed. A DRAFT, not the stored name: nothing is written until Save, so a half-typed name
    /// never reaches the row that a run report or a container link is already showing.</summary>
    private string _nameDraft = string.Empty;

    /// <summary>
    /// Whether the delete button has been pressed once. Two steps rather than one: a container and every image in it go
    /// together, so the confirmation is an act of its own rather than a click that can be made by accident.
    /// </summary>
    private bool _deleteArmed;

    private string? _containerMessage;
    private string? _containerError;

    /// <summary>Which asset the name box was seeded from, so a reload of the SAME asset leaves it alone.</summary>
    private string? _nameDraftAssetId;

    /// <summary>Save is offered only for a name that differs from the stored one, so a no-op write cannot be queued.</summary>
    private bool CanRename => _asset is not null
        && !string.IsNullOrWhiteSpace(_nameDraft)
        && !string.Equals(_nameDraft.Trim(), _asset.Name, StringComparison.Ordinal);

    private async Task RenameAsync()
    {
        if (_asset is null)
        {
            return;
        }

        _busy = true;
        _containerError = null;
        _containerMessage = null;
        try
        {
            var renamed = await AssetService.RenameAssetAsync(_asset.Id, _nameDraft);
            _containerMessage = $"Renamed to '{renamed.Name}'.";
            _nameDraft = renamed.Name;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _containerError = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Deletes this container and everything in it, then returns to the Asset Manager. The refusal cases - an approved
    /// production asset, a LoRA dataset member, an identity pack - come back in the service's own words and are shown
    /// where the button was, because a delete that silently did nothing would read as a delete that worked.
    /// </summary>
    private async Task DeleteContainerAsync()
    {
        if (_asset is null)
        {
            return;
        }

        _busy = true;
        _containerError = null;
        _containerMessage = null;
        try
        {
            await AssetService.DeleteAssetAsync(_asset.Id);
            Navigation.NavigateTo("/asset-studio");
        }
        catch (Exception exception)
        {
            _containerError = exception.Message;
            _deleteArmed = false;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// The image whose own recorded settings have been loaded into the generate panel above, or null until one is.
    /// Held on the page rather than in the panel so the panel stays a plain surface that a parent can seed.
    /// </summary>
    private DreamGenClone.Web.Application.RolePlay.ImageStep.ImageGenerationDraft? _draft;

    /// <summary>
    /// Loads one image's own settings back into the generator: the prompt it rendered, the model, the size, the seed
    /// and the references it carried.
    ///
    /// <para>
    /// Read from the image ROW, not from its queue payload: a completed job's payload is gone, and for an image that
    /// succeeded the row is the authoritative record of how it was made. Nothing is invented for a field the row never
    /// recorded - the panel names what it could not restore instead.
    /// </para>
    /// </summary>
    private void LoadIntoGenerator(SceneAssetImage image)
    {
        _draft = DreamGenClone.Web.Application.RolePlay.ImageStep.ImageGenerationDraft.FromImage(image);
        _autoLoadedImageId = image.Id;
        _message = _draft.HasAnythingToLoad
            ? $"Loaded image {image.Id[..Math.Min(8, image.Id.Length)]}… into the generator."
            : $"Image {image.Id[..Math.Min(8, image.Id.Length)]}… recorded nothing that can be loaded.";
    }

    /// <summary>
    /// The image a query-parameter load already applied, so the page's polling reload does not re-apply it and stomp on
    /// edits the operator has since made in the generator.
    /// </summary>
    private string? _autoLoadedImageId;

    /// <summary>
    /// Applies the <c>loadImageId</c> request once, when the named image is actually among this asset's images. An id
    /// that is not (a stale link, an image deleted since) loads nothing and is not silently reported as loaded.
    /// </summary>
    private void ApplyRequestedDraftLoad()
    {
        if (string.IsNullOrWhiteSpace(LoadImageId)
            || string.Equals(_autoLoadedImageId, LoadImageId, StringComparison.Ordinal))
        {
            return;
        }

        if (_images.FirstOrDefault(image => string.Equals(image.Id, LoadImageId, StringComparison.Ordinal)) is { } image)
        {
            LoadIntoGenerator(image);
        }
    }

    /// <summary>
    /// Deletes one image. The service refuses an image that is IN USE as a reference image, and its message is shown
    /// verbatim: "stop using it first" is an instruction the operator can act on, and inventing a nicer sentence here
    /// would be a second, drifting copy of the rule.
    /// </summary>
    /// <summary>
    /// Names one image, or renames it. The name is the operator's label for THIS picture and what a reference picker
    /// shows, so it is written through its own writer rather than through any image save.
    ///
    /// <para>
    /// A blank name is refused by the service and its own words are shown: clearing the box is an instruction the
    /// operator can act on ("a name is required"), and inventing a nicer sentence here would be a second, drifting
    /// copy of the rule. The reload then puts the stored value back in the box, so the card always shows what is
    /// actually recorded.
    /// </para>
    /// </summary>
    private async Task RenameImageAsync(SceneAssetImage image, string? name)
    {
        _busy = true;
        _message = null;
        try
        {
            var named = await AssetService.SetImageDisplayNameAsync(image.Id, name ?? string.Empty);
            _message = $"This image is named '{named.DisplayName}'.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteImageAsync(SceneAssetImage image)
    {
        _busy = true;
        _message = null;
        try
        {
            await AssetService.DeleteImageAsync(image.Id);
            _message = $"Deleted image {image.Id[..Math.Min(8, image.Id.Length)]}…";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Takes an approved image back out of production.
    ///
    /// <para>
    /// This is the step the delete's refusal tells the operator to take, so it has to exist somewhere they can reach:
    /// while the image is approved the pickers offer it as a reference and <c>DeleteImageAsync</c> refuses. Nothing is
    /// destroyed here — the approval is what is withdrawn, and it can be given again from the review page.
    /// </para>
    /// </summary>
    private async Task RevokeApprovalAsync(SceneAssetImage image)
    {
        _busy = true;
        _message = null;
        try
        {
            var revoked = await AssetService.RevokeImageApprovalAsync(image.Id);
            var label = revoked.DisplayName is { Length: > 0 } name
                ? name
                : revoked.Id[..Math.Min(8, revoked.Id.Length)];
            _message = $"Took '{label}' out of production. It is no longer offered as a reference, so it can be deleted now.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private System.Threading.Timer? _timer;
    private readonly object _timerLock = new();

    protected override async Task OnParametersSetAsync()
    {
        // The poll is started by the load itself, so every path that loads the list - opening the page, generating,
        // renaming, deleting - reconciles it. See LoadAsync.
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _asset = string.IsNullOrWhiteSpace(AssetId)
            ? null
            : await AssetService.GetAssetAsync(AssetId!);
        _images = _asset is null
            ? []
            : (await AssetService.ListImagesAsync(_asset.Id)).ToList();

        // After the image list is loaded, so a request to load one image's settings can be honoured for THIS asset.
        ApplyRequestedDraftLoad();

        // Seeded ONCE per asset, not on every load. This page polls while an image is pending, and a poll that
        // re-seeded the box would delete a name the operator was halfway through typing.
        if (!string.Equals(_nameDraftAssetId, AssetId, StringComparison.Ordinal))
        {
            _nameDraftAssetId = AssetId;
            _nameDraft = _asset?.Name ?? string.Empty;
        }

        StateHasChanged();

        // THIS is what makes the Images list update on its own. Blazor re-renders a poll-driven load only because the
        // load renders; and the poll has to be reconciled HERE, on the load path, because the image that is pending is
        // usually asked for from this very page (it arrives through ImagesChanged, after the page opened). Starting it
        // only when the page was first shown left a finished render — and the "Processing..." badge — stuck until the
        // operator reloaded the screen by hand. Same rule as CharacterWardrobePanel.
        EnsurePolling();
    }

    /// <summary>
    /// The character this asset belongs to, when it belongs to one. The asset creator declares its per-character
    /// element slots from this, because a character slot must name its character; an asset with no character simply
    /// has no such slots rather than rendering one that addresses nobody.
    /// </summary>
    private ImageStepActor? SubjectActor() => string.IsNullOrWhiteSpace(_asset?.CharacterProfileId)
        ? null
        : new ImageStepActor(_asset.CharacterProfileId, _asset.Name);

    private void EnsurePolling()
    {
        lock (_timerLock)
        {
            if (_timer is not null) return;
            if (_asset is null || !_images.Any(image => image.Status == SceneAssetStatus.Pending))
            {
                return;
            }

            _timer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    // Marshalled onto the dispatcher because a System.Threading.Timer callback runs on a threadpool
                    // thread, and GUARDED because this lambda is async void: an exception escaping one of those is
                    // unhandled and can take the process down. Same guard as the Asset Manager's own poll.
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        if (_asset is null || !_images.Any(image => image.Status == SceneAssetStatus.Pending))
                        {
                            StopPolling();
                        }
                    });
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Asset image list polling reload failed.");
                }
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        }
    }

    private static string StatusBadge(SceneAssetStatus status) => status switch
    {
        SceneAssetStatus.Complete => "text-bg-success",
        SceneAssetStatus.Failed => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    /// <summary>The native gates measured on this image (B-135 P3), or empty when none ran.</summary>
    private static IReadOnlyList<ImageGateResult> GateResults(SceneAssetImage image) =>
        ImageGateResults.Read(image.GateResultsJson);

    private void StopPolling()
    {
        lock (_timerLock)
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}
