@page "/roleplay/create"
@rendermode InteractiveServer

@using DreamGenClone.Application.Templates
@using DreamGenClone.Application.StoryAnalysis
@using DreamGenClone.Application.StoryAnalysis.Abstractions
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.Templates
@using DreamGenClone.Domain.StoryAnalysis
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.Scenarios

@inject IRolePlayEngineService RolePlayEngine
@inject IScenarioService ScenarioService
@inject ITemplateService TemplateService
@inject IRPThemeService RPThemeService
@inject ICharacterProfileService CharacterProfileService
@inject NavigationManager Navigation
@inject ILogger<RolePlayCreate> Logger

<PageTitle>Create Role-Play Session</PageTitle>

<div class="container-fluid mt-4">
    <h1>Create Role-Play Session</h1>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-danger">@_statusMessage</div>
    }

    <!-- Step indicator -->
    <div class="d-flex align-items-center mb-4 gap-2 flex-wrap">
        <span class="badge @(_currentStep == 1 ? "bg-primary" : _currentStep > 1 ? "bg-success" : "bg-secondary") fs-6 px-3 py-2">1 — Scenario</span>
        <span class="text-muted">›</span>
        <span class="badge @(_currentStep == 2 ? "bg-primary" : _currentStep > 2 ? "bg-success" : "bg-secondary") fs-6 px-3 py-2">2 — Themes</span>
        <span class="text-muted">›</span>
        <span class="badge @(_currentStep == 3 ? "bg-primary" : "bg-secondary") fs-6 px-3 py-2">3 — Persona &amp; Profiles</span>
    </div>

    <!-- ═══════════════════════════════════════════════════ STEP 1 ══ -->
    @if (_currentStep == 1)
    {
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Step 1 — Scenario</h5></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Scenario <span class="text-danger">*</span></label>
                        <select class="form-select" value="@_newSessionScenarioId" @onchange="OnScenarioSelected">
                            <option value="">(select a scenario)</option>
                            @foreach (var s in _scenarios)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        <div class="form-text">Required — drives the theme catalog and character defaults.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Session Title</label>
                        <input class="form-control" @bind="_newSessionTitle" placeholder="Role-Play Session" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Max milestones to inject <span class="text-muted">(optional)</span></label>
                        <input type="number" class="form-control" min="0" max="100" placeholder="Global default"
                               value="@_maxMilestonesToInject"
                               @onchange="@(e => _maxMilestonesToInject = int.TryParse(e.Value?.ToString(), out var v) ? v : null)" />
                        <div class="form-text">Overrides the global MaxMilestonesToInject default for this session. Leave blank to use global default.</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════ STEP 2 ══ -->
    @if (_currentStep == 2)
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Step 2 — Themes</h5>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ResetThemeSelectionsToScenarioDefaultsAsync">Use Scenario Defaults</button>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Check the themes to include. Scenario profile themes are pre-selected with their assigned tier.
                    Themes you add from outside the profile default to <em>Nice to Have</em>.
                    Unchecked themes are not seeded into the adaptive tracker.
                </p>
                @{
                    var grouped = _allThemes
                        .GroupBy(t => string.IsNullOrWhiteSpace(t.Category) ? "Uncategorized" : t.Category)
                        .OrderBy(g => g.Key);
                }
                <div style="max-height: 520px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
                    @foreach (var group in grouped)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold text-secondary small text-uppercase mb-1 border-bottom pb-1">@group.Key</div>
                            @foreach (var theme in group.OrderBy(t => t.Label))
                            {
                                if (!_themeSelections.TryGetValue(theme.Id, out var sel))
                                {
                                    sel = new ThemeSelectionState { ThemeName = theme.Label, Category = theme.Category ?? string.Empty };
                                    _themeSelections[theme.Id] = sel;
                                }
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <input type="checkbox"
                                           class="form-check-input mt-0"
                                           checked="@sel.IsSelected"
                                           @onchange="@(e => SetThemeSelected(theme.Id, theme.Label, (bool)(e.Value ?? false)))" />
                                    <span style="min-width: 200px; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@theme.Label">@theme.Label</span>
                                    @if (sel.IsSelected)
                                    {
                                        <select class="form-select form-select-sm" style="max-width: 175px;"
                                                value="@sel.Tier.ToString()"
                                                @onchange="@(e => SetThemeTier(theme.Id, e.Value?.ToString()))">
                                            @foreach (var opt in TierOptions)
                                            {
                                                <option value="@opt.Value">@opt.Label</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="text-muted small" style="min-width: 175px;">—</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="mt-2 text-muted small">@(_themeSelections.Values.Count(x => x.IsSelected)) theme(s) selected.</div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════ STEP 3 ══ -->
    @if (_currentStep == 3)
    {
        <!-- Persona card -->
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">Session Persona</h5></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Character</label>
                    <select class="form-select" @bind="_selectedPersonaCharacterId">
                        <option value="">(default from scenario)</option>
                        @if (_selectedScenario is not null)
                        {
                            @foreach (var c in _selectedScenario.Characters.Where(c => !string.IsNullOrWhiteSpace(c.Name)))
                            {
                                <option value="@c.Id" selected="@(c.Id == _selectedScenario.DefaultPersonaCharacterId)">
                                    @c.Name @(c.Id == _selectedScenario.DefaultPersonaCharacterId ? "(default)" : "")
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Character stat overrides -->
        @foreach (var cs in _characterEditStates)
        {
            <div class="rw-collapsible-section mb-2">
                <button type="button" class="rw-collapsible-header" @onclick="@(() => cs.IsExpanded = !cs.IsExpanded)">
                    <span class="rw-collapsible-chevron @(cs.IsExpanded ? "is-open" : "")"></span>
                    <span class="rw-collapsible-title">
                        @cs.CharacterName
                        <span style="text-transform: none; letter-spacing: normal; font-size: 12px; font-weight: 400; color: #999;">(@cs.Gender / @cs.Role)</span>
                    </span>
                </button>
                @if (cs.IsExpanded)
                {
                    <div class="rw-collapsible-body">
                        <div class="mb-1">
                            <label class="form-label fw-semibold mb-1">Stat Profile <span class="text-danger">*</span></label>
                            <select class="form-select @(_showStep3Validation && string.IsNullOrWhiteSpace(cs.SelectedStatProfileId) ? "is-invalid" : "")"
                                    value="@cs.SelectedStatProfileId"
                                    @onchange="@(e => OnCharacterStatProfileChanged(cs, e.Value?.ToString()))">
                                <option value="">(select a profile)</option>
                                @foreach (var p in GetApplicableCharacterProfiles(cs.Role))
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                            @if (_showStep3Validation && string.IsNullOrWhiteSpace(cs.SelectedStatProfileId))
                            {
                                <div class="invalid-feedback d-block">A stat profile is required.</div>
                            }
                        </div>

                        @if (cs.SelectedProfile is not null)
                        {
                            <div class="mt-2 border rounded p-2 bg-dark text-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold">Profile Details — @cs.SelectedProfile.Name</span>
                                </div>
                                <ProfileDetailDisplay Profile="@cs.SelectedProfile"
                                                      State="@cs.ProfileDetailState" />
                            </div>
                        }
                    </div>
                }
            </div>
        }

    }

    <!-- Navigation buttons -->
    <div class="d-flex gap-2 mt-3">
        @if (_currentStep > 1)
        {
            <button class="btn btn-outline-secondary" @onclick="GoBack">Back</button>
        }
        @if (_currentStep < 3)
        {
            <button class="btn btn-primary" @onclick="GoNextAsync" disabled="@(!CanGoNext)">Next</button>
        }
        else
        {
            <div class="border rounded p-2 mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="autoCompleteCheck" @bind="_autoCompleteEnabled" />
                    <label class="form-check-label" for="autoCompleteCheck">Auto-complete after session creation</label>
                </div>
                @if (_autoCompleteEnabled)
                {
                    <div class="mt-2">
                        <label class="form-label small">Max Turns</label>
                        <input type="number" class="form-control form-control-sm" style="width:100px" min="1" step="1" @bind="_autoCompleteMaxTurns" />
                    </div>
                }
            </div>
            <button class="btn btn-success" @onclick="CreateSessionAsync" disabled="@_isCreating">
                @(_isCreating ? "Creating…" : "Create Session")
            </button>
        }
        <button class="btn btn-outline-secondary" @onclick="GoToSavedSessions">Cancel</button>
    </div>
</div>

@code {
    // ── Helper types ───────────────────────────────────────────────

    private sealed class ThemeSelectionState
    {
        public bool IsSelected { get; set; }
        public RPThemeTier Tier { get; set; } = RPThemeTier.NiceToHave;
        public string ThemeName { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
    }

    private sealed class CharacterEditState
    {
        public string CharacterId { get; set; } = string.Empty;
        public string CharacterName { get; set; } = string.Empty;
        public string Gender { get; set; } = "Unknown";
        public string Role { get; set; } = "Unknown";
        public Dictionary<string, int> Stats { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public string SelectedStatProfileId { get; set; } = string.Empty;
        public bool IsExpanded { get; set; } = true;
        public CharacterProfile? SelectedProfile { get; set; }
        public ProfileDetailCollapseState ProfileDetailState { get; set; } = new();
    }

    private static readonly (string Label, string Value)[] TierOptions =
    [
        ("Must Have",        nameof(RPThemeTier.MustHave)),
        ("Strongly Prefer",  nameof(RPThemeTier.StronglyPrefer)),
        ("Nice to Have",     nameof(RPThemeTier.NiceToHave)),
        ("Neutral",          nameof(RPThemeTier.Neutral)),
        ("Discouraged",      nameof(RPThemeTier.Discouraged)),
    ];

    // ── Wizard state ───────────────────────────────────────────────

    private int _currentStep = 1;
    private bool _isCreating;
    private string _statusMessage = string.Empty;

    // Step 1
    private string _newSessionTitle = "Role-Play Session";
    private string _newSessionScenarioId = string.Empty;
    private int? _maxMilestonesToInject;
    private readonly List<Scenario> _scenarios = [];

    private void OnScenarioSelected(ChangeEventArgs e)
    {
        _newSessionScenarioId = e.Value?.ToString() ?? string.Empty;
        var selected = _scenarios.FirstOrDefault(s => s.Id == _newSessionScenarioId);
        if (selected is not null) _newSessionTitle = selected.Name ?? string.Empty;

        // Reset step data if scenario changes, so new scenario data is loaded
        if (_step2DataLoaded || _step3DataLoaded)
        {
            _step2DataLoaded = false;
            _step3DataLoaded = false;
        }
    }

    // Step 2
    private Scenario? _selectedScenario;
    private readonly List<RPTheme> _allThemes = [];
    private readonly Dictionary<string, ThemeSelectionState> _themeSelections = new(StringComparer.OrdinalIgnoreCase);

    // Step 3
    private string _personaName = "You";
    private string? _selectedPersonaCharacterId;
    private string _personaDescription = string.Empty;
    private readonly List<CharacterEditState> _characterEditStates = [];
    private readonly List<CharacterProfile> _characterProfiles = [];
    private readonly Dictionary<string, string> _characterEncounterProfileIds = new(StringComparer.OrdinalIgnoreCase);

    // Auto-Complete
    private bool _autoCompleteEnabled;
    private int _autoCompleteMaxTurns = 50;

    private bool _showStep3Validation;

    // Track whether each step's data has been loaded to preserve user changes
    private bool _step2DataLoaded;
    private bool _step3DataLoaded;

    private bool CanGoNext => _currentStep == 1
        ? !string.IsNullOrWhiteSpace(_newSessionScenarioId)
        : true;

    // ── Lifecycle ──────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _scenarios.Clear();
        _scenarios.AddRange(await ScenarioService.GetAllScenariosAsync());
    }

    // ── Navigation ─────────────────────────────────────────────────

    private void GoBack()
    {
        _statusMessage = string.Empty;
        _currentStep--;
    }

    private async Task GoNextAsync()
    {
        _statusMessage = string.Empty;
        if (_currentStep == 1 && !_step2DataLoaded)
        {
            await LoadStep2DataAsync();
            _step2DataLoaded = true;
        }
        else if (_currentStep == 2 && !_step3DataLoaded)
        {
            await LoadStep3DataAsync();
            _step3DataLoaded = true;
        }
        _currentStep++;
    }

    // ── Step 2 loading ─────────────────────────────────────────────

    private async Task LoadStep2DataAsync()
    {
        _selectedScenario = await ScenarioService.GetScenarioAsync(_newSessionScenarioId);

        // Initialize persona character from scenario default
        _selectedPersonaCharacterId = _selectedScenario?.DefaultPersonaCharacterId;
        if (_selectedPersonaCharacterId is not null && _selectedScenario is not null)
        {
            var defaultPersona = _selectedScenario.Characters
                .FirstOrDefault(c => c.Id == _selectedPersonaCharacterId);
            if (defaultPersona is not null && !string.IsNullOrWhiteSpace(defaultPersona.Name))
                _personaName = defaultPersona.Name.Trim();
        }

        _allThemes.Clear();
        _allThemes.AddRange(await RPThemeService.ListThemesAsync(includeDisabled: false));

        _themeSelections.Clear();
        foreach (var t in _allThemes)
        {
            _themeSelections[t.Id] = new ThemeSelectionState
            {
                ThemeName = t.Label,
                Category = t.Category ?? string.Empty,
            };
        }

        await ApplyScenarioProfilePreselectAsync();
    }

    private async Task ApplyScenarioProfilePreselectAsync()
    {
        if (_selectedScenario is null || string.IsNullOrWhiteSpace(_selectedScenario.DefaultRPThemeProfileId))
        {
            return;
        }

        var assignments = await RPThemeService.ListProfileAssignmentsAsync(_selectedScenario.DefaultRPThemeProfileId);
        foreach (var a in assignments.Where(x => x.IsEnabled))
        {
            if (_themeSelections.TryGetValue(a.ThemeId, out var sel))
            {
                sel.IsSelected = true;
                sel.Tier = a.Tier;
            }
        }
    }

    private async Task ResetThemeSelectionsToScenarioDefaultsAsync()
    {
        foreach (var sel in _themeSelections.Values)
        {
            sel.IsSelected = false;
            sel.Tier = RPThemeTier.NiceToHave;
        }
        await ApplyScenarioProfilePreselectAsync();
    }

    private void SetThemeSelected(string themeId, string themeName, bool isSelected)
    {
        if (!_themeSelections.TryGetValue(themeId, out var sel))
        {
            sel = new ThemeSelectionState { ThemeName = themeName };
            _themeSelections[themeId] = sel;
        }
        sel.IsSelected = isSelected;
    }

    private void SetThemeTier(string themeId, string? tierStr)
    {
        if (!_themeSelections.TryGetValue(themeId, out var sel))
        {
            return;
        }
        if (Enum.TryParse<RPThemeTier>(tierStr, out var tier))
        {
            sel.Tier = tier;
        }
    }

    // ── Step 3 loading ─────────────────────────────────────────────

    private async Task LoadStep3DataAsync()
    {
        _characterProfiles.Clear();
        _characterProfiles.AddRange(await CharacterProfileService.GetAllAsync());
        _characterEncounterProfileIds.Clear();

        _characterEditStates.Clear();
        if (_selectedScenario is null)
        {
            return;
        }

        var resolvedBaseStats = AdaptiveStatCatalog.NormalizePartial(_selectedScenario.ResolvedBaseStats);

        foreach (var character in _selectedScenario.Characters.Where(c => !string.IsNullOrWhiteSpace(c.Name)))
        {
            var mergedStats = new Dictionary<string, int>(resolvedBaseStats, StringComparer.OrdinalIgnoreCase);
            var charOverrides = AdaptiveStatCatalog.NormalizePartial(character.BaseStats);
            foreach (var (k, v) in charOverrides)
            {
                mergedStats[k] = v;
            }
            // Ensure all canonical stats present
            foreach (var statName in AdaptiveStatCatalog.CanonicalStatNames)
            {
                mergedStats.TryAdd(statName, AdaptiveStatCatalog.DefaultValue);
            }

            var editState = new CharacterEditState
            {
                CharacterId = character.Id,
                CharacterName = character.Name!.Trim(),
                Gender = character.Gender,
                Role = character.Role,
                Stats = mergedStats,
                SelectedStatProfileId = character.DefaultEncounterProfileId ?? string.Empty,
            };
            
            // Apply the selected profile to load profile details and stats
            if (!string.IsNullOrWhiteSpace(editState.SelectedStatProfileId))
            {
                ApplyCharacterStatProfile(editState);
            }
            
            _characterEditStates.Add(editState);
        }
    }

    private void OnCharacterStatProfileChanged(CharacterEditState cs, string? profileId)
    {
        cs.SelectedStatProfileId = profileId ?? string.Empty;
        cs.SelectedProfile = null;
        ApplyCharacterStatProfile(cs);
    }

    // ── Character stat helpers ─────────────────────────────────────

    private void ApplyCharacterStatProfile(CharacterEditState cs)
    {
        if (string.IsNullOrWhiteSpace(cs.SelectedStatProfileId))
        {
            cs.SelectedProfile = null;
            return;
        }

        var profile = _characterProfiles.FirstOrDefault(p =>
            string.Equals(p.Id, cs.SelectedStatProfileId, StringComparison.OrdinalIgnoreCase)
            && CharacterRoleCatalog.IsProfileApplicableToCharacter(p.TargetRole, cs.Role));

        if (profile is null)
        {
            cs.SelectedProfile = null;
            return;
        }

        var normalized = AdaptiveStatCatalog.NormalizeComplete(profile.CharacterStats);
        foreach (var (k, v) in normalized)
        {
            cs.Stats[k] = v;
        }

        cs.Role = CharacterRoleCatalog.Normalize(profile.TargetRole);
        cs.SelectedProfile = profile;
        _characterEncounterProfileIds[cs.CharacterId] = profile.Id;
    }

    private IReadOnlyList<CharacterProfile> GetApplicableCharacterProfiles(string role)
    {
        return _characterProfiles
            .Where(p => CharacterRoleCatalog.IsProfileApplicableToCharacter(p.TargetRole, role))
            .ToList();
    }

    // ── Create session ─────────────────────────────────────────────

    private async Task CreateSessionAsync()
    {
        _showStep3Validation = true;
        _statusMessage = string.Empty;

        if (_characterEditStates.Any(cs => string.IsNullOrWhiteSpace(cs.SelectedStatProfileId)))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_newSessionScenarioId))
        {
            _statusMessage = "Please select a scenario in Step 1.";
            return;
        }

        _isCreating = true;
        try
        {
            var themeSelections = _themeSelections.Values.Any(x => x.IsSelected)
                ? _themeSelections
                    .Where(kvp => kvp.Value.IsSelected)
                    .Select(kvp => new SessionThemeSelection { ThemeId = kvp.Key, Tier = kvp.Value.Tier })
                    .ToList()
                : (IReadOnlyList<SessionThemeSelection>)[];

            var charStatOverrides = _characterEditStates
                .ToDictionary(
                    cs => cs.CharacterId,
                    cs => new Dictionary<string, int>(cs.Stats, StringComparer.OrdinalIgnoreCase),
                    StringComparer.OrdinalIgnoreCase);

            var personaCharName = _personaName;
            if (_selectedPersonaCharacterId is not null && _selectedScenario is not null)
            {
                var personaChar = _selectedScenario.Characters.FirstOrDefault(c => c.Id == _selectedPersonaCharacterId);
                if (personaChar is not null)
                    personaCharName = personaChar.Name?.Trim() ?? "You";
            }

            var request = new CreateRolePlaySessionRequest
            {
                Title = _newSessionTitle,
                ScenarioId = _newSessionScenarioId,
                PersonaCharacterId = _selectedPersonaCharacterId,
                PersonaName = personaCharName,
                ThemeSelections = themeSelections,
                CharacterStatOverrides = charStatOverrides,
                CharacterEncounterProfileIds = new Dictionary<string, string>(_characterEncounterProfileIds, StringComparer.OrdinalIgnoreCase),
                MaxMilestonesToInject = _maxMilestonesToInject,
            };

            var created = await RolePlayEngine.CreateSessionAsync(request);
            Logger.LogInformation("Created role-play session {SessionId} from wizard", created.Id);
            if (_autoCompleteEnabled)
            {
                Navigation.NavigateTo($"{RolePlayRoutes.GetWorkspace(created.Id)}?autocomplete={_autoCompleteMaxTurns}");
            }
            else
            {
                Navigation.NavigateTo(RolePlayRoutes.Sessions);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create role-play session from wizard");
            _statusMessage = "Could not create session. Please try again.";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void GoToSavedSessions() => Navigation.NavigateTo(RolePlayRoutes.Sessions);
}
