@page "/production-dashboard"
@rendermode InteractiveServer
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Domain.Processing
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Application.Processing
@inject IProducedImageRepository ProducedImages
@inject IDurableBackgroundJobRepository Jobs
@inject IDurableBackgroundJobQueue JobQueue

<PageTitle>Production Dashboard - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Production Dashboard</h1>
        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="LoadAsync" disabled="@_busy">Refresh</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <section class="mb-4">
        <h2 class="h5">Inbox</h2>
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-2 mb-3">
            @foreach (var status in Enum.GetValues<ProducedImageStatus>())
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body py-2">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <span class="small">@status</span>
                                <span class="badge @GetImageStatusBadgeClass(status)">@_statusCounts.GetValueOrDefault(status)</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <h3 class="h6">Needs review</h3>
        @if (_needsReview.Count == 0)
        {
            <p class="text-muted small">No undecided images.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var img in _needsReview)
                {
                    @if (!string.IsNullOrWhiteSpace(img.BatchId))
                    {
                        <a class="text-decoration-none" href="@($"/review-deck/{img.BatchId}")">
                            <div class="border rounded p-1" style="width:104px;">
                                @RenderThumbnail(img)
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="border rounded p-1" style="width:104px;">
                            @RenderThumbnail(img)
                        </div>
                    }
                }
            </div>
        }
    </section>

    <section>
        <h2 class="h5">Queue / Runs</h2>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var status in Enum.GetValues<DurableBackgroundJobStatus>())
            {
                <span class="badge @GetJobStatusBadgeClass(status)">@status: @GetJobStatusCount(status)</span>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>JobType</th>
                        <th>Lane</th>
                        <th>Status</th>
                        <th>Attempts</th>
                        <th>Error</th>
                        <th>Action</th>
                        <th>Created</th>
                        <th>Completed</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_recentJobs.Count == 0)
                    {
                        <tr>
                            <td class="text-muted" colspan="8">No recent jobs.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var job in _recentJobs)
                        {
                            <tr>
                                <td class="font-monospace small">@(string.IsNullOrWhiteSpace(job.JobType) ? "—" : job.JobType)</td>
                                <td>@job.Lane</td>
                                <td><span class="badge @GetJobStatusBadgeClass(job.Status)">@job.Status</span></td>
                                <td>Attempt @job.AttemptCount/@job.MaxAttempts</td>
                                <td class="font-monospace small text-break">@FormatError(job)</td>
                                <td>
                                    @if (job.Status == DurableBackgroundJobStatus.Staged)
                                    {
                                        <button class="btn btn-sm btn-primary" type="button" disabled="@_busy" @onclick="() => StartAsync(job.Id)">Start</button>
                                    }
                                </td>
                                <td>@job.UpdatedUtc.ToString("u")</td>
                                <td>@(job.CompletedUtc?.ToString("u") ?? "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private Dictionary<ProducedImageStatus, int> _statusCounts = new();
    private List<ProducedImage> _needsReview = [];
    private List<DurableBackgroundJob> _recentJobs = [];
    private string? _error;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var statusCounts = new Dictionary<ProducedImageStatus, int>();
            foreach (var status in Enum.GetValues<ProducedImageStatus>())
            {
                var page = await ProducedImages.QueryAsync(new ProducedImageQuery
                {
                    Status = status,
                    Take = 1
                });
                statusCounts[status] = page.TotalCount;
            }

            _statusCounts = statusCounts;
            _needsReview = (await ProducedImages.ListByStatusAsync(ProducedImageStatus.Undecided)).Take(12).ToList();
            _recentJobs = (await Jobs.ListRecentAsync(50)).ToList();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartAsync(string jobId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var started = await JobQueue.TryActivateAsync(jobId, DateTime.UtcNow);
            if (!started)
            {
                _error = "This job is no longer staged. Refresh the queue to see its current state.";
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private static RenderFragment RenderThumbnail(ProducedImage image) => builder =>
    {
        if (!string.IsNullOrWhiteSpace(image.StoragePath))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "src", $"/scene-images/{image.StoragePath}");
            builder.AddAttribute(2, "loading", "lazy");
            builder.AddAttribute(3, "class", "img-fluid");
            builder.AddAttribute(4, "style", "height:84px;width:100%;object-fit:cover;");
            builder.AddAttribute(5, "alt", $"Produced image {image.Id}");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "d-flex align-items-center justify-content-center bg-light text-muted small");
            builder.AddAttribute(2, "style", "height:84px;");
            builder.AddContent(3, "Unavailable");
            builder.CloseElement();
        }

        builder.OpenElement(6, "div");
        builder.AddAttribute(7, "class", "font-monospace small text-truncate text-muted mt-1");
        builder.AddAttribute(8, "title", image.Id);
        builder.AddContent(9, ShortId(image.Id));
        builder.CloseElement();
        builder.OpenElement(10, "div");
        builder.AddAttribute(11, "class", "font-monospace small text-truncate");
        builder.AddAttribute(12, "title", image.CostJson ?? string.Empty);
        builder.AddContent(13, string.IsNullOrWhiteSpace(image.CostJson) ? "—" : image.CostJson);
        builder.CloseElement();
    };

    private static string FormatError(DurableBackgroundJob job)
    {
        if (string.IsNullOrWhiteSpace(job.ErrorCode) && string.IsNullOrWhiteSpace(job.ErrorMessage))
        {
            return "—";
        }

        return string.Join(" / ", new[] { job.ErrorCode, job.ErrorMessage }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private int GetJobStatusCount(DurableBackgroundJobStatus status) =>
        _recentJobs.GroupBy(job => job.Status).ToDictionary(group => group.Key, group => group.Count()).GetValueOrDefault(status);

    private static string ShortId(string imageId) => imageId.Length <= 12 ? imageId : imageId[..12];

    private static string GetImageStatusBadgeClass(ProducedImageStatus status) => status switch
    {
        ProducedImageStatus.Accepted => "bg-success",
        ProducedImageStatus.Shortlisted => "bg-info text-dark",
        ProducedImageStatus.Rejected or ProducedImageStatus.Revoked => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetJobStatusBadgeClass(DurableBackgroundJobStatus status) => status switch
    {
        DurableBackgroundJobStatus.Complete => "bg-success",
        DurableBackgroundJobStatus.Failed => "bg-danger",
        DurableBackgroundJobStatus.Cancelled => "bg-secondary",
        DurableBackgroundJobStatus.RetryScheduled => "bg-warning text-dark",
        DurableBackgroundJobStatus.Processing => "bg-primary",
        _ => "bg-info text-dark"
    };
}
