@page "/asset-studio/lora-datasets/{DatasetId}/training"
@rendermode InteractiveServer

@using System.Text.Json
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Infrastructure.Models
@using DreamGenClone.Web.Application.RolePlay

@inject ICharacterLoraRepository LoraRepository
@inject ICharacterLoraTrainingService TrainingService
@inject IProviderRepository ProviderRepository
@inject ILogger<LoraDatasetTraining> Logger

<PageTitle>LoRA Training - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h4 class="mb-1">LoRA Training</h4>
            <div class="font-monospace small text-muted text-break">@DatasetId</div>
        </div>
        <a href="/asset-studio/lora-datasets/@DatasetId" class="btn btn-outline-secondary btn-sm">Back to Dataset</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert alert-info">@_status</div>
    }
    @if (!_loaded)
    {
        <div class="text-muted">Loading training workflow...</div>
    }
    else if (_dataset is null)
    {
        <div class="alert alert-warning">The requested LoRA dataset was not found.</div>
    }
    else if (_dataset.Status != CharacterLoraDatasetStatus.Frozen)
    {
        <div class="alert alert-warning">This dataset must be frozen before training can be prepared.</div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-xl-5">
                <section class="card mb-3" aria-label="Training preparation">
                    <div class="card-header"><strong>Preparation</strong></div>
                    <div class="card-body">
                        <div class="small mb-3">
                            <strong>Manifest</strong>
                            <div class="font-monospace text-break">@_dataset.ManifestSha256</div>
                        </div>
                        <label class="form-label small" for="training-profile">Qualified training profile - this IS the base model</label>
                        <select id="training-profile" class="form-select form-select-sm" disabled="@(_busy || _job is not null)" @bind="_profileId">
                            <option value="">Select a qualified profile</option>
                            @foreach (var profile in _profiles)
                            {
                                <option value="@profile.Id">@profile.BaseModelId @profile.BaseModelVersion — @profile.Name v@(profile.Version)</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(SelectedProfileSummary))
                        {
                            <div class="small mt-2">@SelectedProfileSummary</div>
                        }
                        @if (_profiles.Count > 0)
                        {
                            <div class="form-text">
                                The model is not a separate choice: a profile pairs a base model with the recipe
                                qualified for it, so picking a profile picks the model. This dataset declares family
                                @_dataset.TargetModelFamily.
                            </div>
                        }
                        @if (_profiles.Count == 0)
                        {
                            <div class="alert alert-warning small mt-2 mb-0">
                                <div>@ProfileGuidance</div>
                                <div class="mt-1">
                                    <a href="/asset-studio/lora-training-profiles">Create or qualify a profile</a>
                                    <span class="text-muted">·</span>
                                    <a href="/asset-studio/lora-datasets/@DatasetId">Retarget this dataset's family</a>
                                </div>
                            </div>
                        }
                        <button type="button" class="btn btn-primary btn-sm mt-3" disabled="@(_busy || _job is not null)" @onclick="PrepareAsync">Prepare Durable Job</button>
                    </div>
                </section>

                <section class="card mb-3" aria-label="Training provider endpoint">
                    <div class="card-header"><strong>Provider Endpoint Snapshot</strong></div>
                    <div class="card-body">
                        <label class="form-label small" for="training-provider">Enabled provider</label>
                        <select id="training-provider" class="form-select form-select-sm" value="@_providerId" @onchange="OnProviderChangedAsync">
                            <option value="">Select a provider</option>
                            @foreach (var provider in _providers)
                            {
                                <option value="@provider.Id">@provider.Name / @provider.BaseUrl</option>
                            }
                        </select>

                        <label class="form-label small mt-2" for="training-adapter">Training adapter</label>
                        <select id="training-adapter" class="form-select form-select-sm" value="@_adapterKey" @onchange="OnAdapterChangedAsync">
                            @foreach (var adapter in CharacterLoraTrainingAdapters.All)
                            {
                                <option value="@adapter.AdapterKey">@adapter.Label</option>
                            }
                        </select>
                        @if (CharacterLoraTrainingAdapters.Find(_adapterKey) is { } selected)
                        {
                            <div class="form-text">@selected.Note</div>
                            <dl class="row small mt-2 mb-0">
                                <dt class="col-sm-4">Submit / status / cancel</dt>
                                <dd class="col-sm-8 font-monospace text-break">@selected.SubmitPath · @selected.StatusPath · @selected.CancelPath</dd>
                                <dt class="col-sm-4">Seed</dt>
                                <dd class="col-sm-8">
                                    <input id="training-seed" type="number" class="form-control form-control-sm" style="max-width:12rem" @bind="_seed" />
                                    <span class="text-muted">Defaults to 1. Change it only to train a second, differently-seeded LoRA from the same job.</span>
                                </dd>
                                <dt class="col-sm-4">Artifact version</dt>
                                <dd class="col-sm-8">@_artifactVersion <span class="text-muted">(next free version for this dataset; derived, not typed)</span></dd>
                            </dl>
                        }
                    </div>
                </section>
            </div>

            <div class="col-xl-7">
                <section class="card mb-3" aria-label="Durable training job">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <strong>Durable Job</strong>
                        @if (_job is not null)
                        {
                            <span class="badge text-bg-secondary">@_job.Status</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (_job is null)
                        {
                            <div class="text-muted small">No training job has been prepared for this dataset.</div>
                        }
                        else
                        {
                            <dl class="row small mb-3">
                                <dt class="col-4">Job</dt><dd class="col-8 font-monospace text-break">@_job.Id</dd>
                                <dt class="col-4">Profile</dt><dd class="col-8 font-monospace text-break">@_job.TrainingProfileId v@_job.TrainingProfileVersion</dd>
                                <dt class="col-4">Base model</dt><dd class="col-8">@_job.BaseModelId @_job.BaseModelVersion</dd>
                                <dt class="col-4">Trainer</dt><dd class="col-8">@_job.TrainerId @_job.TrainerVersion</dd>
                            </dl>
                            <div class="d-flex flex-wrap gap-2">
                                @if (_job.Status == CharacterLoraTrainingJobStatus.Ready)
                                {
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SubmitAsync">Submit</button>
                                }
                                @if (_job.Status == CharacterLoraTrainingJobStatus.Running && LatestAttempt?.Status is CharacterLoraTrainingAttemptStatus.Submitted or CharacterLoraTrainingAttemptStatus.Running)
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="ReconcileAsync">Reconcile</button>
                                }
                                @if (_job.Status == CharacterLoraTrainingJobStatus.Running && LatestAttempt?.Status is CharacterLoraTrainingAttemptStatus.Failed or CharacterLoraTrainingAttemptStatus.Cancelled or CharacterLoraTrainingAttemptStatus.Indeterminate)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="RetryAsync">Retry As New Attempt</button>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="card" aria-label="Training attempts">
                    <div class="card-header"><strong>Attempts</strong></div>
                    @if (_attempts.Count == 0)
                    {
                        <div class="card-body text-muted small">No attempts have been created.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr><th>#</th><th>Status</th><th>Provider request</th><th>Seed</th><th>Result</th></tr></thead>
                                <tbody>
                                    @foreach (var attempt in _attempts.OrderByDescending(value => value.AttemptNumber))
                                    {
                                        <tr>
                                            <td>@attempt.AttemptNumber</td>
                                            <td><span class="badge text-bg-secondary">@attempt.Status</span></td>
                                            <td class="font-monospace small text-break">@(attempt.ProviderRequestId ?? "Not submitted")</td>
                                            <td>@attempt.Seed</td>
                                            <td class="small text-break">@(attempt.OutputFileRelativePath ?? attempt.FailureDiagnostic ?? "Pending")</td>
                                        </tr>
                                        @if (attempt.Status == CharacterLoraTrainingAttemptStatus.Succeeded)
                                        {
                                            <tr><td colspan="5" class="small"><strong>Logs</strong> @attempt.LogManifestJson<br /><strong>Samples</strong> @attempt.SampleManifestJson<br /><strong>Checkpoints</strong> @attempt.CheckpointManifestJson</td></tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section class="card mt-3" aria-label="LoRA artifact review">
                    <div class="card-header"><strong>Artifact Review</strong></div>
                    <div class="card-body">
                        @if (_artifacts.Count == 0)
                        {
                            <div class="text-muted small">A candidate artifact appears here after a training attempt succeeds.</div>
                        }
                        else
                        {
                            <label class="form-label small" for="artifact-evidence">Decision evidence JSON</label>
                            <textarea id="artifact-evidence" class="form-control form-control-sm font-monospace" rows="4" @bind="_artifactDecisionEvidenceJson"></textarea>
                            <div class="form-text mb-3">Record the frozen evaluation run, prompts, seeds, held-out cells, scores, and pass/fail result used for this decision.</div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Version</th><th>Base model</th><th>Trigger</th><th>Checksum</th><th>Status</th><th class="text-end">Decision</th></tr></thead>
                                    <tbody>
                                        @foreach (var artifact in _artifacts)
                                        {
                                            <tr>
                                                <td>v@(artifact.Version)</td>
                                                <td>@artifact.BaseModelId @artifact.BaseModelVersion</td>
                                                <td class="font-monospace">@artifact.TriggerToken</td>
                                                <td class="font-monospace small text-break">@artifact.Sha256</td>
                                                <td><span class="badge text-bg-secondary">@artifact.Status</span></td>
                                                <td class="text-end text-nowrap">
                                                    @if (artifact.Status == CharacterLoraArtifactStatus.Candidate)
                                                    {
                                                        <button type="button" class="btn btn-success btn-sm" disabled="@_busy" @onclick="() => DecideArtifactAsync(artifact.Id, CharacterLoraArtifactStatus.Qualified)">Qualify</button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="() => DecideArtifactAsync(artifact.Id, CharacterLoraArtifactStatus.Rejected)">Reject</button>
                                                    }
                                                </td>
                                            </tr>
                                            @if (!string.IsNullOrWhiteSpace(artifact.DecisionEvidenceJson))
                                            {
                                                <tr><td colspan="6" class="small"><strong>Decision evidence</strong><pre class="font-monospace text-wrap mb-0">@artifact.DecisionEvidenceJson</pre></td></tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string DatasetId { get; set; } = string.Empty;

    private CharacterLoraDataset? _dataset;
    private List<CharacterLoraTrainingProfile> _profiles = [];
    private List<string> _availableFamilies = [];
    private List<Provider> _providers = [];
    private CharacterLoraTrainingJob? _job;
    private List<CharacterLoraTrainingAttempt> _attempts = [];
    private List<CharacterLoraArtifact> _artifacts = [];
    private string _profileId = string.Empty;
    private string _providerId = string.Empty;
    private string _adapterKey = CharacterLoraTrainingAdapters.DefaultFor(null).AdapterKey;
    private long _seed = 1;
    private int _artifactVersion;
    private string _artifactDecisionEvidenceJson = string.Empty;
    private bool _busy;
    private bool _loaded;
    private string? _error;
    private string? _status;
    private CharacterLoraTrainingAttempt? LatestAttempt => _attempts.OrderBy(value => value.AttemptNumber).LastOrDefault();

    /// <summary>The profile the operator has picked, which is the pairing of a base model with its qualified recipe.</summary>
    private CharacterLoraTrainingProfile? SelectedProfile =>
        _profiles.SingleOrDefault(value => string.Equals(value.Id, _profileId, StringComparison.Ordinal));

    private string SelectedProfileSummary => SelectedProfile is { } profile
        ? $"{profile.BaseModelId} {profile.BaseModelVersion} · {profile.TargetModelFamily} · trainer {profile.TrainerId} {profile.TrainerVersion}"
        : string.Empty;

    /// <summary>
    /// What to say when this dataset cannot be trained yet. The family gate is a real refusal in the repository, so
    /// the page must not leave the operator guessing at a disabled button: it names the families that DO have a
    /// qualified profile and the two ways to close the gap.
    /// </summary>
    private string ProfileGuidance
    {
        get
        {
            if (_dataset is null)
            {
                return string.Empty;
            }

            if (_availableFamilies.Count == 0)
            {
                return "No enabled qualified training profile exists. A profile pairs a base model with the recipe "
                    + "that was qualified for it, so training needs one before a job can be prepared.";
            }

            return $"No enabled qualified profile trains family {_dataset.TargetModelFamily}. "
                + $"Families with a qualified profile: {string.Join(", ", _availableFamilies)}. "
                + $"Retarget this dataset to one of them, or qualify a profile for {_dataset.TargetModelFamily}.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
        _loaded = true;
    }

    private async Task ReloadAsync()
    {
        _dataset = await LoraRepository.GetDatasetAsync(DatasetId);
        var qualified = _dataset is null
            ? []
            : (await LoraRepository.ListTrainingProfilesAsync())
                .Where(profile => profile.Enabled && profile.Status == CharacterLoraTrainingProfileStatus.Qualified)
                .ToList();

        // Every qualified family is listed, not just the matching one, so an empty dropdown can say WHICH families
        // do have a profile instead of looking like nothing was ever built.
        _availableFamilies = qualified
            .Select(profile => profile.TargetModelFamily)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(family => family, StringComparer.Ordinal)
            .ToList();
        _profiles = qualified
            .Where(profile => string.Equals(profile.TargetModelFamily, _dataset!.TargetModelFamily, StringComparison.Ordinal))
            .OrderBy(profile => profile.BaseModelId, StringComparer.Ordinal)
            .ThenBy(profile => profile.Version)
            .ToList();
        _providers = (await ProviderRepository.GetAllAsync()).Where(provider => provider.IsEnabled).ToList();
        var jobs = await LoraRepository.ListTrainingJobsAsync(DatasetId);
        _job = jobs.LastOrDefault();
        _attempts = _job is null ? [] : (await LoraRepository.ListTrainingAttemptsAsync(_job.Id)).ToList();

        // Retry must not depend on transient form state. A reload empties the pickers, and an empty picker made
        // "Retry As New Attempt" refuse with "An enabled provider is required." even though the durable attempt already
        // records exactly where it was sent. The job and its attempt are the source, so the pickers are restored from
        // them. They stay changeable until the first submission.
        if (_job is not null)
        {
            _profileId = _job.TrainingProfileId;
            if (LatestAttempt is { } latest)
            {
                var persistedEndpoint = await TrainingService.GetPersistedEndpointAsync(latest.Id);
                if (persistedEndpoint is not null)
                {
                    _providerId = persistedEndpoint.EndpointId;
                    _adapterKey = persistedEndpoint.AdapterKey;
                }
            }
        }
        _artifacts = _dataset is null
            ? []
            : (await LoraRepository.ListArtifactsAsync(_dataset.CharacterTemplateId))
                .Where(artifact => string.Equals(artifact.DatasetId, DatasetId, StringComparison.Ordinal))
                .ToList();

        // Derived, not typed: an artifact version is an ordinal of this dataset's outputs, and picking the next free
        // one is the only value that cannot collide with an existing artifact.
        _artifactVersion = _artifacts.Count == 0 ? 1 : _artifacts.Max(artifact => artifact.Version) + 1;
    }

    private Task OnProviderChangedAsync(ChangeEventArgs args)
    {
        _providerId = args.Value?.ToString() ?? string.Empty;

        // The address says which kind of trainer this is (a runpod.net host is a serverless worker, a LAN address is
        // the local service), so the adapter is picked rather than asked for. It stays changeable.
        var provider = _providers.FirstOrDefault(value => string.Equals(value.Id, _providerId, StringComparison.Ordinal));
        _adapterKey = CharacterLoraTrainingAdapters.DefaultFor(provider?.BaseUrl).AdapterKey;
        return Task.CompletedTask;
    }

    private Task OnAdapterChangedAsync(ChangeEventArgs args)
    {
        _adapterKey = args.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task PrepareAsync()
    {
        await RunAsync(async () =>
        {
            var profile = _profiles.SingleOrDefault(value => string.Equals(value.Id, _profileId, StringComparison.Ordinal))
                ?? throw new InvalidOperationException("An enabled qualified training profile is required.");
            _job = await TrainingService.PrepareAsync(new CharacterLoraTrainingJob
            {
                DatasetId = DatasetId,
                TrainingProfileId = profile.Id,
                BaseModelId = profile.BaseModelId,
                BaseModelVersion = profile.BaseModelVersion,
                BaseModelSha256 = profile.BaseModelSha256,
                TrainerId = profile.TrainerId,
                TrainerVersion = profile.TrainerVersion,
                RecipeJson = profile.RecipeJson,
                EnvironmentManifestJson = profile.EnvironmentRequirementsJson,
                Status = CharacterLoraTrainingJobStatus.Draft,
                ConcurrencyVersion = 1,
                CreatedUtc = DateTime.UtcNow
            });
            _status = $"Prepared durable training job {_job.Id}.";
        });
    }

    private async Task SubmitAsync()
    {
        await RunAsync(async () =>
        {
            if (_job is null) throw new InvalidOperationException("A prepared training job is required.");
            await TrainingService.SubmitAsync(_job.Id, Endpoint(), _seed, _artifactVersion);
            _status = "Training submitted and provider request ID persisted.";
        });
    }

    private async Task ReconcileAsync()
    {
        await RunAsync(async () =>
        {
            var attempt = LatestAttempt ?? throw new InvalidOperationException("A submitted training attempt is required.");
            await TrainingService.ReconcileAsync(attempt.Id);
            _status = "Training attempt reconciled from its persisted provider request.";
        });
    }

    private async Task RetryAsync()
    {
        await RunAsync(async () =>
        {
            if (_job is null) throw new InvalidOperationException("A running training job is required.");
            await TrainingService.RetryAsync(_job.Id, Endpoint(), _seed, _artifactVersion);
            _status = "Retry submitted as a new durable attempt.";
        });
    }

    private async Task DecideArtifactAsync(string artifactId, CharacterLoraArtifactStatus status)
    {
        await RunAsync(async () =>
        {
            using var evidence = JsonDocument.Parse(_artifactDecisionEvidenceJson);
            if (evidence.RootElement.ValueKind != JsonValueKind.Object)
                throw new InvalidOperationException("Artifact decision evidence must be a JSON object.");
            await LoraRepository.SetArtifactStatusAsync(
                artifactId, status, evidence.RootElement.GetRawText(), DateTime.UtcNow);
            _status = $"Artifact {artifactId} marked {status}.";
        });
    }

    private CharacterLoraTrainingEndpoint Endpoint()
    {
        var provider = _providers.SingleOrDefault(value => string.Equals(value.Id, _providerId, StringComparison.Ordinal))
            ?? throw new InvalidOperationException("An enabled provider is required.");
        var adapter = CharacterLoraTrainingAdapters.Find(_adapterKey)
            ?? throw new InvalidOperationException(
                $"'{_adapterKey}' is not a training adapter this app can dispatch to. Pick one from the list.");
        return new CharacterLoraTrainingEndpoint(
            adapter.AdapterKey, provider.Name, provider.Id, provider.BaseUrl,
            adapter.SubmitPath, adapter.StatusPath, adapter.CancelPath, provider.TimeoutSeconds);
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _status = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            Logger.LogWarning(exception, "LoRA training operation failed.");
            await ReloadAsync();
        }
        finally { _busy = false; }
    }
}