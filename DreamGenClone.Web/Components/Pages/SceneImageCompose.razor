@page "/roleplay/studio/{sessionId}/{interactionId}/compose/{productionGroupId}"
@rendermode InteractiveServer

@inject NavigationManager Nav

@* This route is a redirect ALIAS for the Moment's production workspace (B-130). It deliberately declares no model
   resolution, image service or strategy resolver: the composer in the production workspace owns the step, and this
   page owns nothing but the forward. *@

<PageTitle>Compose Moment Image - DreamGenClone</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <div>
            <a class="btn btn-sm btn-outline-secondary" href="/roleplay/studio/@sessionId/@interactionId">
                <i class="bi bi-arrow-left me-1"></i>Back to Moment chain
            </a>
            <h4 class="d-inline-block ms-2 mb-0">Compose moment image</h4>
        </div>
    </div>

    @* B-130: this route is an ALIAS, and the layout that used to sit here was unreachable. Every parameter set
       redirects to the production workspace (see OnParametersSetAsync), and nothing on this page ever loaded the
       production group it displayed - so its model select, prompt box, identity block, compose button and attempts
       list could never be operated by anyone. It was a seventh copy of one layout, drifting away from the other
       six (its own summary panel claimed an IP-Adapter strategy for models that carry identity natively).

       The copy is DELETED rather than migrated: there is one composer, and this route points at it. The route
       stays because existing links and the browser back-stack use it. *@
    <div class="alert alert-secondary" role="status">
        <i class="bi bi-arrow-right me-1"></i>Taking you to the production workspace for this Moment...
    </div>
</div>

@code {
    [Parameter] public string sessionId { get; set; } = string.Empty;
    [Parameter] public string interactionId { get; set; } = string.Empty;
    [Parameter] public string productionGroupId { get; set; } = string.Empty;

    /// <summary>
    /// This route exists only to forward to the production workspace, which owns the composition step and presents it
    /// through the one composer. Everything else that used to live here - loading the group, resolving identity
    /// readiness, generating a prompt, queueing a render, listing attempts - is deleted with the layout that used it:
    /// if it were kept, it would be a second, silently diverging implementation of a flow nobody can reach.
    /// </summary>
    protected override Task OnParametersSetAsync()
    {
        Nav.NavigateTo($"/roleplay/studio/{sessionId}/{interactionId}/production/{productionGroupId}", replace: true);
        return Task.CompletedTask;
    }
}