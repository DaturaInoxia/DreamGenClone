@page "/roleplay/sessions"
@rendermode InteractiveServer

@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Domain.RolePlay
@using DreamGenClone.Components.Shared
@using DreamGenClone.Web.Application.Scenarios
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Application.StoryAnalysis.Abstractions

@inject IRolePlayEngineService RolePlayEngine
@inject IScenarioService ScenarioService
@inject IRPThemeService RPThemeService
@inject ICharacterProfileService CharacterProfileService
@inject NavigationManager Navigation
@inject ILogger<RolePlaySessionsList> Logger

<PageTitle>Role-Play Saved Sessions</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Role-Play Saved Sessions</h1>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="ReloadAsync">Refresh</button>
            <button class="btn btn-primary" @onclick="GoToCreate">Create Session</button>
        </div>
    </div>
    <p class="text-muted">Start, continue, or delete sessions from this dedicated page.</p>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">@_statusMessage</div>
    }

    @if (_sessions.Count == 0)
    {
        <div class="alert alert-info">No role-play sessions saved yet. Create one to begin.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var session in _sessions)
            {
                <RolePlaySessionRow
                    Title="@session.Title"
                    StatusLabel="@session.Status.ToString()"
                    InteractionCount="@session.Interactions.Count"
                    LastUpdatedLabel='@session.ModifiedAt.ToLocalTime().ToString("g")'
                    PrimaryActionLabel='@(session.Status == RolePlaySessionStatus.NotStarted ? "Start" : "Continue")'
                    ScenarioName="@GetScenarioName(session)"
                    ThemeSummary="@GetThemeSummary(session)"
                    PersonaSummary="@GetPersonaSummary(session)"
                    CharactersSummary="@GetCharactersSummary(session)"
                    OnPrimaryAction="@(() => OpenSessionAsync(session))"
                    OnDeleteAction="@(() => AskDelete(session))" />

                @if (_pendingDeleteSessionId == session.Id)
                {
                    <div class="list-group-item bg-light border-top-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Delete <strong>@session.Title</strong>? This cannot be undone.</span>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteAsync(session.Id)">Confirm Delete</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private readonly List<RolePlaySession> _sessions = [];
    private string _statusMessage = string.Empty;
    private string? _pendingDeleteSessionId;
    private Dictionary<string, string> _scenarioNames = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> _themeLabels = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> _characterProfileNames = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var sessionsTask = RolePlayEngine.GetSessionsAsync();
        var scenariosTask = ScenarioService.GetAllScenariosAsync();
        var themesTask = RPThemeService.ListThemesAsync();
        var profilesTask = CharacterProfileService.GetAllAsync();
        await Task.WhenAll(sessionsTask, scenariosTask, themesTask, profilesTask);
        _sessions.Clear();
        _sessions.AddRange(sessionsTask.Result);
        _scenarioNames = scenariosTask.Result.ToDictionary(s => s.Id, s => s.Name, StringComparer.OrdinalIgnoreCase);
        _themeLabels = themesTask.Result.ToDictionary(t => t.Id, t => t.Label ?? string.Empty, StringComparer.OrdinalIgnoreCase);
        _characterProfileNames = profilesTask.Result.ToDictionary(p => p.Id, p => (string)(p.Name ?? string.Empty), StringComparer.OrdinalIgnoreCase);

        _statusMessage = string.Empty;
    }

    private string GetScenarioName(RolePlaySession session) =>
        string.IsNullOrEmpty(session.ScenarioId)
            ? string.Empty
            : _scenarioNames.GetValueOrDefault(session.ScenarioId, string.Empty);

    private string GetThemeSummary(RolePlaySession session)
    {
        if (session.SessionThemeSelections.Count == 0) return string.Empty;
        const int maxLabels = 3;
        var labels = session.SessionThemeSelections
            .Select(s => _themeLabels.GetValueOrDefault(s.ThemeId, string.Empty))
            .Where(l => !string.IsNullOrEmpty(l))
            .ToList();
        if (labels.Count == 0) return $"{session.SessionThemeSelections.Count} themes";
        var shown = labels.Take(maxLabels).ToList();
        var extra = labels.Count - shown.Count;
        var summary = string.Join(", ", shown);
        return extra > 0 ? $"Themes: {summary} (+{extra} more)" : $"Themes: {summary}";
    }

    private string GetPersonaSummary(RolePlaySession session)
    {
        var name = string.IsNullOrWhiteSpace(session.PersonaName) ? "You" : session.PersonaName;
        var role = string.IsNullOrWhiteSpace(session.PersonaRole) ? null : session.PersonaRole;
        // Resolve persona encounter profile name
        string? profileName = null;
        if (session.AdaptiveState.CharacterEncounterProfileIds.TryGetValue("__persona__", out var personaProfileId)
            && _characterProfileNames.TryGetValue(personaProfileId, out var pName))
        {
            profileName = pName;
        }

        var rolePart = role is not null ? $" ({role})" : string.Empty;
        var profilePart = !string.IsNullOrWhiteSpace(profileName) ? $" - {profileName}" : string.Empty;
        return $"{name}{rolePart}{profilePart}";
    }

    private string GetCharactersSummary(RolePlaySession session)
    {
        var parts = new List<string>();
        foreach (var cp in session.CharacterPerspectives)
        {
            var label = cp.CharacterName;
            // Resolve role from adaptive state
            session.AdaptiveState.CharacterRoles.TryGetValue(cp.CharacterId, out var role);
            // Resolve encounter profile name
            string? profileName = null;
            if (session.AdaptiveState.CharacterEncounterProfileIds.TryGetValue(cp.CharacterId, out var profileId)
                && _characterProfileNames.TryGetValue(profileId, out var pName))
            {
                profileName = pName;
            }

            var rolePart = !string.IsNullOrWhiteSpace(role) ? $" ({role})" : string.Empty;
            var profilePart = !string.IsNullOrWhiteSpace(profileName) ? $" - {profileName}" : string.Empty;
            parts.Add($"{label}{rolePart}{profilePart}");
        }
        return parts.Count > 0 ? string.Join(", ", parts) : string.Empty;
    }

    private async Task OpenSessionAsync(RolePlaySession session)
    {
        try
        {
            var action = session.Status == RolePlaySessionStatus.NotStarted
                ? RolePlaySessionOpenAction.Start
                : RolePlaySessionOpenAction.Continue;

            var opened = await RolePlayEngine.OpenSessionAsync(session.Id, action);
            Navigation.NavigateTo(RolePlayRoutes.GetWorkspace(opened.Id));
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Open session failed for {SessionId}", session.Id);
            _statusMessage = "That session is no longer available or cannot be opened in its current state. The list was refreshed.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Open session failed for {SessionId}", session.Id);
            _statusMessage = "Could not open session. Please refresh and try again.";
        }
    }

    private void AskDelete(RolePlaySession session)
    {
        _pendingDeleteSessionId = session.Id;
    }

    private void CancelDelete()
    {
        _pendingDeleteSessionId = null;
    }

    private async Task ConfirmDeleteAsync(string sessionId)
    {
        try
        {
            var deleted = await RolePlayEngine.DeleteSessionAsync(sessionId);
            _pendingDeleteSessionId = null;

            if (!deleted)
            {
                _statusMessage = "Session was already removed. The list was refreshed.";
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete session failed for {SessionId}", sessionId);
            _statusMessage = "Could not delete session. Please try again.";
        }
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo(RolePlayRoutes.Create);
    }
}
