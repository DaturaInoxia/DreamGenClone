@page "/asset-studio"
@rendermode InteractiveServer

@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Domain.RolePlay
@implements IAsyncDisposable

@inject ISceneAssetService AssetService
@inject ILogger<AssetStudio> Logger

<PageTitle>Asset Manager - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Asset Manager</h4>
        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <a href="/assets/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Create Asset</a>
            <a href="/characters/identity" class="btn btn-outline-primary btn-sm">Identity Packs</a>
            <a href="/asset-studio/lora-datasets/new" class="btn btn-outline-primary btn-sm">New LoRA Dataset</a>
            <a href="/asset-studio/lora-training-profiles" class="btn btn-outline-secondary btn-sm">LoRA Profiles</a>
            <a href="/" class="btn btn-outline-secondary btn-sm">Back to Home</a>
        </div>
    </div>
    <p class="text-muted small mb-3">Browse existing production assets, versions, provenance, and approval state.</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div>
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Asset Library (@_filteredAssets.Count / @_assets.Count)</strong>
                    @if (_hasInFlight)
                    {
                        <span class="text-muted small">updating…</span>
                    }
                </div>
                <div class="card-body border-bottom py-2">
                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="asset-search">Search</label>
                            <input id="asset-search" type="search" class="form-control form-control-sm"
                                   @bind="_assetSearch" @bind:event="oninput" placeholder="Name, ID, character, or pack" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small mb-1" for="asset-type-filter">Type</label>
                            <select id="asset-type-filter" class="form-select form-select-sm" @bind="_assetTypeFilter">
                                <option value="">All types</option>
                                @foreach (var type in Enum.GetValues<SceneAssetType>())
                                {
                                    <option value="@type.ToString()">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label small mb-1" for="asset-approval-filter">Approval</label>
                            <select id="asset-approval-filter" class="form-select form-select-sm" @bind="_assetApprovalFilter">
                                <option value="">All</option>
                                <option value="Unreviewed">Unreviewed</option>
                                @foreach (var status in Enum.GetValues<SceneAssetProductionApprovalStatus>())
                                {
                                    <option value="@status.ToString()">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small mb-1" for="asset-character-filter">Character</label>
                            <select id="asset-character-filter" class="form-select form-select-sm" @bind="_assetCharacterFilter">
                                <option value="">All characters</option>
                                @foreach (var option in _characterOptions)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (_filteredAssets.Count == 0)
                    {
                        <div class="p-3 text-muted">No assets match the current filters.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:56px;"></th>
                                        <th>Name</th>
                                        <th>Kind</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var asset in _filteredAssets)
                                    {
                                        <tr class="@(_selectedAssetId == asset.Id ? "table-active" : "")">
                                            <td>
                                                @if (asset.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(asset.FileRelativePath))
                                                {
                                                    <img src="/scene-images/@asset.FileRelativePath" style="width:48px;height:48px;object-fit:cover;border-radius:4px;" alt="@asset.Name" />
                                                }
                                            </td>
                                            <td>
                                                @asset.Name
                                                @if (asset.FaceView is not null)
                                                {
                                                    <span class="text-muted small d-block">@asset.FaceView</span>
                                                }
                                            </td>
                                            <td>@asset.Kind</td>
                                            <td>
                                                <span class="badge @StatusBadge(asset.Status)">@asset.Status</span>
                                                @if (asset.ProductionApprovalStatus is not null)
                                                {
                                                    <span class="badge text-bg-info d-block mt-1">@asset.ProductionApprovalStatus</span>
                                                }
                                            </td>
                                            <td class="text-nowrap">@asset.CreatedUtc.ToLocalTime().ToString("g")</td>
                                            <td class="text-end text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary" type="button" title="Preview asset"
                                                        aria-label="Preview @asset.Name" @onclick="() => SelectAsset(asset.Id)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <a class="btn btn-sm btn-outline-secondary" href="/asset-studio/@asset.Id">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            @if (_selectedAsset is not null)
            {
                <section class="card" aria-label="Selected asset inspector">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <strong class="text-truncate">@_selectedAsset.Name</strong>
                        <button class="btn btn-sm btn-outline-secondary" type="button" title="Close inspector"
                                aria-label="Close asset inspector" @onclick="ClearAssetSelection">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div class="card-body small">
                        @if (_selectedAsset.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(_selectedAsset.FileRelativePath))
                        {
                            <img src="/scene-images/@_selectedAsset.FileRelativePath" class="img-fluid mb-3"
                                 style="max-height:320px;width:100%;object-fit:contain;background:#101010;" alt="@_selectedAsset.Name" />
                        }
                        <dl class="row mb-3">
                            <dt class="col-4">Asset</dt><dd class="col-8 font-monospace text-break">@_selectedAsset.Id</dd>
                            <dt class="col-4">Type</dt><dd class="col-8">@(_selectedAsset.Type?.ToString() ?? "Unclassified")</dd>
                            <dt class="col-4">Version</dt><dd class="col-8">@(_selectedAsset.ProductionVersion?.ToString() ?? "Not approved")</dd>
                            <dt class="col-4">Character</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.CharacterProfileId ?? "Not assigned")</dd>
                            <dt class="col-4">Identity pack</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.IdentityPackId ?? "Not assigned")</dd>
                            <dt class="col-4">Source</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.SourceAssetId ?? _selectedAsset.SourceSceneImageId ?? "Original")</dd>
                            <dt class="col-4">Supersedes</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.SupersedesAssetId ?? "None")</dd>
                            <dt class="col-4">SHA-256</dt><dd class="col-8 font-monospace text-break">@_selectedAsset.Sha256</dd>
                        </dl>
                        @if (_selectedAsset.ProductionApprovalStatus is not null)
                        {
                            <h6>Production Provenance</h6>
                            <div class="font-monospace text-break mb-2">@_selectedAsset.SourceProvenanceJson</div>
                            <div><strong>Consent:</strong> @_selectedAsset.ConsentState</div>
                            <div><strong>License:</strong> @_selectedAsset.LicenseState · @_selectedAsset.LicenseLabel</div>
                            <div><strong>Use scope:</strong> @_selectedAsset.ApprovedUseScope</div>
                            <div><strong>Policy:</strong> @_selectedAsset.ContentPolicyKey</div>
                            <div class="font-monospace text-break mt-2">@_selectedAsset.CompatibilityMetadataJson</div>
                        }
                        <a class="btn btn-sm btn-outline-primary mt-2" href="/asset-studio/@_selectedAsset.Id">View asset details</a>
                    </div>
                </section>
            }
    </div>
</div>

@code {
    private sealed record CharacterOption(string Id, string Label);

    private readonly List<CharacterOption> _characterOptions = [];
    private List<SceneAsset> _assets = [];
    private string _assetSearch = string.Empty;
    private string _assetTypeFilter = string.Empty;
    private string _assetApprovalFilter = string.Empty;
    private string _assetCharacterFilter = string.Empty;
    private string? _selectedAssetId;

    private bool _hasInFlight;
    private string? _error;

    private System.Threading.Timer? _timer;
    private readonly object _timerLock = new();

    private SceneAsset? _selectedAsset => _assets.FirstOrDefault(asset => asset.Id == _selectedAssetId);

    private List<SceneAsset> _filteredAssets => _assets.Where(asset =>
        (string.IsNullOrWhiteSpace(_assetSearch)
            || asset.Name.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase)
            || asset.Id.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase)
            || (asset.CharacterProfileId?.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase) ?? false)
            || (asset.IdentityPackId?.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase) ?? false))
        && (string.IsNullOrWhiteSpace(_assetTypeFilter)
            || string.Equals(asset.Type?.ToString(), _assetTypeFilter, StringComparison.Ordinal))
        && (string.IsNullOrWhiteSpace(_assetApprovalFilter)
            || (_assetApprovalFilter == "Unreviewed" && asset.ProductionApprovalStatus is null)
            || string.Equals(asset.ProductionApprovalStatus?.ToString(), _assetApprovalFilter, StringComparison.Ordinal))
        && (string.IsNullOrWhiteSpace(_assetCharacterFilter)
            || string.Equals(asset.CharacterProfileId, _assetCharacterFilter, StringComparison.Ordinal)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAssetsAsync();
    }

    private void SelectAsset(string assetId)
    {
        _selectedAssetId = assetId;
    }

    private void ClearAssetSelection() => _selectedAssetId = null;

    private async Task ReloadAssetsAsync()
    {
        _assets = (await AssetService.ListAssetsAsync()).ToList();
        _hasInFlight = _assets.Any(a => a.Status == SceneAssetStatus.Pending);
        StateHasChanged();
    }

    private void EnsurePolling()
    {
        lock (_timerLock)
        {
            if (_timer is null)
            {
                _timer = new System.Threading.Timer(async _ =>
                {
                    try
                    {
                        // System.Threading.Timer callbacks run on a threadpool thread — StateHasChanged
                        // must be marshaled onto the Blazor Dispatcher or it throws "current thread is
                        // not associated with the Dispatcher" and can crash the whole app.
                        await InvokeAsync(async () =>
                        {
                            await ReloadAssetsAsync();
                            if (!_hasInFlight)
                            {
                                StopPolling();
                            }
                        });
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Asset Studio asset-list polling reload failed.");
                    }
                }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
            }
        }
    }

    private void StopPolling()
    {
        lock (_timerLock)
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    private static string StatusBadge(SceneAssetStatus status) => status switch
    {
        SceneAssetStatus.Pending => "bg-secondary",
        SceneAssetStatus.Complete => "bg-success",
        SceneAssetStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}
