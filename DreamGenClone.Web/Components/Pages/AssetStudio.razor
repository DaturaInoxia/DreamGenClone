@page "/asset-studio"
@rendermode InteractiveServer

@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Components.Assets
@implements IAsyncDisposable

@inject ISceneAssetService AssetService
@inject ISceneAssetTreeService AssetTree
@inject ILogger<AssetStudio> Logger

<PageTitle>Asset Manager - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Asset Manager</h4>
        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <a href="/assets/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Create Asset</a>
        </div>
    </div>
    <p class="text-muted small mb-3">Characters, locations, and other asset owners — open one to work in its studio.</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div>
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Asset Manager</strong>
                    @if (_hasInFlight)
                    {
                        <span class="text-muted small">updating…</span>
                    }
                </div>
                <div class="card-body border-bottom py-2">
                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="asset-search">Search</label>
                            <input id="asset-search" type="search" class="form-control form-control-sm"
                                   @bind="_assetSearch" @bind:event="oninput" placeholder="Name, ID, character, or pack" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small mb-1" for="asset-type-filter">Type</label>
                            <select id="asset-type-filter" class="form-select form-select-sm" @bind="_assetTypeFilter">
                                <option value="">All types</option>
                                @foreach (var type in Enum.GetValues<SceneAssetType>())
                                {
                                    <option value="@type.ToString()">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label small mb-1" for="asset-approval-filter">Approval</label>
                            <select id="asset-approval-filter" class="form-select form-select-sm" @bind="_assetApprovalFilter">
                                <option value="">All</option>
                                <option value="Unreviewed">Unreviewed</option>
                                @foreach (var status in Enum.GetValues<SceneAssetProductionApprovalStatus>())
                                {
                                    <option value="@status.ToString()">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small mb-1" for="asset-character-filter">Character</label>
                            <select id="asset-character-filter" class="form-select form-select-sm" @bind="_assetCharacterFilter">
                                <option value="">All characters</option>
                                @foreach (var option in _characterOptions)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (_filteredTree.Count == 0)
                    {
                        <div class="p-3 text-muted">No assets match the current filters.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var root in _filteredTree)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex align-items-center justify-content-between">
                                        @if (root.Owner.Href is not null)
                                        {
                                            <a class="fw-semibold text-decoration-none" href="@root.Owner.Href">@root.Owner.OwnerName</a>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">@root.Owner.OwnerName</span>
                                        }
                                        <span class="text-muted small">@root.Owner.RootKind</span>
                                    </div>
                                    @foreach (var group in root.Groups)
                                    {
                                        <div class="ms-3 mt-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="small fw-semibold">@group.Label</span>
                                                @if (group.Badge is not null)
                                                {
                                                    <span class="badge text-bg-secondary">@group.Badge</span>
                                                }
                                                <span class="text-muted small">@ItemCount(group)</span>
                                            </div>
                                            @if (group.Children.Count > 0)
                                            {
                                                <div class="ms-3 mt-1">
                                                    @foreach (var child in group.Children)
                                                    {
                                                        <div class="mt-1">
                                                            <span class="small text-muted fst-italic">@child.Label</span>
                                                            @ItemGrid(child.Items)
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                @ItemGrid(group.Items)
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (_selectedAsset is not null)
            {
                <section class="card" aria-label="Selected asset inspector">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <strong class="text-truncate">@_selectedAsset.Name</strong>
                        <button class="btn btn-sm btn-outline-secondary" type="button" title="Close inspector"
                                aria-label="Close asset inspector" @onclick="ClearAssetSelection">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div class="card-body small">
                        @if (_selectedAsset.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(_selectedAsset.FileRelativePath))
                        {
                            <img src="/scene-images/@_selectedAsset.FileRelativePath" class="img-fluid mb-3"
                                 style="max-height:320px;width:100%;object-fit:contain;background:#101010;" alt="@_selectedAsset.Name" />
                        }
                        <dl class="row mb-3">
                            <dt class="col-4">Asset</dt><dd class="col-8 font-monospace text-break">@_selectedAsset.Id</dd>
                            <dt class="col-4">Type</dt><dd class="col-8">@(_selectedAsset.Type?.ToString() ?? "Unclassified")</dd>
                            <dt class="col-4">Version</dt><dd class="col-8">@(_selectedAsset.ProductionVersion?.ToString() ?? "Not approved")</dd>
                            <dt class="col-4">Character</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.CharacterProfileId ?? "Not assigned")</dd>
                            <dt class="col-4">Identity pack</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.IdentityPackId ?? "Not assigned")</dd>
                            <dt class="col-4">Source</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.SourceAssetId ?? _selectedAsset.SourceSceneImageId ?? "Original")</dd>
                            <dt class="col-4">Supersedes</dt><dd class="col-8 font-monospace text-break">@(_selectedAsset.SupersedesAssetId ?? "None")</dd>
                            <dt class="col-4">SHA-256</dt><dd class="col-8 font-monospace text-break">@_selectedAsset.Sha256</dd>
                        </dl>
                        @if (_selectedAsset.ProductionApprovalStatus is not null)
                        {
                            <h6>Production Provenance</h6>
                            <div class="font-monospace text-break mb-2">@_selectedAsset.SourceProvenanceJson</div>
                            <div><strong>Consent:</strong> @_selectedAsset.ConsentState</div>
                            <div><strong>License:</strong> @_selectedAsset.LicenseState · @_selectedAsset.LicenseLabel</div>
                            <div><strong>Use scope:</strong> @_selectedAsset.ApprovedUseScope</div>
                            <div><strong>Policy:</strong> @_selectedAsset.ContentPolicyKey</div>
                            <div class="font-monospace text-break mt-2">@_selectedAsset.CompatibilityMetadataJson</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_selectedAsset.CandidateBatchId))
                        {
                            <a class="btn btn-sm btn-outline-info mt-2" href="/review-deck/@_selectedAsset.CandidateBatchId">
                                <i class="bi bi-collection-play me-1"></i> Review Candidate Batch
                            </a>
                        }
                        <a class="btn btn-sm btn-outline-primary mt-2" href="/asset-studio/@_selectedAsset.Id">View asset details</a>
                    </div>
                </section>
            }
    </div>
</div>

@code {
    private sealed record CharacterOption(string Id, string Label);

    private readonly List<CharacterOption> _characterOptions = [];
    private List<SceneAsset> _assets = [];
    private List<AssetTreeRoot> _tree = [];
    private string _assetSearch = string.Empty;
    private string _assetTypeFilter = string.Empty;
    private string _assetApprovalFilter = string.Empty;
    private string _assetCharacterFilter = string.Empty;
    private string? _selectedAssetId;

    private bool _hasInFlight;
    private string? _error;

    private System.Threading.Timer? _timer;
    private readonly object _timerLock = new();

    private SceneAsset? _selectedAsset => _assets.FirstOrDefault(asset => asset.Id == _selectedAssetId);

    private IReadOnlyList<AssetTreeRoot> _filteredTree => FilterTree(_tree);

    private IReadOnlyList<AssetTreeRoot> FilterTree(IReadOnlyList<AssetTreeRoot> roots)
    {
        var result = new List<AssetTreeRoot>();
        foreach (var root in roots)
        {
            if (!string.IsNullOrWhiteSpace(_assetCharacterFilter)
                && (root.Owner.RootKind != "Character" || !string.Equals(root.Owner.OwnerId, _assetCharacterFilter, StringComparison.Ordinal)))
            {
                continue;
            }

            if (root.Groups.Count == 0)
            {
                // Studio entry — keep it unless the search text rules it out.
                if (string.IsNullOrWhiteSpace(_assetSearch)
                    || root.Owner.OwnerName.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase))
                {
                    result.Add(root);
                }

                continue;
            }

            var groups = new List<AssetTreeGroup>();
            foreach (var group in root.Groups)
            {
                var children = group.Children
                    .Select(child => child with { Items = child.Items.Where(item => ItemMatches(item, root.Owner)).ToList() })
                    .Where(child => child.Items.Count > 0)
                    .ToList();
                var items = group.Items.Where(item => ItemMatches(item, root.Owner)).ToList();
                if (children.Count == 0 && items.Count == 0)
                {
                    continue;
                }

                groups.Add(group with { Children = children, Items = items });
            }

            if (groups.Count > 0)
            {
                result.Add(root with { Groups = groups });
            }
        }

        return result;
    }

    private bool ItemMatches(AssetTreeItem item, AssetTreeOwner owner)
    {
        if (!string.IsNullOrWhiteSpace(_assetSearch))
        {
            var hit = item.Name.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase)
                || item.AssetId.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase)
                || (item.CharacterProfileId?.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                || (item.IdentityPackId?.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                || owner.OwnerName.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase);
            if (!hit)
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(_assetTypeFilter)
            && !string.Equals(item.KindFilter, _assetTypeFilter, StringComparison.Ordinal))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_assetApprovalFilter))
        {
            if (_assetApprovalFilter == "Unreviewed")
            {
                if (!string.Equals(item.ApprovalFilter, "Unreviewed", StringComparison.Ordinal))
                {
                    return false;
                }
            }
            else if (!string.Equals(item.ApprovalFilter, _assetApprovalFilter, StringComparison.Ordinal))
            {
                return false;
            }
        }

        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAssetsAsync();
    }

    private void SelectAsset(string assetId)
    {
        _selectedAssetId = assetId;
    }

    private void ClearAssetSelection() => _selectedAssetId = null;

    private async Task ReloadAssetsAsync()
    {
        _assets = (await AssetService.ListAssetsAsync()).ToList();
        _tree = (await AssetTree.BuildTreeAsync()).ToList();

        _characterOptions.Clear();
        _characterOptions.AddRange(_tree
            .Where(root => root.Owner.RootKind == "Character")
            .Select(root => new CharacterOption(root.Owner.OwnerId, root.Owner.OwnerName)));

        _hasInFlight = _assets.Any(a => a.Status == SceneAssetStatus.Pending);
        StateHasChanged();
    }

    private void SelectTreeItem(AssetTreeItem item)
    {
        if (item.SourceStore == "Library")
        {
            SelectAsset(item.AssetId);
        }
    }

    private static int ItemCount(AssetTreeGroup group)
        => group.Items.Count + group.Children.Sum(child => child.Items.Count);

    private RenderFragment ItemGrid(IReadOnlyList<AssetTreeItem> items) => @<div class="d-flex flex-wrap gap-2 mt-1">
        @foreach (var item in items)
        {
            <div class="card @(item.AssetId == _selectedAssetId ? "border-primary" : "")" style="width:168px;" role="button"
                 @onclick="() => SelectTreeItem(item)">
                @if (!string.IsNullOrWhiteSpace(item.FileRelativePath))
                {
                    <img src="/scene-images/@item.FileRelativePath" class="card-img-top" style="height:110px;object-fit:cover;" alt="@item.Name" />
                }
                <div class="card-body p-1 small">
                    <div class="text-truncate" title="@item.Name">@item.Name</div>
                    @if (item.ViewKey is not null)
                    {
                        <div class="text-muted text-truncate">@item.ViewKey</div>
                    }
                    @if (item.StatusLabel is not null)
                    {
                        <div class="text-muted small">@item.StatusLabel</div>
                    }
                    <div class="d-flex gap-1 mt-1">
                        @if (item.Href is not null)
                        {
                            <a class="btn btn-sm btn-outline-secondary py-0" href="@item.Href" @onclick:stopPropagation="true">View</a>
                        }
                        @if (item.CandidateBatchId is not null)
                        {
                            <a class="btn btn-sm btn-outline-info py-0" href="/review-deck/@item.CandidateBatchId" title="Review this candidate batch" @onclick:stopPropagation="true">
                                <i class="bi bi-collection-play"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>;

    private void EnsurePolling()
    {
        lock (_timerLock)
        {
            if (_timer is null)
            {
                _timer = new System.Threading.Timer(async _ =>
                {
                    try
                    {
                        // System.Threading.Timer callbacks run on a threadpool thread — StateHasChanged
                        // must be marshaled onto the Blazor Dispatcher or it throws "current thread is
                        // not associated with the Dispatcher" and can crash the whole app.
                        await InvokeAsync(async () =>
                        {
                            await ReloadAssetsAsync();
                            if (!_hasInFlight)
                            {
                                StopPolling();
                            }
                        });
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Asset Studio asset-list polling reload failed.");
                    }
                }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
            }
        }
    }

    private void StopPolling()
    {
        lock (_timerLock)
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    private static string StatusBadge(SceneAssetStatus status) => status switch
    {
        SceneAssetStatus.Pending => "bg-secondary",
        SceneAssetStatus.Complete => "bg-success",
        SceneAssetStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}
