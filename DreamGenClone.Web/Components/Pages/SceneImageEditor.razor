@page "/roleplay/image-editor/{sessionId}/{interactionId}/{sourceImageId}"
@rendermode InteractiveServer

@using DreamGenClone.Components.Editing
@using DreamGenClone.Web.Application.RolePlay.Editing

<PageTitle>Scene Image Editor - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <a href="/roleplay/studio/@sessionId/@interactionId" class="btn btn-outline-secondary btn-sm" title="Back to Scene Image Studio">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 class="mb-0">Scene Image Editor</h4>
        </div>
        <a href="/roleplay/gallery/@sessionId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-images me-1"></i> Gallery
        </a>
    </div>

    <ImageEditWorkspace Subject="_subject"
                        ShowIdentity="true"
                        EditImageUrlFactory="EditImageUrl" />
</div>

@code {
    [Parameter]
    public string sessionId { get; set; } = string.Empty;

    [Parameter]
    public string interactionId { get; set; } = string.Empty;

    [Parameter]
    public string sourceImageId { get; set; } = string.Empty;

    private ImageEditSubject _subject = null!;

    protected override void OnParametersSet()
        => _subject = ImageEditSubject.ForSceneImage(sessionId, interactionId, sourceImageId);

    private string EditImageUrl(string imageId)
        => $"/roleplay/image-editor/{sessionId}/{interactionId}/{imageId}";
}
