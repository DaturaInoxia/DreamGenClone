@page "/roleplay/image-editor/{sessionId}/{interactionId}/{sourceImageId}"
@rendermode InteractiveServer

@using System.Text.Json
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.Models
@using DreamGenClone.Web.Application.Sessions
@using DreamGenClone.Web.Application.Scenarios
@implements IAsyncDisposable

@inject ISceneImageService ImageService
@inject ISceneImageEditCompilationService CompilationService
@inject IImageEditorModelResolver ImageEditorModelResolver
@inject ISessionService SessionService
@inject IScenarioService ScenarioService
@inject ICharacterImageIdentityService IdentityService
@inject NavigationManager Nav
@inject ILogger<SceneImageEditor> Logger

<PageTitle>Scene Image Editor - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <a href="/roleplay/studio/@sessionId/@interactionId" class="btn btn-outline-secondary btn-sm" title="Back to Scene Image Studio">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 class="mb-0">Scene Image Editor</h4>
        </div>
        <a href="/roleplay/gallery/@sessionId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-images me-1"></i> Gallery
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">@_statusMessage</div>
    }

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-muted">
            <span class="spinner-border spinner-border-sm"></span>
            <span>Loading source image...</span>
        </div>
    }
    else if (_sourceImage is null)
    {
        <div class="alert alert-warning">The selected source image is unavailable or is not complete.</div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-6">
                <section class="scene-edit-media-panel">
                    <div class="scene-edit-panel-heading">
                        <div>
                            <span class="scene-edit-kicker">Source</span>
                            <strong>Original image</strong>
                        </div>
                        <span class="badge bg-secondary">@_sourceImage.ImageSize</span>
                    </div>
                    <div class="scene-edit-image-stage">
                        <img src="/scene-images/@_sourceImage.FileRelativePath" alt="Source scene" class="scene-edit-image" />
                    </div>
                </section>
            </div>

            <div class="col-lg-6">
                <section class="scene-edit-workbench">
                    <ul class="nav nav-tabs small" role="tablist" aria-label="Image edit flow">
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(_activeTab == EditorTab.Edit ? "active" : "")" aria-selected="@(_activeTab == EditorTab.Edit)"
                                    @onclick="() => SelectEditorTab(EditorTab.Edit)">
                                Edit
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link @(_activeTab == EditorTab.Identity ? "active" : "")" aria-selected="@(_activeTab == EditorTab.Identity)"
                                    @onclick="() => SelectEditorTab(EditorTab.Identity)">
                                Identity @if (_identityTargetSelections.Count > 0) { <span class="badge text-bg-secondary ms-1">@_identityTargetSelections.Count</span> }
                            </button>
                        </li>
                    </ul>

                    @if (_activeTab == EditorTab.Edit)
                    {
                        <div class="scene-edit-panel-heading">
                            <div>
                                <span class="scene-edit-kicker">Vision compiler</span>
                                <strong>Describe the change</strong>
                            </div>
                            @if (_attempt is not null)
                            {
                                <span class="badge @AttemptBadgeClass">@FormatAttemptStatus(_attempt.Status)</span>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editor-model">Image editor model</label>
                            @if (_editorModelChoices.Count == 0)
                            {
                                <div class="alert alert-warning py-2 mb-0">No fully configured image editor endpoints are available. Configure a Qwen editor model in Model Manager.</div>
                            }
                            else
                            {
                                <select id="editor-model" class="form-select form-select-sm" @bind="_selectedEditorModelId" disabled="@_busy">
                                    @foreach (var choice in _editorModelChoices)
                                    {
                                        <option value="@choice.ModelId">@choice.DisplayName - @choice.ProviderName</option>
                                    }
                                </select>
                                @if (!string.IsNullOrWhiteSpace(_selectedEditorModelId))
                                {
                                    <div class="mt-3">
                                        <ReferenceApplyPanel ModelId="@_selectedEditorModelId"
                                                             Selections="@_referenceApplications"
                                                             SelectionsChanged="OnReferenceApplicationsChanged"
                                                             ExecutableStrategies="EditorReferenceStrategies" />
                                    </div>
                                }
                            }
                        </div>
                        <EditIterateWorkbench Error="@_errorMessage"
                                               StatusMessage="@_statusMessage"
                                               Loading="false"
                                               Busy="@_busy"
                                               ReadOnly="false"
                                               SourceDescription="@_editSession?.DescriptionText"
                                               IntentInputId="edit-intent"
                                               @bind-Intent="_rawIntent"
                                               CompilationStale="@IsCompilationStale"
                                               HasInFlightWork="@HasInFlightWork()"
                                               Compiling="@(_attempt?.Status is SceneImageEditCompilationAttemptStatus.Pending or SceneImageEditCompilationAttemptStatus.Compiling)"
                                               Rendering="@(_resultImage?.Status is SceneImageStatus.Pending or SceneImageStatus.Generating)"
                                               Compilation="@_compilationResult"
                                               CompilationError="@CompilationError"
                                               @bind-Clarification="_clarificationAnswer"
                                               PromptReady="@(_compilationResult?.Status == SceneImageEditCompilationResultStatus.Ready && _activeRevision is not null)"
                                               PromptRevisionNumber="@((_activeRevision?.Ordinal ?? 0) + 1)"
                                               @bind-EditablePrompt="_editablePrompt"
                                               SubmittedInput="@SubmittedInput"
                                               CanRun="@(_activeRevision is not null && !string.IsNullOrWhiteSpace(_selectedEditorModelId))"
                                               OnReanalyze="ReanalyzeAsync"
                                               OnPrepare="PrepareAsync"
                                               OnSubmitClarification="SubmitClarificationAsync"
                                               OnRun="RunEditAsync">
                            <ReadyContent>
                                @if (IsPromptModified)
                                {
                                    <div class="form-text text-warning">Your changes will be saved as a new accepted revision before execution.</div>
                                }
                            </ReadyContent>
                        </EditIterateWorkbench>
                    }
                    else
                    {
                        <div class="scene-edit-panel-heading">
                            <div>
                                <span class="scene-edit-kicker">Character identity</span>
                                <strong>Apply identity by edit</strong>
                            </div>
                        </div>
                        <div class="mb-3">
                            <p class="small text-muted">Bind each detected person to a scenario character's approved identity pack, then run a separate face-only identity correction. No typed prompt is required — identity compiles from the source image and runs independently of the Edit tab.</p>
                            @if (_compilationResult?.Status != SceneImageEditCompilationResultStatus.Ready)
                            {
                                <div class="alert alert-info py-2 small mb-2">Identity needs a vision analysis of this image to detect the people to correct.</div>
                                <button type="button" class="btn btn-sm btn-outline-info" disabled="@_busy" @onclick="IdentityPrepareAsync">
                                    <i class="bi bi-person-badge me-1"></i> Analyze faces
                                </button>
                            }
                            else if (_identityTargetSelections.Count == 0)
                            {
                                <div class="small text-muted">No people were detected in this image, so there are no faces to bind an identity reference to.</div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(_identityRosterStatus))
                                {
                                    <div class="alert alert-warning py-2 small">@_identityRosterStatus</div>
                                }
                                else if (_identityCharacters.Count == 0)
                                {
                                    <div class="alert alert-warning py-2 small">No scenario characters with an approved identity pack are available for this session. Create and approve identity packs in <a href="/characters/identity">Character Identity</a>.</div>
                                }
                                <section class="border rounded p-3 mt-3" aria-label="Identity-pack character targets">
                                    <div class="d-flex justify-content-between align-items-baseline gap-2 mb-2">
                                        <strong>Character identity targets</strong>
                                        <span class="small text-muted">Bind a character identity pack face to each detected person.</span>
                                    </div>
                                    @foreach (var target in _identityTargetSelections)
                                    {
                                        <div class="border rounded p-2 mb-2" @key="target.Target.Key">
                                            <div class="d-flex justify-content-between gap-2 mb-2">
                                                <strong>@target.Target.Key</strong>
                                                <span class="small text-muted">@target.Target.VisibleLocator</span>
                                            </div>
                                            @if (target.Target.Region is not null)
                                            {
                                                <div class="form-text mb-2">Region: x @target.Target.Region.X.ToString("0.###"), y @target.Target.Region.Y.ToString("0.###"), width @target.Target.Region.Width.ToString("0.###"), height @target.Target.Region.Height.ToString("0.###")</div>
                                            }
                                            @if (target.Target.HeadView is not null)
                                            {
                                                <div class="form-text mb-2">Detected pose: @FaceViewLabel(target.Target.HeadView)</div>
                                            }
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <label class="form-label small mb-1">Scenario character</label>
                                                    <select class="form-select form-select-sm" value="@target.CharacterId" disabled="@_busy" @onchange="args => SetIdentityTargetCharacterAsync(target, args)">
                                                        <option value="">Select character…</option>
                                                        @foreach (var choice in _identityCharacters)
                                                        {
                                                            <option value="@choice.CharacterId">@choice.CharacterName</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small mb-1">Face reference (approved pack)</label>
                                                    <div class="position-relative">
                                                        <button type="button"
                                                                class="scene-face-picker-toggle"
                                                                disabled="@(_busy || target.Faces is not { Count: > 0 })"
                                                                aria-haspopup="listbox"
                                                                aria-expanded="@(_openFacePickerTargetKey == target.Target.Key)"
                                                                @onclick="() => ToggleIdentityFacePicker(target.Target.Key)">
                                                            @{
                                                                var selectedFace = target.Faces?.FirstOrDefault(face => string.Equals(face.Id, target.ReferenceAssetId, StringComparison.Ordinal));
                                                            }
                                                            @if (selectedFace is not null)
                                                            {
                                                                <img src="/scene-images/@selectedFace.FileRelativePath" alt="@IdentityFaceLabel(selectedFace)" class="scene-face-picker-thumb" />
                                                                <span class="scene-face-picker-toggle-label">@IdentityFaceLabel(selectedFace)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="scene-face-picker-toggle-label text-muted">@IdentityFacePlaceholder(target)</span>
                                                            }
                                                            <i class="bi bi-chevron-down ms-auto"></i>
                                                        </button>
                                                        @if (_openFacePickerTargetKey == target.Target.Key)
                                                        {
                                                            <div class="scene-face-picker-backdrop" @onclick="CloseIdentityFacePicker"></div>
                                                            <div class="scene-face-picker-menu" role="listbox" aria-label="Face reference (approved pack)">
                                                                @foreach (var face in target.Faces ?? [])
                                                                {
                                                                    <button type="button"
                                                                            class="scene-face-picker-item @(string.Equals(face.Id, target.ReferenceAssetId, StringComparison.Ordinal) ? "is-selected" : "")"
                                                                            role="option"
                                                                            aria-selected="@(string.Equals(face.Id, target.ReferenceAssetId, StringComparison.Ordinal))"
                                                                            @onclick="() => SelectIdentityFaceAsync(target, face.Id)">
                                                                        <img src="/scene-images/@face.FileRelativePath" alt="@IdentityFaceLabel(face)" class="scene-face-picker-thumb" />
                                                                        <span class="scene-face-picker-item-label">
                                                                            <strong>@FaceViewLabel(face.FaceView)</strong>
                                                                            <span>@face.QualityRating</span>
                                                                        </span>
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <div class="d-flex align-items-center gap-2 mt-3">
                                        <button type="button" class="btn btn-sm btn-outline-success" disabled="@(_busy || !_identityTargetSelections.Any(target => target.IsBound) || _resultImage?.Status is SceneImageStatus.Pending or SceneImageStatus.Generating)" @onclick="RunIdentityEditAsync">
                                            <i class="bi bi-person-badge me-1"></i> Run identity edit
                                        </button>
                                        <span class="small text-muted">Runs a separate face-only identity correction that becomes its own image; content edits on the Edit tab are independent.</span>
                                    </div>
                                </section>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>

        @if (_compilationResult?.Status == SceneImageEditCompilationResultStatus.Ready && _attempt is not null)
        {
            <div class="row g-3 mt-0">
                <div class="col-12">
                    <section class="scene-edit-summary h-100">
                        <div class="scene-edit-panel-heading">
                            <div>
                                <span class="scene-edit-kicker">Grounded analysis</span>
                                <strong>What the compiler found</strong>
                            </div>
                        </div>
                        <p>@_compilationResult.SourceSummary</p>
                        <div class="scene-edit-summary-group">
                            <span>Targets</span>
                            @foreach (var target in _compilationResult.Targets)
                            {
                                <div><strong>@target.Key:</strong> @target.VisibleLocator</div>
                            }
                        </div>
                        <div class="scene-edit-summary-group">
                            <span>Changes</span>
                            <ul>
                                @foreach (var change in _compilationResult.RequestedChanges)
                                {
                                    <li>@change</li>
                                }
                            </ul>
                        </div>
                        <div class="scene-edit-summary-group">
                            <span>Preserve</span>
                            <ul>
                                @foreach (var item in _compilationResult.Preserve)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    </section>
                </div>
            </div>
        }

        @if (_resultImage is not null || _lineage.Count > 1)
        {
            <section class="scene-edit-results mt-3">
                <div class="scene-edit-panel-heading">
                    <div>
                        <span class="scene-edit-kicker">Lineage</span>
                        <strong>Source and results</strong>
                    </div>
                </div>

                @if (_resultImage is not null)
                {
                    <div class="row g-3 align-items-stretch mb-3">
                        <div class="col-md-6">
                            <div class="scene-edit-compare-frame">
                                <span>Before</span>
                                <img src="/scene-images/@_sourceImage.FileRelativePath" alt="Source before editing" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="scene-edit-compare-frame">
                                <span>After</span>
                                @if (_resultImage.Status == SceneImageStatus.Complete && !string.IsNullOrWhiteSpace(_resultImage.FileRelativePath))
                                {
                                    <img src="/scene-images/@_resultImage.FileRelativePath" alt="Edited result" />
                                }
                                else if (_resultImage.Status is SceneImageStatus.Pending or SceneImageStatus.Generating)
                                {
                                    <div class="scene-edit-result-state"><span class="spinner-border"></span><span>Editing image...</span></div>
                                }
                                else
                                {
                                    <div class="alert alert-danger m-3">@_resultImage.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="scene-edit-lineage">
                    @foreach (var image in _lineage)
                    {
                        <div class="scene-edit-lineage-item @(image.Id == _sourceImage.Id ? "is-current" : "")">
                            @if (image.Status == SceneImageStatus.Complete && !string.IsNullOrWhiteSpace(image.FileRelativePath))
                            {
                                <img src="/scene-images/@image.FileRelativePath" alt="@(image.Operation == SceneImageOperation.Edit ? "Edited lineage image" : "Original lineage image")" class="scene-edit-lineage-thumb" />
                            }
                            else
                            {
                                <div class="scene-edit-lineage-thumb scene-edit-lineage-thumb-state">@image.Status</div>
                            }
                            <div class="scene-edit-lineage-meta">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge @(image.Operation == SceneImageOperation.Edit ? "bg-info text-dark" : "bg-secondary")">@image.Operation</span>
                                    <span class="text-muted small">@image.Status · @image.CreatedUtc.ToLocalTime().ToString("g")</span>
                                </div>
                                <span class="font-monospace small text-muted">@image.Id</span>
                                @if (image.Operation == SceneImageOperation.Edit)
                                {
                                    <details class="scene-edit-lineage-prompt">
                                        <summary>Exact edit prompt</summary>
                                        <div>@image.PromptSnapshot</div>
                                    </details>
                                }
                            </div>
                            @if (image.Status == SceneImageStatus.Complete && !string.IsNullOrWhiteSpace(image.FileRelativePath))
                            {
                                <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => EditResult(image)">
                                    <i class="bi bi-pencil-square me-1"></i> Edit image
                                </button>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    /// <summary>Fixed identity-only vision intent so the Identity flow compiles without a user-typed prompt.</summary>
    private const string IdentityAnalysisIntent =
        "Apply the approved face identity to the visible people only. List every visible person as a target with a distinct image-relative key and locator and a normalized face region. Do not propose any content, clothing, pose, expression, or background change.";

    [Parameter]
    public string sessionId { get; set; } = string.Empty;

    [Parameter]
    public string interactionId { get; set; } = string.Empty;

    [Parameter]
    public string sourceImageId { get; set; } = string.Empty;

    private SceneImageRecord? _sourceImage;
    private SceneImageEditSession? _editSession;
    private SceneImageEditCompilationAttempt? _attempt;
    private SceneImageEditCompilationResult? _compilationResult;
    private SceneImageEditPromptRevision? _activeRevision;
    private SceneImageRecord? _resultImage;
    private IReadOnlyList<SceneImageRecord> _lineage = [];
    private string? _lineageRootId;
    private IReadOnlyList<SceneImageModelChoice> _editorModelChoices = [];
    private string? _selectedEditorModelId;
    private static readonly IReadOnlyList<string> EditorReferenceStrategies = ["TextOnly", "NativeMultiReference"];
    private readonly List<ReferenceApplicationSelection> _referenceApplications =
    [
        new() { ElementKey = "Body", SemanticRole = "character body", AssetType = SceneAssetType.CharacterBody },
        new() { ElementKey = "Wardrobe", SemanticRole = "wardrobe continuity", AssetType = SceneAssetType.Wardrobe },
        new() { ElementKey = "Location", SemanticRole = "location continuity", AssetType = SceneAssetType.Location }
    ];
    private readonly List<EditIdentityTargetSelection> _identityTargetSelections = [];
    private string _openFacePickerTargetKey = string.Empty;
    private IReadOnlyList<IdentityCharacterChoice> _identityCharacters = [];
    private string _identityRosterStatus = string.Empty;
    private readonly List<string> _clarificationHistory = [];
    private string _rawIntent = string.Empty;
    private string _preparedIntent = string.Empty;
    private string _clarificationAnswer = string.Empty;
    private string _editablePrompt = string.Empty;
    private string _statusMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _loading = true;
    private bool _busy;
    private bool _polling;
    private bool _descriptionPending;
    private CancellationTokenSource? _pollingCts;
    private Task? _pollingTask;

    private enum EditorTab
    {
        Edit,
        Identity
    }

    private EditorTab _activeTab = EditorTab.Edit;

    private void SelectEditorTab(EditorTab tab)
    {
        _activeTab = tab;
    }

    private bool IsCompilationStale => _attempt is not null
        && !string.Equals(_rawIntent.Trim(), _preparedIntent, StringComparison.Ordinal);

    private bool IsPromptModified => _activeRevision is not null
        && !string.Equals(_editablePrompt.Trim(), _activeRevision.Prompt, StringComparison.Ordinal);
    private string? CompilationError => _compilationResult?.Status == SceneImageEditCompilationResultStatus.Invalid
        ? _compilationResult.InvalidReason
        : _attempt?.Status == SceneImageEditCompilationAttemptStatus.Failed ? _attempt.Error : null;
    private string SubmittedInput => JsonSerializer.Serialize(new
    {
        sessionId,
        interactionId,
        sourceImageId,
        prompt = _editablePrompt.Trim()
    }, JsonOptions);

    private string AttemptBadgeClass => _attempt?.Status switch
    {
        SceneImageEditCompilationAttemptStatus.Ready => "bg-success",
        SceneImageEditCompilationAttemptStatus.ClarificationRequired => "bg-warning text-dark",
        SceneImageEditCompilationAttemptStatus.Invalid or SceneImageEditCompilationAttemptStatus.Failed => "bg-danger",
        _ => "bg-info text-dark"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = string.Empty;
        try
        {
            var images = await ImageService.ListImagesByInteractionAsync(sessionId, interactionId);
            var routedImage = images.FirstOrDefault(image => string.Equals(image.Id, sourceImageId, StringComparison.OrdinalIgnoreCase));
            _sourceImage = routedImage;
            if (_sourceImage is null || _sourceImage.Status != SceneImageStatus.Complete || string.IsNullOrWhiteSpace(_sourceImage.FileRelativePath))
            {
                _sourceImage = null;
                return;
            }
            _lineageRootId = FindLineageRootId(images, _sourceImage);

            _editSession = await CompilationService.CreateSessionAsync(new CreateSceneImageEditSessionRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                SourceImageId = _sourceImage.Id
            });
            _editorModelChoices = await ImageEditorModelResolver.ListImageEditorModelsAsync();
            _selectedEditorModelId = _editorModelChoices.FirstOrDefault()?.ModelId;
            await LoadIdentityRosterAsync();
            await CompilationService.EnqueueDescriptionAsync(_editSession.Id);
            _descriptionPending = true;
            await RefreshAsync();
            if (HasInFlightWork())
                EnsurePolling();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to open the image editor: {ex.Message}";
            Logger.LogError(ex, "SceneImageEditor load failed: SessionId={SessionId}, InteractionId={InteractionId}, SourceImageId={SourceImageId}", sessionId, interactionId, sourceImageId);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrepareAsync()
    {
        if (_editSession is null || string.IsNullOrWhiteSpace(_rawIntent))
            return;
        await RunAsync(async () =>
        {
            await StartNewEditSessionIfCompletedAsync();
            _attempt = await CompilationService.EnqueueCompilationAsync(new EnqueueSceneImageEditCompilationRequest
            {
                EditSessionId = _editSession.Id,
                RawIntent = _rawIntent.Trim(),
                ClarificationHistory = _clarificationHistory.ToList()
            });
            _preparedIntent = _rawIntent.Trim();
            _compilationResult = null;
            _identityTargetSelections.Clear();
            _activeRevision = null;
            _editablePrompt = string.Empty;
            _statusMessage = "Edit compilation queued.";
            EnsurePolling();
        });
    }

    private async Task SubmitClarificationAsync(string clarification)
    {
        if (string.IsNullOrWhiteSpace(clarification))
            return;
        _clarificationHistory.Add(clarification.Trim());
        _clarificationAnswer = string.Empty;
        await PrepareAsync();
    }

    private async Task ReanalyzeAsync()
    {
        if (_editSession is null)
            return;
        await RunAsync(async () =>
        {
            await StartNewEditSessionIfCompletedAsync();
            _descriptionPending = false;
            await CompilationService.EnqueueDescriptionAsync(_editSession.Id, force: true);
            _descriptionPending = true;
            EnsurePolling();
        });
    }

    private async Task RunEditAsync()
    {
        if (_editSession is null || _attempt is null || _activeRevision is null || _sourceImage is null)
            return;
        await RunAsync(async () =>
        {
            var revision = _activeRevision;
            if (IsPromptModified)
            {
                revision = await CompilationService.AppendPromptRevisionAsync(new AppendSceneImageEditPromptRevisionRequest
                {
                    EditSessionId = _editSession.Id,
                    CompilationAttemptId = _attempt.Id,
                    Prompt = _editablePrompt.Trim()
                });
                _activeRevision = revision;
            }

            _resultImage = await ImageService.EnqueueEditAsync(new SceneImageEditRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                SourceImageId = _sourceImage.Id,
                EditSessionId = _editSession.Id,
                CompilationAttemptId = _attempt.Id,
                PromptRevisionId = revision.Id,
                SourceImageSha256 = _editSession.SourceImageSha256,
                PromptSha256 = revision.PromptSha256,
                EditorModelId = _selectedEditorModelId!,
                ReferenceApplications = _referenceApplications.ToList()
            });
            _statusMessage = "Image edit queued.";
            EnsurePolling();
        });
    }

    private async Task RefreshAsync()
    {
        if (_editSession is null)
            return;
        _editSession = await CompilationService.GetSessionAsync(_editSession.Id) ?? _editSession;
        if (_descriptionPending && _editSession is not null && !string.IsNullOrWhiteSpace(_editSession.DescriptionText))
            _descriptionPending = false;
        var latestAttempt = await CompilationService.GetLatestAttemptAsync(_editSession.Id);
        if (latestAttempt is not null)
        {
            var changedAttempt = !string.Equals(_attempt?.Id, latestAttempt.Id, StringComparison.Ordinal);
            _attempt = latestAttempt;
            _compilationResult = ParseResult(latestAttempt.ParsedResultJson);
            SyncIdentityTargetSelections();
            var revisions = await CompilationService.ListRevisionsAsync(latestAttempt.Id);
            var latestRevision = revisions.OrderByDescending(revision => revision.Ordinal).FirstOrDefault();
            if (latestRevision is not null && (changedAttempt || _activeRevision is null))
            {
                _activeRevision = latestRevision;
                _editablePrompt = latestRevision.Prompt;
            }
        }

        var images = await ImageService.ListImagesByInteractionAsync(sessionId, interactionId);
        _resultImage = ResolveResultImage(images);
        _lineage = BuildLineage(images, _lineageRootId ?? _sourceImage.Id);
    }

    /// <summary>
    /// Keeps the tracked result image visible in place while it progresses. The tracked id is
    /// preferred because identity edits are dispatched outside the content edit session and carry
    /// no edit-session id; the edit session's latest image only seeds the first render.
    /// </summary>
    private SceneImageRecord? ResolveResultImage(IReadOnlyList<SceneImageRecord> images)
    {
        if (_resultImage is not null)
        {
            var tracked = images.FirstOrDefault(image => string.Equals(image.Id, _resultImage.Id, StringComparison.Ordinal));
            if (tracked is not null)
                return tracked;
        }
        return images
            .Where(image => string.Equals(image.EditSessionId, _editSession?.Id, StringComparison.Ordinal))
            .OrderByDescending(image => image.CreatedUtc)
            .FirstOrDefault();
    }

    private async Task StartNewEditSessionIfCompletedAsync()
    {
        if (_editSession?.Status != SceneImageEditSessionStatus.Completed)
            return;
        _editSession = await CompilationService.CreateSessionAsync(new CreateSceneImageEditSessionRequest
        {
            SessionId = sessionId,
            InteractionId = interactionId,
            SourceImageId = _sourceImage?.Id ?? sourceImageId
        });
        _attempt = null;
        _compilationResult = null;
        _identityTargetSelections.Clear();
        _activeRevision = null;
        _editablePrompt = string.Empty;
        _preparedIntent = string.Empty;
        _descriptionPending = false;
    }

    private Task OnReferenceApplicationsChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private sealed class IdentityCharacterChoice
    {
        public string CharacterId { get; set; } = string.Empty;
        public string CharacterName { get; set; } = string.Empty;
        public string IdentityPackId { get; set; } = string.Empty;
        public int IdentityPackVersion { get; set; }
        public string CanonicalFaceAssetId { get; set; } = string.Empty;
        public IReadOnlyList<SceneImageReferenceAsset> Faces { get; set; } = [];
    }

    private sealed class EditIdentityTargetSelection
    {
        public SceneImageEditTarget Target { get; set; } = new();
        public string CharacterId { get; set; } = string.Empty;
        public string CharacterName { get; set; } = string.Empty;
        public string ReferenceAssetId { get; set; } = string.Empty;
        public IReadOnlyList<SceneImageReferenceAsset>? Faces { get; set; }
        public bool IsBound => !string.IsNullOrWhiteSpace(CharacterId) && !string.IsNullOrWhiteSpace(ReferenceAssetId);
    }

    private void SyncIdentityTargetSelections()
    {
        var targets = _compilationResult?.Status == SceneImageEditCompilationResultStatus.Ready
            ? _compilationResult.Targets
            : [];
        var existing = _identityTargetSelections.ToDictionary(item => item.Target.Key, StringComparer.Ordinal);
        _identityTargetSelections.Clear();
        foreach (var target in targets)
        {
            if (existing.TryGetValue(target.Key, out var current))
            {
                current.Target = target;
                _identityTargetSelections.Add(current);
                continue;
            }

            _identityTargetSelections.Add(new EditIdentityTargetSelection { Target = target });
        }
    }

    private async Task SetIdentityTargetCharacterAsync(EditIdentityTargetSelection target, ChangeEventArgs args)
    {
        var characterId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(characterId))
        {
            target.CharacterId = string.Empty;
            target.CharacterName = string.Empty;
            target.ReferenceAssetId = string.Empty;
            target.Faces = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var choice = _identityCharacters.FirstOrDefault(item => string.Equals(item.CharacterId, characterId, StringComparison.Ordinal));
        target.CharacterId = choice?.CharacterId ?? characterId;
        target.CharacterName = choice?.CharacterName ?? string.Empty;
        target.Faces = choice?.Faces ?? [];
        target.ReferenceAssetId = choice is null
            ? string.Empty
            : ResolvePreferredIdentityFace(choice, target.Target.HeadView);
        _openFacePickerTargetKey = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Prefer the approved pack face whose angle matches the vision-detected head direction; fall
    /// back to the pack's configured canonical face, then the first approved face. Never invents a
    /// face: every candidate is an approved asset of the character's approved pack.
    /// </summary>
    private static string ResolvePreferredIdentityFace(IdentityCharacterChoice choice, SceneImageReferenceFaceView? headView)
    {
        if (headView is { } view)
        {
            var matched = choice.Faces.FirstOrDefault(face => face.FaceView == view);
            if (matched is not null)
                return matched.Id;
        }
        var canonical = choice.Faces.FirstOrDefault(face => string.Equals(face.Id, choice.CanonicalFaceAssetId, StringComparison.Ordinal));
        return canonical?.Id ?? choice.Faces.FirstOrDefault()?.Id ?? string.Empty;
    }

    private static string IdentityFacePlaceholder(EditIdentityTargetSelection target) => target.Faces switch
    {
        null => "Select a character first…",
        { Count: 0 } => "No approved face in this pack…",
        _ => "No face selected…"
    };

    private void ToggleIdentityFacePicker(string targetKey)
        => _openFacePickerTargetKey = string.Equals(_openFacePickerTargetKey, targetKey, StringComparison.Ordinal)
            ? string.Empty
            : targetKey;

    private void CloseIdentityFacePicker() => _openFacePickerTargetKey = string.Empty;

    private async Task SelectIdentityFaceAsync(EditIdentityTargetSelection target, string assetId)
    {
        target.ReferenceAssetId = assetId;
        _openFacePickerTargetKey = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task IdentityPrepareAsync()
    {
        if (_editSession is null)
            return;
        await RunAsync(async () =>
        {
            await StartNewEditSessionIfCompletedAsync();
            _attempt = await CompilationService.EnqueueCompilationAsync(new EnqueueSceneImageEditCompilationRequest
            {
                EditSessionId = _editSession.Id,
                RawIntent = IdentityAnalysisIntent,
                ClarificationHistory = []
            });
            _preparedIntent = IdentityAnalysisIntent;
            _compilationResult = null;
            _identityTargetSelections.Clear();
            _activeRevision = null;
            _editablePrompt = string.Empty;
            _statusMessage = "Identity analysis queued.";
            EnsurePolling();
        });
    }

    private async Task RunIdentityEditAsync()
    {
        if (_editSession is null || _sourceImage is null)
            return;
        await RunAsync(async () =>
        {
            var selections = _identityTargetSelections
                .Where(target => target.IsBound)
                .Select(target => new SceneImageEditorIdentitySelection
                {
                    TargetKey = target.Target.Key,
                    VisibleLocator = target.Target.VisibleLocator,
                    Region = target.Target.Region,
                    CharacterId = target.CharacterId,
                    CharacterName = target.CharacterName,
                    ReferenceAssetId = target.ReferenceAssetId
                })
                .ToList();
            if (selections.Count == 0)
                throw new InvalidOperationException("Select a character and an approved face for at least one detected person before running an identity edit.");
            _resultImage = await ImageService.EnqueueEditorIdentityAsync(new SceneImageEditorIdentityRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                SourceImageId = _sourceImage.Id,
                Selections = selections
            });
            _statusMessage = "Identity correction queued.";
            EnsurePolling();
        });
    }

    private async Task LoadIdentityRosterAsync()
    {
        _identityCharacters = [];
        _identityRosterStatus = string.Empty;
        try
        {
            var session = await SessionService.LoadRolePlaySessionAsync(sessionId);
            if (session is null || string.IsNullOrWhiteSpace(session.ScenarioId))
            {
                _identityRosterStatus = "This role-play session has no scenario characters to bind identity packs to.";
                return;
            }
            var scenario = await ScenarioService.GetScenarioAsync(session.ScenarioId);
            if (scenario?.Characters is not { Count: > 0 } characters)
            {
                _identityRosterStatus = "This scenario defines no characters, so no identity packs can be applied.";
                return;
            }

            var choices = new List<IdentityCharacterChoice>();
            foreach (var character in characters)
            {
                if (string.IsNullOrWhiteSpace(character.Id))
                    continue;
                IReadOnlyList<CharacterImageIdentityPack> packs;
                try
                {
                    packs = await IdentityService.ListPacksAsync(character.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load identity packs for character: CharacterId={CharacterId}", character.Id);
                    continue;
                }
                var approved = packs
                    .Where(pack => pack.Status == CharacterImageIdentityPackStatus.Approved)
                    .OrderByDescending(pack => pack.Version)
                    .ToArray();
                if (approved.Length != 1)
                    continue;
                var pack = approved[0];
                var assets = await IdentityService.ListAssetsAsync(pack.Id);
                var faces = assets
                    .Where(asset => asset.AssetKind == SceneImageReferenceAssetKind.Face
                        && asset.IsApproved
                        && asset.FaceView.HasValue
                        && !string.IsNullOrWhiteSpace(asset.FileRelativePath)
                        && !string.IsNullOrWhiteSpace(asset.Sha256))
                    .OrderBy(asset => asset.FaceView)
                    .ToList();
                if (faces.Count == 0)
                    continue;
                choices.Add(new IdentityCharacterChoice
                {
                    CharacterId = character.Id,
                    CharacterName = string.IsNullOrWhiteSpace(character.Name) ? character.Id : character.Name,
                    IdentityPackId = pack.Id,
                    IdentityPackVersion = pack.Version,
                    CanonicalFaceAssetId = faces.Any(face => string.Equals(face.Id, pack.CanonicalFaceAssetId, StringComparison.Ordinal))
                        ? pack.CanonicalFaceAssetId!
                        : faces[0].Id,
                    Faces = faces
                });
            }
            _identityCharacters = choices
                .OrderBy(choice => choice.CharacterName, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (_identityCharacters.Count == 0)
                _identityRosterStatus = "No scenario characters currently have an approved identity pack with approved face references.";
        }
        catch (Exception ex)
        {
            _identityRosterStatus = $"Identity packs could not be loaded: {ex.Message}";
            Logger.LogWarning(ex, "SceneImageEditor identity roster load failed: SessionId={SessionId}", sessionId);
        }
    }

    private static string IdentityFaceLabel(SceneImageReferenceAsset face)
        => $"{FaceViewLabel(face.FaceView)} · {face.QualityRating}";

    private static string FaceViewLabel(SceneImageReferenceFaceView? view) => view switch
    {
        SceneImageReferenceFaceView.Front => "Front",
        SceneImageReferenceFaceView.ThreeQuarterLeft => "3/4 left",
        SceneImageReferenceFaceView.ThreeQuarterRight => "3/4 right",
        SceneImageReferenceFaceView.ProfileLeft => "Profile left",
        SceneImageReferenceFaceView.ProfileRight => "Profile right",
        _ => "Front"
    };

    private static SceneImageEditCompilationResult? ParseResult(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return null;
        return JsonSerializer.Deserialize<SceneImageEditCompilationResult>(json, JsonOptions)
            ?? throw new InvalidOperationException("The stored compiler result is invalid.");
    }

    private static IReadOnlyList<SceneImageRecord> BuildLineage(IReadOnlyList<SceneImageRecord> images, string rootId)
    {
        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { rootId };
        var changed = true;
        while (changed)
        {
            changed = false;
            foreach (var image in images)
            {
                if (!string.IsNullOrWhiteSpace(image.SourceImageId) && ids.Contains(image.SourceImageId) && ids.Add(image.Id))
                    changed = true;
            }
        }
        return images.Where(image => ids.Contains(image.Id)).OrderBy(image => image.CreatedUtc).ToList();
    }

    private static string FindLineageRootId(IReadOnlyList<SceneImageRecord> images, SceneImageRecord selectedImage)
    {
        var imagesById = images.ToDictionary(image => image.Id, StringComparer.OrdinalIgnoreCase);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var current = selectedImage;
        while (!string.IsNullOrWhiteSpace(current.SourceImageId)
            && visited.Add(current.Id)
            && imagesById.TryGetValue(current.SourceImageId, out var parent))
        {
            current = parent;
        }
        return current.Id;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _errorMessage = string.Empty;
        _statusMessage = string.Empty;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Logger.LogWarning(ex, "SceneImageEditor action failed: SessionId={SessionId}, SourceImageId={SourceImageId}", sessionId, sourceImageId);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private bool HasInFlightWork()
    {
        if (_descriptionPending)
            return true;
        if (_attempt?.Status is SceneImageEditCompilationAttemptStatus.Pending or SceneImageEditCompilationAttemptStatus.Compiling)
            return true;
        return _resultImage?.Status is SceneImageStatus.Pending or SceneImageStatus.Generating;
    }

    private void EnsurePolling()
    {
        if (_polling)
            return;
        _polling = true;
        _pollingCts = new CancellationTokenSource();
        _pollingTask = Task.Run(() => PollAsync(_pollingCts.Token));
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var stillWorking = false;
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await RefreshAsync();
                    }
                    catch (Exception ex)
                    {
                        _errorMessage = $"Refresh failed: {ex.Message}";
                        Logger.LogWarning(ex, "SceneImageEditor poll failed: SessionId={SessionId}, SourceImageId={SourceImageId}", sessionId, sourceImageId);
                    }
                    stillWorking = HasInFlightWork();
                    StateHasChanged();
                });
                if (!stillWorking)
                    break;
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            _polling = false;
        }
    }

    private void EditResult(SceneImageRecord image)
    {
        Nav.NavigateTo($"/roleplay/image-editor/{sessionId}/{interactionId}/{image.Id}", forceLoad: true);
    }

    private static string FormatAttemptStatus(SceneImageEditCompilationAttemptStatus status) => status switch
    {
        SceneImageEditCompilationAttemptStatus.ClarificationRequired => "Needs clarification",
        _ => status.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        if (_pollingCts is not null)
        {
            await _pollingCts.CancelAsync();
            _pollingCts.Dispose();
            _pollingCts = null;
        }
    }
