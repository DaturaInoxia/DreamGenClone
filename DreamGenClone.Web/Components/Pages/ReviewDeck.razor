    /// <summary>
    /// The whole-dataset scope: every attempt across every cell of a LoRA dataset, in one deck. It exists because
    /// reviewing a training set meant opening 36 cells one at a time, and because the deck's own back button then had
    /// nowhere useful to return to.
    /// </summary>
    private bool IsDatasetRoute => string.Equals(RouteKind, "dataset", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// An item that is backed by a scene-asset image, which decides editing. The dataset scope's items ARE asset images
    /// (a cell attempt is one), so it shares that behaviour instead of re-deriving it - the same mapper builds them.
