    private async Task ResolveFrontBackUrlAsync()
    {
        _frontBackUrl = null;
        if (!IsAssetRoute
            || !BatchId.StartsWith(CharacterIdentityFrontService.FrontBatchPrefix, StringComparison.Ordinal))
        {
            return;
        }

        var buildId = BatchId[CharacterIdentityFrontService.FrontBatchPrefix.Length..];
        var build = await BuildService.GetBuildAsync(buildId);
        if (build is not null && !string.IsNullOrWhiteSpace(build.CharacterTemplateId))
        {
            _frontBackUrl = $"/characters/{Uri.EscapeDataString(build.CharacterTemplateId)}";
        }
    }

    private async Task LoadCurrentAsync()
    {
        try
        {
            _lineageChildren = Current is null
                ? []
                : IsStudioRoute
                    ? _items.Where(item => string.Equals(item.ParentImageId, Current.Id, StringComparison.Ordinal)).ToList()
                    : IsAssetRoute
                        ? _items.Where(item => string.Equals(item.ParentImageId, Current.Id, StringComparison.Ordinal)).ToList()
                    : (await ProducedImages.ListByParentAsync(Current.Id)).Select(MapLegacyItem).ToList();

            // The rail shows the image's tags and the inputs it was generated with, and neither is part of this deck's
            // flat projection — the projection is one shape for three stores, and those two facts live in the row.
            await LoadRailAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    /// <summary>
    /// Reads what the rail needs from the image's OWN row: its tags, and what it was generated with. Which store that
    /// row lives in is the ROUTE's fact, so the route decides here and the rail is handed the result as data — the rail
    /// itself never has to know that a production frame and a library asset are stored differently.
    /// </summary>
    private async Task LoadRailAsync()
    {
        _railTagTarget = null;
        _railTagsJson = null;
        _railDetails = null;

        if (Current is null)
        {
            return;
        }

        if (IsStudioRoute)
        {
            if (await ImageService.GetImageAsync(Current.Id) is { } rendered)
            {
                _railTagTarget = ImageTagTarget.Rendered;
                _railTagsJson = rendered.TagsJson;
                _railDetails = ImageGenerationInputDetails.FromSceneImage(rendered);
            }

            return;
        }

        // The dataset scope's items ARE asset-library images (a cell attempt is one), so it reads the same store the
        // asset route does rather than falling through to the bare route's older table.
        if (IsImageRoute && await AssetService.GetImageAsync(Current.Id) is { } asset)
        {
            _railTagTarget = ImageTagTarget.AssetLibrary;
            _railTagsJson = asset.TagsJson;
            _railDetails = ImageGenerationInputDetails.FromAssetImage(asset);
        }

        // The bare route's images are rows in the older produced-images table: no tag store and no recorded input set,
        // so the rail draws its field list and the audit footer and offers no editor that would refuse every write.
    }

