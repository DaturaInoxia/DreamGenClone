    /// <summary>
    /// Opens the extraction form and loads its lists once. The models offered are the pose-capable ones from the one
    /// resolution service; extraction then refuses a model that is not served by ComfyUI by name, because the estimator
    /// is a node on that host and no other provider has an equivalent.
    /// </summary>
    private async Task OpenExtractAsync()
    {
        _extractOpen = true;
        _extractError = null;
        _extractStatus = null;
        _extractName ??= Current is null ? null : $"Extracted {Current.Id}";

        try
        {
            if (_extractModels.Count == 0)
            {
                _extractModels = (await PoseTestRender.ListModelsAsync())
                    .Where(model => model.CanCarryPose)
                    .ToArray();
                _extractModelId ??= _extractModels.FirstOrDefault()?.ModelId;
            }

            if (_extractLibraries.Count == 0)
            {
                var authored = await PoseLibrary.EnsureAuthoredLibraryAsync();
                _extractLibraries = (await PoseLibrary.ListLibrariesAsync())
                    .Where(library => !library.IsSystem)
                    .ToArray();
                _extractLibraryId ??= _extractLibraries.Any(library => library.Id == authored.Id)
                    ? authored.Id
                    : _extractLibraries.FirstOrDefault()?.Id;
            }
        }
        catch (Exception exception)
        {
            _extractError = $"The extraction form could not load its lists: {exception.Message}";
        }
    }

    private void CloseExtract()
    {
        _extractOpen = false;
        _extractError = null;
        _extractStatus = null;
    }

    /// <summary>
    /// Reads the current image's own stored bytes and stores the pose found in them. The bytes come from the asset
    /// service's own download path rather than from the URL the page renders, so what gets measured is the artifact
    /// that is actually stored.
    /// </summary>
    private async Task ExtractPoseAsync()
    {
        if (Current is null)
        {
            return;
        }

        _extractBusy = true;
        _extractError = null;
        _extractStatus = null;

        try
        {
            var image = await ReadCurrentImageAsync(Current);

            var preset = await PoseExtraction.ExtractAsync(new PoseExtractionRequest(
                image,
                _extractModelId ?? string.Empty,
                _extractName ?? string.Empty,
                _extractCategory ?? string.Empty,
                null,
                _extractLibraryId ?? string.Empty,
                $"review-deck {Current.Id}",
                _extractHeadOnly));

            _extractStatus = $"Stored '{preset.Name}' as pose {preset.Id}; it is searchable in the pose library now.";
        }
        catch (Exception exception)
        {
            _extractError = exception.Message;
        }
        finally
        {
            _extractBusy = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _error = null;
            if (RouteKind is not null && !IsStudioRoute && !IsAssetRoute && !IsDatasetRoute)
            {
                throw new InvalidOperationException($"Unsupported review deck route kind '{RouteKind}'.");
            }

            _items = IsStudioRoute
                ? await LoadStudioItemsAsync()
                : IsAssetRoute
                    ? await LoadAssetItemsAsync()
                    : IsDatasetRoute
                        ? await LoadDatasetItemsAsync()
                        : (await ProducedImages.ListByBatchAsync(BatchId)).Select(MapLegacyItem).ToList();
            _index = Math.Clamp(_index, 0, Math.Max(0, _items.Count - 1));
            await LoadCurrentAsync();
            await ResolveFrontBackUrlAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    /// <summary>
    /// The current image's own stored bytes. Which reader to use is the only thing the route kinds differ in: an asset
    /// candidate is opened through the asset service, and a production attempt or a produced image lives under the
    /// scene-image root the deck already renders from. A candidate whose file does not exist yet is refused by name
    /// rather than measured as something else.
    /// </summary>
    private async Task<byte[]> ReadCurrentImageAsync(ReviewDeckItem item)
    {
        if (IsAssetRoute)
        {
            var (_, _, stream) = await AssetService.OpenImageForDownloadAsync(item.Id);
            await using (stream)
            {
                return await ReadAllAsync(stream);
            }
        }

        if (string.IsNullOrWhiteSpace(item.StoragePath))
        {
            throw new InvalidOperationException(
                $"'{item.Id}' has no stored image file yet, so there is nothing to read a pose from.");
        }

        await using var stored = await SceneImages.OpenReadAsync(item.StoragePath);
        return await ReadAllAsync(stored);
    }

    private static async Task<byte[]> ReadAllAsync(Stream stream)
    {
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private async Task PreviousAsync()
    {
        if (_index == 0)
        {
            return;
        }

        _index--;
        await LoadCurrentAsync();
    }

    private async Task NextAsync()
    {
        if (_index >= _items.Count - 1)
        {
            return;
        }

        _index++;
        await LoadCurrentAsync();
    }

    private async Task SelectCandidateAsync(string imageId)
    {
        var nextIndex = _items.FindIndex(item => string.Equals(item.Id, imageId, StringComparison.Ordinal));
        if (nextIndex < 0 || nextIndex == _index)
        {
            return;
        }

        _index = nextIndex;
        await LoadCurrentAsync();
    }

