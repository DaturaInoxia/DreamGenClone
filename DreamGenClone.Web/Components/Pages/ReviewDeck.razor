@page "/review-deck/{BatchId}"
@page "/review-deck/{RouteKind}/{BatchId}"
@rendermode InteractiveServer
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Application.Abstractions
@using DreamGenClone.Web.Application.RolePlay
@inject IProducedImageRepository ProducedImages
@inject IReferenceBootstrapService ReferenceBootstrapService
@inject ISceneImageProductionService ProductionService
@inject ISceneImageService ImageService
@inject ISceneAssetService AssetService
@inject ICharacterLoraRepository LoraRepository
@inject ICharacterLoraCellService LoraCells
@inject ISceneImageStorageService SceneImages
@inject ICharacterIdentityBuildService BuildService
@inject IPoseExtractionService PoseExtraction
@inject IPoseTestRenderService PoseTestRender
@inject IPoseLibraryService PoseLibrary
@inject IJSRuntime JS

<PageTitle>Review Deck - DreamGenClone</PageTitle>

@* Scoped to this page's own wrapper, so the compaction cannot leak into any other page's definition lists. The deck is
   a one-image-at-a-time surface: every row of chrome is a row of image the operator cannot see. *@
<style>
    .deck-compact dl.row dt, .deck-compact dl.row dd {
        margin-bottom: .15rem;
        line-height: 1.25;
    }

    .deck-compact h5, .deck-compact h6 {
        font-size: 1rem;
        margin-bottom: .35rem;
    }
</style>

<div class="container-fluid mt-4 deck-compact">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Review Deck</h4>
        <div class="d-flex align-items-center gap-2">
            @if (Current is not null || !string.IsNullOrWhiteSpace(ReturnUrl))
            {
                <a class="btn btn-outline-secondary btn-sm" href="@BackUrl" title="@BackLabel">
                    <i class="bi bi-arrow-left me-1"></i>@BackLabel
                </a>
            }
        </div>
        @if (_items.Count > 0)
        {
            <span class="text-muted">@(_index + 1) of @_items.Count</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_items.Count == 0)
    {
        <p class="text-muted">No images are available for this @(IsStudioRoute ? "production group" : IsDatasetRoute ? (OnlyAccepted ? "dataset with accepted attempts" : "dataset") : IsAssetRoute ? "asset batch" : "batch").</p>
    }
    else if (Current is not null)
    {
        <div class="d-flex flex-wrap gap-2 mb-2">
            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="PreviousAsync" disabled="@(_busy || _index == 0)">Previous</button>
            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="NextAsync" disabled="@(_busy || _index == _items.Count - 1)">Next</button>
            @if (_items.Count >= 2 && !IsDatasetRoute)
            {
                <a class="btn btn-outline-primary" href="@CompareUrl" role="button">Compare</a>
            }
            else
            {
                @* No compare in the dataset scope: the compare deck is scoped by batch, and a dataset is not one. *@
                @if (!IsDatasetRoute)
                {
                    <button class="btn btn-outline-primary" type="button" disabled>Compare</button>
                }
            }
            @if (IsDatasetRoute)
            {
                @* The accepted/all choice is part of the ADDRESS rather than component state, so the accepted set can be
                   linked, and the deck's own back button carries the scope home with it. *@
                <a class="btn btn-sm @(OnlyAccepted ? "btn-outline-secondary" : "btn-primary")"
                   href="/review-deck/dataset/@BatchId?only=all@(string.IsNullOrWhiteSpace(ReturnUrl) ? string.Empty : $"&return={Uri.EscapeDataString(ReturnUrl)}")">All attempts</a>
                <a class="btn btn-sm @(OnlyAccepted ? "btn-primary" : "btn-outline-secondary")"
                   href="/review-deck/dataset/@BatchId?only=accepted@(string.IsNullOrWhiteSpace(ReturnUrl) ? string.Empty : $"&return={Uri.EscapeDataString(ReturnUrl)}")">Accepted only</a>
            }
            @if (IsStudioRoute)
            {
                @if (Current.Disposition == SceneImageAttemptDisposition.Active)
                {
                    <button class="btn btn-info" type="button" @onclick="() => SetStudioDispositionAsync(SceneImageAttemptDisposition.Shortlisted)" disabled="@_busy">Shortlist</button>
                }
                else if (Current.Disposition == SceneImageAttemptDisposition.Shortlisted)
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SetStudioDispositionAsync(SceneImageAttemptDisposition.Active)" disabled="@_busy">Return to Active</button>
                }
                @if (Current.Disposition is SceneImageAttemptDisposition.Active or SceneImageAttemptDisposition.Shortlisted)
                {
                    <button class="btn btn-danger" type="button" @onclick="() => SetStudioDispositionAsync(SceneImageAttemptDisposition.Rejected)" disabled="@_busy">Reject</button>
                }
                <button class="btn btn-success" type="button" @onclick="ApproveStudioAsync" disabled="@(_busy || Current.ExecutionStatus != SceneImageStatus.Complete || string.IsNullOrWhiteSpace(Current.Sha256))">Approve</button>
            }
            else if (IsAssetRoute)
            {
                <button class="btn btn-success" type="button" @onclick="() => SetAssetDecisionAsync(SceneAssetCandidateDecision.Accepted)" disabled="@_busy">Accept</button>
                <button class="btn btn-info" type="button" @onclick="() => SetAssetDecisionAsync(SceneAssetCandidateDecision.Shortlisted)" disabled="@_busy">Shortlist</button>
                <button class="btn btn-danger" type="button" @onclick="() => SetAssetDecisionAsync(SceneAssetCandidateDecision.Rejected)" disabled="@_busy">Reject</button>
                <button class="btn btn-outline-danger" type="button" @onclick="() => SetAssetDecisionAsync(SceneAssetCandidateDecision.Revoked)" disabled="@_busy">Revoke</button>
            }
            else
            {
                <button class="btn btn-success" type="button" @onclick="() => SetStatusAsync(ProducedImageStatus.Accepted)" disabled="@_busy">Accept</button>
                <button class="btn btn-info" type="button" @onclick="() => SetStatusAsync(ProducedImageStatus.Shortlisted)" disabled="@_busy">Shortlist</button>
                <button class="btn btn-danger" type="button" @onclick="() => SetStatusAsync(ProducedImageStatus.Rejected)" disabled="@_busy">Reject</button>
                <button class="btn btn-outline-danger" type="button" @onclick="() => SetStatusAsync(ProducedImageStatus.Revoked)" disabled="@_busy">Revoke</button>
            }

            @* Offered on EVERY route, not just the asset one: the deck shows three kinds of candidate and a pose can be
               read from any of them, because what gets measured is the image's own stored bytes whatever put them
               there. A candidate whose file does not exist yet is refused by name rather than measured as something
               else. *@
            <button class="btn btn-outline-primary" type="button" @onclick="OpenExtractAsync" disabled="@(_busy || _extractBusy)" title="Store the pose in this image as a library pose"><i class="bi bi-person-bounding-box me-1"></i>Extract pose</button>
        </div>

        @if (_extractOpen)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <strong class="small">Extract the pose from this image</strong>
                            <span class="d-block small text-muted">
                                The image's own bytes go to the ComfyUI host's pose estimator and come back as keypoints,
                                which are stored as a library pose. An image whose head was not resolved is refused rather
                                than stored, and nothing about the render is changed.
                            </span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseExtract">Close</button>
                    </div>

                    <div class="row g-2 align-items-end mt-2">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">ComfyUI model</label>
                            @if (_extractModels.Count == 0)
                            {
                                <span class="text-muted d-block small">No pose-capable image models are enabled.</span>
                            }
                            else
                            {
                                <select class="form-select form-select-sm" value="@_extractModelId" @onchange="e => _extractModelId = e.Value?.ToString()">
                                    @foreach (var model in _extractModels)
                                    {
                                        <option value="@model.ModelId">@model.DisplayName - @model.ProviderName</option>
                                    }
                                </select>
                                <span class="form-text">The estimator is a node on the ComfyUI host, so a model that is not served by ComfyUI is refused by name.</span>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Name</label>
                            <CommittedTextInput type="text" class="form-control form-control-sm" placeholder="Extracted pose"
                                                Live="@_extractName" LiveChanged="args => _extractName = args ?? string.Empty" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold mb-1">Category</label>
                            <CommittedTextInput type="text" class="form-control form-control-sm"
                                                Live="@_extractCategory" LiveChanged="args => _extractCategory = args ?? string.Empty" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold mb-1">Library</label>
                            <select class="form-select form-select-sm" value="@_extractLibraryId" @onchange="e => _extractLibraryId = e.Value?.ToString()">
                                @foreach (var library in _extractLibraries)
                                {
                                    <option value="@library.Id">@library.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="button" class="btn btn-sm btn-primary"
                                    disabled="@(_extractBusy || string.IsNullOrWhiteSpace(_extractModelId) || string.IsNullOrWhiteSpace(_extractName))"
                                    @onclick="ExtractPoseAsync">
                                @if (_extractBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Extract
                            </button>
                        </div>
                    </div>

                    @* Unticked by default, and deliberately a declaration rather than something worked out from the image:
                       a body pose keeps the COCO-18 five-point head, a head pose carries the estimator's 70-point face and
                       is judged by that instead of by the neck and shoulders. *@
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="extract-head-only"
                               checked="@_extractHeadOnly" @onchange="e => _extractHeadOnly = e.Value is bool value && value" />
                        <label class="form-check-label small" for="extract-head-only">
                            <strong>Head only</strong> — store the estimator's 70-point face and judge the head by that
                            instead of by the neck and shoulders. Leave unticked for a body pose, where fine face detail
                            at full-body scale is a smear rather than information.
                        </label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_extractError))
                    {
                        <div class="alert alert-danger py-1 small mt-2 mb-0">@_extractError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_extractStatus))
                    {
                        <div class="alert alert-success py-1 small mt-2 mb-0">@_extractStatus</div>
                    }
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge @GetStatusBadgeClass(Current.Status)">@Current.Status</span>
                    <span class="small font-monospace text-break">@Current.Id</span>
                    <button class="btn btn-sm btn-outline-secondary ms-auto" type="button" @onclick="OpenViewer" title="View larger"><i class="bi bi-arrows-fullscreen me-1"></i>View larger</button>
                </div>

                <button class="btn w-100 p-0 border-0 bg-transparent" type="button" @onclick="OpenViewer" title="View larger">
                    @RenderImage(Current)
                </button>

                <div class="mt-2">
                    <LineageTree ParentImageId="@Current.ParentImageId"
                                 Children="@_lineageChildren.Select(item => new LineageTreeItem(item.Id, item.Status)).ToList()" />
                </div>
            </div>

            @* The metadata column scrolls INSIDE its own box, so it can never become the tallest thing on the page and
               push the image out of view. Reviewing an image is the job; reading thirteen metadata rows is not. *@
            <div class="col-lg-5" style="max-height:calc(100vh - 15rem);overflow-y:auto;">
                <h5>Metadata</h5>
                @if (IsStudioRoute)
                {
                    <dl class="row small">
                        <dt class="col-sm-4">Kind</dt><dd class="col-sm-8">@Current.Kind</dd>
                        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Current.Status</dd>
                        <dt class="col-sm-4">Stage</dt><dd class="col-sm-8">@Display(Current.Stage)</dd>
                        <dt class="col-sm-4">Execution</dt><dd class="col-sm-8">@Display(Current.ExecutionStatus)</dd>
                        <dt class="col-sm-4">Prompt</dt><dd class="col-sm-8 text-break">@Display(Current.Prompt)</dd>
                        <dt class="col-sm-4">Negative prompt</dt><dd class="col-sm-8 text-break">@Display(Current.NegativePrompt)</dd>
                        <dt class="col-sm-4">Model</dt><dd class="col-sm-8 text-break">@Display(Current.Model)</dd>
                        <dt class="col-sm-4">Checksum</dt><dd class="col-sm-8 text-break">@Display(Current.Sha256)</dd>
                        <dt class="col-sm-4">Created</dt><dd class="col-sm-8 text-break">@Current.CreatedUtc</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Current.Details))
                    {
                        <h6>Details</h6><pre class="font-monospace text-break">@Current.Details</pre>
                    }
                }
                else if (IsAssetRoute)
                {
                    <dl class="row small">
                        <dt class="col-sm-4">Kind</dt><dd class="col-sm-8">@Current.Kind</dd>
                        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Current.Status</dd>
                        <dt class="col-sm-4">Prompt</dt><dd class="col-sm-8 text-break">@Display(Current.Prompt)</dd>
                        <dt class="col-sm-4">Model</dt><dd class="col-sm-8 text-break">@Display(Current.Model)</dd>
                        <dt class="col-sm-4">Checksum</dt><dd class="col-sm-8 text-break">@Display(Current.Sha256)</dd>
                        <dt class="col-sm-4">Created</dt><dd class="col-sm-8 text-break">@Current.CreatedUtc</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Current.Details))
                    {
                        <h6>Details</h6><pre class="font-monospace text-break">@Current.Details</pre>
                    }
                }
                else
                {
                    <dl class="row small">
                        <dt class="col-sm-4">Kind</dt><dd class="col-sm-8">@Current.Kind</dd>
                        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Current.Status</dd>
                        <dt class="col-sm-4">Reference kind</dt><dd class="col-sm-8">@Display(Current.ReferenceKind)</dd>
                        <dt class="col-sm-4">Vision source</dt><dd class="col-sm-8">@Current.VisionSource</dd>
                        <dt class="col-sm-4">Vision text</dt><dd class="col-sm-8 text-break">@Display(Current.VisionText)</dd>
                        <dt class="col-sm-4">Prompt compiled</dt><dd class="col-sm-8 text-break">@Display(Current.PromptCompiled)</dd>
                        <dt class="col-sm-4">Prompt edited</dt><dd class="col-sm-8 text-break">@Display(Current.PromptEdited)</dd>
                        <dt class="col-sm-4">Negative prompt</dt><dd class="col-sm-8 text-break">@Display(Current.NegativePrompt)</dd>
                        <dt class="col-sm-4">Seed</dt><dd class="col-sm-8">@Display(Current.Seed)</dd>
                        <dt class="col-sm-4">Model</dt><dd class="col-sm-8 text-break">@Display(Current.Model)</dd>
                        <dt class="col-sm-4">Endpoint</dt><dd class="col-sm-8 text-break">@Display(Current.EndpointId)</dd>
                        <dt class="col-sm-4">Identity strategy</dt><dd class="col-sm-8 text-break">@Display(Current.IdentityStrategy)</dd>
                        <dt class="col-sm-4">Refusal mode</dt><dd class="col-sm-8">@Current.RefusalMode</dd>
                        <dt class="col-sm-4">Created</dt><dd class="col-sm-8 text-break">@Current.CreatedUtc</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Current.AppliedReferencesJson))
                    {
                        <h6>Applied references</h6><pre class="font-monospace text-break">@Current.AppliedReferencesJson</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(Current.CostJson))
                    {
                        <h6>Cost</h6><pre class="font-monospace text-break">@Current.CostJson</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(Current.ScoreJson))
                    {
                        <h6>Score</h6><pre class="font-monospace text-break">@Current.ScoreJson</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(Current.CandidateNotes))
                    {
                        <h6>Candidate notes</h6><pre class="font-monospace text-break">@Current.CandidateNotes</pre>
                    }
                }
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2 mt-4">
            <h5 class="mb-0">Images</h5>
            <span class="text-muted small">@_items.Count</span>
        </div>
        <div class="row g-2">
            @foreach (var item in _items)
            {
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="border rounded p-2 h-100 @(item.Id == Current.Id ? "border-primary border-3" : "border-secondary")">
                        <button class="btn w-100 p-0 text-start" type="button" @onclick="() => SelectCandidateAsync(item.Id)">
                            <div class="ratio ratio-1x1 bg-dark">
                                @if (!string.IsNullOrWhiteSpace(item.StoragePath))
                                {
                                    <img src="/scene-images/@item.StoragePath" class="w-100 h-100" style="object-fit:contain;" alt="Candidate @item.Id" />
                                }
                                else
                                {
                                    <span class="d-flex align-items-center justify-content-center text-light small">Pending</span>
                                }
                            </div>
                            <span class="d-flex justify-content-between gap-1 p-2 small">
                                <span class="text-truncate font-monospace">@item.Id</span>
                                <span class="badge @GetStatusBadgeClass(item.Status)">@item.Status</span>
                            </span>
                        </button>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @if (IsStudioRoute)
                            {
                                @if (item.Disposition == SceneImageAttemptDisposition.Active)
                                {
                                    <button class="btn btn-sm btn-outline-warning py-0 px-1" title="Shortlist" disabled="@_busy" @onclick="() => SetItemStudioDispositionAsync(item.Id, SceneImageAttemptDisposition.Shortlisted)"><i class="bi bi-star"></i></button>
                                }
                                else if (item.Disposition == SceneImageAttemptDisposition.Shortlisted)
                                {
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Return to Active" disabled="@_busy" @onclick="() => SetItemStudioDispositionAsync(item.Id, SceneImageAttemptDisposition.Active)"><i class="bi bi-star-fill"></i></button>
                                }
                                @if (item.Disposition is SceneImageAttemptDisposition.Active or SceneImageAttemptDisposition.Shortlisted)
                                {
                                    <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Reject" disabled="@_busy" @onclick="() => SetItemStudioDispositionAsync(item.Id, SceneImageAttemptDisposition.Rejected)"><i class="bi bi-x-circle"></i></button>
                                }
                                @if (item.ExecutionStatus == SceneImageStatus.Complete && !string.IsNullOrWhiteSpace(item.Sha256))
                                {
                                    <button class="btn btn-sm btn-outline-success py-0 px-1" title="Approve" disabled="@_busy" @onclick="() => ApproveItemAsync(item.Id)"><i class="bi bi-check2-circle"></i></button>
                                }
                            }
                            else if (IsAssetRoute)
                            {
                                <button class="btn btn-sm btn-outline-success py-0 px-1" title="Accept" disabled="@_busy" @onclick="() => SetItemAssetDecisionAsync(item.Id, SceneAssetCandidateDecision.Accepted)"><i class="bi bi-check2-circle"></i></button>
                                <button class="btn btn-sm btn-outline-info py-0 px-1" title="Shortlist" disabled="@_busy" @onclick="() => SetItemAssetDecisionAsync(item.Id, SceneAssetCandidateDecision.Shortlisted)"><i class="bi bi-star"></i></button>
                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Reject" disabled="@_busy" @onclick="() => SetItemAssetDecisionAsync(item.Id, SceneAssetCandidateDecision.Rejected)"><i class="bi bi-x-circle"></i></button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success py-0 px-1" title="Accept" disabled="@_busy" @onclick="() => SetItemStatusAsync(item.Id, ProducedImageStatus.Accepted)"><i class="bi bi-check2-circle"></i></button>
                                <button class="btn btn-sm btn-outline-info py-0 px-1" title="Shortlist" disabled="@_busy" @onclick="() => SetItemStatusAsync(item.Id, ProducedImageStatus.Shortlisted)"><i class="bi bi-star"></i></button>
                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Reject" disabled="@_busy" @onclick="() => SetItemStatusAsync(item.Id, ProducedImageStatus.Rejected)"><i class="bi bi-x-circle"></i></button>
                            }
                            @if (CanEdit(item))
                            {
                                <a class="btn btn-sm btn-outline-primary py-0 px-1" href="@GetEditUrl(item)" title="Edit this image"><i class="bi bi-pencil-square"></i></a>
                            }
                            @if (CanComposeVideo(item))
                            {
                                <a class="btn btn-sm btn-outline-dark py-0 px-1" href="@GetVideoUrl(item)" title="Compose a video from this image"><i class="bi bi-camera-video"></i></a>
                            }
                            @if (_deleteConfirmId == item.Id)
                            {
                                <button class="btn btn-danger btn-sm py-0 px-1" type="button" @onclick="() => DeleteItemAsync(item.Id)" disabled="@_busy">Delete</button>
                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" type="button" @onclick="CancelDelete" disabled="@_busy">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger py-0 px-1" type="button" @onclick="() => BeginDelete(item.Id)" disabled="@_busy" title="Permanently delete this image"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_viewerOpen && Current is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.85);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Current.Status · <span class="font-monospace small">@Current.Id</span></h5>
                    <button type="button" class="btn-close" @onclick="CloseViewer" title="Close"></button>
                </div>
                <div class="modal-body text-center">
                    @if (!string.IsNullOrWhiteSpace(Current.StoragePath))
                    {
                        <img src="/scene-images/@Current.StoragePath" class="img-fluid" style="max-height:80vh;" alt="Review image @Current.Id" />
                    }
                    else
                    {
                        <div class="text-muted py-5">Image pending</div>
                    }
                </div>
                <div class="modal-footer">
                    @if (!string.IsNullOrWhiteSpace(Current.StoragePath))
                    {
                        <a class="btn btn-outline-secondary btn-sm" href="/scene-images/@Current.StoragePath" target="_blank" title="Open full size"><i class="bi bi-arrows-fullscreen me-1"></i>Open full size</a>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="CloseViewer">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string BatchId { get; set; } = string.Empty;
    [Parameter] public string? RouteKind { get; set; }

    /// <summary>
    /// Where the deck was opened FROM, when the host that linked to it named one. The derived back URL can only reach
    /// the character page, which loses the tab and the cell the operator was working on; this carries the exact place.
    /// </summary>
    [SupplyParameterFromQuery(Name = "return")] public string? ReturnUrl { get; set; }

    /// <summary>Show only the accepted attempts. "accepted" is the only value that filters; absent means all.</summary>
    [SupplyParameterFromQuery(Name = "only")] public string? Only { get; set; }

    private List<ReviewDeckItem> _items = [];
    private int _index;
    private string? _error;
    private bool _busy;
    private bool _viewerOpen;
    private string? _deleteConfirmId;
    private string? _frontBackUrl;
    private List<ReviewDeckItem> _lineageChildren = [];

    private bool _extractOpen;
    private bool _extractBusy;
    private IReadOnlyList<PoseTestModelChoice> _extractModels = [];
    private IReadOnlyList<PoseLibrary> _extractLibraries = [];
    private string? _extractModelId;
    private string? _extractName;
    private string? _extractCategory = "extracted";
    private string? _extractLibraryId;
    private string? _extractError;
    private string? _extractStatus;
    private bool _extractHeadOnly;

    private bool IsStudioRoute => string.Equals(RouteKind, "studio", StringComparison.OrdinalIgnoreCase);
