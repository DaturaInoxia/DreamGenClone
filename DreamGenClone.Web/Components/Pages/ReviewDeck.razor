    private async Task DeleteItemAsync(string imageId)
    {
        if (!string.Equals(_deleteConfirmId, imageId, StringComparison.Ordinal))
            return;

        _busy = true;
        _error = null;
        try
        {
            if (IsAssetRoute)
            {
                await AssetService.DeleteImageAsync(imageId);
            }
            else
            {
                var image = _items.First(item => item.Id == imageId);
                await ImageService.DeleteImageAsync(image.SessionId ?? string.Empty, imageId);
            }

            var deletedIndex = _items.FindIndex(item => item.Id == imageId);
            _items.RemoveAt(deletedIndex);
            _deleteConfirmId = null;
            if (deletedIndex < _index)
                _index--;
            _index = Math.Clamp(_index, 0, Math.Max(0, _items.Count - 1));
            await LoadCurrentAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        _items = IsStudioRoute
            ? await LoadStudioItemsAsync()
            : IsAssetRoute
                ? await LoadAssetItemsAsync()
                : IsDatasetRoute
                    ? await LoadDatasetItemsAsync()
                    : (await ProducedImages.ListByBatchAsync(BatchId)).Select(MapLegacyItem).ToList();
        _index = Math.Clamp(_index, 0, Math.Max(0, _items.Count - 1));
        await LoadCurrentAsync();
    }

    private async Task<List<ReviewDeckItem>> LoadStudioItemsAsync()
    {
        var attempts = await ProductionService.ListAttemptsAsync(BatchId);
        var decisions = await ProductionService.ListApprovalDecisionsAsync(BatchId);
        var approvedImageIds = decisions
            .Where(decision => decision.Decision == ApprovedSceneFrameDecisionState.Approved)
            .Select(decision => decision.SceneImageId)
            .ToHashSet(StringComparer.Ordinal);
        return attempts.Select(attempt => MapStudioItem(attempt, approvedImageIds.Contains(attempt.Id))).ToList();
    }

    private async Task<List<ReviewDeckItem>> LoadAssetItemsAsync()
        => (await AssetService.ListImagesByCandidateBatchAsync(BatchId)).Select(MapAssetItem).ToList();

    /// <summary>
    /// Every attempt across the whole dataset, newest cell order preserved.
    ///
    /// <para>
    /// It reads the SAME attempts the cell list reads, through the same service, and maps them with the same mapper as
    /// an asset batch - so a picture carries the same id, status, decision and edit route here as it does in the cell
    /// workspace. "Accepted" means the attempt's own decision, which is what the cell list shows; dataset members are
    /// not used because accepting an attempt does not create one yet (B-123 P1-05).
    /// </para>
    /// </summary>
    private async Task<List<ReviewDeckItem>> LoadDatasetItemsAsync()
    {
        var dataset = await LoraRepository.GetDatasetAsync(BatchId)
            ?? throw new InvalidOperationException($"LoRA dataset '{BatchId}' was not found.");
        var plan = CoveragePlan.FromStoredJson(dataset.CoveragePlanJson, out _);

        var items = new List<ReviewDeckItem>();
        foreach (var record in plan.Records)
        {
            foreach (var attempt in await LoraCells.ListCellAttemptsAsync(BatchId, record.Key))
            {
                if (OnlyAccepted && attempt.CandidateDecision != SceneAssetCandidateDecision.Accepted)
                {
                    continue;
                }

                items.Add(MapAssetItem(attempt));
            }
        }

        return items;
    }

