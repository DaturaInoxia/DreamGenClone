@page "/roleplay/gallery/{sessionId}"
@rendermode InteractiveServer

@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.Sessions
@using DreamGenClone.Web.Domain.RolePlay
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Domain.ModelManager

@inject ISessionService SessionService
@inject ISceneImageService ImageService
@inject NavigationManager Nav
@inject ILogger<SceneImageGallery> Logger

<PageTitle>Scene Image Gallery - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="/roleplay/workspace/@sessionId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to workspace
            </a>
            <h4 class="d-inline-block ms-2 mb-0">Gallery — @_session?.Title</h4>
        </div>
        <div>
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadAsync" disabled="@_busy">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_session is null)
    {
        <div class="alert alert-warning">Session not found.</div>
    }
    else if (_groups.Count == 0)
    {
        <div class="alert alert-info">No images yet for this session. Generate an image from an interaction to see it here.</div>
    }
    else
    {
        @foreach (var group in _groups)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>@(group.ActorName ?? "Scene")</strong>
                    <span class="text-muted ms-2 small">@group.Excerpt</span>
                    <span class="badge bg-secondary ms-2">@group.Images.Count</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var img in group.Images)
                        {
                            <div class="col-6 col-md-4 col-xl-3">
                                <ImageCard Model="CardModel(img)"
                                           Busy="_busy"
                                           ShowVerdicts="@(img.ProductionGroupId is { Length: > 0 })"
                                           ShortlistRequested="() => ShortlistAsync(img)"
                                           RejectRequested="() => SetDispositionAsync(img, SceneImageAttemptDisposition.Rejected)"
                                           EditRequested="() => OpenEditor(img.InteractionId, img.Id)"
                                           VideoRequested="() => OpenVideoComposer(img.InteractionId, img.Id)"
                                           ViewRequested="() => OpenViewer(img)"
                                           DeleteRequested="() => DeleteImageAsync(img)">
                                    <BodyContent>
                                        @if (img.Status is SceneImageStatus.Pending or SceneImageStatus.Generating)
                                        {
                                            <div class="d-flex align-items-center justify-content-center mt-1">
                                                <span class="spinner-border spinner-border-sm me-2"></span><span class="small">Rendering…</span>
                                            </div>
                                        }
                                    </BodyContent>
                                    <FooterContent>
                                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1"
                                                title="Open this image in Production Studio" @onclick="() => OpenStudio(img)">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </button>
                                    </FooterContent>
                                </ImageCard>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (_viewerImage is not null)
{
    <div class="scene-image-viewer-overlay" @onclick="CloseViewer">
        <div class="scene-image-viewer" @onclick:stopPropagation="true">
            <div class="scene-image-viewer-header">
                <span class="text-muted small">@_viewerImage.Style · @_viewerImage.ImageSize</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseViewer" title="Close (Esc)">
                    &#x2715;
                </button>
            </div>
            <img src="/scene-images/@_viewerImage.FileRelativePath" class="scene-image-viewer-img" alt="Scene image" />
            <div class="scene-image-viewer-footer">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CloseViewer()">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string sessionId { get; set; } = string.Empty;

    private RolePlaySession? _session;
    private List<GalleryGroup> _groups = [];
    private string _errorMessage = string.Empty;
    private bool _busy;
    private SceneImageRecord? _viewerImage;

    private void OpenViewer(SceneImageRecord image) => _viewerImage = image;

    private void CloseViewer() => _viewerImage = null;

    private SceneImageCardModel CardModel(SceneImageRecord img) => new()
    {
        Id = img.Id,
        FileRelativePath = img.FileRelativePath,
        StatusText = img.Status.ToString(),
        StatusBadgeClass = img.Status switch
        {
            SceneImageStatus.Complete => "text-bg-success",
            SceneImageStatus.Failed => "text-bg-danger",
            _ => "text-bg-secondary"
        },
        IsComplete = img.Status == SceneImageStatus.Complete,
        ErrorMessage = img.ErrorMessage,
        Subtitle = StyleSubtitle(img),
        DecisionBadgeText = img.Disposition is SceneImageAttemptDisposition.Shortlisted or SceneImageAttemptDisposition.Rejected
            ? img.Disposition.ToString()
            : null
    };

    private static string? StyleSubtitle(SceneImageRecord img)
        => (img.Style, img.ImageSize) switch
        {
            (null or "", null or "") => null,
            _ => $"{img.Style} · {img.ImageSize}"
        };

    private async Task ShortlistAsync(SceneImageRecord img)
    {
        var current = img.Disposition ?? SceneImageAttemptDisposition.Active;
        var next = current == SceneImageAttemptDisposition.Shortlisted
            ? SceneImageAttemptDisposition.Active
            : SceneImageAttemptDisposition.Shortlisted;
        await SetDispositionAsync(img, next);
    }

    private async Task SetDispositionAsync(SceneImageRecord img, SceneImageAttemptDisposition next)
    {
        if (string.IsNullOrWhiteSpace(img.ProductionGroupId))
        {
            _errorMessage = "This image predates the production pipeline and cannot take a shortlist / reject decision.";
            return;
        }

        _busy = true;
        try
        {
            await ImageService.SetDispositionAsync(
                img.Id,
                img.ProductionGroupId,
                img.Disposition ?? SceneImageAttemptDisposition.Active,
                next);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not update this image's decision: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class GalleryGroup
    {
        public string InteractionId { get; set; } = string.Empty;
        public string? ActorName { get; set; }
        public string Excerpt { get; set; } = string.Empty;
        public List<SceneImageRecord> Images { get; set; } = [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _errorMessage = string.Empty;
        try
        {
            _session = await SessionService.LoadRolePlaySessionAsync(sessionId);
            if (_session is null)
            {
                _errorMessage = "Role-play session not found.";
                return;
            }

            var images = await ImageService.ListImagesBySessionAsync(sessionId);

            _groups = images
                .GroupBy(x => x.InteractionId)
                .Select(g =>
                {
                    var interaction = _session!.Interactions.FirstOrDefault(i => string.Equals(i.Id, g.Key, StringComparison.OrdinalIgnoreCase));
                    return new GalleryGroup
                    {
                        InteractionId = g.Key,
                        ActorName = interaction?.ActorName,
                        Excerpt = Truncate(interaction?.Content ?? string.Empty, 80),
                        Images = g.OrderByDescending(x => x.CreatedUtc).ToList()
                    };
                })
                .OrderByDescending(g => g.Images.Max(x => x.CreatedUtc))
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load gallery: {ex.Message}";
            Logger.LogError(ex, "SceneImageGallery load failed: SessionId={SessionId}", sessionId);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Opens the Production Studio for the image's own production lineage. The exact production
    /// group is preferred because it already pins the beat, moment, and POV the image was rendered
    /// from; the Moment route is used when the image has no group yet, and the plain studio route
    /// remains for legacy images that predate the production pipeline.
    /// </summary>
    private void OpenStudio(SceneImageRecord image)
    {
        if (!string.IsNullOrWhiteSpace(image.ProductionGroupId))
        {
            Nav.NavigateTo($"/roleplay/studio/{sessionId}/{image.InteractionId}/production/{image.ProductionGroupId}");
            return;
        }

        if (!string.IsNullOrWhiteSpace(image.MomentEnrichmentId))
        {
            Nav.NavigateTo($"/roleplay/studio/{sessionId}/{image.InteractionId}/production/moment/{image.MomentEnrichmentId}");
            return;
        }

        Nav.NavigateTo($"/roleplay/studio/{sessionId}/{image.InteractionId}");
    }

    private void OpenEditor(string interactionId, string imageId)
    {
        Nav.NavigateTo($"/roleplay/image-editor/{sessionId}/{interactionId}/{imageId}");
    }

    /// <summary>Opens the Video Composer seeded from this image (B-152 R4).</summary>
    private void OpenVideoComposer(string interactionId, string imageId)
    {
        Nav.NavigateTo($"/roleplay/video-studio/session/{sessionId}/{interactionId}/{imageId}");
    }

    private async Task DeleteImageAsync(SceneImageRecord image)
    {
        _busy = true;
        try
        {
            await ImageService.DeleteImageAsync(sessionId, image.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Truncate(string value, int maxChars)
    {
        var singleLine = value.ReplaceLineEndings(" ").Trim();
        return singleLine.Length <= maxChars ? singleLine : singleLine[..maxChars] + "…";
    }
}
