@page "/pose-library"
@rendermode InteractiveServer

@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.ImageStep
@using Microsoft.Extensions.Options
@inject IPoseLibraryService LibraryService
@inject IPoseLibraryImporter LibraryImporter
@inject IPoseTestRenderService PoseTestRender
@inject ICharacterImageIdentityService IdentityService
@inject IOptions<PoseStudioOptions> StudioOptions

<PageTitle>Pose Library - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h4 class="mb-1">Pose Library</h4>
            <div class="small text-muted">
                Every pose the app can condition a render on. Search by keyword across names, categories and keywords,
                filter by library or category, and keep your own libraries beside the imported pack.
            </div>
        </div>
        <div class="text-end small text-muted">
            <div><strong>@_results.Count</strong> pose(s) shown</div>
            <div><strong>@_libraries.Count</strong> library/libraries</div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold mb-1">Keyword</label>
                    <input type="text" class="form-control form-control-sm" placeholder="standing, kneeling, hand, 029..."
                           value="@_keyword" @oninput="e => _keyword = e.Value?.ToString()" @onkeydown="OnKeywordKeyDownAsync" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Library</label>
                    <select class="form-select form-select-sm" value="@_libraryId" @onchange="OnLibraryFilterChangedAsync">
                        <option value="">All libraries</option>
                        @foreach (var library in _libraries)
                        {
                            <option value="@library.Id">@library.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Category</label>
                    <select class="form-select form-select-sm" value="@_category" @onchange="OnCategoryFilterChangedAsync">
                        <option value="">All categories</option>
                        @foreach (var category in _categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-1 d-grid">
                    <button type="button" class="btn btn-sm btn-primary" disabled="@_busy" @onclick="SearchAsync">Search</button>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ClearFiltersAsync">Clear filters</button>
                @if (_busy)
                {
                    <span class="small text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Working...</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger py-1 small mt-2 mb-0">@_error</div>
            }
            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <div class="alert alert-info py-1 small mt-2 mb-0">@_status</div>
            }
            @if (_metadataNotDeclared.Count > 0)
            {
                <div class="alert alert-warning py-1 small mt-2 mb-0">
                    <strong>@_metadataNotDeclared.Count category/categories have no pose metadata declared</strong>, so
                    their poses carry no prompt and no reference angles:
                    <code>@string.Join(", ", _metadataNotDeclared)</code>.
                    Declare each one in its pack's <code>pack.json</code> — a <code>rating</code> for the pack plus a
                    <code>categories</code> entry for the folder — then search again.
                </div>
            }
        </div>
    </div>

    <PoseAuthorPanel OnSaved="OnPoseSavedAsync" Loaded="_loaded" LoadedFrom="_loadedFrom" />

    <div class="card mb-3">
        <div class="card-header">
            <strong>Test a library pose</strong>
            <span class="d-block small text-muted">
                Renders one throwaway image of the picked pose and saves nothing — no session, no gallery entry. The
                skeleton sent is the pose's <strong>own file</strong>, the same artifact the pose proofs used, so a
                result here can be reproduced outside the app.
                <br />
                Picking a pose also loads <strong>its prompt</strong> (the pose, the direction it faces and the camera,
                as its pack declares them) and resolves the character's references from <strong>the angle the pose
                needs</strong> — the unclothed build for an NSFW pose, and no face at all for a pose shot from behind.
                A character whose pack lacks that angle is refused by name instead of tested with a substitute.
            </span>
        </div>
        <div class="card-body">
            @if (_testPreset is null)
            {
                <div class="small text-muted">Pick a pose with <strong>Test this pose</strong> below.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-lg-3">
                        <div class="d-flex justify-content-center align-items-center bg-black border rounded" style="height: 240px;">
                            @if (LibraryService.SkeletonUrl(_testPreset) is string url)
                            {
                                <img src="@url" alt="@_testPreset.Name skeleton" style="max-height: 236px; max-width: 100%;" />
                            }
                        </div>
                        <div class="form-text"><strong>@_testPreset.Name</strong> — this is the skeleton that will be sent.</div>
                        <div class="small text-muted">
                            @PoseMetadataLabels.Rating(@_testPreset.ContentRating) ·
                            @PoseMetadataLabels.Stance(@_testPreset.Stance) ·
                            @PoseMetadataLabels.Direction(@_testPreset.Direction) ·
                            @PoseMetadataLabels.Camera(@_testPreset.CameraAngle)
                        </div>

                        @* The render sits under the skeleton it came from, so the pair reads as one comparison instead
                           of the image landing beneath the whole composer on the far side of the card. *@
                        @if (_testImageUrl is not null)
                        {
                            <div class="d-flex justify-content-center bg-black border rounded p-2 mt-2">
                                <img src="@_testImageUrl" alt="Pose test render" style="max-width: 100%;" />
                            </div>
                        }
                    </div>
                    <div class="col-lg-9">
                        @* B-130: the step is presented by the ONE composer. This page used to lay out its own model
                           select, its own prompt box and its own submit button - a fourth copy of the same form. What
                           this page owns is now data: the selected preset (seeded into the pose slot), the seed, and
                           the canvas. *@
                        <ImageStepComposer Blueprint="TestBlueprint"
                                           ModelChoices="TestModelChoices"
                                           SelectedModelId="@_testModelId"
                                           SelectedModelIdChanged="OnTestModelChangedAsync"
                                           Bindings="_testBindings"
                                           BindingsChanged="OnTestBindingsChanged"
                                           Prompt="@(_testPrompt ?? string.Empty)"
                                           PromptChanged="OnTestPromptChanged"
                                           Busy="_testBusy"
                                           CanSubmit="CanTestPose()"
                                           SubmitLabel="Test this pose"
                                           SubmitBlockedReason="@TestBlockedReason()"
                                           OnSubmit="RunTestAsync">
                            <ChildContent>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold mb-1">Character</label>
                                        @* The test is run ON a character when one is picked: their approved face and build
                                           travel beside the skeleton, so the result is what the app would render. *@
                                        <select class="form-select form-select-sm" value="@_characterProfileId"
                                                disabled="@_testBusy"
                                                @onchange="e => OnCharacterChangedAsync(e.Value?.ToString())">
                                            <option value="">— nobody (pose only) —</option>
                                            @foreach (var character in _characters)
                                            {
                                                <option value="@character.CharacterProfileId">
                                                    @character.DisplayName (pack v@character.PackVersion)
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold mb-1">Seed (optional)</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="random"
                                               value="@_testSeed" @oninput="e => _testSeed = e.Value?.ToString()" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold mb-1">Canvas</label>
                                        <input type="text" class="form-control form-control-sm"
                                               value="@_testSize" @oninput="e => _testSize = e.Value?.ToString()" />
                                    </div>
                                    <div class="col-md-3">
                                        <span class="form-text">@TestMechanismHint()</span>
                                    </div>
                                </div>
                                @if (TestReferencePlan is { } plan)
                                {
                                    <div class="form-text">
                                        This pose needs <strong>@ReferenceRequirementText(plan)</strong>. @plan.Rationale
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_characterError))
                                {
                                    <div class="alert alert-warning py-1 small mt-2 mb-0">@_characterError</div>
                                }
                                else if (_characterReference is not null)
                                {
                                    <div class="form-text">
                                        Conditioning on <strong>@_characterReference.Label</strong>:
                                        @_characterReference.FaceLabel and @_characterReference.BodyLabel, sent beside
                                        the skeleton.
                                    </div>
                                }
                            </ChildContent>
                        </ImageStepComposer>
                        @if (!string.IsNullOrWhiteSpace(_testError))
                        {
                            <div class="alert alert-danger py-1 small mt-2 mb-0">@_testError</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_testNote))
                        {
                            <div class="alert alert-info py-1 small mt-2 mb-0">@_testNote</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_results.Count == 0 && !_busy)
    {
        <div class="alert alert-warning py-2 small mb-0">
            @if (_totalPoses == 0)
            {
                <strong>This library is empty.</strong>
                <span> No pose is in this database yet. The bundled pack is imported automatically when this page
                searches, so an empty result every time means that import is failing — its reason is shown above.</span>
            }
            else
            {
                <strong>No pose matches these filters.</strong>
                <span> The library holds @_totalPoses pose(s); clear the filters to see them.</span>
            }
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var preset in _results)
            {
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="card h-100">
                        <div class="d-flex justify-content-center align-items-center bg-black" style="height: 160px;">
                            @if (LibraryService.SkeletonUrl(preset) is string url)
                            {
                                <img src="@url" alt="@preset.Name skeleton" style="max-height: 156px; max-width: 100%;" />
                            }
                            else
                            {
                                <span class="text-muted small">no skeleton</span>
                            }
                        </div>
                        <div class="card-body p-2">
                            <div class="small fw-semibold text-truncate" title="@preset.Name">@preset.Name</div>
                            <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                                <span class="badge text-bg-secondary">@preset.Category</span>
                                @if (preset.KnownGood)
                                {
                                    <span class="badge text-bg-success" title="Measured to hold under the control model">known-good</span>
                                }
                                @* What the pose IS, as declared by its pack and checked against its own keypoints. The
                                   rating is on the card because it decides the prompt AND which body reference the test
                                   will load — the two things an operator would otherwise have to guess at. *@
                                @if (preset.ContentRating == PoseContentRating.Unrated)
                                {
                                    <span class="badge text-bg-light border" title="@NoMetadataHint(preset)">not declared</span>
                                }
                                else
                                {
                                    <span class="badge @RatingBadgeCss(preset.ContentRating)">@PoseMetadataLabels.Rating(preset.ContentRating)</span>
                                }
                                @if (preset.Stance != PoseStance.Unknown)
                                {
                                    <span class="badge text-bg-primary">@PoseMetadataLabels.Stance(preset.Stance)</span>
                                }
                                @if (preset.Direction != PoseFacingDirection.Unknown)
                                {
                                    <span class="badge text-bg-info">@PoseMetadataLabels.Direction(preset.Direction)</span>
                                }
                                @if (preset.CameraAngle != PoseCameraAngle.Unknown)
                                {
                                    <span class="badge text-bg-dark">@PoseMetadataLabels.Camera(preset.CameraAngle)</span>
                                }
                                @if (preset.MetadataNeedsReview)
                                {
                                    <span class="badge text-bg-warning" title="@preset.MetadataReviewNote">check pose</span>
                                }
                            </div>
                            <div class="small text-muted mt-1 text-truncate" title="@preset.Keywords">@preset.Keywords</div>
                            @if (preset.MetadataPrompt is { Length: > 0 } cardPrompt)
                            {
                                <div class="small text-body-secondary mt-1" title="@cardPrompt">
                                    <i class="bi bi-chat-left-text me-1"></i>@cardPrompt
                                </div>
                            }
                            @if (preset.MetadataNeedsReview)
                            {
                                <div class="small text-warning-emphasis mt-1">@preset.MetadataReviewNote</div>
                            }
                            <div class="d-grid gap-1 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_busy || _testBusy)"
                                        @onclick="() => SelectForTestAsync(preset)">
                                    <i class="bi bi-eye me-1"></i>Test this pose
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                                        @onclick="() => OpenInEditorAsync(preset)">
                                    <i class="bi bi-pencil-square me-1"></i>Open in editor
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<PoseLibrary> _libraries = [];
    private IReadOnlyList<PosePreset> _results = [];
    private IReadOnlyList<string> _categories = [];
    private string? _keyword;
    private string? _category;
    private string? _libraryId;
    private string? _error;
    private string? _status;
    private bool _busy;

    /// <summary>
    /// Categories whose own pack declares no metadata for them, as reported by the backfill. Held so the page can NAME
    /// them: a pose with no declaration has no prompt and no reference angles, and the fix is one block in one
    /// pack.json — which the operator cannot write without knowing which pack and which category.
    /// </summary>
    private IReadOnlyList<string> _metadataNotDeclared = [];

    /// <summary>How many poses the library holds with NO filters. Only read when a search came back empty, because
    /// that is the only moment the difference between an empty library and an over-narrow filter matters.</summary>
    private int _totalPoses;

    /// <summary>The rig fitted onto a library pose, handed to the authoring panel as its starting point.</summary>
    private PoseRigFitResult? _loaded;

    /// <summary>The preset <see cref="_loaded"/> came from, so the panel can name it and write over the row it came from.</summary>
    private PosePreset? _loadedFrom;

    /// <summary>
    /// The library pose selected for a test render, plus that render's state.
    ///
    /// The test lives on the PAGE rather than only inside the authoring panel because the panel works on a rig FIT:
    /// the bytes it can offer are the projection of the fitted rig, so a pose the rig cannot place would be
    /// untestable, and the thing tested would be a projection of the pose rather than the pose. From here the bytes
    /// sent are the preset's OWN skeleton - the same artifact the recorded proof used - which is what makes a test
    /// result reproducible outside the UI.
    /// </summary>
    private PosePreset? _testPreset;
    private IReadOnlyList<PoseTestModelChoice> _testModels = [];
    private string? _testModelId;
    private string? _testPrompt;
    private string? _testSeed;
    private string _testSize = "1024x1024";
    private string? _testImageUrl;
    private string? _testNote;
    private string? _testError;
    private bool _testBusy;
    private IReadOnlyList<ReferenceApplicationSelection> _testBindings = [];

    /// <summary>
    /// Every character with an APPROVED identity pack, so the test can be run on someone rather than on nobody. A
    /// character is a first-class choice here now: the same approved references the identity renders use are what the
    /// pose is tested against, which is what makes a test result transferable to a real render.
    /// </summary>
    private IReadOnlyList<IdentityPackOwner> _characters = [];
    private string? _characterProfileId;

    /// <summary>The picked character's conditioned references, resolved once per pose/character pick.</summary>
    private PoseTestCharacterReference? _characterReference;

    private string? _characterError;

    /// <summary>
    /// A character's approved references for the POSE's angles, with the pack and asset ids the step's bindings need.
    ///
    /// The face is optional and its absence is a fact about the pose, not a failure to resolve: a back-facing pose
    /// shows no face, so no face reference is resolved and none is sent. Everything else is required, and a missing
    /// angle is reported rather than substituted.
    /// </summary>
    private sealed record PoseTestCharacterReference(
        string Label,
        string PackId,
        string? FaceAssetId,
        string BodyAssetId,
        byte[]? FaceBytes,
        byte[] BodyBytes,
        string FaceLabel,
        string BodyLabel);

    /// <summary>
    /// The reference images the SELECTED POSE requires, from the direction and rating its pack declares. Null until a
    /// pose is picked, because with no pose there is nothing that could justify one angle over another.
    /// </summary>
    private PoseReferencePlan? TestReferencePlan =>
        _testPreset is null ? null : PoseMetadataPrompt.ReferencePlan(_testPreset);

    /// <summary>
    /// Resolves the picked character's APPROVED references for the pose's OWN angles.
    ///
    /// This used to resolve a front face and a clothed front build, whatever the pose was. That was a silent claim:
    /// 472 of the 579 poses in this library are NSFW, so the test conditioned a naked pose on a clothed reference, and
    /// the render came back clothed (or invented clothing) while the skeleton said otherwise. The angles now come from
    /// the pose, and a character who cannot serve them is REFUSED by name rather than tested with a substitute — a
    /// substitute reference measures something the app would never render.
    /// </summary>
    private async Task OnCharacterChangedAsync(string? characterProfileId)
    {
        _characterProfileId = characterProfileId;
        _characterReference = null;
        _characterError = null;

        if (string.IsNullOrWhiteSpace(characterProfileId))
        {
            _testBindings = StepBindings();
            return;
        }

        var owner = _characters.FirstOrDefault(candidate =>
            string.Equals(candidate.CharacterProfileId, characterProfileId, StringComparison.Ordinal));
        if (owner is null)
        {
            _characterError = "That character is no longer listed. Pick another.";
            return;
        }

        if (_testPreset is not { } pose || TestReferencePlan is not { } plan)
        {
            _characterError =
                "Pick a pose first: which face and body references the test sends comes from what that pose needs.";
            return;
        }

        if (plan.BodyView is not { } bodyView || plan.BodyState is not { } bodyState)
        {
            // The refusal wording lives beside the plan (PoseReferenceRequirement), so the pose library's test render and
            // a pose SUITE run explain the same missing angle the same way.
            _characterError = PoseReferenceRequirement.Unplannable(pose.Name, plan);
            return;
        }

        // A back-facing pose shows no face, so no face reference is resolved AND none is sent. Substituting the front
        // face here is the failure this whole path exists to avoid: it would put a face where the pose has none.
        SceneImageReferenceAsset? faceAsset = null;
        if (plan.FaceView is { } faceView)
        {
            faceAsset = IdentityPackReferenceResolver.ResolveFace(owner.ApprovedAssets, faceView);
            if (faceAsset is null)
            {
                _characterError = PoseReferenceRequirement.MissingFace(owner, pose.Name, pose.Direction);
                return;
            }
        }

        var bodyAsset = IdentityPackReferenceResolver.ResolveBody(owner.ApprovedAssets, bodyView, bodyState);
        if (bodyAsset is null)
        {
            _characterError = PoseReferenceRequirement.MissingBody(
                owner, pose.Name, pose.Direction, pose.ContentRating, bodyState);
            return;
        }

        try
        {
            var faceBytes = faceAsset is null ? null : await IdentityService.ReadAssetBytesAsync(faceAsset);

            _characterReference = new PoseTestCharacterReference(
                Label: owner.DisplayName,
                PackId: owner.PackId,
                FaceAssetId: faceAsset?.Id,
                BodyAssetId: bodyAsset.Id,
                FaceBytes: faceBytes,
                BodyBytes: await IdentityService.ReadAssetBytesAsync(bodyAsset),
                FaceLabel: plan.FaceView is null
                    ? "no face reference (this pose shows no face)"
                    : $"approved {PoseMetadataLabels.Direction(pose.Direction)} face",
                BodyLabel: $"approved {(bodyState == SceneImageReferenceBodyState.Unclothed ? "unclothed" : "clothed")} "
                    + $"{PoseMetadataLabels.Direction(pose.Direction)} build");
            _testNote = null;
        }
        catch (Exception exception)
        {
            _characterError = exception.Message;
        }

        // The step's bindings follow the character, so its face and build elements show as SUPPLIED rather than as
        // empty slots the operator is left to fill in one by one.
        _testBindings = StepBindings();
    }

    /// <summary>The step this page presents, built by the one factory that owns host knowledge.</summary>
    private ImageStepBlueprint TestBlueprint => ImageStepBlueprintFactory.ForPoseLibraryTest(TestCharacterActor);

    /// <summary>
    /// The pose-capable models, as composer choices. Only models that can ACTUALLY carry a pose are listed: this page
    /// used to render an option per model and grey out the ones that could not, which is a control the operator can
    /// never satisfy pretending to be a choice (D3). The mechanism the render would take becomes the choice's
    /// qualified strategy, so the composer's strategy menu comes from the same decision the render makes.
    /// </summary>
    private IReadOnlyList<SceneImageModelChoice> TestModelChoices =>
        _testModels
            .Where(model => model.CanCarryPose)
            .Select(model => new SceneImageModelChoice(
                model.ModelId, model.DisplayName, model.Mechanism, model.ProviderName, HasIdentity: false)
            {
                QualifiedStrategies = [model.Mechanism],
                // The MODEL's own reference capacity. This used to be a hard-coded 1 - "one slot, one skeleton" - which
                // was true only while the pose was the sole element: the moment a character's face and build are bound
                // alongside it, a budget of one refuses the step outright.
                MaxReferences = model.MaxReferences
            })
            .ToList();

    /// <summary>
    /// <summary>The character the pose is tested on, as the blueprint's actor, or null when none is picked.</summary>
    private ImageStepActor? TestCharacterActor => _characterProfileId is { Length: > 0 } profileId
        ? new ImageStepActor(profileId, _characterReference?.Label ?? profileId)
        : null;

    /// <summary>The bindings for the character's own elements, for the angle the POSE needs.</summary>
    private IReadOnlyList<ReferenceApplicationSelection> CharacterBindings()
    {
        if (_characterProfileId is not { Length: > 0 } profileId || _characterReference is not { } reference)
        {
            return [];
        }

        // Face and body are ADDRESSED to the character, because both are per-character slots. The strategy is the
        // reference-image route, which is the only route that carries them beside a pose.
        var bindings = new List<ReferenceApplicationSelection>(2);

        // A pose that shows no face has no face element at all, so the step is never left holding a slot the render
        // would have to drop.
        if (reference.FaceAssetId is { Length: > 0 } faceAssetId)
        {
            bindings.Add(new ReferenceApplicationSelection
            {
                ElementKey = ReferenceStrategyCatalogue.ElementKeyForSlot(ImageStepSlotKind.Face),
                SemanticRole = reference.FaceLabel,
                Kind = ImageStepSlotKind.Face.ToString(),
                ActorKey = profileId,
                Source = ImageStepReferenceSourceKind.IdentityPackAsset.ToString(),
                Strategy = ReferenceStrategyResolver.IdentityNativeMultiReference,
                IdentityPackId = reference.PackId,
                ReferenceAssetId = faceAssetId
            });
        }

        bindings.Add(new ReferenceApplicationSelection
        {
            ElementKey = ReferenceStrategyCatalogue.ElementKeyForSlot(ImageStepSlotKind.Body),
            SemanticRole = reference.BodyLabel,
            Kind = ImageStepSlotKind.Body.ToString(),
            ActorKey = profileId,
            Source = ImageStepReferenceSourceKind.IdentityPackAsset.ToString(),
            Strategy = ReferenceStrategyResolver.IdentityNativeMultiReference,
            IdentityPackId = reference.PackId,
            ReferenceAssetId = reference.BodyAssetId
        });

        return bindings;
    }

    /// <summary>
    /// The step's bindings: the pose's own skeleton, then the character's face and build when one is picked. ASSIGNED
    /// rather than seeded - the composer has no seed parameter on purpose, because a seed list keeps re-adding a
    /// binding the operator just cleared.
    /// </summary>
    private IReadOnlyList<ReferenceApplicationSelection> StepBindings()
        => [.. TestSeedBindings, .. CharacterBindings()];
    private IReadOnlyList<ReferenceApplicationSelection> TestSeedBindings =>
        _testPreset is null
            ? []
            : [
                new ReferenceApplicationSelection
                {
                    ElementKey = ReferenceStrategyCatalogue.ElementKeyForSlot(ImageStepSlotKind.Pose),
                    SemanticRole = "pose skeleton",
                    Kind = ImageStepSlotKind.Pose.ToString(),
                    Source = ImageStepReferenceSourceKind.PoseLibrarySkeleton.ToString(),
                    Strategy = ReferenceStrategyResolver.IdentityNativeMultiReference,
                    SkeletonRelativePath = _testPreset.SkeletonPngPath
                }
            ];

    /// <summary>The binding the step will actually send as its pose.</summary>
    private ReferenceApplicationSelection? TestSkeletonBinding =>
        _testBindings.FirstOrDefault(binding =>
            string.Equals(binding.Kind, ImageStepSlotKind.Pose.ToString(), StringComparison.OrdinalIgnoreCase));

    private Task OnTestModelChangedAsync(string? modelId)
    {
        _testModelId = modelId;
        return Task.CompletedTask;
    }

    private Task OnTestBindingsChanged(IReadOnlyList<ReferenceApplicationSelection> bindings)
    {
        _testBindings = bindings;
        return Task.CompletedTask;
    }

    private Task OnTestPromptChanged(string? prompt)
    {
        _testPrompt = prompt;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
        await LoadTestModelsAsync();
    }

    /// <summary>
    /// The models a pose can be tested against, each with the mechanism it would really use. Failing to load them
    /// must not take out the library, so the reason is surfaced where the test panel sits.
    /// </summary>
    private async Task LoadTestModelsAsync()
    {
        try
        {
            _testModels = await PoseTestRender.ListModelsAsync();

            // The first model that CAN carry a pose, from a list the service already ordered reference-route first,
            // so the default is the mechanism this work is built on rather than whatever sorts first by name.
            _testModelId = _testModels.FirstOrDefault(model => model.CanCarryPose)?.ModelId;

            // The characters a pose can be tested ON. A failure here must not take out the model list, so it is
            // reported in its own place rather than thrown into the page-level error.
            try
            {
                _characters = await IdentityService.ListPackOwnersAsync();

                // The step opens ON a character that can actually serve the references, so its face, build and wardrobe
                // elements are present from the first render. Making the operator discover that they must pick someone
                // before the tabs exist is not a design - the tabs ARE the feature. A character is skipped rather than
                // chosen when it cannot serve them, so the default never lands on a roster entry the page would then
                // refuse.
                // The default character is the first who can serve the POSE's own references. With no pose picked yet,
                // the first preference is what most of this library needs — an unclothed front build with a front face
                // (472 of the 579 poses are NSFW) — and the second is the clothed one. A character who can serve
                // neither is simply not chosen: the page then names what is missing the moment a pose is picked,
                // instead of defaulting to someone whose references would be silently substituted.
                if (string.IsNullOrWhiteSpace(_characterProfileId))
                {
                    var chosen = DefaultCharacterSearchOrder()
                        .Select(plan => _characters.FirstOrDefault(owner => CanServe(owner, plan)))
                        .FirstOrDefault(owner => owner is not null);

                    if (chosen is not null)
                    {
                        await OnCharacterChangedAsync(chosen.CharacterProfileId);
                    }
                    else
                    {
                        _characterError = _characters.Count == 0
                            ? "No character has an approved identity pack yet, so a pose can be tested on nobody."
                            : "No character's approved pack can serve a pose's references yet (a face plus a front build, "
                                + "clothed or unclothed), so a pose can be tested on nobody.";
                    }
                }
            }
            catch (Exception characters)
            {
                _characterError = $"The character roster could not be listed: {characters.Message}";
            }
        }
        catch (Exception ex)
        {
            _testError = $"The test render could not list image models: {ex.Message}";
        }
    }

    /// <summary>Selects a library pose for testing without fitting a rig onto it.</summary>
    private async Task SelectForTestAsync(PosePreset preset)
    {
        _testPreset = preset;
        _testError = null;
        _testNote = null;
        _testImageUrl = null;
        // The step's bindings are ASSIGNED here rather than seeded. The composer has no seed parameter by design:
        // a seed list would keep re-adding a binding the operator had just cleared, because clearing it does not
        // change what this rule resolves to. A binding left over from the previous pose would hold the old artifact,
        // and the step would then (correctly) refuse to render it.
        _testBindings = StepBindings();

        // The POSE's prompt replaces whatever is in the box, on every pick. That is what makes the test comparable to
        // the recorded pose proof: the words describe the pose that is about to be rendered, including the two things
        // a skeleton cannot say — which way the figure faces and where the camera sits.
        _testPrompt = preset.MetadataPrompt is { Length: > 0 } posePrompt ? posePrompt : PoseTestPrompts.Default;

        // The references follow the pose, so the character's angles are re-resolved against what this pose needs.
        await OnCharacterChangedAsync(_characterProfileId);
    }

    /// <summary>True only when a pose is selected, the selected model can carry a pose, AND the step still sends that
    /// pose's OWN skeleton - the bytes the pose proofs used, which is what makes a test here reproducible outside the
    /// app. A slot pointing at a different artifact is refused by name instead of silently rendering something else.</summary>
    private bool CanTestPose() =>
        _testPreset is not null
        && _testModels.Any(model => model.ModelId == _testModelId && model.CanCarryPose)
        && CharacterIsReady
        && string.Equals(TestSkeletonBinding?.SkeletonRelativePath, _testPreset.SkeletonPngPath, StringComparison.Ordinal);

    /// <summary>
    /// Whether the character choice is usable: no character picked is fine (a pose on nobody), but a picked character
    /// whose references could not be resolved is not - the test would otherwise run unconditioned and look like it
    /// tested the character.
    /// </summary>
    private bool CharacterIsReady =>
        string.IsNullOrWhiteSpace(_characterProfileId) || _characterReference is not null;

    /// <summary>Why the test cannot run, named rather than left to a greyed-out button.</summary>
    private string? TestBlockedReason()
    {
        if (_testPreset is null) return "Pick a pose from the library below.";
        if (!_testModels.Any(model => model.ModelId == _testModelId && model.CanCarryPose))
            return "Choose a model that can carry a pose.";
        if (!CharacterIsReady)
            return _characterError ?? "The picked character's references could not be resolved.";
        if (TestSkeletonBinding is null) return "Bind the pose slot: this step sends the pose's own skeleton.";
        if (!string.Equals(TestSkeletonBinding.SkeletonRelativePath, _testPreset.SkeletonPngPath, StringComparison.Ordinal))
            return $"The pose slot points at a different skeleton. This test renders '{_testPreset.Name}' - pick the "
                + "pose from the library grid to change what is tested.";

        return null;
    }

    /// <summary>
    /// The reference plans the default character is chosen against, most-preferred first: the selected pose's own
    /// plan when a pose is picked, otherwise an unclothed front build (the first preference, because most of this
    /// library is NSFW) and then a clothed one.
    /// </summary>
    private IReadOnlyList<PoseReferencePlan> DefaultCharacterSearchOrder()
    {
        if (TestReferencePlan is { } selected) return [selected];

        return
        [
            new PoseReferencePlan(
                SceneImageReferenceFaceView.Front,
                SceneImageReferenceBodyView.Front,
                SceneImageReferenceBodyState.Unclothed,
                "the first preference: an unclothed front build"),
            new PoseReferencePlan(
                SceneImageReferenceFaceView.Front,
                SceneImageReferenceBodyView.Front,
                SceneImageReferenceBodyState.Clothed,
                "the second preference: a clothed front build")
        ];
    }

    /// <summary>True when the character's approved pack can serve every reference the plan asks for.</summary>
    private static bool CanServe(IdentityPackOwner owner, PoseReferencePlan plan)
    {
        if (plan.BodyView is not { } view || plan.BodyState is not { } state) return false;
        if (IdentityPackReferenceResolver.ResolveBody(owner.ApprovedAssets, view, state) is null) return false;

        return plan.FaceView is not { } face
            || IdentityPackReferenceResolver.ResolveFace(owner.ApprovedAssets, face) is not null;
    }

    /// <summary>The rating badge's colour, so NSFW is not the same grey as everything else on the card.</summary>
    private static string RatingBadgeCss(PoseContentRating rating) =>
        rating == PoseContentRating.Nsfw ? "text-bg-danger" : "text-bg-success";

    /// <summary>What to tell the operator about a pose whose pack declares nothing about it.</summary>
    private static string NoMetadataHint(PosePreset preset) =>
        $"This pose's pack declares no metadata for '{preset.Category}', so it has no prompt and no reference angles. "
        + "Add a \"rating\" and a \"categories\" entry to the pack's pack.json (see pose-packs/README.md).";

    /// <summary>
    /// The references the pose needs, in one line, so the operator sees what will be loaded BEFORE pressing the button.
    /// Every "not declared" is named as such rather than dressed up as a value.
    /// </summary>
    private static string ReferenceRequirementText(PoseReferencePlan plan)
    {
        if (plan.BodyView is not { } bodyView)
        {
            return "no reference angles (its pack declares no direction)";
        }

        var state = plan.BodyState switch
        {
            SceneImageReferenceBodyState.Unclothed => "unclothed",
            SceneImageReferenceBodyState.Clothed => "clothed",
            _ => "state not declared"
        };

        var body = $"{bodyView} body ({state})";
        return plan.FaceView is { } faceView ? $"{faceView} face + {body}" : $"{body}, no face";
    }

    /// <summary>
    /// Names the mechanism the selected model will use, or the resolver's reason it cannot carry the pose, so the
    /// words on screen and the graph that runs come from the same decision.
    /// </summary>
    private string TestMechanismHint()
    {
        var selected = _testModels.FirstOrDefault(model => model.ModelId == _testModelId);
        if (selected is null)
        {
            return "Pick a model to see how it will carry the pose.";
        }

        return selected.CanCarryPose
            ? $"This model carries the pose through: {selected.MechanismLabel}."
            : $"This model cannot carry a pose: {selected.Reason}";
    }

    /// <summary>
    /// Renders one throwaway image of the SELECTED pose. The skeleton is read from the library, so the bytes that
    /// condition the render are the preset's own artifact - the proof's input - and not a rig projection of it.
    /// Nothing is persisted: no session, no gallery entry.
    /// </summary>
    private async Task RunTestAsync()
    {
        if (_testPreset is null) return;

        _testBusy = true;
        _testError = null;
        _testNote = null;
        _testImageUrl = null;
        try
        {
            long? seed = null;
            if (!string.IsNullOrWhiteSpace(_testSeed))
            {
                // Refused rather than ignored: a seed that silently became "random" would make two runs differ for
                // a reason the operator cannot see.
                if (!long.TryParse(_testSeed.Trim(), out var parsed))
                {
                    throw new InvalidOperationException(
                        $"'{_testSeed}' is not a whole-number seed. Leave it blank for a random one.");
                }

                seed = parsed;
            }

            var skeleton = await LibraryService.ReadSkeletonAsync(_testPreset.Id);

            // Character conditioning: the pose is tested ON a character when one is picked, so the skeleton goes in
            // beside that character's approved face and build - the same three references the render path sends, in
            // the same order. Named arguments, so a new request field cannot shift them.
            var result = await PoseTestRender.RenderAsync(new PoseTestRenderRequest(
                Skeleton: skeleton,
                PoseLabel: _testPreset.Name,
                ModelId: _testModelId ?? string.Empty,
                Prompt: _testPrompt ?? string.Empty,
                Size: _testSize,
                Seed: seed,
                FaceReference: _characterReference?.FaceBytes,
                BodyReference: _characterReference?.BodyBytes,
                CharacterLabel: _characterReference?.Label));

            _testImageUrl = "data:image/png;base64," + Convert.ToBase64String(result.Image);
            _testNote = $"Sent the library skeleton for '{_testPreset.Name}' ({skeleton.Length:N0} bytes). "
                + $"Carried the pose through: {result.Mechanism}. {result.Note}";
        }
        catch (Exception ex)
        {
            _testError = ex.Message;
        }
        finally
        {
            _testBusy = false;
        }
    }

    private async Task OnKeywordKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            await SearchAsync();
        }
    }

    private async Task OnLibraryFilterChangedAsync(ChangeEventArgs args)
    {
        _libraryId = args.Value?.ToString();
        await SearchAsync();
    }

    private async Task OnCategoryFilterChangedAsync(ChangeEventArgs args)
    {
        _category = args.Value?.ToString();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await EnsureBundledPackAsync();
            await EnsurePoseMetadataAsync();
            _libraries = await LibraryService.ListLibrariesAsync();
            _categories = await LibraryService.ListCategoriesAsync();
            _results = await LibraryService.SearchAsync(new PoseLibraryQuery(_keyword, _category, _libraryId));

            // Asked only when nothing matched: an empty library and a filter that excluded everything need opposite
            // actions, and naming the wrong one is how a working search reads as a broken one.
            if (_results.Count == 0)
            {
                _totalPoses = (await LibraryService.SearchAsync(new PoseLibraryQuery())).Count;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Seeds the bundled pack the first time it is needed, so a pack that ships with the app is simply present. It
    /// runs before the search, and a failure is SURFACED rather than swallowed: the library stays browsable, but the
    /// operator is told why it is empty instead of being left to conclude the search is broken.
    /// </summary>
    private async Task EnsureBundledPackAsync()
    {
        try
        {
            var seeded = await LibraryImporter.EnsureBundledPackAsync();
            if (seeded is not null)
            {
                _status = $"Imported the bundled pose pack: {seeded.PresetsImported} pose(s) added, "
                    + $"{seeded.SkeletonsRendered} skeleton(s) rendered. This happens once.";
            }
        }
        catch (Exception ex)
        {
            _error = $"The bundled pose pack could not be imported: {ex.Message}";
        }
    }

    /// <summary>
    /// Fills in pose metadata for rows imported before it existed — the packs shipped first, metadata second — and
    /// writes nothing when every row already has it, which is why it can run on every search instead of once.
    ///
    /// A category a pack declares nothing for is NAMED rather than passed over: it is a state the operator can fix in
    /// that pack's pack.json, and the alternative it produces — a pose with no wording and no reference angles — is the
    /// failure this whole path exists to prevent. The backfill never overwrites metadata that is already stored, so an
    /// edited prompt survives it.
    /// </summary>
    private async Task EnsurePoseMetadataAsync()
    {
        try
        {
            var filled = await LibraryImporter.EnsureMetadataAsync();
            _metadataNotDeclared = filled.NotDeclared;

            if (filled.Filled > 0)
            {
                _status = $"Filled in pose metadata for {filled.Filled} pose(s) imported before it existed — each now "
                    + "has a rating, a stance, a camera angle and a prompt.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Pose metadata could not be filled in: {ex.Message}";
        }
    }

    private async Task ClearFiltersAsync()
    {
        _keyword = null;
        _category = null;
        _libraryId = null;
        await SearchAsync();
    }

    /// <summary>
    /// Shows the pose that was just saved. The filters are moved to it rather than left as they were: a new pose
    /// that does not appear because a stale filter excludes it reads as a failed save.
    /// /// </summary>
    private async Task OnPoseSavedAsync(PosePreset preset)
    {
        _keyword = null;
        _category = null;
        _libraryId = preset.LibraryId;

        _libraries = await LibraryService.ListLibrariesAsync();
        _categories = await LibraryService.ListCategoriesAsync();
        _results = await LibraryService.SearchAsync(new PoseLibraryQuery(null, null, _libraryId));
    }

    /// <summary>
    /// Fits the rig onto a library pose and hands it to the authoring panel, so a pose that was never authored here
    /// — a pack pose extracted from a photograph — can still be edited with every tool: the 5° arrows, the head
    /// tool and the drag editor.
    ///
    /// The fit is an approximation, because a single 2D view carries no depth, so its residual travels with it and
    /// is shown rather than hidden. A pose that cannot be fitted at all (too few visible joints) reports the reason
    /// instead of opening an empty editor.
    /// </summary>
    private Task OpenInEditorAsync(PosePreset preset)
    {
        _error = null;
        _status = null;
        try
        {
            var observed = OpenPosePoseJson.Parse(preset.KeypointsJson, preset.Name);

            // A HEAD pose is opened as one, rather than refused. A body rig fitted onto
            // five head joints is not an approximation of this pose, it is a different thing — and because the 5°
            // arrows re-project through the FIT's rotations, every nudge afterwards would be built on that.
            if (PoseFaceProxy.IsHeadPose(observed))
            {
                // The test is the JOINT COUNT, not the presence of a face channel. A face-framed crop makes DWPose
                // report a handful of body joints that are not in the picture, but a full-body pose that also carries a
                // face is still a body pose — and the guard this replaces refused those too, rejecting poses the rig
                // fits perfectly well.
                //
                // Handed over with NO fit, because the panel's Head step turns the FACE itself: its arrows work on the
                // pose without a rig being fitted onto joints that are not there.
                _loaded = null;
                _loadedFrom = preset;
                _status = $"Opened '{preset.Name}' as a head pose: it carries a face and no body, so the Head step turns "
                    + "the head itself. Save writes your changes over it; Save As makes a new pose.";
                return Task.CompletedTask;
            }

            var fitted = PoseRigFit.Fit(observed, StudioOptions.Value);

            // The residual travels with the fit, and now decides whether the pose may be edited at all. The arrows
            // project the rig through the FIT's rotations, so a fit that did not converge does not merely look
            // approximate — it turns the next nudge into a pose that is not the one that was opened.
            if (fitted.MeanErrorPercentOfHeight > PoseRigFit.UsableMeanErrorPercentOfHeight)
            {
                throw new InvalidOperationException(
                    $"the rig fitted onto it only to {fitted.MeanErrorPercentOfHeight:0.0}% mean joint error across "
                    + $"{fitted.JointsMatched} joints, past the {PoseRigFit.UsableMeanErrorPercentOfHeight:0.0}% a fit "
                    + "has to reach before its rotations can be edited: the 5° arrows would project a pose that is not "
                    + "this one. It can still be picked and rendered as it is.");
            }

            _loaded = fitted;
            _loadedFrom = preset;

            _status = $"Fitted the rig onto '{preset.Name}': {fitted.MeanErrorPercentOfHeight:0.0}% mean joint error. "
                + "Edit it in the panel above — Save writes your changes over it, Save As makes a new pose.";
        }
        catch (Exception ex)
        {
            // Deliberately not left half-loaded: a failed fit must not leave the panel editing the previous pose
            // while the message claims otherwise.
            _loaded = null;
            _loadedFrom = null;
            _error = $"'{preset.Name}' could not be opened in the editor: {ex.Message}";
        }

        return Task.CompletedTask;
    }
}
