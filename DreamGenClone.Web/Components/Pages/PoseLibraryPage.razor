    private async Task ImportPackAsync()
    {
        _busy = true;
        _error = null;
        _status = null;
        try
        {
            var result = await LibraryImporter.ImportAsync();
            _status = $"Import finished: {result.Packs} pack(s), {result.PresetsImported} added, "
                + $"{result.PresetsAlreadyPresent} already present, {result.SkeletonsRendered} skeletons rendered, "
                + $"{result.Skipped.Count} skipped.";
            if (result.Skipped.Count > 0)
            {
                Logger.LogWarning("Pose import skipped {Count} files: {Skipped}", result.Skipped.Count, string.Join(" | ", result.Skipped));
            }

            _libraries = await LibraryService.ListLibrariesAsync();
            _categories = await LibraryService.ListCategoriesAsync();
            _results = await LibraryService.SearchAsync(new PoseLibraryQuery(_keyword, _category, _libraryId));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Shows the pose that was just saved. The filters are moved to it rather than left as they were: a new pose
    /// that does not appear because a stale filter excludes it reads as a failed save.
    /// /// </summary>
    private async Task OnPoseSavedAsync(PosePreset preset)
    {
        _keyword = null;
        _category = null;
        _libraryId = preset.LibraryId;

        _libraries = await LibraryService.ListLibrariesAsync();
        _categories = await LibraryService.ListCategoriesAsync();
        _results = await LibraryService.SearchAsync(new PoseLibraryQuery(null, null, _libraryId));
    }

    /// <summary>
    /// Fits the rig onto a library pose and hands it to the authoring panel, so a pose that was never authored here
    /// — a pack pose extracted from a photograph — can still be edited with every tool: the 5° arrows, the head
    /// tool and the drag editor.
    ///
    /// The fit is an approximation, because a single 2D view carries no depth, so its residual travels with it and
    /// is shown rather than hidden. A pose that cannot be fitted at all (too few visible joints) reports the reason
    /// instead of opening an empty editor.
    /// </summary>
    private Task OpenInEditorAsync(PosePreset preset)
    {
        _error = null;
        _status = null;
        try
        {
            var observed = OpenPosePoseJson.Parse(preset.KeypointsJson, preset.Name);

            // A pose carrying a face channel is a HEAD pose, and there is no body in it to fit. A body rig fitted onto
            // five head joints is not an approximation of this pose, it is a different thing — and because the 5°
            // arrows re-project through the FIT's rotations, every nudge afterwards would be built on that.
            if (observed.Face.Count > 0)
            {
                throw new InvalidOperationException(
                    "this is a head pose: it carries a 70-point face and no body, so the body rig cannot be fitted onto "
                    + "it. A head pose is picked and rendered as it is; head angles are authored from the Head step.");
            }

            var fitted = PoseRigFit.Fit(observed, StudioOptions.Value);

            // The residual travels with the fit, and now decides whether the pose may be edited at all. The arrows
            // project the rig through the FIT's rotations, so a fit that did not converge does not merely look
            // approximate — it turns the next nudge into a pose that is not the one that was opened.
            if (fitted.MeanErrorPercentOfHeight > PoseRigFit.UsableMeanErrorPercentOfHeight)
            {
                throw new InvalidOperationException(
                    $"the rig fitted onto it only to {fitted.MeanErrorPercentOfHeight:0.0}% mean joint error across "
                    + $"{fitted.JointsMatched} joints, past the {PoseRigFit.UsableMeanErrorPercentOfHeight:0.0}% a fit "
                    + "has to reach before its rotations can be edited: the 5° arrows would project a pose that is not "
                    + "this one. It can still be picked and rendered as it is.");
            }

            _loaded = fitted;
            _loadedFrom = preset;

            _status = $"Fitted the rig onto '{preset.Name}': {fitted.MeanErrorPercentOfHeight:0.0}% mean joint error. "
                + "Edit it in the panel above — saving adds a new pose and leaves this one alone.";
        }
        catch (Exception ex)
        {
            // Deliberately not left half-loaded: a failed fit must not leave the panel editing the previous pose
            // while the message claims otherwise.
            _loaded = null;
            _loadedFrom = null;
            _error = $"'{preset.Name}' could not be opened in the editor: {ex.Message}";
        }

        return Task.CompletedTask;
    }
}
