@page "/roleplay/studio/{sessionId}/{interactionId}/production/{productionGroupId}/composition"
@rendermode InteractiveServer

@using System.Text.Json
@using System.Text.Json.Nodes
@using DreamGenClone.Application.Abstractions
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.ImageStep
@using DreamGenClone.Web.Application.RolePlay.Models
@using DreamGenClone.Web.Application.Sessions
@using DreamGenClone.Web.Application.Scenarios
@implements IAsyncDisposable

@inject ISceneImageService ImageService
@inject ISceneImageProductionService ProductionService
@inject ISceneImageStorageService SceneImageStorage
@inject IModelResolutionService ModelResolutionService
@inject NavigationManager Nav
@inject ILogger<CompositionComposer> Logger
@inject ISessionService SessionService
@inject IScenarioService ScenarioService
@inject ICharacterImageIdentityService IdentityService
@inject ICharacterIdentityOwnerResolver OwnerResolver
@inject IReferenceStrategyResolver ReferenceStrategies
@inject ISceneMomentEnrichmentPipelineService MomentEnrichmentService
@inject IPoseLibraryService PoseCatalog
@inject ISceneAssetService AssetService
@inject IImageStagingProfileResolver StagingProfiles

<PageTitle>Composition Composer - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <div>
            <a href="@StudioUrl" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Production Studio
            </a>
            <h4 class="d-inline-block ms-2 mb-0">Composition Composer</h4>
        </div>
        @if (_productionGroup is not null)
        {
            <a class="btn btn-sm btn-outline-info" href="/review-deck/studio/@_productionGroup.Id">
                <i class="bi bi-images me-1"></i>Review Deck
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">@_statusMessage</div>
    }

    @if (_productionGroup is null || _compiledMediaBrief is null)
    {
        <div class="alert alert-warning">Loading the exact production group and still brief...</div>
    }
    else
    {
        <details class="card mb-3">
            <summary class="card-header fw-semibold small py-2">
                <i class="bi bi-info-circle me-1"></i>Selected Moment &amp; production context
                @if (_frozenState is not null) { <span class="text-muted">· @_frozenState.Location</span> }
                <span class="text-muted">· @_productionGroup.Pov POV</span>
            </summary>
            <div class="card-body small">
                @if (_momentEnrichment is null || _frozenState is null)
                {
                    <span class="text-muted">The selected Moment enrichment is not loaded yet. Complete Moment enrichment before generating references/prompts.</span>
                }
                else
                {
                    <dl class="row mb-2">
                        <dt class="col-sm-3">Moment</dt>
                        <dd class="col-sm-9">@_productionGroup.MomentId <span class="text-muted">· enrichment r@_momentEnrichment.Revision · @_momentEnrichment.Status</span></dd>
                        <dt class="col-sm-3">POV</dt><dd class="col-sm-9">@_productionGroup.Pov</dd>
                        <dt class="col-sm-3">Visual description</dt><dd class="col-sm-9">@_frozenState.VisualDescription</dd>
                        <dt class="col-sm-3">Location</dt><dd class="col-sm-9">@_frozenState.Location · @_frozenState.TimeOfDay · @_frozenState.Lighting</dd>
                        <dt class="col-sm-3">Environment</dt><dd class="col-sm-9">@_frozenState.Environment</dd>
                        <dt class="col-sm-3">Mood</dt><dd class="col-sm-9">@_frozenState.Mood</dd>
                        <dt class="col-sm-3">Objects</dt><dd class="col-sm-9">@string.Join(", ", _frozenState.Objects)</dd>
                        <dt class="col-sm-3">Continuity</dt><dd class="col-sm-9">@_frozenState.ContinuityState</dd>
                    </dl>
                    <div class="fw-semibold mb-1">Visible cast (source of the reference tabs)</div>
                    @foreach (var character in _frozenState.Characters)
                    {
                        <div class="d-flex justify-content-between gap-2 border-top py-1">
                            <span><strong>@character.Name</strong> · @character.Position · @character.ActionOrObservation</span>
                            <span class="text-muted text-truncate ms-2">@character.Clothing</span>
                        </div>
                    }
                }
            </div>
        </details>

        <div class="row g-3">
            <div class="col-xl-7">
                <section class="card">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <strong>Composition</strong>
                        <span class="badge text-bg-info">@_productionGroup.Pov</span>
                    </div>
                    <div class="card-body">
                        <div class="mt-3">
                            @* B-130: the model and the reference slots come from the ONE composer. Its prompt panel and
                               submit button are off: this page owns the prompt tabs, the generate action and the
                               prompt-input inspector, so a second prompt box would be two controls over one value. *@
                            @if (_modelChoices.Count == 0)
                            {
                                <span class="text-muted d-block">No image models are enabled in Model Manager.</span>
                            }
                            else
                            {
                                <ImageStepComposer Blueprint="CompositionBlueprint"
                                                   ModelChoices="_modelChoices"
                                                   SelectedModelId="@_selectedModelId"
                                                   SelectedModelIdChanged="OnCompositionModelSelectedAsync"
                                                   ModelPlaceholder="Choose an image model"
                                                   Bindings="_referenceBindings"
                                                   BindingsChanged="OnReferenceBindingsChanged"
                                                   IdentityOwnerKeys="@IdentityOwnerKeys"
                                                   CharacterLoras="_characterLoras"
                                                   CharacterLorasChanged="OnCharacterLorasChanged"
                                                   AppImageSearchScope="@CompositionSearchScope()"
                                                   RequestedLocationReference="_requestedLocationReference"
                                                   Busy="_busy"
                                                   CanSubmit="false"
                                                   ShowPrompt="false" />
                                <div class="mt-2">
                                    <ResolvedRenderBadge ModelLabel="@SelectedModelLabel()" Selections="_referenceBindings" />
                                </div>

                                @* B-157: what the model will actually RECEIVE for this Composition — the prompt that renders
                                   (the style the selected model reads) plus the reference block naming each person and their
                                   position. The frame comes from the compiled brief's own snapshot, which is the same value
                                   the render reads, so the preview and the render cannot disagree. *@
                                <StepPromptFramePreview Prompt="@PromptTextFor(RenderStyle)"
                                                        Bindings="_referenceBindings"
                                                        Blocking="@CompositionBlocking"
                                                        Family="@SelectedCompositionModelFamily"
                                                        Override="_blockingOverride"
                                                        FramingChoices="_framingChoices"
                                                        CompiledFramingLabel="@CompiledFramingLabel"
                                                        OverrideChanged="OnBlockingOverrideChanged" />

                                @if (!string.IsNullOrWhiteSpace(_locationSeedNotice))
                                {
                                    <div class="alert alert-warning py-2 small mt-2">@_locationSeedNotice</div>
                                }
                                @* B-137 §4 item 4c: the composition's SCENE LoRAs (unlock / act / anatomy / style).
                                   Filtered to the selected model's FAMILY - a LoRA binds only to the family it was
                                   trained against - and it renders NOTHING when the catalog carries no rows for that
                                   family, so no control is offered that the render would have to refuse. The client
                                   chains these BEFORE the character LoRAs the composer above supplies, so identity
                                   stays closest to the subject. *@
                                <div class="mt-2">
                                    <SceneLoraPicker Family="@SelectedCompositionModelFamily"
                                                     Selections="_sceneLoras"
                                                     SelectionsChanged="OnSceneLorasChanged"
                                                     Disabled="_busy"
                                                     Scope="composition-scene-lora" />
                                </div>
                            }
                        </div>

                        <div class="mt-3">
                            @if (IsPromptPending && PendingPromptStyle == _activeStyle)
                            {
                                <div class="small text-muted mb-2"><span class="spinner-border spinner-border-sm me-1"></span>Generating @SceneImagePromptStyleResolver.DisplayLabel(_activeStyle) prompt...</div>
                            }
                            else if (_failedPrompt is not null && FailedPromptStyle == _activeStyle)
                            {
                                <div class="alert alert-danger py-2 small mb-2">Prompt generation failed: @_failedPrompt.ErrorMessage</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_framingNotice))
                            {
                                @* B-161: the frame reaches the prompt twice — as prose written by the pre-processor and
                                   as the authoritative block appended at render. A framing chosen after a draft exists
                                   leaves the prose naming the old camera, so the operator is told which half is stale
                                   rather than being handed one prompt that asserts two cameras. *@
                                <div class="alert alert-warning py-2 small mb-2" role="alert">@_framingNotice</div>
                            }

                            <ul class="nav nav-tabs small mb-2" role="tablist" aria-label="Prompt input">
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(_promptInputTab == SceneImagePromptSource.Scene ? "active" : "")"
                                            @onclick="() => _promptInputTab = SceneImagePromptSource.Scene">Scene</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(_promptInputTab == SceneImagePromptSource.UserIntent ? "active" : "")"
                                            @onclick="() => _promptInputTab = SceneImagePromptSource.UserIntent">User Intent</button>
                                </li>
                            </ul>

                            @if (_promptInputTab == SceneImagePromptSource.UserIntent)
                            {
                                <div class="border rounded p-2 mb-2">
                                    <div class="small fw-semibold mb-1">Reference images in this render</div>
                                    @if (_referenceBindings.Count == 0)
                                    {
                                        <div class="small text-muted">No reference images are bound.</div>
                                    }
                                    else
                                    {
                                        <ol class="small mb-0 ps-3">
                                            @foreach (var reference in ReferencesInSendOrder())
                                            {
                                                <li>
                                                    @if (reference.Tag is null)
                                                    {
                                                        <span class="text-muted">@ReferenceRoleClauses.UntaggedImageLabel</span>
                                                    }
                                                    else
                                                    {
                                                        <code>@reference.Tag</code>
                                                    }
                                                    — @reference.Binding.SemanticRole@(string.IsNullOrWhiteSpace(reference.Binding.ReferenceLabel) ? "" : $" ({reference.Binding.ReferenceLabel})")
                                                </li>
                                            }
                                        </ol>
                                    }
                                </div>
                                <label class="form-label small fw-semibold mb-1">User intent</label>
                                <textarea class="form-control font-monospace" rows="8" @bind="_userIntentText" @bind:event="oninput" @bind:after="QueuePromptDraftSave"
                                          placeholder="Write the instruction you want compiled: what the shot is, who is in it, where they stand, how the frame is composed. The reference tags above are the ones this render will receive."></textarea>
                                <div class="form-text">@WordCount(_userIntentText) words · ~@EstimateTokens(_userIntentText) tokens</div>
                            }
                            else
                            {
                                <label class="form-label small fw-semibold mb-1">Prompt</label>
                                <textarea class="form-control font-monospace" rows="8" @bind="PromptText"
                                          placeholder="Generate a prompt for the selected model's family, then edit it before generating a Composition."></textarea>
                                <div class="form-text">@WordCount(PromptText) words · ~@EstimateTokens(PromptText) tokens · the selected model's family decides the prompt dialect, so there is one prompt rather than one per style.</div>
                            }

                            <label class="form-label small fw-semibold mb-1 mt-2" for="compose-prompt-source">Prompt source</label>
                            <select id="compose-prompt-source" class="form-select form-select-sm" @bind="_promptSource" @bind:after="SavePromptDraftAsync">
                                <option value="@SceneImagePromptSource.Scene">Scene — compile the selected Moment's scene brief</option>
                                <option value="@SceneImagePromptSource.UserIntent">User Intent — compile the intent I wrote above</option>
                            </select>
                            <div class="form-text">What Generate Prompt sends to the compiler. The tab above only decides which input you are looking at.</div>

                            <label class="form-label small fw-semibold mb-1 mt-2" for="compose-explicitness">Explicitness</label>
                            <select id="compose-explicitness" class="form-select form-select-sm" @bind="_explicitness" @bind:after="QueuePromptDraftSave">
                                <option value="@SceneImageExplicitness.Explicit">Explicit — preserve the scene's explicit content</option>
                                <option value="@SceneImageExplicitness.MatchScene">Match the scene — neither add nor remove</option>
                                <option value="@SceneImageExplicitness.Sfw">SFW — remove or soften explicit nudity and acts</option>
                            </select>
                            <div class="form-text">Stated to the compiler as an authoritative line, so it does not soften or invent explicitness on its own.</div>

                            @if (!string.Equals(_productionGroup?.Pov.Trim(), SceneImagePovFramer.Omniscient, StringComparison.OrdinalIgnoreCase))
                            {
                                <label class="form-label small fw-semibold mb-1 mt-2" for="compose-camera-holder-parts">Camera holder body parts (participant POV)</label>
                                <select id="compose-camera-holder-parts" class="form-select form-select-sm" @bind="_cameraHolderParts" @bind:after="QueuePromptDraftSave">
                                    <option value="@CameraHolderPartsMode.None">Off — never show the camera holder</option>
                                    <option value="@CameraHolderPartsMode.Derived">Show the parts the moment records</option>
                                </select>
                                <div class="form-text">For a participant POV the camera holder is normally never in the picture. Show the body parts the moment's recorded contacts put in frame — edit the Contacts row under Prompt Input to change which parts those are.</div>
                            }

                            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                <button class="btn btn-sm btn-primary" disabled="@(_busy || IsPromptPending || _modelChoices.Count == 0)" @onclick="GeneratePromptAsync">
                                    <i class="bi bi-magic me-1"></i>Generate Prompt
                                </button>
                            </div>

                            <label class="form-label small fw-semibold mb-1 mt-3">Prompt sent to the model</label>
                            <textarea class="form-control font-monospace" rows="8" readonly value="@PromptAsSent"></textarea>
                            <div class="form-text">The complete text, including the reference block and camera clause the render appends — nothing reaches the model that is not shown here.</div>

                            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                <button class="btn btn-sm btn-success"
                                        disabled="@(!CanGenerateComposition)"
                                        @onclick="GenerateCompositionAsync">
                                    <i class="bi bi-image me-1"></i>Generate Image
                                </button>
                                <label class="form-label small mb-0 ms-2" for="compose-image-count">Images</label>
                                <input id="compose-image-count" type="number" class="form-control form-control-sm" style="width: 80px;"
                                       min="1" max="8" step="1" @bind="_imageCount" disabled="@_busy" />
                            </div>
                        </div>

                        @* Collapsed by default. This is an INSPECTOR - the payload the compiler received, with overrides -
                           and expanded it is the longest block on the page, which pushed the things the operator
                           actually came here to do (the prompt, the generate action) below the fold. Collapsed, the
                           header still says what it is and how to open it. *@
                        <div class="border-top mt-3 pt-3" aria-label="Prompt input inspector">
                            <button type="button" class="btn btn-link p-0 w-100 text-start text-decoration-none"
                                    aria-expanded="@PromptInputExpanded" @onclick="TogglePromptInput">
                                <span class="d-flex justify-content-between align-items-start gap-2">
                                    <span>
                                        <strong class="text-body">Prompt input (what the compiler receives)</strong>
                                        <span class="d-block small text-muted">The compiled brief grouped into concepts. A concept may live in several payload spots — editing it rewrites every spot at once, and the coverage is listed on each row. Tick remove to drop the whole concept. Each row says whether its text is restated verbatim by the frame or read by the prompt compiler.</span>
                                    </span>
                                    <span class="small text-nowrap">
                                        <i class="bi @(_showPromptInput ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        @(_showPromptInput ? "Hide" : "Show")
                                    </span>
                                </span>
                            </button>
                            @if (_showPromptInput)
                            {
                                @if (!string.IsNullOrWhiteSpace(_castReferenceError))
                                {
                                    <div class="alert alert-warning py-1 small mb-2 mt-2">@_castReferenceError</div>
                                }
                                @if (!_promptRowsInitialized)
                                {
                                    <span class="text-muted small">Loading the compiled brief payload...</span>
                                }
                                else
                                {
                                    @foreach (var group in _promptGroups)
                                    {
                                        <div class="fw-semibold small mt-3 mb-1 d-flex justify-content-between align-items-center gap-2">
                                            <span>@PromptGroupHeader(group)</span>
                                            @if (group.CharacterKey is not null)
                                            {
                                                @if (IsCameraHolder(group))
                                                {
                                                    <span class="small text-muted" title="This character IS the camera for this POV: they hold it, so they are never in the picture. Their position still sets the camera height.">
                                                        camera holder — not in the picture
                                                    </span>
                                                }
                                                else
                                                {
                                                    <label class="form-check-label small">
                                                        <input class="form-check-input me-1" type="checkbox"
                                                               checked="@group.Removed"
                                                               @onchange="args => SetGroupRemoved(group, (bool?)args.Value == true)" />
                                                        remove character
                                                    </label>
                                                }
                                            }
                                        </div>
                                        @foreach (var row in group.Rows)
                                        {
                                            <div class="border rounded p-2 mb-2 @(row.Removed ? "opacity-50" : "")">
                                                <div class="d-flex justify-content-between align-items-baseline gap-2 mb-1">
                                                    <span>
                                                        <strong class="small">@row.Label</strong>
                                                        <span class="d-block small text-muted">@RowHint(row, group)@CoverageHint(row)</span>
                                                    </span>
                                                    @if (IsReferenceSupplied(row))
                                                    {
                                                        <span class="badge text-bg-secondary" title="A bound reference image supplies this element, so the prompt must not describe it — unbind that reference to make it editable again.">
                                                            <i class="bi bi-lock me-1"></i>supplied by reference
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <label class="form-check-label small">
                                                            <input class="form-check-input me-1" type="checkbox"
                                                                   checked="@row.Removed"
                                                                   @onchange="args => SetRowRemoved(group, row, (bool?)args.Value == true)" />
                                                            remove
                                                        </label>
                                                    }
                                                </div>
                                                <CommittedTextInput Multiline="true" class="form-control form-control-sm font-monospace" rows="2"
                                                                    Live="@row.Value" LiveChanged="args => SetPromptRowValue(row, args ?? string.Empty)"
                                                                    disabled="@(row.Removed || IsReferenceSupplied(row))" />
                                                @if (row.IsChanged && !row.Removed)
                                                {
                                                    <div class="small text-muted mt-1">was: <span class="font-monospace">@row.OriginalValue</span></div>
                                                }
                                            </div>
                                        }
                                    }
                                }
                            }
                        </div>

                        @if (!IsQwenImage21Selected)
                        {
                        <div class="border-top mt-3 pt-3" aria-label="Pose reference">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <strong>Pose reference</strong>
                                    <span class="d-block small text-muted">A library pose is bound in the step's <strong>Pose</strong> tab above, and that binding is what the render reads — the picker no longer lives here, because two ways to choose one pose is how the two drift apart. A skeleton the library does not hold (a DWPose extract, say) can be uploaded here instead. The selected model's family decides how the skeleton travels: a model that qualifies an OpenPose ControlNet (SDXL/FLUX on the local ComfyUI) conditions the sampler with it, while a model that carries references natively (Qwen-Image-2.1) takes the skeleton as one more reference image in the same call — which is also what lets a pose combine with identity on create. A model that supports neither fails fast rather than rendering without the pose.</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_poseStoragePath))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearPose">Clear pose</button>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_poseUploadError))
                            {
                                <div class="alert alert-danger py-1 small mb-2">@_poseUploadError</div>
                            }
                            <div class="mt-2">
                                @if (_poseBusy)
                                {
                                    <span class="small text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Saving pose...</span>
                                }
                                else if (string.IsNullOrWhiteSpace(_poseStoragePath))
                                {
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <InputFile accept=".png,.jpg,.jpeg,.webp" OnChange="OnPoseFileSelectedAsync" />
                                    </div>
                                    <div class="form-text">OpenPose skeleton PNG — upload a DWPose extract, or bind a library pose in the <strong>Pose</strong> tab above. When attached, the render uses the OpenPose ControlNet graph instead of plain text.</div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="/scene-images/@_poseStoragePath" alt="Pose reference" style="max-height: 90px;" class="border rounded" />
                                        <div>
                                            <div class="small text-break">@_poseImageName</div>
                                            <label class="form-label small fw-semibold mb-0 mt-1">ControlNet strength</label>
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="range" class="form-range" min="0.1" max="1" step="0.05" style="width: 180px;" @bind="_poseStrength" />
                                                <span class="small text-muted">@_poseStrength.ToString("0.00")</span>
                                            </div>
                                            <span class="d-block small text-muted">Used when the model conditions the pose with a ControlNet; a reference-image pose carries no strength.</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        }

                        @if (!IsQwenImage21Selected)
                        {
                        <div class="border-top mt-4 pt-3" aria-label="Identity on create">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <strong>Identity on create</strong>
                                    <span class="d-block small text-muted">Applies the approved canonical identity pack while creating this Composition (IP-Adapter face conditioning).</span>
                                </div>
                                @if (_identityResolution is not null)
                                {
                                    <span class="badge @IdentityBadgeClass()">@_identityResolution.Status</span>
                                }
                            </div>
                            @if (_identityResolution is not null)
                            {
                                <div class="small mt-2">@_identityResolution.Reason</div>
                            }
                            <div class="form-check mt-2">
                                <input id="compose-with-identity" class="form-check-input" type="checkbox" @bind="_applyIdentityOnCreate"
                                       @bind:after="OnIdentityOnCreateChangedAsync"
                                       disabled="@(!IdentityAvailable)" />
                                <label class="form-check-label" for="compose-with-identity">Apply identity while creating this composition</label>
                            </div>
                            @if (_applyIdentityOnCreate)
                            {
                                <div class="mt-3">
                                    <label class="form-label small fw-semibold mb-1">Identity model (identity-capable)</label>
                                    @if (_identityModelChoices.Count == 0)
                                    {
                                        <span class="text-muted d-block">No identity-capable image models are enabled. Configure an identity mechanism (IP-Adapter/PuLID) in Model Manager.</span>
                                    }
                                    else
                                    {
                                        <ModelPicker Choices="_identityModelChoices" @bind-SelectedModelId="_selectedIdentityModelId"
                                                     @bind-SelectedModelId:after="OnIdentityModelSelectedAsync"
                                                     Id="compose-identity-model" CssClass="form-select form-select-sm mb-2" />
                                    }
                                </div>
                                @if (_identityPackOptions.Count == 0)
                                {
                                    <span class="text-muted small">No approved identity packs yet. Create and approve one in <a href="/characters/identity">Character Identity</a>.</span>
                                }
                                else
                                {
                                    <label class="form-label small fw-semibold mb-1">Approved identity pack</label>
                                    <select class="form-select form-select-sm mb-2" @bind="_selectedIdentityPackId">
                                        <option value="">Select an approved pack</option>
                                        @foreach (var opt in _identityPackOptions)
                                        {
                                            <option value="@opt.PackId">@opt.Label</option>
                                        }
                                    </select>
                                    @if (SelectedIdentityPack is not null)
                                    {
                                        <label class="form-label small fw-semibold mb-1">Strength override (optional)</label>
                                        <input type="number" class="form-control form-control-sm" style="width: 120px;"
                                               @bind="SelectedIdentityPack.Strength" min="0" max="2" step="0.05" placeholder="model default" />
                                    }
                                    <div class="form-text">A single character pack applies one face to the whole image; describe exactly one person in the prompt for best results. Strength overrides the model's configured identity strength.</div>
                                }
                            }
                        </div>
                        }

                        <details class="mt-3">
                            <summary class="small fw-semibold">View what will be submitted</summary>
                            <dl class="row small mt-2 mb-0">
                                <dt class="col-sm-3">POV</dt><dd class="col-sm-9">@_productionGroup.Pov</dd>
                                <dt class="col-sm-3">Model</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_selectedModelId) ? "Select an enabled image model" : SelectedModelLabel())</dd>
                                <dt class="col-sm-3">Prompt style</dt><dd class="col-sm-9">@SceneImagePromptStyleResolver.DisplayLabel(RenderStyle) (chosen from the selected model's family)</dd>
                                <dt class="col-sm-3">Prompt</dt><dd class="col-sm-9 text-break">@(string.IsNullOrWhiteSpace(PromptTextFor(RenderStyle)) ? "Generate or enter a prompt for the selected model's style" : PromptTextFor(RenderStyle))</dd>
                            </dl>
                        </details>
                    </div>
                </section>
            </div>
            <div class="col-xl-5">
                <section class="card h-100">
                    <div class="card-header"><strong>Images</strong> <span class="text-muted">(@_productionImages.Count)</span></div>
                    <div class="card-body">
                        @if (_productionImages.Count == 0)
                        {
                            <span class="text-muted small">No images have been generated for this POV.</span>
                        }
                        else
                        {
                            <div class="d-grid gap-3">
                                @foreach (var attempt in _productionImages)
                                {
                                    @* The SAME card every other image list renders, wired to the commands this page can
                                       actually honour. Nothing is drawn that the page would then refuse: a command with no
                                       callback is simply not a button, and a command a row cannot satisfy is offered only
                                       where the rule that decides it says it can be. *@
                                    <ImageCard Model="CardModel(attempt)"
                                               Busy="_busy"
                                               ShowName="true"
                                               NameChanged="name => NameCompositionImageAsync(attempt, name)"
                                               AcceptRequested="@(CanApprove(attempt)
                                                   ? EventCallback.Factory.Create(this, () => ApproveCompositionAttemptAsync(attempt))
                                                   : default(EventCallback))"
                                               AcceptTitle="Approve this Composition as the production frame"
                                               ShortlistRequested="() => ToggleCompositionShortlistAsync(attempt)"
                                               RejectRequested="() => SetCompositionDispositionAsync(attempt, SceneImageAttemptDisposition.Rejected)"
                                               ReviewRequested="OpenCompositionReview"
                                               EditRequested="() => OpenCompositionInEditor(attempt)"
                                               DownloadRequested="() => OpenCompositionDownload(attempt)"
                                               VideoRequested="() => OpenCompositionInVideoStudio(attempt)"
                                               LoadIntoGeneratorRequested="() => RestoreCompositionInputsAsync(attempt)"
                                               LoadIntoGeneratorTitle="Reload the prompt, model, references, LoRAs and pose that made this Composition"
                                               UseAsReferenceRequested="() => UseCompositionImageAsReferenceAsync(attempt)"
                                               UseAsReferenceTitle="Use as reference: reload what made this Composition, and bind this image itself as the composition's Location reference"
                                               DeleteRequested="() => RequestDeleteCompositionAsync(attempt)">
                                        <BodyContent>
                                            @* What this row IS and what it came from. A flat list mixes a Composition with
                                               every edit derived from it, and neither the stage nor the operation alone says
                                               which: an editor edit carries no stage, and a preset edit is an edit of an edit. *@
                                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                                <span class="badge text-bg-secondary">@KindLabel(attempt)</span>
                                                @if (ParentLabel(attempt) is { } parentLabel)
                                                {
                                                    <span class="small text-muted">from @parentLabel</span>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                        @onclick="() => ToggleMetadata(attempt.Id)">
                                                    @(_metadataImageId == attempt.Id ? "Hide metadata" : "Metadata")
                                                </button>
                                            </div>
                                            @if (_metadataImageId == attempt.Id)
                                            {
                                                @* The metadata rail of every review surface, and the same mapping the review
                                                   deck uses, so a row shows its model, references, LoRAs and tags here in the
                                                   one field order those surfaces already agree on. *@
                                                <div class="border rounded p-2 mt-2">
                                                    <ImageMetadataRail Item="ReviewDeckMapper.MapStudio(attempt, _approvedAttemptIds.Contains(attempt.Id))"
                                                                       TagTarget="ImageTagTarget.Rendered"
                                                                       TagsJson="attempt.TagsJson"
                                                                       Details="ImageGenerationInputDetails.FromSceneImage(attempt)"
                                                                       TagsChanged="OnCompositionTagsChangedAsync" />
                                                </div>
                                            }
                                            @if (_deleteConfirmImageId == attempt.Id)
                                            {
                                                <div class="d-flex gap-2 mt-1 align-items-center">
                                                    <small class="text-danger">Delete this Composition image?</small>
                                                    <button class="btn btn-sm btn-danger py-0 px-2" disabled="@_busy"
                                                            @onclick="() => ConfirmDeleteCompositionAsync(attempt)">Delete</button>
                                                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" disabled="@_busy"
                                                            @onclick="CancelDeleteComposition">Keep</button>
                                                </div>
                                            }
                                            else if (attempt.Status is SceneImageStatus.Pending or SceneImageStatus.Generating)
                                            {
                                                <div class="d-flex align-items-center mt-1">
                                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                                    <span class="small">@KindLabel(attempt) @attempt.Status.ToString().ToLowerInvariant()…</span>
                                                </div>
                                            }
                                        </BodyContent>
                                        <FooterContent>
                                            @* The one action that belongs to THIS page's step rather than to an image: a
                                               sibling Composition from the same inputs. It stays in the card's footer because
                                               it acts on the image the card is showing, and it stays on Composition rows
                                               only: regenerating means re-running the Composition, and SceneImageService
                                               refuses any other source by name. *@
                                            @if (attempt.ProductionStage == SceneImageProductionStage.Composition)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                        title="Regenerate a sibling Composition from this image's inputs" disabled="@_busy"
                                                        @onclick="() => RegenerateCompositionAsync(attempt)">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            }
                                        </FooterContent>
                                    </ImageCard>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string sessionId { get; set; } = string.Empty;
    [Parameter] public string interactionId { get; set; } = string.Empty;
    [Parameter] public string productionGroupId { get; set; } = string.Empty;

    private SceneImageProductionGroup? _productionGroup;
    private CompiledMediaBrief? _compiledMediaBrief;
    private List<SceneImageRecord> _compositionAttempts = [];

    /// <summary>
    /// Set when the route pairs this group with a sibling interaction; the interactive render navigates there once.
    /// Prerendering cannot navigate, so the redirect is deferred to <see cref="OnAfterRender"/>.
    /// </summary>
    private string? _canonicalRedirectUrl;

    /// <summary>
    /// Every image this production group owns, newest first — the Compositions AND everything derived from them.
    ///
    /// <para>
    /// The page listed only <see cref="SceneImageProductionStage.Composition"/>, which hid every edit made from a
    /// card. <c>SceneImageService.EnqueueEditAsync</c> records an edit's production GROUP but no stage at all, so a
    /// stage filter drops it: in group 0f98cb6f that was 16 of 45 rows, and the operator's edits were reachable only
    /// from a different page ("these should not be separated into separate things").
    /// </para>
    /// </summary>
    private List<SceneImageRecord> _productionImages = [];

    /// <summary>
    /// The ONE row whose generation metadata is expanded. The details resolve names per row, so rendering every card's
    /// metadata up front would do that work for images nobody is looking at.
    /// </summary>
    private string? _metadataImageId;
    private List<SceneImageModelChoice> _modelChoices = [];
    private string _sdxlPromptText = string.Empty;
    private string _ponyPromptText = string.Empty;
    private readonly Dictionary<SceneImagePromptStyle, SceneImagePromptRecord> _completedByStyle = new();
    private SceneImagePromptStyle _activeStyle = SceneImagePromptStyle.NaturalLanguage;

    /// <summary>
    /// The ONE prompt this page edits. The record still stores a dialect (PromptStyle), but the operator gets a single
    /// box: the selected model's family decides which dialect the render reads, so two boxes plus a Pony tab were two
    /// controls over one value.
    /// </summary>
    private string PromptText
    {
        get => PromptTextFor(RenderStyle);
        set
        {
            if (RenderStyle == SceneImagePromptStyle.PonyV6Tags)
            {
                _ponyPromptText = value;
            }
            else
            {
                _sdxlPromptText = value;
            }
        }
    }

    /// <summary>How many renders one Generate Image click submits. Request data: the operator's number, default 1.</summary>
    private int _imageCount = 1;

    /// <summary>Which prompt input the operator is LOOKING at. Independent of what is sent: inspecting the scene brief
    /// while compiling the intent is legitimate, and the two must not be one control.</summary>
    private SceneImagePromptSource _promptInputTab = SceneImagePromptSource.Scene;

    /// <summary>What Generate Prompt actually sends to the compiler. Persisted on the record, so the compile is auditable.</summary>
    private SceneImagePromptSource _promptSource = SceneImagePromptSource.Scene;

    /// <summary>The operator's own instruction. Consulted only when <see cref="_promptSource"/> is UserIntent.</summary>
    private string _userIntentText = string.Empty;

    /// <summary>
    /// How the compiled prompt states explicitness for this Composition. Default Explicit (this app is adult-content-first);
    /// the operator can switch to SFW or back to the compiler's match-the-scene judgement. Persisted on the prompt draft.
    /// </summary>
    private SceneImageExplicitness _explicitness = SceneImageExplicitness.Explicit;

    /// <summary>
    /// Whether this participant-POV Composition shows parts of the camera holder's body in the frame. Default None
    /// (never depicted); Derived extracts the parts from the moment data, Custom uses the operator's text below.
    /// </summary>
    private CameraHolderPartsMode _cameraHolderParts = CameraHolderPartsMode.None;

    /// <summary>
    /// The retired custom camera-holder parts text. Kept so an older draft's value is surfaced and cleared rather than
    /// silently carried into a render (B-167: the parts come from the moment's recorded contacts).
    /// </summary>
    private string _cameraHolderPartsText = string.Empty;

    /// <summary>
    /// Whether the source and intent have been restored from the drafts this Composition already has. Restored ONCE,
    /// because <c>LoadAsync</c> runs on every poll and a later pass must never overwrite what the operator is typing
    /// or the source they just chose.
    /// </summary>
    private bool _promptSourceInitialized;

    /// <summary>How long the intent box waits after the last keystroke before its draft is written.</summary>
    private static readonly TimeSpan PromptDraftSaveDelay = TimeSpan.FromSeconds(1.5);

    private CancellationTokenSource? _draftSaveCts;

    /// <summary>
    /// The COMPLETE text the render submits: the compiled brief plus the reference block and camera clause the render
    /// appends, composed through the SAME owners and rules the render applies, so the preview cannot disagree with what
    /// is actually sent. Shown rather than edited: editing it would round-trip into the render, which composes the block
    /// again and would duplicate it.
    /// </summary>
    /// <remarks>
    /// The camera holder's visible body is NOT part of this composition any more: it is stated to the caption writer and
    /// required inside the compiled caption itself, so the render appends nothing for it (operator report 2026-10-23 —
    /// as a trailing block it was ignored and the subject was drawn alone).
    /// </remarks>
    private string PromptAsSent
    {
        get
        {
            return FinalImagePromptPlanBuilder.Build(
                PromptTextFor(RenderStyle),
                ReferenceRoleClauses.RolesFor(_referenceBindings),
                SelectedCompositionModelFamily,
                ReferenceRoleClauses.LeadingImageCount.Generate,
                EffectiveCompositionBlocking).Prompt;
        }
    }

    /// <summary>
    /// The compiled frame with the OPERATOR's corrections applied — the same frame the render reads.
    /// </summary>
    /// <remarks>
    /// A malformed override returns the compiled frame rather than throwing: the frame preview already reports it in
    /// place, and this property is read while the page renders.
    /// </remarks>
    private SceneBlocking? EffectiveCompositionBlocking
    {
        get
        {
            if (CompositionBlocking is null) return null;
            try
            {
                return SceneBlockingResolver.ApplyForPrompt(CompositionBlocking, _blockingOverride);
            }
            catch (InvalidOperationException)
            {
                return CompositionBlocking;
            }
        }
    }
    private SceneImagePromptRecord? _pendingPrompt;

    /// <summary>
    /// The last draft this page started that TERMINATED without a prompt, kept so the failure is visible.
    ///
    /// <para>
    /// The pending record cannot carry it: it is cleared the moment it leaves Pending, so a banner that read it could
    /// never render. Measured 2026-10-14 — a pre-processor call that hit the 360-second provider timeout left the
    /// panel showing the "Generation queued" line and then nothing at all, with no end and no reason. It is cleared
    /// when the same style is generated again, and set on load from the newest FAILED record so a reopened page
    /// explains itself.
    /// </para>
    /// </summary>
    private SceneImagePromptRecord? _failedPrompt;
    private bool _promptsInitialized;
    private string _errorMessage = string.Empty;
    private string _statusMessage = string.Empty;
    private bool _busy;

    private string? _selectedModelBacking;
    private string? _selectedModelId
    {
        get => _selectedModelBacking;
        set
        {
            if (string.Equals(_selectedModelBacking, value, StringComparison.Ordinal)) return;
            _selectedModelBacking = value;
            // Auto-switch the prompt tab to the family of the newly selected model.
            _activeStyle = RenderStyle;
        }
    }

    /// <summary>
    /// The reference strategies the SELECTED model can actually execute, read from the model choice that came out of
    /// the same capability decision the render uses. A hardcoded text-only list here hid every reference strategy
    /// even for a model that carries identity as its own reference images (reported 2026-09-24).
    /// </summary>
    private IReadOnlyList<string> SelectedModelStrategies
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_selectedModelId))
            {
                return ["TextOnly"];
            }

            var choice = _modelChoices.FirstOrDefault(model => model.ModelId == _selectedModelId)
                ?? throw new InvalidOperationException(
                    "The selected Composition image model is not in the enabled image-model list. Reload the page and "
                    + "pick an enabled model in Model Manager.");
            return choice.QualifiedStrategies;
        }
    }

    /// <summary>
    /// The Composition step's references, ordered, written by the composer's planner. It starts empty: the slots come
    /// from the blueprint, so this holds what the operator bound rather than a pre-built element list (the panel this
    /// replaces offered four element rows with no owner on either per-character one).
    /// </summary>
    private IReadOnlyList<ReferenceApplicationSelection> _referenceBindings = [];
    private string? _locationSeedNotice;

    /// <summary>
    /// The image a card asked to have bound as this composition's location reference ("use as reference"). Held as the
    /// request the composer applies ONCE per image id, so it binds through the step's own plan rather than the page
    /// authoring a binding the planner would then have to accept.
    /// </summary>
    private SceneImageLocationReferenceRequest? _requestedLocationReference;

    /// <summary>
    /// The <c>useAsReferenceId</c> this page has already applied, so the 2-second poll does not re-apply it and stack a
    /// second reference for the same image.
    /// </summary>
    private string? _appliedUseAsReferenceId;

    /// <summary>
    /// The <c>reloadImageId</c> this page has already applied, so the 2-second poll does not reload the same image over
    /// edits the operator has since made.
    /// </summary>
    private string? _appliedReloadImageId;

    /// <summary>
    /// Where the step's image search looks, and how far it opens: this production moment, with the beat and the whole
    /// session available as the operator widens it. The moment comes from the production GROUP rather than from the
    /// selected enrichment, because the group is the immutable record of which enrichment this composition belongs to.
    /// </summary>
    private SceneImageSearchScope CompositionSearchScope()
        => new(
            sessionId,
            SceneImageSearchScopeLevel.Moment,
            _productionGroup?.MomentId,
            _productionGroup?.BeatId);

    /// <summary>
    /// An image another surface asked this page to bind as the composition's location reference — the "use as
    /// reference" command on a production card, which hands off to the surface that owns the Composition step rather
    /// than re-implementing it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "useAsReferenceId")] public string? UseAsReferenceId { get; set; }

    /// <summary>
    /// An image whose recorded inputs another surface asked this page to reload — the "load the prompt and model"
    /// command on a production card. It travels in the URL for the same reason the location request does: the page that
    /// can re-apply the inputs is the page the operator lands on, so the request cannot sit pending on a surface that
    /// never renders it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "reloadImageId")] public string? ReloadImageId { get; set; }

    /// <summary>
    /// Whether this page instance has already auto-seeded the group's backdrop. The seed is an INITIALISATION, so it
    /// runs once: with the latch, a location the operator removed stays removed, and the 2-second poll can never
    /// re-run the seed over the step.
    /// </summary>
    private bool _locationSeedDone;

    /// <summary>
    /// The characters this Composition addresses. The actor key is the PARTICIPANT profile key (`p0`, `p1`, ...) - the
    /// key the compiled Still brief addresses a depicted character by, and therefore the only key a reference slot's
    /// role clause or prompt-element removal can join on.
    ///
    /// <para>
    /// This used to be the character's identity-owner (template) id, on the assumption that the two were the same key.
    /// They are not: the brief freezes its cast as <c>profileKey: "p0"/"p1"</c> plus the scenario <c>characterId</c>,
    /// and it has never contained an identity-owner id. Every join written against the template id therefore matched
    /// nothing and did it silently - measured live 2026-10-12, the prompt told the model to forget an appearance it was
    /// still being handed, because the removal addressed a character the brief does not contain.
    /// </para>
    ///
    /// <para>
    /// A character the frozen cast does not contain is not in the shot, so it is not in the cast: the brief cannot
    /// address it, and offering it a reference slot would create a binding that addresses nobody.
    /// </para>
    /// </summary>
    private IReadOnlyList<ImageStepActor> CompositionCast =>
        _identityPackOptions
            .Where(option => !RemovedCharacterKeys.Contains(option.CharacterKey))
            .Select(option => ParticipantProfileKeyFor(option.CharacterKey) is { Length: > 0 } profileKey
                ? new ImageStepActor(profileKey, option.CharacterName, ViewHintFor(profileKey))
                : null)
            .Where(actor => actor is not null)
            .Select(actor => actor!)
            .DistinctBy(actor => actor.ActorKey, StringComparer.Ordinal)
            .ToList();

    /// <summary>
    /// Which reference view this moment's recorded stance suggests for one participant (B-166 D8), or null when the
    /// brief records no angle. GUIDANCE for the view picker: it never pre-selects a view, and an unrecorded angle
    /// says nothing rather than guessing.
    /// </summary>
    private string? ViewHintFor(string profileKey)
    {
        var character = _frozenState?.Characters.FirstOrDefault(candidate =>
            string.Equals(candidate.ProfileKey, profileKey, StringComparison.OrdinalIgnoreCase));
        if (character is null)
        {
            return null;
        }

        var recommendation = SceneViewRecommender.Resolve(character.Sightline, character.Position);
        if (recommendation.IsEmpty)
        {
            return null;
        }

        var view = recommendation.FaceView is { } face
            ? face switch
            {
                SceneImageReferenceFaceView.Front => "Front",
                SceneImageReferenceFaceView.ThreeQuarterLeft => "Three-quarter left",
                SceneImageReferenceFaceView.ThreeQuarterRight => "Three-quarter right",
                SceneImageReferenceFaceView.ProfileLeft => "Profile left",
                SceneImageReferenceFaceView.ProfileRight => "Profile right",
                _ => face.ToString()
            }
            : "Back (no face visible)";

        return $"{view} — {recommendation.Basis}";
    }

    /// <summary>
    /// The participant profile key the compiled Still brief addresses a scenario character by, or null when this
    /// Composition has no frozen cast yet or the character is not in it.
    ///
    /// <para>
    /// The join is exact and needs no name matching: an identity-pack option carries the SCENARIO character id as its
    /// <c>CharacterKey</c>, and the frozen cast carries that same id beside the profile key. Nothing is guessed - a
    /// character that cannot be resolved yields null and is left out, rather than being handed a key of the wrong
    /// kind that would silently address somebody else.
    /// </para>
    /// </summary>
    /// <summary>
    /// Which identity owner each participant's approved packs and character-owned assets are filed under.
    ///
    /// <para>
    /// This step's actor key is the PARTICIPANT profile key the compiled brief addresses (<c>p0</c>, <c>p1</c>), but a
    /// pack belongs to the character's IDENTITY OWNER — a different key. The composer reads this map for its pack and
    /// character-asset pickers only; the prompt joins keep using the participant key. See
    /// <c>ImageStepComposer.IdentityOwnerKeys</c>.
    /// </para>
    /// </summary>
    private IReadOnlyDictionary<string, string> IdentityOwnerKeys =>
        _identityPackOptions
            .Select(option => (Participant: ParticipantProfileKeyFor(option.CharacterKey), option.TemplateId))
            .Where(entry => !string.IsNullOrWhiteSpace(entry.Participant)
                && !string.IsNullOrWhiteSpace(entry.TemplateId))
            .GroupBy(entry => entry.Participant!, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.First().TemplateId, StringComparer.Ordinal);

    private string? ParticipantProfileKeyFor(string scenarioCharacterId)
    {
        if (_frozenState is null || string.IsNullOrWhiteSpace(scenarioCharacterId))
        {
            return null;
        }

        return _frozenState.Characters
            .FirstOrDefault(character => string.Equals(
                character.CharacterId, scenarioCharacterId, StringComparison.OrdinalIgnoreCase))
            ?.ProfileKey;
    }

    /// <summary>
    /// The step this page presents. Identity travels as PACKS here (the page's own channel, resolved into face
    /// references by the render) and as a per-character Face slot, which binds one image out of the character's
    /// approved pack; the step also declares the elements a pack cannot carry - bodies and wardrobe per character,
    /// plus the frame-wide location and pose.
    /// </summary>
    private ImageStepBlueprint CompositionBlueprint => ImageStepBlueprintFactory.ForPackIdentityComposition(CompositionCast);

    /// <summary>
    /// The model this Composition will RENDER on. Identity-on-create runs the render on the identity-capable model, not
    /// on the composition model, so it is the one the render's own reference questions must be asked about — the same
    /// expression the render request uses, so the composer's answer cannot differ from the render's.
    /// </summary>
    private string? CompositionRenderModelId => _applyIdentityOnCreate ? _selectedIdentityModelId : _selectedModelId;

    /// <summary>
    /// The same binding with its direction statement seeded from the location image's analysis (B-160), when there is
    /// one and the operator has not already spoken for this reference.
    /// </summary>
    /// <remarks>
    /// The decision of WHO may write the statement lives in <see cref="ReferenceDirectionsPrefill.Apply"/>, not here: an
    /// analysis replaces only nothing-yet or an earlier analysis's own proposal, so the operator's words are never
    /// talked over — including after a re-read.
    ///
    /// <para>
    /// A missing or unreadable analysis leaves the binding exactly as it was. Binding an unanalysed location therefore
    /// changes nothing about what the prompt says, which is what keeps this safe to switch on for every binding.
    /// </para>
    /// </remarks>
    private async Task<ReferenceApplicationSelection> WithLocationAnalysisAsync(ReferenceApplicationSelection binding)
    {
        if (string.IsNullOrWhiteSpace(binding.SceneAssetImageId)
            || !string.Equals(binding.Kind, ImageStepSlotKind.Location.ToString(), StringComparison.OrdinalIgnoreCase))
        {
            return binding;
        }

        try
        {
            var image = await AssetService.GetImageAsync(binding.SceneAssetImageId);
            var analysis = LocationImageAnalysisJson.TryRead(image?.LocationAnalysisJson);

            // A reading of a SUPERSEDED picture is not used: the analysis records which checksum it read, so binding a
            // re-edited image cannot inherit the old picture's features.
            if (image is null || analysis is null || !analysis.IsAbout(image.Sha256))
            {
                return binding;
            }

            // The binding is the one this page just built, so it is this page's to set. A class rather than a record:
            // there is no `with`, and copying it wholesale would be a second, drifting definition of the binding.
            binding.Directions = ReferenceDirectionsPrefill.Apply(binding.Directions, analysis);
            return binding;
        }
        catch (InvalidOperationException)
        {
            // An analysis that cannot be read is treated as absent: the reference still binds, only the proposal is lost.
            return binding;
        }
    }

    private async Task OnReferenceBindingsChanged(IReadOnlyList<ReferenceApplicationSelection> bindings)
    {
        _referenceBindings = bindings;
        await SyncBoundPoseAsync(bindings);
        StateHasChanged();
    }

    /// <summary>
    /// Keeps the page's LoRA selection in step with the composer, which is the operator's single control over what
    /// this composition render applies. Empty clears it back to the configured "no LoRA" state.
    /// </summary>
    private Task OnCharacterLorasChanged(IReadOnlyList<SceneImageCharacterLoraSelection> selections)
    {
        _characterLoras = selections;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// The composition's scene-LoRA selection. Empty clears it back to the configured "no scene LoRA" state, in
    /// which the render emits no loader node for them at all.
    /// </summary>
    private Task OnSceneLorasChanged(IReadOnlyList<SceneImageLoraSelection> selections)
    {
        _sceneLoras = selections;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// A model change runs the page's own model logic AND drops the step's bindings: the slots a step offers depend on
    /// the selected model's capability, so keeping them would leave the plan describing a model no longer chosen. The
    /// composer's per-slot menu resolves strategies from that same capability, so the page no longer resets them.
    /// </summary>
    private async Task OnCompositionModelSelectedAsync(string? modelId)
    {
        _selectedModelId = modelId;
        _referenceBindings = [];
        // A scene LoRA binds to a model FAMILY, so changing the model invalidates the choice: carrying it over would
        // either refuse the render or apply a LoRA trained against a different family. Cleared here, where the change
        // happens, rather than filtered later.
        _sceneLoras = [];
        // Qwen-Image-2.1 carries identity as reference images and pose as a reference skeleton, so the IP-Adapter /
        // ControlNet machinery on this page is hidden for that family. It is CLEARED as well: a hidden control that
        // still reaches the render is invisible behaviour the operator can neither see nor switch off.
        if (SelectedCompositionModelFamily == SceneImageModelFamily.QwenImage21
            && (_applyIdentityOnCreate || !string.IsNullOrWhiteSpace(_poseStoragePath)))
        {
            _applyIdentityOnCreate = false;
            _poseStoragePath = null;
            _statusMessage = "Qwen-Image-2.1 carries identity and pose through reference images, so 'Identity on create' "
                + "and the pose upload were cleared for this model.";
        }
        // The location binding re-seeds only after re-validation against the new model's slot plan; a blueprint that
        // declares no location slot shows a notice instead of a silent drop. Forced, because the step was just cleared
        // above and the once-per-page latch would otherwise swallow this deliberate re-seed.
        await SeedLocationBackdropIfBoundAsync(force: true);
        await OnModelChangedAsync();
    }
