        => Nav.NavigateTo($"/roleplay/video-studio/session/{sessionId}/{interactionId}/{attempt.Id}");

    /// <summary>
    /// Re-applies what made this image to this page: the prompt that reached the sampler, the model, the reference set,
    /// and the LoRAs and pose the render carried.
    ///
    /// <para>
    /// The bindings are RESTORED rather than re-derived: they are the record of what the model actually received, and
    /// re-planning them from the moment produces a similar frame instead of this one's inputs. The card's command
    /// promises "the prompt, model, size, seed and references that made this image"; restoring only the model and the
    /// bindings — which is what this used to do — left the prompt box untouched, so the one input the operator asked
    /// for by name appeared not to happen at all.
    /// </para>
    ///
    /// <para>
    /// The model is adopted only when it is still one of the ENABLED Composition models this page offers. An image
    /// produced by an edit records an editor model, and so does an image whose row was later reconfigured as one, and
    /// Model Manager keeps editor models out of the Composition picker — adopting such an id left the selection naming
    /// a model the page cannot render with, which took the whole page down instead of saying so.
    /// </para>
    /// </summary>
    private async Task RestoreCompositionInputsAsync(SceneImageRecord attempt)
    {
        if (attempt.Status != SceneImageStatus.Complete)
        {
            _statusMessage = "Only a completed Composition image has recorded inputs that can be restored.";
            return;
        }

        var recordedModelId = attempt.RequestedModelId;
        var modelRestored = !string.IsNullOrWhiteSpace(recordedModelId)
            && _modelChoices.Any(choice => choice.ModelId == recordedModelId);
        if (modelRestored)
        {
            _selectedModelId = recordedModelId;
        }

        _referenceBindings = ReadRecordedBindings(attempt);
        var promptStyle = await RestoreRecordedPromptAsync(attempt);
        var notRecorded = RestoreRecordedSettings(attempt);

        var parts = new List<string>();
        parts.Add(promptStyle is { } style
            ? $"the {SceneImagePromptStyleResolver.DisplayLabel(style)} prompt"
            : "no prompt (this image's prompt record is gone)");
        parts.Add(string.IsNullOrWhiteSpace(recordedModelId)
            ? "no model"
            : modelRestored
                ? "the model"
                : $"no model (the recorded model '{recordedModelId}' is not an enabled Composition model, so the "
                    + "current selection was kept)");
        parts.Add(_referenceBindings.Count == 0
            ? "no reference set"
            : $"{_referenceBindings.Count} reference(s)");
        if (notRecorded.Count > 0)
        {
            parts.Add($"nothing for {string.Join(", ", notRecorded)} (not recorded on this image)");
        }

        _statusMessage = $"Reloaded {string.Join(", ", parts)}.";
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Puts the prompt that made this image back into the style box it was drawn in, and adopts that image's own prompt
    /// record so the next render uses the record the image was rendered from rather than whichever draft happened to be
    /// loaded.
    ///
    /// <para>
    /// The TEXT comes from the image's own <c>PromptSnapshot</c> — what the sampler actually received — and the STYLE
    /// from the prompt record, which is the only thing that records it. When the record is gone there is no way to know
    /// which style the prompt was drawn in, so nothing is written and the caller says so: writing it into a guessed tab
    /// would put a Pony tag prompt into the natural-language box.
    /// </para>
    /// </summary>
    /// <returns>The style the prompt was restored into, or null when nothing could be restored.</returns>
    private async Task<SceneImagePromptStyle?> RestoreRecordedPromptAsync(SceneImageRecord attempt)
    {
        if (string.IsNullOrWhiteSpace(attempt.PromptRecordId))
        {
            return null;
        }

        var record = await ImageService.GetPromptAsync(sessionId, attempt.PromptRecordId);
        if (record is null)
        {
            return null;
        }

        var style = SceneImagePromptStyleResolver.Effective(record.PromptStyle);
        AdoptCompletedPrompt(record);
        // Reloading an image is an explicit "make the panel look like it did" request, so the source and the intent
        // come back with the prompt — the once-per-page guard exists only to stop POLLS from stomping edits. The
        // restored panel is then SAVED, so a later page load shows this image's drafting state rather than the one
        // that happened to be stored before the reload.
        AdoptPromptSource(record);
        await SavePromptDraftAsync();
        if (!string.IsNullOrWhiteSpace(attempt.PromptSnapshot))
        {
            SetPromptText(style, attempt.PromptSnapshot);
        }

        _activeStyle = style;
        return style;
    }

    /// <summary>
    /// Re-applies the LoRAs and the pose the render carried, out of the settings snapshot the image recorded, and
    /// reports which of them the image did not record at all.
    /// </summary>
    /// <returns>The names of the inputs this image recorded nothing for.</returns>
    private List<string> RestoreRecordedSettings(SceneImageRecord attempt)
    {
        var recorded = SceneImageRecordedInputs.Read(attempt.SettingsJson);
        var notRecorded = new List<string>();

        if (recorded.CharacterLoras.Count > 0)
        {
            _characterLoras = recorded.CharacterLoras;
        }
        else
        {
            notRecorded.Add("character LoRAs");
        }

        if (recorded.SceneLoras.Count > 0)
        {
            _sceneLoras = recorded.SceneLoras;
        }
        else
        {
            notRecorded.Add("scene LoRAs");
        }

        if (string.IsNullOrWhiteSpace(recorded.PoseSkeletonRelativePath))
        {
            notRecorded.Add("the pose");
        }
        else
        {
            _poseStoragePath = recorded.PoseSkeletonRelativePath;
            if (recorded.PoseStrength is { } strength)
            {
                _poseStrength = strength;
            }
            else
            {
                notRecorded.Add("the pose's strength");
            }
        }

        return notRecorded;
    }

    /// <summary>
    /// The card's "use as reference": restore what made this Composition AND bind the image ITSELF as the step's
    /// location reference, so the next render is anchored to this place.
    ///
    /// <para>
    /// The image goes in as a LOCATION reference through the composer's own plan — the only thing that may author a
    /// binding — because that is what an operator means by "use this picture as the place". Nothing is invented about
    /// its approval: it is a rendered image, and the channel that carries it asks only for the bytes it was bound with.
    /// </para>
    /// </summary>
    private async Task UseCompositionImageAsReferenceAsync(SceneImageRecord attempt)
    {
        if (attempt.Status != SceneImageStatus.Complete || string.IsNullOrWhiteSpace(attempt.FileRelativePath))
        {
            _statusMessage = "Only a completed Composition image can be used as a location reference.";
            return;
        }

        if (string.IsNullOrWhiteSpace(attempt.Sha256))
        {
            _statusMessage = $"Composition image '{attempt.Id}' records no checksum, so a reference to it could not be proven exact.";
            return;
        }

        await RestoreCompositionInputsAsync(attempt);
        _requestedLocationReference = SceneImageLocationReferenceRequest.ForRenderedImage(
            attempt.Id, attempt.Sha256, attempt.DisplayName);
        // The restore's own report is kept rather than replaced: which inputs came back (and which the image never
        // recorded) is what tells the operator whether this really is the render they meant to continue from.
        _statusMessage = $"{_statusMessage} Bound this image itself as the Location reference — render to continue from it.";
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The reference set a finished render recorded, or none when it recorded nothing readable. Unreadable provenance is
    /// treated as ABSENT rather than thrown over: the row's own record is what is being restored, and refusing to open
    /// the image because its provenance cannot be parsed would hide the image over a detail of its metadata.
    /// </summary>
    private IReadOnlyList<ReferenceApplicationSelection> ReadRecordedBindings(SceneImageRecord attempt)
    {
        if (string.IsNullOrWhiteSpace(attempt.AppliedReferenceBindingsJson))
        {
            return [];
        }

        try
        {
            return JsonSerializer.Deserialize<List<ReferenceApplicationSelection>>(
                attempt.AppliedReferenceBindingsJson, JsonOptions) ?? [];
        }
        catch (JsonException exception)
        {
            Logger.LogWarning(
                exception, "Recorded reference bindings for Composition image {ImageId} are unreadable.", attempt.Id);
            _statusMessage = "This image's recorded reference set is unreadable, so it was left as it was.";
            return [];
        }
    }

    private async Task OnModelChangedAsync()
    {
        // Re-derive the identity-capable model options and re-check the ReferenceConditioning
        // capability whenever the Composition image model changes, so Model Manager edits or model
        // switches are reflected immediately (not only on the identity-model dropdown).
        _identityModelChoices = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: true)).ToList();
        if (!_identityModelChoices.Any(choice => choice.ModelId == _selectedIdentityModelId))
            _selectedIdentityModelId = ModelChoiceOrdering.AutoSelect(_identityModelChoices)?.ModelId;
        _applyIdentityOnCreate = false;
        await RefreshIdentityResolutionAsync();

        // A strategy chosen for the PREVIOUS model is not necessarily executable on this one. The composer's own
        // per-slot menu intersects each slot's meaning with the SELECTED model's capability, so there is no page-level
        // element list to reset here - and no "reset to TextOnly" branch that could quietly downgrade what was bound.

        await InvokeAsync(StateHasChanged);
    }

    private async Task SetCompositionDispositionAsync(SceneImageRecord attempt, SceneImageAttemptDisposition next)
    {
        await RunAsync(async () =>
        {
            var expected = attempt.Disposition ?? SceneImageAttemptDisposition.Active;
            await ProductionService.SetDispositionAsync(attempt.Id, _productionGroup!.Id, expected, next);
            _statusMessage = next == SceneImageAttemptDisposition.Shortlisted
                ? "Composition shortlisted."
                : "Composition returned to active.";
            await LoadAsync();
        });
    }

    private async Task ApproveCompositionAttemptAsync(SceneImageRecord attempt)
    {
        await RunAsync(async () =>
        {
            if (_productionGroup is null)
                throw new InvalidOperationException("Choose a production group before approving a frame.");
            // The gate is the DOMAIN's, so this page and the approval itself reach the same verdict. It used to demand a
            // skipped identity policy here as well as in the studio, which is why an attempt was approvable on one
            // surface and not the other.
            if (SceneImageFrameApprovalGate.BlockerFor(_productionGroup, attempt) is { } blocker)
                throw new InvalidOperationException(blocker.Message);
            await ProductionService.ApproveAsync(_productionGroup.Id, attempt.Id, attempt.Sha256!, "Composition Composer", null);
            _statusMessage = "Composition approved.";
            await LoadAsync();
        });
    }

    private void RequestDeleteCompositionAsync(SceneImageRecord attempt)
    {
        _deleteConfirmImageId = attempt.Id;
        StateHasChanged();
    }

    private void CancelDeleteComposition()
    {
        _deleteConfirmImageId = null;
        StateHasChanged();
    }

    private async Task ConfirmDeleteCompositionAsync(SceneImageRecord attempt)
    {
        await RunAsync(async () =>
        {
            await ImageService.DeleteImageAsync(sessionId, attempt.Id);
            _deleteConfirmImageId = null;
            _statusMessage = "Composition deleted.";
            await LoadAsync();
        });
    }

    private string SelectedModelLabel()
        => _modelChoices.FirstOrDefault(choice => choice.ModelId == _selectedModelId)?.DisplayName
            ?? throw new InvalidOperationException("The selected Composition model is no longer enabled.");

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _errorMessage = string.Empty;
        _statusMessage = string.Empty;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            Logger.LogWarning(exception, "Composition Composer action failed: ProductionGroupId={ProductionGroupId}", productionGroupId);
        }
        finally
        {
            _busy = false;
        }
    }

    private bool HasInFlightWork()
        => _pendingPrompt?.Status == SceneImagePromptStatus.Pending
            || _compositionAttempts.Any(attempt => attempt.Status is SceneImageStatus.Pending or SceneImageStatus.Generating);

    private void EnsurePollingWhenNeeded()
    {
        if (!HasInFlightWork() || _pollingTask is not null)
            return;
        _pollingCts = new CancellationTokenSource();
        _pollingTask = Task.Run(() => PollAsync(_pollingCts.Token));
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
                if (!HasInFlightWork())
                    return;
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _pollingTask = null;
        }
    }

    private static int WordCount(string text)
        => string.IsNullOrWhiteSpace(text) ? 0 : text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private static int EstimateTokens(string text)
        => string.IsNullOrWhiteSpace(text) ? 0 : (int)Math.Ceiling(text.Length / 4.0);

    public async ValueTask DisposeAsync()
    {
        if (_pollingCts is not null)
        {
            await _pollingCts.CancelAsync();
            _pollingCts.Dispose();
        }

        // A debounced save that has not fired yet holds the operator's last few seconds of typing: write the panel once
        // more before the circuit goes away rather than dropping them. An extra identical write costs one UPDATE and is
        // cheaper than reasoning about whether the timer beat us to it.
        if (_draftSaveCts is not null)
        {
            await _draftSaveCts.CancelAsync();
            await SavePromptDraftAsync();
        }
    }
}