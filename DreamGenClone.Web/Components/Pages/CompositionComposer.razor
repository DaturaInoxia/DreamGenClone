    /// <summary>One reference as the operator must see it: the tag the prompt will carry, and the binding itself.</summary>
    private sealed record ReferenceLine(ReferenceApplicationSelection Binding, string? Tag);

    /// <summary>
    /// The references in the order the render SENDS them, each with the <c>&lt;imageN&gt;</c> tag the prompt will
    /// carry — so the numbers the operator writes into their intent are the numbers the model receives.
    /// </summary>
    /// <remarks>
    /// The tag comes from <see cref="ReferenceRoleClauses.TagsFor"/>, the same owner the prompt uses. It used to be
    /// printed from <see cref="ReferenceApplicationSelection.Ordinal"/>, which is stored request data and can carry a
    /// GAP where a slot was bound and then cleared — so the panel numbered the wardrobe one image later than the tag
    /// the render actually sent, and an intent that named "the wardrobe image" pointed the compiler at the unclothed
    /// body plate instead (SceneImage 39af0b11 rendered topless from a prompt that named the wardrobe). A null tag is
    /// not a missing number: the render sends the image untagged because a single-image request forbids tags.
    /// </remarks>
    private IReadOnlyList<ReferenceLine> ReferencesInSendOrder()
    {
        var tags = ReferenceRoleClauses.TagsFor(_referenceBindings);
        return ReferenceBindingShape.InSendOrder(_referenceBindings)
            .Select(binding => new ReferenceLine(binding, tags.TryGetValue(binding, out var tag) ? tag : null))
            .ToList();
    }

    /// <summary>
    /// Puts the source and the intent text a persisted draft was made with back on the panel. Both ride on the prompt
    /// record already — that is what makes a compile auditable — so nothing extra is stored to restore them.
    /// </summary>
    private void AdoptPromptSource(SceneImagePromptRecord record)
    {
        if (!string.IsNullOrWhiteSpace(record.UserIntent))
        {
            _userIntentText = record.UserIntent!;
        }

        _promptSource = record.PromptSource;
        _promptInputTab = record.PromptSource;
    }

    /// <summary>
    /// Restores the source and the intent text from this Composition's own drafts, once, so reopening the page shows
    /// what the operator wrote instead of resetting the source to Scene and the intent box to empty.
    /// </summary>
    /// <remarks>
    /// The newest draft decides the SOURCE, because it is the last thing they actually compiled with. The TEXT comes
    /// from the newest draft that carried one, so a draft since switched to Scene does not throw the intent away.
    ///
    /// <para>
    /// This is the FALLBACK for work done before the group carried an uncommitted draft; a saved
    /// <see cref="SceneImageProductionGroup.PromptDraftJson"/> wins and suppresses this entirely.
    /// </para>
    /// </remarks>
    private void RestorePromptSourceFromDrafts()
    {
        if (_promptSourceInitialized || _completedByStyle.Count == 0)
        {
            return;
        }

        var drafts = _completedByStyle.Values
            .OrderByDescending(record => record.UpdatedUtc)
            .ToList();

        _promptSource = drafts[0].PromptSource;

        // The TEXT comes from the newest draft that carried one, so a draft since switched to Scene does not throw the
        // intent away — and the panel OPENS on it, because a restored draft the operator cannot see is the same as a
        // lost one (the reported "I typed a user intent and now I can't find it"). The source select still shows what
        // the last compile actually used, so flipping it back is one click and the text is already there.
        var withIntent = drafts.FirstOrDefault(record => !string.IsNullOrWhiteSpace(record.UserIntent));
        if (withIntent is not null)
        {
            _userIntentText = withIntent.UserIntent!;
        }

        _promptInputTab = string.IsNullOrWhiteSpace(_userIntentText)
            ? _promptSource
            : SceneImagePromptSource.UserIntent;

        _promptSourceInitialized = true;
    }

    /// <summary>
    /// Restores the panel from the draft saved on this group — the source and the intent the operator had typed, sent
    /// to the compiler or not. Suppresses the compiled-draft fallback, because the saved panel is what they last saw.
    /// </summary>
    private void RestorePromptDraft()
    {
        // Once only: LoadAsync runs on every poll, and a poll that re-applied the stored draft would roll back the
        // characters typed since the last debounced save — the same hazard the prompt-text hydration guards against.
        if (_promptSourceInitialized)
        {
            return;
        }

        var draft = SceneImagePromptDraftJson.Read(_productionGroup?.PromptDraftJson, productionGroupId);
        if (draft is null)
        {
            return;
        }

        _promptSource = draft.Source;
        _userIntentText = draft.UserIntent;
        _explicitness = draft.Explicitness;
        _cameraHolderParts = draft.CameraHolderParts;
        _cameraHolderPartsText = string.Empty;
        _promptInputTab = string.IsNullOrWhiteSpace(draft.UserIntent)
            ? draft.Source
            : SceneImagePromptSource.UserIntent;
        _promptSourceInitialized = true;
    }

    /// <summary>
    /// Saves what the panel currently says, so the intent survives a reload without waiting for Generate Prompt.
    /// </summary>
    private async Task SavePromptDraftAsync()
    {
        if (_productionGroup is null)
        {
            return;
        }

        try
        {
            _productionGroup = await ProductionService.SavePromptDraftAsync(
                _productionGroup.Id, _promptSource, _userIntentText, BuildPromptOverrides(), _explicitness,
                _cameraHolderParts, _cameraHolderPartsText);
        }
        catch (InvalidOperationException exception)
        {
            // The panel keeps the operator's text either way; a failed save is reported rather than swallowed.
            _errorMessage = $"The prompt draft could not be saved: {exception.Message}";
        }
    }

    /// <summary>
    /// Schedules the draft save for after the operator stops typing.
    /// </summary>
    /// <remarks>
    /// Wired to <c>oninput</c> and DEBOUNCED, rather than to the change event, because a change event only fires on blur
    /// — an operator who types an intent and reloads without clicking away would lose exactly the text this exists to
    /// keep. Debouncing is what makes a per-keystroke trigger affordable: the store is SQLite, and one write per
    /// character is churn nobody asked for, while the trailing save guarantees the LAST keystroke is the one that lands.
    /// </remarks>
    private void QueuePromptDraftSave()
    {
        // Restoring the saved edits must not immediately write them back: the first load would queue a save for state
        // it just read.
        if (_productionGroup is null || _restoringPromptInspector)
        {
            return;
        }

        // Only CANCEL the previous timer; it disposes itself in its own finally. Disposing a source here could pull the
        // token out from under the delay still observing it.
        _draftSaveCts?.Cancel();

        var source = new CancellationTokenSource();
        _draftSaveCts = source;
        _ = DebouncedPromptDraftSaveAsync(source);
    }

    private async Task DebouncedPromptDraftSaveAsync(CancellationTokenSource source)
    {
        try
        {
            await Task.Delay(PromptDraftSaveDelay, source.Token);
            await InvokeAsync(SavePromptDraftAsync);
        }
        catch (OperationCanceledException)
        {
            // Superseded by the next keystroke — the newer timer carries the text.
        }
        catch (Exception)
        {
            // SavePromptDraftAsync reports its own failures through _errorMessage. Anything that reaches here is the
            // renderer going away mid-save, which there is nobody left to tell.
        }
        finally
        {
            if (ReferenceEquals(_draftSaveCts, source))
            {
                _draftSaveCts = null;
            }

            source.Dispose();
        }
    }

    private string StudioUrl => $"/roleplay/studio/{sessionId}/{interactionId}/production/{productionGroupId}";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (!string.IsNullOrWhiteSpace(_canonicalRedirectUrl))
        {
            return;
        }

        await ApplyRequestedLocationReferenceAsync();
        await ApplyRequestedReloadAsync();
        EnsurePollingWhenNeeded();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // A production group is anchored to the interaction that created it (one group per Moment + POV). The Studio can
        // be opened on a sibling interaction of the same turn and build a Composition link from the current route, so a
        // hand-edited or stale URL can pair the group with the wrong interaction. That used to throw an unhandled
        // InvalidOperationException (500, reported 2026-10-27); the pair is recoverable, so send the operator to the URL
        // where the group and its renders are consistent. Done AFTER render because navigation is not available during
        // prerendering.
        if (string.IsNullOrWhiteSpace(_canonicalRedirectUrl))
        {
            return;
        }

        var url = _canonicalRedirectUrl;
        _canonicalRedirectUrl = null;
        Nav.NavigateTo(url, replace: true);
    }

    /// <summary>
    /// Applies a <c>reloadImageId</c> request once: the named image's recorded inputs are re-applied to this
    /// Composition, exactly as the card's own reload command applies them.
    ///
    /// <para>
    /// The row is read BY ID rather than looked up in this page's list, because the request comes from a card that may
    /// be showing any image of the production group — an edit or a finish attempt included. What the page refuses is an
    /// id that names no image at all, or one belonging to another session.
    /// </para>
    /// </summary>
    private async Task ApplyRequestedReloadAsync()
    {
        if (string.IsNullOrWhiteSpace(ReloadImageId)
            || string.Equals(_appliedReloadImageId, ReloadImageId, StringComparison.Ordinal))
        {
            return;
        }

        _appliedReloadImageId = ReloadImageId;

        var image = await ResolveRequestedImageAsync(ReloadImageId);
        if (image is null)
        {
            _statusMessage = $"Image '{ReloadImageId}' was not found in this session, so nothing was reloaded.";
            return;
        }

        await RestoreCompositionInputsAsync(image);
    }

    /// <summary>
    /// Applies a <c>useAsReferenceId</c> request once: the named image is bound as this Composition's location
    /// reference.
    ///
    /// <para>
    /// The row is read BY ID rather than looked up in this page's own attempt list. That list holds the
    /// Composition-stage attempts, but the card's command is offered on every attempt of the production group, so
    /// resolving through the list alone meant an edit — or any later stage — was refused with a reason the operator had
    /// no way to act on. What the page refuses is an id that names no image at all, or one belonging to another session;
    /// whether the image is exact enough to condition a render on (complete, bytes, checksum) is checked by the same
    /// path the page's own cards use.
    /// </para>
    /// </summary>
    private async Task ApplyRequestedLocationReferenceAsync()
    {
        if (string.IsNullOrWhiteSpace(UseAsReferenceId)
            || string.Equals(_appliedUseAsReferenceId, UseAsReferenceId, StringComparison.Ordinal))
        {
            return;
        }

        _appliedUseAsReferenceId = UseAsReferenceId;

        var image = await ResolveRequestedImageAsync(UseAsReferenceId);
        if (image is null)
        {
            _statusMessage = $"Image '{UseAsReferenceId}' was not found in this session, so nothing was bound as a "
                + "location reference.";
            return;
        }

        await UseCompositionImageAsReferenceAsync(image);
    }

    /// <summary>
    /// The image a card's command named, read from its OWN row. Null when the id names no image, or names one belonging
    /// to another session: a request travels in a URL, and a URL can be edited or replayed against another session's
    /// page.
    /// </summary>
    private async Task<SceneImageRecord?> ResolveRequestedImageAsync(string imageId)
    {
        var image = await ImageService.GetImageAsync(imageId);
        return image is not null && string.Equals(image.SessionId, sessionId, StringComparison.Ordinal)
            ? image
            : null;
    }

    private async Task LoadAsync()
    {
        var group = await ProductionService.GetGroupAsync(productionGroupId)
            ?? throw new InvalidOperationException($"Production group '{productionGroupId}' was not found.");
        if (!string.Equals(group.SessionId, sessionId, StringComparison.Ordinal))
        {
            throw new InvalidOperationException("The requested production group does not belong to this Studio context.");
        }

        if (!string.Equals(group.InteractionId, interactionId, StringComparison.Ordinal))
        {
            _canonicalRedirectUrl =
                $"/roleplay/studio/{group.SessionId}/{group.InteractionId}/production/{group.Id}/composition";
            return;
        }

        _productionGroup = group;

        _compiledMediaBrief = await ProductionService.GetOrCreateStillBriefAsync(_productionGroup.Id);

        if (_pendingPrompt is not null && _pendingPrompt.Status == SceneImagePromptStatus.Pending)
        {
            _pendingPrompt = await ImageService.GetPromptAsync(sessionId, _pendingPrompt.Id);
        }

        if (_pendingPrompt is not null && _pendingPrompt.Status != SceneImagePromptStatus.Pending)
        {
            // A generation this page started finished: adopt its result into the matching style tab. A FAILED one is
            // KEPT rather than discarded — the failure is the only thing that explains a draft that never appeared,
            // and the status line this page set when it queued the draft is stale the moment the draft is over.
            if (_pendingPrompt.Status == SceneImagePromptStatus.Complete)
            {
                AdoptCompletedPrompt(_pendingPrompt);
            }
            else
            {
                _failedPrompt = _pendingPrompt;
            }

            _pendingPrompt = null;
            _statusMessage = string.Empty;
        }

        if (!_promptsInitialized && _pendingPrompt is null)
        {
            // First load on this page: hydrate the latest completed prompt for each style so both
            // tabs show their last drafted prompt. Polls later never overwrite in-progress edits.
            await RefreshCompletedPromptAsync(SceneImagePromptStyle.NaturalLanguage);
            await RefreshCompletedPromptAsync(SceneImagePromptStyle.PonyV6Tags);
            await RefreshFailedPromptAsync();
            _promptsInitialized = true;
        }

        // Outside the block above so a load whose prompt was still Pending restores on the poll that completes it —
        // and self-guarding, so no later poll overwrites the source or the intent the operator is working on. The
        // saved panel wins over the compiled drafts: it is what they last saw, including text never compiled.
        RestorePromptDraft();
        RestorePromptSourceFromDrafts();

        // ONE read of the group, projected twice. The stage filter below is what the step itself reasons about — which
        // Composition attempts exist, and what made them. The list beside it is the same rows WITHOUT that filter, so
        // the page can show the group's whole work (see _productionImages).
        var groupImages = await ProductionService.ListAttemptsAsync(_productionGroup.Id);
        _compositionAttempts = groupImages
            .Where(attempt => attempt.ProductionStage == SceneImageProductionStage.Composition)
            .OrderByDescending(attempt => attempt.CreatedUtc)
            .Take(100)
            .ToList();
        _productionImages = groupImages
            .OrderByDescending(attempt => attempt.CreatedUtc)
            .Take(100)
            .ToList();
        _modelChoices = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: false)).ToList();
        _selectedModelId = KeepSelection(_modelChoices, _selectedModelId);

        _identityModelChoices = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: true)).ToList();
        _selectedIdentityModelId = KeepSelection(_identityModelChoices, _selectedIdentityModelId);
        if (_identityPackOptions.Count == 0)
            await LoadIdentityPackOptionsAsync();
        if (_identityResolution is null)
            await RefreshIdentityResolutionAsync();

        if (_momentEnrichment is null)
            await LoadMomentEnrichmentAsync();
        await LoadScenarioCharactersAsync();
        if (!_promptRowsInitialized && _compiledMediaBrief is not null)
        {
            _castReferenceError = null;
            BuildPromptRows();
            RestorePromptInspectorOverrides();
        }
        _approvedAttemptIds = (await ProductionService.ListApprovalDecisionsAsync(_productionGroup.Id))
            .Where(decision => decision.Decision == ApprovedSceneFrameDecisionState.Approved)
            .Select(decision => decision.SceneImageId)
            .ToHashSet(StringComparer.Ordinal);

        await SeedLocationBackdropIfBoundAsync();
        await LoadFramingChoicesAsync();
    }

    /// <summary>
    /// Reads the framings this surface may be rendered at from the Composition staging profile (B-161).
    /// </summary>
    /// <remarks>
    /// Once per page: the profile is the configured vocabulary, and re-reading it on every poll tick would be a second
    /// source of truth for a list that only changes when an operator edits /profiles. A profile that declares no shot
    /// sizes legitimately yields none, and the framing control then does not render.
    /// </remarks>
    private async Task LoadFramingChoicesAsync()
    {
        if (_framingChoicesLoaded)
        {
            return;
        }

        try
        {
            var profile = await StagingProfiles.ResolveAsync(ImageStagingSurface.Composition);
            _framingChoices = ImageStagingProfileValidation.ReadFramingChoices(profile);
            _framingChoicesLoaded = true;
        }
        catch (Exception exception)
        {
            // A profile that cannot be read is reported, not guessed: the framing control stays hidden and the render
            // keeps using the framing the brief was compiled with.
            Logger.LogWarning(
                exception, "Reading the Composition staging profile for framing choices failed.");
        }
    }

    /// <summary>
    /// The Composition auto-seed: on composer open, a bound per-POV backdrop re-seeds the declared <c>Location</c> slot
    /// from the group (the durable record). A blueprint that declares no location slot is refused by name — the
    /// operator sees a notice, never a silently dropped reference.
    ///
    /// <para>
    /// It is an INITIALISATION: it fills an EMPTY step, once, and never touches a step that holds anything. This
    /// method used to run on every load — and <c>LoadAsync</c> runs on the 2-second poll — while REPLACING the whole
    /// binding list with the location alone, so a face and a body the operator had just added disappeared a moment
    /// later (reported 2026-10-12). Both guards are needed: the emptiness check stops the poll overwriting the
    /// operator's bindings, and the once-per-page latch stops the seed re-adding a location the operator removed. A
    /// model change still re-seeds — it clears the step and passes <paramref name="force"/>, because the backdrop has
    /// to be re-validated against the new model's declared slots.
    /// </para>
    /// </summary>
    /// <param name="force">
    /// Bypasses the once-per-page latch for a caller that has just cleared the step on purpose. It never bypasses the
    /// emptiness check: nothing may overwrite what the operator bound.
    /// </param>
    private async Task SeedLocationBackdropIfBoundAsync(bool force = false)
    {
        _locationSeedNotice = null;

        // A forced re-seed withdraws ONLY the binding this method seeded, because the model that will run the render
        // can change under it (a new composition model, a new identity model, identity-on-create) and a reference the
        // previous model could carry has to be re-proved against the new one. Withdrawing it is what lets the check
        // below be reached at all: without it the step looks populated and the stale binding is left to fail at render
        // time. Anything the OPERATOR bound is never touched — the emptiness check is about their bindings, not ours.
        if (force && _locationSeededImageId is not null)
        {
            _referenceBindings = _referenceBindings
                .Where(binding => !string.Equals(binding.SceneAssetImageId, _locationSeededImageId, StringComparison.Ordinal))
                .ToList();
            _locationSeededImageId = null;
        }

        // A populated step is never touched, whatever else is configured. Checked before the latch so that no caller,
        // forced or not, can overwrite the operator's bindings.
        if (_referenceBindings.Count > 0)
        {
            return;
        }

        // LoadAsync runs on the 2-second poll; the seed belongs to the page's first load.
        if (_locationSeedDone && !force)
        {
            return;
        }

        _locationSeedDone = true;

        if (_productionGroup is null || string.IsNullOrWhiteSpace(_productionGroup.LocationBackdropJson))
        {
            return;
        }

        SceneImageLocationBackdrop? backdrop;
        try
        {
            backdrop = JsonSerializer.Deserialize<SceneImageLocationBackdrop>(_productionGroup.LocationBackdropJson, JsonOptions);
        }
        catch (JsonException)
        {
            backdrop = null;
        }

        if (backdrop is null)
        {
            return;
        }

        // The model that will RUN this render decides whether a backdrop can be carried at all: a location reference is
        // an image, and a model that declares no reference strategy (Krea 2: ["TextOnly","Lora"]) has nowhere to put it.
        // Seeding it anyway is what made such a Composition die in the render with "does not declare support for
        // 'NativeMultiReference' in Model Manager" (2026-10-13). A declared slot is not a capability.
        var seed = await LocationBackdropSlotPrefill.ResolveAsync(
            ReferenceStrategies, CompositionRenderModelId, CompositionBlueprint, backdrop);
        var binding = seed.Binding;
        if (binding is null)
        {
            _locationSeedNotice = seed.Outcome == LocationBackdropSeedOutcome.ModelCannotCarry
                ? $"This model cannot carry the location reference; the bound backdrop was not applied. {seed.Reason}"
                : seed.Reason;
            return;
        }

        _referenceBindings = [await WithLocationAnalysisAsync(binding)];
        _locationSeededImageId = binding.SceneAssetImageId;
    }

    /// <summary>
    /// The identity model is a RENDER model, not a side setting: with identity-on-create ticked it is the model the
    /// Composition runs on, so the location binding has to be re-proved against it rather than left to fail at render
    /// time.
    /// </summary>
    private async Task OnIdentityModelSelectedAsync()
    {
        await RefreshIdentityResolutionAsync();
        await SeedLocationBackdropIfBoundAsync(force: true);
    }

    /// <summary>
    /// Ticking identity-on-create MOVES the render onto the identity-capable model, so the same re-proof runs here —
    /// and unticking moves it back.
    /// </summary>
    private Task OnIdentityOnCreateChangedAsync()
        => SeedLocationBackdropIfBoundAsync(force: true);

    private async Task RefreshCompletedPromptAsync(SceneImagePromptStyle style)
    {
        var record = await ImageService.GetLatestCompletedProductionPromptAsync(
            sessionId, interactionId, _productionGroup!.Id, _compiledMediaBrief!.Id, style);
        if (record is null) return;
        _completedByStyle[style] = record;
        SetPromptText(style, record.OutputPrompt);
    }

    /// <summary>
    /// Keeps the newest FAILED draft for this Composition so a page reopened after a failure says why there is no
    /// prompt instead of showing an empty box. Only this group's and this brief's newest record counts, and only when
    /// it FAILED: a later success replaces it, which is what makes the notice self-clearing.
    /// </summary>
    private async Task RefreshFailedPromptAsync()
    {
        if (_productionGroup is null || _compiledMediaBrief is null)
        {
            return;
        }

        var latest = await ImageService.GetLatestPromptAsync(sessionId, interactionId);
        if (latest is null
            || latest.Status != SceneImagePromptStatus.Failed
            || !string.Equals(latest.ProductionGroupId, _productionGroup.Id, StringComparison.Ordinal)
            || !string.Equals(latest.CompiledMediaBriefId, _compiledMediaBrief.Id, StringComparison.Ordinal))
        {
            return;
        }

        _failedPrompt = latest;
    }

    private void AdoptCompletedPrompt(SceneImagePromptRecord record)
    {
        var style = SceneImagePromptStyleResolver.Effective(record.PromptStyle);
        _completedByStyle[style] = record;
        SetPromptText(style, record.OutputPrompt);
    }

    private async Task GeneratePromptAsync()
    {
        await RunAsync(async () =>
        {
            var style = _activeStyle;

            // A new draft for this style retires the previous failure for it: the banner explains a missing prompt,
            // and a prompt is now on its way. A failure recorded for the OTHER style is left alone.
            if (_failedPrompt is not null
                && SceneImagePromptStyleResolver.Effective(_failedPrompt.PromptStyle) == style)
            {
                _failedPrompt = null;
            }

            var record = await ImageService.EnqueuePromptAsync(new ScenePromptRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                // B-161: the operator's frame correction travels with the DRAFT as well as the render, because the
                // prose is written here — a framing chosen on the panel but absent from this request would leave the
                // pre-processor writing the profile's framing into a prompt the render then frames differently.
                Settings = new SceneImageStudioSettings
                {
                    PromptOverrides = BuildPromptOverrides(),
                    SceneBlockingOverride = _blockingOverride,
                    Explicitness = _explicitness,
                    CameraHolderParts = _cameraHolderParts,
                    // B-167: the parts come from the moment's recorded contacts, so no custom text travels with the prompt.
                    CameraHolderPartsText = null
                },
                ProductionGroupId = _productionGroup!.Id,
                CompiledMediaBriefId = _compiledMediaBrief!.Id,
                Pov = _productionGroup.Pov,
                PromptStyle = style,
                RequestedImageModelId = _selectedModelId,
                // The bindings this render will carry, so the prompt is drafted KNOWING what the images supply and
                // does not describe it in prose. Without them the pre-processor writes a complete description of the
                // room (and its lighting) that the bound location image then has to argue with — and loses, because
                // the body is longer, earlier and more specific than the role clause appended under it. Measured
                // 2026-10-03: a prompt drafted with no bindings produced a render at mean brightness 43.5 against its
                // reference's 72.0, and as far from its own bound room (outer-ring L1 2.094) as two different views
                // of that shed are from each other (2.141).
                ReferenceApplications = _referenceBindings,
                PromptSource = _promptSource,
                UserIntent = _promptSource == SceneImagePromptSource.UserIntent ? _userIntentText : null
            });
            _pendingPrompt = record;
            SetPromptText(style, string.Empty);
            _activeStyle = style;
            _framingNotice = null;
            _statusMessage = $"Prompt generation queued ({SceneImagePromptStyleResolver.DisplayLabel(style)}).";
            EnsurePollingWhenNeeded();
        });
    }

    private async Task GenerateCompositionAsync()
    {
        // The count is the operator's number of JOBS, not a display mode: each iteration enqueues its own render with
        // the same prompt, model and reference snapshot, so every result is an ordinary row the page can approve,
        // discard or edit on its own.
        var count = Math.Max(1, _imageCount);
        for (var index = 0; index < count; index++)
        {
            await EnqueueCompositionAsync(null);
        }
    }

    private Task RegenerateCompositionAsync(SceneImageRecord source) => EnqueueCompositionAsync(source.Id);

    private async Task EnqueueCompositionAsync(string? regenerateOfId)
    {
        // A Composition always renders with the prompt style that matches the SELECTED model's
        // family (Pony => tag prompt; SDXL/FLUX/API => natural language), independent of which tab
        // is currently visible, so the right dialect is never sent to the wrong checkpoint.
        var style = RenderStyle;
        if (!_completedByStyle.TryGetValue(style, out var promptRecord)
            || promptRecord.Status != SceneImagePromptStatus.Complete)
            throw new InvalidOperationException(
                $"A completed {SceneImagePromptStyleResolver.DisplayLabel(style)} prompt is required before generating a Composition.");
        var prompt = PromptTextFor(style);
        if (string.IsNullOrWhiteSpace(prompt))
            throw new InvalidOperationException(
                $"The {SceneImagePromptStyleResolver.DisplayLabel(style)} prompt cannot be empty.");

        _activeStyle = style;

        await RunAsync(async () =>
        {
            await ImageService.UpdatePromptOutputAsync(sessionId, promptRecord.Id, prompt.Trim());
            var identityPacks = _applyIdentityOnCreate
                ? _identityPackOptions
                    .Where(option => string.Equals(option.PackId, _selectedIdentityPackId, StringComparison.Ordinal)
                        && !RemovedCharacterKeys.Contains(option.CharacterKey))
                    .Select(option => new IdentityPackSelection
                    {
                        PackId = option.PackId,
                        CharacterLabel = option.Label,
                        Strength = option.Strength,
                        // B-157: the actor key is the PARTICIPANT profile key the compiled Still brief addresses this
                        // character by (`p0`, `p1`, ...), which is the key the role clause and the prompt-element
                        // removals join on. See ParticipantProfileKeyFor.
                        ActorKey = ParticipantProfileKeyFor(option.CharacterKey)
                    })
                    .ToList()
                : null;
            // Pose and one-pass identity may only be combined when BOTH travel as references on the SAME model.
            // Identity through a configured IP-Adapter/PuLID graph and a pose through a ControlNet are different
            // graphs, so the skeleton would be silently dropped — refuse that, and only that. The render path
            // re-validates the same question authoritatively; this is the enqueue-time courtesy check.
            if (_applyIdentityOnCreate && !string.IsNullOrWhiteSpace(_poseStoragePath))
            {
                var poseStrategy = await ReferenceStrategies.ResolvePoseAsync(_selectedIdentityModelId);
                var poseTravelsAsReference = poseStrategy.IsAvailable
                    && string.Equals(poseStrategy.Strategy, ReferenceStrategyResolver.IdentityNativeMultiReference, StringComparison.OrdinalIgnoreCase);
                var identityTravelsAsReference = string.Equals(
                    _identityResolution?.Strategy,
                    ReferenceStrategyResolver.IdentityNativeMultiReference,
                    StringComparison.OrdinalIgnoreCase);
                if (!poseTravelsAsReference || !identityTravelsAsReference)
                {
                    throw new InvalidOperationException(
                        "Pose conditioning and 'Identity on create' cannot be combined on this model: it applies identity through a "
                        + "configured mechanism while the pose needs a separate ControlNet graph. Select a model that carries both as "
                        + "references (Qwen-Image-2.1), or clear one of them.");
                }
            }
            // A NATIVE reference render is decided by the step's BINDINGS, not by a second checkbox: a face bound from
            // an identity pack IS the request, and the render builds that exact view into a reference image
            // (SceneImageRenderingJobHandler.BuildNativeReferencesAsync resolves pack bindings; the pack's own face
            // resolver re-reads the pack, so a superseded reference fails the render instead of rendering a stranger).
            //
            // 'Identity on create' is the other route: the model's configured IP-Adapter/PuLID mechanism, which
            // resolves each selected pack's CANONICAL face. Binding a pack face as well would send that character two
            // faces by two mechanisms, so the two are refused together rather than quietly stacked.
            var nativePacks = _referenceBindings
                .Where(binding => string.Equals(binding.Kind, nameof(ImageStepSlotKind.Face), StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(binding.IdentityPackId)
                    && !string.IsNullOrWhiteSpace(binding.ReferenceAssetId))
                .GroupBy(binding => binding.IdentityPackId!, StringComparer.Ordinal)
                .Select(group => new IdentityPackSelection
                {
                    PackId = group.Key,
                    // The character the face belongs to, which is the label the operator recognises; the pack id is only
                    // a fallback for a binding that somehow names no actor.
                    CharacterLabel = group.Select(binding => binding.ActorKey)
                        .FirstOrDefault(actor => !string.IsNullOrWhiteSpace(actor)) ?? group.Key,
                    // B-157: the binding's actor key IS the profile key, so the role clause can name this person's
                    // position instead of only their pack view.
                    ActorKey = group.Select(binding => binding.ActorKey)
                        .FirstOrDefault(actor => !string.IsNullOrWhiteSpace(actor)),
                    Strength = 1.0
                })
                .ToList();

            if (_applyIdentityOnCreate && nativePacks.Count > 0)
            {
                throw new InvalidOperationException(
                    "This Composition applies identity through 'Identity on create' and also binds the character's face "
                    + "from an identity pack, which is two identity mechanisms for one frame. Clear the Face slot, or "
                    + "untick 'Apply identity while creating this composition'.");
            }

            var renderMode = _applyIdentityOnCreate
                ? SceneImageRenderMode.IdentityControlled
                : nativePacks.Count > 0
                    ? SceneImageRenderMode.NativeReference
                    : SceneImageRenderMode.PromptOnly;

            var firstPackId = identityPacks?.FirstOrDefault()?.PackId ?? nativePacks.FirstOrDefault()?.PackId;
            var renderSettings = new SceneImageStudioSettings();
            // B-157 T7.1: the operator's placement correction travels with the render, which is where the frame is
            // read and the only place the rule is applied — the same rule the preview above shows.
            if (_blockingOverride is { IsEmpty: false })
            {
                renderSettings.SceneBlockingOverride = _blockingOverride;
            }
            // The LoRA chain travels with the render, so the attempt records which artifact, strength and checksum
            // produced the image. Empty stays null: no LoRA means the graph is left untouched.
            if (_characterLoras.Count > 0)
            {
                renderSettings.CharacterLoras = _characterLoras.ToList();
            }
            // Scene LoRAs travel beside the character LoRAs on the SAME settings object, which is what the render
            // path resolves them from. Empty stays null for the same reason.
            if (_sceneLoras.Count > 0)
            {
                renderSettings.SceneLoras = _sceneLoras.ToList();
            }
            if (!string.IsNullOrWhiteSpace(_poseStoragePath))
            {
                renderSettings.PoseReference = new SceneImagePoseReference
                {
                    StoragePath = _poseStoragePath,
                    Strength = _poseStrength
                };
            }
            // Camera-holder body parts travel with the render so the handler can append them VERBATIM after the compiled
            // caption (the caption writer would scramble "behind" into "in front" if it wrote them itself). The parts
            // are derived from the moment's recorded contacts; B-167 retired the free-text override.
            if (_cameraHolderParts != CameraHolderPartsMode.None)
            {
                renderSettings.CameraHolderParts = _cameraHolderParts;
                renderSettings.CameraHolderPartsText = null;
            }
            await ImageService.EnqueueRenderAsync(new SceneRenderRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                PromptRecordId = promptRecord.Id,
                Prompt = prompt.Trim(),
                RequestedModelId = _applyIdentityOnCreate ? _selectedIdentityModelId : _selectedModelId,
                SettingsJson = JsonSerializer.Serialize(renderSettings),
                RegenerateOfId = regenerateOfId,
                ProductionGroupId = _productionGroup!.Id,
                CompiledMediaBriefId = _compiledMediaBrief!.Id,
                BeatId = _productionGroup.BeatId,
                Pov = _productionGroup.Pov,
                RenderMode = renderMode,
                IdentityPackId = firstPackId,
                // The CHANNEL carries packs only for the identity-controlled route. On the native route the packs
                // travel as the step's own bindings (ReferenceApplications), which is what makes the operator's
                // EXACT face view and build reach the render; sending them here as well would add the pack's
                // canonical face beside the bound one.
                IdentityPacks = identityPacks,
                ReferenceApplications = _referenceBindings
            });
            _statusMessage = regenerateOfId is null ? "Composition queued." : "Sibling Composition queued.";
            await LoadAsync();
            EnsurePollingWhenNeeded();
        });
    }

    private Task SelectPromptStyleAsync(SceneImagePromptStyle style)
    {
        _activeStyle = style;

        // Generating on a tab other than the family of the selected model is allowed (each style keeps its own
        // draft), but it must not look like the draft this Composition will use: a Composition always renders the
        // style the SELECTED model's family implies, so say which one that is.
        _statusMessage = style == RenderStyle
            ? string.Empty
            : $"Editing the {SceneImagePromptStyleResolver.DisplayLabel(style)} draft. This Composition renders the "
                + $"{SceneImagePromptStyleResolver.DisplayLabel(RenderStyle)} draft, because that is the dialect the selected model reads.";

        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Keeps a picker's current selection while the model is still enabled, otherwise falls back to the operator's
    /// configured default model (B-131), then to the first enabled choice. A stale id would reach the capability
    /// lookups as a model the operator can no longer see.
    /// </summary>
    private static string? KeepSelection(IReadOnlyList<SceneImageModelChoice> choices, string? current)
        => !string.IsNullOrWhiteSpace(current) && choices.Any(choice => choice.ModelId == current)
            ? current
            : ModelChoiceOrdering.AutoSelect(choices)?.ModelId;

    /// <summary>The prompt style that matches the currently selected image model's family.</summary>
    private SceneImagePromptStyle RenderStyle
    {
        get
        {
            var choice = _modelChoices.FirstOrDefault(model => model.ModelId == _selectedModelId);
            return choice is null
                ? SceneImagePromptStyle.NaturalLanguage
                : SceneImagePromptStyleResolver.FromFamilyDialect(choice.Family, choice.Dialect);
        }
    }

    /// <summary>
    /// B-157: the frame this Composition's brief was compiled with, read from the brief's own snapshot — never
    /// re-derived from the staging profile, so the preview and the render agree and an edit to the profile cannot
    /// re-frame a brief that already exists.
    /// </summary>
    private SceneBlocking? CompositionBlocking => _compiledMediaBrief is null
        ? null
        : SceneBlockingJson.TryRead(_compiledMediaBrief.SemanticInputSnapshotJson);

    private SceneImagePromptStyle PendingPromptStyle
        => _pendingPrompt is null
            ? SceneImagePromptStyle.NaturalLanguage
            : SceneImagePromptStyleResolver.Effective(_pendingPrompt.PromptStyle);

    /// <summary>The tab a recorded failure belongs to, so the notice appears only where the missing draft belongs.</summary>
    private SceneImagePromptStyle FailedPromptStyle
        => _failedPrompt is null
            ? SceneImagePromptStyle.NaturalLanguage
            : SceneImagePromptStyleResolver.Effective(_failedPrompt.PromptStyle);

    /// <summary>
    /// The FAMILY of the composition's selected render model, or Unknown when nothing is chosen. This is the one thing
    /// that decides which scene LoRAs may be offered: a LoRA binds only to the model family it was trained against, and
    /// the render refuses a selection whose family does not match the model it is applied to.
    /// </summary>
    private SceneImageModelFamily SelectedCompositionModelFamily => _modelChoices
        .FirstOrDefault(model => model.ModelId == _selectedModelId)
        ?.Family ?? SceneImageModelFamily.Unknown;

    /// <summary>
    /// True when the selected Composition model is Qwen-Image-2.1. That family carries identity as reference images
    /// and pose as a reference skeleton, so the IP-Adapter 'Identity on create' block and the pose upload are hidden
    /// for it — they describe mechanisms it does not have.
    /// </summary>
    private bool IsQwenImage21Selected => SelectedCompositionModelFamily == SceneImageModelFamily.QwenImage21;

    private bool IsPromptPending => _pendingPrompt?.Status == SceneImagePromptStatus.Pending;

    private bool CanGenerateComposition
    {
        get
        {
            if (_busy || _productionGroup is null || _compiledMediaBrief is null || string.IsNullOrWhiteSpace(_selectedModelId))
                return false;
            if (_applyIdentityOnCreate && !CanApplyIdentityOnCreate)
                return false;
            if (!_completedByStyle.TryGetValue(RenderStyle, out var record)
                || record.Status != SceneImagePromptStatus.Complete)
                return false;
            return !string.IsNullOrWhiteSpace(PromptTextFor(RenderStyle));
        }
    }

    private bool IdentityAvailable =>
        _identityResolution?.IsAvailable == true
        && _identityModelChoices.Count > 0
        && _identityPackOptions.Count > 0;

    private bool CanApplyIdentityOnCreate =>
        IdentityAvailable
        && !string.IsNullOrWhiteSpace(_selectedIdentityPackId)
        && !string.IsNullOrWhiteSpace(_selectedIdentityModelId);

    private IdentityPackOption? SelectedIdentityPack =>
        _identityPackOptions.FirstOrDefault(option => string.Equals(option.PackId, _selectedIdentityPackId, StringComparison.Ordinal));

    private string IdentityBadgeClass() => _identityResolution?.Status switch
    {
        ReferenceStrategyResolutionStatus.Possible => "text-bg-success",
        ReferenceStrategyResolutionStatus.Unqualified => "text-bg-warning",
        ReferenceStrategyResolutionStatus.Impossible => "text-bg-secondary",
        _ => "text-bg-secondary"
    };

    private async Task RefreshIdentityResolutionAsync()
    {
        _identityResolution = null;
        if (string.IsNullOrWhiteSpace(_selectedIdentityModelId))
        {
            await InvokeAsync(StateHasChanged);
            return;
        }
        try
        {
            // The SHARED identity decision, not a hardcoded mechanism: a model that carries identity as its own
            // reference images (Qwen-Image-2.1) is available here too, and the badge explains which mechanism
            // the render will use.
            _identityResolution = await ReferenceStrategies.ResolveIdentityAsync(_selectedIdentityModelId);
        }
        catch (Exception ex)
        {
            _identityResolution = new ReferenceStrategyResolution(
                ReferenceStrategyResolutionStatus.Unqualified,
                ReferenceStrategyResolver.IdentityReferenceConditioning,
                ex.Message);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadIdentityPackOptionsAsync()
    {
        try
        {
            var session = await SessionService.LoadRolePlaySessionAsync(sessionId);
            if (session is null || string.IsNullOrWhiteSpace(session.ScenarioId))
            {
                return;
            }
            var scenario = await ScenarioService.GetScenarioAsync(session.ScenarioId);
            var characters = scenario?.Characters;
            if (characters is null)
            {
                return;
            }
            var options = new List<IdentityPackOption>();
            foreach (var character in characters)
            {
                string templateId;
                IReadOnlyList<CharacterImageIdentityPack> packs;
                try
                {
                    // B-127: packs belong to the character TEMPLATE. Reading them with the scenario character id
                    // returned nothing, so approved packs existed and never appeared in this list. The resolved owner
                    // is kept, because it is also the actor key a reference slot has to address (B-130).
                    var owner = await OwnerResolver.ResolveAsync(character.Id);
                    templateId = owner.TemplateId;
                    packs = await IdentityService.ListPacksAsync(templateId);
                }
                catch
                {
                    continue;
                }
                foreach (var pack in packs.Where(p => p.Status == CharacterImageIdentityPackStatus.Approved))
                {
                    options.Add(new IdentityPackOption
                    {
                        PackId = pack.Id,
                        Label = $"{character.Name ?? character.Id} — v{pack.Version}",
                        CharacterKey = character.Id ?? character.Name ?? string.Empty,
                        TemplateId = templateId,
                        CharacterName = character.Name ?? character.Id ?? string.Empty
                    });
                }
            }
            _identityPackOptions = options;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load identity packs for composition: SessionId={SessionId}", sessionId);
        }
    }

    // ── Selected Moment / per-character reference (base text) helpers ──────────────────────

    private async Task LoadMomentEnrichmentAsync()
    {
        try
        {
            _momentEnrichment = await MomentEnrichmentService.GetAsync(_productionGroup!.MomentEnrichmentId);
            if (_momentEnrichment is not null
                && _momentEnrichment.Status == SceneBeatCatalogueStatus.Complete
                && !string.IsNullOrWhiteSpace(_momentEnrichment.FrozenStateContractJson))
            {
                _frozenState = JsonSerializer.Deserialize<SceneMomentFrozenStateContract>(
                    _momentEnrichment.FrozenStateContractJson, JsonOptions);
            }
        }
        catch (Exception ex)
        {
            _castReferenceError = ex.Message;
            Logger.LogWarning(ex, "Composition Composer could not load the Moment enrichment: MomentEnrichmentId={MomentEnrichmentId}", _productionGroup?.MomentEnrichmentId);
        }
    }

    private async Task LoadScenarioCharactersAsync()
    {
        if (_scenarioCharacters is not null) return;
        try
        {
            var session = await SessionService.LoadRolePlaySessionAsync(sessionId);
            if (session is null || string.IsNullOrWhiteSpace(session.ScenarioId))
            {
                _scenarioCharacters = [];
                return;
            }
            var scenario = await ScenarioService.GetScenarioAsync(session.ScenarioId);
            _scenarioCharacters = scenario?.Characters ?? [];
        }
        catch (Exception ex)
        {
            _scenarioCharacters = [];
            Logger.LogWarning(ex, "Composition Composer could not load scenario characters: SessionId={SessionId}", sessionId);
        }
    }

    private DreamGenClone.Web.Domain.Scenarios.Character? ResolveScenarioCharacter(string? characterId, string? name, string? profileKey)
    {
        if (_scenarioCharacters is null || _scenarioCharacters.Count == 0) return null;
        foreach (var candidate in new[] { characterId, profileKey, name })
        {
            if (string.IsNullOrWhiteSpace(candidate)) continue;
            var byId = _scenarioCharacters.FirstOrDefault(character =>
                string.Equals(character.Id, candidate, StringComparison.OrdinalIgnoreCase));
            if (byId is not null) return byId;
            var byName = _scenarioCharacters.FirstOrDefault(character =>
                string.Equals(character.Name, candidate, StringComparison.OrdinalIgnoreCase));
            if (byName is not null) return byName;
        }
        return null;
    }

    private void BuildPromptRows()
    {
        _promptRows.Clear();
        if (_compiledMediaBrief is null) return;
        JsonObject? root;
        try
        {
            root = JsonNode.Parse(_compiledMediaBrief.SemanticInputSnapshotJson) as JsonObject;
        }
        catch (JsonException ex)
        {
            _castReferenceError = $"The compiled brief semantic snapshot is invalid: {ex.Message}";
            return;
        }
        if (root is null)
        {
            _castReferenceError = "The compiled brief semantic snapshot is not a JSON object.";
            return;
        }
        var frozen = root["frozenState"] as JsonObject;

        // The rows are CONCEPT clusters, not raw payload leaves: one concept ("lighting", "the room") lives in several
        // leaves, and editing the row writes them all. The leaf set each row covers is shown beside it, so the coverage
        // is visible rather than discovered leaf by leaf (the "shaded is in many spots" defect).
        foreach (var cluster in PromptElementClusters.Scene)
        {
            var primary = cluster.EditScopes[0];
            AddClusterRow(cluster, ClusterGroupFor(cluster.Key), null, primary, StringValuePath(root, cluster.ReadPath ?? primary));
        }

        if (frozen?["characters"] is JsonArray characters)
        {
            foreach (var node in characters)
            {
                if (node is not JsonObject character) continue;
                var id = StringValue(character, "characterId");
                var name = StringValue(character, "name");
                var profileKey = StringValue(character, "profileKey");
                var key = FirstNonEmpty(id, name, profileKey);
                if (string.IsNullOrWhiteSpace(key)) continue;
                var label = string.IsNullOrWhiteSpace(name) ? key : name;
                foreach (var cluster in PromptElementClusters.Character)
                {
                    var primary = PromptElementClusters.ScopesFor(cluster, key)[0];
                    var value = cluster.Key == "appearance"
                        ? AppearanceTextFor(id, name, profileKey)
                        : StringValue(character, LeafName(cluster.Key));
                    AddClusterRow(cluster, key, key, primary, value, label);
                }
            }
        }

        _promptGroups = _promptRows
            .GroupBy(row => row.CharacterKey ?? row.Group)
            .Select(group => new PromptGroup
            {
                Key = group.Key,
                CharacterKey = group.First().CharacterKey,
                Rows = group.ToList()
            })
            .ToList();
        _promptRowsInitialized = true;
    }

    /// <summary>The inspector group a scene concept belongs to (Scene vs Moment).</summary>
    private static string ClusterGroupFor(string clusterKey)
        => clusterKey is "eventLine" or "eventAnchor" or "contacts" ? "moment" : "scene";

    /// <summary>The snapshot property a per-character concept names, without the <c>character:</c> prefix.</summary>
    private static string LeafName(string clusterKey) => clusterKey switch
    {
        "physicalLocation" => "physicalLocation",
        "position" => "position",
        "actionOrObservation" => "actionOrObservation",
        "sightline" => "sightline",
        "clothing" => "clothing",
        "atAnchor" => "at.anchor",
        "atPosture" => "at.posture",
        "facing" => "facing.toward",
        _ => throw new InvalidOperationException(
            $"Character prompt concept '{clusterKey}' has no snapshot property. Add one deliberately: a concept " +
            "that reads nothing would show an empty row that writes a property nothing addresses.")
    };

    private void AddClusterRow(
        PromptElementCluster cluster,
        string group,
        string? characterKey,
        string primaryElementKey,
        string value,
        string? characterLabel = null)
    {
        _promptRows.Add(new PromptFieldRow
        {
            ElementKey = primaryElementKey,
            Label = characterKey is null ? cluster.Label : $"{characterLabel} — {cluster.Label}",
            Group = group,
            CharacterKey = characterKey,
            Consumer = cluster.Consumer,
            Scopes = Expand(cluster.EditScopes, characterKey),
            RemoveScopes = Expand(cluster.EffectiveRemoveScopes, characterKey),
            OriginalValue = value ?? string.Empty,
            Value = value ?? string.Empty
        });
    }

    private static IReadOnlyList<string> Expand(IReadOnlyList<string> scopes, string? characterKey)
        => characterKey is null
            ? scopes
            : scopes.Select(scope => scope.Replace("{key}", characterKey, StringComparison.Ordinal)).ToList();

    private static string PromptGroupHeader(PromptGroup group)
        => group.CharacterKey is null
            ? (string.Equals(group.Key, "scene", StringComparison.Ordinal) ? "Scene" : "Moment")
            : $"Character — {group.CharacterKey}";

    private static string StringValue(JsonObject? obj, string path) => StringValuePath(obj, path);

    /// <summary>
    /// Reads a dotted path (<c>frozenState.location</c>, <c>frozenState.event.line</c>,
    /// <c>character:{key}.at.posture</c>) to a scalar, a joined array, or a contacts list rendered one per line as
    /// <c>from|part|to|targetPart|manner</c> — the same format the editor writes back.
    /// </summary>
    private static string StringValuePath(JsonObject? root, string path)
    {
        JsonNode? current = root;
        foreach (var segment in path.Split('.'))
        {
            if (current is not JsonObject obj) return string.Empty;
            var match = obj.FirstOrDefault(pair => string.Equals(pair.Key, segment, StringComparison.OrdinalIgnoreCase));
            if (match.Value is null) return string.Empty;
            current = match.Value;
        }

        return RenderNode(current);
    }

    private static string RenderNode(JsonNode? node) => node switch
    {
        JsonValue value when value.TryGetValue<string>(out var text) => text ?? string.Empty,
        JsonArray array => string.Join(
            Environment.NewLine,
            array.Select(RenderArrayItem).Where(line => line.Length > 0)),
        _ => string.Empty
    };

    private static string RenderArrayItem(JsonNode? item)
    {
        if (item is JsonValue value && value.TryGetValue<string>(out var text)) return text ?? string.Empty;
        if (item is not JsonObject contact) return string.Empty;
        return string.Join(
            '|',
            new[] { "from", "part", "to", "targetPart", "manner" }
                .Select(property => StringValue(contact, property)));
    }

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private string AppearanceTextFor(string id, string name, string profileKey)
    {
        var character = ResolveScenarioCharacter(id, name, profileKey);
        if (character is null) return string.Empty;
        var appearance = PhysicalAttributesFormatter.FormatVisualBlock(character.PhysicalAttributes);
        if (!string.IsNullOrWhiteSpace(appearance)) return appearance;
        return string.IsNullOrWhiteSpace(character.Description) ? string.Empty : character.Description.Trim();
    }

    private void SetPromptRowValue(PromptFieldRow row, string value)
    {
        row.Value = value ?? string.Empty;
        QueuePromptDraftSave();
    }

    private static string ConsumerLabel(PromptElementConsumer consumer) => consumer switch
    {
        PromptElementConsumer.DeterministicFrame => "stated verbatim in the SHOT block",
        PromptElementConsumer.DeterministicAppearance => "written into the appearance block",
        _ => "read by the prompt compiler"
    };

    /// <summary>
    /// Says, in one line, how many payload spots this row writes and (when wider) that its remove tick drops more.
    /// </summary>
    private static string CoverageHint(PromptFieldRow row)
    {
        var parts = new List<string>();
        if (row.Scopes.Count > 1)
        {
            parts.Add($"edits {row.Scopes.Count} spots at once");
        }
        if (row.RemoveScopes.Count != row.Scopes.Count)
        {
            parts.Add($"removing it drops {row.RemoveScopes.Count} spots");
        }
        return parts.Count == 0 ? string.Empty : " · " + string.Join(" · ", parts);
    }

    /// <summary>
    /// The row's own hint line: the consumer label normally, but for the CAMERA HOLDER's rows the role that row plays in
    /// the first-person frame — position sets the camera height, sightline sets the aim, and the body facts are never
    /// sent because the holder is never depicted. This is what makes "what does not apply to this POV" visible.
    /// </summary>
    private string RowHint(PromptFieldRow row, PromptGroup group)
    {
        if (group.CharacterKey is null || !IsCameraHolder(group))
        {
            return ConsumerLabel(row.Consumer);
        }

        var leaf = row.ElementKey[(row.ElementKey.LastIndexOf('.') + 1)..];
        return leaf switch
        {
            "position" => "camera holder — sets the camera height",
            "sightline" => "camera holder — sets the camera aim",
            "physicalLocation" => "camera holder — the camera is at this spot",
            "clothing" or "actionOrObservation" or "appearance" => "camera holder — NOT sent (never depicted)",
            _ => ConsumerLabel(row.Consumer)
        };
    }

    private IReadOnlyList<ReferenceApplicationSelection>? _suppliedScopesSource;
    private HashSet<string> _referenceSuppliedScopes = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The payload leaves the bound reference images already take over, cached per binding set so the inspector does not
    /// re-derive the omission set for every row. The SAME omission owner the render uses, so the panel cannot claim an
    /// element is reference-supplied that the render does not actually remove.
    /// </summary>
    private HashSet<string> ReferenceSuppliedScopes()
    {
        if (!ReferenceEquals(_suppliedScopesSource, _referenceBindings))
        {
            var omitted = ImageStepPromptOmission.ElementKeysFor(CompositionBlueprint, _referenceBindings);
            var set = new HashSet<string>(omitted, StringComparer.OrdinalIgnoreCase);
            // A BODY reference removes face AND build, which together cover the whole appearance row the inspector shows.
            foreach (var key in omitted)
            {
                if (!key.EndsWith(".appearance.face", StringComparison.OrdinalIgnoreCase)) continue;
                var prefix = key[..^".appearance.face".Length];
                if (set.Contains(prefix + ".appearance.build"))
                {
                    set.Add(prefix + ".appearance");
                }
            }
            _referenceSuppliedScopes = set;
            _suppliedScopesSource = _referenceBindings;
        }
        return _referenceSuppliedScopes;
    }

    /// <summary>Whether a bound reference image supplies this row's whole concept, so its remove tick is locked.</summary>
    private bool IsReferenceSupplied(PromptFieldRow row)
        => row.RemoveScopes.Count > 0 && row.RemoveScopes.All(ReferenceSuppliedScopes().Contains);

    /// <summary>
    /// Re-applies the inspector edits saved on this group: the value the operator typed, and the sections/characters
    /// they ticked for removal.
    /// </summary>
    /// <remarks>
    /// The rows are rebuilt from the compiled brief on every load, so without this a reload silently discarded every
    /// edit and the next Generate sent no overrides at all (reported 2026-10-22, "I think I lost the changes"). A key
    /// that no longer exists — the brief was recompiled and the element is gone — is reported rather than dropped in
    /// silence, because a stored edit that stops applying is exactly the kind of thing an operator must hear about.
    /// </remarks>
    private void RestorePromptInspectorOverrides()
    {
        var overrides = SceneImagePromptDraftJson.Read(_productionGroup?.PromptDraftJson, productionGroupId)?.Overrides;
        if (overrides is null || overrides.IsEmpty)
        {
            return;
        }

        // A stored override is a LEAF key, while a row now covers a whole concept (several leaves). Map the leaf back
        // to its row so an edit saved before the cluster change — or written against one leaf — still lands on the
        // right row instead of being reported as stale.
        PromptFieldRow? FindRow(string leafKey) => _promptRows.FirstOrDefault(row =>
            row.Scopes.Any(scope => string.Equals(scope, leafKey, StringComparison.OrdinalIgnoreCase))
            || row.RemoveScopes.Any(scope => string.Equals(scope, leafKey, StringComparison.OrdinalIgnoreCase)));

        var stale = new List<string>();
        _restoringPromptInspector = true;
        try
        {
            foreach (var field in overrides.Fields)
            {
                var row = FindRow(field.ElementKey);
                if (row is null)
                {
                    stale.Add(field.ElementKey);
                    continue;
                }

                if (field.Removed)
                {
                    row.Removed = true;
                }
                else
                {
                    row.Value = field.Value ?? string.Empty;
                }
            }

            foreach (var characterKey in overrides.RemovedCharacters)
            {
                var group = _promptGroups.FirstOrDefault(candidate =>
                    string.Equals(candidate.CharacterKey, characterKey, StringComparison.OrdinalIgnoreCase));
                if (group is null)
                {
                    stale.Add($"character:{characterKey}");
                    continue;
                }

                SetGroupRemoved(group, true);
            }
        }
        finally
        {
            _restoringPromptInspector = false;
        }

        if (stale.Count > 0)
        {
            _castReferenceError =
                "Saved prompt edits that no longer match the compiled brief were not applied: " + string.Join(", ", stale);
        }
    }

    /// <summary>
    /// Whether a group is the character HOLDING the camera for this POV.
    /// </summary>
    /// <remarks>
    /// Ticking "remove character" for the camera holder is a contradiction, not an instruction: the camera needs a
    /// holder, and the prompt then failed with "POV character 'Becky' was removed from this prompt by an override, so
    /// its camera has no holder" (reported 2026-10-22). The control is not offered, so the state cannot be built; the
    /// guard stays in the job handler for a draft that was saved before this. Their rows still matter — their recorded
    /// position sets the camera HEIGHT — so they stay editable.
    /// </remarks>
    private bool IsCameraHolder(PromptGroup group)
        => group.CharacterKey is not null
           && _productionGroup is not null
           && !string.Equals(_productionGroup.Pov.Trim(), SceneImagePovFramer.Omniscient, StringComparison.OrdinalIgnoreCase)
           && (string.Equals(group.CharacterKey, _productionGroup.Pov.Trim(), StringComparison.OrdinalIgnoreCase)
               || group.Rows.Any(row => row.Label.StartsWith(_productionGroup.Pov.Trim() + " —", StringComparison.OrdinalIgnoreCase)));

    /// <summary>
    /// Ticking "remove character" ticks every section belonging to that character, so the two controls can never
    /// disagree about whether the character is in the render.
    /// </summary>
    private void SetGroupRemoved(PromptGroup group, bool removed)
    {
        group.Removed = removed;
        foreach (var row in group.Rows)
        {
            row.Removed = removed;
        }

        QueuePromptDraftSave();
    }

    /// <summary>
    /// A per-section tick. Releasing one section of a character also releases the character-level removal: with the
    /// group still ticked, <see cref="BuildPromptOverrides"/> skips every row of that character, so the untick would
    /// silently do nothing.
    /// </summary>
    private void SetRowRemoved(PromptGroup group, PromptFieldRow row, bool removed)
    {
        row.Removed = removed;
        if (!removed)
        {
            group.Removed = false;
        }

        QueuePromptDraftSave();
    }

    /// <summary>Character keys ticked for removal (derived from the inspector groups).</summary>
    private IReadOnlySet<string> RemovedCharacterKeys => _promptGroups
        .Where(group => group.CharacterKey is not null && group.Removed)
        .Select(group => group.CharacterKey!)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private ScenePromptOverrides? BuildPromptOverrides()
    {
        var removed = RemovedCharacterKeys;
        var overrides = new ScenePromptOverrides();
        foreach (var row in _promptRows)
        {
            if (row.CharacterKey is not null && removed.Contains(row.CharacterKey)) continue;
            if (row.Removed)
            {
                // A remove tick removes the WHOLE concept — every leaf the concept covers, not just the one shown.
                foreach (var scope in row.RemoveScopes)
                    overrides.Fields.Add(new ScenePromptFieldOverride { ElementKey = scope, Removed = true });
                continue;
            }
            if (!string.Equals(row.Value, row.OriginalValue, StringComparison.Ordinal))
            {
                // An edit writes the new value to every leaf the concept covers, so the fix lands in each spot the
                // fact was stated — the "shaded in many places" fix.
                foreach (var scope in row.Scopes)
                    overrides.Fields.Add(new ScenePromptFieldOverride { ElementKey = scope, Value = row.Value });
            }
        }
        overrides.RemovedCharacters.AddRange(removed);
        return overrides.IsEmpty ? null : overrides;
    }

    private string PromptTextFor(SceneImagePromptStyle style)
        => style == SceneImagePromptStyle.PonyV6Tags ? _ponyPromptText : _sdxlPromptText;

    private void SetPromptText(SceneImagePromptStyle style, string value)
    {
        if (style == SceneImagePromptStyle.PonyV6Tags) _ponyPromptText = value;
        else _sdxlPromptText = value;
    }

    /// <summary>
    /// Attaches the pose the step's Pose tab names, by copying that preset's skeleton into this session's pose input.
    ///
    /// The render path is untouched: it still receives a stored skeleton, exactly as an upload does, so there is ONE
    /// conditioning path rather than two. The skeleton is read BY PRESET ID, never from a path on the binding, so a
    /// stale path cannot make the render read a different file than the pose the operator picked.
    ///
    /// Unbinding the slot detaches it again, which is how the composer's own "clear" reaches this page.
    /// </summary>
    private async Task SyncBoundPoseAsync(IReadOnlyList<ReferenceApplicationSelection> bindings)
    {
        var selected = ImageStepPoseBinding.Resolve(bindings);
        if (selected is null)
        {
            if (_posePresetId is not null)
            {
                DetachPose();
            }

            return;
        }

        if (string.Equals(selected.PresetId, _posePresetId, StringComparison.Ordinal))
        {
            return;
        }

        _poseUploadError = string.Empty;
        _poseBusy = true;
        try
        {
            var bytes = await PoseCatalog.ReadSkeletonAsync(selected.PresetId);
            var name = $"pose_{selected.PresetId}_{Guid.NewGuid():N}.png";
            await using var stream = new MemoryStream(bytes);
            _poseStoragePath = await SceneImageStorage.SaveAsync(sessionId, name, stream);
            _poseImageName = $"{selected.PresetId} (pose library)";
            _posePresetId = selected.PresetId;
            _poseStrength = 0.8;
        }
        catch (Exception ex)
        {
            _poseUploadError = $"Failed to attach the library pose: {ex.Message}";
        }
        finally
        {
            _poseBusy = false;
        }
    }

    /// <summary>Releases the attached pose without deciding what replaces it.</summary>
    private void DetachPose()
    {
        _poseStoragePath = null;
        _poseImageName = string.Empty;
        _posePresetId = null;
        _poseStrength = 0.8;
    }

    private async Task OnPoseFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _poseUploadError = string.Empty;
        var file = e.File;
        if (file is null || file.Size == 0)
        {
            _poseUploadError = "The pose file is empty. Choose an OpenPose skeleton PNG.";
            StateHasChanged();
            return;
        }
        if (file.Size > 20L * 1024 * 1024)
        {
            _poseUploadError = "The pose file is larger than 20 MB.";
            StateHasChanged();
            return;
        }

        _poseBusy = true;
        try
        {
            var name = $"pose_{Guid.NewGuid():N}.png";
            await using var stream = file.OpenReadStream(maxAllowedSize: 20L * 1024 * 1024);
            _poseStoragePath = await SceneImageStorage.SaveAsync(sessionId, name, stream);
            _poseImageName = file.Name;
            _poseStrength = 0.8;

            // The upload takes the place of a bound library pose rather than sitting beside it: a render takes one
            // pose, and the step's Pose tab is where the other one lives. Clearing the BINDING (not just this field)
            // is what stops the composer's Pose tab from showing a pose this page has just released.
            _posePresetId = null;
            _referenceBindings = _referenceBindings
                .Where(binding => !string.Equals(binding.Kind, nameof(ImageStepSlotKind.Pose), StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        catch (Exception ex)
        {
            _poseUploadError = $"Failed to store the pose image: {ex.Message}";
        }
        finally
        {
            _poseBusy = false;
            StateHasChanged();
        }
    }

    private void ClearPose()
    {
        DetachPose();

        // The step's Pose slot is released with it, for the same reason an upload releases it: a binding left behind
        // would show a pose in the composer that this page has just removed from the render.
        _referenceBindings = _referenceBindings
            .Where(binding => !string.Equals(binding.Kind, nameof(ImageStepSlotKind.Pose), StringComparison.OrdinalIgnoreCase))
            .ToList();
        StateHasChanged();
    }

    /// <summary>
    /// One Composition attempt as the shared card. The page owns the facts and the card owns the presentation, and the
    /// decisions it shows are the page's own: the group's approval (which attempt is the current production frame), the
    /// attempt's disposition, and its execution status. "Accepted" is deliberately not among them — a disposition says
    /// an attempt was shortlisted or rejected, and it is never read as "approved".
    /// </summary>
    private SceneImageCardModel CardModel(SceneImageRecord attempt)
    {
        var isApproved = _approvedAttemptIds.Contains(attempt.Id);
        return new SceneImageCardModel
        {
            Id = attempt.Id,
            FileRelativePath = attempt.FileRelativePath,
            StatusText = isApproved ? "Approved" : attempt.Status.ToString(),
            StatusBadgeClass = isApproved
                ? "text-bg-success"
                : attempt.Status switch
                {
                    SceneImageStatus.Complete => "text-bg-light",
                    SceneImageStatus.Failed => "text-bg-danger",
                    _ => "text-bg-secondary"
                },
            IsComplete = attempt.Status == SceneImageStatus.Complete,
            ErrorMessage = attempt.ErrorMessage,
            Subtitle = attempt.CreatedUtc.ToLocalTime().ToString("g"),
            DisplayName = attempt.DisplayName,
            ApprovalBadgeText = isApproved ? "Production frame" : null,
            IsProductionApproved = isApproved,
            DecisionBadgeText = attempt.Disposition is SceneImageAttemptDisposition.Shortlisted
                or SceneImageAttemptDisposition.Rejected
                    ? attempt.Disposition.ToString()
                    : null,
            DecisionKey = attempt.Status switch
            {
                SceneImageStatus.Pending or SceneImageStatus.Generating => ImageCardStatus.Pending,
                SceneImageStatus.Failed => ImageCardStatus.Failed,
                _ => attempt.Disposition switch
                {
                    SceneImageAttemptDisposition.Shortlisted => ImageCardStatus.Shortlisted,
                    SceneImageAttemptDisposition.Rejected => ImageCardStatus.Rejected,
                    SceneImageAttemptDisposition.Archived => ImageCardStatus.Archived,
                    _ => isApproved ? ImageCardStatus.Approved : ImageCardStatus.Undecided
                }
            }
        };
    }

    /// <summary>
    /// Names one Composition image. The row is updated in place rather than by reloading the page: a name is not a
    /// reason to re-read the group, the brief and the moment, and a reload would also discard whatever the operator has
    /// typed into the step.
    /// </summary>
    private async Task NameCompositionImageAsync(SceneImageRecord attempt, string? name)
    {
        try
        {
            var named = await ImageService.SetDisplayNameAsync(sessionId, attempt.Id, name);
            var index = _productionImages.FindIndex(item => string.Equals(item.Id, attempt.Id, StringComparison.Ordinal));
            if (index >= 0)
            {
                _productionImages[index] = named;
            }

            index = _compositionAttempts.FindIndex(item => string.Equals(item.Id, attempt.Id, StringComparison.Ordinal));
            if (index >= 0)
            {
                _compositionAttempts[index] = named;
            }

            _statusMessage = string.IsNullOrWhiteSpace(named.DisplayName)
                ? "Cleared this Composition image's name."
                : $"This Composition image is named '{named.DisplayName}'.";
        }
        catch (Exception exception)
        {
            _statusMessage = exception.Message;
        }

        StateHasChanged();
    }

    /// <summary>
    /// What this row is, in the operator's words. A flat production list mixes a Composition with everything derived
    /// from it, and "stage" cannot say which of them a row is: an editor edit records NO stage at all, so the operation
    /// is what identifies it and the stage only refines an edit's name.
    /// </summary>
    private static string KindLabel(SceneImageRecord attempt) => attempt.Operation switch
    {
        SceneImageOperation.Crop => "Crop",
        SceneImageOperation.Enhance => "Enhance",
        SceneImageOperation.Edit => attempt.ProductionStage switch
        {
            SceneImageProductionStage.Preset => "Preset edit",
            SceneImageProductionStage.MultiAngle => "Camera edit",
            SceneImageProductionStage.Finish => "Finish",
            SceneImageProductionStage.Identity => "Identity edit",
            _ => "Edit"
        },
        _ => attempt.ProductionStage switch
        {
            SceneImageProductionStage.Composition => "Composition",
            SceneImageProductionStage.Identity => "Identity",
            SceneImageProductionStage.Finish => "Finish",
            _ => "Generated"
        }
    };

    /// <summary>
    /// The image this one was derived from, named as the operator named it. A flat list is only readable if a derived
    /// row says what it came from, and an unnamed parent falls back to a short id rather than being shown as
    /// parentless — the row HAS a parent, and hiding it would misstate the lineage.
    /// </summary>
    private string? ParentLabel(SceneImageRecord attempt)
    {
        if (string.IsNullOrWhiteSpace(attempt.SourceImageId))
        {
            return null;
        }

        var parent = _productionImages.FirstOrDefault(
            item => string.Equals(item.Id, attempt.SourceImageId, StringComparison.Ordinal));
        if (parent is null)
        {
            return null;
        }

        var label = string.IsNullOrWhiteSpace(parent.DisplayName) ? parent.Id[..8] : parent.DisplayName;
        return $"{KindLabel(parent)} “{label}”";
    }

    /// <summary>
    /// Whether this row can be approved as the production frame. The DOMAIN's gate decides — the same call the approval
    /// itself makes — so the button appears exactly when the write would be accepted, instead of on this page's own idea
    /// of a valid row.
    /// </summary>
    private bool CanApprove(SceneImageRecord attempt)
        => _productionGroup is not null
            && attempt.Status == SceneImageStatus.Complete
            && SceneImageFrameApprovalGate.BlockerFor(_productionGroup, attempt) is null;

    private void ToggleMetadata(string imageId)
    {
        _metadataImageId = string.Equals(_metadataImageId, imageId, StringComparison.Ordinal) ? null : imageId;
        StateHasChanged();
    }

    /// <summary>
    /// Records the tags the rail just wrote on the row this page is showing, in place. Only the tag list changed, so
    /// re-reading the group, the brief and the moment to learn one string would be work for nothing.
    /// </summary>
    private Task OnCompositionTagsChangedAsync(IReadOnlyList<string> tags)
    {
        if (string.IsNullOrWhiteSpace(_metadataImageId))
        {
            return Task.CompletedTask;
        }

        var json = JsonSerializer.Serialize(tags, JsonOptions);
        foreach (var list in new[] { _productionImages, _compositionAttempts })
        {
            var index = list.FindIndex(item => string.Equals(item.Id, _metadataImageId, StringComparison.Ordinal));
            if (index >= 0)
            {
                list[index].TagsJson = json;
            }
        }

        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The card's one shortlist control, which both shortlists and returns an attempt to active: a star that only ever
    /// turned on would leave "I did not mean that" with no way back.
    /// </summary>
    private Task ToggleCompositionShortlistAsync(SceneImageRecord attempt)
        => SetCompositionDispositionAsync(
            attempt,
            attempt.Disposition == SceneImageAttemptDisposition.Shortlisted
                ? SceneImageAttemptDisposition.Active
                : SceneImageAttemptDisposition.Shortlisted);

