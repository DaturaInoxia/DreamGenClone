    private async Task OnPoseFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _poseUploadError = string.Empty;
        var file = e.File;
        if (file is null || file.Size == 0)
        {
            _poseUploadError = "The pose file is empty. Choose an OpenPose skeleton PNG.";
            StateHasChanged();
            return;
        }
        if (file.Size > 20L * 1024 * 1024)
        {
            _poseUploadError = "The pose file is larger than 20 MB.";
            StateHasChanged();
            return;
        }

        _poseBusy = true;
        try
        {
            var name = $"pose_{Guid.NewGuid():N}.png";
            await using var stream = file.OpenReadStream(maxAllowedSize: 20L * 1024 * 1024);
            _poseStoragePath = await SceneImageStorage.SaveAsync(sessionId, name, stream);
            _poseImageName = file.Name;
            _poseStrength = 0.8;
        }
        catch (Exception ex)
        {
            _poseUploadError = $"Failed to store the pose image: {ex.Message}";
        }
        finally
        {
            _poseBusy = false;
            StateHasChanged();
        }
    }

    private void ClearPose()
    {
        _poseStoragePath = null;
        _poseImageName = string.Empty;
        _poseStrength = 0.8;
        StateHasChanged();
    }

    private async Task OnModelChangedAsync()
    {
        // Re-derive the identity-capable model options and re-check the ReferenceConditioning
        // capability whenever the Composition image model changes, so Model Manager edits or model
        // switches are reflected immediately (not only on the identity-model dropdown).
        _identityModelChoices = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: true)).ToList();
        if (!_identityModelChoices.Any(choice => choice.ModelId == _selectedIdentityModelId))
            _selectedIdentityModelId = _identityModelChoices.FirstOrDefault()?.ModelId;
        _applyIdentityOnCreate = false;
        await RefreshIdentityResolutionAsync();
    }

    private async Task SetCompositionDispositionAsync(SceneImageRecord attempt, SceneImageAttemptDisposition next)
    {
        await RunAsync(async () =>
        {
            var expected = attempt.Disposition ?? SceneImageAttemptDisposition.Active;
            await ProductionService.SetDispositionAsync(attempt.Id, _productionGroup!.Id, expected, next);
            _statusMessage = next == SceneImageAttemptDisposition.Shortlisted
                ? "Composition shortlisted."
                : "Composition returned to active.";
            await LoadAsync();
        });
    }

    private async Task ApproveCompositionAttemptAsync(SceneImageRecord attempt)
    {
        await RunAsync(async () =>
        {
            if (_productionGroup?.IdentityPolicy != SceneImageIdentityPolicy.SkippedByUser)
                throw new InvalidOperationException("A Composition can only be approved after identity is skipped for this production group (Production Studio > Identity > Record identity skip).");
            if (string.IsNullOrWhiteSpace(attempt.Sha256))
                throw new InvalidOperationException("Approval requires the Composition checksum; the image may still be processing.");
            await ProductionService.ApproveAsync(_productionGroup!.Id, attempt.Id, attempt.Sha256, "Composition Composer", null);
            _statusMessage = "Composition approved.";
            await LoadAsync();
        });
    }

