    /// <remarks>
    /// Changing the FRAMING is different in kind from changing a placement: the frame is written into the prompt's
    /// PROSE by the pre-processor, so a framing chosen after a draft exists leaves that draft describing the previous
    /// camera. The operator is told to regenerate rather than being left with one prompt asserting two cameras — and
    /// the draft itself is kept, because throwing their text away is worse than a notice.
    /// </remarks>
    private Task OnBlockingOverrideChanged(SceneBlockingOverride? updated)
    {
        var framingChanged = !string.Equals(
            _blockingOverride?.Camera?.ShotSize,
            updated?.Camera?.ShotSize,
            StringComparison.OrdinalIgnoreCase);

        _blockingOverride = updated;
        _framingNotice = framingChanged && HasAnyPromptDraft()
            ? "Framing changed. Press Generate Prompt again so the prose describes this framing — the render will use "
                + "it either way, but the existing draft still names the previous camera."
            : null;
        StateHasChanged();
        return Task.CompletedTask;
    }

