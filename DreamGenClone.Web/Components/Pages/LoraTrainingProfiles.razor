@page "/asset-studio/lora-training-profiles"
@rendermode InteractiveServer

@using System.IO
@using System.Text.Json
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay

@inject ICharacterLoraRepository LoraRepository
@inject IProviderRepository ProviderRepository
@inject ILocalLoraTrainerInventoryService TrainerInventory
@inject ILogger<LoraTrainingProfiles> Logger

<PageTitle>LoRA Training Profiles - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">LoRA Training Profiles</h4>
        <a href="/asset-studio" class="btn btn-outline-secondary btn-sm">Back to Asset Manager</a>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="alert alert-info">@_status</div>
    }

    <div class="row g-3">
        <div class="col-xl-7">
            <section class="card" aria-label="Create LoRA training profile">
                <div class="card-header"><strong>New Versioned Profile</strong></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small" for="lora-provider">Training host</label>
                            <select id="lora-provider" class="form-select form-select-sm" disabled="@_busy" @onchange="OnProviderChangedAsync">
                                <option value="">Select a training host</option>
                                @foreach (var provider in _providers)
                                {
                                    <option value="@provider.Id">@provider.Name — @provider.BaseUrl</option>
                                }
                            </select>
                            <div class="form-text">The GPU host that runs the trainer. Its checkpoints and its stack are read from it, never typed.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small" for="lora-model-family">Model family</label>
                            <select id="lora-model-family" class="form-select form-select-sm" @bind="_targetModelFamily" @bind:after="DeriveNameAsync">
                                <option value="">Select a family</option>
                                @foreach (var family in CharacterLoraModelFamilies.All)
                                {
                                    <option value="@family">@family</option>
                                }
                            </select>
                            <div class="form-text">A dataset may only be trained by a profile qualified for the same family.</div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small" for="lora-base-model">Base model checkpoint</label>
                            <select id="lora-base-model" class="form-select form-select-sm" disabled="@(_busy || !InventoryReady)" value="@_checkpointName" @onchange="OnCheckpointChangedAsync">
                                <option value="">@CheckpointPlaceholder</option>
                                @foreach (var checkpoint in _inventory.Checkpoints)
                                {
                                    <option value="@checkpoint.Name">@checkpoint.Display</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small" for="lora-recipe">Training recipe</label>
                            <select id="lora-recipe" class="form-select form-select-sm" @bind="_presetName">
                                @foreach (var preset in LoraTrainingRecipePresets.All)
                                {
                                    <option value="@preset.Name">@preset.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small" for="lora-profile-name">Profile name</label>
                            <input id="lora-profile-name" class="form-control form-control-sm" @bind="_name" />
                            <div class="form-text">Prefilled from the checkpoint and the family; edit it only to tell two profiles apart.</div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small" for="lora-profile-version">Version</label>
                            <input id="lora-profile-version" class="form-control form-control-sm" value="@NextVersion" readonly />
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_inventory.Error))
                    {
                        <div class="alert alert-warning small mt-3 mb-0">
                            The training host could not be read: @_inventory.Error
                        </div>
                    }
                    else if (SelectedCheckpoint is { } chosen)
                    {
                        <dl class="row small mt-3 mb-0">
                            <dt class="col-sm-4">Base model SHA-256</dt><dd class="col-sm-8 font-monospace text-break">@chosen.Sha256</dd>
                            <dt class="col-sm-4">Trainer</dt><dd class="col-sm-8">@TrainerSummary</dd>
                            <dt class="col-sm-4">Recipe</dt><dd class="col-sm-8">@SelectedPreset.Detail</dd>
                            <dt class="col-sm-4">Rank / alpha</dt><dd class="col-sm-8">@SelectedPreset.Rank / @SelectedPreset.Alpha</dd>
                            <dt class="col-sm-4">Learning rates</dt><dd class="col-sm-8">UNet @SelectedPreset.UnetLearningRate · text encoder @SelectedPreset.TextEncoderLearningRate</dd>
                            <dt class="col-sm-4">Repeats / epochs / steps</dt><dd class="col-sm-8">@SelectedPreset.Repeats / @SelectedPreset.Epochs / @SelectedPreset.Steps</dd>
                            <dt class="col-sm-4">Checkpoint / sample every</dt><dd class="col-sm-8">@SelectedPreset.CheckpointEverySteps / @SelectedPreset.SampleEverySteps steps</dd>
                            <dt class="col-sm-4">Precision / dropout</dt><dd class="col-sm-8">@SelectedPreset.Precision / @SelectedPreset.CaptionDropout</dd>
                        </dl>
                    }

                    <button class="btn btn-primary btn-sm mt-3" type="button" disabled="@(_busy || !CanCreate)" @onclick="CreateProfileAsync">
                        Create Draft Profile
                    </button>
                </div>
            </section>
        </div>

        <div class="col-xl-5">
            <section class="card" aria-label="Persisted LoRA training profiles">
                <div class="card-header"><strong>Persisted Profiles</strong></div>
                <div class="card-body">
                    <label class="form-label small" for="lora-qualification-evidence">Qualification evidence</label>
                    <select id="lora-qualification-evidence" class="form-select form-select-sm" @bind="_qualificationEvidenceKey">
                        @foreach (var kind in LoraTrainingQualificationEvidence.All)
                        {
                            <option value="@kind.Key">@kind.Label</option>
                        }
                    </select>
                    @if (LoraTrainingQualificationEvidence.Find(_qualificationEvidenceKey) is { } evidence)
                    {
                        <div class="form-text mb-3">@evidence.Meaning</div>
                    }
                    @if (_profiles.Count == 0)
                    {
                        <div class="text-muted small">No LoRA training profiles have been created.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr><th>Name</th><th>Base</th><th>Status</th><th class="text-end">Action</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var profile in _profiles)
                                    {
                                        <tr>
                                            <td>@profile.Name <span class="text-muted">v@profile.Version</span></td>
                                            <td><span class="d-block">@profile.TargetModelFamily</span><span class="small text-muted">@profile.BaseModelId @profile.BaseModelVersion</span></td>
                                            <td><span class="badge @(profile.Enabled ? "bg-success" : "bg-secondary")">@profile.Status</span></td>
                                            <td class="text-end">
                                                @if (profile.Status == CharacterLoraTrainingProfileStatus.Draft)
                                                {
                                                    <button class="btn btn-sm btn-outline-success" type="button" title="Qualify profile"
                                                            aria-label="Qualify @profile.Name version @profile.Version"
                                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_qualificationEvidenceKey))"
                                                            @onclick="() => QualifyProfileAsync(profile.Id)">
                                                        <i class="bi bi-check2-circle"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private List<CharacterLoraTrainingProfile> _profiles = [];
    private List<Provider> _providers = [];
    private LoraTrainerInventory _inventory = LoraTrainerInventory.Unreachable(string.Empty, string.Empty);
    private string _providerId = string.Empty;
    private string _checkpointName = string.Empty;
    private string _presetName = LoraTrainingRecipePresets.Default.Name;
    private string _name = string.Empty;
    private string _targetModelFamily = string.Empty;
    private string _qualificationEvidenceKey = LoraTrainingQualificationEvidence.Default.Key;
    private bool _busy;
    private string? _error;
    private string? _status;

    private LoraTrainerCheckpoint? SelectedCheckpoint =>
        _inventory.Checkpoints.FirstOrDefault(
            checkpoint => string.Equals(checkpoint.Name, _checkpointName, StringComparison.Ordinal));

    private LoraTrainingRecipePreset SelectedPreset =>
        LoraTrainingRecipePresets.All.FirstOrDefault(
            preset => string.Equals(preset.Name, _presetName, StringComparison.Ordinal))
        ?? LoraTrainingRecipePresets.Default;

    private bool InventoryReady => _inventory.Reachable && _inventory.Checkpoints.Count > 0;

    private string CheckpointPlaceholder => _inventory.Reachable
        ? "Select a checkpoint"
        : "Pick a training host first";

    /// <summary>
    /// The trainer's identity, taken from the host that will run it. A local sd-scripts checkout has no version of
    /// its own to report, and the torch build is what its behaviour actually depends on, so that is what is pinned:
    /// a profile that says "torch 2.11.0+cu128" is reproducible, one that says "v1" is not.
    /// </summary>
    private string TrainerSummary => _inventory.TrainerStack.Count == 0
        ? "(the host did not report its stack)"
        : string.Join(" · ", _inventory.TrainerStack.Select(entry => $"{entry.Key} {entry.Value}"));

    /// <summary>Next free version for the current name, so creating twice adds a version rather than colliding.</summary>
    private int NextVersion => _profiles
        .Where(profile => string.Equals(profile.Name, _name.Trim(), StringComparison.Ordinal))
        .Select(profile => profile.Version)
        .DefaultIfEmpty(0)
        .Max() + 1;

    /// <summary>
    /// Every value a profile records must come from something real: a picked checkpoint, a picked recipe, a reported
    /// stack. Anything a pick list cannot supply blocks creation with a reason instead of being filled in blind.
    ///
    /// <para>
    /// Deliberately says nothing about <c>_busy</c>. The busy flag is set by the SAME wrapper that runs this check, so
    /// including it made the guard permanently false and every attempt failed with a message about missing picks that
    /// were plainly on screen. Busy-ness belongs on the button, which is where it now lives.
    /// </para>
    /// </summary>
    private bool CanCreate =>
        InventoryReady
        && SelectedCheckpoint is not null
        && CharacterLoraModelFamilies.IsKnown(_targetModelFamily)
        && !string.IsNullOrWhiteSpace(_name)
        && _inventory.TrainerStack.ContainsKey("torch");

    protected override async Task OnInitializedAsync()
    {
        _providers = await ProviderRepository.GetAllAsync();
        await ReloadAsync();
    }

    private async Task OnProviderChangedAsync(ChangeEventArgs args)
    {
        _providerId = args.Value?.ToString() ?? string.Empty;
        _checkpointName = string.Empty;
        _error = null;
        _status = null;
        _inventory = LoraTrainerInventory.Unreachable(string.Empty, string.Empty);

        var provider = _providers.FirstOrDefault(
            candidate => string.Equals(candidate.Id, _providerId, StringComparison.Ordinal));
        if (provider is null)
        {
            return;
        }

        _busy = true;
        try
        {
            _inventory = await TrainerInventory.DescribeAsync(provider.BaseUrl);
            if (!_inventory.Reachable)
            {
                _status = null;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task OnCheckpointChangedAsync(ChangeEventArgs args)
    {
        _checkpointName = args.Value?.ToString() ?? string.Empty;
        return DeriveNameAsync();
    }

    /// <summary>
    /// The name follows the checkpoint and the family, so the usual case needs no keystrokes at all. Editing it by
    /// hand still wins - until the checkpoint changes again, which is the point at which "which model is this"
    /// changed too.
    /// </summary>
    private Task DeriveNameAsync()
    {
        var stem = SelectedCheckpoint is { } checkpoint
            ? Path.GetFileNameWithoutExtension(checkpoint.Name)
            : string.Empty;
        _name = string.IsNullOrWhiteSpace(stem)
            ? string.Empty
            : string.IsNullOrEmpty(_targetModelFamily) ? stem : $"{stem} {_targetModelFamily}";
        return Task.CompletedTask;
    }

    /// <summary>
    /// The trainer a model family is trained by. Krea 2 is the exception and the reason this is derived rather
    /// than typed: it has no kohya network module, so it can only be musubi-tuner, and the only musubi runtime
    /// here is the RunPod Serverless worker.
    /// </summary>
    private static string TrainerIdForFamily(string family) =>
        string.Equals(family, nameof(SceneImageModelFamily.Krea2), StringComparison.Ordinal)
            ? CharacterLoraTrainingAdapters.Krea2ServerlessTrainerId
            : "sd-scripts";

    /// <summary>
    /// The trainer's own version. Krea 2 names the WORKER IMAGE it runs in; every other family names this host's
    /// torch, because that is the interpreter that will actually execute kohya.
    /// </summary>
    private string TrainerVersionForFamily(string family) =>
        string.Equals(family, nameof(SceneImageModelFamily.Krea2), StringComparison.Ordinal)
            ? CharacterLoraTrainingAdapters.Krea2ServerlessTrainerVersion
            : $"torch {_inventory.TrainerStack["torch"]}";

    /// <summary>
    /// What the run needs. A Krea 2 job trains on the worker image and never touches this host's stack, so
    /// recording the host's torch/diffusers versions would describe a machine the run never used.
    /// </summary>
    private string EnvironmentRequirementsForFamily(string family) =>
        string.Equals(family, nameof(SceneImageModelFamily.Krea2), StringComparison.Ordinal)
            ? JsonSerializer.Serialize(new
            {
                trainer = CharacterLoraTrainingAdapters.Krea2ServerlessTrainerId,
                runtime = CharacterLoraTrainingAdapters.Krea2ServerlessTrainerVersion
            })
            : JsonSerializer.Serialize(_inventory.TrainerStack);

    private async Task CreateProfileAsync()
    {
        await RunAsync(async () =>
        {
            if (!CanCreate)
            {
                throw new InvalidOperationException(
                    "A training host, a checkpoint, a family, a recipe and the host's reported trainer stack are all "
                    + "required before a profile can be created.");
            }

            var checkpoint = SelectedCheckpoint!;
            var preset = SelectedPreset;
            await LoraRepository.CreateTrainingProfileAsync(new CharacterLoraTrainingProfile
            {
                Name = _name.Trim(),
                Version = NextVersion,
                Status = CharacterLoraTrainingProfileStatus.Draft,
                Enabled = false,
                TargetModelFamily = _targetModelFamily.Trim(),

                // The checkpoint's FILE NAME is the id: the trainer joins it with its own checkpoints folder, so a
                // name this host can render with is a name it can train with. Its "version" is its family, because
                // the file name and the checksum already pin the exact weights.
                BaseModelId = checkpoint.Name,
                BaseModelVersion = _targetModelFamily.Trim(),
                BaseModelSha256 = checkpoint.Sha256,

                // The FAMILY decides the trainer: Krea 2 is musubi-tuner on RunPod Serverless, every other family is
                // kohya sd-scripts on this host. Deriving it here means the two can never be paired wrongly by hand
                // - a Krea 2 profile pointed at kohya fails at submission, and no family has both trainers.
                TrainerId = TrainerIdForFamily(_targetModelFamily.Trim()),
                TrainerVersion = TrainerVersionForFamily(_targetModelFamily.Trim()),
                RecipeJson = preset.ToRecipeJson(),
                EnvironmentRequirementsJson = EnvironmentRequirementsForFamily(_targetModelFamily.Trim()),
                CheckpointCadenceJson = JsonSerializer.Serialize(new { everySteps = preset.CheckpointEverySteps }),
                SampleCadenceJson = JsonSerializer.Serialize(new { everySteps = preset.SampleEverySteps }),
                CreatedUtc = DateTime.UtcNow
            });
            _status = $"Created LoRA training profile '{_name}' version {NextVersion - 1} for {checkpoint.Name}.";
            await ReloadAsync();
        });
    }

    private async Task QualifyProfileAsync(string profileId)
    {
        await RunAsync(async () =>
        {
            var evidence = LoraTrainingQualificationEvidence.Find(_qualificationEvidenceKey)
                ?? throw new InvalidOperationException(
                    $"'{_qualificationEvidenceKey}' is not a kind of qualification evidence. Pick one from the list.");
            await LoraRepository.QualifyTrainingProfileAsync(profileId, evidence.Json, DateTime.UtcNow);
            _status = $"LoRA training profile qualified and enabled, on evidence: {evidence.Label}.";
            await ReloadAsync();
        });
    }

    private async Task ReloadAsync()
    {
        _profiles = (await LoraRepository.ListTrainingProfilesAsync()).ToList();
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _status = null;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            Logger.LogWarning(exception, "LoRA training profile operation failed.");
        }
        finally
        {
            _busy = false;
        }
    }
}