    /// belongs to the image, so every card can show its own outcome (B-121 note 001).
    /// </summary>
    private static SceneAssetImageValidation? ParseValidation(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            return JsonSerializer.Deserialize<SceneAssetImageValidation>(json, JsonOptions);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>
    /// The front-pipeline steps that produced one image, read from that image's own metadata. The record is
    /// written when the image is approved as the canonical front, so an attempt that has not been approved
    /// yet shows nothing (B-121 note 002).
    /// </summary>
    private static SceneAssetImagePipeline? ParsePipeline(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            return JsonSerializer.Deserialize<SceneAssetImagePipeline>(json, PipelineJsonOptions);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>
    /// One compact line naming what the image went through: <c>de-clothe ✓ · crop — skipped</c>. This is the
    /// image's own record, not a guess from the images around it.
    /// </summary>
    private static string? DescribePipeline(SceneAssetImage image)
    {
        var pipeline = ParsePipeline(image.PipelineStepsJson);
        if (pipeline is null)
        {
            return null;
        }

        return string.Join(
            " · ",
            pipeline.Steps.Select(step =>
                $"{PipelineStepLabel(step.Step)} {PipelineOutcomeMark(step.Outcome)}"));
    }

    private static string PipelineStepLabel(CharacterIdentityBuildStep step) => step switch
    {
        CharacterIdentityBuildStep.GarmentRemoval => "de-clothe",
        CharacterIdentityBuildStep.Crop => "crop",
        CharacterIdentityBuildStep.Enhance => "enhance",
        _ => step.ToString()
    };

    private static string PipelineOutcomeMark(CharacterIdentityBuildStepStatus outcome)
        => outcome == CharacterIdentityBuildStepStatus.Complete ? "✓" : "— skipped";

