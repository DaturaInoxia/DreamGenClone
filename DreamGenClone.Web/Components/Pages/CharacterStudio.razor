    /// <summary>
    /// True for the image approved in Panel B as the canonical front — the value the later steps work
    /// from. It is stored on the build, not on a step, because the Front step is long complete by then.
    /// </summary>
    private bool IsCanonicalFront(SceneAssetImage image)
        => _build?.CanonicalFrontAssetId is { Length: > 0 } canonical
            && string.Equals(canonical, image.Id, StringComparison.Ordinal);

    /// <summary>
    /// Approves an image as this build's canonical front, which also finishes the de-clothe / crop /
    /// enhance part of the pipeline: the service derives those three steps from the approved image's own
    /// lineage. The Front step keeps the generated candidate it recorded — nothing is re-opened.
    /// </summary>
    private async Task ApproveCanonicalFrontAsync(SceneAssetImage image)
    {
        if (_build is null)
        {
            return;
        }

        _frontBusy = true;
        _frontMessage = null;
        try
        {
            _build = await BuildService.SetCanonicalFrontAsync(_build.Id, image.Id);
            await RefreshBuildStepsAsync();
            // The image now carries its own pipeline record, so the list has to be re-read to show it.
            await RefreshEditedImagesAsync();
            // Report what was actually recorded, read from the approved image's own record: with no edit at
            // all the three steps are recorded as skipped, and the message must say that rather than imply
            // work that never happened.
            var approved = await AssetService.GetImageAsync(image.Id) ?? image;
            var recorded = DescribePipeline(approved);
            _frontMessage = recorded is null
                ? $"Canonical front approved: {image.Id[..8]}… — the image carries no pipeline record."
                : $"Canonical front approved: {image.Id[..8]}… — {recorded}. The pipeline is at the face angles.";
        }
        catch (Exception ex)
        {
            _frontMessage = ex.Message;
        }
        finally
        {
            _frontBusy = false;
        }
    }

    /// <summary>
    /// Approves the candidate chosen in Panel A as the canonical front with no de-clothe, crop or enhance
    /// edit at all. The service derives those three steps from the approved image's own lineage, so a front
    /// that never went through them is recorded as skipped and the build moves on to the face angles. This is
    /// the way out of steps 3-5 for a front that needs no edit; the pipeline otherwise had no path to the
    /// angles that did not require an edit.
    /// </summary>
    private async Task ApproveFrontAsIsAsync()
    {
        if (_garmentSource is null)
        {
            return;
        }

        await ApproveCanonicalFrontAsync(_garmentSource);
    }

    private bool _frontStepComplete
