    private string AnglePrompt(CharacterIdentityAngleView view)
        => _anglePrompts.TryGetValue(view, out var prompt) ? prompt : string.Empty;

    private void SetAnglePrompt(CharacterIdentityAngleView view, string? prompt)
        => _anglePrompts[view] = prompt ?? string.Empty;

    private async Task SelectAngleAsync(CharacterIdentityAngleView view)
    {
        if (_build is null)
            return;

        // Change the visible selection before any asynchronous preparation. This prevents the previous
        // angle's workspace from remaining on screen when the newly selected angle is still loading or
        // has a preparation error.
        _selectedAngleView = view;
        _angleSource = null;
        _angleSubject = null;
        _angleReviewDeckUrl = null;
        _anglesMessage = $"Loading {AngleLabel(view)} edit workspace…";
        _anglesBusy = true;
        try
        {
            _angleEditorModelId = await GarmentService.ResolveEditorModelIdAsync();
            // Resolve the selected view's persisted template in the service. Do not pass the previous
            // card's in-memory prompt as an override: left and right have distinct template keys.
            var prepared = await AnglesService.PrepareAsync(_build.Id, view, _angleEditorModelId);
            _anglePrompts[view] = prepared.ResolvedPromptText
                ?? throw new InvalidOperationException($"The resolved prompt for {AngleLabel(view)} was empty.");
            _angleSource = await AssetService.GetImageAsync(prepared.InputArtifactId!)
                ?? throw new InvalidOperationException($"Angle source image '{prepared.InputArtifactId}' was not found.");
            _angleSubject = new ImageEditSubject(
                ImageEditSubjectKind.AssetImage,
                _angleSource.Id,
                _angleSource.AssetId,
                CandidateBatchId: CharacterIdentityAnglesService.CandidateBatchIdFor(_build.Id, view));
            _angleReviewDeckUrl = string.IsNullOrWhiteSpace(_angleSource.CandidateBatchId)
                ? null
                : $"/review-deck/asset/{_angleSource.CandidateBatchId}";
            _angles = (await AnglesService.ListAsync(_build.Id)).ToList();
            _angleAttempts = (await AnglesService.ListAttemptsAsync(_build.Id, view)).ToList();
            _angleAttemptImages = await LoadAngleAttemptImagesAsync(_angleAttempts);
            _anglesMessage = $"{AngleLabel(view)} selected. Prepare the prompt, then run the edit.";
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
        finally
        {
            _anglesBusy = false;
        }
    }

    private async Task UploadAngleAsync(CharacterIdentityAngleView view, InputFileChangeEventArgs args)
    {
        if (_build is null || args.File is null)
            return;
        try
        {
            await using var stream = args.File.OpenReadStream(20 * 1024 * 1024);
            await AnglesService.UploadAsync(_build.Id, view, args.File.Name, stream);
            _selectedAngleView = view;
            await SelectAngleAsync(view);
            _anglesMessage = $"Uploaded {args.File.Name} as a {AngleLabel(view)} attempt. Review it, edit it if needed, then use this angle.";
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

