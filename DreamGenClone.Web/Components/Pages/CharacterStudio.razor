@page "/characters/{CharacterId}"
@rendermode InteractiveServer

@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.Templates
@using DreamGenClone.Components.Assets
@using DreamGenClone.Components.Editing
@using DreamGenClone.Web.Application.RolePlay.Editing

@inject IScenarioService ScenarioService
@inject ICharacterImageIdentityService IdentityService
@inject ICharacterIdentityBuildService BuildService
@inject ICharacterIdentityStepPlanService StepPlanService
@inject ISceneAssetService AssetService
@inject ICharacterIdentityFrontService FrontService
@inject ICharacterIdentityValidationService ValidationService
@inject ICharacterIdentityGarmentService GarmentService
@inject ICharacterIdentityAnglesService AnglesService
@inject ICharacterIdentityPromotionService PromotionService
@inject ICharacterIdentityBodyService BodyService
@inject ICharacterBodyCardPrefillService PrefillService
@inject ICharacterIdentityOwnerResolver OwnerResolver
@inject NavigationManager Navigation
@inject IModelResolutionService ModelResolutionService

<PageTitle>Character Studio - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h4 class="mb-0">@_characterName</h4>
            <span class="small text-muted">Character Studio</span>
        </div>
        <a href="/asset-studio" class="btn btn-outline-secondary btn-sm">Back to Asset Manager</a>
    </div>

    @if (_scenarioName is not null)
    {
        <p class="text-muted small mb-1">@_scenarioName · @_packs.Count identity pack@(_packs.Count == 1 ? "" : "s")</p>
    }

    @* The identity owner, said plainly: identity belongs to the character template, and this page may have been
       reached through a scenario instance or an asset (B-127). *@
    @if (_owner is not null)
    {
        <p class="text-muted small mb-3">
            Identity owner: <strong>@_owner.TemplateName</strong> <code>@_owner.TemplateId</code>
            @if (_owner.IsInstance)
            {
                <span>· opened from the @_owner.DescribeKind() <strong>@_owner.InstanceName</strong> <code>@_owner.InstanceId</code></span>
            }
        </p>
    }

    @* An unresolvable character must say so on EVERY tab: identity is keyed by the character template, so nothing
       on this page can work, and a message buried in one section is a dead end (B-127). *@
    @if (!string.IsNullOrWhiteSpace(_ownerMessage))
    {
        <div class="alert alert-danger">@_ownerMessage</div>
    }

    <ul class="nav nav-pills mb-3">
        @foreach (var tab in _sections)
        {
            <li class="nav-item">
                <button type="button" class="nav-link @(tab == _activeSection ? "active" : "")" @onclick="() => _activeSection = tab">@tab</button>
            </li>
        }
    </ul>

    @switch (_activeSection)
    {
        case "Faces":
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Face build</strong>
                    <span class="d-flex align-items-center gap-2">
                        @if (_build is not null)
                        {
                            <a class="btn btn-sm btn-outline-info" href="/review-deck/asset/@CharacterIdentityFrontService.FrontBatchIdFor(_build.Id)" title="Every image this build created or edited"><i class="bi bi-images me-1"></i>Review deck</a>
                            <a class="btn btn-sm btn-outline-primary" href="/review-compare/asset/@CharacterIdentityFrontService.FrontBatchIdFor(_build.Id)" title="Compare this build's images side by side"><i class="bi bi-layout-split me-1"></i>Compare</a>
                        }
                        <button type="button" class="btn btn-sm btn-primary" @onclick="StartBuildAsync" disabled="@_startingBuild">
                            @(_build is null ? "Start build" : "Start over")
                        </button>
                    </span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(_facesError))
                    {
                        <div class="alert alert-danger py-2">@_facesError</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_frontMessage))
                    {
                        <div class="alert alert-secondary py-1 small mb-2">@_frontMessage</div>
                    }

                    @if (_build is null)
                    {
                        <div class="text-muted small">No face build yet. Start one to run the pipeline: Front → Validate → Garment removal → Crop → Enhance → Angles → Promote.</div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">Build @_build.Id.Substring(0, 8)… · @_build.Status</div>
                        @* One line of pipeline state, in the build's own step order (the plan for its target kind).
                           The panels below hold the controls, so the step status is
                           not repeated as a second list (B-121 note 007). *@
                        @if (_stepPlan is { } plan)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-1 mb-3">
                                @foreach (var definition in plan.Ordered)
                                {
                                    var row = _buildStepRows.FirstOrDefault(r => r.Step == definition.Step);
                                    var status = row?.Status ?? CharacterIdentityBuildStepStatus.NotStarted;
                                    <span class="badge @StepBadge(status) @(definition.Step == _build.CurrentStep ? "border border-light" : "")" title="@definition.Step: @status">@StepLabel(definition.Step) · @status</span>
                                }
                            </div>
                        }
                    }

                    @if (_build is not null)
                    {
                        <div class="card mt-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" @onclick="() => _panelAOpen = !_panelAOpen" aria-expanded="@_panelAOpen" aria-controls="panel-a-body">
                                    <i class="bi @(_panelAOpen ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>Panel A · 1 Front · 2 Validate
                                </button>
                                <span class="d-flex align-items-center gap-1">
                                    <span class="small text-muted me-1">seed: identity.front.generate</span>
                                    @if (_frontStepComplete)
                                    {
                                        <span class="badge text-bg-success">front selected</span>
                                    }
                                    <a class="btn btn-sm btn-outline-info" href="/review-deck/asset/@CharacterIdentityFrontService.FrontBatchIdFor(_build.Id)" title="Review this build's front attempts"><i class="bi bi-images me-1"></i>Review deck</a>
                                    <a class="btn btn-sm btn-outline-primary" href="/review-compare/asset/@CharacterIdentityFrontService.FrontBatchIdFor(_build.Id)" title="Compare front attempts side by side"><i class="bi bi-layout-split me-1"></i>Compare</a>
                                </span>
                            </div>

                            @if (_panelAOpen)
                            {
                                <div class="card-body" id="panel-a-body">
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small mb-0">Prompt (editable — saved for this character; each Generate creates a new attempt)</label>
                                    <span class="d-flex align-items-center gap-1">
                                        <span class="badge @(_frontPromptIsCharacterOverride ? "text-bg-info" : "text-bg-secondary")">
                                            @(_frontPromptIsCharacterOverride ? "character prompt" : "default prompt")
                                        </span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReloadDefaultFrontPromptAsync" disabled="@_frontBusy" title="Load this character's default prompt">Reload default</button>
                                    </span>
                                </div>
                                <textarea class="form-control font-monospace small" rows="6" value="@_frontPrompt" @oninput="OnFrontPromptInput" @onchange="OnFrontPromptCommitted"></textarea>
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-md-5">
                                    <label class="form-label small mb-1">Model</label>
                                    <select class="form-select form-select-sm" @bind="_frontModelId" @bind:after="PersistFrontModelAsync">
                                        <option value="">Select model…</option>
                                        @foreach (var m in _frontModels)
                                        {
                                            <option value="@m.ModelId">@m.DisplayName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-1">Size</label>
                                    <input class="form-control form-control-sm" @bind="_frontImageSize" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end gap-1">
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="GenerateFrontAsync" disabled="@_frontBusy">Generate</button>
                                    <InputFile class="form-control form-control-sm" accept="image/png,image/jpeg,image/webp" OnChange="OnFrontUpload" />
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshFrontAttemptsAsync">Refresh</button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_frontMessage))
                            {
                                <div class="small text-muted mb-2">@_frontMessage</div>
                            }

                            @if (_validateStepRecord is { ManualOverrideApplied: true } overrideRow)
                            {
                                <div class="alert alert-warning py-1 small mb-2">Manual visual override recorded by @overrideRow.ManualOverrideAuthor: @overrideRow.ManualOverrideReason</div>
                            }

                            @if (_recordedFrontArtifactMissing)
                            {
                                <div class="alert alert-warning py-1 small mb-2">
                                    The front this build recorded (@_recordedFrontArtifactLabel) is no longer in this pack — its image was deleted.
                                    Choose a candidate again with "Use this"; the build then records that one as its front.
                                </div>
                            }

                            @{ var promptImages = _frontAttempts.Where(a => a.Kind != SceneAssetKind.Edited).ToList(); }
                            @if (promptImages.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var attempt in promptImages)
                                    {
                                        <div class="border rounded p-1 text-center @(IsChosenFront(attempt) ? "border-success border-2" : "")" style="width:150px;">
                                            <button type="button" class="btn w-100 p-0 border-0 bg-transparent" @onclick="() => OpenAttemptViewer(attempt)" title="View larger">
                                                @if (attempt.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(attempt.FileRelativePath))
                                                {
                                                    <img src="/scene-images/@attempt.FileRelativePath" style="height:150px; width:100%; object-fit:contain;" alt="front attempt" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center text-muted small" style="height:150px;">@attempt.Status</div>
                                                }
                                            </button>
                                            <div class="d-flex justify-content-between align-items-center small mt-1 px-1">
                                                <span class="font-monospace text-truncate">@attempt.Id[..8]…</span>
                                                <span class="badge @FrontDecisionBadge(attempt.CandidateDecision)">@(attempt.CandidateDecision?.ToString() ?? "—")</span>
                                            </div>
                                            @if (IsChosenFront(attempt))
                                            {
                                                <div class="small text-success fw-semibold">chosen · input to Panel B</div>
                                            }
                                            @{ var validation = ParseValidation(attempt.ValidationResultJson); }
                                            @if (validation is not null)
                                            {
                                                <div class="small @ValidationTextClass(validation.Verdict)">
                                                    @validation.Verdict@(validation.IrisDyPercent is { } irisDy ? $" · irisDy {irisDy:F2}%" : "")@(validation.BlockReason is null ? "" : $" · {validation.BlockReason}")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="small text-muted">not validated</div>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-1" @onclick="() => RevalidateAsync(attempt)" disabled="@(_validationBusy || attempt.Status != SceneAssetStatus.Complete)">@(validation is null ? "Run validation" : "Re-validate")</button>
                                            @* ui-contract.md §3: the override control is always visible — it belongs to every
                                               candidate the gate blocks, not only the one recorded on the build. Gating it on
                                               "this is the chosen front" left a deleted recorded front with no override at all
                                               (B-121 note 008). *@
                                            @if (validation is not null
                                                && (validation.Verdict == CharacterIdentityValidationVerdict.Fail
                                                    || validation.Verdict == CharacterIdentityValidationVerdict.NoFaceMesh))
                                            {
                                                <div class="border border-warning rounded p-2 mt-2" @onclick:stopPropagation="true">
                                                    <div class="small text-warning">
                                                        @(validation.Verdict == CharacterIdentityValidationVerdict.NoFaceMesh
                                                            ? "No face mesh was measured on this image. Record a manual visual override to continue."
                                                            : "Validation failed. Record a manual visual override to continue.")
                                                    </div>
                                                    <input class="form-control form-control-sm mt-1" placeholder="Override reason" @bind="_frontOverrideReason" />
                                                    <input class="form-control form-control-sm mt-1" placeholder="Author" @bind="_frontOverrideAuthor" />
                                                    <button type="button" class="btn btn-sm btn-warning mt-1" @onclick="RecordFrontOverrideAsync">Record front override</button>
                                                </div>
                                            }
                                            <div class="d-flex flex-wrap gap-1 mt-1 justify-content-center">
                                                <button type="button" class="btn btn-sm btn-outline-success py-0 px-1" title="Accept" @onclick="() => SetFrontDecisionAsync(attempt, SceneAssetCandidateDecision.Accepted)"><i class="bi bi-check2-circle"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-info py-0 px-1" title="Shortlist" @onclick="() => SetFrontDecisionAsync(attempt, SceneAssetCandidateDecision.Shortlisted)"><i class="bi bi-star"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="Reject" @onclick="() => SetFrontDecisionAsync(attempt, SceneAssetCandidateDecision.Rejected)"><i class="bi bi-x-circle"></i></button>
                                            </div>
                                            <button type="button" class="btn btn-sm @(IsChosenFront(attempt) ? "btn-success" : "btn-outline-success") w-100 mt-1" @onclick="() => SelectFrontAsync(attempt.Id)" disabled="@(attempt.Status != SceneAssetStatus.Complete)" title="@(IsChosenFront(attempt) && _build?.CurrentStep == CharacterIdentityBuildStep.Validate ? "Continue past validation with this front" : "Make this candidate the input to Panel B")">@(IsChosenFront(attempt) && _build?.CurrentStep == CharacterIdentityBuildStep.Validate ? "Continue" : IsChosenFront(attempt) ? "Chosen" : "Use this")</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-1" @onclick="() => DeleteImageAsync(attempt)" disabled="@(_frontBusy || IsChosenFront(attempt))" title="@(IsChosenFront(attempt) ? "The build's recorded front cannot be deleted. Choose another candidate with Use this first." : "Delete this image")"><i class="bi bi-trash me-1"></i>Delete</button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small">No front attempts yet. Generate or upload one.</div>
                            }                                </div>
                            }
                        </div>
                    }

                    @if (_build is not null && (int)_build.CurrentStep >= (int)CharacterIdentityBuildStep.GarmentRemoval)
                    {
                        <div class="card mt-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" @onclick="() => _panelBOpen = !_panelBOpen" aria-expanded="@_panelBOpen" aria-controls="panel-b-body">
                                    <i class="bi @(_panelBOpen ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>Panel B · 3 De-clothe · 4 Crop · 5 Enhance
                                </button>
                                <span class="badge @StepBadge(_garmentStepStatus)">@_garmentStepStatus</span>
                            </div>
                            @if (_panelBOpen)
                            {
                                <div class="card-body" id="panel-b-body">

                            @* The input is the candidate chosen in panel A. De-clothing, cropping and enhancing all
                               produce new images, so several attempts may be made at each step; the edit form's
                               lineage is the list of those attempts. *@
                            <div class="d-flex align-items-center gap-2 mb-2">
                                @if (!string.IsNullOrWhiteSpace(_selectedFrontPreviewUrl))
                                {
                                    <img src="@_selectedFrontPreviewUrl" class="border rounded" style="height:72px;width:72px;object-fit:cover;" alt="Input: the chosen candidate" />
                                    <span class="small text-muted">Input: the candidate you chose in Panel A. Each edit adds an attempt to the list below — switch between them with the lineage.</span>
                                }
                                else
                                {
                                    <span class="small text-warning">Choose a candidate with "Use this" in Panel A first.</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_garmentMessage))
                            {
                                <div class="alert alert-secondary py-1 small mb-2">@_garmentMessage</div>
                            }

                            @* Steps 3, 4 and 5 are steps, not requirements: a front that needs no de-clothe, crop or
                               enhance (an upload, or an already-clean render) has to be able to reach the face angles.
                               Approving the candidate chosen in Panel A as-is records all three as skipped — the design's
                               own recorded state for "this image never went through it" — and moves the build to Angles
                               (B-121 note 008). Offered only until a canonical front is approved: swapping the canonical
                               front afterwards would rewrite the recorded lineage of steps 3/4/5. *@
                            @if (_garmentSource is not null && string.IsNullOrWhiteSpace(_build?.CanonicalFrontAssetId))
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="ApproveFrontAsIsAsync" disabled="@_frontBusy">Use the front as-is — skip 3 · 4 · 5</button>
                                    <span class="small text-muted">No edit needed: de-clothe, crop and enhance are recorded as skipped and the build moves on to the face angles.</span>
                                </div>
                            }

                            @* The edited images are their own list: this is where the user picks the picture that
                               becomes the canonical front the later steps work from (B-121 note 007). *@
                            @if (_editedImages.Count > 0)
                            {
                                <div class="mb-3">
                                    <div class="small fw-semibold mb-1">Edited images — pick the canonical front</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var edited in _editedImages)
                                        {
                                            <div class="border rounded p-1 text-center @(IsChosenFront(edited) ? "border-success border-2" : "")" style="width:150px;">
                                                <button type="button" class="btn w-100 p-0 border-0 bg-transparent" @onclick="() => OpenAttemptViewer(edited)" title="View larger">
                                                    @if (edited.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(edited.FileRelativePath))
                                                    {
                                                        <img src="/scene-images/@edited.FileRelativePath" style="height:150px; width:100%; object-fit:contain;" alt="edited image" />
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center text-muted small" style="height:150px;">@edited.Status</div>
                                                    }
                                                </button>
                                                <div class="d-flex justify-content-between align-items-center small mt-1 px-1">
                                                    <span class="font-monospace text-truncate">@edited.Id[..8]…</span>
                                                    <span class="badge @FrontDecisionBadge(edited.CandidateDecision)">@(edited.CandidateDecision?.ToString() ?? "—")</span>
                                                </div>
                                                @{ var editedValidation = ParseValidation(edited.ValidationResultJson); }
                                                @if (editedValidation is not null)
                                                {
                                                    <div class="small @ValidationTextClass(editedValidation.Verdict)">@editedValidation.Verdict@(editedValidation.IrisDyPercent is { } editedIrisDy ? $" · irisDy {editedIrisDy:F2}%" : "")</div>
                                                }
                                                else
                                                {
                                                    <div class="small text-muted">not validated</div>
                                                }
                                                @{ var editedPipeline = DescribePipeline(edited); }
                                                @if (editedPipeline is not null)
                                                {
                                                    <div class="small text-muted" title="What this image went through, from its own record">@editedPipeline</div>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-1" @onclick="() => RevalidateAsync(edited)" disabled="@(_validationBusy || edited.Status != SceneAssetStatus.Complete)">@(editedValidation is null ? "Run validation" : "Re-validate")</button>
                                                <button type="button" class="btn btn-sm @(IsCanonicalFront(edited) ? "btn-success" : "btn-outline-success") w-100 mt-1" @onclick="() => ApproveCanonicalFrontAsync(edited)" disabled="@(_frontBusy || edited.Status != SceneAssetStatus.Complete)" title="Make this the canonical front for the next steps">@(IsCanonicalFront(edited) ? "Canonical front" : "Use this")</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-1" @onclick="() => DeleteImageAsync(edited)" disabled="@(_frontBusy || IsCanonicalFront(edited))" title="@(IsCanonicalFront(edited) ? "The canonical front cannot be deleted" : "Delete this image")"><i class="bi bi-trash me-1"></i>Delete</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (_garmentSource is not null)
                            {
                                <ImageEditWorkspace Subject="_garmentSubject!"
                                                    ShowIdentity="false"
                                                    SeedIntent="@_garmentIntent"
                                                    DefaultEditorModelId="@_garmentEditorModelId"
                                                    ReviewDeckUrl="@_garmentReviewDeckUrl"
                                                    EditImageUrlFactory="@GarmentEditImageUrl"
                                                    ResultChanged="@OnGarmentResultAsync" />
                            }
                            else
                            {
                                <div class="text-muted small">The front image for this step is unavailable.</div>
                            }

                            @* De-clothe, crop and enhance are recorded from the approved image's own lineage when
                               it is approved above: the pipeline status line shows the result, so there is
                               nothing to skip or complete here (B-121 notes 002/005). *@
                                </div>
                            }
                        </div>
                    }

                    @if (_build is not null && (int)_build.CurrentStep >= (int)CharacterIdentityBuildStep.Angles)
                    {
                        <div class="card mt-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <strong>Panel C · Face angles</strong>
                                <span class="small text-muted">Build the four required identity views</span>
                            </div>
                            <div class="card-body">
                                <p class="small text-muted">Each view is a separate edit of the approved canonical front or the previously accepted view on that side. Edit the prebuilt prompt before running if needed.</p>
                                @if (!string.IsNullOrWhiteSpace(_anglesMessage))
                                {
                                    <div class="alert alert-secondary py-1 small">@_anglesMessage</div>
                                }
                                @if (_selectedAngleView is null)
                                {
                                    <div class="alert alert-info py-2 small">Select an angle card below to open its dedicated Edit Image workspace.</div>
                                }
                                <div class="row g-3">
                                    @foreach (var view in AngleViews)
                                    {
                                        var angle = _angles.FirstOrDefault(item => item.View == view);
                                        var source = angle?.InputArtifactId;
                                        <div class="col-md-6">
                                            <div class="border rounded p-2 h-100 @(view == _selectedAngleView ? "border-primary border-2" : "")" role="button" tabindex="0" @onclick="() => SelectAngleAsync(view)" @onkeydown="eventArgs => OnAngleCardKeyDown(eventArgs, view)">
                                                <h6>@AngleLabel(view)</h6>
                                                <div class="small text-muted mb-2">Source: @AngleSourceLabel(view, source)</div>
                                                <a class="small" href="@AngleReviewDeckUrl(view)" target="_blank" @onclick:stopPropagation="true">Review @AngleLabel(view) attempts</a>
                                                @if (angle?.OutputArtifactId is { Length: > 0 } output)
                                                {
                                                    var outputImage = _angleImages.FirstOrDefault(image => image.Id == output);
                                                    if (outputImage?.FileRelativePath is { Length: > 0 } path)
                                                    {
                                                        <img src="/scene-images/@path" class="img-fluid rounded mb-2" style="max-height:260px;object-fit:contain;" alt="@AngleLabel(view) angle" />
                                                    }
                                                }
                                                <div class="small mb-2">Status: @(angle?.Status.ToString() ?? "NotStarted")</div>
                                                <div class="small text-muted mb-2">Attempts on this card: @AngleAttemptCount(view)</div>
                                                @if (!string.IsNullOrWhiteSpace(angle?.FailureReason))
                                                {
                                                    <div class="small text-danger mb-2">@angle.FailureReason</div>
                                                }
                                                @if (view == _selectedAngleView && _angleAttempts.Count > 0)
                                                {
                                                    <div class="mt-2 border-top pt-2">
                                                        <div class="small fw-semibold">@AngleLabel(view) attempts (@_angleAttempts.Count)</div>
                                                        @foreach (var attempt in _angleAttempts)
                                                        {
                                                            var attemptImage = _angleAttemptImages.FirstOrDefault(image => image.Id == attempt.OutputArtifactId);
                                                            <div class="border rounded p-1 mt-2">
                                                                @if (attemptImage?.FileRelativePath is { Length: > 0 } attemptPath)
                                                                {
                                                                    <button type="button" class="btn p-0 border-0 bg-transparent w-100" @onclick:stopPropagation="true" @onclick="() => OpenAttemptViewer(attemptImage)" title="View attempt @attempt.AttemptNumber">
                                                                        <img src="/scene-images/@attemptPath" class="img-fluid rounded" style="max-height:220px;object-fit:contain;" alt="@AngleLabel(view) attempt @attempt.AttemptNumber" />
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <div class="small text-muted text-center py-3">No completed image yet</div>
                                                                }
                                                                <div class="d-flex justify-content-between align-items-center small mt-1">
                                                                    <span>Attempt @attempt.AttemptNumber · @attempt.Status</span>
                                                                @if (attempt.Status != CharacterIdentityAngleStatus.Accepted)
                                                                {
                                                                    <button type="button" class="btn btn-sm btn-outline-success py-0" @onclick:stopPropagation="true" @onclick="() => AcceptAngleAttemptAsync(view, attempt.Id)" disabled="@(attemptImage?.Status != SceneAssetStatus.Complete)">Use this</button>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 ms-1" @onclick:stopPropagation="true" @onclick="() => DeleteAngleAttemptAsync(view, attempt.Id)">Delete</button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-success">Selected</span>
                                                                }
                                                                </div>
                                                                @if (attempt.Status == CharacterIdentityAngleStatus.Failed)
                                                                {
                                                                    <div class="mt-2">
                                                                        <input class="form-control form-control-sm" placeholder="Override reason" value="@OverrideReason(attempt.Id)" @oninput="args => SetOverrideReason(attempt.Id, args.Value?.ToString() ?? string.Empty)" @onclick:stopPropagation="true" />
                                                                        <input class="form-control form-control-sm mt-1" placeholder="Author" value="@OverrideAuthor(attempt.Id)" @oninput="args => SetOverrideAuthor(attempt.Id, args.Value?.ToString() ?? string.Empty)" @onclick:stopPropagation="true" />
                                                                        <button type="button" class="btn btn-sm btn-warning mt-1" @onclick:stopPropagation="true" @onclick="() => RecordAngleOverrideAsync(view, attempt.Id)">Record visual override</button>
                                                                    </div>
                                                                }
                                                                @if (attempt.ManualOverrideApplied)
                                                                {
                                                                    <div class="small text-warning mt-1">Override recorded by @attempt.ManualOverrideAuthor</div>
                                                                }
                                                                @if (attempt.MirrorDerived)
                                                                {
                                                                    <div class="small text-info mt-1">Mirror-derived — the configured remedy mirrored the wrong-facing render into this view's side.</div>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(attempt.FailureReason))
                                                                {
                                                                    <div class="small text-danger mt-1">@attempt.FailureReason</div>
                                                                }
                                                                @if (DescribeDirection(attempt) is { Length: > 0 } directionNote)
                                                                {
                                                                    <div class="small text-muted mt-1">@directionNote</div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                <div class="small text-muted mt-2">Select this card to edit this angle with the prepared prompt.</div>
                                                <InputFile class="form-control form-control-sm mt-2" accept="image/png,image/jpeg,image/webp" OnChange="@(args => UploadAngleAsync(view, args))" @onclick:stopPropagation="true" />
                                                <div class="d-flex gap-2 mt-2">
                                                    @if (angle?.Status == CharacterIdentityAngleStatus.Pending)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-success" @onclick:stopPropagation="true" @onclick="() => AcceptAngleAsync(view)">Use this angle</button>
                                                    }
                                                </div>
                                                @if (angle?.ManualConfirmationRequired == true && angle.Status != CharacterIdentityAngleStatus.Accepted)
                                                {
                                                    <div class="form-check mt-2">
                                                        <input class="form-check-input" type="checkbox" checked="@ProfileConfirmed(view)" @onchange="args => SetProfileConfirmed(view, args.Value is bool confirmed && confirmed)" id="confirm-@view" />
                                                        <label class="form-check-label small" for="confirm-@view">I confirm this profile faces the expected image direction.</label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (_selectedAngleView is { } selectedView && _angleSubject is not null)
                                {
                                    <div class="mt-4 border-top pt-3">
                                        <h5>@AngleLabel(selectedView) · Edit image</h5>
                                        <p class="small text-muted">Prepare the prebuilt angle prompt, edit it if needed, then run the image edit. This workspace is independent from Panel B.</p>
                                        <ImageEditWorkspace @key="@(selectedView + ":" + _angleSubject.ImageId)"
                                                             Subject="_angleSubject"
                                                             ShowIdentity="false"
                                                             SeedIntent="@AnglePrompt(selectedView)"
                                                             DefaultEditorModelId="@_angleEditorModelId"
                                                             ReviewDeckUrl="@_angleReviewDeckUrl"
                                                             EditImageUrlFactory="@AngleEditImageUrl"
                                                             ResultChanged="@(result => OnAngleResultAsync(selectedView, result))" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_build is not null && (int)_build.CurrentStep >= (int)CharacterIdentityBuildStep.Promote)
                    {
                        <div class="card mt-3">
                            <div class="card-header"><strong>Panel D · Promote identity pack</strong></div>
                            <div class="card-body">
                                @if (_promotion is not null)
                                {
                                    <div class="row g-2 mb-3">
                                        @foreach (var view in _promotion.Views)
                                        {
                                            <div class="col-md-2"><div class="border rounded p-2 small"><strong>@view.Label</strong><br /><span class="@(view.Ready ? "text-success" : "text-danger")">@(view.Ready ? "Ready" : "Blocked")</span></div></div>
                                        }
                                    </div>
                                    @if (_promotion.BlockingReasons.Count > 0)
                                    {
                                        <div class="alert alert-warning small">@string.Join(" ", _promotion.BlockingReasons)</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_promotionMessage))
                                    {
                                        <div class="alert alert-info small">@_promotionMessage</div>
                                    }
                                    <button type="button" class="btn btn-primary" @onclick="PromoteIdentityAsync" disabled="@(!_promotion.Ready || _promotionBusy)">Promote view set to identity pack</button>
                                    @if (!string.IsNullOrWhiteSpace(_promotion.PackId))
                                    {
                                        <a class="btn btn-outline-success ms-2" href="/characters/@CharacterId#packs">Open identity packs</a>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            break;
        case "Body":
            <div>
                @if (!string.IsNullOrWhiteSpace(_bodyMessage))
                {
                    <div class="alert alert-info small py-1">@_bodyMessage</div>
                }

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Body card</strong>
                        <span class="small @(_bodyCard.IsReady && _bodyCardVersion > 0 ? "text-success" : "text-warning")">@BodyCardStatus</span>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted">
                            The single source of every body prompt: this line is pasted verbatim into each body reference
                            prompt, and generation refuses while a field is unanswered. A field marked <strong>[DECIDE]</strong>
                            needs an exact value or an explicit "none" — a vague body does not train.
                        </p>
                        @* The SAME vocabulary the character template uses, here on the card, because the template is
                           only the start point and the tweaks live on the card.

                           A SELECT, not a datalist. The pickers were datalists, and a datalist is filtered by whatever
                           is already in the box — so a field that had a value showed an EMPTY popup, which reads as
                           "there are no options" and is exactly what was reported. A select always shows the whole
                           catalog, and "(custom…)" opens a text box for wording the catalog does not carry, so a
                           catalog pick and a typed override are two visible choices rather than one ambiguous box. *@
                        <div class="border rounded p-2 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-semibold">Body parts</span>
                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        @onclick="ComposeBodyAxesAsync" disabled="@_bodyCard.Axes.IsEmpty">
                                    Compose into body shape
                                </button>
                            </div>
                            @if (BodyShapeLineIsStale)
                            {
                                @* These picks are what GENERATE — only they carry a per-family rendering, so the line
                                   below is a record, not the source. Say so here rather than at generation time, where
                                   the mismatch was invisible and looked like a broken button. *@
                                <div class="alert alert-warning py-1 px-2 small mb-2">
                                    The body shape line no longer matches these picks. The <strong>picks</strong> are what
                                    generate; press <strong>Compose into body shape</strong> to rewrite the line from them.
                                </div>
                            }
                            @* WHICH value set these pickers show, and why. The gender gate recognises "Male" exactly, so a
                               character whose gender is unset or "Any" silently gets the female-typical set — the operator's
                               "all the dropdowns are for a typical female body" (2026-09-23). *@
                            <div class="small text-muted mb-2">@BodyAxisSourceNote</div>
                            <div class="row g-2">
                                @foreach (var picker in BodyAxisPickers)
                                {
                                    var picked = picker.Read(_bodyCard.Axes) ?? string.Empty;
                                    var custom = IsCustomAxis(picker, picked);
                                    <div class="@picker.ColumnClass">
                                        <label class="form-label small mb-1">@picker.Label</label>
                                        <select class="form-select form-select-sm"
                                                value="@(custom ? CustomAxisValue : picked)"
                                                @onchange="e => OnAxisPicked(picker, e.Value?.ToString())">
                                            <option value="">— not set —</option>
                                            @foreach (var option in picker.Options)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                            <option value="@CustomAxisValue">(custom…)</option>
                                        </select>
                                        @if (custom)
                                        {
                                            <input class="form-control form-control-sm mt-1"
                                                   placeholder="type your own wording"
                                                   value="@picked"
                                                   @oninput="e => picker.Write(_bodyCard.Axes, e.Value?.ToString())" />
                                        }
                                        @if (DescribeAxisConsequence(picker.Axis, picked) is { Length: > 0 } consequence)
                                        {
                                            @* The consequence, not just a label. A value whose name is vague and whose
                                               Pony rendering is EMPTY looks identical to one that works — which is exactly
                                               how "my pick did nothing" happens. *@
                                            <div class="small text-muted mt-1">@consequence</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small mb-1">@BodyCardLabel(CharacterBodyCardField.BodyShape)</label>
                                <input class="form-control form-control-sm" @bind="_bodyCard.BodyShape" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">@BodyCardLabel(CharacterBodyCardField.HeightBuild)</label>
                                <input class="form-control form-control-sm" @bind="_bodyCard.HeightBuild" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">@BodyCardLabel(CharacterBodyCardField.Skin)</label>
                                <input class="form-control form-control-sm" @bind="_bodyCard.Skin" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">
                                    @BodyCardLabel(CharacterBodyCardField.BodyHair)
                                    @if (BodyCardRequiresDecision(CharacterBodyCardField.BodyHair))
                                    {
                                        <span class="badge text-bg-warning ms-1">[DECIDE]</span>
                                    }
                                </label>
                                <input class="form-control form-control-sm" list="body-card-body-hair-options" @bind="_bodyCard.BodyHair" />
                                <datalist id="body-card-body-hair-options">
                                    @foreach (var option in PhysicalAttributesCatalog.BodyHairOptions)
                                    {
                                        <option value="@option"></option>
                                    }
                                </datalist>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">
                                    @BodyCardLabel(CharacterBodyCardField.Tattoos)
                                    @if (BodyCardRequiresDecision(CharacterBodyCardField.Tattoos))
                                    {
                                        <span class="badge text-bg-warning ms-1">[DECIDE]</span>
                                    }
                                </label>
                                <input class="form-control form-control-sm" @bind="_bodyCard.Tattoos" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">@BodyCardLabel(CharacterBodyCardField.ScarsMarks)</label>
                                <input class="form-control form-control-sm" @bind="_bodyCard.ScarsMarks" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">
                                    @BodyCardLabel(CharacterBodyCardField.PubicHair)
                                    @if (BodyCardRequiresDecision(CharacterBodyCardField.PubicHair))
                                    {
                                        <span class="badge text-bg-warning ms-1">[DECIDE]</span>
                                    }
                                </label>
                                <input class="form-control form-control-sm" list="body-card-pubic-hair-options" @bind="_bodyCard.PubicHair" />
                                <datalist id="body-card-pubic-hair-options">
                                    @foreach (var option in PhysicalAttributesCatalog.PubicHairOptions)
                                    {
                                        <option value="@option"></option>
                                    }
                                </datalist>
                            </div>
                        </div>
                        <div class="border-top mt-3 pt-2">
                            <div class="d-flex gap-2 flex-wrap align-items-center">
                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        @onclick="PrefillFromCharacterAsync" disabled="@_prefillBusy">
                                    Prefill from character
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        @onclick="DraftFromDescriptionAsync" disabled="@_prefillBusy">
                                    Draft from description
                                </button>
                                @if (_prefillBusy)
                                {
                                    <span class="small text-muted">Working…</span>
                                }
                            </div>
                            <div class="form-text">
                                Either source fills only the fields you have left EMPTY, and nothing is saved until you press
                                Save. <strong>Prefill from character</strong> copies the character template's physical
                                attributes; <strong>Draft from description</strong> asks the configured model what the
                                character's description actually states, and proposes nothing for the rest.
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_prefillMessage))
                            {
                                <div class="alert @(_prefillMessageIsError ? "alert-danger" : "alert-info") small py-1 px-2 mt-2 mb-0">@_prefillMessage</div>
                            }

                            @if (_prefill is not null)
                            {
                                <div class="mt-2">
                                    <div class="small text-muted mb-1">
                                        @_prefill.Proposals.Count proposal(s) from
                                        @(_prefill.Source == CharacterBodyCardPrefillSource.CharacterAttributes
                                            ? "the character template"
                                            : $"the description draft ({_prefill.ModelIdentifier})")
                                    </div>
                                    @if (_prefill.Proposals.Count == 0)
                                    {
                                        <p class="small mb-1">Nothing could be proposed.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var proposal in _prefill.Proposals)
                                            {
                                                var applies = BodyCardAcceptsProposal(proposal);
                                                <li class="list-group-item px-0 py-1">
                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                        <span class="small">
                                                            <strong>@proposal.Label</strong>: @proposal.ProposedValue
                                                            <br />
                                                            <span class="text-muted">@proposal.Provenance</span>
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                                disabled="@(!applies)"
                                                                @onclick="() => ApplyPrefillProposalAsync(proposal)">
                                                            @(applies ? "Apply" : "Already set")
                                                        </button>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                        <button type="button" class="btn btn-sm btn-outline-success mt-2"
                                                @onclick="ApplyPrefillToEmptyFieldsAsync">
                                            Fill the empty fields
                                        </button>
                                    }

                                    @if (_prefill.Gaps.Count > 0)
                                    {
                                        <details class="mt-2">
                                            <summary class="small">
                                                @_prefill.Gaps.Count field(s) nothing could answer
                                            </summary>
                                            <ul class="small text-muted mb-0">
                                                @foreach (var gap in _prefill.Gaps)
                                                {
                                                    <li>
                                                        <strong>@gap.Label</strong>@(gap.RequiresDecision ? " [DECIDE]" : string.Empty): @gap.Reason
                                                    </li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </div>
                            }
                        </div>

                        <button type="button" class="btn btn-primary btn-sm mt-3" @onclick="SaveBodyCardAsync" disabled="@_bodyCardBusy">
                            @(_bodyCardVersion == 0 ? "Record body card" : "Save body card")
                        </button>
                        @if (_bodyCardVersion > 0)
                        {
                            <span class="small text-muted ms-2">v@_bodyCardVersion</span>
                        }
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Body build</strong>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="StartBodyBuildAsync" disabled="@_bodyStartingBuild">
                            @(_bodyBuild is null ? "Start body build" : "Start over")
                        </button>
                    </div>
                    <div class="card-body">
                        @if (_bodyBuild is null)
                        {
                            <p class="text-muted small mb-0">
                                The body target is the same pipeline as the face build, on its own plan: one request
                                produces one image, in the order the plan lists — a base in each state, then the angles.
                                There is no batch and no "generate all".
                            </p>
                        }
                        else
                        {
                            <p class="small text-muted mb-2">
                                Build <code>@_bodyBuild.Id</code> · @_bodyBuild.Status · current step <strong>@StepLabel(_bodyBuild.CurrentStep)</strong>
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var row in _bodyStepRows)
                                {
                                    <span class="badge @StepBadge(row.Status)" title="@row.FailureReason">@StepLabel(row.Step)</span>
                                }
                            </div>

                            @* B-122 E-2: the clothed and unclothed view grids. One row per canonical slot, one
                               request per row — the panel owns the per-view actions and this page only tells it
                               which build it is acquiring and which settings apply. *@
                            <div class="card mt-3">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <strong>Body view settings</strong>
                                    <span class="small text-muted">set once — used by every body view</span>
                                </div>
                                <div class="card-body">
                                    <p class="small text-muted mb-2">
                                        The image model and the render size for the whole body set. A full-body frame
                                        needs portrait proportions, and every view of one body must be rendered at
                                        the SAME size — otherwise the views are not comparable. Nothing here is
                                        assumed: an unset value disables Generate rather than quietly picking one.
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(_bodyViewSettingsMessage))
                                    {
                                        <div class="alert alert-secondary py-1 small mb-2">@_bodyViewSettingsMessage</div>
                                    }
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-5">
                                            <label class="form-label small mb-1">Body view model</label>
                                            <select class="form-select form-select-sm" @bind="_bodyViewModelId">
                                                <option value="">Select model…</option>
                                                @foreach (var choice in _bodyViewModels)
                                                {
                                                    <option value="@choice.ModelId">@choice.DisplayName</option>
                                                }
                                            </select>
                                            @if (!string.IsNullOrWhiteSpace(_bodyViewModelsMessage))
                                            {
                                                <div class="small text-warning mt-1">
                                                    @_bodyViewModelsMessage
                                                    <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                                                            @onclick="() => RetryBodyViewModelListAsync()">Retry</button>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small mb-1">Image size</label>
                                            <input class="form-control form-control-sm" @bind="_bodyViewImageSize" />
                                        </div>
                                        <div class="col-md-4">
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    @onclick="SaveBodyViewSettingsAsync" disabled="@_bodyViewSettingsBusy">
                                                Save body view settings
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <BodyViewsPanel BuildId="@_bodyBuild.Id" CharacterName="@BodyPanelCharacterName"
                                                ModelId="@_bodyViewModelId" ModelName="@BodyViewModelName"
                                                ImageSize="@_bodyViewImageSize"
                                                SettingsRevision="@_bodyViewSettingsRevision" />
                            </div>
                        }
                    </div>
                </div>
            </div>
            break;
        case "LoRA images":
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">LoRA images</h5>
                    <p class="text-muted mb-0">LoRA dataset coverage cells, created one at a time with pose + identity — B-123 Phases 1–7. Not yet implemented.</p>
                </div>
            </div>
            break;
        case "LoRAs":
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">LoRAs</h5>
                    <p class="text-muted mb-0">Trained artifacts per base model — B-123 Phase 8. Not yet implemented.</p>
                    <a href="/asset-studio/lora-training-profiles" class="btn btn-sm btn-outline-primary">Training profiles</a>
                </div>
            </div>
            break;
        default:
            <CharacterIdentity CharacterId="@CharacterId" PackId="@PackId" />
            break;
    }
</div>

@if (_viewerAttempt is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.85);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Front attempt · <span class="font-monospace small">@_viewerAttempt.Id</span></h5>
                    <button type="button" class="btn-close" @onclick="CloseAttemptViewer" title="Close"></button>
                </div>
                <div class="modal-body text-center">
                    @if (_viewerAttempt.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(_viewerAttempt.FileRelativePath))
                    {
                        <img src="/scene-images/@_viewerAttempt.FileRelativePath" class="img-fluid" style="max-height:80vh;" alt="front attempt" />
                    }
                    else
                    {
                        <div class="text-muted py-5">@_viewerAttempt.Status</div>
                    }
                </div>
                <div class="modal-footer">
                    @if (!string.IsNullOrWhiteSpace(_viewerAttempt.FileRelativePath))
                    {
                        <a class="btn btn-outline-secondary btn-sm" href="/scene-images/@_viewerAttempt.FileRelativePath" target="_blank" title="Open full size"><i class="bi bi-arrows-fullscreen me-1"></i>Open full size</a>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="CloseAttemptViewer">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] _sections = ["Faces", "Body", "LoRA images", "LoRAs", "Packs"];

    /// <summary>Matches the options the validation service writes with, so camelCase keys read back.</summary>
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    /// <summary>Short rail labels, so the one-line status strip stays readable.</summary>
    private static string StepLabel(CharacterIdentityBuildStep step) => step switch
    {
        CharacterIdentityBuildStep.GarmentRemoval => "De-clothe",
        _ => step.ToString()
    };

    [Parameter] public string? CharacterId { get; set; }

    [Parameter] public string? PackId { get; set; }

    /// <summary>
    /// The character whose identity this page edits (B-127). The route may arrive with any owner id — a character
    /// template, a scenario character or a character asset — and identity always resolves to the template, so every
    /// identity call below uses <see cref="IdentityKey"/> rather than the raw route id. Resolution is refused, never
    /// guessed: an unresolvable id shows the resolver's message instead of an empty page.
    /// </summary>
    private CharacterIdentityOwner? _owner;

    /// <summary>
    /// The name the body views' prompts address. It is the owner template's name — the same identity the rest of
    /// this page reads and writes — and never the route id a caller happened to arrive with.
    /// </summary>
    private string BodyPanelCharacterName => _owner?.TemplateName ?? string.Empty;

    /// <summary>The display name of the model the body set is configured with, for the grid's read-only summary.</summary>
    private string BodyViewModelName => _bodyViewModels
        .FirstOrDefault(choice => string.Equals(choice.ModelId, _bodyViewModelId, StringComparison.Ordinal))
        ?.DisplayName ?? _bodyViewModelId;

    /// <summary>
    /// The body set's settings (model + render size) come from the persisted workflow settings and are edited in the
    /// card above the grid, not per view: one body, one size, one model.
    /// </summary>
    private async Task RefreshBodyViewSettingsAsync()
    {
        if (string.IsNullOrWhiteSpace(IdentityKey))
        {
            return;
        }

        // The MODEL LIST is loaded on its own, deliberately NOT inside the settings try below. They were one block, so any
        // failure (a transient "database is locked", a half-written provider row) left the picker EMPTY with nothing but a
        // message — "no models are showing up in the list to pick" (operator report, 2026-09-23) — and the two facts, "the
        // list could not be read" and "this character has no model", were indistinguishable.
        try
        {
            if (_bodyViewModels.Count == 0)
            {
                _bodyViewModels = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: false)).ToList();
            }

            _bodyViewModelsMessage = _bodyViewModels.Count == 0
                ? "No image model is registered for generation (Model Manager → models of kind Image without an editor "
                  + "diffusion model). A body render needs one."
                : string.Empty;
        }
        catch (Exception error)
        {
            // The list itself failed. Say so, and offer the retry, instead of leaving an empty dropdown to be read as
            // "nothing is configured".
            _bodyViewModelsMessage = $"The image-model list could not be read: {error.Message}";
        }

        try
        {
            var settings = await BodyService.ResolveViewSettingsAsync(IdentityKey);
            _bodyViewModelId = settings.ModelId;
            _bodyViewImageSize = settings.ImageSize;
        }
        catch (Exception error)
        {
            _bodyViewSettingsMessage = error.Message;
        }
    }

    private async Task SaveBodyViewSettingsAsync()
    {
        if (string.IsNullOrWhiteSpace(IdentityKey))
        {
            return;
        }

        _bodyViewSettingsBusy = true;
        try
        {
            await BodyService.SaveViewSettingsAsync(IdentityKey, _bodyViewModelId, _bodyViewImageSize);
            await RefreshBodyViewSettingsAsync();

            // The model dropdown is two-way bound, so the panel's ModelId parameter changes BEFORE the save persists.
            // The panel's capability answer is therefore re-asked against the OLD settings and never again — which is
            // how a model that declares identity kept showing "identity is unavailable" after the save. The SAVE is the
            // event that changes the persisted setting, so the save is what tells the panel to re-ask.
            _bodyViewSettingsRevision++;
            _bodyViewSettingsMessage = $"Body view settings saved: {BodyViewModelName} at {_bodyViewImageSize}.";
        }
        catch (Exception error)
        {
            _bodyViewSettingsMessage = error.Message;
        }
        finally
        {
            _bodyViewSettingsBusy = false;
        }
    }

