    /// <summary>
    /// Which value set the pickers are showing, and WHY. The gender gate only recognises "Male" exactly, so a character
    /// whose gender is blank, "Any" or an abbreviation silently gets the female-typical set — the operator's "all the
    /// dropdowns are for a typical female body, but the template says male" (2026-09-23). Nothing is defaulted here: the
    /// line names the gender the studio actually read, so a set that does not match the template is visible before a
    /// render is spent.
    /// </summary>
    private string BodyAxisSourceNote
    {
        get
        {
            if (IsMaleCharacter)
            {
                return $"Body values shown for MALE characters (the character's gender is '{_characterGender}').";
            }

            if (string.Equals(_characterGender, "Female", StringComparison.OrdinalIgnoreCase))
            {
                return $"Body values shown for FEMALE characters (the character's gender is '{_characterGender}').";
            }

            return $"Body values shown for FEMALE characters, because this character's gender is "
                + $"'{(_characterGender ?? "(unset)")}' rather than 'Male' — set the gender to Male on the character to "
                + "get the male value set.";
        }
    }

    /// <summary>
    /// Writes the picked body parts into the body shape line. BodyShape stays the authored, gate-checked field that
    /// reaches the prompt — this only fills it, and it stays hand-editable afterwards. Nothing is saved here; Save
    /// remains the only writer of the card.
    /// </summary>
    private Task ComposeBodyAxesAsync()
    {
        if (_bodyCard is null)
        {
            return Task.CompletedTask;
        }

        // The chest label travels WITH the picks: the composed line has to read "chest Average" on a male card, and
        // three places compare the stored line against Compose() — a label passed only here would make a male card look
        // permanently stale.
        _bodyCard.Axes.ChestLabel = ChestAxisLabel.ToLowerInvariant();
        var composed = _bodyCard.Axes.Compose();
        if (string.IsNullOrWhiteSpace(composed))
        {
            _bodyMessage = "No body parts picked yet, so there is nothing to compose.";
            return Task.CompletedTask;
        }

        _bodyCard.BodyShape = composed;
        _bodyMessage = "Body shape composed from the picked body parts. Save the card to keep it.";
        return Task.CompletedTask;
    }

    /// <summary>
    /// Offers the template's axis picks as the card's start point, without overwriting picks the operator has
    /// already made — the same rule the field proposals follow (the operator's decision always wins).
    /// </summary>
    private void TrySeedAxesFromPrefill()
    {
        if (_bodyCard is null || _prefill?.Axes is null || !_bodyCard.Axes.IsEmpty)
        {
            return;
        }

        _bodyCard.Axes = _prefill.Axes;
    }

    /// <summary>
    /// One body-part picker: its label, its layout width, the catalog it picks from, and how to read and write the
    /// axis on the card. Declared once so the pickers are generated from a list rather than hand-copied — ten copied
    /// blocks is how a picker gets left behind when an axis is added.
    /// </summary>
    private sealed record BodyAxisPicker(
        BodyAxis Axis,
        string Label,
        string ColumnClass,
        IReadOnlyList<string> Options,
        Func<CharacterBodyAxes, string?> Read,
        Action<CharacterBodyAxes, string?> Write);

    /// <summary>
    /// The value a picker carries when the operator wants to type their own wording. Not a value any catalog can
    /// contain, so a pick can never be confused with a typed override.
    /// </summary>
    private const string CustomAxisValue = "__custom__";

    /// <summary>
    /// True when the card's shape line is not what its picked parts compose. The PARTS generate (only they carry a
    /// per-family rendering); the line is their record. Drift is normal — changing a picker does not rewrite the line —
    /// so it is shown as a warning with the one-click fix, and the compiler does not refuse on it.
    /// </summary>
    private bool BodyShapeLineIsStale
        => _bodyCard is not null
