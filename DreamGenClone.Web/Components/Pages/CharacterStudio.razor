    private async Task RefreshGarmentAsync()
    {
        if (_build is null || (int)_build.CurrentStep < (int)CharacterIdentityBuildStep.GarmentRemoval)
        {
            _garmentSource = null;
            _garmentSubject = null;
            return;
        }

        try
        {
            _garmentSource = await GarmentService.ResolveGarmentSourceAsync(_build.Id);
            _garmentSubject = ImageEditSubject.ForAssetImage(_garmentSource.AssetId, _garmentSource.Id);
            _garmentReviewDeckUrl = string.IsNullOrWhiteSpace(_garmentSource.CandidateBatchId)
                ? null
                : $"/review-deck/asset/{_garmentSource.CandidateBatchId}";
            _garmentIntent = await GarmentService.ResolveGarmentPromptAsync(
                _build.CharacterProfileId, _characterName, _characterGender);
            _garmentEditorModelId = await GarmentService.ResolveEditorModelIdAsync();
            await RefreshEditedImagesAsync();
        }
        catch (Exception ex)
        {
            _garmentMessage = ex.Message;
        }
    }

    private async Task RefreshAnglesAsync()
    {
        if (_build is null)
            return;

        try
        {
            _angles = (await AnglesService.ListAsync(_build.Id)).ToList();
            if (_build.CanonicalFrontAssetId is { Length: > 0 } canonicalId)
            {
                var canonical = await AssetService.GetImageAsync(canonicalId);
                if (canonical is not null)
                    _angleImages = (await AssetService.ListImagesAsync(canonical.AssetId)).ToList();
            }
            foreach (var view in AngleViews)
            {
                if (!_anglePrompts.ContainsKey(view))
                    _anglePrompts[view] = view is CharacterIdentityAngleView.ThreeQuarterLeft or CharacterIdentityAngleView.ThreeQuarterRight
                        ? "Turn the person's head and upper body to a three-quarter view so the nose points toward the LEFT side of the image and more of the left side of the face is visible. Keep the exact same face, hair, facial features, identity, bare neck and bare shoulders, and lighting unchanged. Do not add any clothing. Keep the identical crop, framing, zoom and head size."
                        : "Turn the person's head to a full profile so the nose points toward the LEFT side of the image and the left side of the face is shown in full profile. Keep the exact same face, hair, facial features, identity, bare neck and bare shoulders, and lighting unchanged. Do not add any clothing. Keep the identical crop, framing, zoom and head size.";
            }
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

