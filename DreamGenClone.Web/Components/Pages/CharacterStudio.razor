    private async Task SelectFrontAsync(string imageId)
    {
        if (_build is null)
        {
            return;
        }

        _frontBusy = true;
        _frontMessage = null;
        try
        {
            var selected = _frontAttempts.FirstOrDefault(a => string.Equals(a.Id, imageId, StringComparison.Ordinal));
            var selectedAlready = selected is not null && IsChosenFront(selected);
            if (selectedAlready && _build.CurrentStep == CharacterIdentityBuildStep.Validate)
            {
                var validation = ParseValidation(selected.ValidationResultJson);
                var gate = await ValidationService.GetGateAsync(_build.Id);
                if (!gate.CanAdvance)
                {
                    _frontMessage = gate.BlockReason is not null
                        ? $"Validate is blocked: {gate.BlockReason}"
                        : validation is null
                            ? "Validate this front first before continuing."
                            : $"Validate is {validation.Verdict}: {validation.BlockReason}";
                    return;
                }

                // A recorded build-level manual override is an explicit alternative to the image-level
                // eye verdict. Do not re-measure and replace the user's override when Continue is clicked.
                if (!gate.ManualOverrideApplied)
                {
                    await ValidationService.MeasureAsync(_build.Id);
                }
                await ValidationService.AdvanceAsync(_build.Id);
                _build = await BuildService.GetBuildAsync(_build.Id) ?? _build;
                _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
                await RefreshGarmentAsync();
                _frontMessage = $"Front continued past validation — build advanced to {_build.CurrentStep}.";
                return;
            }

            // A different candidate can be chosen after Front has already been completed. Re-open only the
            // Front step and record the new candidate there: choosing a candidate is not the same act as
            // advancing past Validate, so a candidate the eye gate rejects is accepted here and left blocked
            // on its own verdict — which is the state whose card offers the manual override (B-121 note 008).
            // Refusing the selection outright left a deleted recorded front with no way forward at all.
            if (_build.CurrentStep == CharacterIdentityBuildStep.Validate)
            {
                _build = await BuildService.ReRunStepAsync(_build.Id, CharacterIdentityBuildStep.Front);
                _build = await FrontService.SelectFrontAsync(_build.Id, imageId);
                _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
                var measured = await ValidationService.MeasureAsync(_build.Id);
                if (measured.CanAdvance)
                {
                    await ValidationService.AdvanceAsync(_build.Id);
                    _build = await BuildService.GetBuildAsync(_build.Id) ?? _build;
                    _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
                    await RefreshGarmentAsync();
                    _frontMessage = $"Front selected and past the eye gate — build advanced to {_build.CurrentStep}.";
                }
                else
                {
                    _frontMessage = $"Front selected. Validate is {measured.Verdict}: {measured.BlockReason}";
                }

                await RefreshFrontAttemptsAsync();
                return;
            }

            _build = await FrontService.SelectFrontAsync(_build.Id, imageId);
            _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
            _frontMessage = $"Front selected — build advanced to {_build.CurrentStep}.";

            // Validate is automatic once a front is chosen (note 001): the chosen image's own gate result
            // decides whether the pipeline may move past it, so no separate "advance" control is needed.
            var chosen = _frontAttempts.FirstOrDefault(a => string.Equals(a.Id, imageId, StringComparison.Ordinal));
            var chosenValidation = ParseValidation(chosen?.ValidationResultJson);
            if (chosenValidation?.Verdict == CharacterIdentityValidationVerdict.Pass)
            {
                await ValidationService.MeasureAsync(_build.Id);
                await ValidationService.AdvanceAsync(_build.Id);
                _build = await BuildService.GetBuildAsync(_build.Id) ?? _build;
                _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
                _frontMessage = $"Front selected and past the eye gate — build advanced to {_build.CurrentStep}.";
            }
            else if (chosenValidation is not null)
            {
                _frontMessage += $" Validate is {chosenValidation.Verdict}: {chosenValidation.BlockReason}";
            }

            await RefreshFrontAttemptsAsync();
        }
        catch (Exception ex)
        {
            _frontMessage = ex.Message;
        }
        finally
        {
            _frontBusy = false;
        }
    }

    /// <summary>
    /// Measures one candidate on demand and stores the result on that image. A failed gate rejects the
    /// image, so a candidate that is out of contention says so on its own card.
    /// </summary>
    private async Task RevalidateAsync(SceneAssetImage attempt)
    {
        _validationBusy = true;
        _frontMessage = null;
        try
        {
            var result = await ValidationService.MeasureImageAsync(attempt.Id);
            _frontMessage = result.Verdict == CharacterIdentityValidationVerdict.Pass
                ? $"{attempt.Id[..8]}… passed the eye gate ({result.IrisDyPercent:F2}%)."
                : $"{attempt.Id[..8]}… {result.Verdict}: {result.BlockReason}";
            await RefreshFrontAttemptsAsync();

            // Front may already be complete when validation is run separately from front selection.
            // In that state, a passing result for the selected front is the explicit signal to advance
            // Validate; do not ask the user to click Use this again, which would be out of order.
            if (result.Verdict == CharacterIdentityValidationVerdict.Pass
                && _build is not null
                && _build.CurrentStep == CharacterIdentityBuildStep.Validate
                && IsChosenFront(attempt))
            {
                await ValidationService.AdvanceAsync(_build.Id);
                _build = await BuildService.GetBuildAsync(_build.Id) ?? _build;
                _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
                await RefreshGarmentAsync();
                _frontMessage = $"{attempt.Id[..8]}… passed the eye gate and the build advanced to {_build.CurrentStep}.";
            }
        }
        catch (Exception ex)
        {
            _frontMessage = ex.Message;
        }
        finally
        {
            _validationBusy = false;
        }
    }

