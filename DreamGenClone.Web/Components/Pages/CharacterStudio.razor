    private async Task RefreshAnglesAsync()
    {
        if (_build is null)
            return;

        try
        {
            _angles = (await AnglesService.ListAsync(_build.Id)).ToList();

            // Each card renders the image its own record names, resolved by id. This must not be a scan of one
            // container read when the page loaded: an image created during the session (an upload, or an edit
            // result) is not in that list, and a card that cannot find its image renders nothing at all.
            var images = new List<SceneAssetImage>();
            foreach (var outputId in _angles
                         .Select(angle => angle.OutputArtifactId)
                         .Where(id => !string.IsNullOrWhiteSpace(id))
                         .Distinct(StringComparer.Ordinal))
            {
                var image = await AssetService.GetImageAsync(outputId!);
                if (image is not null)
                {
                    images.Add(image);
                }
            }

            _angleImages = images;

            // Every card's own attempt count, read here so the FIRST render has it too: counting only in the
            // panel refresh left every card reporting zero attempts until the user acted (B-121 note 010).
            foreach (var countedView in AngleViews)
            {
                _angleAttemptCounts[countedView] = (await AnglesService.ListAttemptsAsync(_build.Id, countedView)).Count;
            }

            foreach (var view in AngleViews)
            {
                if (!_anglePrompts.ContainsKey(view))
                    _anglePrompts[view] = view is CharacterIdentityAngleView.ThreeQuarterLeft or CharacterIdentityAngleView.ThreeQuarterRight
                        ? "Turn the person's head and upper body to a three-quarter view so the nose points toward the LEFT side of the image and more of the left side of the face is visible. Keep the exact same face, hair, facial features, identity, bare neck and bare shoulders, and lighting unchanged. Do not add any clothing. Keep the identical crop, framing, zoom and head size."
                        : "Turn the person's head to a full profile so the nose points toward the LEFT side of the image and the left side of the face is shown in full profile. Keep the exact same face, hair, facial features, identity, bare neck and bare shoulders, and lighting unchanged. Do not add any clothing. Keep the identical crop, framing, zoom and head size.";
            }
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

    /// <summary>
    /// Re-reads everything Panel C draws from — the four angle records, the image each card shows, and the
    /// attempts of the open card — plus the Promote readiness that depends on those records. Every angle
    /// action ends here, so no card can keep rendering the state it had when the page loaded: an image created
    /// during the session is not in a list read at page load, and a card that cannot find its own image renders
    /// nothing at all (B-121 note 009).
    /// </summary>
    private async Task RefreshAnglePanelAsync(CharacterIdentityAngleView? attemptsView = null)
    {
        if (_build is null)
        {
            return;
        }

        await RefreshAnglesAsync();

        var view = attemptsView ?? _selectedAngleView;
        if (view is null)
        {
            _angleAttempts = [];
            _angleAttemptImages = [];
        }
        else
        {
            _angleAttempts = (await AnglesService.ListAttemptsAsync(_build.Id, view.Value)).ToList();
            _angleAttemptImages = await LoadAngleAttemptImagesAsync(_angleAttempts);
        }

        // Readiness reads the same records, so accepting the last angle has to show up in Panel D too.
        await RefreshPromotionAsync();
    }

    private async Task RefreshPromotionAsync()
    {
        if (_build is null || (int)_build.CurrentStep < (int)CharacterIdentityBuildStep.Promote)
            return;
        try
        {
            _promotion = await PromotionService.GetReadinessAsync(_build.Id);
        }
        catch (Exception ex)
        {
            _promotionMessage = ex.Message;
        }
    }

    private async Task PromoteIdentityAsync()
    {
        if (_build is null)
            return;
        _promotionBusy = true;
        try
        {
            _promotion = await PromotionService.PromoteAsync(_build.Id);
            _packs = (await IdentityService.ListPacksAsync(_build.CharacterTemplateId)).ToList();
            _promotionMessage = $"Promoted the five accepted views to draft identity pack {_promotion.PackId}.";
            _activeSection = "Packs";
        }
        catch (Exception ex)
        {
            _promotionMessage = ex.Message;
        }
        finally
        {
            _promotionBusy = false;
        }
    }

    private string AnglePrompt(CharacterIdentityAngleView view)
        => _anglePrompts.TryGetValue(view, out var prompt) ? prompt : string.Empty;

    private void SetAnglePrompt(CharacterIdentityAngleView view, string? prompt)
        => _anglePrompts[view] = prompt ?? string.Empty;

    private async Task SelectAngleAsync(CharacterIdentityAngleView view)
    {
        if (_build is null)
            return;

        // Change the visible selection before any asynchronous preparation. This prevents the previous
        // angle's workspace from remaining on screen when the newly selected angle is still loading or
        // has a preparation error.
        _selectedAngleView = view;
        _angleSource = null;
        _angleSubject = null;
        _angleReviewDeckUrl = null;
        _anglesMessage = $"Loading {AngleLabel(view)} edit workspace…";
        _anglesBusy = true;
        try
        {
            _angleEditorModelId = await GarmentService.ResolveEditorModelIdAsync();
            // Resolve the selected view's persisted template in the service. Do not pass the previous
            // card's in-memory prompt as an override: left and right have distinct template keys.
            var prepared = await AnglesService.PrepareAsync(_build.Id, view, _angleEditorModelId);
            _anglePrompts[view] = prepared.ResolvedPromptText
                ?? throw new InvalidOperationException($"The resolved prompt for {AngleLabel(view)} was empty.");
            _angleSource = await AssetService.GetImageAsync(prepared.InputArtifactId!)
                ?? throw new InvalidOperationException($"Angle source image '{prepared.InputArtifactId}' was not found.");
            _angleSubject = new ImageEditSubject(
                ImageEditSubjectKind.AssetImage,
                _angleSource.Id,
                _angleSource.AssetId,
                CandidateBatchId: CharacterIdentityAnglesService.CandidateBatchIdFor(_build.Id, view));
            _angleReviewDeckUrl = string.IsNullOrWhiteSpace(_angleSource.CandidateBatchId)
                ? null
                : $"/review-deck/asset/{_angleSource.CandidateBatchId}";
            await RefreshAnglePanelAsync(view);
            _anglesMessage = $"{AngleLabel(view)} selected. Prepare the prompt, then run the edit.";
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
        finally
        {
            _anglesBusy = false;
        }
    }

    private async Task UploadAngleAsync(CharacterIdentityAngleView view, InputFileChangeEventArgs args)
    {
        if (_build is null || args.File is null)
            return;
        try
        {
            await using var stream = args.File.OpenReadStream(20 * 1024 * 1024);
            await AnglesService.UploadAsync(_build.Id, view, args.File.Name, stream);
            _selectedAngleView = view;
            await SelectAngleAsync(view);
            _anglesMessage = $"Uploaded {args.File.Name} as a {AngleLabel(view)} attempt. Review it, edit it if needed, then use this angle.";
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

    private async Task OnAngleCardKeyDown(KeyboardEventArgs args, CharacterIdentityAngleView view)
    {
        if (args.Key is "Enter" or " ")
            await SelectAngleAsync(view);
    }

    private string AngleEditImageUrl(string imageId)
        => _angleSource is null ? string.Empty : $"/assets/{_angleSource.AssetId}/images/{imageId}/edit";

    private string AngleReviewDeckUrl(CharacterIdentityAngleView view)
        => $"/review-deck/asset/{CharacterIdentityAnglesService.CandidateBatchIdFor(_build!.Id, view)}";

    private async Task OnAngleResultAsync(CharacterIdentityAngleView resultView, ImageEditResultView result)
    {
        if (_build is null)
            return;

        try
        {
            await AnglesService.RecordResultAsync(_build.Id, resultView, result.ImageId, AnglePrompt(resultView));
            await RefreshAnglePanelAsync(resultView);
            _anglesMessage = $"{AngleLabel(resultView)} produced a result. Review it, then use this angle.";
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

    private async Task AcceptAngleAsync(CharacterIdentityAngleView view)
    {
        if (_build is null)
            return;
        try
        {
            await AnglesService.AcceptAsync(_build.Id, view, _profileConfirmations.GetValueOrDefault(view));
            _anglesMessage = $"{AngleLabel(view)} accepted.";
            _build = await BuildService.GetBuildAsync(_build.Id) ?? _build;
            _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
            await RefreshAnglePanelAsync(view);
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

    private async Task AcceptAngleAttemptAsync(CharacterIdentityAngleView view, string attemptId)
    {
        if (_build is null)
            return;
        try
        {
            await AnglesService.AcceptAttemptAsync(_build.Id, view, attemptId, _profileConfirmations.GetValueOrDefault(view));
            _build = await BuildService.GetBuildAsync(_build.Id) ?? _build;
            _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
            await RefreshAnglePanelAsync(view);
            _anglesMessage = $"{AngleLabel(view)} attempt selected.";
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

    private async Task DeleteAngleAttemptAsync(CharacterIdentityAngleView view, string attemptId)
    {
        if (_build is null)
            return;
        try
        {
            await AnglesService.DeleteAttemptAsync(_build.Id, view, attemptId);
            await RefreshAnglePanelAsync(view);
            _anglesMessage = $"Deleted the selected {AngleLabel(view)} attempt output.";
        }
        catch (Exception ex)
        {
            _anglesMessage = ex.Message;
        }
    }

    private async Task RecordAngleOverrideAsync(CharacterIdentityAngleView view, string attemptId)
    {
        if (_build is null)
            return;
        try
        {
            await AnglesService.RecordOverrideAsync(
                _build.Id,
                view,
                attemptId,
                _overrideReasons.GetValueOrDefault(attemptId) ?? string.Empty,
                _overrideAuthors.GetValueOrDefault(attemptId) ?? string.Empty);
            await RefreshAnglePanelAsync(view);
            _anglesMessage = $"Recorded visual override for {AngleLabel(view)} attempt.";
        }
