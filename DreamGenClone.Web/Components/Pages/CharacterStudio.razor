    /// <summary>
    /// What the picked value BECOMES for each target family, or why it becomes nothing for one of them.
    ///
    /// The picker's job is to make the prompt legible before a render is spent: the vocabulary deliberately omits
    /// values Pony has no reliable token for, and those omissions were invisible — the operator saw a plausible value
    /// selected and no effect in the image. This reuses the vocabulary's own reason (one source), so the hint cannot
    /// drift from what the compiler does.
    /// </summary>
    private static string DescribeAxisConsequence(BodyAxis axis, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var trimmed = value.Trim();
        if (!BodyAxisVocabulary.HasRendering(axis, trimmed))
        {
            return "→ SDXL: sent as written · Pony: nothing (hand-written wording cannot be tagged)";
        }

        var rendering = BodyAxisVocabulary.Require(axis, trimmed);
        if (rendering.IsOmittedForPony)
        {
            return $"→ SDXL: {rendering.SdxlPhrase} · Pony: nothing";
        }

        return $"→ SDXL: {rendering.SdxlPhrase} · Pony: {rendering.PonyTags}";
    }

    /// <summary>
    /// True when this axis shows its text box. A value the catalog does not carry opens the box on its own: silently
    /// showing it as an unselected dropdown would hide wording the operator typed earlier.
    /// </summary>
    private bool IsCustomAxis(BodyAxisPicker picker, string value)
        => _customAxes.Contains(picker.Label)
            || (!string.IsNullOrWhiteSpace(value) && !picker.Options.Contains(value, StringComparer.Ordinal));

    /// <summary>
    /// Applies a pick. "(custom…)" opens the text box and leaves the current value alone so it can be edited; any
    /// other choice is written straight to the axis, and "— not set —" clears it (an unset axis is omitted from the
    /// composed line, never defaulted).
    /// </summary>
    private void OnAxisPicked(BodyAxisPicker picker, string? picked)
    {
        if (string.Equals(picked, CustomAxisValue, StringComparison.Ordinal))
        {
            _customAxes.Add(picker.Label);
            return;
        }

        _customAxes.Remove(picker.Label);
        picker.Write(_bodyCard.Axes, string.IsNullOrWhiteSpace(picked) ? null : picked);
    }

