    protected override async Task OnInitializedAsync()
    {
        var characterId = CharacterId;
        if (string.IsNullOrWhiteSpace(characterId))
        {
            return;
        }

        foreach (var scenario in await ScenarioService.GetAllScenariosAsync())
        {
            // The route id may be the character's OWN id or the TEMPLATE it is backed by — B-127 resolves "any owner id"
            // to the template, and a page opened from the template (which is how the identity work is reached) carries
            // the template id. Matching on Id alone therefore missed the character entirely, so its Gender was never
            // read and every body-axis picker silently fell back to the female-typical set: the operator's "all of the
            // body building dropdowns are for a typical female body, but the template has the gender set to male"
            // (2026-09-23, Dean, whose stored Gender is "Male").
            var character = scenario.Characters.FirstOrDefault(c =>
                string.Equals(c.Id, characterId, StringComparison.Ordinal)
                || string.Equals(c.TemplateId, characterId, StringComparison.Ordinal));
            if (character is not null)
            {
                _characterName = string.IsNullOrWhiteSpace(character.Name) ? "Character" : character.Name;
                _characterGender = character.Gender;
                _scenarioName = scenario.Name;
                break;
            }
        }

        if (_scenarioName is null)
        {
            var ownerAsset = await AssetService.GetAssetAsync(characterId);
            if (ownerAsset is not null && ownerAsset.Type == SceneAssetType.Character)
            {
                _characterName = string.IsNullOrWhiteSpace(ownerAsset.Name) ? "Character" : ownerAsset.Name;
            }
        }

        // B-127: resolve the route id (template, scenario character or character asset) to the character that owns
        // this identity. Identity is keyed by the character TEMPLATE, so every identity call below uses IdentityKey;
        // an unresolvable character is reported with the resolver's remedy, never guessed.
        try
        {
            _owner = await OwnerResolver.ResolveAsync(characterId);
        }
        catch (Exception ex)
        {
            _ownerMessage = ex.Message;
            return;
        }

        // The character template is the canonical address (B-127). Arriving through a scenario character or an
        // asset still works and lands on the same identity, but the URL is normalised so a character has ONE
        // address instead of one per scenario it appears in.
        if (!string.Equals(characterId, _owner.TemplateId, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"/characters/{Uri.EscapeDataString(_owner.TemplateId)}", replace: true);
            return;
        }

        _packs = (await IdentityService.ListPacksAsync(IdentityKey)).ToList();

        var builds = await BuildService.ListBuildsAsync(IdentityKey);
        _build = builds.FirstOrDefault(build => build.TargetKind == CharacterIdentityTargetKind.Face);
        if (_build is not null)
        {
            _stepPlan = await StepPlanService.GetPlanAsync(_build.TargetKind);
            _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
        }

        _bodyBuild = builds.FirstOrDefault(build => build.TargetKind == CharacterIdentityTargetKind.Body);
        if (_bodyBuild is not null)
        {
            _bodyStepPlan = await StepPlanService.GetPlanAsync(_bodyBuild.TargetKind);
            _bodyStepRows = (await BuildService.ListStepsAsync(_bodyBuild.Id)).ToList();

            // B-122 E-2: the model and the render size for the whole body set come from the persisted workflow
            // settings, so the operator sets them once instead of typing a size per view.
            await RefreshBodyViewSettingsAsync();
        }

        try
        {
            _frontModels = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: false)).ToList();
            var savedModel = await FrontService.ResolveFrontModelAsync(IdentityKey);
            _frontModelId = !string.IsNullOrWhiteSpace(savedModel) && _frontModels.Any(m => string.Equals(m.ModelId, savedModel, StringComparison.Ordinal))
                ? savedModel
                : _frontModels.Count > 0 ? _frontModels[0].ModelId : null;
        }
        catch (Exception ex)
        {
            _facesError = ex.Message;
        }

        try
        {
            _frontPrompt = await FrontService.ResolveFrontPromptAsync(IdentityKey, _characterName, "");
            _frontPromptIsCharacterOverride = await FrontService.HasFrontPromptOverrideAsync(IdentityKey);
        }
        catch (Exception ex)
        {
            _facesError = ex.Message;
        }

        await RefreshFrontAttemptsAsync();
        await RefreshGarmentAsync();
        await RefreshAnglesAsync();
        await RefreshPromotionAsync();
        await RefreshBodyCardAsync();
    }
    private static string StepBadge(CharacterIdentityBuildStepStatus status) => status switch
    {
        CharacterIdentityBuildStepStatus.Complete => "text-bg-success",
        CharacterIdentityBuildStepStatus.Failed => "text-bg-danger",
        CharacterIdentityBuildStepStatus.Skipped => "text-bg-warning",
        CharacterIdentityBuildStepStatus.Running => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private async Task StartBuildAsync()
    {
        var characterId = CharacterId;
        if (string.IsNullOrWhiteSpace(characterId))
        {
            return;
