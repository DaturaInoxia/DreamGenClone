    private async Task RunPrefillAsync(string source, Func<Task<CharacterBodyCardPrefill>> produce)
    {
        if (_prefillBusy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(IdentityKey))
        {
            _prefill = null;
            _prefillMessage = _ownerMessage
                ?? "This page has no character template yet, so there is no body card to prefill.";
            _prefillMessageIsError = true;
            return;
        }

        _prefillBusy = true;
        _prefillMessage = null;
        _prefillMessageIsError = false;
        try
        {
            _prefill = await produce();
            TrySeedAxesFromPrefill();
            _prefillMessage = _prefill.IsEmpty
                ? $"Nothing could be proposed from {source}."
                : $"Proposed {_prefill.Proposals.Count} field(s) from {source}. Apply the ones you want — nothing is saved yet.";
            _prefillMessageIsError = _prefill.IsEmpty;
        }
        catch (Exception error)
        {
            _prefill = null;
            _prefillMessage = error.Message;
            _prefillMessageIsError = true;
        }
        finally
        {
            _prefillBusy = false;
        }
    }

    /// <summary>False when the field already has a value: a prefill never overwrites the operator's decision.</summary>
    private bool BodyCardAcceptsProposal(CharacterBodyCardFieldProposal proposal)
        => _bodyCard is not null
            && !string.IsNullOrWhiteSpace(proposal.ProposedValue)
            && !CharacterBodyCardFields.Require(proposal.Field).IsAnswered(_bodyCard);

    private Task ApplyPrefillProposalAsync(CharacterBodyCardFieldProposal proposal)
    {
        if (_bodyCard is null)
        {
            return Task.CompletedTask;
        }

        var applied = _bodyCard.TryApplyPrefill(proposal.Field, proposal.ProposedValue);
        _prefillMessage = applied
            ? $"Applied {proposal.Label} from {proposal.DescribeSource()}. Save the card to keep it."
            : $"{proposal.Label} already has a value, so nothing was applied.";
        _prefillMessageIsError = !applied;
        return Task.CompletedTask;
    }

    private Task ApplyPrefillToEmptyFieldsAsync()
    {
        if (_bodyCard is null || _prefill is null)
        {
            return Task.CompletedTask;
        }

        var applied = _prefill.Proposals.Count(
            proposal => _bodyCard.TryApplyPrefill(proposal.Field, proposal.ProposedValue));
        _prefillMessage = applied == 0
            ? "Every proposed field already has a value, so nothing was applied."
            : $"Applied {applied} proposed field(s). Save the card to keep them.";
        _prefillMessageIsError = false;
        return Task.CompletedTask;
    }

