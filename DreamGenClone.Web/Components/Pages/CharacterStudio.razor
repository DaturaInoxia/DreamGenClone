        _startingBuild = true;
        _facesError = null;
        try
        {
            _build = await BuildService.CreateBuildAsync(IdentityKey, null, CharacterIdentityTargetKind.Face);
            _stepPlan = await StepPlanService.GetPlanAsync(_build.TargetKind);
            _buildStepRows = (await BuildService.ListStepsAsync(_build.Id)).ToList();
        }
        catch (Exception ex)
        {
            _facesError = ex.Message;
        }
        finally
        {
            _startingBuild = false;
        }
    }

    /// <summary>
    /// The body card's own readiness, in its own words: a card that was never recorded is named as such, and an
    /// incomplete one lists every unanswered field with the <c>[DECIDE]</c> items marked. Nothing here decides
    /// anything — the card's own domain rule does.
    /// </summary>
    private string BodyCardStatus
    {
        get
        {
            if (_bodyCardVersion == 0)
            {
                return "Not recorded yet";
            }

            if (_bodyCard.IsReady)
            {
                return "Complete";
            }

            return "Incomplete: " + string.Join(
                ", ",
                _bodyCard.UnresolvedFields.Select(field =>
                    field.RequiresDecision ? $"{field.Label} [DECIDE]" : field.Label));
        }
    }

