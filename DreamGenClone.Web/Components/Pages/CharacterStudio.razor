    private async Task<List<SceneAssetImage>> LoadAngleAttemptImagesAsync(
        IEnumerable<CharacterIdentityAngleAttempt> attempts)
    {
        var images = new List<SceneAssetImage>();
        foreach (var attempt in attempts)
        {
            var imageId = attempt.OutputArtifactId;
            if (string.IsNullOrWhiteSpace(imageId))
            {
                continue;
            }

            var image = await AssetService.GetImageAsync(imageId);
            if (image is not null)
            {
                images.Add(image);
            }
        }

        return images;
    }

    /// <summary>
    /// The direction the angle gate read for one attempt, in the gate's own terms: the signed nose offset in
    /// image space, or the tool's reason when the view cannot be measured (a profile). Empty when the attempt
    /// has no recorded measurement.
    /// </summary>
    private static string DescribeDirection(CharacterIdentityAngleAttempt attempt)
    {
        if (string.IsNullOrWhiteSpace(attempt.MeasurementJson))
        {
            return string.Empty;
        }

        CharacterIdentityEyeMeasurement? measurement;
        try
        {
            measurement = JsonSerializer.Deserialize<CharacterIdentityEyeMeasurement>(attempt.MeasurementJson, JsonOptions);
        }
        catch (JsonException)
        {
            return string.Empty;
        }

        if (measurement is null)
        {
            return string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(measurement.Error))
        {
            return $"Direction: {measurement.Error} — this view is not asserted by measurement.";
        }

        return measurement.NoseOffsetPercent is { } offset
            ? $"Direction: nose offset {offset:F2}% — facing {(offset < 0 ? "image-left" : "image-right")}."
            : string.Empty;
    }

    /// <summary>
    /// Which image this card will edit, or what it is waiting for. The two three-quarter views chain to the
    /// approved canonical front and the profiles to the previously accepted view on their own side, so the
    /// "waiting for" wording says which of the two this card needs (B-121 note 010).
    /// </summary>
    private static string AngleSourceLabel(CharacterIdentityAngleView view, string? sourceImageId)
    {
        if (!string.IsNullOrWhiteSpace(sourceImageId))
        {
            return sourceImageId[..Math.Min(8, sourceImageId.Length)] + "…";
        }

        return view is CharacterIdentityAngleView.ThreeQuarterLeft or CharacterIdentityAngleView.ThreeQuarterRight
            ? "waiting for the approved canonical front"
            : $"waiting for the accepted {AngleLabel(view == CharacterIdentityAngleView.ProfileLeft ? CharacterIdentityAngleView.ThreeQuarterLeft : CharacterIdentityAngleView.ThreeQuarterRight)} view";
    }

    /// <summary>
    /// How many attempts this card owns. Shown on every card so it is obvious which images belong to which view:
    /// the attempts list itself only renders for the open card, and an image that migrated between cards was
    /// exactly the confusing symptom of B-121 note 010.
    /// </summary>
    private int AngleAttemptCount(CharacterIdentityAngleView view)
        => _angleAttemptCounts.TryGetValue(view, out var count) ? count : 0;

    /// <summary>
    /// Panel C reads and writes these three per-attempt/per-view inputs through these helpers, never through a
    /// dictionary indexer in the markup. <c>@bind="_profileConfirmations[view]"</c> reads the key during render,
    /// so a view that had not been touched yet threw <see cref="KeyNotFoundException"/> and killed the circuit
    /// (B-121 note 009). Reads are always tolerant; writes create the entry.
    /// </summary>
    private bool ProfileConfirmed(CharacterIdentityAngleView view)
        => _profileConfirmations.TryGetValue(view, out var confirmed) && confirmed;

    private void SetProfileConfirmed(CharacterIdentityAngleView view, bool confirmed)
        => _profileConfirmations[view] = confirmed;

    private string OverrideReason(string attemptId)
        => _overrideReasons.TryGetValue(attemptId, out var reason) ? reason : string.Empty;

    private void SetOverrideReason(string attemptId, string reason) => _overrideReasons[attemptId] = reason;

    private string OverrideAuthor(string attemptId)
        => _overrideAuthors.TryGetValue(attemptId, out var author) ? author : string.Empty;

    private void SetOverrideAuthor(string attemptId, string author) => _overrideAuthors[attemptId] = author;

    private static string AngleLabel(CharacterIdentityAngleView view) => view switch
    {
        CharacterIdentityAngleView.ThreeQuarterLeft => "Three-quarter left",
        CharacterIdentityAngleView.ThreeQuarterRight => "Three-quarter right",
        CharacterIdentityAngleView.ProfileLeft => "Profile left",
        CharacterIdentityAngleView.ProfileRight => "Profile right",
        _ => view.ToString()
    };

    /// <summary>Loads the edited images of the front asset, newest first.</summary>
    private async Task RefreshEditedImagesAsync()
    {
        if (_garmentSource is null)
        {
            _editedImages = [];
            return;
        }

        var images = await AssetService.ListImagesAsync(_garmentSource.AssetId);
        _editedImages = images
            .Where(image => image.Kind == SceneAssetKind.Edited)
            .OrderByDescending(image => image.CreatedUtc)
            .ToList();
    }

    /// <summary>
    /// Deletes one image. The canonical front is refused: the build's steps point at it, and removing it
    /// would leave those steps naming a file that no longer exists.
    /// </summary>
    private async Task DeleteImageAsync(SceneAssetImage image)
    {
        if (IsCanonicalFront(image))
        {
            _frontMessage = "The canonical front cannot be deleted. Choose another image first.";
            return;
        }

        // The Front step names this image as the build's front and Validate measures that artifact. Deleting
        // it would leave the step naming a file that no longer exists — the state that once made the front
        // list show no chosen card, and therefore no override control (B-121 note 008).
        if (IsChosenFront(image))
        {
            _frontMessage = "This image is the build's recorded front. Choose another candidate with \"Use this\" first.";
            return;
        }

        _frontBusy = true;
        _frontMessage = null;
        try
        {
            await AssetService.DeleteImageAsync(image.Id);
            _frontMessage = $"Deleted {image.Id[..8]}….";
            await RefreshFrontAttemptsAsync();
            await RefreshEditedImagesAsync();
        }
        catch (Exception ex)
        {
            _frontMessage = ex.Message;
        }
        finally
        {
            _frontBusy = false;
        }
    }

    private string GarmentEditImageUrl(string imageId)
        => _garmentSource is null ? string.Empty : $"/assets/{_garmentSource.AssetId}/images/{imageId}/edit";

    /// <summary>
    /// The edit form produced an image. Nothing about the build's steps is written here: the de-clothe,
    /// crop and enhance steps are recorded from the approved image's lineage when the user approves it in
    /// Panel B. This only keeps Panel B's list current.
    /// </summary>
    private async Task OnGarmentResultAsync(ImageEditResultView result)
    {
        if (_build is null)
        {
            return;
        }

        try
        {
            await RefreshEditedImagesAsync();
            var produced = _editedImages.FirstOrDefault(image =>
                string.Equals(image.Id, result.ImageId, StringComparison.Ordinal));
            if (produced is not null)
            {
                // Keep the shared editor chained to the newest artifact. Crop and Enhance must operate
                // on the completed output of the preceding operation, not silently return to the original
                // Front image when the workspace tab changes.
                _garmentSource = produced;
                _garmentSubject = ImageEditSubject.ForAssetImage(produced.AssetId, produced.Id);
                _garmentReviewDeckUrl = string.IsNullOrWhiteSpace(produced.CandidateBatchId)
                    ? null
                    : $"/review-deck/asset/{produced.CandidateBatchId}";
            }
            _garmentMessage = $"Added {result.ImageId[..8]}… to the edited images. Approve the one you want with \"Use this\".";
        }
        catch (Exception ex)
        {
            _garmentMessage = ex.Message;
        }
    }

    /// <summary>
    /// JSON options for the per-image pipeline record, which writes its enums as names (the writer in
    /// <c>CharacterIdentityBuildService</c> uses the same converter).
    /// </summary>
    private static readonly JsonSerializerOptions PipelineJsonOptions =
        new(JsonSerializerDefaults.Web) { Converters = { new JsonStringEnumConverter() } };
}
