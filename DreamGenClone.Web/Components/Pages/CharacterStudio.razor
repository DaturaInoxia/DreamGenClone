    private async Task<List<SceneAssetImage>> LoadAngleAttemptImagesAsync(
        IEnumerable<CharacterIdentityAngleAttempt> attempts)
    {
        var images = new List<SceneAssetImage>();
        foreach (var attempt in attempts)
        {
            var imageId = attempt.OutputArtifactId;
            if (string.IsNullOrWhiteSpace(imageId))
            {
                continue;
            }

            var image = await AssetService.GetImageAsync(imageId);
            if (image is not null)
            {
                images.Add(image);
            }
        }

        return images;
    }

    private static string AngleLabel(CharacterIdentityAngleView view) => view switch
    {
        CharacterIdentityAngleView.ThreeQuarterLeft => "Three-quarter left",
        CharacterIdentityAngleView.ThreeQuarterRight => "Three-quarter right",
        CharacterIdentityAngleView.ProfileLeft => "Profile left",
        CharacterIdentityAngleView.ProfileRight => "Profile right",
        _ => view.ToString()
    };

    /// <summary>Loads the edited images of the front asset, newest first.</summary>
    private async Task RefreshEditedImagesAsync()
    {
        if (_garmentSource is null)
        {
            _editedImages = [];
            return;
        }

        var images = await AssetService.ListImagesAsync(_garmentSource.AssetId);
        _editedImages = images
            .Where(image => image.Kind == SceneAssetKind.Edited)
            .OrderByDescending(image => image.CreatedUtc)
            .ToList();
    }

    /// <summary>
    /// Deletes one image. The canonical front is refused: the build's steps point at it, and removing it
    /// would leave those steps naming a file that no longer exists.
    /// </summary>
    private async Task DeleteImageAsync(SceneAssetImage image)
    {
        if (IsCanonicalFront(image))
        {
            _frontMessage = "The canonical front cannot be deleted. Choose another image first.";
            return;
        }

        _frontBusy = true;
        _frontMessage = null;
        try
        {
            await AssetService.DeleteImageAsync(image.Id);
            _frontMessage = $"Deleted {image.Id[..8]}….";
            await RefreshFrontAttemptsAsync();
            await RefreshEditedImagesAsync();
        }
        catch (Exception ex)
        {
            _frontMessage = ex.Message;
        }
        finally
        {
            _frontBusy = false;
        }
    }

    private string GarmentEditImageUrl(string imageId)
        => _garmentSource is null ? string.Empty : $"/assets/{_garmentSource.AssetId}/images/{imageId}/edit";

    /// <summary>
    /// The edit form produced an image. Nothing about the build's steps is written here: the de-clothe,
    /// crop and enhance steps are recorded from the approved image's lineage when the user approves it in
    /// Panel B. This only keeps Panel B's list current.
    /// </summary>
    private async Task OnGarmentResultAsync(ImageEditResultView result)
    {
        if (_build is null)
        {
            return;
        }

        try
        {
            await RefreshEditedImagesAsync();
            var produced = _editedImages.FirstOrDefault(image =>
                string.Equals(image.Id, result.ImageId, StringComparison.Ordinal));
            if (produced is not null)
            {
                // Keep the shared editor chained to the newest artifact. Crop and Enhance must operate
                // on the completed output of the preceding operation, not silently return to the original
                // Front image when the workspace tab changes.
                _garmentSource = produced;
                _garmentSubject = ImageEditSubject.ForAssetImage(produced.AssetId, produced.Id);
                _garmentReviewDeckUrl = string.IsNullOrWhiteSpace(produced.CandidateBatchId)
                    ? null
                    : $"/review-deck/asset/{produced.CandidateBatchId}";
            }
            _garmentMessage = $"Added {result.ImageId[..8]}… to the edited images. Approve the one you want with \"Use this\".";
        }
        catch (Exception ex)
        {
            _garmentMessage = ex.Message;
        }
    }

