    private List<(Provider Provider, List<RegisteredModel> Models)> GetFunctionModelDropdown(AppFunction func)
    {
        if (func == AppFunction.RolePlaySceneImage || func == AppFunction.RolePlaySceneImageEditor)
        {
            // Image render function: only image-kind models are valid. Fail-fast at the UI by
            // not offering text models (resolution also enforces this).
            return _enabledModelsDropdown
                .Select(g => (g.Provider, Models: g.Models.Where(m => m.ModelKind == ModelKind.Image).ToList()))
                .Where(g => g.Models.Count > 0)
                .ToList();
        }

            if (func is AppFunction.RolePlaySceneImageEditPromptCompiler or AppFunction.RolePlaySceneImageValidator)
            {
                return _enabledModelsDropdown
                .Select(g => (g.Provider, Models: g.Models.Where(m => m.SupportsImageInput).ToList()))
                .Where(g => g.Models.Count > 0)
                .ToList();
            }

        return _enabledModelsDropdown;
    }

