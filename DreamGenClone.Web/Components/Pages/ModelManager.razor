    private static bool ValidateMultimodalProvider(Provider provider, out string? error)
    {
        error = null;
        var configured = !string.IsNullOrWhiteSpace(provider.LifecycleStrategyIdentifier)
            || !string.IsNullOrWhiteSpace(provider.ReadinessPath)
            || !string.IsNullOrWhiteSpace(provider.ReadinessSuccessContractJson)
            || provider.TransitionTimeoutSeconds.HasValue
            || provider.TransitionMarginSeconds.HasValue
            || provider.MaximumActiveRequests.HasValue
            || provider.QueueCapacity.HasValue
            || !string.IsNullOrWhiteSpace(provider.CredentialReference)
            || !string.IsNullOrWhiteSpace(provider.ServerIdentityPolicyJson)
            || !string.IsNullOrWhiteSpace(provider.AllowedNetworkBoundary);
        if (!configured)
            return true;
        if (string.IsNullOrWhiteSpace(provider.LifecycleStrategyIdentifier)
            || string.IsNullOrWhiteSpace(provider.ReadinessPath)
            || string.IsNullOrWhiteSpace(provider.ReadinessSuccessContractJson)
            || provider.TransitionTimeoutSeconds is null or <= 0
            || provider.TransitionMarginSeconds is null or <= 0
            || provider.MaximumActiveRequests is null or <= 0
            || provider.QueueCapacity is null or <= 0
            || string.IsNullOrWhiteSpace(provider.CredentialReference)
            || string.IsNullOrWhiteSpace(provider.ServerIdentityPolicyJson)
            || string.IsNullOrWhiteSpace(provider.AllowedNetworkBoundary))
        {
            error = "Multimodal runtime configuration requires lifecycle, readiness, transition timing, capacity, credential reference, identity policy, and network boundary values.";
            return false;
        }
        try
        {
            using var readiness = System.Text.Json.JsonDocument.Parse(provider.ReadinessSuccessContractJson);
            using var identity = System.Text.Json.JsonDocument.Parse(provider.ServerIdentityPolicyJson);
            if (readiness.RootElement.ValueKind is not (System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)
                || identity.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                error = "Readiness and server identity policies must be JSON objects or arrays as indicated.";
                return false;
            }
            if (!string.IsNullOrWhiteSpace(provider.ShutdownDrainPolicyJson))
            {
                using var drain = System.Text.Json.JsonDocument.Parse(provider.ShutdownDrainPolicyJson);
                if (drain.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
                {
                    error = "Shutdown / drain policy must be a JSON object.";
                    return false;
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
            error = "Multimodal readiness, identity, and drain policies must contain valid JSON.";
            return false;
        }
        return true;
    }

    private static bool ValidateMultimodalModel(RegisteredModel model, out string? error)
    {
        error = null;
        if (!model.SupportsImageInput)
            return true;
        if (model.MaximumInputImages is null or <= 0
            || model.MaximumInputImageBytes is null or <= 0
            || model.MaximumInputImagePixels is null or <= 0
            || model.MaximumInputImageDimension is null or <= 0
            || model.MaximumResponseBytes is null or <= 0)
        {
            error = "Image-input models require positive image count, byte, pixel, dimension, and response byte limits.";
            return false;
        }
        var mediaTypes = model.AcceptedInputMediaTypes?.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
        if (mediaTypes.Length == 0 || mediaTypes.Any(value => !value.StartsWith("image/", StringComparison.OrdinalIgnoreCase)))
        {
            error = "Image-input models require one or more comma-separated image/* media types.";
            return false;
        }
        return true;
    }

    private static bool ValidateStructuredOutputModel(RegisteredModel model, out string? error)
    {
        error = null;
        if (!Enum.IsDefined(model.StructuredOutputMode))
        {
            error = "Structured output mode is invalid.";
            return false;
        }
        if (model.MaximumContextTokens is <= 0 || model.MaximumOutputTokens is <= 0)
        {
            error = "Configured context and output token limits must be positive.";
            return false;
        }
        if (model.MaximumContextTokens.HasValue
            && model.MaximumOutputTokens.HasValue
            && model.MaximumOutputTokens > model.MaximumContextTokens)
        {
            error = "Maximum output tokens cannot exceed maximum context tokens.";
            return false;
        }
        return true;
    }

    private static bool ValidateImagePromptMetadata(RegisteredModel model, bool requireConfigured, out string? error)
    {
        error = null;
        if (model.ModelKind != ModelKind.Image)
            return true;
        if (SceneImagePromptMetadata.IsCompatible(model.SceneImageModelFamily, model.PromptDialect))
            return true;
        if (!requireConfigured && SceneImagePromptMetadata.IsUnconfigured(model.SceneImageModelFamily, model.PromptDialect))
            return true;

        error = SceneImagePromptMetadata.IsUnconfigured(model.SceneImageModelFamily, model.PromptDialect)
            ? "Scene-image generation models require an image family and prompt dialect. Configure both before assigning this model to RP Scene Image."
            : $"Image family '{model.SceneImageModelFamily}' is incompatible with prompt dialect '{model.PromptDialect}'. Pony requires Pony V6 tags; SDXL / Juggernaut requires SDXL natural language.";
        return false;
    }

