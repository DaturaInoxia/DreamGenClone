@page "/model-manager"
@rendermode InteractiveServer
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Web.Application.ModelManager

@inject ModelManagerFacade Facade
@inject IModelManagerSecretProvider SecretProvider

<PageTitle>Model Manager - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <h1 class="mb-4">Model Manager</h1>

    @if (!string.IsNullOrEmpty(_globalError))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @_globalError
            <button type="button" class="btn-close" @onclick="() => _globalError = null"></button>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════
       SECTION 0: System Health Summary
       ══════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-heart-pulse"></i> System Health</h4>
            <button class="btn btn-outline-primary btn-sm" @onclick="RunHealthChecks" disabled="@_isHealthChecking">
                @if (_isHealthChecking) { <span class="spinner-border spinner-border-sm me-1"></span> }
                else { <i class="bi bi-arrow-clockwise me-1"></i> }
                Re-check All
            </button>
        </div>
        <div class="card-body">
            @if (_healthResults.Count == 0)
            {
                <div class="alert alert-info mb-0">No health check results yet. Click "Re-check All" or restart the application.</div>
            }
            else
            {
                var providerResults = _healthResults.Where(r => r.EntityType == HealthCheckEntityType.Provider).ToList();
                var modelResults = _healthResults.Where(r => r.EntityType == HealthCheckEntityType.Model).ToList();
                var healthyProviders = providerResults.Count(r => r.IsHealthy);
                var healthyModels = modelResults.Count(r => r.IsHealthy);
                var hasFailures = providerResults.Any(r => !r.IsHealthy) || modelResults.Any(r => !r.IsHealthy);

                <div class="d-flex flex-wrap gap-3 mb-3">
                    <span class="badge @(healthyProviders == providerResults.Count ? "bg-success" : "bg-warning text-dark") fs-6">
                        <i class="bi bi-hdd-network me-1"></i> @healthyProviders / @providerResults.Count providers healthy
                    </span>
                    <span class="badge @(healthyModels == modelResults.Count ? "bg-success" : "bg-warning text-dark") fs-6">
                        <i class="bi bi-cpu me-1"></i> @healthyModels / @modelResults.Count models healthy
                    </span>
                </div>

                @if (hasFailures)
                {
                    <div class="alert alert-warning alert-dismissible fade show mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        <strong>@(providerResults.Count(r => !r.IsHealthy) + modelResults.Count(r => !r.IsHealthy)) connectivity issue(s) detected.</strong>
                        Check the details below for failing providers or models.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @foreach (var providerGroup in _healthResults.GroupBy(r => r.ProviderName))
                {
                    var providerResult = providerGroup.FirstOrDefault(r => r.EntityType == HealthCheckEntityType.Provider);
                    var models = providerGroup.Where(r => r.EntityType == HealthCheckEntityType.Model).ToList();

                    <div class="mb-2">
                        <div class="d-flex align-items-center">
                            <i class="bi @(providerResult?.IsHealthy == true ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") me-2"></i>
                            <strong>@providerGroup.Key</strong>
                            <small class="text-muted ms-2">@providerResult?.Message</small>
                            @if (providerResult is not null)
                            {
                                <small class="text-muted ms-auto">@FormatTimestamp(providerResult.CheckedUtc)</small>
                            }
                        </div>

                        @foreach (var model in models)
                        {
                            <div class="d-flex align-items-center ms-4 mt-1">
                                <i class="bi @(model.IsHealthy ? "bi-check-circle text-success" : "bi-x-circle text-danger") me-2"></i>
                                <span>@model.EntityName</span>
                                <small class="text-muted ms-2">@model.Message</small>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       SECTION 1: Providers
       ══════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-hdd-network"></i> Providers</h4>
            <button class="btn btn-sm btn-primary" @onclick="StartAddProvider" disabled="@_isBusy">
                <i class="bi bi-plus-lg"></i> Add Provider
            </button>
        </div>
        <div class="card-body">
            @if (_showProviderForm)
            {
                <div class="card mb-3 border-primary">
                    <div class="card-body">
                        <h5>@(_editingProvider?.CreatedUtc != null && _existingProviderIds.Contains(_editingProvider.Id) ? "Edit Provider" : "Add Provider")</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control @(string.IsNullOrWhiteSpace(_editingProvider?.Name) ? "is-invalid" : "")"
                                       @bind="_editingProvider!.Name" maxlength="100" />
                                <div class="invalid-feedback">Name is required</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Type <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="_editingProviderType">
                                    <option value="0">LM Studio (Local)</option>
                                    <option value="1">Together AI (Cloud)</option>
                                    <option value="2">OpenRouter (Cloud)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Timeout (seconds)</label>
                                <input type="number" class="form-control" @bind="_editingProvider!.TimeoutSeconds" min="1" max="600" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Base URL <span class="text-danger">*</span></label>
                                <input type="url" class="form-control @(string.IsNullOrWhiteSpace(_editingProvider?.BaseUrl) ? "is-invalid" : "")"
                                       @bind="_editingProvider!.BaseUrl" placeholder="http://127.0.0.1:1234" />
                                <div class="invalid-feedback">Valid URL is required</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Chat Completions Path</label>
                                <input type="text" class="form-control" @bind="_editingProvider!.ChatCompletionsPath" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Image Capability</label>
                                <select class="form-select" @bind="_editingProvider!.ImageCapability">
                                    <option value="None">None (text only)</option>
                                    <option value="TextAndImage">Text + Image</option>
                                    <option value="ImageOnly">Image only</option>
                                </select>
                                <div class="form-text">Does this provider expose an image-generation endpoint?</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Image Generation Path</label>
                                <input type="text" class="form-control" @bind="_editingProvider!.ImageGenerationPath" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Image Protocol</label>
                                <select class="form-select" @bind="_editingProvider!.ImageProtocol">
                                    <option value="OpenAiImages">OpenAI Images API</option>
                                    <option value="ComfyUi">ComfyUI (pod HTTP)</option>
                                    <option value="ComfyUiServerless">ComfyUI Serverless (RunPod)</option>
                                </select>
                                <div class="form-text">Wire protocol for image calls. ComfyUI uses /prompt + /history + /view; ComfyUI Serverless uses the RunPod job API (/run + /status, base64 output). Base URL for serverless = https://api.runpod.ai/v2/{endpointId}.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Content Policy</label>
                                <select class="form-select" @bind="_editingProvider!.ContentPolicy">
                                    <option value="Unknown">-- Not configured --</option>
                                    <option value="SfwFiltered">Safe-for-work (filtered)</option>
                                    <option value="AdultAllowed">Adult allowed</option>
                                    <option value="AdultAllowedConfigurable">Adult (configurable)</option>
                                </select>
                                <div class="form-text">Required before this provider can render images. Explicit content is only generated when adult-allowed.</div>
                            </div>
                            <div class="col-12"><hr class="my-1" /><strong>Multimodal Runtime Contract</strong></div>
                            <div class="col-md-4">
                                <label class="form-label">Lifecycle Strategy</label>
                                <select class="form-select" @bind="_editingProvider!.LifecycleStrategyIdentifier">
                                    <option value="">-- Not configured --</option>
                                    <option value="ScheduledSinglePod">Scheduled single pod</option>
                                    <option value="AlwaysOnSeparateProvider">Always-on separate provider</option>
                                    <option value="ManagedDedicatedPod">Managed dedicated pod</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Readiness Path</label>
                                <input type="text" class="form-control" @bind="_editingProvider!.ReadinessPath" placeholder="/v1/models" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Credential Reference</label>
                                <input type="text" class="form-control" @bind="_editingProvider!.CredentialReference" placeholder="runpod:image-vision-qwen-vl-prod" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Transition Timeout (seconds)</label>
                                <input type="number" class="form-control" @bind="_editingProvider!.TransitionTimeoutSeconds" min="1" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Transition Margin (seconds)</label>
                                <input type="number" class="form-control" @bind="_editingProvider!.TransitionMarginSeconds" min="1" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Max Active</label>
                                <input type="number" class="form-control" @bind="_editingProvider!.MaximumActiveRequests" min="1" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Queue Capacity</label>
                                <input type="number" class="form-control" @bind="_editingProvider!.QueueCapacity" min="1" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Readiness Success Contract (JSON)</label>
                                <textarea class="form-control font-monospace" rows="3" @bind="_editingProvider!.ReadinessSuccessContractJson"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Server Identity Policy (JSON)</label>
                                <textarea class="form-control font-monospace" rows="3" @bind="_editingProvider!.ServerIdentityPolicyJson"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Shutdown / Drain Policy (JSON)</label>
                                <textarea class="form-control font-monospace" rows="3" @bind="_editingProvider!.ShutdownDrainPolicyJson"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Allowed Network Boundary</label>
                                <input type="text" class="form-control" @bind="_editingProvider!.AllowedNetworkBoundary" placeholder="Configured private RunPod endpoint" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">API Key</label>
                                <input type="password" class="form-control" @bind="_editingApiKey"
                                       placeholder="@(_existingProviderIds.Contains(_editingProvider!.Id) ? "(unchanged - enter new key to replace)" : "Enter API key")" />
                                <div class="form-text">Required when a credential reference is configured. The key is encrypted before persistence.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" rows="2" @bind="_editingProvider!.Notes" maxlength="1000"
                                          placeholder="e.g., Free tier, rate-limited to 60 RPM, pricing tier, special capabilities..."></textarea>
                                <div class="form-text">Optional. Helps the model analysis understand provider capabilities and constraints.</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_providerFormError))
                        {
                            <div class="text-danger mt-2">@_providerFormError</div>
                        }
                        <div class="mt-3">
                            <button class="btn btn-success me-2" @onclick="SaveProvider" disabled="@_isBusy">
                                @if (_isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Save
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CancelProviderForm">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            @if (_providers.Count == 0 && !_showProviderForm)
            {
                <div class="alert alert-info">No providers configured. Add a provider to get started.</div>
            }

            @foreach (var provider in _providers)
            {
                <div class="card mb-2 @(!provider.IsEnabled ? "border-secondary opacity-75" : "")">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <strong>@provider.Name</strong>
                                <span class="badge ms-2 @(provider.ProviderType switch { ProviderType.LmStudio => "bg-success", ProviderType.TogetherAI => "bg-info", ProviderType.OpenRouter => "bg-warning text-dark", _ => "bg-secondary" })">
                                    @provider.ProviderType
                                </span>
                                @if (!provider.IsEnabled)
                                {
                                    <span class="badge bg-secondary ms-1">Disabled</span>
                                }
                                <br />
                                <small class="text-muted">@provider.BaseUrl — Timeout: @(provider.TimeoutSeconds)s</small>
                                @if (provider.ApiKeyEncrypted is not null)
                                {
                                    <small class="text-muted ms-2">
                                        <i class="bi bi-key"></i> Key: ****
                                    </small>
                                }
                            </div>
                            <div class="d-flex gap-1 flex-wrap">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => TestProvider(provider)" disabled="@_isBusy">
                                    @if (_testingProviderId == provider.Id) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    else { <i class="bi bi-wifi me-1"></i> }
                                    Test
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditProvider(provider)" disabled="@_isBusy">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                <button class="btn @(provider.IsEnabled ? "btn-outline-warning" : "btn-outline-success") btn-sm" @onclick="() => ToggleProvider(provider)" disabled="@_isBusy">
                                    <i class="bi @(provider.IsEnabled ? "bi-toggle-on" : "bi-toggle-off") me-1"></i> @(provider.IsEnabled ? "Disable" : "Enable")
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDeleteProvider(provider)" disabled="@_isBusy">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                        @if (_testResultProviderId == provider.Id && _testResultMessage is not null)
                        {
                            <div class="mt-2 small @(_testResultSuccess ? "text-success" : "text-danger")">
                                <i class="bi @(_testResultSuccess ? "bi-check-circle" : "bi-x-circle")"></i> @_testResultMessage
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       SECTION 2: Models
       ══════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-cpu"></i> Models</h4>
            <button class="btn btn-sm btn-primary" @onclick="StartAddModel" disabled="@(_isBusy || _providers.Count == 0)">
                <i class="bi bi-plus-lg"></i> Add Model
            </button>
        </div>
        <div class="card-body">
            @if (_providers.Count == 0)
            {
                <div class="alert alert-info">Add a provider first before registering models.</div>
            }
            else
            {
                @if (_showModelForm)
                {
                    <div class="card mb-3 border-primary">
                        <div class="card-body">
                            <h5>@(_existingModelIds.Contains(_editingModel!.Id) ? "Edit Model" : "Add Model")</h5>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Provider <span class="text-danger">*</span></label>
                                    <select class="form-select" @bind="_editingModel!.ProviderId">
                                        <option value="">-- Select --</option>
                                        @foreach (var p in _providers)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Model Identifier <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" @bind="_editingModel!.ModelIdentifier" maxlength="200"
                                           placeholder="e.g., Dolphin3.0-Llama3.1-8B" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Display Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" @bind="_editingModel!.DisplayName" maxlength="200" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Model Kind</label>
                                    <select class="form-select" @bind="_editingModel!.ModelKind">
                                        <option value="Text">Text</option>
                                        <option value="Image">Image</option>
                                    </select>
                                    <div class="form-text">Image models are selectable for scene-image rendering.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Supported Image Size</label>
                                    <input type="text" class="form-control" @bind="_editingModel!.ImageSizeSupported"
                                           placeholder="e.g., 1024x1024" />
                                    <div class="form-text">Optional, informational (image models only).</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Thinking Control</label>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" @bind="_editingModel!.SupportsThinkingControl" id="model-thinking-control" />
                                        <label class="form-check-label" for="model-thinking-control">Supported by chat template</label>
                                    </div>
                                    <div class="form-text">Enable only when the provider supports chat_template_kwargs.thinking.</div>
                                </div>
                                <div class="col-12"><hr class="my-1" /><strong>Structured Output Contract</strong></div>
                                <div class="col-md-4">
                                    <label class="form-label">Structured Output Mode</label>
                                    <select class="form-select" @bind="_editingModel!.StructuredOutputMode">
                                        <option value="None">Not supported</option>
                                        <option value="StrictJsonSchema">Strict JSON Schema</option>
                                        <option value="JsonObject">JSON Object</option>
                                    </select>
                                    <div class="form-text">Select the exact response format enforced by this provider/model path.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Maximum Context Tokens</label>
                                    <input type="number" class="form-control" @bind="_editingModel!.MaximumContextTokens" min="1" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Maximum Output Tokens</label>
                                    <input type="number" class="form-control" @bind="_editingModel!.MaximumOutputTokens" min="1" />
                                </div>
                                <div class="col-12"><hr class="my-1" /><strong>Multimodal Input Contract</strong></div>
                                <div class="col-md-3">
                                    <label class="form-label">Image Input</label>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" @bind="_editingModel!.SupportsImageInput" id="model-image-input" />
                                        <label class="form-check-label" for="model-image-input">Accepts source images</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Max Images</label>
                                    <input type="number" class="form-control" @bind="_editingModel!.MaximumInputImages" min="1" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Max Image Bytes</label>
                                    <input type="number" class="form-control" @bind="_editingModel!.MaximumInputImageBytes" min="1" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Max Response Bytes</label>
                                    <input type="number" class="form-control" @bind="_editingModel!.MaximumResponseBytes" min="1" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Max Image Pixels</label>
                                    <input type="number" class="form-control" @bind="_editingModel!.MaximumInputImagePixels" min="1" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Max Image Dimension</label>
                                    <input type="number" class="form-control" @bind="_editingModel!.MaximumInputImageDimension" min="1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Accepted Media Types</label>
                                    <input type="text" class="form-control" @bind="_editingModel!.AcceptedInputMediaTypes" placeholder="image/png,image/jpeg,image/webp" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Runtime Revision</label>
                                    <input type="text" class="form-control" @bind="_editingModel!.RuntimeRevision" placeholder="vllm-0.27.1-python-3.13.2-torch-2.13.0+cu130" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Artifact Revision</label>
                                    <input type="text" class="form-control" @bind="_editingModel!.ArtifactRevision" placeholder="Pinned repository commit" />
                                </div>
                                @if (_editingModel!.ModelKind == ModelKind.Image)
                                {
                                    <div class="col-12"><hr class="my-1" /><strong>Scene Image Compilation</strong></div>
                                    <div class="col-md-6">
                                        <label class="form-label">Image Family</label>
                                        <select class="form-select" @bind="_editingModel.SceneImageModelFamily">
                                            <option value="Unknown">Not configured</option>
                                            <option value="Pony">Pony V6 XL</option>
                                            <option value="Sdxl">SDXL / Juggernaut</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Prompt Dialect</label>
                                        <select class="form-select" @bind="_editingModel.PromptDialect">
                                            <option value="Unknown">Not configured</option>
                                            <option value="PonyV6Tags">Pony V6 tags</option>
                                            <option value="SdxlNaturalLanguage">SDXL natural language</option>
                                        </select>
                                        <div class="form-text">Pony requires Pony V6 tags. SDXL / Juggernaut requires SDXL natural language.</div>
                                    </div>
                                    <div class="col-12"><hr class="my-1" /><strong>Qwen Source-Image Editor Settings</strong></div>
                                    <div class="col-md-4">
                                        <label class="form-label">Diffusion Model</label>
                                        <input type="text" class="form-control" @bind="_editingModel.ImageEditorDiffusionModel" placeholder="qwen_image_edit_2511_fp8mixed.safetensors" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Text Encoder</label>
                                        <input type="text" class="form-control" @bind="_editingModel.ImageEditorTextEncoder" placeholder="qwen_2.5_vl_7b_fp8_scaled.safetensors" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">VAE</label>
                                        <input type="text" class="form-control" @bind="_editingModel.ImageEditorVae" placeholder="qwen_image_vae.safetensors" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Steps</label>
                                        <input type="number" class="form-control" @bind="_editingModel.ImageEditorSteps" min="1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">CFG</label>
                                        <input type="number" class="form-control" @bind="_editingModel.ImageEditorCfg" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Sampler</label>
                                        <input type="text" class="form-control" @bind="_editingModel.ImageEditorSampler" placeholder="euler" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Scheduler</label>
                                        <input type="text" class="form-control" @bind="_editingModel.ImageEditorScheduler" placeholder="simple" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Denoise</label>
                                        <input type="number" class="form-control" @bind="_editingModel.ImageEditorDenoise" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">AuraFlow Shift</label>
                                        <input type="number" class="form-control" @bind="_editingModel.ImageEditorAuraFlowShift" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">CFGNorm Strength</label>
                                        <input type="number" class="form-control" @bind="_editingModel.ImageEditorCfgNormStrength" min="0" step="0.1" />
                                    </div>
                                    <div class="col-12"><div class="form-text">Required only when this image model is assigned to RP Scene Image Editor. Missing values fail explicitly when an edit is requested.</div></div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_modelFormError))
                            {
                                <div class="text-danger mt-2">@_modelFormError</div>
                            }
                            <div class="mt-3">
                                <button class="btn btn-success me-2" @onclick="SaveModel" disabled="@_isBusy">Save</button>
                                <button class="btn btn-outline-secondary" @onclick="() => _showModelForm = false">Cancel</button>
                            </div>
                        </div>
                    </div>
                }

                @if (_showModelDetails && _detailsModel is not null)
                {
                    <ModelDetailsEditor Model="_detailsModel" OnSaved="OnModelDetailsSaved" OnCancelled="OnModelDetailsCancelled" />
                }

                @foreach (var group in _modelsGrouped)
                {
                    <h6 class="mt-3">
                        <i class="bi bi-hdd-network"></i> @group.Key.Name
                        @if (!group.Key.IsEnabled) { <span class="badge bg-secondary">Disabled</span> }
                    </h6>
                    @if (group.Value.Count == 0)
                    {
                        <p class="text-muted small ms-3">No models registered.</p>
                    }
                    @foreach (var model in group.Value)
                    {
                        <div class="card mb-1 ms-3 @(!model.IsEnabled ? "border-secondary opacity-75" : "")">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <strong>@model.DisplayName</strong>
                                        @if (!model.IsEnabled) { <span class="badge bg-secondary ms-1">Disabled</span> }
                                        <br />
                                        <small class="text-muted font-monospace">@model.ModelIdentifier</small>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => TestModel(model)" disabled="@_isBusy">
                                            @if (_testingModelId == model.Id) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            else { <i class="bi bi-wifi me-1"></i> }
                                            Test
                                        </button>
                                        <button class="btn btn-outline-info btn-sm" @onclick="() => OpenModelDetails(model)" disabled="@_isBusy">
                                            <i class="bi bi-card-text me-1"></i> Details
                                        </button>
                                        <button class="btn @(model.IsEnabled ? "btn-outline-warning" : "btn-outline-success") btn-sm" @onclick="() => ToggleModel(model)" disabled="@_isBusy">
                                            <i class="bi @(model.IsEnabled ? "bi-toggle-on" : "bi-toggle-off") me-1"></i> @(model.IsEnabled ? "Disable" : "Enable")
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDeleteModel(model)" disabled="@_isBusy">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </div>
                                </div>
                                @if (_testResultModelId == model.Id && _testResultModelMessage is not null)
                                {
                                    <div class="mt-2 small @(_testResultModelSuccess ? "text-success" : "text-danger")">
                                        <i class="bi @(_testResultModelSuccess ? "bi-check-circle" : "bi-x-circle")"></i> @_testResultModelMessage
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       SECTION 3: Function Defaults
       ══════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0"><i class="bi bi-gear"></i> Function Defaults</h4>
        </div>
        <div class="card-body">
            @if (_functionStates.TryGetValue(AppFunction.RolePlaySceneImage, out var _imageFnState) && string.IsNullOrEmpty(_imageFnState.ModelId))
            {
                <div class="alert alert-warning">
                    <i class="bi bi-image me-1"></i>
                    No image model configured for scene-image rendering. Assign an image-kind model to <strong>RP Scene Image (Render)</strong> to enable image generation.
                </div>
            }
            @if (_enabledModelsDropdown.Count == 0)
            {
                <div class="alert alert-info">Register and enable a model first to assign function defaults.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Function</th>
                                <th>Model</th>
                                <th style="width:120px">Temperature</th>
                                <th style="width:100px">Top P</th>
                                <th style="width:100px">Max Tokens</th>
                                <th style="width:120px">Thinking</th>
                                <th style="width:100px">Max Parallel</th>
                                <th style="width:80px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (func, fd) in _functionDefaults)
                            {
                                var state = GetFunctionState(func);
                                <tr>
                                    <td>
                                        <strong>@FormatFunctionName(func)</strong>
                                        @if ((func == AppFunction.RolePlaySemanticAnalysis
                                            || func == AppFunction.RolePlaySceneBeatAnalyzer
                                            || func == AppFunction.RolePlaySceneImage
                                            || func == AppFunction.RolePlaySceneImagePreprocessor
                                            || func == AppFunction.RolePlaySceneImageEditor
                                            || func == AppFunction.RolePlaySceneImageEditPromptCompiler
                                            || func == AppFunction.RolePlaySceneImageValidator)
                                            && string.IsNullOrEmpty(state.ModelId))
                                        {
                                            <span class="badge bg-warning text-dark ms-1">No model</span>
                                        }
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm" value="@state.ModelId" @onchange="e => OnFunctionModelChange(func, e)">
                                            <option value="">-- Not Assigned --</option>
                                            @foreach (var group in GetFunctionModelDropdown(func))
                                            {
                                                <optgroup label="@group.Provider.Name">
                                                    @foreach (var m in group.Models)
                                                    {
                                                        <option value="@m.Id">@m.DisplayName</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" step="0.1" min="0" max="2"
                                               value="@state.Temperature" @onchange="e => state.Temperature = ParseDouble(e, 0.7)" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" step="0.05" min="0" max="1"
                                               value="@state.TopP" @onchange="e => state.TopP = ParseDouble(e, 0.9)" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" min="1" max="16000"
                                               value="@state.MaxTokens" @onchange="e => state.MaxTokens = ParseInt(e, 500)" />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm" value="@state.ThinkingMode" @onchange="e => state.ThinkingMode = ParseThinkingMode(e)">
                                            <option value="Default">Default (omit)</option>
                                            <option value="Enabled">Enabled</option>
                                            <option value="Disabled">Disabled</option>
                                        </select>
                                    </td>
                                    <td>
                                        @if (func is AppFunction.RolePlaySemanticAnalysis or AppFunction.RolePlaySceneBeatAnalyzer)
                                        {
                                            <input type="number" class="form-control form-control-sm" min="1" max="16"
                                                   value="@state.MaxConcurrentJobs" @onchange="e => state.MaxConcurrentJobs = ParseNullableInt(e)" />
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => SaveFunctionDefault(func)" disabled="@_isBusy">
                                            <i class="bi bi-check-lg me-1"></i> Save
                                        </button>
                                        @if (func is AppFunction.RolePlaySemanticAnalysis or AppFunction.RolePlaySceneBeatAnalyzer && state.HasBeenSaved)
                                        {
                                            <div class="form-text text-muted mt-1" style="font-size:0.75em">Restart app to apply concurrency changes.</div>
                                        }
                                    </td>
                                </tr>
                                @if (func == AppFunction.RolePlaySceneBeatAnalyzer)
                                {
                                    <tr>
                                        <td colspan="8" class="border-top-0 pt-0 pb-3">
                                            <div class="row g-2 ms-1">
                                                <div class="col-md-2">
                                                    <label class="form-label small">Lease Seconds</label>
                                                    <input type="number" class="form-control form-control-sm" min="1" max="3600"
                                                           value="@state.DurableJobLeaseSeconds" @onchange="e => state.DurableJobLeaseSeconds = ParseNullableInt(e)" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label small">Poll Milliseconds</label>
                                                    <input type="number" class="form-control form-control-sm" min="10" max="60000"
                                                           value="@state.DurableJobPollIntervalMilliseconds" @onchange="e => state.DurableJobPollIntervalMilliseconds = ParseNullableInt(e)" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label small">Retry Count</label>
                                                    <input type="number" class="form-control form-control-sm" min="0" max="10"
                                                           value="@state.TransientRetryCount" @onchange="e => state.TransientRetryCount = ParseNullableInt(e)" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small">Retry Delays Seconds (JSON)</label>
                                                    <input type="text" class="form-control form-control-sm font-monospace"
                                                           value="@state.TransientRetryDelaysSecondsJson" @onchange="e => state.TransientRetryDelaysSecondsJson = e.Value?.ToString()" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label small">Diagnostics Retention Days</label>
                                                    <input type="number" class="form-control form-control-sm" min="1" max="3650"
                                                           value="@state.DiagnosticsRetentionDays" @onchange="e => state.DiagnosticsRetentionDays = ParseNullableInt(e)" />
                                                </div>
                                                <div class="col-md-1">
                                                    <label class="form-label small">Max Beats</label>
                                                    <input type="number" class="form-control form-control-sm" min="1" max="12"
                                                           value="@state.MaximumCatalogueEntries" @onchange="e => state.MaximumCatalogueEntries = ParseNullableInt(e)" />
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(state.ValidationError))
                                                {
                                                    <div class="col-12 text-danger small">@state.ValidationError</div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* Delete Confirmation Modal *@
    @if (_showDeleteConfirmation)
    {
        <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                    </div>
                    <div class="modal-body">
                        <p>@_deleteConfirmMessage</p>
                        @if (_deleteDependentWarning is not null)
                        {
                            <div class="alert alert-warning">@_deleteDependentWarning</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button class="btn btn-danger" @onclick="ExecuteDelete" disabled="@_isBusy">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Provider> _providers = [];
    private Dictionary<Provider, List<RegisteredModel>> _modelsGrouped = [];
    private List<(AppFunction Function, FunctionModelDefault? Default)> _functionDefaults = [];
    private List<(Provider Provider, List<RegisteredModel> Models)> _enabledModelsDropdown = [];
    private List<HealthCheckResult> _healthResults = [];

    private bool _isBusy;
    private bool _isHealthChecking;
    private string? _globalError;

    // Provider form state
    private bool _showProviderForm;
    private Provider? _editingProvider;
    private int _editingProviderType;
    private string? _editingApiKey;
    private string? _providerFormError;
    private HashSet<string> _existingProviderIds = [];

    // Provider test state
    private string? _testingProviderId;
    private string? _testResultProviderId;
    private bool _testResultSuccess;
    private string? _testResultMessage;

    // Model test state
    private string? _testingModelId;
    private string? _testResultModelId;
    private bool _testResultModelSuccess;
    private string? _testResultModelMessage;

    // Model details state
    private RegisteredModel? _detailsModel;
    private bool _showModelDetails;

    // Model form state
    private bool _showModelForm;
    private RegisteredModel? _editingModel;
    private string? _modelFormError;
    private HashSet<string> _existingModelIds = [];

    // Function default edit state
    private Dictionary<AppFunction, FunctionEditState> _functionStates = [];

    // Delete confirmation state
    private bool _showDeleteConfirmation;
    private string? _deleteConfirmMessage;
    private string? _deleteDependentWarning;
    private Func<Task>? _deleteAction;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            _providers = await Facade.GetAllProvidersAsync();
            _existingProviderIds = _providers.Select(p => p.Id).ToHashSet();

            _modelsGrouped = await Facade.GetAllModelsGroupedByProviderAsync();
            _existingModelIds = _modelsGrouped.Values.SelectMany(m => m).Select(m => m.Id).ToHashSet();

            _functionDefaults = await Facade.GetAllFunctionDefaultsAsync();
            _enabledModelsDropdown = await Facade.GetEnabledModelsForDropdownAsync();

            _healthResults = await Facade.GetHealthCheckSummaryAsync();

            // Initialize function edit states
            _functionStates.Clear();
            foreach (var (func, fd) in _functionDefaults)
            {
                _functionStates[func] = new FunctionEditState
                {
                    ModelId = fd?.ModelId ?? "",
                    Temperature = fd?.Temperature ?? 0.7,
                    TopP = fd?.TopP ?? 0.9,
                    MaxTokens = fd?.MaxTokens ?? 500,
                    ThinkingMode = fd?.ThinkingMode ?? ThinkingMode.Default,
                    MaxConcurrentJobs = fd?.MaxConcurrentJobs,
                    DurableJobLeaseSeconds = fd?.DurableJobLeaseSeconds,
                    DurableJobPollIntervalMilliseconds = fd?.DurableJobPollIntervalMilliseconds,
                    TransientRetryCount = fd?.TransientRetryCount,
                    TransientRetryDelaysSecondsJson = fd?.TransientRetryDelaysSecondsJson,
                    DiagnosticsRetentionDays = fd?.DiagnosticsRetentionDays,
                    MaximumCatalogueEntries = fd?.MaximumCatalogueEntries,
                    HasBeenSaved = fd is not null,
                    ExistingId = fd?.Id
                };
            }
        }
        catch (Exception ex)
        {
            _globalError = $"Failed to load data: {ex.Message}";
        }
    }

    private async Task RunHealthChecks()
    {
        _isHealthChecking = true;
        StateHasChanged();
        try
        {
            _healthResults = await Facade.RunAllHealthChecksAsync();
        }
        catch (Exception ex)
        {
            _globalError = $"Health check failed: {ex.Message}";
        }
        finally
        {
            _isHealthChecking = false;
        }
    }

    // === Provider methods ===

    private void StartAddProvider()
    {
        _editingProvider = new Provider();
        _editingProviderType = 0;
        _editingApiKey = null;
        _providerFormError = null;
        _showProviderForm = true;
    }

    private void EditProvider(Provider provider)
    {
        _editingProvider = new Provider
        {
            Id = provider.Id,
            Name = provider.Name,
            ProviderType = provider.ProviderType,
            BaseUrl = provider.BaseUrl,
            ChatCompletionsPath = provider.ChatCompletionsPath,
            ImageCapability = provider.ImageCapability,
            ImageGenerationPath = provider.ImageGenerationPath,
            ContentPolicy = provider.ContentPolicy,
            ImageProtocol = provider.ImageProtocol,
            TimeoutSeconds = provider.TimeoutSeconds,
            LifecycleStrategyIdentifier = provider.LifecycleStrategyIdentifier,
            ReadinessPath = provider.ReadinessPath,
            ReadinessSuccessContractJson = provider.ReadinessSuccessContractJson,
            TransitionTimeoutSeconds = provider.TransitionTimeoutSeconds,
            TransitionMarginSeconds = provider.TransitionMarginSeconds,
            ShutdownDrainPolicyJson = provider.ShutdownDrainPolicyJson,
            MaximumActiveRequests = provider.MaximumActiveRequests,
            QueueCapacity = provider.QueueCapacity,
            CredentialReference = provider.CredentialReference,
            ServerIdentityPolicyJson = provider.ServerIdentityPolicyJson,
            AllowedNetworkBoundary = provider.AllowedNetworkBoundary,
            ApiKeyEncrypted = provider.ApiKeyEncrypted,
            IsEnabled = provider.IsEnabled,
            CreatedUtc = provider.CreatedUtc,
            UpdatedUtc = provider.UpdatedUtc,
            Notes = provider.Notes
        };
        _editingProviderType = (int)provider.ProviderType;
        _editingApiKey = null;
        _providerFormError = null;
        _showProviderForm = true;
    }

    private void CancelProviderForm()
    {
        _showProviderForm = false;
        _editingProvider = null;
        _providerFormError = null;
    }

    private async Task SaveProvider()
    {
        if (_editingProvider is null) return;

        _editingProvider.ProviderType = (ProviderType)_editingProviderType;

        // Validation
        if (string.IsNullOrWhiteSpace(_editingProvider.Name))
        {
            _providerFormError = "Name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingProvider.BaseUrl) || !Uri.TryCreate(_editingProvider.BaseUrl, UriKind.Absolute, out _))
        {
            _providerFormError = "A valid URL is required.";
            return;
        }
        if (_editingProvider.TimeoutSeconds < 1 || _editingProvider.TimeoutSeconds > 600)
        {
            _providerFormError = "Timeout must be between 1 and 600 seconds.";
            return;
        }
        // A blank API key is allowed when a matching local secret resolves from the git-ignored
        // appsettings.Local.json (ModelManagerSecrets) — by CredentialReference, then provider name,
        // then the default "RunPod" entry. The runtime falls back to that secret for serverless
        // providers, so operators can keep instance keys out of git and out of the DB.
        var localSecretAvailable = !string.IsNullOrWhiteSpace(
            SecretProvider.Resolve(_editingProvider.CredentialReference)
            ?? SecretProvider.Resolve(_editingProvider.Name)
            ?? SecretProvider.Resolve("RunPod"));

        if (_editingProviderType != 0
            && string.IsNullOrEmpty(_editingApiKey)
            && !_existingProviderIds.Contains(_editingProvider.Id)
            && !localSecretAvailable)
        {
            _providerFormError = "API key is required for cloud providers (or provide a local secret in appsettings.Local.json matching the Credential Reference).";
            return;
        }
        if (!string.IsNullOrWhiteSpace(_editingProvider.CredentialReference)
            && string.IsNullOrEmpty(_editingApiKey)
            && string.IsNullOrWhiteSpace(_editingProvider.ApiKeyEncrypted)
            && !localSecretAvailable)
        {
            _providerFormError = "An API key is required when a credential reference is configured (or provide a matching local secret in appsettings.Local.json).";
            return;
        }
        if (!ValidateMultimodalProvider(_editingProvider, out var multimodalError))
        {
            _providerFormError = multimodalError;
            return;
        }
        if (_editingProvider.ImageCapability != ImageProviderCapability.None && _editingProvider.ContentPolicy == ImageContentPolicy.Unknown)
        {
            _providerFormError = "An image-capable provider requires an explicit content policy (safe-for-work or adult-allowed).";
            return;
        }

        _isBusy = true;
        _providerFormError = null;
        try
        {
            await Facade.SaveProviderAsync(_editingProvider, _editingApiKey);
            _showProviderForm = false;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _providerFormError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task TestProvider(Provider provider)
    {
        _testingProviderId = provider.Id;
        _testResultProviderId = null;
        _testResultMessage = null;
        _isBusy = true;
        StateHasChanged();

        try
        {
            var (success, message) = await Facade.TestProviderConnectionAsync(provider);
            _testResultProviderId = provider.Id;
            _testResultSuccess = success;
            _testResultMessage = message;
        }
        catch (Exception ex)
        {
            _testResultProviderId = provider.Id;
            _testResultSuccess = false;
            _testResultMessage = $"Test failed: {ex.Message}";
        }
        finally
        {
            _testingProviderId = null;
            _isBusy = false;
        }
    }

    private async Task ToggleProvider(Provider provider)
    {
        _isBusy = true;
        try
        {
            await Facade.EnableDisableProviderAsync(provider.Id, !provider.IsEnabled);
            await LoadAllDataAsync();
        }
        finally { _isBusy = false; }
    }

    private Task ConfirmDeleteProvider(Provider provider)
    {
        var models = _modelsGrouped.GetValueOrDefault(provider) ?? [];
        _deleteConfirmMessage = $"Delete provider '{provider.Name}'?";
        _deleteDependentWarning = models.Count > 0
            ? $"This will also delete {models.Count} registered model(s) and clear any associated function defaults."
            : null;
        _deleteAction = async () =>
        {
            await Facade.DeleteProviderAsync(provider.Id);
            await LoadAllDataAsync();
        };
        _showDeleteConfirmation = true;
        return Task.CompletedTask;
    }

    // === Model methods ===

    private void StartAddModel()
    {
        _editingModel = new RegisteredModel();
        _modelFormError = null;
        _showModelForm = true;
    }

    private void EditModel(RegisteredModel model)
    {
        _editingModel = new RegisteredModel
        {
            Id = model.Id,
            ProviderId = model.ProviderId,
            ModelIdentifier = model.ModelIdentifier,
            DisplayName = model.DisplayName,
            IsEnabled = model.IsEnabled,
            SupportsThinkingControl = model.SupportsThinkingControl,
            StructuredOutputMode = model.StructuredOutputMode,
            MaximumContextTokens = model.MaximumContextTokens,
            MaximumOutputTokens = model.MaximumOutputTokens,
            ModelKind = model.ModelKind,
            ImageSizeSupported = model.ImageSizeSupported,
            SceneImageModelFamily = model.SceneImageModelFamily,
            PromptDialect = model.PromptDialect,
            SupportsImageInput = model.SupportsImageInput,
            MaximumInputImages = model.MaximumInputImages,
            MaximumInputImageBytes = model.MaximumInputImageBytes,
            MaximumInputImagePixels = model.MaximumInputImagePixels,
            MaximumInputImageDimension = model.MaximumInputImageDimension,
            AcceptedInputMediaTypes = model.AcceptedInputMediaTypes,
            MaximumResponseBytes = model.MaximumResponseBytes,
            RuntimeRevision = model.RuntimeRevision,
            ArtifactRevision = model.ArtifactRevision,
            ImageEditorDiffusionModel = model.ImageEditorDiffusionModel,
            ImageEditorTextEncoder = model.ImageEditorTextEncoder,
            ImageEditorVae = model.ImageEditorVae,
            ImageEditorSteps = model.ImageEditorSteps,
            ImageEditorCfg = model.ImageEditorCfg,
            ImageEditorSampler = model.ImageEditorSampler,
            ImageEditorScheduler = model.ImageEditorScheduler,
            ImageEditorDenoise = model.ImageEditorDenoise,
            ImageEditorAuraFlowShift = model.ImageEditorAuraFlowShift,
            ImageEditorCfgNormStrength = model.ImageEditorCfgNormStrength,
            CreatedUtc = model.CreatedUtc
        };
        _modelFormError = null;
        _showModelForm = true;
    }

    private async Task SaveModel()
    {
        if (_editingModel is null) return;

        if (string.IsNullOrWhiteSpace(_editingModel.ProviderId))
        {
            _modelFormError = "Provider is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingModel.ModelIdentifier))
        {
            _modelFormError = "Model identifier is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingModel.DisplayName))
        {
            _modelFormError = "Display name is required.";
            return;
        }
        if (!ValidateMultimodalModel(_editingModel, out var multimodalError))
        {
            _modelFormError = multimodalError;
            return;
        }
        if (!ValidateStructuredOutputModel(_editingModel, out var structuredOutputError))
        {
            _modelFormError = structuredOutputError;
            return;
        }
        if (!ValidateImagePromptMetadata(_editingModel, requireConfigured: false, out var imagePromptError))
        {
            _modelFormError = imagePromptError;
            return;
        }

        _isBusy = true;
        _modelFormError = null;
        try
        {
            await Facade.SaveModelAsync(_editingModel);
            _showModelForm = false;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _modelFormError = $"Save failed: {ex.Message}";
        }
        finally { _isBusy = false; }
    }

