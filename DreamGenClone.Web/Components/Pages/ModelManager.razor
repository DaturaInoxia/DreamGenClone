    {
        _isBusy = true;
        try
        {
            await Facade.EnableDisableModelAsync(model.Id, !model.IsEnabled);
            await LoadAllDataAsync();
        }
        finally { _isBusy = false; }
    }

    private async Task TestModel(RegisteredModel model)
    {
        _testingModelId = model.Id;
        _testResultModelId = null;
        _testResultModelMessage = null;
        _isBusy = true;
        StateHasChanged();

        try
        {
            var (success, message) = await Facade.TestModelConnectionAsync(model);
            _testResultModelId = model.Id;
            _testResultModelSuccess = success;
            _testResultModelMessage = message;
        }
        catch (Exception ex)
        {
            _testResultModelId = model.Id;
            _testResultModelSuccess = false;
            _testResultModelMessage = $"Test failed: {ex.Message}";
        }
        finally
        {
            _testingModelId = null;
            _isBusy = false;
        }
    }

