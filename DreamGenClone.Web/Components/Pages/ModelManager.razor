    }

    // === Function Default methods ===

    private FunctionEditState GetFunctionState(AppFunction func)
    {
        return _functionStates.GetValueOrDefault(func) ?? new FunctionEditState();
    }

    private void OnFunctionModelChange(AppFunction func, ChangeEventArgs e)
    {
        var state = GetFunctionState(func);
        state.ModelId = e.Value?.ToString() ?? "";
    }

    private async Task SaveFunctionDefault(AppFunction func)
    {
        var state = GetFunctionState(func);

        if (string.IsNullOrEmpty(state.ModelId))
        {
            // Clear the function default
            await Facade.ClearFunctionDefaultAsync(func);
            await LoadAllDataAsync();
            return;
        }

        if (func == AppFunction.RolePlaySceneImage)
        {
            var selectedModel = _modelsGrouped.Values.SelectMany(models => models)
                .SingleOrDefault(model => model.Id == state.ModelId);
            string? imagePromptError = null;
            if (selectedModel is null || !ValidateImagePromptMetadata(selectedModel, requireConfigured: true, out imagePromptError))
            {
                state.ValidationError = imagePromptError ?? "The selected scene-image model could not be loaded.";
                return;
            }
        }

        if (func != AppFunction.RolePlaySceneBeatAnalyzer)
        {
            state.Temperature = Math.Clamp(state.Temperature, 0.0, 2.0);
            state.TopP = Math.Clamp(state.TopP, 0.0, 1.0);
            state.MaxTokens = Math.Clamp(state.MaxTokens, 1, 16000);
            if (state.MaxConcurrentJobs.HasValue)
                state.MaxConcurrentJobs = Math.Clamp(state.MaxConcurrentJobs.Value, 1, 16);
        }

        _isBusy = true;
        try
        {
            var fd = new FunctionModelDefault
            {
                Id = state.ExistingId ?? Guid.NewGuid().ToString(),
                FunctionName = func.ToString(),
                ModelId = state.ModelId,
                Temperature = state.Temperature,
                TopP = state.TopP,
                MaxTokens = state.MaxTokens,
                ThinkingMode = state.ThinkingMode,
                MaxConcurrentJobs = state.MaxConcurrentJobs,
                DurableJobLeaseSeconds = state.DurableJobLeaseSeconds,
                DurableJobPollIntervalMilliseconds = state.DurableJobPollIntervalMilliseconds,
                TransientRetryCount = state.TransientRetryCount,
                TransientRetryDelaysSecondsJson = state.TransientRetryDelaysSecondsJson,
                DiagnosticsRetentionDays = state.DiagnosticsRetentionDays,
                MaximumCatalogueEntries = state.MaximumCatalogueEntries
            };
            state.ValidationError = fd.ValidateSceneBeatAnalyzerConfiguration();
            if (state.ValidationError is not null)
                return;

            await Facade.SaveFunctionDefaultAsync(fd);
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _globalError = $"Failed to save function default: {ex.Message}";
        }
        finally { _isBusy = false; }
    }

    // === Delete confirmation ===

    private void CancelDelete()
    {
        _showDeleteConfirmation = false;
        _deleteAction = null;
    }

    private async Task ExecuteDelete()
    {
        _isBusy = true;
        _showDeleteConfirmation = false;
        try
        {
            if (_deleteAction is not null)
                await _deleteAction();
        }
        catch (Exception ex)
        {
            _globalError = $"Delete failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            _deleteAction = null;
        }
    }

