    private async Task CreateOrLoadProductionAsync()
    {
        if (!IsSelectedMomentEnriched
            || _catalogue is null
            || _selectedCatalogueBeat is null
            || _productionPlan?.Status != SceneBeatCatalogueStatus.Complete
            || _momentSet?.Status != SceneBeatCatalogueStatus.Complete
            || _selectedMoment is null
            || _momentEnrichment is null
            || string.IsNullOrWhiteSpace(_productionPov))
        {
            throw new InvalidOperationException("Exact completed Catalogue, Beat Production Plan, Moment Set, Moment enrichment, and production POV are required.");
        }

        await RunAsync(async () =>
        {
            _productionGroup = await ProductionService.GetOrCreateGroupAsync(new(
                sessionId,
                interactionId,
                _catalogue.Id,
                _selectedCatalogueBeat.BeatId,
                _productionPlan.Id,
                _productionPlan.Version,
                _momentSet.Id,
                _momentSet.Version,
                _selectedMoment.MomentId,
                _momentEnrichment.Id,
                _momentEnrichment.Revision,
                _productionPov,
                null));
            _compiledMediaBrief = await ProductionService.GetOrCreateStillBriefAsync(_productionGroup.Id);
