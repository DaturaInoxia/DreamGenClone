    private async Task ContinueFromImageAsync(SceneImageRecord image)
    {
        await RunAsync(async () =>
        {
            _continueFromImageId = image.Id;

            // Restore the prompt that produced this image.
            if (!string.IsNullOrWhiteSpace(image.PromptSnapshot))
            {
                _editablePrompt = image.PromptSnapshot;
            }

            // Restore the exact settings that produced this image.
            if (!string.IsNullOrWhiteSpace(image.SettingsJson) && image.SettingsJson != "{}")
            {
                try
                {
                    var restored = JsonSerializer.Deserialize<SceneImageStudioSettings>(image.SettingsJson);
                    if (restored is not null)
                    {
                        _settings = restored;
                        SyncAngleFromSettings();
                    }
                }
                catch (JsonException ex)
                {
                    Logger.LogWarning(ex, "Failed to restore settings from image {ImageId}; keeping current settings.", image.Id);
                }
            }

            // Restore the beat + POV that produced this image (CR-006 P5).
            if (!string.IsNullOrWhiteSpace(image.BeatId))
            {
                _selectedBeatId = image.BeatId;
            }
            if (!string.IsNullOrWhiteSpace(image.Pov))
            {
                _selectedPov = image.Pov;
            }

            _statusMessage = "Loaded prompt + settings from the selected image. Edit and render to continue from it.";
        });
    }

