    private Task RegenerateProductionCompositionAsync(SceneImageRecord source)
    {
        if (source.Status != SceneImageStatus.Complete
            || source.ProductionStage != SceneImageProductionStage.Composition)
        {
            throw new InvalidOperationException("Production regeneration requires a completed Composition attempt.");
        }
        return EnqueueProductionCompositionAsync(source.Id);
    }

    private async Task EnqueueProductionCompositionAsync(string? regenerateOfId)
    {
        if (_productionGroup is null
            || _compiledMediaBrief is null
            || _activePrompt?.Status != SceneImagePromptStatus.Complete
            || string.IsNullOrWhiteSpace(_editablePrompt)
            || string.IsNullOrWhiteSpace(_productionPov))
        {
            throw new InvalidOperationException("A production group and completed nonblank prompt are required for Composition.");
        }
        EnsureProductionGroupMatchesSelection(_productionGroup);
        if (!string.Equals(_activePrompt.ProductionGroupId, _productionGroup.Id, StringComparison.Ordinal)
            || !string.Equals(_activePrompt.CompiledMediaBriefId, _compiledMediaBrief.Id, StringComparison.Ordinal))
            throw new InvalidOperationException("The active prompt does not belong to the exact production group and compiled Still brief.");

        await RunAsync(async () =>
        {
            await ImageService.UpdatePromptOutputAsync(sessionId, _activePrompt.Id, _editablePrompt.Trim());
            var record = await ImageService.EnqueueRenderAsync(new SceneRenderRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                PromptRecordId = _activePrompt.Id,
                Prompt = _editablePrompt.Trim(),
                ImageSize = _settings.ImageSize,
                RequestedModelId = _selectedProductionModelId,
                SettingsJson = JsonSerializer.Serialize(_settings),
                RegenerateOfId = regenerateOfId,
                ProductionGroupId = _productionGroup.Id,
                CompiledMediaBriefId = _activePrompt.CompiledMediaBriefId,
                BeatId = _productionGroup.BeatId,
                Pov = _productionGroup.Pov
            });
            await LoadProductionGroupAsync();
            _selectedProductionAttemptId = record.Id;
            _statusMessage = regenerateOfId is null
                ? "Production Composition queued."
                : "Sibling Production Composition queued.";
            EnsurePolling();
        });
    }

    private async Task GenerateProductionCompositionWithIdentityAsync()
    {
        if (_productionGroup is null
            || _compiledMediaBrief is null
            || _activePrompt?.Status != SceneImagePromptStatus.Complete
            || string.IsNullOrWhiteSpace(_editablePrompt)
            || string.IsNullOrWhiteSpace(_productionPov))
        {
            throw new InvalidOperationException("A production group and completed nonblank prompt are required for Composition.");
        }
        var selected = _productionIdentityPacks.Where(o => o.Selected).ToList();
        if (selected.Count == 0)
            throw new InvalidOperationException("Select at least one approved identity pack for one-pass identity Composition.");
        EnsureProductionGroupMatchesSelection(_productionGroup);

        await RunAsync(async () =>
        {
