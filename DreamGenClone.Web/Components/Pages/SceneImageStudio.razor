    private string? _lastLoadedInteractionId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Reload on the initial render and whenever the route's interaction changes (e.g. when
        // navigating between turns from the Story arc "Open in Studio"), so the studio always
        // reflects the requested interaction and its turn stays pinned in the Story arc.
        if (firstRender || !string.Equals(_lastLoadedInteractionId, interactionId, StringComparison.OrdinalIgnoreCase))
        {
            _lastLoadedInteractionId = interactionId;
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _errorMessage = string.Empty;
        try
        {
            _session = await SessionService.LoadRolePlaySessionAsync(sessionId);
            if (_session is null)
            {
                _errorMessage = "Role-play session not found.";
                return;
            }

            _interaction = _session.Interactions.FirstOrDefault(x => string.Equals(x.Id, interactionId, StringComparison.OrdinalIgnoreCase));
            if (_interaction is null)
            {
                _errorMessage = "Interaction not found in this session.";
                return;
            }

            if (!_settingsSeeded)
            {
                SeedSettingsFromWorkspace();
                _settingsSeeded = true;
            }

            await LoadIntensityProfilesAsync();
            await ResolvePolicyAsync();
            await LoadFullTurnContextAsync();
            await LoadStoryArcAsync();
            await LoadCatalogueAsync();
            await RefreshAsync();
            await LoadBeatAnalysisAsync();
            await LoadIdentityPackOptionsAsync();
            LoadProductionIdentityPackOptionsAsync();
            await LoadModelChoicesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load image studio: {ex.Message}";
            Logger.LogError(ex, "SceneImageStudio load failed: SessionId={SessionId}, InteractionId={InteractionId}", sessionId, interactionId);
        }
    }

    private async Task LoadFullTurnContextAsync()
    {
        if (_session is null || _interaction is null)
        {
            _fullTurn = null;
            return;
        }

        try
        {
            _fullTurn = await TurnResolver.ResolveAsync(_session, _interaction.Id);
        }
        catch (Exception ex)
        {
            _fullTurn = null;
            Logger.LogWarning(ex, "Failed to resolve full turn for studio: SessionId={SessionId}, InteractionId={InteractionId}", sessionId, interactionId);
        }
    }

    private async Task LoadStoryArcAsync()
    {
        if (_session is null)
        {
            _storyArcTurns = [];
            return;
        }

        try
        {
            var turns = await StateRepository.LoadTurnsAsync(_session.Id, take: 200);
            var transitions = await StateRepository.LoadTransitionEventsAsync(_session.Id, take: 200);
            var currentPhase = _session.AdaptiveState.CurrentPhase;

            var result = new List<StoryArcTurn>();
            foreach (var turn in turns.OrderBy(t => t.TurnIndex))
            {
                result.Add(await BuildStoryArcTurnAsync(turn, transitions, currentPhase));
            }

            _storyArcTurns = result;

            // When the studio is opened for an interaction that belongs to a turn (e.g. from the
            // workspace turn/command button or the Story arc "Open in Studio"), pin that turn so
            // the Story arc shows it as the selected turn with the lists collapsed.
            var currentTurnId = _fullTurn?.Turn?.TurnId;
            _selectedArcTurnId = currentTurnId is null
                ? null
                : result.FirstOrDefault(t => string.Equals(t.TurnId, currentTurnId, StringComparison.OrdinalIgnoreCase))?.TurnId;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load story arc for studio: SessionId={SessionId}", sessionId);
            _storyArcTurns = [];
            _selectedArcTurnId = null;
        }
    }

    private async Task<StoryArcTurn> BuildStoryArcTurnAsync(
        RolePlayTurn turn,
        IReadOnlyList<NarrativePhaseTransitionEvent> transitions,
        DreamGenClone.Domain.RolePlay.NarrativePhase currentPhase)
    {
        var phase = ResolvePhaseAt(turn.StartedUtc, transitions, currentPhase);

        var interactionIds = turn.OutputInteractionIds
            .Concat(turn.InputInteractionId is null ? [] : [turn.InputInteractionId])
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var turnInteractions = _session!.Interactions
            .Where(x => interactionIds.Contains(x.Id))
            .OrderBy(x => x.CreatedAt)
            .ToList();

        var characters = string.Join(", ", turnInteractions
            .Select(x => x.ActorName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase));

        var narrative = turnInteractions.FirstOrDefault(IsNarrative);
        var labelSource = narrative?.Content ?? turnInteractions.FirstOrDefault()?.Content ?? string.Empty;

        var (stage, status) = await ResolvePipelineStageAsync(turn);
        var intensity = ResolveTurnIntensityLabel(turn.StartedUtc);

        return new StoryArcTurn
        {
            TurnId = turn.TurnId,
            TurnNumber = turn.TurnIndex + 1,
            Phase = phase.ToString(),
            Intensity = intensity ?? string.Empty,
            Characters = string.IsNullOrWhiteSpace(characters) ? "(no interactions)" : characters,
            PipelineStage = stage,
            PipelineStatus = status,
            IsCurrent = _fullTurn?.Turn is not null
                && string.Equals(_fullTurn.Turn.TurnId, turn.TurnId, StringComparison.OrdinalIgnoreCase),
            NavigationInteractionId = narrative?.Id ?? turnInteractions.FirstOrDefault()?.Id ?? turn.InputInteractionId ?? string.Empty,
            Label = TruncateForArc(labelSource)
        };
    }

    private async Task<(string Stage, string Status)> ResolvePipelineStageAsync(RolePlayTurn turn)
    {
        var catalogue = await BeatPipelineService.GetCurrentCatalogueAsync(sessionId, turn.TurnId);
        if (catalogue is null)
        {
            return ("", "");
        }

        if (catalogue.Status != SceneBeatCatalogueStatus.Complete)
        {
            return ("Beat Catalogue", catalogue.Status.ToString());
        }

        foreach (var entry in catalogue.Entries)
        {
            var plan = await BeatProductionService.GetCurrentAsync(catalogue.Id, entry.BeatId);
            if (plan is null)
            {
                continue;
            }

            if (plan.Status != SceneBeatCatalogueStatus.Complete)
            {
                return ("Beat Production", plan.Status.ToString());
            }

            var momentSet = await MomentDiscoveryService.GetCurrentAsync(plan.Id);
            if (momentSet is null)
            {
                return ("Beat Production", "Complete");
            }

            if (momentSet.Status != SceneBeatCatalogueStatus.Complete)
            {
                return ("Production Moments", momentSet.Status.ToString());
            }

            var momentId = momentSet.RecommendedMomentId ?? momentSet.Moments.FirstOrDefault()?.MomentId;
            if (momentId is null)
            {
                return ("Production Moments", "Complete");
            }

            var enrichment = await MomentEnrichmentService.GetCurrentAsync(momentSet.Id, momentId);
            if (enrichment is null)
            {
                return ("Production Moments", "Complete");
            }

            if (enrichment.Status != SceneBeatCatalogueStatus.Complete)
            {
                return ("Moment Enrichment", enrichment.Status.ToString());
            }

            return ("Moment Enrichment", "Complete");
        }

        return ("Beat Catalogue", "Complete");
    }

    private string? ResolveTurnIntensityLabel(DateTime occurredUtc)
    {
        if (_session is null)
        {
            return null;
        }

        string? adaptiveProfileId = _session.AdaptiveIntensityProfileId;
        var transitions = _session.AdaptiveIntensityTransitions
            .OrderBy(t => t.OccurredUtc)
            .ToList();
        if (transitions.Count > 0)
        {
            adaptiveProfileId = transitions[0].FromProfileId;
            foreach (var transition in transitions)
            {
                if (occurredUtc >= transition.OccurredUtc)
                {
                    adaptiveProfileId = transition.ToProfileId;
                }
                else
                {
                    break;
                }
            }
        }

        IntensityLevel? selectedIntensityLevel = IntensityLevel.Emotional;
        if (!string.IsNullOrWhiteSpace(_session.SelectedIntensityProfileId)
            && _intensityProfilesById.TryGetValue(_session.SelectedIntensityProfileId, out var intensityProfile))
        {
            selectedIntensityLevel = intensityProfile.Intensity;
        }

        IntensityLevel? adaptiveIntensityLevel = null;
        if (!string.IsNullOrWhiteSpace(adaptiveProfileId)
            && _intensityProfilesById.TryGetValue(adaptiveProfileId, out var adaptiveProfile))
        {
            adaptiveIntensityLevel = adaptiveProfile.Intensity;
        }

        var (label, _) = RolePlayStyleResolver.ResolveEffectiveStyle(_session, selectedIntensityLevel, adaptiveIntensityLevel);
        return label;
    }

    private static DreamGenClone.Domain.RolePlay.NarrativePhase ResolvePhaseAt(
        DateTime occurredUtc,
        IReadOnlyList<NarrativePhaseTransitionEvent> transitions,
        DreamGenClone.Domain.RolePlay.NarrativePhase currentPhase)
    {
        var ordered = transitions.OrderBy(t => t.OccurredUtc).ToList();
        if (ordered.Count == 0)
        {
            return currentPhase;
        }

        var phase = ordered[0].FromPhase;
        foreach (var transition in ordered)
        {
            if (occurredUtc >= transition.OccurredUtc)
            {
                phase = transition.ToPhase;
            }
            else
            {
                break;
            }
        }

        return phase;
    }

    private static bool IsNarrative(RolePlayInteraction interaction)
        => string.Equals(interaction.ActorName, "Narrative", StringComparison.OrdinalIgnoreCase);

    private static string TruncateForArc(string text, int max = 150)
        => string.IsNullOrWhiteSpace(text) ? string.Empty : (text.Length <= max ? text : text[..max] + "…");

    private static string PipelineBadgeClass(string stage) => stage switch
    {
        "Beat Catalogue" => "text-bg-secondary",
        "Beat Production" => "text-bg-info",
        "Production Moments" => "text-bg-warning",
        "Moment Enrichment" => "text-bg-success",
        _ => "text-bg-secondary"
    };

    private void SeedSettingsFromWorkspace()
    {
        _settings.ImageSize = WorkspaceSettings.ImageSize;
        _settings.AllowExplicitImage = WorkspaceSettings.AllowExplicitImage;
        if (!string.IsNullOrWhiteSpace(WorkspaceSettings.ImageStyleSuffix))
        {
            // Seed the free-text style cue as a suffix appended to the selected style so it
            // survives regeneration; keep the base style selection distinct.
            _settings.Style = WorkspaceSettings.ImageStyleSuffix;
        }

        Logger.LogInformation(
            "Seeded studio settings from workspace defaults: SessionId={SessionId}, ImageSize={ImageSize}, Style={Style}, AllowExplicitImage={AllowExplicitImage}",
            sessionId, _settings.ImageSize, _settings.Style, _settings.AllowExplicitImage);
    }

    private async Task LoadIntensityProfilesAsync()
    {
        try
        {
            var intensityProfiles = await StoryAnalysis.ListIntensityProfilesAsync();
            _intensityProfilesById = intensityProfiles
                .Where(x => x.Intensity != IntensityLevel.Intro)
                .ToDictionary(x => x.Id, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load intensity profiles for studio: SessionId={SessionId}", sessionId);
            _intensityProfilesById = new(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task ResolvePolicyAsync()
    {
        _resolvedPolicy = null;
        _policyResolutionError = null;
        try
        {
            var resolved = await ModelResolutionService.ResolveImageModelAsync(null);
            _resolvedPolicy = resolved.ContentPolicy;
            _resolvedDefaultImageModelId = resolved.ModelIdentifier;
        }
        catch (Exception ex)
        {
            // No image model configured (or misconfigured). The render/enqueue paths fail fast with
            // detailed guidance; here we just surface a friendly banner and leave the toggle enabled
            // (the render path will still hard-clamp/hard-fail).
            _policyResolutionError = ex.Message;
            Logger.LogInformation(
                "Scene image policy not resolvable on studio open (will surface at render time): SessionId={SessionId}, Error={Error}",
                sessionId, ex.Message);
        }
    }

    private async Task RefreshAsync()
    {
        if (_activePrompt?.Status == SceneImagePromptStatus.Pending)
        {
            _activePrompt = await ImageService.GetPromptAsync(sessionId, _activePrompt.Id);
            if (_activePrompt?.Status == SceneImagePromptStatus.Complete)
            {
                _editablePrompt = _activePrompt.OutputPrompt;
            }
        }
        else if (_productionGroup is not null && _compiledMediaBrief is not null)
        {
            await LoadProductionPromptAsync();
        }
        else if (_selectedBeat is not null && !string.IsNullOrWhiteSpace(_selectedPov))
        {
            await LoadSelectedPromptAsync();
        }
        else
        {
            _activePrompt = await ImageService.GetLatestPromptAsync(sessionId, interactionId);
            if (_activePrompt?.Status == SceneImagePromptStatus.Complete)
            {
                _editablePrompt = _activePrompt.OutputPrompt;
            }
        }
        await LoadPreprocessorPromptAsync();
        _images = (await ImageService.ListImagesByInteractionAsync(sessionId, interactionId)).ToList();
        await LoadCatalogueAsync();
        await LoadBeatAnalysisAsync();
        await LoadProductionGroupAsync();
    }

    private async Task LoadCatalogueAsync()
    {
        var previousCatalogueId = _catalogue?.Id;
        _catalogue = _fullTurn?.Turn is null
            ? null
            : await BeatPipelineService.GetCurrentCatalogueAsync(sessionId, _fullTurn.Turn.TurnId);
        if (previousCatalogueId is not null
            && !string.Equals(previousCatalogueId, _catalogue?.Id, StringComparison.Ordinal))
        {
            _cataloguePinned = false;
            ClearProductionState();
        }
        if (_selectedCatalogueBeatId is not null
            && (_catalogue is null || !_catalogue.Entries.Any(entry => entry.BeatId == _selectedCatalogueBeatId)))
        {
            _selectedCatalogueBeatId = null;
            _cataloguePinned = false;
            _productionPlan = null;
            _replaceProductionRequested = false;
            _momentSet = null;
            _replaceMomentsRequested = false;
            _selectedMomentId = null;
            _momentEnrichment = null;
            _replaceEnrichmentRequested = false;
            ClearProductionState();
        }
        await LoadProductionPlanAsync();
    }

    private async Task LoadProductionPlanAsync()
    {
        var previousProductionPlanId = _productionPlan?.Id;
        _productionPlan = _catalogue is null || _selectedCatalogueBeatId is null
            ? null
            : await BeatProductionService.GetCurrentAsync(_catalogue.Id, _selectedCatalogueBeatId);
        if (previousProductionPlanId is not null
            && !string.Equals(previousProductionPlanId, _productionPlan?.Id, StringComparison.Ordinal))
        {
