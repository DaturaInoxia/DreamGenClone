    private async Task RenderIdentityImageAsync()
    {
        if (!IsSelectedMomentEnriched)
            throw new InvalidOperationException("A current completed Moment enrichment is required before identity rendering.");
        if (_activePrompt is null || string.IsNullOrWhiteSpace(_editablePrompt)) return;
        var selected = _identityPackOptions.Where(o => o.Selected).ToList();
        if (selected.Count == 0) return;

        await RunAsync(async () =>
        {
            // Persist the edited text back to the prompt record so a later studio reopen shows it.
            await ImageService.UpdatePromptOutputAsync(sessionId, _activePrompt.Id, _editablePrompt.Trim());

            var identityPacks = selected
                .Select(o => new IdentityPackSelection
                {
                    PackId = o.PackId,
                    CharacterLabel = o.Label,
                    Strength = o.Strength
                })
                .ToList();

            var record = await ImageService.EnqueueRenderAsync(new SceneRenderRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                PromptRecordId = _activePrompt.Id,
                Prompt = _editablePrompt.Trim(),
                ImageSize = _settings.ImageSize,
                SettingsJson = JsonSerializer.Serialize(_settings),
                RegenerateOfId = null,
                BeatId = _selectedBeatId,
                Pov = _selectedPov,
                RenderMode = SceneImageRenderMode.IdentityControlled,
                IdentityPackId = identityPacks[0].PackId,
                IdentityPacks = identityPacks
            });
            _images.Insert(0, record);
            _statusMessage = selected.Count > 1
                ? $"Identity-controlled render queued ({selected.Count} packs)."
                : "Identity-controlled render queued.";
            EnsurePolling();
        });
    }

