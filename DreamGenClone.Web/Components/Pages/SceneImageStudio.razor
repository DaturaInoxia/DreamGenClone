    private void EnsureProductionGroupMatchesSelection(SceneImageProductionGroup group)
    {
        if (_catalogue is null
            || _selectedCatalogueBeat is null
            || _productionPlan is null
            || _momentSet is null
            || _selectedMoment is null
            || _momentEnrichment is null
            || !string.Equals(group.SessionId, sessionId, StringComparison.Ordinal)
            || !string.Equals(group.InteractionId, interactionId, StringComparison.Ordinal)
            || !string.Equals(group.CatalogueId, _catalogue.Id, StringComparison.Ordinal)
            || !string.Equals(group.BeatId, _selectedCatalogueBeat.BeatId, StringComparison.Ordinal)
            || !string.Equals(group.BeatProductionPlanId, _productionPlan.Id, StringComparison.Ordinal)
            || group.BeatProductionPlanVersion != _productionPlan.Version
            || !string.Equals(group.MomentSetId, _momentSet.Id, StringComparison.Ordinal)
            || group.MomentSetVersion != _momentSet.Version
            || !string.Equals(group.MomentId, _selectedMoment.MomentId, StringComparison.Ordinal)
            || !string.Equals(group.MomentEnrichmentId, _momentEnrichment.Id, StringComparison.Ordinal)
            || group.MomentEnrichmentRevision != _momentEnrichment.Revision
            || !string.Equals(group.Pov, _productionPov, StringComparison.Ordinal))
        {
            throw new InvalidOperationException($"Production group '{group.Id}' does not match the exact selected lineage and POV.");
        }
    }

    private Task GenerateProductionCompositionAsync()
