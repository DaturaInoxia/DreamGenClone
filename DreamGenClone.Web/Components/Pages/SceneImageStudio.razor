    private static int ProductionReviewIssueCount(SceneBeatProductionPlan plan)
        => plan.DialogueCues.Count(cue => cue.ReviewStatus == ProductionReviewStatus.ReviewRequired)
            + plan.SoundCues.Count(cue => cue.ReviewStatus == ProductionReviewStatus.ReviewRequired)
            + plan.VideoCoveragePlans.Count(coverage => coverage.ReviewStatus == ProductionReviewStatus.ReviewRequired);

    private static IEnumerable<string> ProductionReviewIssues(SceneBeatProductionPlan plan)
    {
        foreach (var cue in plan.DialogueCues.Where(cue => cue.ReviewStatus == ProductionReviewStatus.ReviewRequired))
        {
            yield return $"Dialogue {cue.Order}: {cue.ReviewReason}";
        }
        foreach (var cue in plan.SoundCues.Where(cue => cue.ReviewStatus == ProductionReviewStatus.ReviewRequired))
        {
            yield return $"Sound {cue.Order}: {cue.ReviewReason}";
        }
        foreach (var coverage in plan.VideoCoveragePlans.Where(coverage => coverage.ReviewStatus == ProductionReviewStatus.ReviewRequired))
        {
            yield return $"Video {coverage.CoverageKey}: {coverage.ReviewReason}";
        }
    }

