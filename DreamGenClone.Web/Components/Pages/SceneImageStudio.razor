@page "/roleplay/studio/{sessionId}/{interactionId}"
@rendermode InteractiveServer

@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.Models
@using DreamGenClone.Web.Application.Sessions
@using DreamGenClone.Web.Application.Scenarios
@using DreamGenClone.Web.Domain.RolePlay
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Web.Application.StoryAnalysis
@using DreamGenClone.Domain.StoryAnalysis
@using System.Text.Json
@implements IAsyncDisposable

@inject ISessionService SessionService
@inject ISceneImageService ImageService
@inject ISceneImageProductionService ProductionService
@inject ISceneBeatPipelineService BeatPipelineService
@inject ISceneBeatProductionPipelineService BeatProductionService
@inject ISceneMomentDiscoveryPipelineService MomentDiscoveryService
@inject ISceneMomentEnrichmentPipelineService MomentEnrichmentService
@inject IRolePlayStateRepository StateRepository
@inject ICharacterImageIdentityService IdentityService
@inject IModelResolutionService ModelResolutionService
@inject StoryAnalysisFacade StoryAnalysis
@inject IScenarioService ScenarioService
@inject WorkspaceSettingsState WorkspaceSettings
@inject RolePlayDebugEventService DebugEventService
@inject SceneImageTurnResolver TurnResolver
@inject NavigationManager Nav
@inject ILogger<SceneImageStudio> Logger

<PageTitle>Scene Image Studio - DreamGenClone</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="/roleplay/workspace/@sessionId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to workspace
            </a>
            <h4 class="d-inline-block ms-2 mb-0">@_session?.Title</h4>
        </div>
        <div>
            <a href="/roleplay/gallery/@sessionId" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-images me-1"></i> Gallery
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-info">@_statusMessage</div>
    }
    @if (!string.IsNullOrEmpty(_policyResolutionError))
    {
        <div class="alert alert-warning">
            <i class="bi bi-info-circle me-1"></i>
            No image model is configured yet. Configure an image-capable provider + image model in
            <a href="/model-manager" class="alert-link">Model Manager</a> before rendering.
            <small class="d-block mt-1 text-muted">@_policyResolutionError</small>
        </div>
    }

    @if (_session is null)
    {
        <div class="alert alert-warning">Session or interaction not found.</div>
    }
    else
    {
        @* ── Story Arc: session turn overview + beat-pipeline activity ── *@
        <div class="card mb-3 scene-story-arc">
            <div class="card-header p-0">
                <button class="studio-collapse-toggle studio-collapse-toggle-full px-3 py-2" @onclick="ToggleStoryArc" type="button">
                    <strong>Story arc</strong>
                    <i class="bi @(_storyArcOpen ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></i>
                </button>
            </div>
            @if (_storyArcOpen)
            {
                var selectedTurn = _selectedArcTurn;
                <div class="card-body small">
                    @if (_storyArcTurns.Count == 0)
                    {
                        <span class="text-muted">No persisted turns in this session.</span>
                    }
                    else if (selectedTurn is not null)
                    {
                        <div class="scene-story-arc-selected mb-2">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                <span class="fw-semibold"><i class="bi bi-pin-angle-fill me-1 text-info"></i>Selected turn</span>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ExpandStoryArc" type="button">
                                        <i class="bi bi-arrows-expand me-1"></i> Expand list
                                    </button>
                                    <button class="btn btn-sm btn-primary" @onclick="() => NavigateToTurn(selectedTurn)" type="button">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> Open in Studio
                                    </button>
                                </div>
                            </div>
                            <button class="btn text-start scene-story-arc-row @(selectedTurn.HasPipelineActivity ? "scene-story-arc-active" : "btn-outline-secondary") @(selectedTurn.IsCurrent ? "scene-story-arc-current" : "")"
                                    @onclick="() => NavigateToTurn(selectedTurn)">
                                <span class="d-flex justify-content-between gap-2">
                                    <strong>Turn @selectedTurn.TurnNumber</strong>
                                    <span class="text-nowrap small text-muted">@selectedTurn.Phase@(string.IsNullOrWhiteSpace(selectedTurn.Intensity) ? "" : $" · {selectedTurn.Intensity}")</span>
                                </span>
                                <span class="d-block small mt-1 text-muted">@selectedTurn.Characters</span>
                                @if (selectedTurn.HasPipelineActivity)
                                {
                                    <span class="d-block mt-1">
                                        <span class="badge @PipelineBadgeClass(selectedTurn.PipelineStage)">@selectedTurn.PipelineStage</span>
                                        <span class="text-muted small ms-1">@selectedTurn.PipelineStatus</span>
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedTurn.Label))
                                {
                                    <span class="d-block small mt-1 text-muted text-truncate">@selectedTurn.Label</span>
                                }
                            </button>
                        </div>
                    }
                    else
                    {
                        var activeTurns = _storyArcTurns.Where(t => t.HasPipelineActivity).ToList();
                        @if (activeTurns.Count > 0)
                        {
                            <div class="mb-3">
                                <div class="fw-semibold mb-1"><i class="bi bi-activity me-1 text-info"></i>Active (@activeTurns.Count)</div>
                                <div class="scene-story-arc-scroll d-grid gap-2">
                                    @foreach (var t in activeTurns)
                                    {
                                        <button class="btn text-start scene-story-arc-row @(t.HasPipelineActivity ? "scene-story-arc-active" : "btn-outline-secondary") @(t.IsCurrent ? "scene-story-arc-current" : "")"
                                                @onclick="() => SelectArcTurn(t)">
                                            <span class="d-flex justify-content-between gap-2">
                                                <strong>Turn @t.TurnNumber</strong>
                                                <span class="text-nowrap small text-muted">@t.Phase@(string.IsNullOrWhiteSpace(t.Intensity) ? "" : $" · {t.Intensity}")</span>
                                            </span>
                                            <span class="d-block small mt-1 text-muted">@t.Characters</span>
                                            <span class="d-block mt-1">
                                                <span class="badge @PipelineBadgeClass(t.PipelineStage)">@t.PipelineStage</span>
                                                <span class="text-muted small ms-1">@t.PipelineStatus</span>
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(t.Label))
                                            {
                                                <span class="d-block small mt-1 text-muted text-truncate">@t.Label</span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        <div class="scene-story-arc-all">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                <span class="fw-semibold">All turns (@_storyArcTurns.Count)</span>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleAllTurns" type="button" title="Collapse / expand the turn list">
                                    <i class="bi @(_allTurnsOpen ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>@(_allTurnsOpen ? "Collapse" : "Expand")
                                </button>
                            </div>
                            @if (_allTurnsOpen)
                            {
                                <div class="scene-story-arc-scroll d-grid gap-2">
                                    @foreach (var t in _storyArcTurns)
                                    {
                                        <button class="btn text-start scene-story-arc-row @(t.HasPipelineActivity ? "scene-story-arc-active" : "btn-outline-secondary") @(t.IsCurrent ? "scene-story-arc-current" : "")"
                                                @onclick="() => SelectArcTurn(t)">
                                            <span class="d-flex justify-content-between gap-2">
                                                <strong>Turn @t.TurnNumber</strong>
                                                <span class="text-nowrap small text-muted">@t.Phase@(string.IsNullOrWhiteSpace(t.Intensity) ? "" : $" · {t.Intensity}")</span>
                                            </span>
                                            <span class="d-block small mt-1 text-muted">@t.Characters</span>
                                            @if (t.HasPipelineActivity)
                                            {
                                                <span class="d-block mt-1">
                                                    <span class="badge @PipelineBadgeClass(t.PipelineStage)">@t.PipelineStage</span>
                                                    <span class="text-muted small ms-1">@t.PipelineStatus</span>
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(t.Label))
                                            {
                                                <span class="d-block small mt-1 text-muted text-truncate">@t.Label</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* ── Row 1: Story Moment (tabs; collapsible, collapsed by default) ── *@
        <div class="card mb-3 scene-story-moment-panel">
            <div class="card-header p-0">
                <button class="studio-collapse-toggle studio-collapse-toggle-full px-3 py-2" @onclick="ToggleStoryMoment" type="button">
                    <strong>Story Moment</strong>
                    <i class="bi @(_storyMomentOpen ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></i>
                </button>
            </div>
            @if (_storyMomentOpen)
            {
                <div class="card-body">
                    <ul class="nav nav-tabs small" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link @(_storyTab == StoryPanelTab.StoryMoment ? "active" : "")" type="button" @onclick="() => _storyTab = StoryPanelTab.StoryMoment">Story Moment</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(_storyTab == StoryPanelTab.FullTurnContext ? "active" : "")" type="button" @onclick="() => _storyTab = StoryPanelTab.FullTurnContext">Full Turn Context</button>
                        </li>
                    </ul>
                    <div class="tab-content mt-2">
                        @if (_storyTab == StoryPanelTab.StoryMoment)
                        {
                            <div class="scene-image-story-moment" style="max-height: 320px; overflow: auto; white-space: pre-wrap;">@_interaction?.Content</div>
                        }
                        else if (_storyTab == StoryPanelTab.FullTurnContext)
                        {
                            @if (_fullTurn is not null)
                            {
                                <div class="text-muted small mb-2">
                                    @if (_fullTurn.Turn is not null)
                                    {
                                        <span>Turn #@(_fullTurn.Turn.TurnIndex + 1) · Source: RolePlayV2Turns · @_fullTurn.Turn.TurnKind · @_fullTurn.Turn.TriggerSource</span>
                                    }
                                    else
                                    {
                                        <span>Source: legacy context window</span>
                                    }
                                </div>
                                <div class="list-group list-group-flush scene-image-turn-context">
                                    @foreach (var turnInteraction in _fullTurn.Interactions)
                                    {
                                        var isSelectedInteraction = string.Equals(turnInteraction.Id, interactionId, StringComparison.OrdinalIgnoreCase);
                                        <div class="list-group-item px-0 @(isSelectedInteraction ? "scene-image-turn-selected" : "")">
                                            <div class="d-flex justify-content-between gap-2 small">
                                                <strong>@turnInteraction.ActorName</strong>
                                                <span class="text-muted text-nowrap">@turnInteraction.InteractionType · @turnInteraction.CreatedAt.ToLocalTime().ToString("g")</span>
                                            </div>
                                            @if (isSelectedInteraction)
                                            {
                                                <div class="small text-info">Selected for this image</div>
                                            }
                                            <div class="small mt-1" style="white-space: pre-wrap;">@turnInteraction.Content</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">No full-turn context is available for this interaction.</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @* ── Row 2: Beat Catalogue ── *@
        <div class="card mb-3 scene-beat-catalogue">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <button class="studio-collapse-toggle" @onclick="ToggleBeatCatalogue" type="button">
                            <i class="bi @(_beatCatalogueOpen ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                            <strong>Beat Catalogue</strong>
                            @if (_catalogue is not null)
                            {
                                <span class="badge text-bg-secondary ms-2">v@_catalogue.Version</span>
                            }
                        </button>
                        @if (_catalogue is null)
                        {
                            <button class="btn btn-sm btn-primary" disabled="@(_busy || _fullTurn?.Turn is null)" @onclick="GenerateCatalogueAsync">
                                <i class="bi bi-list-stars me-1"></i> Generate Beats
                            </button>
                        }
                        else if (_catalogue.Status is SceneBeatCatalogueStatus.Pending or SceneBeatCatalogueStatus.Processing)
                        {
                            <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="CancelCatalogueAsync">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceCatalogueRequested = true">
                                <i class="bi bi-arrow-repeat me-1"></i> @(_catalogue.Status == SceneBeatCatalogueStatus.Complete ? "Generate Again" : "Retry")
                            </button>
                        }
                    </div>
                    @if (_beatCatalogueOpen)
                    {
                    <div class="card-body small">
                        @if (_fullTurn?.Turn is null)
                        {
                            <span class="text-muted">A persisted completed turn is required.</span>
                        }
                        else if (_replaceCatalogueRequested)
                        {
                            <div class="alert alert-warning py-2 mb-0">
                                Create a new catalogue version for this turn?
                                <div class="mt-2 d-flex gap-2">
                                    <button class="btn btn-sm btn-warning" disabled="@_busy" @onclick="GenerateCatalogueAsync">Create Version</button>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceCatalogueRequested = false">Cancel</button>
                                </div>
                            </div>
                        }
                        else if (_catalogue is null)
                        {
                            <span class="text-muted">No Beat Catalogue exists for this turn.</span>
                        }
                        else if (_catalogue.Status is SceneBeatCatalogueStatus.Pending or SceneBeatCatalogueStatus.Processing)
                        {
                            <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Building Beat Catalogue...</span>
                        }
                        else if (_catalogue.Status == SceneBeatCatalogueStatus.Failed)
                        {
                            <div class="alert alert-danger py-2 mb-0">
                                <strong>@(_catalogue.ErrorCode ?? "Beat Catalogue failed")</strong>
                                @if (!string.IsNullOrWhiteSpace(_catalogue.ErrorMessage))
                                {
                                    <span class="d-block mt-1">@_catalogue.ErrorMessage</span>
                                }
                            </div>
                        }
                        else if (_catalogue.Status == SceneBeatCatalogueStatus.Complete)
                        {
                            var selectedBeat = _selectedCatalogueBeat;
                            @if (selectedBeat is not null && _cataloguePinned)
                            {
                                <div class="scene-beat-catalogue-selected mb-2">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                        <span class="fw-semibold"><i class="bi bi-pin-angle-fill me-1 text-info"></i>Selected beat</span>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExpandCatalogue" type="button">
                                            <i class="bi bi-arrows-expand me-1"></i> Expand list
                                        </button>
                                    </div>
                                    <div class="scene-beat-catalogue-pinned-card">
                                        <span class="d-flex justify-content-between gap-2">
                                            <strong>@selectedBeat.Order. @selectedBeat.Label</strong>
                                            <span class="text-nowrap small">@selectedBeat.PrimaryLocation</span>
                                        </span>
                                        <span class="d-block small mt-1">@selectedBeat.BeatSynopsis</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-grid gap-2 scene-beat-catalogue-list">
                                    @foreach (var beat in _catalogue.Entries.OrderBy(entry => entry.Order))
                                    {
                                        <button class="btn text-start @(_selectedCatalogueBeatId == beat.BeatId ? "btn-primary" : "btn-outline-secondary")"
                                                @onclick="() => SelectCatalogueBeatAsync(beat.BeatId)">
                                            <span class="d-flex justify-content-between gap-2">
                                                <strong>@beat.Order. @beat.Label</strong>
                                                <span class="text-nowrap small">@beat.PrimaryLocation</span>
                                            </span>
                                            <span class="d-block small mt-1">@beat.BeatSynopsis</span>
                                        </button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Catalogue status: @_catalogue.Status</span>
                        }
                    </div>
                    }
                </div>

                    @* ── Row 3: Beat Production ── *@
                    @if (_catalogue?.Status == SceneBeatCatalogueStatus.Complete && _selectedCatalogueBeat is not null)
                    {
                        <div class="card mb-3 scene-beat-production-panel">
                            <div class="card-header d-flex justify-content-between align-items-start gap-2">
                                <button class="studio-collapse-toggle" @onclick="ToggleBeatProduction" type="button">
                                    <i class="bi @(_beatProductionOpen ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                    <span>
                                        <strong>Beat Production</strong>
                                        <span class="d-block text-muted">@_selectedCatalogueBeat.Label</span>
                                    </span>
                                </button>
                                @if (_productionPlan is not null)
                                {
                                    <span class="badge @ProductionStatusBadgeClass(_productionPlan.Status)">v@_productionPlan.Version · @_productionPlan.Status</span>
                                }
                            </div>
                            @if (_beatProductionOpen)
                            {
                            <div class="card-body small">
                                @if (_replaceProductionRequested)
                                {
                                    <div class="alert alert-warning py-2 mb-0">
                                        Create a new production version for this Beat?
                                        <div class="mt-2 d-flex gap-2">
                                            <button class="btn btn-sm btn-warning" disabled="@_busy" @onclick="GenerateProductionPlanAsync">Create Version</button>
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceProductionRequested = false">Cancel</button>
                                        </div>
                                    </div>
                                }
                                else if (_productionPlan is null)
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="GenerateProductionPlanAsync">
                                        <i class="bi bi-diagram-3 me-1"></i> Produce Beat
                                    </button>
                                }
                                else if (_productionPlan.Status is SceneBeatCatalogueStatus.Pending or SceneBeatCatalogueStatus.Processing)
                                {
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Building production plan...</span>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="CancelProductionPlanAsync">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </button>
                                    </div>
                                }
                                else if (_productionPlan.Status == SceneBeatCatalogueStatus.Failed)
                                {
                                    <div class="alert alert-danger py-2 mb-2">
                                        <strong>@(_productionPlan.ErrorCode ?? "Production planning failed")</strong>
                                        @if (!string.IsNullOrWhiteSpace(_productionPlan.ErrorMessage))
                                        {
                                            <span class="d-block mt-1">@_productionPlan.ErrorMessage</span>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceProductionRequested = true">
                                        <i class="bi bi-arrow-repeat me-1"></i> Retry
                                    </button>
                                }
                                else if (_productionPlan.Status == SceneBeatCatalogueStatus.Complete)
                                {
                                    var reviewCount = ProductionReviewIssueCount(_productionPlan);
                                    <div class="scene-beat-production-metrics mb-2">
                                        <span><strong>@_productionPlan.DialogueCues.Count</strong> dialogue</span>
                                        <span><strong>@_productionPlan.SoundCues.Count</strong> sound</span>
                                        <span><strong>@_productionPlan.VideoCoveragePlans.Count</strong> video</span>
                                        <span class="@(reviewCount == 0 ? "text-success" : "text-warning")"><strong>@reviewCount</strong> review</span>
                                    </div>
                                    @if (reviewCount > 0)
                                    {
                                        <div class="alert alert-warning py-2 mb-2">
                                            <strong>Review required</strong>
                                            @foreach (var issue in ProductionReviewIssues(_productionPlan))
                                            {
                                                <span class="d-block mt-1">@issue</span>
                                            }
                                        </div>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceProductionRequested = true">
                                        <i class="bi bi-arrow-repeat me-1"></i> Produce Again
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">Production status: @_productionPlan.Status</span>
                                }
                            </div>
                            }
                        </div>
                    }

                    @* ── Row 4: Production Moments ── *@
                    @if (_productionPlan?.Status == SceneBeatCatalogueStatus.Complete)
                    {
                        <div class="card mb-3 scene-production-moments-panel">
                            <div class="card-header d-flex justify-content-between align-items-start gap-2">
                                <button class="studio-collapse-toggle" @onclick="ToggleProductionMoments" type="button">
                                    <i class="bi @(_productionMomentsOpen ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                    <span>
                                        <strong>Production Moments</strong>
                                        <span class="d-block text-muted">Choose a frozen state for still, video, and sound production.</span>
                                    </span>
                                </button>
                                @if (_momentSet is not null)
                                {
                                    <span class="badge @ProductionStatusBadgeClass(_momentSet.Status)">v@_momentSet.Version · @_momentSet.Status</span>
                                }
                            </div>
                            @if (_productionMomentsOpen)
                            {
                            <div class="card-body small">
                                @if (_replaceMomentsRequested)
                                {
                                    <div class="alert alert-warning py-2 mb-0">
                                        Create a new Moment Set version for this production plan?
                                        <div class="mt-2 d-flex gap-2">
                                            <button class="btn btn-sm btn-warning" disabled="@_busy" @onclick="GenerateMomentsAsync">Create Version</button>
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceMomentsRequested = false">Cancel</button>
                                        </div>
                                    </div>
                                }
                                else if (_momentSet is null)
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="GenerateMomentsAsync">
                                        <i class="bi bi-camera-reels me-1"></i> Discover Moments
                                    </button>
                                }
                                else if (_momentSet.Status is SceneBeatCatalogueStatus.Pending or SceneBeatCatalogueStatus.Processing)
                                {
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Discovering production moments...</span>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="CancelMomentsAsync">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </button>
                                    </div>
                                }
                                else if (_momentSet.Status == SceneBeatCatalogueStatus.Failed)
                                {
                                    <div class="alert alert-danger py-2 mb-2">
                                        <strong>@(_momentSet.ErrorCode ?? "Moment discovery failed")</strong>
                                        @if (!string.IsNullOrWhiteSpace(_momentSet.ErrorMessage))
                                        {
                                            <span class="d-block mt-1">@_momentSet.ErrorMessage</span>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceMomentsRequested = true">
                                        <i class="bi bi-arrow-repeat me-1"></i> Retry
                                    </button>
                                }
                                else if (_momentSet.Status == SceneBeatCatalogueStatus.Complete)
                                {
                                    var selectedMoment = _selectedMoment;
                                    @if (selectedMoment is not null && _momentsPinned)
                                    {
                                        var isRecommended = selectedMoment.MomentId == _momentSet.RecommendedMomentId;
                                        <div class="scene-moment-selected mb-2">
                                            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                                <span class="fw-semibold"><i class="bi bi-pin-angle-fill me-1 text-info"></i>Selected moment</span>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="ExpandMoments" type="button">
                                                    <i class="bi bi-arrows-expand me-1"></i> Expand list
                                                </button>
                                            </div>
                                            <div class="scene-moment-choice is-selected">
                                                <span class="d-flex justify-content-between align-items-start gap-2">
                                                    <strong>@selectedMoment.Order. @selectedMoment.Label</strong>
                                                    @if (isRecommended)
                                                    {
                                                        <span class="badge text-bg-success"><i class="bi bi-star-fill me-1"></i>Recommended</span>
                                                    }
                                                </span>
                                                <span class="d-block mt-1">@selectedMoment.FrozenState</span>
                                                <span class="d-block text-muted mt-1">@selectedMoment.TemporalAnchor</span>
                                                <span class="scene-moment-roles d-flex flex-wrap gap-1 mt-2">
                                                    @foreach (var role in MomentRoles(selectedMoment))
                                                    {
                                                        <span class="badge text-bg-secondary">@role</span>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success mb-2" disabled="@_busy" @onclick="SelectRecommendedMomentAsync">
                                            <i class="bi bi-star-fill me-1"></i> Use Recommended Moment
                                        </button>
                                        <div class="scene-moment-list d-grid gap-2">
                                            @foreach (var moment in _momentSet.Moments.OrderBy(moment => moment.Order))
                                            {
                                                var isRecommended = moment.MomentId == _momentSet.RecommendedMomentId;
                                                <button class="scene-moment-choice text-start @(_selectedMomentId == moment.MomentId ? "is-selected" : "")"
                                                    @onclick="() => SelectMomentAsync(moment)">
                                                    <span class="d-flex justify-content-between align-items-start gap-2">
                                                        <strong>@moment.Order. @moment.Label</strong>
                                                        @if (isRecommended)
                                                        {
                                                            <span class="badge text-bg-success"><i class="bi bi-star-fill me-1"></i>Recommended</span>
                                                        }
                                                    </span>
                                                    <span class="d-block mt-1">@moment.FrozenState</span>
                                                    <span class="d-block text-muted mt-1">@moment.TemporalAnchor</span>
                                                    <span class="scene-moment-roles d-flex flex-wrap gap-1 mt-2">
                                                        @foreach (var role in MomentRoles(moment))
                                                        {
                                                            <span class="badge text-bg-secondary">@role</span>
                                                        }
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary mt-2" disabled="@_busy" @onclick="() => _replaceMomentsRequested = true">
                                            <i class="bi bi-arrow-repeat me-1"></i> Discover Again
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Moment discovery status: @_momentSet.Status</span>
                                }
                            </div>
                            }
                        </div>
                    }

                    @* ── Row 5: Moment Enrichment ── *@
                    @if (_momentSet?.Status == SceneBeatCatalogueStatus.Complete && _selectedMoment is not null)
                    {
                        <div class="card mb-3 scene-moment-enrichment-panel">
                            <div class="card-header d-flex justify-content-between align-items-start gap-2">
                                <button class="studio-collapse-toggle" @onclick="ToggleMomentEnrichment" type="button">
                                    <i class="bi @(_momentEnrichmentOpen ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                    <span>
                                        <strong>Moment Enrichment</strong>
                                        <span class="d-block text-muted">@_selectedMoment.Label</span>
                                    </span>
                                </button>
                                @if (_momentEnrichment is not null)
                                {
                                    <span class="badge @ProductionStatusBadgeClass(_momentEnrichment.Status)">r@_momentEnrichment.Revision · @_momentEnrichment.Status</span>
                                }
                            </div>
                            @if (_momentEnrichmentOpen)
                            {
                            <div class="card-body small">
                                @if (_replaceEnrichmentRequested)
                                {
                                    <div class="alert alert-warning py-2 mb-0">
                                        Create a new enrichment revision for this Moment?
                                        <div class="mt-2 d-flex gap-2">
                                            <button class="btn btn-sm btn-warning" disabled="@_busy" @onclick="ReplaceMomentEnrichmentAsync">Create Revision</button>
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceEnrichmentRequested = false">Cancel</button>
                                        </div>
                                    </div>
                                }
                                else if (_momentEnrichment is null)
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => SelectMomentAsync(_selectedMoment)">
                                        <i class="bi bi-bounding-box me-1"></i> Enrich Moment
                                    </button>
                                }
                                else if (_momentEnrichment.Status is SceneBeatCatalogueStatus.Pending or SceneBeatCatalogueStatus.Processing)
                                {
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Resolving frozen production state...</span>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="CancelMomentEnrichmentAsync">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </button>
                                    </div>
                                }
                                else if (_momentEnrichment.Status == SceneBeatCatalogueStatus.Failed)
                                {
                                    <div class="alert alert-danger py-2 mb-2">
                                        <strong>@(_momentEnrichment.ErrorCode ?? "Moment enrichment failed")</strong>
                                        @if (!string.IsNullOrWhiteSpace(_momentEnrichment.ErrorMessage))
                                        {
                                            <span class="d-block mt-1">@_momentEnrichment.ErrorMessage</span>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _replaceEnrichmentRequested = true">
                                        <i class="bi bi-arrow-repeat me-1"></i> Retry
                                    </button>
                                }
                                else if (_momentEnrichment.Status == SceneBeatCatalogueStatus.Complete)
                                {
                                    var frozen = JsonSerializer.Deserialize<SceneMomentFrozenStateContract>(_momentEnrichment.FrozenStateContractJson, JsonOptions)
                                        ?? throw new InvalidOperationException("Completed Moment enrichment has no frozen-state contract.");
                                    var sounds = JsonSerializer.Deserialize<IReadOnlyList<SceneMomentInstantaneousSoundEvent>>(_momentEnrichment.InstantaneousSoundEventsJson, JsonOptions)
                                        ?? throw new InvalidOperationException("Completed Moment enrichment has no sound-event contract.");
                                    var video = JsonSerializer.Deserialize<SceneMomentVideoKeyState>(_momentEnrichment.VideoKeyStateJson, JsonOptions)
                                        ?? throw new InvalidOperationException("Completed Moment enrichment has no video key-state contract.");
                                    <div class="scene-moment-enrichment-summary">
                                        <strong class="d-block">@frozen.VisualDescription</strong>
                                        <span class="d-block text-muted mt-1">@frozen.Location · @frozen.TimeOfDay · @frozen.Lighting</span>
                                        <span class="d-block mt-1">@frozen.Environment</span>
                                        <span class="d-block text-muted">Mood: @frozen.Mood · Continuity: @frozen.ContinuityState</span>
                                        @foreach (var character in frozen.Characters)
                                        {
                                            <div class="scene-moment-character mt-2">
                                                <strong>@character.Name</strong>
                                                <span class="d-block">@character.Position · @character.ActionOrObservation</span>
                                                <span class="d-block text-muted">Looking @character.Sightline · @character.Clothing</span>
                                            </div>
                                        }
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @foreach (var sound in sounds)
                                            {
                                                <span class="badge text-bg-secondary"><i class="bi bi-volume-up me-1"></i>@sound.CueKey</span>
                                            }
                                            @foreach (var role in video.Roles)
                                            {
                                                <span class="badge text-bg-info"><i class="bi bi-camera-video me-1"></i>@role</span>
                                            }
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary mt-2" disabled="@_busy" @onclick="() => _replaceEnrichmentRequested = true">
                                        <i class="bi bi-arrow-repeat me-1"></i> Enrich Again
                                    </button>
                                }
                                @if (!IsSelectedMomentEnriched)
                                {
                                    <div class="alert alert-secondary py-2 mt-2 mb-0">
                                        Media actions unlock when this Moment enrichment completes.
                                    </div>
                                }
                            </div>
                            }
                        </div>
                    }

                <div class="card mb-3 scene-production-studio">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <button class="studio-collapse-toggle" @onclick="ToggleProductionStudio" type="button">
                            <i class="bi @(_productionStudioOpen ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                            <strong>Production Studio</strong>
                            @if (_productionGroup is not null)
                            {
                                <span class="badge text-bg-info ms-2">@_productionGroup.Status</span>
                            }
                        </button>
                        @if (IsSelectedMomentEnriched)
                        {
                            <button class="btn btn-sm btn-primary"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_productionPov))"
                                    @onclick="CreateOrLoadProductionAsync">
                                <i class="bi bi-folder2-open me-1"></i> Create / Load Production
                            </button>
                        }
                    </div>
                    @if (_productionStudioOpen)
                    {
                    <div class="card-body">
                        @if (!IsSelectedMomentEnriched)
                        {
                            <div class="scene-production-empty text-muted">
                                Select and complete a Moment enrichment to begin image production.
                            </div>
                        }
                        else
                        {
                            <div class="scene-production-pov mb-3">
                                <span class="small fw-semibold me-2">Production POV</span>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var pov in _productionPovOptions)
                                    {
                                        <button class="btn btn-sm @(_productionPov == pov ? "btn-primary" : "btn-outline-secondary")"
                                                disabled="@_busy" @onclick="() => SelectProductionPovAsync(pov)">@pov</button>
                                    }
                                </div>
                                <div class="form-text">POV is pinned with this exact Moment enrichment. Changing it loads a separate production group.</div>
                            </div>

                            <div class="scene-production-grid">
                                <section class="scene-production-main" aria-label="Production canvas">
                                    <div class="scene-production-stage-stepper" aria-label="Production stages">
                                        <span class="is-current"><strong>1</strong> Composition</span>
                                        <span><strong>2</strong> Identity</span>
                                        <span><strong>3</strong> Finish</span>
                                    </div>

                                    <div class="scene-production-canvas">
                                        @if (_selectedProductionAttempt is null)
                                        {
                                            <div class="scene-production-empty text-muted">
                                                @if (_productionGroup is null)
                                                {
                                                    <span>Create or load the production group to generate its first Composition.</span>
                                                }
                                                else
                                                {
                                                    <span>No production attempts yet.</span>
                                                }
                                            </div>
                                        }
                                        else if (_selectedProductionAttempt.Status == SceneImageStatus.Complete
                                            && !string.IsNullOrWhiteSpace(_selectedProductionAttempt.FileRelativePath))
                                        {
                                            <img src="/scene-images/@_selectedProductionAttempt.FileRelativePath"
                                                 class="scene-production-canvas-image" alt="Selected production attempt"
                                                 @onclick="() => OpenViewer(_selectedProductionAttempt)" />
                                        }
                                        else if (_selectedProductionAttempt.BytesPurgedUtc is not null)
                                        {
                                            <div class="scene-production-empty text-muted">
                                                Image bytes were purged; attempt metadata and checksum remain.
                                            </div>
                                        }
                                        else if (_selectedProductionAttempt.Status is SceneImageStatus.Pending or SceneImageStatus.Generating)
                                        {
                                            <div class="scene-production-empty text-muted">
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                Composition @_selectedProductionAttempt.Status.ToString().ToLowerInvariant()...
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="scene-production-empty text-danger">
                                                Composition failed: @(_selectedProductionAttempt.ErrorMessage ?? "No provider error was recorded.")
                                            </div>
                                        }
                                    </div>

                                    <div class="scene-production-stage-controls mt-3">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <strong>Composition</strong>
                                            <button class="btn btn-sm btn-primary"
                                                    disabled="@(_busy || _productionGroup is null || _compiledMediaBrief is null)"
                                                    @onclick="GeneratePromptAsync">
                                                <i class="bi bi-magic me-1"></i> Generate Prompt
                                            </button>
                                            <button class="btn btn-sm btn-success"
                                                    disabled="@(_busy || _productionGroup is null || _compiledMediaBrief is null || _activePrompt?.Status != SceneImagePromptStatus.Complete || string.IsNullOrWhiteSpace(_editablePrompt) || _productionAttempts.Any(attempt => attempt.Status is SceneImageStatus.Pending or SceneImageStatus.Generating))"
                                                    @onclick="GenerateProductionCompositionAsync">
                                                <i class="bi bi-image me-1"></i> Generate Composition
                                            </button>
                                            <button class="btn btn-sm btn-outline-success"
                                                    disabled="@(_busy || _productionGroup is null || _compiledMediaBrief is null || _activePrompt?.Status != SceneImagePromptStatus.Complete || string.IsNullOrWhiteSpace(_editablePrompt) || !_productionIdentityPacks.Any(o => o.Selected) || _productionAttempts.Any(attempt => attempt.Status is SceneImageStatus.Pending or SceneImageStatus.Generating))"
                                                    @onclick="GenerateProductionCompositionWithIdentityAsync">
                                                <i class="bi bi-person-badge me-1"></i> + Identity
                                            </button>
                                            @if (_selectedProductionAttempt?.Status == SceneImageStatus.Complete
                                                && _selectedProductionAttempt.ProductionStage == SceneImageProductionStage.Composition)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        disabled="@(_busy || _productionAttempts.Any(attempt => attempt.Status is SceneImageStatus.Pending or SceneImageStatus.Generating))"
                                                        @onclick="() => RegenerateProductionCompositionAsync(_selectedProductionAttempt)">
                                                    <i class="bi bi-arrow-repeat me-1"></i> Regenerate Sibling
                                                </button>
                                            }
                                        </div>

                                        <div class="mt-3">
                                            <label class="form-label small fw-semibold mb-1">Image Prompt</label>
                                            <textarea class="form-control font-monospace" rows="4" @bind="_editablePrompt"
                                                      placeholder="Generate a prompt to project this compiled Still brief into an image caption."></textarea>
                                            <div class="form-text">@WordCount(_editablePrompt) words · ~@EstimateTokens(_editablePrompt) tokens</div>
                                        </div>

                                        <div class="mt-2">
                                            <label class="form-label small fw-semibold mb-1">Image Model</label>
                                            @if (_genericModelChoices.Count == 0)
                                            {
                                                <span class="text-muted d-block">No image models enabled.</span>
                                            }
                                            else
                                            {
                                                <select class="form-select form-select-sm" @bind="_selectedProductionModelId">
                                                    @foreach (var choice in _genericModelChoices)
                                                    {
                                                        <option value="@choice.ModelId">@choice.DisplayName — @choice.ProviderName</option>
                                                    }
                                                </select>
                                            }
                                        </div>

                                        <div class="mt-2">
                                            <label class="form-label small fw-semibold mb-1">Character Identity (one-pass)</label>
                                            @if (_identityModelChoices.Count == 0)
                                            {
                                                <span class="text-muted d-block">No identity-capable image models enabled. Configure an identity mechanism (IP-Adapter/PuLid) in Model Manager.</span>
                                            }
                                            else
                                            {
                                                <select class="form-select form-select-sm mb-2" @bind="_selectedProductionIdentityModelId">
                                                    @foreach (var choice in _identityModelChoices)
                                                    {
                                                        <option value="@choice.ModelId">@choice.DisplayName — @choice.ProviderName</option>
                                                    }
                                                </select>
                                            }
                                            @if (_productionIdentityPacks.Count == 0)
                                            {
                                                <span class="text-muted d-block">No approved identity packs. Create and approve one in <a href="/characters/identity">Character Identity</a>.</span>
                                            }
                                            else
                                            {
                                                @foreach (var opt in _productionIdentityPacks)
                                                {
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="checkbox" @bind="opt.Selected" id="@("prod_idp_" + opt.PackId)" />
                                                        <label class="form-check-label" for="@("prod_idp_" + opt.PackId)">@opt.Label</label>
                                                    </div>
                                                }
                                            }
                                        </div>

                                        <div class="form-text mt-1">Composition renders prompt-only with the selected image model; "+ Identity" folds the selected identity packs into the same render in one generation.</div>

                                        <div class="scene-production-unavailable mt-2">
                                            <strong>Finish</strong>
                                            <span>Unavailable: finish-stage source-image editing follows the identity boundary.</span>
                                        </div>
                                    </div>
                                </section>

                                <aside class="scene-production-inspector" aria-label="Production inspector">
                                    <h6>Selected Moment</h6>
                                    @if (_selectedMoment is not null && _productionFrozenState is not null)
                                    {
                                        <dl class="small mb-3">
                                            <dt>@_selectedMoment.Label</dt>
                                            <dd>@_productionFrozenState.VisualDescription</dd>
                                            <dt>Place</dt>
                                            <dd>@_productionFrozenState.Location · @_productionFrozenState.TimeOfDay · @_productionFrozenState.Lighting</dd>
                                            <dt>Environment</dt>
                                            <dd>@_productionFrozenState.Environment</dd>
                                            <dt>Characters</dt>
                                            <dd>
                                                @foreach (var character in _productionFrozenState.Characters)
                                                {
                                                    <span class="d-block"><strong>@character.Name</strong>: @character.Position · @character.ActionOrObservation · @character.Clothing</span>
                                                }
                                            </dd>
                                        </dl>
                                    }

                                    <h6>Exact Lineage</h6>
                                    @if (_productionGroup is null)
                                    {
                                        <div class="small text-muted mb-3">No production group loaded.</div>
                                    }
                                    else
                                    {
                                        <dl class="small font-monospace mb-3">
                                            <dt>Group</dt><dd>@_productionGroup.Id</dd>
                                            <dt>Still brief</dt><dd>@(_compiledMediaBrief?.Id ?? "Not compiled")</dd>
                                            <dt>Catalogue</dt><dd>@_productionGroup.CatalogueId</dd>
                                            <dt>Plan</dt><dd>@_productionGroup.BeatProductionPlanId · v@_productionGroup.BeatProductionPlanVersion</dd>
                                            <dt>Moment Set</dt><dd>@_productionGroup.MomentSetId · v@_productionGroup.MomentSetVersion</dd>
                                            <dt>Moment</dt><dd>@_productionGroup.MomentId</dd>
                                            <dt>Enrichment</dt><dd>@_productionGroup.MomentEnrichmentId · r@_productionGroup.MomentEnrichmentRevision</dd>
                                            <dt>POV</dt><dd>@_productionGroup.Pov</dd>
                                            <dt>Status</dt><dd>@_productionGroup.Status</dd>
                                            <dt>Current approval</dt><dd>@(_currentApproval is null ? "None" : $"v{_currentApproval.Version} · {_currentApproval.SceneImageId}")</dd>
                                        </dl>
                                    }

                                    <h6>Selected Attempt</h6>
                                    @if (_selectedProductionAttempt is null)
                                    {
                                        <div class="small text-muted">No attempt selected.</div>
                                    }
                                    else
                                    {
                                        var parentId = _selectedProductionAttempt.SourceImageId ?? _selectedProductionAttempt.RegenerateOfId;
                                        <dl class="small mb-0">
                                            <dt>Operation / stage</dt><dd>@_selectedProductionAttempt.Operation · @_selectedProductionAttempt.ProductionStage</dd>
                                            <dt>Execution status</dt><dd><span class="badge text-bg-secondary">@_selectedProductionAttempt.Status</span></dd>
                                            <dt>Disposition</dt><dd><span class="badge text-bg-info">@_selectedProductionAttempt.Disposition</span></dd>
                                            <dt>Approval</dt><dd><span class="badge @(_currentApproval?.SceneImageId == _selectedProductionAttempt.Id ? "text-bg-success" : "text-bg-secondary")">@(_currentApproval?.SceneImageId == _selectedProductionAttempt.Id ? "Approved" : "Not approved")</span></dd>
                                            <dt>Model</dt><dd>@(_selectedProductionAttempt.ModelIdentifier ?? "Pending resolution")</dd>
                                            <dt>Checksum</dt><dd class="font-monospace">@(_selectedProductionAttempt.Sha256 ?? "Pending")</dd>
                                            <dt>Parent / source</dt><dd class="font-monospace">@(parentId ?? "Root attempt")</dd>
                                        </dl>
                                    }
                                </aside>
                            </div>

                            <div class="scene-production-attempts mt-3 pt-3 border-top">
                                <h6>Production Attempts</h6>
                                @foreach (var stage in new[] { SceneImageProductionStage.Composition, SceneImageProductionStage.Identity, SceneImageProductionStage.Finish })
                                {
                                    var stageAttempts = _productionAttempts.Where(attempt => attempt.ProductionStage == stage).ToList();
                                    <section class="scene-production-attempt-stage mt-2" aria-label="@stage attempts">
                                        <div class="small fw-semibold mb-1">@stage <span class="text-muted">(@stageAttempts.Count)</span></div>
                                        @if (stageAttempts.Count == 0)
                                        {
                                            <div class="small text-muted">No @stage attempts.</div>
                                        }
                                        else
                                        {
                                            <div class="scene-production-attempt-strip">
                                                @foreach (var attempt in stageAttempts)
                                                {
                                                    var parentId = attempt.SourceImageId ?? attempt.RegenerateOfId;
                                                    <div class="scene-production-attempt @(_selectedProductionAttemptId == attempt.Id ? "is-selected" : "")">
                                                        <button class="scene-production-attempt-select" title="Select attempt" @onclick="() => _selectedProductionAttemptId = attempt.Id">
                                                            @if (attempt.Status == SceneImageStatus.Complete && !string.IsNullOrWhiteSpace(attempt.FileRelativePath))
                                                            {
                                                                <img src="/scene-images/@attempt.FileRelativePath" alt="Production attempt thumbnail" />
                                                            }
                                                            else
                                                            {
                                                                <span>@attempt.Status</span>
                                                            }
                                                        </button>
                                                        <div class="small mt-1">
                                                            <span class="badge text-bg-secondary">@attempt.Status</span>
                                                            <span class="badge text-bg-info">@attempt.Disposition</span>
                                                            <span class="badge @(_currentApproval?.SceneImageId == attempt.Id ? "text-bg-success" : "text-bg-secondary")">@(_currentApproval?.SceneImageId == attempt.Id ? "Approved" : "Not approved")</span>
                                                        </div>
                                                        <div class="small text-muted text-truncate" title="@(parentId is null ? "Root attempt" : $"Parent/source: {parentId}")">
                                                            @(parentId is null ? "Root attempt" : $"From {parentId}")
                                                        </div>
                                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                                            @if (attempt.Disposition == SceneImageAttemptDisposition.Active)
                                                            {
                                                                <button class="btn btn-sm btn-outline-warning py-0 px-1" title="Shortlist attempt" disabled="@_busy"
                                                                        @onclick="() => SetProductionDispositionAsync(attempt, SceneImageAttemptDisposition.Shortlisted)"><i class="bi bi-star"></i></button>
                                                            }
                                                            else if (attempt.Disposition == SceneImageAttemptDisposition.Shortlisted)
                                                            {
                                                                <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Return attempt to Active" disabled="@_busy"
                                                                        @onclick="() => SetProductionDispositionAsync(attempt, SceneImageAttemptDisposition.Active)"><i class="bi bi-star-fill"></i></button>
                                                            }
                                                            @if (attempt.Disposition is SceneImageAttemptDisposition.Active or SceneImageAttemptDisposition.Shortlisted)
                                                            {
                                                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Mark attempt Rejected" disabled="@_busy"
                                                                        @onclick="() => SetProductionDispositionAsync(attempt, SceneImageAttemptDisposition.Rejected)"><i class="bi bi-x-circle"></i></button>
                                                            }
                                                            @if (attempt.Status == SceneImageStatus.Complete && !string.IsNullOrWhiteSpace(attempt.Sha256))
                                                            {
                                                                <button class="btn btn-sm btn-outline-success py-0 px-1" title="Approve this exact completed attempt" disabled="@_busy"
                                                                        @onclick="() => ApproveProductionAttemptAsync(attempt)"><i class="bi bi-check2-circle"></i></button>
                                                            }
                                                            @if (attempt.Disposition == SceneImageAttemptDisposition.Rejected
                                                                && attempt.BytesPurgedUtc is null
                                                                && !string.IsNullOrWhiteSpace(attempt.FileRelativePath))
                                                            {
                                                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Purge rejected image bytes; keep metadata" disabled="@_busy"
                                                                        @onclick="() => PurgeProductionAttemptAsync(attempt)"><i class="bi bi-trash3"></i></button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                            </div>
                        }
                    </div>
                    }
                </div>

                <div class="card mb-3 scene-image-legacy-tools">
                    <div class="card-header p-0">
                        <button class="studio-collapse-toggle studio-collapse-toggle-full px-3 py-2" @onclick="ToggleLegacyTools" type="button">
                            <strong>Legacy / Experimental Tools</strong>
                            <i class="bi @(_legacyToolsOpen ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></i>
                        </button>
                    </div>
                    @if (_legacyToolsOpen)
                    {
                        <div class="card-body">
                            <div class="small text-muted mb-2">Prompt compilation and identity-conditioned text-to-image remain available during production workflow migration.</div>

                            <div class="card mb-3">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <strong>Historical Image Plan <span class="text-muted small">schema v3, read-only</span></strong>
                                </div>
                                <div class="card-body small">
                                    <div class="alert alert-secondary py-2 mb-2">
                                        Historical schema-v3 data remains visible for existing images. New production prompts use the canonical compiled Still brief.
                                    </div>
                                    @if (_fullTurn?.Turn is null)
                                    {
                                        <span class="text-muted">This legacy interaction has no persisted turn, so it cannot be analyzed into image beats.</span>
                                    }
                                    else if (_beatAnalysis is null)
                                    {
                                        <span class="text-muted">No historical schema-v3 plan is stored for this turn.</span>
                                    }
                                    else if (_beatAnalysis.Status == SceneImageBeatAnalysisStatus.Pending)
                                    {
                                        <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Analyzing the full turn into image beats...</span>
                                    }
                                    else if (_beatAnalysis.Status == SceneImageBeatAnalysisStatus.Failed)
                                    {
                                        <div class="alert alert-danger py-2 mb-0">Beat analysis failed: @_beatAnalysis.ErrorMessage</div>
                                    }
                                    else if (_requiresBeatRegeneration)
                                    {
                                        <div class="alert alert-warning py-2 mb-0">This historical plan uses an older schema and remains available for inspection only.</div>
                                    }
                                    else
                                    {
                                        <div class="d-grid gap-2 scene-image-beat-list">
                                            @foreach (var beat in _analysis?.Beats ?? [])
                                            {
                                                <button class="btn text-start @(_selectedBeatId == beat.BeatId ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SelectBeatAsync(beat.BeatId)">
                                                    <strong>@beat.Order. @beat.Label</strong>
                                                    <span class="d-block small">@beat.VisualDescription</span>
                                                    <span class="d-block small">@beat.Location · @beat.TimeOfDay</span>
                                                    <span class="d-block small">@beat.Lighting · @beat.Mood</span>
                                                    @foreach (var character in beat.Characters)
                                                    {
                                                        <span class="d-block small mt-1">
                                                            <strong>@character.Name</strong> · @character.Involvement · @character.Position<br />
                                                            @character.ActionOrObservation · looking @character.Sightline<br />
                                                            Clothing: @character.Clothing · Visible: @(character.VisibleCharacterNames.Count == 0 ? "none" : string.Join(", ", character.VisibleCharacterNames))
                                                        </span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="card mb-3">
                                <div class="card-header"><strong>Image Settings</strong></div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Style</label>
                                <select class="form-select form-select-sm" @bind="_settings.Style">
                                    <option value="realistic">Realistic</option>
                                    <option value="cinematic">Cinematic</option>
                                    <option value="anime">Anime</option>
                                    <option value="cartoon">Cartoon</option>
                                    <option value="painterly">Painterly</option>
                                    <option value="sketch">Sketch</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Size</label>
                                <select class="form-select form-select-sm" @bind="_settings.ImageSize">
                                    <option value="512x512">512 x 512</option>
                                    <option value="768x768">768 x 768</option>
                                    <option value="1024x1024">1024 x 1024</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Aspect Ratio (optional)</label>
                                <input type="text" class="form-control form-control-sm" @bind="_settings.AspectRatio" placeholder="e.g. 16:9" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Seed (optional, blank = random)</label>
                                <input type="number" class="form-control form-control-sm" @bind="_settings.Seed"
                                       placeholder="e.g. 24680" />
                            </div>
                            <div class="col-12">
                                <div class="form-text">A fixed seed makes a render reproducible; leave blank for a random seed each time. Only honored for the ComfyUI protocol.</div>
                                @if (_resolvedPolicy == ImageContentPolicy.SfwFiltered)
                                {
                                    <div class="alert alert-warning py-2 small mb-2">
                                        <i class="bi bi-shield-lock me-1"></i>
                                        The configured image provider filters adult content — the prompt is clamped to safe-for-work.
                                    </div>
                                }
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="studio-explicit" @bind="_settings.AllowExplicitImage" disabled="@(_resolvedPolicy == ImageContentPolicy.SfwFiltered)" />
                                    <label class="form-check-label @(_resolvedPolicy == ImageContentPolicy.SfwFiltered ? "text-muted" : "")" for="studio-explicit">Allow explicit content</label>
                                    <div class="form-text">Only honored when the configured image provider's content policy is adult-allowed; otherwise the prompt is clamped to safe-for-work.</div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-2 mt-2">
                            <div class="col-6 col-md-3">
                                <label class="form-label">CFG</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="_settings.Cfg" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Steps</label>
                                <input type="number" class="form-control form-control-sm" @bind="_settings.Steps" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label">Sampler</label>
                                <select class="form-select form-select-sm" @bind="_settings.SamplerName">
                                    <option value="dpmpp_2m">dpmpp_2m</option>
                                    <option value="dpmpp_2m_sde">dpmpp_2m_sde</option>
                                    <option value="euler">euler</option>
                                    <option value="euler_ancestral">euler_ancestral</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label">Scheduler</label>
                                <select class="form-select form-select-sm" @bind="_settings.Scheduler">
                                    <option value="karras">karras</option>
                                    <option value="normal">normal</option>
                                    <option value="simple">simple</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label">Clip Skip</label>
                                <select class="form-select form-select-sm" @bind="_settings.ClipSkip">
                                    <option value="">None</option>
                                    <option value="-1">1</option>
                                    <option value="-2">2</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-text">Sampler/CLIP options default to the suggested Juggernaut values and apply to the ComfyUI (SDXL/Juggernaut) workflow only.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header"><strong>Legacy Selected Beat and POV</strong></div>
                    <div class="card-body small">
                        @if (_selectedBeat is null)
                        {
                            <span class="text-muted">Choose a generated beat on the left.</span>
                        }
                        else
                        {
                            <div><strong>@_selectedBeat.Label</strong> · @_selectedBeat.Location · @_selectedBeat.TimeOfDay</div>
                            <div class="mt-1">@_selectedBeat.VisualDescription</div>
                            <div class="text-muted mt-1">@_selectedBeat.Environment</div>
                            <div class="text-muted">Lighting: @_selectedBeat.Lighting · Mood: @_selectedBeat.Mood</div>
                            <label class="form-label small mt-3 mb-1">POV</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var pov in _povOptions)
                                {
                                    <button class="btn btn-sm @(_selectedPov == pov ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SelectPovAsync(pov)">@pov</button>
                                }
                            </div>
                            @if (_selectedPov == SceneImagePovFramer.Omniscient)
                            {
                                <label class="form-label small mt-3 mb-1">Camera Angle (Omniscient)</label>
                                <select class="form-select form-select-sm" value="@_selectedAngle" @onchange="OnOmniscientAngleChanged">
                                    <option value="">Default (neutral wide)</option>
                                    @foreach (var angle in OmniscientAngles)
                                    {
                                        <option value="@angle">@angle</option>
                                    }
                                </select>
                                <div class="form-text">Adjust the external fly-on-the-wall camera angle for this scene.</div>
                            }
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Production Image Prompt</strong>
                        <button class="btn btn-sm btn-primary" @onclick="GeneratePromptAsync" disabled="@(_busy || _productionGroup is null || _compiledMediaBrief is null)">
                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            <i class="bi bi-magic me-1"></i> Generate Prompt
                        </button>
                    </div>
                    <div class="card-body">
                        @if (_activePrompt is not null && _activePrompt.Status == SceneImagePromptStatus.Pending)
                        {
                            <div class="text-muted small mb-2"><span class="spinner-border spinner-border-sm me-1"></span>Generating prompt…</div>
                        }
                        @if (_activePrompt is not null && _activePrompt.Status == SceneImagePromptStatus.Failed)
                        {
                            <div class="alert alert-danger py-2 small">Prompt generation failed: @_activePrompt.ErrorMessage</div>
                        }
                        <textarea class="form-control font-monospace" rows="5" @bind="_editablePrompt"
                                  placeholder="The pre-processor will draft an image prompt here. You can edit it before rendering."></textarea>
                        <div class="form-text">
                            @WordCount(_editablePrompt) words · ~@EstimateTokens(_editablePrompt) tokens
                            @if (EstimateTokens(_editablePrompt) > 77)
                            {
                                <span class="text-warning fw-semibold">⚠ Prompt exceeds the suggested 77-token limit — consider shortening.</span>
                            }
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <input type="text" class="form-control form-control-sm" @bind="_refineInstruction"
                                   placeholder="Refine instruction, e.g. 'more atmospheric' or 'tighter framing'" />
                            <button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="RefinePromptAsync" disabled="@_busy">
                                <i class="bi bi-arrow-repeat me-1"></i> Refine
                            </button>
                        </div>
                        <label class="form-label mt-3 mb-1 small fw-semibold">Negative Prompt (optional)</label>
                        <textarea class="form-control font-monospace" rows="3" @bind="_settings.NegativePrompt"
                                  placeholder="Optional guard terms (e.g. deformed, extra limbs, low quality). Leave blank to use the automatic negative."></textarea>
                    </div>
                </div>

                @if (_analysis is not null)
                {
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>Legacy Prompt Analysis</strong>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showAnalysis = !_showAnalysis">
                                @(_showAnalysis ? "Hide" : "Show")
                            </button>
                        </div>
                        @if (_showAnalysis)
                        {
                            <div class="card-body small">
                                <div class="mb-2">
                                    <span class="text-muted">Participants:</span>
                                    @if (_analysis.Participants.Count == 0)
                                    {
                                        <span class="text-muted"> none</span>
                                    }
                                    else
                                    {
                                        <ul class="mb-0">
                                            @foreach (var p in _analysis.Participants)
                                            {
                                                <li><strong>@p.Name</strong> — @p.Presence (@p.Reason)</li>
                                            }
                                        </ul>
                                    }
                                </div>
                                @if (_analysis.Excluded.Count > 0)
                                {
                                    <div class="mb-2">
                                        <span class="text-muted">Excluded:</span>
                                        <ul class="mb-0">
                                            @foreach (var p in _analysis.Excluded)
                                            {
                                                <li><strong>@p.Name</strong> — @p.Reason</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_analysis.TurnId))
                                {
                                    <div class="text-muted">Turn: @_analysis.TurnId</div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Legacy Exact Preprocessor Request</strong>
                        @if (_preprocessorPrompt is not null)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showPreprocessorPrompts = !_showPreprocessorPrompts">
                                @(_showPreprocessorPrompts ? "Hide" : "Show")
                            </button>
                        }
                    </div>
                    <div class="card-body small">
                        @if (_activePrompt is null)
                        {
                            <span class="text-muted">Generate a prompt to inspect the exact system and user prompts sent to the preprocessor.</span>
                        }
                        else if (_preprocessorPrompt is null)
                        {
                            <span class="text-muted">The preprocessor request for this prompt is not available yet. It appears here after the background job records the sent request.</span>
                        }
                        else
                        {
                            <div class="text-muted mb-2">
                                Exact request stored @(_preprocessorPrompt.CreatedUtc.ToLocalTime().ToString("g")) for prompt record <span class="font-monospace">@_preprocessorPrompt.PromptRecordId</span>.
                            </div>
                            @if (_showPreprocessorPrompts)
                            {
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">System Prompt</label>
                                    <pre class="scene-image-preprocessor-prompt mb-0">@_preprocessorPrompt.SystemPrompt</pre>
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold">User Prompt</label>
                                    <pre class="scene-image-preprocessor-prompt mb-0">@_preprocessorPrompt.UserPrompt</pre>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Legacy Identity-Conditioned Render</strong>
                        <button class="btn btn-sm btn-success" @onclick="RenderIdentityImageAsync"
                            disabled="@(_busy || !IsSelectedMomentEnriched || HasInFlightWork() || string.IsNullOrWhiteSpace(_editablePrompt) || _activePrompt is null || !_identityPackOptions.Any(o => o.Selected))">
                            <i class="bi bi-person-badge me-1"></i> Render with Identity
                        </button>
                    </div>
                    <div class="card-body small">
                        <label class="form-label mb-1">Image Model (identity-capable)</label>
                        @if (_identityModelChoices.Count == 0)
                        {
                            <span class="text-muted d-block mb-2">No identity-capable image models enabled. Configure an identity mechanism (IP-Adapter/PuLid) on an image model in Model Manager.</span>
                        }
                        else
                        {
                            <select class="form-select form-select-sm mb-2" @bind="_selectedIdentityModelId">
                                @foreach (var choice in _identityModelChoices)
                                {
                                    <option value="@choice.ModelId">@choice.DisplayName — @choice.ProviderName</option>
                                }
                            </select>
                        }
                        @if (_identityPackOptions.Count == 0)
                        {
                            <span class="text-muted">No approved identity packs yet. Create and approve one in
                                <a href="/characters/identity">Character Identity</a> to render a recurring character with face conditioning.</span>
                        }
                        else
                        {
                            <label class="form-label mb-1">Approved Identity Packs (select one or more)</label>
                            <div class="list-group list-group-flush">
                                @foreach (var opt in _identityPackOptions)
                                {
                                    <div class="list-group-item d-flex align-items-center gap-2 px-0">
                                        <input type="checkbox" class="form-check-input m-0" @bind="opt.Selected" id="@("idp_" + opt.PackId)" />
                                        <label class="form-check-label flex-grow-1 mb-0" for="@("idp_" + opt.PackId)">@opt.Label</label>
                                        <input type="number" class="form-control form-control-sm" style="width: 90px;"
                                               @bind="opt.Strength" min="0" max="2" step="0.05"
                                               placeholder="strength" title="Optional per-character strength override; defaults to the model's configured identity strength" />
                                    </div>
                                }
                            </div>
                            <div class="form-text">Selecting more than one pack chains IP-Adapter face conditioning with a per-character regional mask (the verified two-character workflow). Strength overrides the model's configured identity strength.</div>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Legacy Images</strong>
                        <button class="btn btn-sm btn-success" @onclick="RenderImageAsync"
                            disabled="@(_busy || !IsSelectedMomentEnriched || HasInFlightWork() || string.IsNullOrWhiteSpace(_editablePrompt) || _activePrompt is null)">
                            <i class="bi bi-image me-1"></i> Render Image
                        </button>
                    </div>
                    <div class="card-body">
                        <label class="form-label mb-1">Image Model</label>
                        @if (_genericModelChoices.Count == 0)
                        {
                            <span class="text-muted d-block mb-2">No image models enabled in Model Manager.</span>
                        }
                        else
                        {
                            <select class="form-select form-select-sm mb-2" @bind="_selectedGenericModelId">
                                @foreach (var choice in _genericModelChoices)
                                {
                                    <option value="@choice.ModelId">@choice.DisplayName — @choice.ProviderName</option>
                                }
                            </select>
                        }
                        @if (!_legacyImages.Any())
                        {
                            <div class="text-muted small">No images yet. Generate a prompt, then render an image.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var img in _legacyImages)
                                {
                                    <div class="border rounded p-2" style="width: 220px;">
                                        @if (img.Status == SceneImageStatus.Complete && !string.IsNullOrWhiteSpace(img.FileRelativePath))
                                        {
                                            <img src="/scene-images/@img.FileRelativePath" class="img-fluid rounded scene-image-thumb" alt="Scene image"
                                                 @onclick="() => OpenViewer(img)" />
                                        }
                                        else if (img.Status == SceneImageStatus.Generating || img.Status == SceneImageStatus.Pending)
                                        {
                                            <div class="d-flex align-items-center justify-content-center" style="height: 120px;">
                                                <span class="spinner-border spinner-border-sm me-2"></span><span class="small">Rendering…</span>
                                            </div>
                                        }
                                        else if (img.Status == SceneImageStatus.Failed)
                                        {
                                            <div class="alert alert-danger py-2 small mb-0">Image failed: @img.ErrorMessage</div>
                                        }
                                        <div class="d-flex justify-content-between align-items-center mt-1">
                                            <small class="text-muted">@img.Style · @img.ImageSize</small>
                                            <span>
                                                @if (img.Status == SceneImageStatus.Complete)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary py-0 px-1" title="Edit this image" disabled="@_busy"
                                                        @onclick="() => OpenImageEditor(img)"><i class="bi bi-pencil-square"></i></button>
                                                    <button class="btn btn-sm btn-outline-secondary scene-image-continue-btn py-0 px-1" title="Continue from this image (reuse prompt + settings)" disabled="@_busy"
                                                            @onclick="() => ContinueFromImageAsync(img)">&#8635;</button>
                                                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Regenerate (keeps this version)" disabled="@(_busy || HasInFlightWork())"
                                                            @onclick="() => RegenerateImageAsync(img)">&#128260;</button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Delete image" disabled="@_busy"
                                                        @onclick="() => RequestDeleteImageAsync(img)">&#x2715;</button>
                                            </span>
                                        </div>
                                        @if (_continueFromImageId == img.Id)
                                        {
                                            <div class="alert alert-success py-1 px-2 small mt-1 mb-0">Loaded prompt + settings from this image. Edit and Render to continue.</div>
                                        }
                                        @if (_pendingDeleteImageId == img.Id)
                                        {
                                            <div class="d-flex gap-2 mt-1 align-items-center">
                                                <small class="text-danger">Delete this image?</small>
                                                <button class="btn btn-sm btn-danger py-0 px-2" disabled="@_busy" @onclick="() => ConfirmDeleteImageAsync(img)">Delete</button>
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" disabled="@_busy" @onclick="CancelDeleteImage">Keep</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    }
</div>

@if (_viewerImage is not null)
{
    <div class="scene-image-viewer-overlay" @onclick="CloseViewer">
        <div class="scene-image-viewer" @onclick:stopPropagation="true">
            <div class="scene-image-viewer-header">
                <span class="text-muted small">@_viewerImage.Style · @_viewerImage.ImageSize</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseViewer" title="Close (Esc)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <img src="/scene-images/@_viewerImage.FileRelativePath" class="scene-image-viewer-img" alt="Scene image" />
            <div class="scene-image-viewer-footer">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CloseViewer()">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    [Parameter]
    public string sessionId { get; set; } = string.Empty;

    [Parameter]
    public string interactionId { get; set; } = string.Empty;

    private RolePlaySession? _session;
    private RolePlayInteraction? _interaction;
    private SceneImagePromptRecord? _activePrompt;
    private SceneImageStudioSettings _settings = new();
    private List<SceneImageRecord> _images = [];
    private string _editablePrompt = string.Empty;

    private static int WordCount(string text) =>
        string.IsNullOrWhiteSpace(text) ? 0 : text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private static int EstimateTokens(string text) =>
        string.IsNullOrWhiteSpace(text) ? 0 : (int)Math.Ceiling(text.Length / 4.0);

    private string _refineInstruction = string.Empty;
    private string _statusMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _busy;
    private bool _polling;
    private CancellationTokenSource? _pollingCts;
    private Task? _pollingTask;
    private ImageContentPolicy? _resolvedPolicy;
    private string? _policyResolutionError;
    private string? _pendingDeleteImageId;
    private bool _settingsSeeded;
    private string? _continueFromImageId;
    private Dictionary<string, IntensityProfile> _intensityProfilesById = new(StringComparer.OrdinalIgnoreCase);
    private FullTurnContext? _fullTurn;
    private SceneBeatCatalogue? _catalogue;
    private bool _replaceCatalogueRequested;
    private string? _selectedCatalogueBeatId;
    private bool _cataloguePinned;
    private SceneBeatProductionPlan? _productionPlan;
    private bool _replaceProductionRequested;
    private SceneMomentSet? _momentSet;
    private bool _replaceMomentsRequested;
    private string? _selectedMomentId;
    private bool _momentsPinned;
    private SceneMomentEnrichment? _momentEnrichment;
    private bool _replaceEnrichmentRequested;
    private SceneImageProductionGroup? _productionGroup;
    private CompiledMediaBrief? _compiledMediaBrief;
    private List<SceneImageRecord> _productionAttempts = [];
    private List<ApprovedSceneFrameDecision> _approvalDecisions = [];
    private string? _selectedProductionAttemptId;
    private string? _productionPov;
    private SceneImageBeatAnalysisRecord? _beatAnalysis;
    private bool _requiresBeatRegeneration;
    private SceneImageAnalysisResult? _analysis;
    private bool _showAnalysis;
    private SceneImagePreprocessorPromptAudit? _preprocessorPrompt;
    private bool _showPreprocessorPrompts;
    private string? _selectedBeatId;
    private string? _selectedPov;
    private SceneImageRecord? _viewerImage;

    // Studio layout: the Story Moment panel and the Legacy / Experimental Tools panel are
    // collapsible and collapsed by default. The Story Moment panel hosts tabs for the story
    // moment itself, the full turn context, and the scene context.
    private bool _storyMomentOpen;
    private bool _legacyToolsOpen;
    private enum StoryPanelTab { StoryMoment, FullTurnContext }
    private StoryPanelTab _storyTab = StoryPanelTab.StoryMoment;

    // Per-panel collapse state. Story Moment and Legacy tools collapse by default; the
