    private async Task LoadPreprocessorPromptAsync()
    {
        if (_activePrompt is null)
        {
            _preprocessorPrompt = null;
            return;
        }

        if (string.Equals(_preprocessorPrompt?.PromptRecordId, _activePrompt.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _preprocessorPrompt = null;
        try
        {
            var events = await DebugEventService.QuerySessionEventsAsync(sessionId, eventKind: "SceneImagePromptSent", take: 100);
            foreach (var debugEvent in events.Reverse())
            {
                if (!string.Equals(debugEvent.InteractionId, interactionId, StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var promptAudit = TryReadPreprocessorPromptAudit(debugEvent.MetadataJson, debugEvent.CreatedUtc);
                if (promptAudit is not null
                    && string.Equals(promptAudit.PromptRecordId, _activePrompt.Id, StringComparison.OrdinalIgnoreCase))
                {
                    _preprocessorPrompt = promptAudit;
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load preprocessor request for studio: SessionId={SessionId}, InteractionId={InteractionId}, PromptRecordId={PromptRecordId}", sessionId, interactionId, _activePrompt.Id);
        }
    }

    private static SceneImagePreprocessorPromptAudit? TryReadPreprocessorPromptAudit(string metadataJson, DateTime createdUtc)
    {
        try
        {
            using var document = JsonDocument.Parse(metadataJson);
            var metadata = document.RootElement;
            if (!metadata.TryGetProperty("promptRecordId", out var promptRecordId)
                || promptRecordId.ValueKind != JsonValueKind.String
                || !metadata.TryGetProperty("systemPrompt", out var systemPrompt)
                || systemPrompt.ValueKind != JsonValueKind.String
                || !metadata.TryGetProperty("userPrompt", out var userPrompt)
                || userPrompt.ValueKind != JsonValueKind.String)
            {
                return null;
            }

            return new SceneImagePreprocessorPromptAudit(
                promptRecordId.GetString() ?? string.Empty,
                systemPrompt.GetString() ?? string.Empty,
                userPrompt.GetString() ?? string.Empty,
                createdUtc);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>
    /// Loads (or computes) the scene-image analysis for this interaction (CR-006 P3/P4) so the
    /// Beat selector + POV selector + "Why this prompt?" panel show immediately on studio open —
    /// not only after a prompt has been generated. Prefers the persisted
    /// <c>SceneImageAnalysisCompleted</c> debug event when present; otherwise computes it live from
    /// the full-turn context + deterministic beat analyzer.
    /// </summary>
    private async Task LoadBeatAnalysisAsync()
    {
        if (_fullTurn?.Turn is null)
        {
            _beatAnalysis = null;
            _analysis = null;
            _requiresBeatRegeneration = false;
            return;
        }
        _beatAnalysis = await ImageService.GetBeatAnalysisByTurnAsync(sessionId, _fullTurn.Turn.TurnId);
        if (_beatAnalysis?.Status == SceneImageBeatAnalysisStatus.Complete)
        {
            var beats = JsonSerializer.Deserialize<IReadOnlyList<SceneImageBeat>>(_beatAnalysis.BeatsJson, JsonOptions) ?? [];
            _requiresBeatRegeneration = beats.Count == 0
                || beats.Any(x => x.SchemaVersion != SceneImageBeatAnalysisService.CurrentSchemaVersion);
            _analysis = _requiresBeatRegeneration
                ? null
                : new SceneImageAnalysisResult { TurnId = _beatAnalysis.TurnId, Beats = beats, AnalysisStatus = "complete" };
        }
        else
        {
            _analysis = null;
            _requiresBeatRegeneration = false;
        }
    }

