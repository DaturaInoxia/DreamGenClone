            _approvalDecisions = [];
            _selectedProductionAttemptId = null;
            return;
        }

        EnsureProductionGroupMatchesSelection(_productionGroup);
    _compiledMediaBrief = await ProductionService.GetOrCreateStillBriefAsync(_productionGroup.Id);
    await LoadProductionPromptAsync();
        _productionAttempts = (await ProductionService.ListAttemptsAsync(_productionGroup.Id)).ToList();
        _approvalDecisions = (await ProductionService.ListApprovalDecisionsAsync(_productionGroup.Id)).ToList();
