    private async Task CreateOrLoadProductionAsync()
    {
        if (!IsSelectedMomentEnriched
            || _catalogue is null
            || _selectedCatalogueBeat is null
            || _productionPlan?.Status != SceneBeatCatalogueStatus.Complete
            || _momentSet?.Status != SceneBeatCatalogueStatus.Complete
            || _selectedMoment is null
            || _momentEnrichment is null
            || string.IsNullOrWhiteSpace(_productionPov))
        {
            throw new InvalidOperationException("Exact completed Catalogue, Beat Production Plan, Moment Set, Moment enrichment, and production POV are required.");
        }

        await RunAsync(async () =>
        {
            _productionGroup = await ProductionService.GetOrCreateGroupAsync(new(
                sessionId,
                interactionId,
                _catalogue.Id,
                _selectedCatalogueBeat.BeatId,
                _productionPlan.Id,
                _productionPlan.Version,
                _momentSet.Id,
                _momentSet.Version,
                _selectedMoment.MomentId,
                _momentEnrichment.Id,
                _momentEnrichment.Revision,
                _productionPov,
                null));
            _compiledMediaBrief = await ProductionService.GetOrCreateStillBriefAsync(_productionGroup.Id);
            await LoadProductionGroupAsync();
            _statusMessage = "Production group and compiled Still brief are ready for the exact selected Moment and POV.";
        });
    }

    private void EnsureProductionGroupMatchesSelection(SceneImageProductionGroup group)
    {
        if (_catalogue is null
            || _selectedCatalogueBeat is null
            || _productionPlan is null
            || _momentSet is null
            || _selectedMoment is null
            || _momentEnrichment is null
            || !string.Equals(group.SessionId, sessionId, StringComparison.Ordinal)
            || !string.Equals(group.InteractionId, interactionId, StringComparison.Ordinal)
            || !string.Equals(group.CatalogueId, _catalogue.Id, StringComparison.Ordinal)
            || !string.Equals(group.BeatId, _selectedCatalogueBeat.BeatId, StringComparison.Ordinal)
            || !string.Equals(group.BeatProductionPlanId, _productionPlan.Id, StringComparison.Ordinal)
            || group.BeatProductionPlanVersion != _productionPlan.Version
            || !string.Equals(group.MomentSetId, _momentSet.Id, StringComparison.Ordinal)
            || group.MomentSetVersion != _momentSet.Version
            || !string.Equals(group.MomentId, _selectedMoment.MomentId, StringComparison.Ordinal)
            || !string.Equals(group.MomentEnrichmentId, _momentEnrichment.Id, StringComparison.Ordinal)
            || group.MomentEnrichmentRevision != _momentEnrichment.Revision
            || !string.Equals(group.Pov, _productionPov, StringComparison.Ordinal))
        {
            throw new InvalidOperationException($"Production group '{group.Id}' does not match the exact selected lineage and POV.");
        }
    }

    private Task GenerateProductionCompositionAsync()
        => EnqueueProductionCompositionAsync(null);

    private Task RegenerateProductionCompositionAsync(SceneImageRecord source)
    {
        if (source.Status != SceneImageStatus.Complete
            || source.ProductionStage != SceneImageProductionStage.Composition)
        {
            throw new InvalidOperationException("Production regeneration requires a completed Composition attempt.");
        }
        return EnqueueProductionCompositionAsync(source.Id);
    }

    private async Task EnqueueProductionCompositionAsync(string? regenerateOfId)
    {
        if (_productionGroup is null
            || _compiledMediaBrief is null
            || _activePrompt?.Status != SceneImagePromptStatus.Complete
            || string.IsNullOrWhiteSpace(_editablePrompt)
            || string.IsNullOrWhiteSpace(_productionPov))
        {
            throw new InvalidOperationException("A production group and completed nonblank prompt are required for Composition.");
        }
        EnsureProductionGroupMatchesSelection(_productionGroup);
        if (!string.Equals(_activePrompt.ProductionGroupId, _productionGroup.Id, StringComparison.Ordinal)
            || !string.Equals(_activePrompt.CompiledMediaBriefId, _compiledMediaBrief.Id, StringComparison.Ordinal))
            throw new InvalidOperationException("The active prompt does not belong to the exact production group and compiled Still brief.");

        await RunAsync(async () =>
        {
            await ImageService.UpdatePromptOutputAsync(sessionId, _activePrompt.Id, _editablePrompt.Trim());
            var record = await ImageService.EnqueueRenderAsync(new SceneRenderRequest
            {
                SessionId = sessionId,
                InteractionId = interactionId,
                PromptRecordId = _activePrompt.Id,
                Prompt = _editablePrompt.Trim(),
                ImageSize = _settings.ImageSize,
                SettingsJson = JsonSerializer.Serialize(_settings),
                RegenerateOfId = regenerateOfId,
                ProductionGroupId = _productionGroup.Id,
                CompiledMediaBriefId = _activePrompt.CompiledMediaBriefId,
                BeatId = _productionGroup.BeatId,
                Pov = _productionGroup.Pov
            });
            await LoadProductionGroupAsync();
            _selectedProductionAttemptId = record.Id;
            _statusMessage = regenerateOfId is null
                ? "Production Composition queued."
                : "Sibling Production Composition queued.";
            EnsurePolling();
        });
    }

