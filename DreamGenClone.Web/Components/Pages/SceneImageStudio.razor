        }
        await LoadMomentSetAsync();
    }

    private async Task LoadMomentSetAsync()
    {
        var previousMomentSetId = _momentSet?.Id;
        _momentSet = _productionPlan?.Status == SceneBeatCatalogueStatus.Complete
            ? await MomentDiscoveryService.GetCurrentAsync(_productionPlan.Id)
            : null;
        if (previousMomentSetId is not null
            && !string.Equals(previousMomentSetId, _momentSet?.Id, StringComparison.Ordinal))
        {
            _momentsPinned = false;
            ClearProductionState();
        }
        if (_selectedMomentId is not null
            && (_momentSet is null || !_momentSet.Moments.Any(moment => moment.MomentId == _selectedMomentId)))
        {
            _selectedMomentId = null;
            _momentsPinned = false;
