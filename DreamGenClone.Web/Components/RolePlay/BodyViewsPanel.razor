@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.ImageStep
@using DreamGenClone.Web.Application.RolePlay.Models
@using DreamGenClone.Web.Application.Scenarios
@using DreamGenClone.Components.Assets
@inject ICharacterIdentityBodyService BodyService
@inject ISceneAssetService AssetService
@inject IImageCellPromptCompiler PromptCompiler
@inject IImageCompilerProfileRepository CompilerProfiles
@inject IModelResolutionService ModelResolutionService
@inject NavigationManager Navigation
@implements IDisposable

@* B-122 E-2: the clothed and unclothed view grids. One row per canonical slot, one request per row, and no batch
   action anywhere in this panel — the same one-view-at-a-time contract the face pipeline uses. Extended views get
   their own row because a pack slot cannot name a rotation. *@

@if (string.IsNullOrWhiteSpace(BuildId))
{
    <p class="text-muted small mb-0">The body build is not available yet, so there are no views to acquire.</p>
}
else
{
    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshViewsAsync" disabled="@_refreshing">Refresh views</button>
        @if (CanGenerate)
        {
            <span class="small text-muted">
                Model <strong>@ModelName</strong> · size <code>@ImageSize</code> — both come from
                <strong>Body view settings</strong> above, so every view of this body is rendered at the same quality
                setting. Every action below applies to the one view it is on; there is no batch and no "generate all".
            </span>
        }
        else
        {
            <span class="small text-warning">
                Set the body view model and image size in <strong>Body view settings</strong> above —
                <strong>Generate</strong>, <strong>Re-run</strong> and <strong>Edit from accepted source</strong> stay
                disabled until both are set. Neither is assumed.
            </span>
        }
        @if (_submitting.Count > 0 || _views.Any(view => view.Status == CharacterIdentityAngleStatus.Pending))
        {
            <span class="small text-muted"><i class="bi bi-hourglass-split me-1"></i>Rendering — this panel refreshes itself.</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_panelMessage))
    {
        <div class="alert @(_panelMessageIsError ? "alert-danger" : "alert-secondary") py-1 small mb-2">@_panelMessage</div>
    }

    @foreach (var state in BodyStates)
    {
        var slots = CharacterIdentityBodySlots.For(state)
            .Where(slot => SelectedSlot is null || (slot.State == SelectedSlot.State && slot.View == SelectedSlot.View))
            .ToList();
        if (slots.Count == 0)
        {
            continue;
        }

        var accepted = slots.Count(slot => ViewFor(slot)?.Status == CharacterIdentityAngleStatus.Accepted);
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@(SelectedSlot is null ? $"{state} views" : SelectedSlot.Label)</strong>
                @if (SelectedSlot is null)
                {
                    <span class="badge @(accepted == slots.Count ? "text-bg-success" : "text-bg-secondary")">@accepted / @slots.Count accepted</span>
                }
            </div>
            <div class="card-body">
                @foreach (var slot in slots)
                {
                    var key = CharacterIdentityBodyViewKey.Canonical(slot.State, slot.View);
                    var keyText = key.Describe();
                    var view = ViewFor(slot);
                    var open = SelectedSlot is not null || string.Equals(_openKey, keyText, StringComparison.Ordinal);
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-semibold small">@slot.Label</span>
                            @if (slot.IsBase)
                            {
                                <span class="badge text-bg-info">base</span>
                            }
                            <span class="badge @StatusBadge(view)">@(view?.Status.ToString() ?? "NotStarted")</span>
                            @if (IsSubmitting(keyText))
                            {
                                @* The request is in flight RIGHT NOW. Without this the operator sees every button on the
                                   panel go dead with nothing to say why, and concludes the click did nothing. *@
                                <span class="badge text-bg-info">
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Submitting…
                                </span>
                            }
                            @if (view is not null && view.QualityRating != SceneImageReferenceQuality.NotRated)
                            {
                                <span class="badge text-bg-light" title="@view.QualityNotes">quality: @view.QualityRating</span>
                            }
                            @if (view?.ManualOverrideApplied == true)
                            {
                                <span class="badge text-bg-warning" title="@view.ManualOverrideReason">override by @view.ManualOverrideAuthor</span>
                            }
                            @if (PreviewFor(view) is { } preview)
                            {
                                <button type="button" class="btn p-0 border-0 bg-transparent"
                                        title="Open this image full size"
                                        @onclick="() => OpenViewer(slot.Label, view)">
                                    <img src="@preview" class="border rounded" style="height:64px;width:64px;object-fit:cover;cursor:zoom-in;" alt="@slot.Label" />
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenViewer(slot.Label, view)">
                                    View image
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => ToggleAsync(key)">
                                @(open ? "Close" : "Open")
                            </button>
                        </div>

                        @if (view?.Status == CharacterIdentityAngleStatus.Blocked && !string.IsNullOrWhiteSpace(view.FailureReason))
                        {
                            <div class="small text-danger mt-1">@view.FailureReason</div>
                        }

                        @* The prerequisite, stated BEFORE the button is pressed: an angle render is an accepted body turned,
                           so with no accepted source it can only refuse. The source is named from the SAME derivation rule
                           the render uses — an unclothed profile is rendered from its same-side three-quarter, not from the
                           front, so naming "the front" here would send the operator to a view that would not unblock them. *@
                        @if (PrerequisiteLabelFor(slot, key) is { } prerequisite)
                        {
                            <div class="small text-warning mt-1">
                                The <strong>@prerequisite</strong> is not accepted yet, so <strong>@GenerateLabelFor(slot)</strong>
                                would refuse: a view is that same body, turned. Accept the @prerequisite first.
                            </div>
                        }

                        @* A Pending row whose image was deleted can never complete: the poll watches for the artifact that
                           is gone. Said plainly rather than left as a row that renders forever. *@
                        @if (view?.Status == CharacterIdentityAngleStatus.Pending && MissingArtifact(view))
                        {
                            <div class="small text-warning mt-1">
                                This view is marked Pending, but its queued image no longer exists — it was deleted after
                                being queued, so nothing will arrive. Render it again.
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(MessageFor(keyText)))
                        {
                            <div class="small text-muted mt-1">@MessageFor(keyText)</div>
                        }

                        @if (open)
                        {
                            <div class="mt-2">
                                @* The image composition is the ONE shared step every surface uses: its Face, Body and Pose
                                   tabs bind the conditionings, and its prompt panel and Generate submit replace this
                                   panel's own prompt box and generate button. *@
                                @if (BodyViewBlueprint is { } blueprint)
                                {
                                    <ImageStepComposer Blueprint="blueprint"
                                                       ModelChoices="ModelChoices"
                                                       SelectedModelId="@ModelId"
                                                       SelectedModelIdChanged="OnModelChanged"
                                                       ModelPlaceholder="Select model…"
                                                       AutoSelectDefaultModel="false"
                                                       Bindings="ViewBindingsFor(keyText)"
                                                       BindingsChanged="bindings => SetViewBindings(keyText, bindings)"
                                                       CharacterLoras="ViewLorasFor(keyText)"
                                                       CharacterLorasChanged="loras => SetViewLoras(keyText, loras)"
                                                       Prompt="@PromptFor(keyText)"
                                                       PromptChanged="p => OnPromptEditedAsync(key, p)"
                                                       OnGeneratePrompt="() => GeneratePromptAsync(key)"
                                                       Busy="@(IsSubmitting(keyText) || IsCompiling(keyText))"
                                                       CanSubmit="@CanGenerate"
                                                       SubmitLabel="Generate"
                                                       SubmitBlockedReason="@(CanGenerate ? null : "Set the body view model and image size in Body view setting.")"
                                                       OnSubmit="() => GenerateAsync(key)" />
                                }

                                @* The scene-LoRA picker (unlock / act / anatomy / style) — the SAME shared control the
                                   Studio, the Playground and the asset creator render. It lists by the selected model's
                                   family and shows nothing for a family with no catalog rows, so it can never offer a
                                   LoRA the render would refuse. *@
                                @if (!string.IsNullOrWhiteSpace(ModelId))
                                {
                                    <div class="mt-2">
                                        <SceneLoraPicker Family="@SelectedModelFamily"
                                                         Selections="ViewSceneLorasFor(keyText)"
                                                         SelectionsChanged="loras => SetViewSceneLoras(keyText, loras)"
                                                         Disabled="@(IsSubmitting(keyText) || IsCompiling(keyText))"
                                                         Scope="@($"body-scene-lora-{slot.State}-{slot.View}")" />
                                    </div>
                                }

                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @if (slot.IsBase)
                                    {
                                        @* A base has no source to derive from, so "edit from accepted source" cannot apply to it:
                                           it used to refuse with "is generated or uploaded, not derived from another view". Its
                                           image is edited in the SHARED editor instead — the same screen every other body image
                                           and every review-deck image opens, and the result lands in this view's candidates. *@
                                        @if (EditImageUrlFor(view) is { } rowEditUrl)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@rowEditUrl"
                                               title="Edit this image in the shared editor; the result joins this view's candidates">Edit image</a>
                                        }
                                        else
                                        {
                                            <span class="small text-muted align-self-center">Nothing to edit yet — generate an image first.</span>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditFromSourceAsync(key)" disabled="@(IsSubmitting(keyText) || !CanGenerate)">@EditLabelFor(slot)</button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RecordSourceAsResultAsync(key)" disabled="@IsSubmitting(keyText)">Record source as result</button>
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => AcceptAsync(key)" disabled="@IsSubmitting(keyText)">Accept</button>
                                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => AnalyzeQualityAsync(key)" disabled="@IsSubmitting(keyText)">Analyze quality</button>
                                    @* Every image this view produced or edited reaches one screen: the row's own candidate
                                       batch IS what the deck lists. *@
                                    <a class="btn btn-sm btn-outline-info" href="@ReviewDeckUrlFor(key)"
                                       title="Every image this view created or edited">Review deck</a>
                                </div>

                                @* An unclothed view can be produced by EDITING the approved CLOTHED same-angle to remove
                                   clothes, so the clothed/unclothed pairs match by angle. The source is shown with its
                                   thumbnail — an edit is never a blind request. *@
                                @if (key.State == SceneImageReferenceBodyState.Unclothed)
                                {
                                    <div class="border rounded p-2 mt-2">
                                        <div class="small fw-semibold mb-1">
                                            Approved @ClothedAngleLabel(slot) — edit to remove clothes
                                        </div>
                                        @if (AcceptedClothedAnglePreview(key) is { } clothedUrl)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <img src="@clothedUrl" class="border rounded"
                                                     style="height:80px;width:80px;object-fit:cover;" alt="approved clothed source" />
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => EditFromClothedSourceAsync(key)"
                                                        disabled="@(IsSubmitting(keyText) || !CanGenerate)"
                                                        title="Edit the approved clothed view to remove clothes; the result joins this view's candidates">
                                                    Edit — remove clothes
                                                </button>
                                                @if (AcceptedClothedAngleEditUrl(key) is { } clothedEditUrl)
                                                {
                                                    <a class="btn btn-sm btn-outline-primary" href="@clothedEditUrl"
                                                       title="Open the full editor on the approved clothed image — masks, prompt and model, nothing canned">
                                                        <i class="bi bi-magic me-1"></i>Full editor
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-warning">
                                                The @ClothedAngleLabel(slot) is not accepted yet, so there is no clothed image to
                                                remove clothes from. Accept the @ClothedAngleLabel(slot) first.
                                            </div>
                                        }
                                    </div>
                                }

                                @* WHAT this render sends, shown before it is sent: an angle render is the accepted body turned
                                   by the committed angle skeleton, so both are named here with their thumbnails — and the
                                   identity face joins them when the switch below is on. Nothing about the request is
                                   implicit. *@
                                @if (!slot.IsBase && AngleSkeletonFor(slot) is { } angleSkeleton)
                                {
                                    <div class="border rounded p-2 mt-2">
                                        <div class="small fw-semibold mb-1">What <strong>Render angle</strong> sends</div>
                                        <div class="d-flex flex-wrap gap-2 align-items-start">
                                            <div class="text-center" style="width:96px;">
                                                @if (AcceptedBasePreview(key) is { } baseUrl)
                                                {
                                                    <img src="@baseUrl" class="border rounded"
                                                         style="height:80px;width:80px;object-fit:cover;" alt="accepted body reference" />
                                                }
                                                else
                                                {
                                                    <div class="border rounded bg-light d-flex align-items-center justify-content-center text-muted small"
                                                         style="height:80px;width:80px;">none</div>
                                                }
                                                <div class="small text-muted">accepted base body</div>
                                            </div>
                                            <div class="text-center" style="width:96px;">
                                                <img src="@($"/pose-library/{angleSkeleton.FileName}")" class="border rounded"
                                                     style="height:80px;width:80px;object-fit:contain;background:#f8f9fa;" alt="angle skeleton" />
                                                <div class="small text-muted">@slot.View pose</div>
                                            </div>
                                            <div class="small text-muted" style="max-width:26rem;">
                                                The committed <code>@angleSkeleton.FileName</code> is annotated from a figure in
                                                this view (<span title="@angleSkeleton.VerifiedOn">provenance</span>) — it supplies the
                                                turn, the accepted base supplies the build, the prompt supplies the rest.
                                                @if (!string.IsNullOrWhiteSpace(angleSkeleton.KnownLimitation))
                                                {
                                                    <div>Angle skeleton note: @angleSkeleton.KnownLimitation</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }


                                @* Every attempt this view has ever produced, NEWEST first. A re-run never erases the
                                   previous result — the view row only ever pointed at the newest image — so this is
                                   the compare deck: each candidate shows the image, the prompt that made it and the
                                   model that ran it, side by side. *@
                                @{
                                    var candidates = CandidatesFor(key);
                                    var visibleCandidates = candidates
                                        .Where(candidate => ImageCardStatus.Matches(CandidateCardModel(candidate), CandidateFilterFor(keyText)))
                                        .ToList();
                                }
                                <div class="border rounded p-2 mt-2">
                                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                        <span class="small fw-semibold">
                                            Candidates (@visibleCandidates.Count of @candidates.Count)
                                            @if (candidates.Count > 1)
                                            {
                                                <span class="text-muted fw-normal">— compare the prompt and model on each</span>
                                            }
                                        </span>
                                        <span class="d-flex align-items-center gap-2">
                                            <ImageCardStatusFilter Options="ImageCardStatus.Build(candidates.Select(CandidateCardModel))"
                                                                   Selected="CandidateFilterFor(keyText)"
                                                                   SelectedChanged="value => SetCandidateFilter(keyText, value)"
                                                                   Total="candidates.Count" />
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@_refreshing">Refresh</button>
                                        </span>
                                    </div>
                                    @if (candidates.Count == 0)
                                    {
                                        <p class="small text-muted mb-0">
                                            Nothing has been generated for this view yet. Every image this view produces
                                            stays listed here, including ones a later re-run replaced.
                                        </p>
                                    }
                                    else
                                    {
                                        <div class="row g-2 mt-2">
                                            @foreach (var candidate in visibleCandidates)
                                            {
                                                <div class="col-sm-6 col-xl-4 col-xxl-3">
                                                    <ImageCard Model="CandidateCardModel(candidate)"
                                                               Busy="IsSubmitting(keyText)"
                                                               ShowName="true"
                                                               NameChanged="name => RenameCandidateAsync(candidate, name)"
                                                               AcceptTitle="Make this image this view's result and accept the view (the recorded findings gate still applies)"
                                                               AcceptRequested="() => AcceptCandidateAsync(key, candidate.Id)"
                                                               ShortlistRequested="() => DecideCandidateAsync(key, candidate.Id, SceneAssetCandidateDecision.Shortlisted)"
                                                               RejectRequested="() => DecideCandidateAsync(key, candidate.Id, SceneAssetCandidateDecision.Rejected)"
                                                               EditRequested="() => OpenCandidateEdit(candidate)"
                                                               ReviewRequested="() => OpenCandidateReview(candidate)"
                                                               DownloadRequested="() => OpenCandidateDownload(candidate)"
                                                               VideoRequested="() => OpenCandidateVideo(candidate)"
                                                               LoadIntoGeneratorRequested="() => LoadCandidatePromptAsync(key, candidate)"
                                                               DeleteRequested="() => DeleteCandidateAsync(key, candidate)">
                                                        <BodyContent>
                                                            @if (candidate.Status == SceneAssetStatus.Complete)
                                                            {
                                                                <div class="mt-2">
                                                                    <ImageTags ImageId="candidate.Id" Target="ImageTagTarget.AssetLibrary"
                                                                               TagsJson="candidate.TagsJson" Editable="true" TagsChanged="() => RefreshAsync()" />
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(candidate.CandidateNotes))
                                                            {
                                                                <div class="small text-muted">Note: @candidate.CandidateNotes</div>
                                                            }
                                                        </BodyContent>
                                                        <FooterContent>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                                    @onclick="() => DecideCandidateAsync(key, candidate.Id, SceneAssetCandidateDecision.Undecided)"
                                                                    disabled="@IsSubmitting(keyText)"
                                                                    title="Return this candidate to Undecided"><i class="bi bi-question-lg"></i></button>
                                                            @if (candidate.CandidateDecision == SceneAssetCandidateDecision.Accepted
                                                                && view?.Status != CharacterIdentityAngleStatus.Accepted)
                                                            {
                                                                <div class="small text-warning w-100 mt-1">
                                                                    This image is decided Accepted, but the VIEW is not accepted yet
                                                                    (@(view?.Status.ToString() ?? "NotStarted")). Accept the view to finish.
                                                                </div>
                                                            }
                                                        </FooterContent>
                                                    </ImageCard>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="mt-2">
                                    <label class="form-label small mb-1">Upload this view</label>
                                    <InputFile class="form-control form-control-sm" accept="image/png,image/jpeg,image/webp"
                                               OnChange="args => UploadAsync(key, args)" />
                                    <button type="button" class="btn btn-sm btn-outline-primary w-100 mt-1"
                                            disabled="@IsSubmitting(keyText)"
                                            title="Use an image the app already holds — an approved or draft pack body image, or one from the asset library"
                                            @onclick="() => OpenPicker(key)">From app</button>
                                </div>

                                <div class="border-top mt-2 pt-2">
                                    <button type="button" class="btn btn-sm btn-success"
                                            @onclick="() => AcceptAsync(key)" disabled="@IsSubmitting(keyText)"
                                            title="Accept this view as it stands — the next step waits on it">
                                        Accept
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header"><strong>Extended view</strong></div>
        <div class="card-body">
            <p class="small text-muted">
                A rotation plus a position key, for a view no canonical slot names. It is a request of its own — it is
                never promoted into a pack slot.
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-1">State</label>
                    <select class="form-select form-select-sm" value="@_extendedState" @onchange="e => _extendedState = ParseState(e.Value?.ToString())">
                        @foreach (var state in BodyStates)
                        {
                            <option value="@state">@state</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Rotation (deg)</label>
                    @* The box draws the operator's own text, never the parsed int: typing "-" or clearing the box
                       mid-edit parses to 0, and drawing that would rewrite what they are typing. ParseRotation still
                       keeps the number current on every keystroke, so Generate uses what is in the box. *@
                    <CommittedTextInput type="number" min="-180" max="180" class="form-control form-control-sm"
                           Live="@_extendedRotationText" LiveChanged="OnExtendedRotationInput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Position key</label>
                    <CommittedTextInput class="form-control form-control-sm" placeholder="e.g. standing"
                           Live="@_extendedPosition" LiveChanged="e => _extendedPosition = e ?? string.Empty" />
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-primary" @onclick="GenerateExtendedAsync" disabled="@(_extendedBusy || !CanGenerate)">Generate</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleExtendedAsync" disabled="@_extendedBusy">Open actions</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_extendedMessage))
            {
                <div class="small text-muted mt-2">@_extendedMessage</div>
            }
        </div>
    </div>
}

@if (_viewer is not null)
{
    @* The grid is a workspace, not a thumbnail sheet: every view can be opened at full size, with its source beside
       it when it was produced as an edit of an accepted view. *@
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.88);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @_viewer.Label
                        <span class="badge @StatusBadge(_viewer.View) ms-2">@(_viewer.View?.Status.ToString() ?? "NotStarted")</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseViewer" title="Close"></button>
                </div>
                <div class="modal-body text-center" style="overflow:auto;">
                    <img src="@_viewer.Url"
                         class="@(_viewerZoomed ? string.Empty : "img-fluid")"
                         style="@(_viewerZoomed ? "max-width:none;" : "max-height:78vh;cursor:zoom-in;")"
                         title="@(_viewerZoomed ? "Click to fit the window" : "Click to zoom to 100%")"
                         @onclick="() => _viewerZoomed = !_viewerZoomed"
                         alt="@_viewer.Label" />
                    @if (!string.IsNullOrWhiteSpace(_viewer.SourceUrl))
                    {
                        <div class="mt-3">
                            <div class="small text-muted mb-1">Source image — this view was produced as an edit of it</div>
                            <img src="@_viewer.SourceUrl" class="border rounded" style="height:140px;" alt="source image" />
                        </div>
                    }
                    @if (_viewer.View is { } shown && !string.IsNullOrWhiteSpace(shown.ResolvedPromptText))
                    {
                        <details class="mt-3 text-start">
                            <summary class="small">The prompt this image was rendered from</summary>
                            <pre class="small mb-0" style="white-space:pre-wrap;">@shown.ResolvedPromptText</pre>
                        </details>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-secondary btn-sm" href="@_viewer.Url" target="_blank" title="Open the raw file">
                        <i class="bi bi-arrows-fullscreen me-1"></i>Open the raw file
                    </a>
                    <button type="button" class="btn btn-secondary" @onclick="CloseViewer">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* A body view's image is chosen from what the app already holds at least as often as it is uploaded, so the picker
   sits beside the file input rather than replacing it. *@
@if (_pickerKey is not null)
{
    <InAppImagePicker Visible="true"
                      CharacterTemplateId="@CharacterId"
                      IdentityKind="SceneImageReferenceAssetKind.FullBody"
                      Title="@($"Choose {_pickerKey.Describe()}")"
                      Picked="UsePickedImageAsync"
                      CancelRequested="ClosePicker" />
}

@code {
    private static readonly SceneImageReferenceBodyState[] BodyStates =
        [SceneImageReferenceBodyState.Clothed, SceneImageReferenceBodyState.Unclothed];

    /// <summary>The body build whose views this panel acquires.</summary>
    [Parameter, EditorRequired]
    public string BuildId { get; set; } = string.Empty;

    /// <summary>The character's display name, which the resolved prompts address.</summary>
    [Parameter]
    public string CharacterName { get; set; } = string.Empty;

    /// <summary>
    /// The body view model and image size, both resolved from the character's persisted workflow settings. The panel
    /// renders at ONE quality setting for every view of this body, and it assumes neither value: unset means the
    /// generate/edit actions stay disabled and the operator is told where the setting lives.
    /// </summary>
    [Parameter]
    public string ModelId { get; set; } = string.Empty;

    [Parameter]
    public string ModelName { get; set; } = string.Empty;

    [Parameter]
    public string ImageSize { get; set; } = string.Empty;

    /// <summary>
    /// Incremented by the studio on every successful save of the body view settings. The capability questions below
    /// (can this model carry identity? can it carry a pose?) are answered from the SAVED settings, so a save is what
    /// invalidates the cached answer. The model id alone is not enough: it is bound two-way to the dropdown, so it
    /// changes before the save persists.
    /// </summary>
    [Parameter]
    public int SettingsRevision { get; set; }

    /// <summary>
    /// When set with <see cref="SelectedView"/>, the panel renders exactly ONE canonical slot (always expanded)
    /// instead of the whole clothed/unclothed grid — the Body tab's left navigation drives these.
    /// </summary>
    [Parameter]
    public SceneImageReferenceBodyState? SelectedState { get; set; }

    [Parameter]
    public SceneImageReferenceBodyView? SelectedView { get; set; }

    /// <summary>The single slot to render, or null to render the whole grid.</summary>
    private CharacterIdentityBodySlot? SelectedSlot =>
        SelectedState is { } state && SelectedView is { } view
            ? CharacterIdentityBodySlots.All.FirstOrDefault(slot => slot.State == state && slot.View == view)
            : null;

    /// <summary>
    /// Raised whenever this panel's view rows change, carrying the rows themselves.
    ///
    /// <para>
    /// The panel already loads every view and re-reads them after each action, so the Body tab's left navigation
    /// mirrors THIS list rather than running a second query: two loaders would drift, and the nav exists precisely so
    /// the operator can trust it to show which cells still need work. Nothing is passed when the rows are unchanged —
    /// the host re-renders these parameters on every pass, so an unguarded raise would re-enter this component's
    /// parameter set and never settle.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<CharacterIdentityBodyView>> ViewsChanged { get; set; }

    /// <summary>The character template id — the profile key the body render addresses identity by.</summary>
    [Parameter]
    public string CharacterId { get; set; } = string.Empty;

    /// <summary>The shared body-view model list, fed to the common image step composer so its model picker reflects the same setting.</summary>
    [Parameter]
    public IReadOnlyList<SceneImageModelChoice> ModelChoices { get; set; } = [];

    /// <summary>Updates the parent's body-view model when the composer's model picker changes it.</summary>
    [Parameter]
    public EventCallback<string?> ModelIdChanged { get; set; }

    private List<CharacterIdentityBodyView> _views = [];
    private string? _publishedViewSignature;
    private Dictionary<string, string> _previews = new(StringComparer.Ordinal);

    /// <summary>
    /// Every image produced for each candidate batch, NEWEST first, keyed by batch id. Built from the container's
    /// image list that the panel already reads — one query, no extra round trip — so a view's whole generation
    /// history is reachable instead of only the newest attempt.
    /// </summary>
    private Dictionary<string, IReadOnlyList<SceneAssetImage>> _candidatesByBatch = new(StringComparer.Ordinal);
    private readonly Dictionary<string, SceneAssetStatus> _imageStatuses = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _prompts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<ReferenceApplicationSelection>> _viewBindings = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<SceneImageCharacterLoraSelection>> _viewLoras = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<SceneImageLoraSelection>> _viewSceneLoras = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _messages = new(StringComparer.Ordinal);

    private string? _openKey;
    private string _panelMessage = string.Empty;
    private bool _panelMessageIsError;
    private string _extendedMessage = string.Empty;

    /// <summary>
    /// Guards the BACKGROUND refresh and its five-second poll ONLY.
    ///
    /// It must never gate an operator action. It used to: every row button was disabled by that same lock, and
    /// <c>RunAsync</c> refused outright when it was set, so while the poll was refreshing, clicks landed on a
    /// disabled button or were discarded server-side with no message — "the generate button does not do anything".
    /// A refresh is the panel's own housekeeping; it must not make the operator's controls dead.    /// </summary>
    private bool _refreshing;

    /// <summary>Guards the extended-view controls, whose key is not a slot and so has its own row state.</summary>
    private bool _extendedBusy;

    /// <summary>
    /// Views whose request is in flight RIGHT NOW, keyed as the panel keys everything else. The per-row in-flight
    /// only deadens the buttons: it says nothing about which row is working or whether the click registered, which is
    /// exactly what "nothing happened after I pressed Generate" looked like.
    /// </summary>
    private readonly HashSet<string> _submitting = new(StringComparer.Ordinal);
    private ViewerState? _viewer;
    private bool _viewerZoomed;
    private Timer? _poll;
    private bool _disposed;

    /// <summary>Debounces prompt-edit saves so a keystroke does not write to the store on every character.</summary>
    private Timer? _promptSaveDebounce;
    private CharacterIdentityBodyViewKey? _pendingPromptKey;
    private SceneImageReferenceBodyState _extendedState = SceneImageReferenceBodyState.Clothed;
    private int _extendedRotation;
    private string _extendedRotationText = "0";
    private string _extendedPosition = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(BuildId))
        {
            return;
        }

        // A body render takes tens of seconds and finishes on the container's image, not on this component, so the
        // panel polls while anything is rendering — otherwise the operator watches a Pending badge and concludes the
        // button did nothing.
        _poll ??= new Timer(_ => _ = InvokeAsync(PollAsync), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        await RefreshAsync();

        // The single-slot view (the Body tab's left navigation) renders its card ALREADY EXPANDED, so the toggle that
        // resolves a prompt in the full grid never runs and the prompt box came up empty. Resolve it here, so a slot
        // the operator is looking at is pre-filled exactly as opening it in the grid would be.
        if (SelectedSlot is { } selectedSlot)
        {
            var selectedKey = CharacterIdentityBodyViewKey.Canonical(selectedSlot.State, selectedSlot.View);
            if (!_prompts.ContainsKey(selectedKey.Describe()))
            {
                await ResolvePromptAsync(selectedKey);
            }
        }
    }

    /// <summary>Refresh views re-reads the views so the grid stays in line with the saved settings.</summary>
    private async Task RefreshViewsAsync()
    {
        await RefreshAsync();
    }

    /// <summary>
    /// Pose and identity COMPOSE (operator decision, 2026-09-22): the skeleton drives the pose by conditioning the
    /// sampler's prompt inputs, and the face reference drives the identity by conditioning its model input. They are
    /// independent conditionings on one render, so neither switch turns the other off.
    /// </summary>
    private async Task PollAsync()
    {
        if (_disposed || _refreshing || string.IsNullOrWhiteSpace(BuildId))
        {
            return;
        }

        if (_views.Any(view => view.Status == CharacterIdentityAngleStatus.Pending))
        {
            await RefreshAsync();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _poll?.Dispose();
        _promptSaveDebounce?.Dispose();
    }

    /// <summary>
    /// Loads the view rows through the ONE service call and tells the host what changed. Every site that re-reads the
    /// views goes through here, so the navigation cannot be left showing a status an action has already moved on from.
    /// </summary>
    private async Task LoadViewsAsync()
    {
        _views = (await BodyService.ListViewsAsync(BuildId)).ToList();

        var signature = string.Join(
            "|", _views.Select(view => $"{view.Key().Describe()}={view.Status}").OrderBy(text => text, StringComparer.Ordinal));
        if (string.Equals(signature, _publishedViewSignature, StringComparison.Ordinal))
        {
            return;
        }

        _publishedViewSignature = signature;
        await ViewsChanged.InvokeAsync(_views);
    }

    /// <summary>
    /// Reads everything this panel renders from — the view rows, the container's images, and the candidate history —
    /// in ONE pass.
    ///
    /// <para>
    /// They must be read together, and an action that changes one changes the others. The rows say a view is Pending
    /// and name the image it is waiting on; the images map says whether that image is actually there. Load the rows
    /// alone after queueing a render — which is what the action path used to do — and the freshly queued artifact is
    /// not yet in the map, so the panel concludes the artifact is <em>missing</em> and tells the operator the render
    /// they just started will never arrive (reported 2026-10-11).
    /// </para>
    /// </summary>
    private async Task LoadPanelStateAsync()
    {
        await LoadViewsAsync();

        // The views' images live on the build's container asset; the map is rebuilt rather than cached so a
        // deleted artifact cannot leave a stale preview behind.
        var container = await BodyService.EnsureContainerAsync(BuildId);
        var images = await AssetService.ListImagesAsync(container.Id);
        _previews = images
            .Where(image => !string.IsNullOrWhiteSpace(image.FileRelativePath))
            .GroupBy(image => image.Id, StringComparer.Ordinal)
            .ToDictionary(
                group => group.Key,
                group => $"/scene-images/{group.First().FileRelativePath}",
                StringComparer.Ordinal);
        _imageStatuses.Clear();
        foreach (var group in images.GroupBy(image => image.Id, StringComparer.Ordinal))
        {
            _imageStatuses[group.Key] = group.First().Status;
        }

        // The same list already holds every candidate this view ever produced, because each generation joins the
        // view's batch. Grouping by batch is what makes the history reachable: the view row only pointed at the
        // newest image, so without this a re-run looked like the previous result had been thrown away.
        //
        // NEWEST FIRST (operator decision, 2026-09-22): the deck opens on the attempt just made, which is the one
        // being judged, instead of burying it below every earlier attempt.
        _candidatesByBatch = images
            .Where(image => !string.IsNullOrWhiteSpace(image.CandidateBatchId))
            .GroupBy(image => image.CandidateBatchId!, StringComparer.Ordinal)
            .ToDictionary(
                group => group.Key,
                group => (IReadOnlyList<SceneAssetImage>)group
                    .OrderByDescending(image => image.CreatedUtc)
                    .ToList(),
                StringComparer.Ordinal);
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrWhiteSpace(BuildId) || _refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            await LoadPanelStateAsync();

            // A queued render completes the CONTAINER's image row; nothing else advances the view from Pending, so
            // the panel records the finished image through the service's completion path and re-reads the views.
            var finished = _views
                .Where(view => view.Status == CharacterIdentityAngleStatus.Pending
                    && !string.IsNullOrWhiteSpace(view.OutputArtifactId))
                .Where(view => _imageStatuses.TryGetValue(view.OutputArtifactId!, out var status)
                    && status == SceneAssetStatus.Complete)
                .ToList();
            foreach (var view in finished)
            {
                await BodyService.RecordResultAsync(BuildId, view.Key(), view.OutputArtifactId!);
            }

            if (finished.Count > 0)
            {
                await LoadViewsAsync();
            }
        }
        catch (InvalidOperationException error)
        {
            _panelMessage = error.Message;
            _panelMessageIsError = true;
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task ToggleAsync(CharacterIdentityBodyViewKey key)
    {
        var keyText = key.Describe();
        if (string.Equals(_openKey, keyText, StringComparison.Ordinal))
        {
            _openKey = null;
            return;
        }

        _openKey = keyText;
        if (!_prompts.ContainsKey(keyText))
        {
            // Opening reads the prompt without announcing it: the row is about to show it anyway, and a message on
            // every open would be noise.
            await ResolvePromptAsync(key);
        }
    }

    /// <summary>
    /// Compiles this row's prompt through the shared image-cell prompt compiler — the same LLM compile every other
    /// surface's Generate Prompt button uses — for the selected body view model's checkpoint profile, and shows the
    /// result in the prompt box.
    ///
    /// The direction names only what the render's reference images do NOT already carry. An angle row conditions on
    /// the accepted body, the committed angle skeleton and an optional face, so its direction is the subject noun,
    /// the state and the camera clause (the skeleton carries limb layout, not facing — measured 2026-09-24). The
    /// base has no body reference, so its direction keeps the full canonical description. The declared bindings tell
    /// the compiler which axes the references carry, so it does not describe those in words as well.
    /// </summary>
    private async Task GeneratePromptAsync(CharacterIdentityBodyViewKey key)
    {
        var keyText = key.Describe();
        if (!_compiling.Add(keyText))
        {
            return;
        }

        StateHasChanged();
        try
        {
            var body = await BodyService.ResolveBodyTextsAsync(CharacterId, key.State);
            var model = ModelChoices.FirstOrDefault(choice => choice.ModelId == ModelId)
                ?? throw new InvalidOperationException("Choose a body view model first — there is no model selected to compile for.");
            var profile = await CompilerProfiles.FindByCheckpointAsync(model.ModelIdentifier)
                ?? throw new InvalidOperationException(
                    $"No compiler profile exists for checkpoint '{model.ModelIdentifier}'. Add one before compiling a prompt.");
            var promptModel = await ModelResolutionService.ResolveImagePromptModelAsync();
            var settings = new ImageCellCompilerLlmSettings(promptModel.ModelIdentifier, promptModel.Temperature);

            var bindings = ViewBindingsFor(keyText);
            var direction = await BuildBodyCompileDirectionAsync(key, body, bindings);
            var result = await PromptCompiler.CompileAsync(new ImageCellCompileInput(
                direction, profile, settings, DeclareBindings(key)));

            _prompts[keyText] = result.CompiledPrompt;
            BumpPromptRevision(keyText);
            SetMessage(keyText, $"Compiled a prompt for {profile.DisplayName} with {result.ModelIdentifier}.");
        }
        catch (Exception error)
        {
            SetMessage(keyText, error.Message);
        }
        finally
        {
            _compiling.Remove(keyText);
            StateHasChanged();
        }
    }

    /// <summary>
    /// The compile's input direction. Split on purpose: an ANGLE row's references (accepted body, angle skeleton,
    /// optional face) already carry the build, the pose and the identity, so its direction names only what the words
    /// must still say — the subject noun, the state and the camera direction. The base has no body reference, so its
    /// direction keeps the full canonical description, with the face left out only when a face reference is bound.
    ///
    /// <para>
    /// This split is the same rule as <c>BodyPromptScope</c>, which the render path's own compile applies — an angle
    /// POINTS AT ITS REFERENCES, the base DESCRIBES the body. The two drifted apart once already: this path was made
    /// minimal while the render path still compiled the full body description, so "Generate prompt" and the prompt
    /// that was actually rendered said different things (reported 2026-10-10). The RENDER side of the rule is now
    /// pinned by <c>BodyReferencePromptCompilerTests</c>; this direction builder is not, so a change here must keep
    /// the same shape — subject, state and camera direction only, and never a stance.
    /// </para>
    /// </summary>
    private async Task<string> BuildBodyCompileDirectionAsync(
        CharacterIdentityBodyViewKey key,
        CharacterBodyTexts body,
        IReadOnlyList<ReferenceApplicationSelection> bindings)
    {
        if (key.IsCanonical && key.View is { } view && view != SceneImageReferenceBodyView.Front)
        {
            var clause = await BodyService.ResolveRenderClauseAsync(BuildId, key, CharacterName);
            return ComposeAngleDirection(body, key.State, clause);
        }

        var faceBound = FaceFromBindings(bindings) is not null;
        var subject = faceBound ? body.SubjectWithoutFace : body.SubjectWithFace;
        return ComposeBaseDirection(subject, body, key.State);
    }

    /// <summary>The minimal angle direction: subject noun + state + camera clause + the framing/lighting tail.</summary>
    private static string ComposeAngleDirection(
        CharacterBodyTexts body, SceneImageReferenceBodyState state, string cameraClause)
    {
        var builder = new System.Text.StringBuilder();
        builder.Append(body.SubjectNoun.Trim().TrimEnd('.'));
        builder.Append(". ");
        AppendState(builder, body, state);
        builder.Append(cameraClause.Trim().TrimEnd('.'));
        builder.Append(". ");
        builder.Append(
            "Full body in frame from head to feet, natural skin texture, soft even lighting, sharp focus, "
            + "35mm photograph.");
        return builder.ToString();
    }

    /// <summary>The base direction: the full description, with the face left out when a face reference is bound.</summary>
    private static string ComposeBaseDirection(
        string subject, CharacterBodyTexts body, SceneImageReferenceBodyState state)
    {
        var builder = new System.Text.StringBuilder();
        builder.Append(subject.Trim().TrimEnd('.'));
        builder.Append(". ");
        AppendState(builder, body, state);
        builder.Append(
            "Full body in frame from head to feet, standing upright facing the camera, natural skin texture, "
            + "soft even lighting, sharp focus, 35mm photograph.");
        return builder.ToString();
    }

    /// <summary>The clothing/state sentence both directions share, resolved once rather than spelled in two places.</summary>
    private static void AppendState(
        System.Text.StringBuilder builder, CharacterBodyTexts body, SceneImageReferenceBodyState state)
    {
        if (state == SceneImageReferenceBodyState.Clothed)
        {
            // A clothed reference's outfit is required (the brief refuses a clothed body with no clothing), so the
            // wardrobe text is always present here — and describing it in words is exactly what a clothed render needs.
            builder.Append("Wearing ");
            builder.Append(body.WardrobeText.Trim());
            builder.Append(". ");
        }
        else
        {
            builder.Append("Fully nude. ");
        }
    }

    /// <summary>
    /// The axes this render carries structurally, so the compiler does not describe them in words. An angle row
    /// always conditions on the accepted body (Identity) and the committed angle skeleton (Pose) — a bound face joins
    /// the Identity axis, so the axis is structural whether or not one is bound. The base has no body reference and
    /// no skeleton, so it declares nothing; its face, when bound, is left out of the direction text instead.
    /// </summary>
    private static IReadOnlyList<ImageCellBinding> DeclareBindings(CharacterIdentityBodyViewKey key)
    {
        if (key.IsCanonical && key.View is { } view && view != SceneImageReferenceBodyView.Front)
        {
            return
            [
                new ImageCellBinding(ImageBindingAxis.Identity, ImageBindingMode.Reference),
                new ImageCellBinding(ImageBindingAxis.Pose, ImageBindingMode.Reference)
            ];
        }

        return [];
    }

    /// <summary>
    /// Resolves this row's prompt once, silently, when the row opens. The prompt box shows the deterministic body
    /// prompt (or the stored rotation instruction for an extended view), which the operator can then edit or replace
    /// with the shared compiler's Generate Prompt.
    /// </summary>
    private async Task ResolvePromptAsync(CharacterIdentityBodyViewKey key)
    {
        var keyText = key.Describe();
        if (!_reloading.Add(keyText))
        {
            return;
        }

        StateHasChanged();
        try
        {
            // A canonical angle has a REAL generation prompt now — the compiled body prompt plus its camera clause —
            // so it resolves like the base does. Only an extended view has nothing to compile: its prompt is the stored
            // rotation instruction, because a rotation is a request about an image that already exists.
            var prompt = key.IsCanonical
                ? await BodyService.ResolvePromptAsync(BuildId, key, ModelId, CharacterName)
                : await BodyService.ResolveEditInstructionAsync(BuildId, key, CharacterName);

            _prompts[keyText] = prompt;

            // The box is an uncontrolled input: Blazor only updates its DOM value when the RENDERED value changes, so
            // re-resolving the same text would leave any edit sitting in the box and look like nothing happened.
            // Bumping the revision remounts it through the @key below, so a resolve really does replace what is on
            // screen.
            BumpPromptRevision(keyText);
        }
        catch (Exception error)
        {
            SetMessage(keyText, error.Message);
        }
        finally
        {
            _reloading.Remove(keyText);
            StateHasChanged();
        }
    }

    /// <summary>
    /// The committed angle skeleton this slot renders with, or null for a slot that has none (the base, which is
    /// generated from the body card alone). Resolved from the ONE angle library, so the panel and the render cannot
    /// disagree about which skeleton a view uses — or about whether it has one at all.
    /// </summary>
    private static BodyAngleSkeleton? AngleSkeletonFor(CharacterIdentityBodySlot slot)
        => BodyAngleSkeletons.Has(slot.View) ? BodyAngleSkeletons.Require(slot.View) : null;

    /// <summary>
    /// What the primary button does for this slot. A base is GENERATED from the body card; a canonical angle is
    /// RENDERED from the accepted body, which is a different request, so it is named as one instead of reusing
    /// "Generate" for both.
    /// </summary>
    private static string GenerateLabelFor(CharacterIdentityBodySlot slot)
        => slot.IsBase ? "Generate" : "Render angle";

    /// <summary>
    /// The alternative route: an edit of the accepted source. Called a rotation edit where an angle render exists,
    /// because for those views it is the other way to obtain the same view.
    /// </summary>
    private static string EditLabelFor(CharacterIdentityBodySlot slot)
        => slot.IsBase ? "Edit from accepted source" : "Rotation edit";

    private Task GenerateAsync(CharacterIdentityBodyViewKey key)
    {
        if (!CanGenerate)
        {
            SetMessage(key.Describe(), "Set the body view model and image size in Body view settings — neither is assumed.");
            return Task.CompletedTask;
        }

        var keyText = key.Describe();
        return RunAsync(key, async () =>
        {
            // The composer's Face, Body and Pose slots are the request's conditionings. Each is read back from the ONE
            // binding channel the shared step uses, so a bound reference is never dropped the way the old switches
            // could drop one on a model change.
            var bindings = ViewBindingsFor(keyText);
            var face = FaceFromBindings(bindings);
            var body = BodyFromBindings(bindings);
            var pose = ImageStepPoseBinding.Resolve(bindings);
            var loras = ViewLorasFor(keyText);
            var sceneLoras = ViewSceneLorasFor(keyText);

            await BodyService.GenerateAsync(
                BuildId, key, ModelId, ImageSize, CharacterName, PromptOrNull(key),
                useIdentity: face is not null && key.View != SceneImageReferenceBodyView.Back,
                identityFaceAssetId: face?.ReferenceAssetId,
                bodyReference: body,
                posePresetId: pose?.PresetId,
                poseSkeletonRelativePath: pose?.SkeletonRelativePath,
                characterLoras: loras.Count > 0 ? loras : null,
                sceneLoras: sceneLoras.Count > 0 ? sceneLoras : null);
            return $"Render submitted for {keyText} at {ImageSize}. It appears here when it finishes.";
        });
    }

    /// <summary>The Face slot's approved-pack binding, or null when the operator bound none.</summary>
    private ReferenceApplicationSelection? FaceFromBindings(IReadOnlyList<ReferenceApplicationSelection> bindings)
        => bindings.FirstOrDefault(binding =>
            string.Equals(binding.Kind, nameof(ImageStepSlotKind.Face), StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(binding.IdentityPackId));

    /// <summary>The Body slot's approved-pack binding, as the render's body-reference conditioning — or null.</summary>
    private SceneAssetBodyReferenceConditioning? BodyFromBindings(IReadOnlyList<ReferenceApplicationSelection> bindings)
        => bindings.FirstOrDefault(binding =>
            string.Equals(binding.Kind, nameof(ImageStepSlotKind.Body), StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(binding.IdentityPackId)) is { } body
                ? new SceneAssetBodyReferenceConditioning(body.IdentityPackId!, body.ReferenceAssetId ?? string.Empty)
                : null;

    /// <summary>The shared step's blueprint for this body view, or null when the character is unresolved.</summary>
    private ImageStepBlueprint? BodyViewBlueprint =>
        string.IsNullOrWhiteSpace(CharacterId)
            ? null
            : ImageStepBlueprintFactory.ForBodyView(new ImageStepActor(CharacterId, CharacterName));

    private IReadOnlyList<ReferenceApplicationSelection> ViewBindingsFor(string keyText)
        => _viewBindings.TryGetValue(keyText, out var bindings) ? bindings : [];

    private void SetViewBindings(string keyText, IReadOnlyList<ReferenceApplicationSelection> bindings)
        => _viewBindings[keyText] = bindings;

    /// <summary>The character LoRA selections the shared step's picker made for this view, or none.</summary>
    private IReadOnlyList<SceneImageCharacterLoraSelection> ViewLorasFor(string keyText)
        => _viewLoras.TryGetValue(keyText, out var loras) ? loras : [];

    private void SetViewLoras(string keyText, IReadOnlyList<SceneImageCharacterLoraSelection> loras)
        => _viewLoras[keyText] = loras;

    /// <summary>The scene LoRA selections the shared scene-LoRA picker made for this view, or none.</summary>
    private IReadOnlyList<SceneImageLoraSelection> ViewSceneLorasFor(string keyText)
        => _viewSceneLoras.TryGetValue(keyText, out var loras) ? loras : [];

    private void SetViewSceneLoras(string keyText, IReadOnlyList<SceneImageLoraSelection> loras)
        => _viewSceneLoras[keyText] = loras;

    /// <summary>The selected body view model's family, for the scene-LoRA picker — the picker lists by family.</summary>
    private SceneImageModelFamily SelectedModelFamily =>
        ModelChoices.FirstOrDefault(choice => string.Equals(choice.ModelId, ModelId, StringComparison.Ordinal))?.Family
        ?? SceneImageModelFamily.Unknown;

    private Task OnModelChanged(string? modelId)
    {
        // Bindings and LoRA selections do not survive a model change: both bind to the model's family, and a stale
        // selection would plan a render the new model refuses.
        _viewBindings.Clear();
        _viewLoras.Clear();
        _viewSceneLoras.Clear();
        return ModelIdChanged.InvokeAsync(modelId);
    }

    private Task EditFromSourceAsync(CharacterIdentityBodyViewKey key)    {
        if (!CanGenerate)
        {
            SetMessage(key.Describe(), "Set the body view model in Body view settings above — no model is assumed.");
            return Task.CompletedTask;
        }

        return RunAsync(key, async () =>
        {
            await BodyService.EditFromAcceptedSourceAsync(
                BuildId, key, ModelId, CharacterName, PromptOrNull(key));
            return $"Edit from the accepted source submitted for {key.Describe()}.";
        });
    }

    /// <summary>
    /// The "remove clothes" edit: an UNCLOTHED view edited from the approved CLOTHED same-angle, so the two states
    /// match by angle. Its instruction is the one store's remove-clothes template — not the prompt box, which holds
    /// this view's GENERATION prompt, not a clothing-removal instruction.
    /// </summary>
    private Task EditFromClothedSourceAsync(CharacterIdentityBodyViewKey key)
    {
        if (!CanGenerate)
        {
            SetMessage(key.Describe(), "Set the body view model in Body view settings above — no model is assumed.");
            return Task.CompletedTask;
        }

        return RunAsync(key, async () =>
        {
            await BodyService.EditFromClothedSourceAsync(
                BuildId, key, ModelId, CharacterName);
            return $"Edit from the approved clothed {key.View} submitted for {key.Describe()}.";
        });
    }

