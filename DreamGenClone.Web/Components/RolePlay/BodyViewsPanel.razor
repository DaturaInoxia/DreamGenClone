            var bindings = ViewBindingsFor(keyText);
            var face = FaceFromBindings(bindings);
            var body = BodyFromBindings(bindings);
            var pose = ImageStepPoseBinding.Resolve(bindings);
            var loras = ViewLorasFor(keyText);
            var sceneLoras = ViewSceneLorasFor(keyText);

            await BodyService.GenerateAsync(
                BuildId, key, ModelId, ImageSize, CharacterName, PromptOrNull(key),
                useIdentity: face is not null && key.View != SceneImageReferenceBodyView.Back,
                identityFaceAssetId: face?.ReferenceAssetId,
                bodyReference: body,
                posePresetId: pose?.PresetId,
                poseSkeletonRelativePath: pose?.SkeletonRelativePath,
                characterLoras: loras.Count > 0 ? loras : null,
                sceneLoras: sceneLoras.Count > 0 ? sceneLoras : null);
            return $"Render submitted for {keyText} at {ImageSize}. It appears here when it finishes.";
        });
    }

