@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay
@using DreamGenClone.Web.Application.RolePlay.ImageStep
@using DreamGenClone.Web.Application.RolePlay.Models
@using DreamGenClone.Web.Application.Scenarios
@using DreamGenClone.Components.Assets
@inject ICharacterIdentityBodyService BodyService
@inject ISceneAssetService AssetService
@inject IImageCellPromptCompiler PromptCompiler
@inject IImageCompilerProfileRepository CompilerProfiles
@inject IModelResolutionService ModelResolutionService
@inject NavigationManager Navigation
@implements IDisposable

@* B-122 E-2: the clothed and unclothed view grids. One row per canonical slot, one request per row, and no batch
   action anywhere in this panel — the same one-view-at-a-time contract the face pipeline uses. Extended views get
   their own row because a pack slot cannot name a rotation. *@

@if (string.IsNullOrWhiteSpace(BuildId))
{
    <p class="text-muted small mb-0">The body build is not available yet, so there are no views to acquire.</p>
}
else
{
    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshViewsAsync" disabled="@_refreshing">Refresh views</button>
        @if (CanGenerate)
        {
            <span class="small text-muted">
                Model <strong>@ModelName</strong> · size <code>@ImageSize</code> — both come from
                <strong>Body view settings</strong> above, so every view of this body is rendered at the same quality
                setting. Every action below applies to the one view it is on; there is no batch and no "generate all".
            </span>
        }
        else
        {
            <span class="small text-warning">
                Set the body view model and image size in <strong>Body view settings</strong> above —
                <strong>Generate</strong>, <strong>Re-run</strong> and <strong>Edit from accepted source</strong> stay
                disabled until both are set. Neither is assumed.
            </span>
        }
        @if (_submitting.Count > 0 || _views.Any(view => view.Status == CharacterIdentityAngleStatus.Pending))
        {
            <span class="small text-muted"><i class="bi bi-hourglass-split me-1"></i>Rendering — this panel refreshes itself.</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_panelMessage))
    {
        <div class="alert @(_panelMessageIsError ? "alert-danger" : "alert-secondary") py-1 small mb-2">@_panelMessage</div>
    }

    @foreach (var state in BodyStates)
    {
        var slots = CharacterIdentityBodySlots.For(state)
            .Where(slot => SelectedSlot is null || (slot.State == SelectedSlot.State && slot.View == SelectedSlot.View))
            .ToList();
        if (slots.Count == 0)
        {
            continue;
        }

        var accepted = slots.Count(slot => ViewFor(slot)?.Status == CharacterIdentityAngleStatus.Accepted);
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@(SelectedSlot is null ? $"{state} views" : SelectedSlot.Label)</strong>
                @if (SelectedSlot is null)
                {
                    <span class="badge @(accepted == slots.Count ? "text-bg-success" : "text-bg-secondary")">@accepted / @slots.Count accepted</span>
                }
            </div>
            <div class="card-body">
                @foreach (var slot in slots)
                {
                    var key = CharacterIdentityBodyViewKey.Canonical(slot.State, slot.View);
                    var keyText = key.Describe();
                    var view = ViewFor(slot);
                    var open = SelectedSlot is not null || string.Equals(_openKey, keyText, StringComparison.Ordinal);
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-semibold small">@slot.Label</span>
                            @if (slot.IsBase)
                            {
                                <span class="badge text-bg-info">base</span>
                            }
                            <span class="badge @StatusBadge(view)">@(view?.Status.ToString() ?? "NotStarted")</span>
                            @if (IsSubmitting(keyText))
                            {
                                @* The request is in flight RIGHT NOW. Without this the operator sees every button on the
                                   panel go dead with nothing to say why, and concludes the click did nothing. *@
                                <span class="badge text-bg-info">
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Submitting…
                                </span>
                            }
                            @if (view is not null && view.QualityRating != SceneImageReferenceQuality.NotRated)
                            {
                                <span class="badge text-bg-light" title="@view.QualityNotes">quality: @view.QualityRating</span>
                            }
                            @if (view?.ManualOverrideApplied == true)
                            {
                                <span class="badge text-bg-warning" title="@view.ManualOverrideReason">override by @view.ManualOverrideAuthor</span>
                            }
                            @if (PreviewFor(view) is { } preview)
                            {
                                <button type="button" class="btn p-0 border-0 bg-transparent"
                                        title="Open this image full size"
                                        @onclick="() => OpenViewer(slot.Label, view)">
                                    <img src="@preview" class="border rounded" style="height:64px;width:64px;object-fit:cover;cursor:zoom-in;" alt="@slot.Label" />
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenViewer(slot.Label, view)">
                                    View image
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => ToggleAsync(key)">
                                @(open ? "Close" : "Open")
                            </button>
                        </div>

                        @if (view?.Status == CharacterIdentityAngleStatus.Blocked && !string.IsNullOrWhiteSpace(view.FailureReason))
                        {
                            <div class="small text-danger mt-1">@view.FailureReason</div>
                        }

                        @* The prerequisite, stated BEFORE the button is pressed: an angle render is the accepted base body
                           turned, so with no accepted base it can only refuse. Naming it here is what makes the next step
                           obvious instead of leaving "Render angle" looking inert. *@
                        @if (!slot.IsBase && AcceptedBasePreview(key) is null)
                        {
                            <div class="small text-warning mt-1">
                                The @slot.State front is not accepted yet, so <strong>@GenerateLabelFor(slot)</strong> would
                                refuse: an angle is that same body, turned. Accept the front first (record its findings, or use
                                "All four pass · record &amp; accept" on that row).
                            </div>
                        }

                        @* A Pending row whose image was deleted can never complete: the poll watches for the artifact that
                           is gone. Said plainly rather than left as a row that renders forever. *@
                        @if (view?.Status == CharacterIdentityAngleStatus.Pending && MissingArtifact(view))
                        {
                            <div class="small text-warning mt-1">
                                This view is marked Pending, but its queued image no longer exists — it was deleted after
                                being queued, so nothing will arrive. Render it again.
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(MessageFor(keyText)))
                        {
                            <div class="small text-muted mt-1">@MessageFor(keyText)</div>
                        }

                        @if (open)
                        {
                            <div class="mt-2">
                                @* The image composition is the ONE shared step every surface uses: its Face, Body and Pose
                                   tabs bind the conditionings, and its prompt panel and Generate submit replace this
                                   panel's own prompt box and generate button. *@
                                @if (BodyViewBlueprint is { } blueprint)
                                {
                                    <ImageStepComposer Blueprint="blueprint"
                                                       ModelChoices="ModelChoices"
                                                       SelectedModelId="@ModelId"
                                                       SelectedModelIdChanged="OnModelChanged"
                                                       ModelPlaceholder="Select model…"
                                                       AutoSelectDefaultModel="false"
                                                       Bindings="ViewBindingsFor(keyText)"
                                                       BindingsChanged="bindings => SetViewBindings(keyText, bindings)"
                                                       CharacterLoras="ViewLorasFor(keyText)"
                                                       CharacterLorasChanged="loras => SetViewLoras(keyText, loras)"
                                                       Prompt="@PromptFor(keyText)"
                                                       PromptChanged="p => OnPromptEditedAsync(key, p)"
                                                       OnGeneratePrompt="() => GeneratePromptAsync(key)"
                                                       Busy="@(IsSubmitting(keyText) || IsCompiling(keyText))"
                                                       CanSubmit="@CanGenerate"
                                                       SubmitLabel="Generate"
                                                       SubmitBlockedReason="@(CanGenerate ? null : "Set the body view model and image size in Body view setting.")"
                                                       OnSubmit="() => GenerateAsync(key)" />
                                }

                                @* The scene-LoRA picker (unlock / act / anatomy / style) — the SAME shared control the
                                   Studio, the Playground and the asset creator render. It lists by the selected model's
                                   family and shows nothing for a family with no catalog rows, so it can never offer a
                                   LoRA the render would refuse. *@
                                @if (!string.IsNullOrWhiteSpace(ModelId))
                                {
                                    <div class="mt-2">
                                        <SceneLoraPicker Family="@SelectedModelFamily"
                                                         Selections="ViewSceneLorasFor(keyText)"
                                                         SelectionsChanged="loras => SetViewSceneLoras(keyText, loras)"
                                                         Disabled="@(IsSubmitting(keyText) || IsCompiling(keyText))"
                                                         Scope="@($"body-scene-lora-{slot.State}-{slot.View}")" />
                                    </div>
                                }

                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @if (slot.IsBase)
                                    {
                                        @* A base has no source to derive from, so "edit from accepted source" cannot apply to it:
                                           it used to refuse with "is generated or uploaded, not derived from another view". Its
                                           image is edited in the SHARED editor instead — the same screen every other body image
                                           and every review-deck image opens, and the result lands in this view's candidates. *@
                                        @if (EditImageUrlFor(view) is { } rowEditUrl)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@rowEditUrl"
                                               title="Edit this image in the shared editor; the result joins this view's candidates">Edit image</a>
                                        }
                                        else
                                        {
                                            <span class="small text-muted align-self-center">Nothing to edit yet — generate an image first.</span>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditFromSourceAsync(key)" disabled="@(IsSubmitting(keyText) || !CanGenerate)">@EditLabelFor(slot)</button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RecordSourceAsResultAsync(key)" disabled="@IsSubmitting(keyText)">Record source as result</button>
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => AcceptAsync(key)" disabled="@IsSubmitting(keyText)">Accept</button>
                                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => AnalyzeQualityAsync(key)" disabled="@IsSubmitting(keyText)">Analyze quality</button>
                                    @* Every image this view produced or edited reaches one screen: the row's own candidate
                                       batch IS what the deck lists. *@
                                    <a class="btn btn-sm btn-outline-info" href="@ReviewDeckUrlFor(key)"
                                       title="Every image this view created or edited">Review deck</a>
                                </div>

                                @* An unclothed view can be produced by EDITING the approved CLOTHED same-angle to remove
                                   clothes, so the clothed/unclothed pairs match by angle. The source is shown with its
                                   thumbnail — an edit is never a blind request. *@
                                @if (key.State == SceneImageReferenceBodyState.Unclothed)
                                {
                                    <div class="border rounded p-2 mt-2">
                                        <div class="small fw-semibold mb-1">
                                            Approved @ClothedAngleLabel(slot) — edit to remove clothes
                                        </div>
                                        @if (AcceptedClothedAnglePreview(key) is { } clothedUrl)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <img src="@clothedUrl" class="border rounded"
                                                     style="height:80px;width:80px;object-fit:cover;" alt="approved clothed source" />
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => EditFromClothedSourceAsync(key)"
                                                        disabled="@(IsSubmitting(keyText) || !CanGenerate)"
                                                        title="Edit the approved clothed view to remove clothes; the result joins this view's candidates">
                                                    Edit — remove clothes
                                                </button>
                                                @if (AcceptedClothedAngleEditUrl(key) is { } clothedEditUrl)
                                                {
                                                    <a class="btn btn-sm btn-outline-primary" href="@clothedEditUrl"
                                                       title="Open the full editor on the approved clothed image — masks, prompt and model, nothing canned">
                                                        <i class="bi bi-magic me-1"></i>Full editor
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-warning">
                                                The @ClothedAngleLabel(slot) is not accepted yet, so there is no clothed image to
                                                remove clothes from. Accept the @ClothedAngleLabel(slot) first.
                                            </div>
                                        }
                                    </div>
                                }

                                @* WHAT this render sends, shown before it is sent: an angle render is the accepted body turned
                                   by the committed angle skeleton, so both are named here with their thumbnails — and the
                                   identity face joins them when the switch below is on. Nothing about the request is
                                   implicit. *@
                                @if (!slot.IsBase && AngleSkeletonFor(slot) is { } angleSkeleton)
                                {
                                    <div class="border rounded p-2 mt-2">
                                        <div class="small fw-semibold mb-1">What <strong>Render angle</strong> sends</div>
                                        <div class="d-flex flex-wrap gap-2 align-items-start">
                                            <div class="text-center" style="width:96px;">
                                                @if (AcceptedBasePreview(key) is { } baseUrl)
                                                {
                                                    <img src="@baseUrl" class="border rounded"
                                                         style="height:80px;width:80px;object-fit:cover;" alt="accepted body reference" />
                                                }
                                                else
                                                {
                                                    <div class="border rounded bg-light d-flex align-items-center justify-content-center text-muted small"
                                                         style="height:80px;width:80px;">none</div>
                                                }
                                                <div class="small text-muted">accepted base body</div>
                                            </div>
                                            <div class="text-center" style="width:96px;">
                                                <img src="@($"/pose-library/{angleSkeleton.FileName}")" class="border rounded"
                                                     style="height:80px;width:80px;object-fit:contain;background:#f8f9fa;" alt="angle skeleton" />
                                                <div class="small text-muted">@slot.View pose</div>
                                            </div>
                                            <div class="small text-muted" style="max-width:26rem;">
                                                The committed <code>@angleSkeleton.FileName</code> is annotated from a figure in
                                                this view (<span title="@angleSkeleton.VerifiedOn">provenance</span>) — it supplies the
                                                turn, the accepted base supplies the build, the prompt supplies the rest.
                                                @if (!string.IsNullOrWhiteSpace(angleSkeleton.KnownLimitation))
                                                {
                                                    <div>Angle skeleton note: @angleSkeleton.KnownLimitation</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }


                                @* Every attempt this view has ever produced, NEWEST first. A re-run never erases the
                                   previous result — the view row only ever pointed at the newest image — so this is
                                   the compare deck: each candidate shows the image, the prompt that made it and the
                                   model that ran it, side by side. *@
                                @{
                                    var candidates = CandidatesFor(key);
                                }
                                <div class="border rounded p-2 mt-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small fw-semibold">
                                            Candidates (@candidates.Count)
                                            @if (candidates.Count > 1)
                                            {
                                                <span class="text-muted fw-normal">— compare the prompt and model on each</span>
                                            }
                                        </span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@_refreshing">Refresh</button>
                                    </div>
                                    @if (candidates.Count == 0)
                                    {
                                        <p class="small text-muted mb-0">
                                            Nothing has been generated for this view yet. Every image this view produces
                                            stays listed here, including ones a later re-run replaced.
                                        </p>
                                    }
                                    else
                                    {
                                        <div class="row g-2 mt-2">
                                            @foreach (var candidate in candidates)
                                            {
                                                <div class="col-sm-6 col-xl-4 col-xxl-3">
                                                    <ImageCard Model="CandidateCardModel(candidate)"
                                                               Busy="IsSubmitting(keyText)"
                                                               ShowName="true"
                                                               NameChanged="name => RenameCandidateAsync(candidate, name)"
                                                               AcceptTitle="Make this image this view's result and accept the view (the recorded findings gate still applies)"
                                                               AcceptRequested="() => AcceptCandidateAsync(key, candidate.Id)"
                                                               ShortlistRequested="() => DecideCandidateAsync(key, candidate.Id, SceneAssetCandidateDecision.Shortlisted)"
                                                               RejectRequested="() => DecideCandidateAsync(key, candidate.Id, SceneAssetCandidateDecision.Rejected)"
                                                               EditRequested="() => OpenCandidateEdit(candidate)"
                                                               ReviewRequested="() => OpenCandidateReview(candidate)"
                                                               DownloadRequested="() => OpenCandidateDownload(candidate)"
                                                               VideoRequested="() => OpenCandidateVideo(candidate)"
                                                               LoadIntoGeneratorRequested="() => LoadCandidatePromptAsync(key, candidate)"
                                                               DeleteRequested="() => DeleteCandidateAsync(key, candidate)">
                                                        <BodyContent>
                                                            @if (candidate.Status == SceneAssetStatus.Complete)
                                                            {
                                                                <div class="mt-2">
                                                                    <ImageTags Image="candidate" Editable="true" TagsChanged="() => RefreshAsync()" />
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(candidate.CandidateNotes))
                                                            {
                                                                <div class="small text-muted">Note: @candidate.CandidateNotes</div>
                                                            }
                                                        </BodyContent>
                                                        <FooterContent>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                                    @onclick="() => DecideCandidateAsync(key, candidate.Id, SceneAssetCandidateDecision.Undecided)"
                                                                    disabled="@IsSubmitting(keyText)"
                                                                    title="Return this candidate to Undecided">Undecide</button>
                                                            @if (candidate.CandidateDecision == SceneAssetCandidateDecision.Accepted
                                                                && view?.Status != CharacterIdentityAngleStatus.Accepted)
                                                            {
                                                                <div class="small text-warning w-100 mt-1">
                                                                    This image is decided Accepted, but the VIEW is not accepted yet
                                                                    (@(view?.Status.ToString() ?? "NotStarted")). Record this view's findings (or an
                                                                    attributed override) and then accept it.
                                                                </div>
                                                            }
                                                        </FooterContent>
                                                    </ImageCard>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="mt-2">
                                    <label class="form-label small mb-1">Upload this view</label>
                                    <InputFile class="form-control form-control-sm" accept="image/png,image/jpeg,image/webp"
                                               OnChange="args => UploadAsync(key, args)" />
                                </div>

                                <div class="border-top mt-2 pt-2">
                                    <div class="small fw-semibold mb-1">Findings — a judgement about this image, recorded with who made it</div>
                                    <div class="row g-2">
                                        @foreach (var check in CharacterIdentityBodyChecks.All)
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label small mb-1">@CharacterIdentityBodyChecks.Label(check)</label>
                                                <select class="form-select form-select-sm"
                                                        value="@VerdictFor(keyText, check)"
                                                        @onchange="e => SetVerdict(keyText, check, e.Value?.ToString())">
                                                    @foreach (var verdict in Enum.GetValues<CharacterIdentityBodyCheckVerdict>())
                                                    {
                                                        <option value="@verdict">@verdict</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        <div class="col-md-6">
                                            <label class="form-label small mb-1">Reviewer</label>
                                            <CommittedTextInput class="form-control form-control-sm" Live="@ReviewerFor(keyText)"
                                                   LiveChanged="e => _reviewers[keyText] = e ?? string.Empty" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small mb-1">Note</label>
                                            <CommittedTextInput class="form-control form-control-sm" Live="@NoteFor(keyText)"
                                                   LiveChanged="e => _notes[keyText] = e ?? string.Empty" />
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success mt-2"
                                            @onclick="() => RecordFindingsAsync(key)" disabled="@IsSubmitting(keyText)">
                                        Record findings
                                    </button>
                                    @* One action for the common judgement. The gate read as "the workflow is stuck": an image was
                                       approved and nothing said that acceptance ALSO needs the four checks recorded. The record is
                                       identical either way — an attributed verdict per check, against the named reviewer. *@
                                    <button type="button" class="btn btn-sm btn-success mt-2 ms-1"
                                            @onclick="() => RecordChecksPassedAndAcceptAsync(key)" disabled="@IsSubmitting(keyText)"
                                            title="Record the named reviewer's judgement that all four checks pass, then accept the view">
                                        All four pass · record &amp; accept
                                    </button>
                                    @if (view is not null && view.Findings.NotPassed.Count > 0)
                                    {
                                        <div class="small text-muted mt-1">
                                            Not a recorded pass: @string.Join(", ", view.Findings.NotPassed.Select(item => $"{CharacterIdentityBodyChecks.Label(item.Check)} = {item.Verdict}"))
                                        </div>
                                    }
                                </div>

                                <div class="border-top mt-2 pt-2">
                                    <div class="small fw-semibold mb-1">Attributed override — only for a view the checks refuse</div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <CommittedTextInput class="form-control form-control-sm" placeholder="Reason"
                                                   Live="@OverrideReasonFor(keyText)"
                                                   LiveChanged="e => _overrideReasons[keyText] = e ?? string.Empty" />
                                        </div>
                                        <div class="col-md-6">
                                            <CommittedTextInput class="form-control form-control-sm" placeholder="Author"
                                                   Live="@OverrideAuthorFor(keyText)"
                                                   LiveChanged="e => _overrideAuthors[keyText] = e ?? string.Empty" />
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-warning mt-2"
                                            @onclick="() => RecordOverrideAsync(key)" disabled="@IsSubmitting(keyText)">
                                        Record override
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header"><strong>Extended view</strong></div>
        <div class="card-body">
            <p class="small text-muted">
                A rotation plus a position key, for a view no canonical slot names. It is a request of its own — it is
                never promoted into a pack slot.
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-1">State</label>
                    <select class="form-select form-select-sm" value="@_extendedState" @onchange="e => _extendedState = ParseState(e.Value?.ToString())">
                        @foreach (var state in BodyStates)
                        {
                            <option value="@state">@state</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Rotation (deg)</label>
                    @* The box draws the operator's own text, never the parsed int: typing "-" or clearing the box
                       mid-edit parses to 0, and drawing that would rewrite what they are typing. ParseRotation still
                       keeps the number current on every keystroke, so Generate uses what is in the box. *@
                    <CommittedTextInput type="number" min="-180" max="180" class="form-control form-control-sm"
                           Live="@_extendedRotationText" LiveChanged="OnExtendedRotationInput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Position key</label>
                    <CommittedTextInput class="form-control form-control-sm" placeholder="e.g. standing"
                           Live="@_extendedPosition" LiveChanged="e => _extendedPosition = e ?? string.Empty" />
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-primary" @onclick="GenerateExtendedAsync" disabled="@(_extendedBusy || !CanGenerate)">Generate</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleExtendedAsync" disabled="@_extendedBusy">Open actions</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_extendedMessage))
            {
                <div class="small text-muted mt-2">@_extendedMessage</div>
            }
        </div>
    </div>
}

@if (_viewer is not null)
{
    @* The grid is a workspace, not a thumbnail sheet: every view can be opened at full size, with its source beside
       it when it was produced as an edit of an accepted view. *@
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.88);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @_viewer.Label
                        <span class="badge @StatusBadge(_viewer.View) ms-2">@(_viewer.View?.Status.ToString() ?? "NotStarted")</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseViewer" title="Close"></button>
                </div>
                <div class="modal-body text-center" style="overflow:auto;">
                    <img src="@_viewer.Url"
                         class="@(_viewerZoomed ? string.Empty : "img-fluid")"
