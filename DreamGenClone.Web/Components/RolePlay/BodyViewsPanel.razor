        IsComplete = candidate.Status == SceneAssetStatus.Complete,
        ErrorMessage = candidate.ErrorMessage,
        Subtitle = candidate.CreatedUtc.ToLocalTime().ToString("g"),
        DecisionBadgeText = candidate.CandidateDecision?.ToString(),
        DecisionBadgeTitle = "This attempt's pick in the body-view deck.",
        CandidateBatchId = candidate.CandidateBatchId,
        DisplayName = candidate.DisplayName,
        IsProductionApproved = candidate.ProductionApprovalStatus == SceneAssetProductionApprovalStatus.Approved
    };

