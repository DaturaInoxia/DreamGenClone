            /// ("-", "") stays in the box instead of being replaced by the 0 it parses to.
            /// </summary>
            private void OnExtendedRotationInput(string? text)
            {
                _extendedRotationText = text ?? string.Empty;
                _extendedRotation = ParseRotation(_extendedRotationText);
            }
