    /// <summary>Loads this candidate's prompt into the view's prompt box so it can be tweaked and regenerated.</summary>
    private Task LoadCandidatePromptAsync(CharacterIdentityBodyViewKey key, SceneAssetImage candidate)
    {
        SetPrompt(key.Describe(), candidate.Prompt);
        SetMessage(key.Describe(), $"Loaded the prompt from {candidate.Id[..Math.Min(8, candidate.Id.Length)]}… into the view's prompt box.");
        return Task.CompletedTask;
    }

    /// <summary>
    /// Records the operator's judgement about one candidate. This is a decision ABOUT an image, so it never moves
    /// or deletes the image — the whole point of the deck is that every attempt stays comparable.
    /// </summary>
    private async Task DecideCandidateAsync(
        CharacterIdentityBodyViewKey key, string imageId, SceneAssetCandidateDecision decision)
    {
        var keyText = key.Describe();
        if (!_submitting.Add(keyText))
        {
            return;
        }

        try
        {
            await AssetService.SetImageCandidateDecisionAsync(imageId, decision, null);
            await RefreshAsync();
            SetMessage(keyText, $"Candidate {imageId} marked {decision}.");
        }
        catch (Exception error)
        {
            SetMessage(keyText, error.Message);
        }
        finally
        {
            _submitting.Remove(keyText);
        }
    }

    /// <summary>
    /// Opens one view's image at full size. The source is shown beside it when the view was produced as an edit of
    /// an accepted view, because that is the comparison the operator is actually making.
    /// </summary>
    private void OpenViewer(string label, CharacterIdentityBodyView? view)
    {
        if (PreviewFor(view) is not { } url)
        {
            return;
        }

        var sourceUrl = view?.InputArtifactId is { } inputId
            && _previews.TryGetValue(inputId, out var source)
                ? source
                : null;
        _viewer = new ViewerState(label, url, sourceUrl, view);
        _viewerZoomed = false;
    }

    private void CloseViewer() => _viewer = null;

    /// <summary>What the full-size viewer is showing.</summary>
    private sealed record ViewerState(
        string Label, string Url, string? SourceUrl, CharacterIdentityBodyView? View);

    /// <summary>Rows whose prompt is being resolved right now, so the button can say so.</summary>
    private readonly HashSet<string> _reloading = new(StringComparer.Ordinal);

    /// <summary>Rows whose prompt is being compiled through the shared image-cell prompt compiler right now.</summary>
    private readonly HashSet<string> _compiling = new(StringComparer.Ordinal);

    /// <summary>
    /// Bumped each time a row's prompt is re-resolved. It is the textarea's <c>@key</c>, which is the only reliable
    /// way to make Blazor recreate an uncontrolled input so it shows the resolved text again.
    /// </summary>
    private readonly Dictionary<string, int> _promptRevisions = new(StringComparer.Ordinal);

    private void BumpPromptRevision(string keyText)
        => _promptRevisions[keyText] = _promptRevisions.TryGetValue(keyText, out var revision) ? revision + 1 : 1;

    private int PromptRevisionFor(string keyText)
        => _promptRevisions.TryGetValue(keyText, out var revision) ? revision : 0;

    /// <summary>True while this row's prompt is being compiled.</summary>
    private bool IsCompiling(string keyText) => _compiling.Contains(keyText);

    private string PromptFor(string keyText) => _prompts.TryGetValue(keyText, out var prompt) ? prompt : string.Empty;    private string? PromptOrNull(CharacterIdentityBodyViewKey key)
    {
        var prompt = PromptFor(key.Describe());
        return string.IsNullOrWhiteSpace(prompt) ? null : prompt;
    }

    private void SetPrompt(string keyText, string? value) => _prompts[keyText] = value ?? string.Empty;

    /// <summary>
    /// Records an operator edit in the panel and schedules it to be PERSISTED a moment later, so a reload shows what
    /// they entered instead of re-compiling the body card over it.
    /// </summary>
    private Task OnPromptEditedAsync(CharacterIdentityBodyViewKey key, string? value)
    {
        SetPrompt(key.Describe(), value);
        _pendingPromptKey = key;
        _promptSaveDebounce ??= new Timer(_ => _ = InvokeAsync(SavePendingPromptAsync), null, Timeout.Infinite, Timeout.Infinite);
        _promptSaveDebounce.Change(TimeSpan.FromMilliseconds(800), Timeout.InfiniteTimeSpan);
        return Task.CompletedTask;
    }

    /// <summary>Persists the last edited prompt. Failure here must not interrupt editing, so it is swallowed after a log.</summary>
    private async Task SavePendingPromptAsync()
    {
        var key = _pendingPromptKey;
        _pendingPromptKey = null;
        if (key is null || string.IsNullOrWhiteSpace(BuildId))
        {
            return;
        }

        try
        {
            await BodyService.SavePromptOverrideAsync(BuildId, key, PromptFor(key.Describe()));
        }
        catch (Exception)
        {
            // The edit stays in the panel; the next save retries. A transient store failure must not look like the
            // edit was lost.
        }
    }

    private string MessageFor(string keyText) => _messages.TryGetValue(keyText, out var message) ? message : string.Empty;

    private string ReviewerFor(string keyText) => _reviewers.TryGetValue(keyText, out var value) ? value : string.Empty;

    private string NoteFor(string keyText) => _notes.TryGetValue(keyText, out var value) ? value : string.Empty;

    private string OverrideReasonFor(string keyText) => _overrideReasons.TryGetValue(keyText, out var value) ? value : string.Empty;

    private string OverrideAuthorFor(string keyText) => _overrideAuthors.TryGetValue(keyText, out var value) ? value : string.Empty;

    private string VerdictFor(string keyText, CharacterIdentityBodyCheck check)
    {
        var draftKey = $"{keyText}|{check}";
        if (_draftVerdicts.TryGetValue(draftKey, out var draft))
        {
            return draft.ToString();
        }

        // Nothing drafted yet: the row shows what the view already recorded, so a reviewer edits a real state
        // rather than a silent default.
        var view = _views.FirstOrDefault(candidate => string.Equals(candidate.Key().Describe(), keyText, StringComparison.Ordinal));
        return (view?.Findings.VerdictFor(check) ?? CharacterIdentityBodyCheckVerdict.NotReviewed).ToString();
    }

    private void SetVerdict(string keyText, CharacterIdentityBodyCheck check, string? value)
        => _draftVerdicts[$"{keyText}|{check}"] =
            Enum.TryParse<CharacterIdentityBodyCheckVerdict>(value, out var verdict)
                ? verdict
                : CharacterIdentityBodyCheckVerdict.NotReviewed;

    private CharacterIdentityBodyViewKey ExtendedKey()
        => CharacterIdentityBodyViewKey.Extended(_extendedState, _extendedRotation, _extendedPosition);

    /// <summary>
    /// True when a model and a size are both chosen. Nothing here falls back to "the first model" or a guessed size:
    /// an image produced with a model the operator did not choose would be a silent decision about their identity
    /// pack.
    /// </summary>
    private bool CanGenerate => !string.IsNullOrWhiteSpace(ModelId) && !string.IsNullOrWhiteSpace(ImageSize);

    /// <summary>
    /// The extended-view actions validate their key BEFORE anything calls <c>Describe()</c>, because an extended key
    /// with no position refuses to describe itself — and a refusal thrown out of an event handler is a button that
    /// silently does nothing, which is exactly what this guard exists to prevent.
    /// </summary>
    private bool TryExtendedKey(out CharacterIdentityBodyViewKey key, out string refusal)
    {
        if (string.IsNullOrWhiteSpace(_extendedPosition))
        {
            key = CharacterIdentityBodyViewKey.Extended(_extendedState, _extendedRotation, string.Empty);
            refusal = "An extended view needs a position key (for example 'standing'). Without it the request has no "
                + "identity, so nothing was started.";
            return false;
        }

        key = ExtendedKey();
        refusal = string.Empty;
        return true;
    }

    private Task GenerateExtendedAsync()
    {
        if (!TryExtendedKey(out var key, out var refusal))
        {
            ShowPanelRefusal(refusal);
            return Task.CompletedTask;
        }

        return RunExtendedAsync(() => GenerateAsync(key));
    }

    private Task ToggleExtendedAsync()
    {
        if (!TryExtendedKey(out var key, out var refusal))
        {
            ShowPanelRefusal(refusal);
            return Task.CompletedTask;
        }

        return RunExtendedAsync(() => ToggleAsync(key));
    }

    /// <summary>Gives the extended-view controls their own in-flight state, since their key is not a slot.</summary>
    private async Task RunExtendedAsync(Func<Task> action)
    {
        if (_extendedBusy)
        {
            return;
        }

        _extendedBusy = true;
        try
        {
            await action();
        }
        finally
        {
            _extendedBusy = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// A refusal that belongs to the panel's own form (the model/size choice, an incomplete extended key) is shown at
    /// the top of the panel — visible no matter which view happens to be open.
    /// </summary>
    private void ShowPanelRefusal(string refusal)
    {
        _panelMessage = refusal;
        _panelMessageIsError = true;
    }

    private static string StatusBadge(CharacterIdentityBodyView? view) => view?.Status switch
    {
        CharacterIdentityAngleStatus.Accepted => "text-bg-success",
        CharacterIdentityAngleStatus.Complete => "text-bg-info",
        CharacterIdentityAngleStatus.Pending => "text-bg-primary",
        CharacterIdentityAngleStatus.Failed or CharacterIdentityAngleStatus.Blocked => "text-bg-danger",
        _ => "text-bg-secondary"
    };

