        => Enum.TryParse<SceneImageReferenceBodyState>(value, out var state)
            ? state
            : throw new InvalidOperationException($"Unsupported body state '{value}'.");    private static int ParseRotation(string? value)
        => int.TryParse(value, out var rotation) ? rotation : 0;

            /// <summary>
            /// The rotation box's own text: the int above is derived from it and never drawn from, so a half-typed value
            /// ("-", "") stays in the box instead of being replaced by the 0 it parses to.
            /// </summary>
            private void OnExtendedRotationInput(string? text)
            {
                _extendedRotationText = text ?? string.Empty;
                _extendedRotation = ParseRotation(_extendedRotationText);
            }
