    private Task UploadAsync(CharacterIdentityBodyViewKey key, InputFileChangeEventArgs args)
        => RunAsync(key, async () =>
        {
            var file = args.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            await BodyService.UploadAsync(BuildId, key, file.Name, buffer);
            return $"Uploaded {file.Name} as {key.Describe()}.";
        });

    /// <summary>
    /// The view an open in-app picker will fill, or null when it is closed. One field rather than a flag per row: the
    /// picker is a single modal, so "which view is this for" has to be answered by whatever opened it.
    /// </summary>
    private CharacterIdentityBodyViewKey? _pickerKey;

    private void OpenPicker(CharacterIdentityBodyViewKey key) => _pickerKey = key;

    private void ClosePicker() => _pickerKey = null;

    /// <summary>
    /// Stores an image chosen from inside the app as this view's next candidate. It goes through the SAME service call
    /// the file path uses, so a body image picked from the app lands exactly where an uploaded one would — the pick
    /// only changes where the bytes came from, not what the view does with them.
    /// </summary>
    private Task UsePickedImageAsync(InAppPickedImage picked)
    {
        if (_pickerKey is not { } key)
        {
            return Task.CompletedTask;
        }

        _pickerKey = null;
        return RunAsync(key, async () =>
        {
            using var buffer = new MemoryStream(picked.Content);
            await BodyService.UploadAsync(BuildId, key, picked.FileName, buffer);
            return $"Used {picked.SourceLabel} as {key.Describe()}.";
        });
    }

    /// <summary>
    /// One view, one service call: the message is written to that view's row, never to the panel, so a refusal can
    /// never be mistaken for another view's outcome.
    /// </summary>
    private async Task RunAsync(CharacterIdentityBodyViewKey key, Func<Task<string?>> action)
    {
        var keyText = key.Describe();

        // Guarded per ROW, not per panel: two different views can be operated at once, and a background refresh must
        // never block either. A second click on the SAME row is what this refuses (the button is disabled too).
        if (!_submitting.Add(keyText))
        {
            return;
        }

        // Paint the in-flight state BEFORE awaiting: a render takes tens of seconds, and a spinner that only appears
        // after the work is done is not an indicator at all.
        StateHasChanged();
        try
        {
            var message = await action();
            if (!string.IsNullOrWhiteSpace(message))
            {
                SetMessage(keyText, message);
            }

            await LoadPanelStateAsync();
            _panelMessage = string.Empty;
            _panelMessageIsError = false;
        }
        catch (Exception error)
        {
            SetMessage(keyText, error.Message);
        }
        finally
        {
            _submitting.Remove(keyText);
            StateHasChanged();
        }
    }

    /// <summary>True while this view's request is on the wire.</summary>
    private bool IsSubmitting(string keyText) => _submitting.Contains(keyText);

    private void SetMessage(string keyText, string message)
    {
        _messages[keyText] = message;
        // With no row open, the message is shown next to the extended-view controls so a refusal is never invisible.
        if (_openKey is null)
        {
            _extendedMessage = message;
        }
    }

    private CharacterIdentityBodyView? ViewFor(CharacterIdentityBodySlot slot)
        => ViewFor(CharacterIdentityBodyViewKey.Canonical(slot.State, slot.View));

    private CharacterIdentityBodyView? ViewFor(CharacterIdentityBodyViewKey key)
        => _views.FirstOrDefault(view => view.Key() == key);

    /// <summary>
    /// The image the row SHOWS: the accepted candidate when this view has one, otherwise the view's current artifact.
    /// The row used to show the newest image, which is the last thing GENERATED — after choosing a different candidate
    /// from the deck the row and the deck disagreed about which image the view actually is.
    /// </summary>
    private string? PreviewFor(CharacterIdentityBodyView? view)
    {
        var accepted = view is null
            ? null
            : CandidatesFor(view.Key()).FirstOrDefault(
                candidate => candidate.CandidateDecision == SceneAssetCandidateDecision.Accepted);
        var artifactId = accepted?.Id ?? view?.OutputArtifactId;
        return string.IsNullOrWhiteSpace(artifactId) || !_previews.TryGetValue(artifactId, out var url) ? null : url;
    }

    /// <summary>The shared image editor, addressed by the image's own asset — the same screen the asset library uses.</summary>
    private string? EditUrlFor(SceneAssetImage candidate)
        => string.IsNullOrWhiteSpace(candidate.AssetId) || string.IsNullOrWhiteSpace(candidate.Id)
            ? null
            : $"/assets/{candidate.AssetId}/images/{candidate.Id}/edit";

    /// <summary>
    /// The shared editor for the image this row currently shows, or null when the row has no image yet. A base view has
    /// no source to derive from, so this — not "edit from accepted source" — is how its image is changed.
    /// </summary>
    private string? EditImageUrlFor(CharacterIdentityBodyView? view)
    {
        var imageId = view?.OutputArtifactId;
        if (string.IsNullOrWhiteSpace(imageId))
        {
            return null;
        }

        var assetId = _candidatesByBatch.Values
            .SelectMany(candidates => candidates)
            .FirstOrDefault(candidate => string.Equals(candidate.Id, imageId, StringComparison.Ordinal))?.AssetId;

        return string.IsNullOrWhiteSpace(assetId)
            ? null
            : $"/assets/{assetId}/images/{imageId}/edit";
    }

    /// <summary>
    /// This view's review deck: the candidate batch this row's requests already write to.
    ///
    /// The URL carries the <c>asset</c> route kind, which is what makes the deck read SCENE ASSET candidate batches;
    /// the bare <c>/review-deck/{batchId}</c> route reads the older produced-images table, so a body batch opened there
    /// shows "No images are available for this batch" no matter how many it has (verified against the live DB,
    /// 2026-09-23).
    /// </summary>
    private string ReviewDeckUrlFor(CharacterIdentityBodyViewKey key)
        => $"/review-deck/asset/{key.BatchIdFor(BuildId)}";

    /// <summary>
    /// The accepted base body an angle render sends, as a thumbnail: the front of this row's state. Null when that base
    /// is not accepted yet — which is exactly the prerequisite an angle render refuses on.
    /// </summary>
    private string? AcceptedBasePreview(CharacterIdentityBodyViewKey key)
    {
        // The rule the RENDER itself uses, so the prerequisite this panel states and the one the render enforces
        // cannot disagree — an unclothed profile needs its same-side three-quarter, and a panel that still said
        // "accept the front" would be naming a view that would not help.
        var baseView = BodyViewDerivation.RenderBaseFor(key) is { } sourceKey ? ViewFor(sourceKey) : null;
        return baseView is null || baseView.Status != CharacterIdentityAngleStatus.Accepted
            ? null
            : PreviewFor(baseView);
    }

    /// <summary>What this row is waiting for, named for the operator, or null when nothing is missing.</summary>
    private string? PrerequisiteLabelFor(CharacterIdentityBodySlot slot, CharacterIdentityBodyViewKey key)
        => !slot.IsBase
            && AcceptedBasePreview(key) is null
            && BodyViewDerivation.RenderBaseFor(key) is { } sourceKey
                ? BodyViewStatusDisplay.Prerequisite(sourceKey)
                : null;

    /// <summary>
    /// The approved CLOTHED view of the same angle, as a thumbnail, for an UNCLOTHED view — the source a "remove
    /// clothes" edit removes the clothing from. Null for a clothed view, or when its clothed same-angle has not been
    /// accepted yet.
    /// </summary>
    private string? AcceptedClothedAnglePreview(CharacterIdentityBodyViewKey key)
    {
        if (key.State != SceneImageReferenceBodyState.Unclothed || key.View is not { } view)
        {
            return null;
        }

        var clothed = ViewFor(CharacterIdentityBodyViewKey.Canonical(
            SceneImageReferenceBodyState.Clothed, view));
        return clothed is null || clothed.Status != CharacterIdentityAngleStatus.Accepted
            ? null
            : PreviewFor(clothed);
    }

    /// <summary>The label of the CLOTHED slot with the same angle as an unclothed slot — "Clothed three-quarter left", etc.</summary>
    private static string ClothedAngleLabel(CharacterIdentityBodySlot slot)
        => CharacterIdentityBodySlots.Require(SceneImageReferenceBodyState.Clothed, slot.View).Label;

    /// <summary>
    /// The FULL shared editor's URL for the approved CLOTHED same-angle, or null when there is none to edit. This is
    /// the real editor — masks, prompt, model — not the one-shot remove-clothes request, for when the operator wants
    /// to remove the clothing themselves rather than send a canned instruction.
    ///
    /// It carries the UNCLOTHED view's candidate batch, so an edit made there lands in THIS view's deck — the one the
    /// operator is looking at — rather than in the clothed view's deck (the source image's own batch).
    /// </summary>
    private string? AcceptedClothedAngleEditUrl(CharacterIdentityBodyViewKey key)
    {
        if (key.State != SceneImageReferenceBodyState.Unclothed || key.View is not { } view)
        {
            return null;
        }

        var clothed = ViewFor(CharacterIdentityBodyViewKey.Canonical(
            SceneImageReferenceBodyState.Clothed, view));
        if (clothed is null || clothed.Status != CharacterIdentityAngleStatus.Accepted)
        {
            return null;
        }

        var editUrl = EditImageUrlFor(clothed);
        return editUrl is null
            ? null
            : $"{editUrl}?batch={Uri.EscapeDataString(key.BatchIdFor(BuildId))}";
    }

    /// <summary>
    /// True when a view's artifact id is not among the container's images: a row whose image was deleted after it was
    /// queued. The poll completes a Pending view from the ARTIFACT, so without this the row waits forever.
    /// </summary>
    private bool MissingArtifact(CharacterIdentityBodyView view)
        => !string.IsNullOrWhiteSpace(view.OutputArtifactId) && !_imageStatuses.ContainsKey(view.OutputArtifactId!);

    /// <summary>Every candidate this view has produced, NEWEST first — empty until something has been generated.</summary>
    private IReadOnlyList<SceneAssetImage> CandidatesFor(CharacterIdentityBodyViewKey key)
        => _candidatesByBatch.TryGetValue(key.BatchIdFor(BuildId), out var candidates) ? candidates : [];

    /// <summary>The card model for one body-view candidate: the shared card renders its picture, status and decision.</summary>
    private SceneImageCardModel CandidateCardModel(SceneAssetImage candidate) => new()
    {
        Id = candidate.Id,
        FileRelativePath = candidate.FileRelativePath,
        StatusText = candidate.Status.ToString(),
        StatusBadgeClass = candidate.Status switch
        {
            SceneAssetStatus.Complete => "text-bg-success",
            SceneAssetStatus.Failed => "text-bg-danger",
            _ => "text-bg-secondary"
        },
        IsComplete = candidate.Status == SceneAssetStatus.Complete,
        ErrorMessage = candidate.ErrorMessage,
        Subtitle = candidate.CreatedUtc.ToLocalTime().ToString("g"),
        DecisionBadgeText = candidate.CandidateDecision?.ToString(),
        DecisionBadgeTitle = "This attempt's pick in the body-view deck.",
        CandidateBatchId = candidate.CandidateBatchId,
        DisplayName = candidate.DisplayName,
        IsProductionApproved = candidate.ProductionApprovalStatus == SceneAssetProductionApprovalStatus.Approved,
        DecisionKey = candidate.Status switch
        {
            SceneAssetStatus.Pending => ImageCardStatus.Pending,
            SceneAssetStatus.Failed => ImageCardStatus.Failed,
            _ => candidate.CandidateDecision switch
            {
                SceneAssetCandidateDecision.Accepted => ImageCardStatus.Accepted,
                SceneAssetCandidateDecision.Shortlisted => ImageCardStatus.Shortlisted,
                SceneAssetCandidateDecision.Rejected => ImageCardStatus.Rejected,
                SceneAssetCandidateDecision.Revoked => ImageCardStatus.Revoked,
                _ => ImageCardStatus.Undecided
            }
        }
    };

