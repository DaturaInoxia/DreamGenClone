    private SceneAssetBodyReferenceConditioning? BodyFromBindings(IReadOnlyList<ReferenceApplicationSelection> bindings)
        => bindings.FirstOrDefault(binding =>
            string.Equals(binding.Kind, nameof(ImageStepSlotKind.Body), StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(binding.IdentityPackId)) is { } body
                ? new SceneAssetBodyReferenceConditioning(body.IdentityPackId!, body.ReferenceAssetId ?? string.Empty)
                : null;

