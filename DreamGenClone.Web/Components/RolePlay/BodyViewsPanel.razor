        => Enum.TryParse<SceneImageReferenceBodyState>(value, out var state)
            ? state
            : throw new InvalidOperationException($"Unsupported body state '{value}'.");    private static int ParseRotation(string? value)
        => int.TryParse(value, out var rotation) ? rotation : 0;

            /// <summary>
