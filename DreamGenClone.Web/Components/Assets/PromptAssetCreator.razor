@using DreamGenClone.Application.ModelManager
@using DreamGenClone.Application.RolePlay
@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay

@inject ISceneAssetService AssetService
@inject IModelResolutionService ModelResolutionService
@inject ILogger<PromptAssetCreator> Logger

<div class="card h-100">
    <div class="card-header"><strong>Generate Image</strong></div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        <label class="form-label" for="generated-asset-prompt">Description</label>
        <textarea id="generated-asset-prompt" class="form-control" rows="5" @bind="_prompt"></textarea>
        <label class="form-label mt-2" for="generated-asset-model">Image model</label>
        <select id="generated-asset-model" class="form-select" @bind="_modelId">
            <option value="">Select an image model</option>
            @foreach (var choice in _models)
            {
                <option value="@choice.ModelId">@choice.DisplayName - @choice.ProviderName</option>
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(_modelId))
        {
            <div class="mt-3">
                <ReferenceApplyPanel ModelId="@_modelId" Selections="@_referenceApplications"
                                     SelectionsChanged="OnReferenceApplicationsChanged"
                                     ExecutableStrategies="TextOnlyReferenceStrategy" />
                <div class="mt-2">
                    <ResolvedRenderBadge ModelLabel="@SelectedModelLabel()" Selections="@_referenceApplications" />
                </div>
            </div>
        }
        <div class="row g-2 mt-1">
            <div class="col-sm-6">
                <label class="form-label" for="generated-asset-size">Image size</label>
                <select id="generated-asset-size" class="form-select" @bind="_imageSize">
                    <option value="1024x1024">1024 x 1024</option>
                    <option value="1152x896">1152 x 896</option>
                    <option value="896x1152">896 x 1152</option>
                </select>
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="generated-asset-count">Outputs</label>
                <input id="generated-asset-count" type="number" class="form-control" min="1" max="8" @bind="_outputCount" />
            </div>
        </div>
        <button class="btn btn-primary mt-3" type="button" disabled="@(_busy || !CanGenerate)" @onclick="GenerateAsync">
            <i class="bi bi-stars me-1"></i> Generate
        </button>
        @if (_results.Count > 0)
        {
            <div class="alert alert-success mt-3 mb-0">
                @_results.Count output@(_results.Count == 1 ? "" : "s") queued.
                @foreach (var result in _results)
                {
                    <span class="d-block font-monospace text-break">@result.Id</span>
                }
                @if (!string.IsNullOrWhiteSpace(_candidateBatchId))
                {
                    <a class="btn btn-sm btn-outline-success mt-2" href="/review-deck/asset/@_candidateBatchId">
                        <i class="bi bi-collection-play me-1"></i> Review Candidate Batch
                    </a>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string AssetId { get; set; } = string.Empty;
    [Parameter]
    public EventCallback ImagesChanged { get; set; }

    private List<SceneImageModelChoice> _models = [];
    private List<SceneAssetImage> _results = [];
    private string _prompt = string.Empty;
    private string? _modelId;
    private string _imageSize = "1024x1024";
    private int _outputCount = 1;
    private string? _candidateBatchId;
    private static readonly IReadOnlyList<string> TextOnlyReferenceStrategy = ["TextOnly"];
    private readonly List<ReferenceApplicationSelection> _referenceApplications =
    [
        new() { ElementKey = "Identity", SemanticRole = "character identity", AssetType = SceneAssetType.CharacterFace },
        new() { ElementKey = "Body", SemanticRole = "character body", AssetType = SceneAssetType.CharacterBody },
        new() { ElementKey = "Wardrobe", SemanticRole = "wardrobe continuity", AssetType = SceneAssetType.Wardrobe },
        new() { ElementKey = "Location", SemanticRole = "location continuity", AssetType = SceneAssetType.Location }
    ];
    private bool _busy;
    private string? _error;

    private bool CanGenerate => !string.IsNullOrWhiteSpace(AssetId)
        && !string.IsNullOrWhiteSpace(_prompt)
        && !string.IsNullOrWhiteSpace(_modelId);

    private string SelectedModelLabel()
        => _models.FirstOrDefault(choice => choice.ModelId == _modelId)?.DisplayName
            ?? throw new InvalidOperationException("The selected image model is no longer enabled.");

    private Task OnReferenceApplicationsChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _models = (await ModelResolutionService.ListSceneImageModelsAsync(identityCapableOnly: false)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogWarning(ex, "Failed to load models for asset creation.");
        }
    }

    private async Task GenerateAsync()
    {
        if (!CanGenerate) return;

        _busy = true;
        _error = null;
        _results = [];
        _candidateBatchId = Guid.NewGuid().ToString("N");
        try
        {
            var outputCount = Math.Clamp(_outputCount, 1, 8);
            for (var output = 1; output <= outputCount; output++)
            {
                _results.Add(await AssetService.AddGeneratedImageAsync(
                    AssetId, _prompt, _modelId!, _imageSize,
                    referenceApplications: _referenceApplications,
                    candidateBatchId: _candidateBatchId));
            }
            await ImagesChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogWarning(ex, "Asset generation submission failed.");
        }
        finally
        {
            _busy = false;
        }
    }
}