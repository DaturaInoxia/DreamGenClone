@using DreamGenClone.Domain.ModelManager
@using DreamGenClone.Domain.RolePlay
@using DreamGenClone.Web.Application.RolePlay
@inject IWardrobeItemService Wardrobe
@implements IAsyncDisposable

@* The character Wardrobe tab. Wardrobe ITEMS are shared library entries, not character-owned assets: the same dress is
   worn by whoever the scene calls for, so an item created here is reachable from every character's wardrobe row. The
   tab exists on a character because that is where an operator looks for "what does she wear", and it says out loud
   that the library is shared so nobody expects their garment to be private to one character. *@

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <strong>Wardrobe</strong>
            <span class="text-muted small ms-2">Shared library — an item you add here can be worn by any character.</span>
        </span>
        @if (_loading)
        {
            <span class="text-muted small">loading…</span>
        }
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-secondary py-2 small mb-2">@_message</div>
        }

        <div class="border rounded p-3 mb-3">
            <strong class="small d-block mb-2">Add a garment</strong>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="wardrobe-item">Item</label>
                    <select id="wardrobe-item" class="form-select form-select-sm" value="@_itemId" @onchange="OnItemChanged">
                        <option value="">(new item)</option>
                        @foreach (var item in _items)
                        {
                            <option value="@item.Asset.Id">@item.Asset.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="wardrobe-new-name">New item name</label>
                    <input id="wardrobe-new-name" class="form-control form-control-sm" value="@_newItemName"
                           @onchange="e => _newItemName = e.Value?.ToString() ?? string.Empty"
                           placeholder="Yellow sundress" disabled="@(!string.IsNullOrWhiteSpace(_itemId))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="wardrobe-model">Image model</label>
                    <select id="wardrobe-model" class="form-select form-select-sm" value="@_modelId" @onchange="OnModelChanged">
                        <option value="">Select a model</option>
                        @foreach (var model in _models)
                        {
                            <option value="@model.ModelId">@model.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label small mb-1" for="wardrobe-description">Garment, in a few words</label>
                    <input id="wardrobe-description" class="form-control form-control-sm" value="@_description"
                           @oninput="e => _description = e.Value?.ToString() ?? string.Empty"
                           placeholder="a blue one piece swimsuit" />
                    <div class="form-text">
                        The prompt is compiled from this text for the chosen model — a full garment description with its
                        framing, backdrop and lighting — so a few words is the whole input.
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="wardrobe-size">Size</label>
                    <select id="wardrobe-size" class="form-select form-select-sm" value="@_imageSize" @onchange="e => _imageSize = e.Value?.ToString() ?? _imageSize">
                        <option value="896x1152">896 x 1152 (portrait)</option>
                        <option value="1024x1024">1024 x 1024 (square)</option>
                        <option value="1152x896">1152 x 896 (landscape)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="wardrobe-count">Images</label>
                    <input id="wardrobe-count" type="number" class="form-control form-control-sm" min="1" max="8"
                           value="@_outputCount" @onchange="e => _outputCount = ParseCount(e.Value)" />
                </div>
            </div>
            <div class="mt-2">
                <label class="form-label small mb-1" for="wardrobe-prompt">Prompt</label>
                <textarea id="wardrobe-prompt" class="form-control form-control-sm font-monospace" rows="6"
                          aria-label="Prompt used for the render"
                          placeholder="Press Generate prompt to draft this from the description above, or type one yourself."
                          value="@_prompt"
                          @oninput="e => OnPromptChanged(e.Value?.ToString())"></textarea>
                <div class="form-text">
                    The prompt is what the model is actually sent. "Generate prompt" drafts it and stops; edit it here and
                    press "Render image" when it reads right. "Compile prompt and generate" does both in one go.
                </div>
                @if (IsDraftingPrompt)
                {
                    <div class="text-primary small mt-1">
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        Drafting the prompt for the chosen model — this page updates by itself when it arrives.
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(DraftFailureMessage))
                {
                    <div class="text-danger small mt-1">
                        The prompt could not be drafted: @DraftFailureMessage
                    </div>
                }
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_busy || !CanDraftPrompt)"
                        title="Draft the prompt for the chosen model and show it, without rendering"
                        @onclick="GeneratePromptAsync">
                    <i class="bi bi-file-text me-1"></i>Generate prompt
                </button>
                <button type="button" class="btn btn-sm btn-outline-success" disabled="@(_busy || !CanRenderPrompt)"
                        title="Render the prompt above, exactly as it reads"
                        @onclick="RenderFromFormAsync">
                    <i class="bi bi-image me-1"></i>Render image
                </button>
                <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || !CanGenerate)"
                        @onclick="GenerateAsync">
                    <i class="bi bi-magic me-1"></i>Compile prompt and generate
                </button>
                @if (!CanDraftPrompt && !_busy && string.IsNullOrWhiteSpace(_prompt))
                {
                    <span class="form-text">@BlockedReason</span>
                }
                @if (!string.IsNullOrWhiteSpace(_draftedImageId) && !_promptEdited)
                {
                    <span class="form-text">
                        This prompt is drafted but not rendered yet — press "Render image" to use it.
                    </span>
                }
            </div>
        </div>

        @if (_items.Count == 0)
        {
            <div class="text-muted small">No wardrobe items yet.</div>
        }
        else
        {
            @foreach (var item in _items)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <strong>@item.Asset.Name</strong>
                        <span class="small text-muted">@ItemStatus(item)</span>
                    </div>
                    @if (item.Images.Count == 0)
                    {
                        <div class="text-muted small mt-2">No images yet — describe the garment above and generate.</div>
                    }
                    else if (item.Images.All(entry => entry.IsPromptDraft))
                    {
                        @* A drafted prompt is not a picture: it is reported as a PROMPT, with no empty image card
                           pretending an image is on its way. *@
                        <div class="text-muted small mt-2">
                            No images yet — a prompt draft is shown in the box above, where you can edit it and press
                            "Render image".
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mt-1">
                            @foreach (var entry in item.Images.Where(entry => !entry.IsPromptDraft))
                            {
                                <div class="col-sm-6 col-xl-4 col-xxl-3">
                                    <div class="card h-100">
                                        <div class="ratio ratio-1x1 bg-dark">
                                            @if (entry.Image.Status == SceneAssetStatus.Complete && !string.IsNullOrWhiteSpace(entry.Image.FileRelativePath))
                                            {
                                                <img src="/scene-images/@entry.Image.FileRelativePath" class="w-100 h-100" style="object-fit:contain;" alt="@item.Asset.Name image" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center text-light small">@entry.Image.Status</div>
                                            }
                                        </div>
                                        <div class="card-body py-2 small">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="badge @(entry.InUse ? "text-bg-success" : "text-bg-secondary")">
                                                    @(entry.InUse ? "in use" : "not used")
                                                </span>
                                                @if (entry.InUse)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0" disabled="@_busy"
                                                            @onclick="() => SetInUseAsync(entry, false)">Stop using</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success py-0" disabled="@(_busy || entry.Image.Status != SceneAssetStatus.Complete)"
                                                            title="Make this image available as a reference image"
                                                            @onclick="() => SetInUseAsync(entry, true)">Use as reference</button>
                                                }
                                            </div>
                                            @* What the row is DOING. A queued image used to show only "Pending", which is
                                               indistinguishable from a button that did nothing. *@
                                            @if (StateFor(entry) is { Length: > 0 } state)
                                            {
                                                <div class="text-muted mt-1">@state</div>
                                            }
                                            <label class="form-label small mb-1 mt-2" for="label-@entry.Image.Id">Label</label>
                                            <input id="label-@entry.Image.Id" class="form-control form-control-sm" value="@entry.Label"
                                                   placeholder="front" @onchange="e => SaveLabelAsync(entry, e.Value?.ToString())" />
                                            @if (!string.IsNullOrWhiteSpace(entry.Image.ErrorMessage))
                                            {
                                                <div class="text-danger mt-1">@entry.Image.ErrorMessage</div>
                                            }
                                            @* ONE prompt per card, editable: the text that a re-render will send. A
                                               read-only copy beside it showed the same words twice. *@
                                            <details class="mt-2">
                                                <summary class="small">Prompt — edit and re-render</summary>
                                                <textarea class="form-control form-control-sm font-monospace mt-1" rows="6"
                                                          aria-label="Prompt to render again"
                                                          value="@PromptDraft(entry)"
                                                          @oninput="e => SetPromptDraft(entry, e.Value?.ToString())"></textarea>
                                                <button type="button" class="btn btn-sm btn-outline-primary mt-1 w-100"
                                                        disabled="@(_busy || string.IsNullOrWhiteSpace(_modelId))"
                                                        title="Render the prompt above as a new image, with the selected model and size"
                                                        @onclick="() => ReRenderAsync(item, entry)">
                                                    <i class="bi bi-arrow-repeat me-1"></i>Render this prompt
                                                </button>
                                            </details>
                                        </div>
                                        <div class="card-footer d-flex gap-1 justify-content-end">
                                            @* The STANDARD edit and review flows, linked with a return path back to this tab.
                                               An edit (change the colour, rotate the garment) produces a child image of the
                                               same asset, so it appears here as another card - which is why the panel needs
                                               no edit UI of its own. *@
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="/assets/@item.Asset.Id/images/@entry.Image.Id/edit?return=@ReturnUrlEncoded"
                                               title="Edit this image (recolour, rotate, adjust) — the result appears here">
                                                <i class="bi bi-magic"></i>
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary"
                                               href="/assets/@item.Asset.Id/images/@entry.Image.Id/review"
                                               title="Review this image">
                                                <i class="bi bi-check2-circle"></i>
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary" href="/asset-studio/images/@entry.Image.Id/download" title="Download image"><i class="bi bi-download"></i></a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                                    title="Delete this image" @onclick="() => DeleteImageAsync(entry)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<WardrobeItem> _items = [];
    private IReadOnlyList<SceneImageModelChoice> _models = [];
    private string _itemId = string.Empty;
    private string _newItemName = string.Empty;
    private string _description = string.Empty;
    private string _prompt = string.Empty;
    private string _modelId = string.Empty;
    private string _imageSize = "896x1152";
    private int _outputCount = 3;
    private bool _busy;
    private bool _loading;
    private string? _message;
    private string? _error;

    /// <summary>
    /// True once the operator has typed in the prompt box, which stops a later compile from overwriting their words.
    /// </summary>
    private bool _promptEdited;

    /// <summary>The last row this tab drafted a prompt for, so it can be rendered as-is rather than drafted twice.</summary>
    private string? _draftedImageId;

    /// <summary>The draft this tab is waiting to see completed, so its prompt can be shown in the form when it arrives.</summary>
    private string? _awaitingDraftImageId;

    /// <summary>Per-image prompt edits, keyed by image id. Kept here rather than on the row so a compiled prompt is
    /// shown as compiled until the operator actually changes it.</summary>
    private readonly Dictionary<string, string> _promptDrafts = new(StringComparer.Ordinal);

    private System.Threading.Timer? _timer;
    private readonly object _timerLock = new();
    private bool _disposed;

    /// <summary>
    /// The character whose studio is showing this tab, used ONLY to build the return path for the standard edit flow, so
    /// "Back to where I came from" lands back on this tab. The wardrobe itself is shared, so nothing is scoped by it.
    /// </summary>
    [Parameter]
    public string? CharacterId { get; set; }

    private string ReturnUrlEncoded => Uri.EscapeDataString(
        string.IsNullOrWhiteSpace(CharacterId) ? "/asset-studio" : $"/characters/{CharacterId}?section=Wardrobe");

    private bool CanDraftPrompt => !string.IsNullOrWhiteSpace(_modelId)
        && !string.IsNullOrWhiteSpace(_description)
        && (!string.IsNullOrWhiteSpace(_itemId) || !string.IsNullOrWhiteSpace(_newItemName));

    private bool CanRenderPrompt => !string.IsNullOrWhiteSpace(_modelId)
        && !string.IsNullOrWhiteSpace(_prompt)
        && (!string.IsNullOrWhiteSpace(_itemId) || !string.IsNullOrWhiteSpace(_newItemName));

    private bool CanGenerate => CanDraftPrompt;

    private string BlockedReason
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_modelId)) return "Choose an image model.";
            if (string.IsNullOrWhiteSpace(_description)) return "Describe the garment in a few words.";
            if (string.IsNullOrWhiteSpace(_itemId) && string.IsNullOrWhiteSpace(_newItemName)) return "Pick an item or name a new one.";
            return string.Empty;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Wardrobe.ListItemsAsync();
            _models = await Wardrobe.ListModelsAsync();
            if (string.IsNullOrWhiteSpace(_modelId))
            {
                var configured = await Wardrobe.DefaultModelIdAsync();
                _modelId = _models.Any(model => string.Equals(model.ModelId, configured, StringComparison.Ordinal))
                    ? configured!
                    : _models[0].ModelId;
            }

            SyncPromptBoxWithDrafts();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        if (_disposed)
        {
            return;
        }

        // THIS is what makes the page update. Blazor re-renders by itself only after an EVENT HANDLER (a button click);
        // a load driven by the poll timer changes the fields and nothing else happens, so without this call the screen
        // keeps showing whatever it showed when the last click finished. That is the reported failure: "Drafting the
        // prompt for the chosen model" stayed on screen for 20 minutes while the prompt had been written in 5 seconds
        // (verified 2026-09-30: the row was prompt-ready at 02:00:30 and the page was still drafting at 02:01:06).
        // Same pattern as AssetStudioView/ProductionWorkspace, which call StateHasChanged() on their load path.
        StateHasChanged();
        EnsurePolling();
    }

    private void OnItemChanged(ChangeEventArgs args)
    {
        _itemId = args.Value?.ToString() ?? string.Empty;
        _draftedImageId = null;
        _awaitingDraftImageId = null;
        if (!_promptEdited)
        {
            _prompt = string.Empty;
        }

        // Switching item must show THAT item's prompt straight away. Clearing the box and waiting for a reload to refill
        // it is the same "nothing happened" defect as the empty box after a refresh (2026-09-29).
        SyncPromptBoxWithDrafts();
    }

    private void OnModelChanged(ChangeEventArgs args) => _modelId = args.Value?.ToString() ?? string.Empty;

    private void OnPromptChanged(string? text)
    {
        _prompt = text ?? string.Empty;
        _promptEdited = true;
    }

    /// <summary>
    /// Hands the box to the compiler: this action is a request for the compiler to write the prompt, so what is in the
    /// box now is the PREVIOUS prompt and must not stay there looking like the answer to this request (and the operator's
    /// typed text is never replaced when they render instead, which is what "Render image" is for). The description is
    /// the input and is kept.
    /// </summary>
    private void OnBeforeDrafting()
    {
        _promptEdited = false;
        _prompt = string.Empty;
        _draftedImageId = null;
    }

    /// <summary>
    /// Shows the item's drafted prompt IN THE BOX. Read from the ROWS on every load rather than remembered from the
    /// request that asked for it: remembering is why a draft that already existed stayed invisible after a refresh or a
    /// tab switch (reported 2026-09-29: "i should not have to refresh or click off tab and back").
    ///
    /// The operator's own words win: text they have typed is never overwritten by a compiler's.
    /// </summary>
    private void SyncPromptBoxWithDrafts()
    {
        var draft = WardrobePromptDraftSelection.SelectPromptToShow(_items, _itemId);
        if (draft is null)
        {
            // Nothing has been compiled yet. If a compile this tab asked for has finished unsuccessfully, stop waiting
            // for it; the reason is shown in the form.
            if (HasFailedDraft())
            {
                _awaitingDraftImageId = null;
                if (string.Equals(_message, DraftingNotice, StringComparison.Ordinal))
                {
                    _message = null;
                }
            }

            return;
        }

        // The compile this tab was waiting for has arrived. The notice changes with it: a message that still says
        // "drafting" after the prompt is on screen is the same lie as the spinner that never stopped (reported
        // 2026-09-29: "Drafting the prompt ... for 20 minutes").
        _awaitingDraftImageId = null;
        if (string.Equals(_message, DraftingNotice, StringComparison.Ordinal))
        {
            _message = "Prompt ready. Edit it above if you want, then press \"Render image\".";
        }

        _draftedImageId = draft.Image.Id;
        if (!_promptEdited)
        {
            _prompt = draft.Image.Prompt;
        }
    }

    private bool HasFailedDraft() => _items
        .SelectMany(item => item.Images)
        .Any(entry => entry.IsPromptDraft && entry.Image.Status == SceneAssetStatus.Failed);

    /// <summary>
    /// Whether this row's prompt is still being written. One definition, used by both the progress line and the polling
    /// rule, so the two can never disagree about whether something is happening.
    /// </summary>
    private static bool IsCompileInFlight(WardrobeItemImage entry) => entry.IsPromptDraft
        && string.IsNullOrWhiteSpace(entry.Image.PromptCompilerId)
        && entry.Image.Status != SceneAssetStatus.Failed;

    /// <summary>
    /// Whether a compile is running for any item, so the form can say so instead of looking inert while a prompt is
    /// being written.
    /// </summary>
    private bool IsDraftingPrompt => _items.SelectMany(item => item.Images).Any(IsCompileInFlight);

    /// <summary>The compile failure a draft is carrying, if any, so the prompt area can show the reason.</summary>
    private string? DraftFailureMessage => _items
        .SelectMany(item => item.Images)
        .FirstOrDefault(entry => entry.IsPromptDraft && entry.Image.Status == SceneAssetStatus.Failed)
        ?.Image.ErrorMessage;

    /// <summary>
    /// The notice shown while a compile runs. Kept as one constant because it is both written and looked for: when the
    /// prompt arrives, this exact message is replaced by the ready notice rather than left standing.
    /// </summary>
    private const string DraftingNotice = "Drafting the prompt. It appears in the box above for you to edit before "
        + "rendering; your description and the prompt are both kept.";

    /// <summary>
    /// Drafts the prompt and stops. The row appears at once and says it is drafting; when the text arrives it is shown
    /// in the box above (and on the card), and nothing is rendered until the operator asks for it.
    /// </summary>
    private async Task GeneratePromptAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var itemId = await ResolveItemIdAsync();
            OnBeforeDrafting();
            var row = await Wardrobe.EnqueuePromptDraftAsync(itemId, _description, _modelId, _imageSize);
            _itemId = itemId;
            _awaitingDraftImageId = row.Id;
            _message = DraftingNotice;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Renders the prompt in the box, exactly as it reads. An untouched drafted prompt reuses the row it was drafted onto
    /// (no duplicate render); an edited one becomes a NEW row, named for what authored it, because the prompt a previous
    /// image was made from must not be rewritten.
    /// </summary>
    private async Task RenderFromFormAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var itemId = await ResolveItemIdAsync();
            _itemId = itemId;

            if (!_promptEdited && !string.IsNullOrWhiteSpace(_draftedImageId))
            {
                await Wardrobe.RenderExistingImageAsync(_draftedImageId);
                _message = "Rendering the drafted prompt.";
            }
            else
            {
                await Wardrobe.RenderPromptAsync(
                    itemId,
                    _prompt,
                    _modelId,
                    _imageSize,
                    WardrobeItemService.HandEditedPromptCompilerId,
                    semanticDescription: _description,
                    handEditedFromImageId: _draftedImageId);
                _message = "Rendering your edited prompt as a new image of this item.";
                _draftedImageId = null;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The item the form is working on: the one selected, or the one the new name creates.</summary>
    private async Task<string> ResolveItemIdAsync()
    {
        if (!string.IsNullOrWhiteSpace(_itemId))
        {
            return _itemId;
        }

        var created = await Wardrobe.CreateItemAsync(_newItemName);
        _newItemName = string.Empty;
        return created.Id;
    }

    private static int ParseCount(object? value) =>
        int.TryParse(value?.ToString(), out var parsed) ? Math.Clamp(parsed, 1, 8) : 1;

    private async Task GenerateAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var itemId = await ResolveItemIdAsync();
            await Wardrobe.EnqueueItemImagesAsync(itemId, _description, _modelId, _imageSize, _outputCount);
            _itemId = itemId;
            _message = $"{_outputCount} image(s) queued: each one drafts a full garment prompt for the chosen model and then"
                + " renders it. They appear below straight away and say what they are doing. Your description is kept.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetInUseAsync(WardrobeItemImage entry, bool inUse)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await Wardrobe.SetImageInUseAsync(entry.Image.Id, inUse);
            _message = inUse
                ? "This image is now available in every wardrobe reference picker."
                : "This image is no longer offered as a reference.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveLabelAsync(WardrobeItemImage entry, string? label)
    {
        try
        {
            await Wardrobe.SetImageLabelAsync(entry.Image.Id, label);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>The prompt as the operator has edited it, or the compiled one until they change it.</summary>
    private string PromptDraft(WardrobeItemImage entry) =>
        _promptDrafts.TryGetValue(entry.Image.Id, out var draft) ? draft : entry.Image.Prompt;

    /// <summary>
    /// What this item is doing right now, counted from its own rows: usable images, drafts still being written, renders
    /// in flight, failures. A prompt draft is counted as a PROMPT, never as an image, because that is what it is.
    /// </summary>
    private static string ItemStatus(WardrobeItem item)
    {
        var drafts = item.Images.Count(entry => entry.IsPromptDraft);
        var drafted = item.Images.Count(entry => entry.IsPromptDraft
            && !string.IsNullOrWhiteSpace(entry.Image.PromptCompilerId));
        var rendering = item.Images.Count(entry => !entry.IsPromptDraft && entry.Image.Status == SceneAssetStatus.Pending);
        var failed = item.Images.Count(entry => entry.Image.Status == SceneAssetStatus.Failed);

        var parts = new List<string>();
        if (item.IsUsable)
        {
            parts.Add($"{item.InUseImages.Count} image(s) usable as a reference");
        }

        if (drafts > 0)
        {
            parts.Add(drafted == drafts
                ? $"{drafts} prompt(s) ready to render"
                : $"{drafts} prompt(s) being drafted");
        }

        if (rendering > 0)
        {
            parts.Add($"{rendering} rendering");
        }

        if (failed > 0)
        {
            parts.Add($"{failed} failed");
        }

        return parts.Count == 0 ? "not usable yet" : string.Join(" · ", parts);
    }

    /// <summary>
    /// What this row is currently doing, in the operator's words, read from the STAGE the service recorded. Without the
    /// stage a row whose prompt is written and deliberately not rendered looks exactly like one still being drafted.
    /// </summary>
    private static string StateFor(WardrobeItemImage entry)
    {
        if (entry.Image.Status == SceneAssetStatus.Failed)
        {
            return "failed — see the message below";
        }

        if (entry.Image.Status != SceneAssetStatus.Pending)
        {
            return string.Empty;
        }

        return StageOf(entry.Image) switch
        {
            "prompt-ready" => "prompt ready — press Render image to use it",
            "rendering" => "queued to render…",
            _ => "drafting the prompt…"
        };
    }

    /// <summary>The stage the service recorded on this row, or empty when it recorded none.</summary>
    private static string StageOf(SceneAssetImage image)
    {
        if (string.IsNullOrWhiteSpace(image.AssociationMetadataJson) || image.AssociationMetadataJson.Trim().Length <= 2)
        {
            return string.Empty;
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(image.AssociationMetadataJson);
            return document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object
                && document.RootElement.TryGetProperty("stage", out var stage)
                && stage.ValueKind == System.Text.Json.JsonValueKind.String
                    ? stage.GetString() ?? string.Empty
                    : string.Empty;
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private void SetPromptDraft(WardrobeItemImage entry, string? text) =>
        _promptDrafts[entry.Image.Id] = text ?? string.Empty;

    /// <summary>
    /// Renders the edited prompt as a NEW image of the item. A new row rather than an overwrite, because the stored
    /// prompt is what an existing image WAS made from: rewriting it would make the record of the render a lie.
    /// </summary>
    private async Task ReRenderAsync(WardrobeItem item, WardrobeItemImage entry)
    {
        var prompt = PromptDraft(entry);
        if (string.IsNullOrWhiteSpace(prompt))
        {
            _error = "The prompt is empty, so there is nothing to render.";
            return;
        }

        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await Wardrobe.RenderPromptAsync(
                item.Asset.Id,
                prompt,
                _modelId,
                _imageSize,
                WardrobeItemService.HandEditedPromptCompilerId,
                handEditedFromImageId: entry.Image.Id);
            _message = "Prompt queued as a new image of this item.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteImageAsync(WardrobeItemImage entry)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await Wardrobe.DeleteImageAsync(entry.Image.Id);
            _message = "Image deleted.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // The refusal ("stop using it first") is the operator's instruction, so it is shown as-is.
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Polls while anything is outstanding, so a compiled prompt and a finished render appear WITHOUT the operator
    /// touching the page. The timer body is marshalled onto the Blazor dispatcher: a System.Threading.Timer callback runs
    /// on a thread-pool thread, and touching component state from there throws "current thread is not associated with the
    /// Dispatcher" and can take the whole app down.
    /// </summary>
    /// <remarks>
    /// The rule covers BOTH halves of an action: a row still being written (its prompt is not there yet) and a row still
    /// being rendered. An earlier version only polled for a PENDING ROW, which stopped as soon as the compile finished -
    /// the draft could be written and the page would never notice (reported 2026-09-29: "it should update when it is
    /// done, i should not have to refresh or click off tab and back").
    /// </remarks>
    private void EnsurePolling()
    {
        lock (_timerLock)
        {
            if (_timer is not null || _disposed)
            {
                return;
            }

            if (!NeedsPolling)
            {
                return;
            }

            _timer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    if (!NeedsPolling)
                    {
                        StopPolling();
                    }
                });
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        }
    }

    /// <summary>
    /// Whether work is genuinely IN FLIGHT: a compile this tab asked for and has not seen the result of, a row whose
    /// prompt is still being written, or a row being rendered. A compiled-but-unrendered draft is deliberately NOT
    /// work in flight - it is finished work waiting for the operator, and it stays Pending until they render it, so
    /// polling on "Pending" alone would have ticked forever on a prompt that was already done.
    /// </summary>
    private bool NeedsPolling => _busy
        || !string.IsNullOrWhiteSpace(_awaitingDraftImageId)
        || _items.SelectMany(item => item.Images).Any(entry =>
            IsCompileInFlight(entry)
            || (!entry.IsPromptDraft && entry.Image.Status == SceneAssetStatus.Pending));

    private void StopPolling()
    {
        lock (_timerLock)
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        StopPolling();
        return ValueTask.CompletedTask;
    }
}
